    {
      "type": "paragraph",
      "sentences": [
        {
          "id": "s0005",
          "zh": "713 開元元年 幽州置防禦大使。",
          "translations": [
            {
              "lang": "en",
              "literal": "713, first year of the Kaiyuan era. At Youzhou a defense commissioner was established.",
              "idiomatic": "In 713, the first year of Kaiyuan, a defense commissioner was posted to Youzhou.",
              "translator": "Garrett M. Petersen (2026)",
              "model": "Composer 2.5"
            }
          ]
        }
      ],
      "translations": [
        {
          "lang": "en",
          "literal": "",
          "idiomatic": "",
          "translator": ""
        }
      ]
    },
    {
      "type": "paragraph",
      "sentences": [
        {
          "id": "s0006",
          "zh": "置營平鎮守，治太平州。",
          "translations": [
            {
              "lang": "en",
              "literal": "The Yingping garrison commander was established, with seat at Taiping Prefecture.",
              "idiomatic": "A Yingping garrison commander was appointed, headquartered at Taiping Prefecture.",
              "translator": "Garrett M. Petersen (2026)",
              "model": "Composer 2.5"
            }
          ]
        }
      ],
      "translations": [
        {
          "lang": "en",
          "literal": "",
          "idiomatic": "",
          "translator": ""
        }
      ]
    },
    {
      "type": "paragraph",
      "sentences": [
        {
          "id": "s0007",
          "zh": "756 至德元載 置河中防禦守捉蒲關使。",
          "translations": [
            {
              "lang": "en",
              "literal": "756, first year of the Zhide era. The Hezhong defense and Tong Pass garrison commissioner was established.",
              "idiomatic": "In 756, the first year of Zhide, the Hezhong defense and Tong Pass garrison commissioner was created.",
              "translator": "Garrett M. Petersen (2026)",
              "model": "Composer 2.5"
            }
          ]
        },
        {
          "id": "s0008",
          "zh": "置澤潞沁節度使，治潞州。",
          "translations": [
            {
              "lang": "en",
              "literal": "The Ze-Lu-Qin military commissioner was established, with seat at Lu Prefecture.",
              "idiomatic": "A Ze–Lu–Qin military commissioner was appointed, with his seat at Lu Prefecture.",
              "translator": "Garrett M. Petersen (2026)",
              "model": "Composer 2.5"
            }
          ]
        }
      ],
      "translations": [
        {
          "lang": "en",
          "literal": "",
          "idiomatic": "",
          "translator": ""
        }
      ]
    },
