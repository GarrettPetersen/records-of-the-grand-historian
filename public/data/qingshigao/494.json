  "content": [
    {
      "type": "paragraph",
      "sentences": [
        {
          "id": "s0001",
          "zh": "列傳二百八十一",
          "translations": []
        }
      ],
      "translations": []
    },
    {
      "type": "paragraph",
      "sentences": [
        {
          "id": "s0002",
          "zh": "忠義八",
          "translations": []
        }
      ],
      "translations": []
    },
    {
      "type": "paragraph",
      "sentences": [
        {
          "id": "s0003",
          "zh": "姚懷祥全福舒恭受等韋逢甲長喜等麥廷章劉大忠等",
          "translations": []
        }
      ],
      "translations": []
    },
    {
      "type": "paragraph",
      "sentences": [
        {
          "id": "s0004",
          "zh": "韋印福錢金玉等龍汝元樂善魁霖等文豐",
          "translations": []
        }
      ],
      "translations": []
    },
    {
      "type": "paragraph",
      "sentences": [
        {
          "id": "s0005",
          "zh": "殷明恆高騰雲等高善繼駱佩德等林永昇陳金揆等",
          "translations": []
        }
      ],
      "translations": []
    },
    {
      "type": "paragraph",
      "sentences": [
        {
          "id": "s0006",
          "zh": "李大本於光炘等黃祖蓮",
          "translations": []
        }
      ],
      "translations": []
    },
    {
      "type": "paragraph",
      "sentences": [
        {
          "id": "s0007",
          "zh": "姚懷祥，福建侯官人。",
          "translations": []
        },
        {
          "id": "s0008",
          "zh": "嘉慶二十三年舉人。",
          "translations": []
        },
        {
          "id": "s0009",
          "zh": "道光十五年，挑知縣，發浙江，權象山、龍遊等縣。",
          "translations": []
        },
        {
          "id": "s0010",
          "zh": "二十年，英吉利以欽差大臣林則徐在兩廣堅持鴉片之禁，耀兵寧波洋面，破定海，旋退出。",
          "translations": []
        },
        {
          "id": "s0011",
          "zh": "二十一年二月，攻虎門，廣東水師提督關天培、湖南提督祥福；",
          "translations": []
        },
        {
          "id": "s0012",
          "zh": "七月，攻廈門，總兵江繼芸，游擊凌志；",
          "translations": []
        },
        {
          "id": "s0013",
          "zh": "八月，復攻定海，總兵王錫朋、鄭國鴻、葛雲飛；",
          "translations": []
        },
        {
          "id": "s0014",
          "zh": "九月，攻鎮海，兩江總督裕謙，狼山鎮總兵謝朝恩；",
          "translations": []
        },
        {
          "id": "s0015",
          "zh": "二十二年三月，攻慈溪，副將硃貴與子昭南；",
          "translations": []
        },
        {
          "id": "s0016",
          "zh": "五月，攻吳淞，江南提督陳化成：均先後殉難，自有傳。",
          "translations": []
        },
        {
          "id": "s0017",
          "zh": "懷祥於二十年適署定海篆，分募鄉勇，為死守計，總兵張朝發撤之。",
          "translations": []
        },
        {
          "id": "s0018",
          "zh": "城陷南門，懷祥負傷，立城上呼兵，無應者，憤甚，投成仁塘死。",
          "translations": []
        }
      ],
      "translations": []
    },
    {
      "type": "paragraph",
      "sentences": [
        {
          "id": "s0019",
          "zh": "典史全福使酒仗氣，敵至，衣冠坐獄門。",
          "translations": []
        },
        {
          "id": "s0020",
          "zh": "囚跳，歎曰：「失城當死。",
          "translations": []
        },
        {
          "id": "s0021",
          "zh": "況失囚耶？",
          "translations": []
        },
        {
          "id": "s0022",
          "zh": "」敵入署，大呼殺賊，斃黑酋者一，叢刺死。",
          "translations": []
        },
        {
          "id": "s0023",
          "zh": "翌年，再犯寧波、定海，則石浦同知舒恭受，游擊張玉衡、外委武英太同死難。",
          "translations": []
        },
        {
          "id": "s0024",
          "zh": "都司李躍淵則隨總兵鄭國鴻戰曉峰嶺六晝夜，與把總胡大純、洪武琮，外委金釗同歿於陣。",
          "translations": []
        }
      ],
      "translations": []
    },
    {
      "type": "paragraph",
      "sentences": [
        {
          "id": "s0025",
          "zh": "是役也，慈溪大寶山死者，為即用知縣顏履敬，參將黃泰，守備田錫、陳芝蘭、徐宦、哈克里，千總阿本穰、魏啟明，把總林懷玉、盧炳、邸法德，外委張化鵬、馬龍圖、何海、毛玉貴、王保元、楊福增；",
          "translations": []
        },
        {
          "id": "s0026",
          "zh": "死鎮海城者，為縣丞李向陽；",
          "translations": []
        },
        {
          "id": "s0027",
          "zh": "戰金雞山死者，為都司孫汝鵬，守備李雲龍、王萬龍，千總陳慶三、陳守澍、周萬治，把總馬金龍、汪宗斌、解天培、金，外委林賡、吳定江；",
          "translations": []
        },
        {
          "id": "s0028",
          "zh": "死招寶山者，為外委蔡步高。",
          "translations": []
        },
        {
          "id": "s0029",
          "zh": "而山陰練勇袁樂忠以從間道導硃貴軍至長碕迎戰，為砲火所逼，從煙焰中躍起，投海死。",
          "translations": []
        }
      ],
      "translations": []
    },
    {
      "type": "paragraph",
      "sentences": [
        {
          "id": "s0030",
          "zh": "韋逢甲，山東​​齊河人。",
          "translations": []
        },
        {
          "id": "s0031",
          "zh": "道光十六年進士，用知縣，發浙江，累權宣平、馀杭、浦江等縣。",
          "translations": []
        },
        {
          "id": "s0032",
          "zh": "英吉利既再擾寧波洋面，將寇吳淞，先以弋船三十艘進攻乍浦。",
          "translations": []
        },
        {
          "id": "s0033",
          "zh": "時逢甲以督鑄大砲，由鎮海赴乍浦設防，就權同知。",
          "translations": []
        },
        {
          "id": "s0034",
          "zh": "四月，敵遽由東光山上陸，屯兵皆潰。",
          "translations": []
        },
        {
          "id": "s0035",
          "zh": "逢甲帶鄉團禦於西行汛，死之。",
          "translations": []
        }
      ],
      "translations": []
    },
    {
      "type": "paragraph",
      "sentences": [
        {
          "id": "s0036",
          "zh": "同死者，為駐防副都統長喜，前鋒協領英登布，佐領隆福，防禦貴順、額特赫，前鋒校佛印，驍騎校伊勒哈畚、根順、該杭阿及調浙助防之守備張淮泗，千總李廷貴，把總王榮、馬致榮、孫登霄，外委馬成功、硃朝貴。",
          "translations": []
        },
        {
          "id": "s0037",
          "zh": "而伊勒哈畚尤慘，伏觀山射夷，殪甚眾，被執，磔死。",
          "translations": []
        },
        {
          "id": "s0038",
          "zh": "子仁厚，襲職，殉粵寇。",
          "translations": []
        }
      ],
      "translations": []
    },
    {
      "type": "paragraph",
      "sentences": [
        {
          "id": "s0039",
          "zh": "麥廷章，廣東鶴山人。",
          "translations": []
        },
        {
          "id": "s0040",
          "zh": "道光十二年，以外委隨剿連州瑤匪功，屢遷至游擊。",
          "translations": []
        },
        {
          "id": "s0041",
          "zh": "林則徐查辦英吉利躉船鴉片，檄廷章率舟師駐九龍山巡防。",
          "translations": []
        },
        {
          "id": "s0042",
          "zh": "英酋遞書辯論，開導不服，遽開砲，廷章以大砲應之，毀雙桅敵船。",
          "translations": []
        },
        {
          "id": "s0043",
          "zh": "又潛約土密兵船助攻，复擊卻之。",
          "translations": []
        },
        {
          "id": "s0044",
          "zh": "英人既陷浙定海，遂溯大洋至天津乞和，朝命直隸總督琦善馳粵與議，海防遽懈。",
          "translations": []
        },
        {
          "id": "s0045",
          "zh": "二十年十二月，敵乘不備，突進占大角、沙角，廷章時佐提督關天培防守靖遠砲台。",
          "translations": []
        },
        {
          "id": "s0046",
          "zh": "明年二月，敵船擁入三門口，斷防禦椿練。",
          "translations": []
        },
        {
          "id": "s0047",
          "zh": "南風作，復以大隊圍橫檔、永安，截我軍援道，進犯虎門。",
          "translations": []
        },
        {
          "id": "s0048",
          "zh": "廷章奮勇御之，力竭死。",
          "translations": []
        }
      ],
      "translations": []
    },
    {
      "type": "paragraph",
      "sentences": [
        {
          "id": "s0049",
          "zh": "時同死者，為香山協副將劉大忠，游擊沈佔鼇，守備洪達科等。",
          "translations": []
        },
        {
          "id": "s0050",
          "zh": "參將周枋則以拒敵烏湧戰歿。",
          "translations": []
        },
        {
          "id": "s0051",
          "zh": "三月，英人復由粵擾閩，攻廈門，犯內港，守備王世俊、蔣錫恩，千總張然迎擊之，均以力戰陣亡。",
          "translations": []
        }
      ],
      "translations": []
    },
    {
      "type": "paragraph",
      "sentences": [
        {
          "id": "s0052",
          "zh": "韋印福，江蘇上元人。",
          "translations": []
        },
        {
          "id": "s0053",
          "zh": "由行伍隨剿滑縣匪，有膽略，嘗曰：「武官臨陣，死生度外事，畏死不作武官矣。",
          "translations": []
        },
        {
          "id": "s0054",
          "zh": "」累擢千總，為兩江總督陶澍所賞，擢署金山營游擊。",
          "translations": []
        },
        {
          "id": "s0055",
          "zh": "英吉利之窺吳淞也，提督陳化成守西砲台，誓死戰，以印福忠勇，隸左右。",
          "translations": []
        },
        {
          "id": "s0056",
          "zh": "二十二年五月，敵艦叢擊之，化成被傷，印福救護不及，歿於陣。",
          "translations": []
        }
      ],
      "translations": []
    },
    {
      "type": "paragraph",
      "sentences": [
        {
          "id": "s0057",
          "zh": "化成之歿，從殉者八十人，其尤烈者：千總錢金玉，臨危或勸避去，答曰：「金玉年十六即食國餉，今焉避？",
          "translations": []
        },
        {
          "id": "s0058",
          "zh": "」遂及難；",
          "translations": []
        },
        {
          "id": "s0059",
          "zh": "外委徐太華，善用砲，轉移如志，擊皆命中，被擊死；",
          "translations": []
        },
        {
          "id": "s0060",
          "zh": "把總許攀桂，擁護化成，謂：「主將與某等同甘苦，公報國在今日，某等報公亦在今日！",
          "translations": []
        },
        {
          "id": "s0061",
          "zh": "」眾心益固，卒飲劍死；",
          "translations": []
        },
        {
          "id": "s0062",
          "zh": "把總龔增齡，迎戰，刃數人，敵人圍而擒之，釘手足於板，擲諸海；",
          "translations": []
        },
        {
          "id": "s0063",
          "zh": "外委周林，率帳下巷戰，中槍，先化成死。",
          "translations": []
        }
      ],
      "translations": []
    },
    {
      "type": "paragraph",
      "sentences": [
        {
          "id": "s0064",
          "zh": "時督師兩江總督牛鑑，以砲毀演武廳，亟退去，之蘇州，又之江寧，敵遂由寶山徇上海，道以下官皆遁，典史劉慶恩投浦江死。",
          "translations": []
        },
        {
          "id": "s0065",
          "zh": "內河不能深入艦隊，乃由福山口犯鎮江京口，副都統海齡戰不勝，自縊死，尋諡昭節。",
          "translations": []
        },
        {
          "id": "s0066",
          "zh": "赴援游擊羅必魁、把總趙連璧，均死之。",
          "translations": []
        }
      ],
      "translations": []
    },
    {
      "type": "paragraph",
      "sentences": [
        {
          "id": "s0067",
          "zh": "駐防員弁同與難者，為馬甲長松，與子驍騎校祥雲；",
          "translations": []
        },
        {
          "id": "s0068",
          "zh": "佐領景星、愛星布、𢗝明，防禦恆山、尚德、恆福、吉成，驍騎校伊克濟訥，文舉人噶喇，武舉人哈達海，筆帖式哈豐阿、恩喜，前鋒校松寶、文魁、阿勒金圖、喜興等。",
          "translations": []
        },
        {
          "id": "s0069",
          "zh": "迫江寧欽差大臣耆英等奏定款局，而五口通商之約成。",
          "translations": []
        }
      ],
      "translations": []
    },
    {
      "type": "paragraph",
      "sentences": [
        {
          "id": "s0070",
          "zh": "龍汝元，順天宛平人。",
          "translations": []
        },
        {
          "id": "s0071",
          "zh": "由行伍隨剿廣西會匪，以功累擢游擊，隸河南巡撫英桂軍營。",
          "translations": []
        },
        {
          "id": "s0072",
          "zh": "咸豐八年，英吉利糾合法郎西、米利堅兩國，藉口換約，俄羅斯复陰助之，堅請在京師開議。",
          "translations": []
        },
        {
          "id": "s0073",
          "zh": "議未定，艦隊集天津海口，朝命科爾沁親王僧格林沁辦理海防。",
          "translations": []
        },
        {
          "id": "s0074",
          "zh": "汝元奉檄至，擢大沽協副將。",
          "translations": []
        },
        {
          "id": "s0075",
          "zh": "九年五月，英、法兵船駛入內河，汝元手燃巨砲沉其船，旋中砲歿於陣，諡武愍。",
          "translations": []
        },
        {
          "id": "s0076",
          "zh": "提督史榮椿同死，自有傳。",
          "translations": []
        }
      ],
      "translations": []
    },
    {
      "type": "paragraph",
      "sentences": [
        {
          "id": "s0077",
          "zh": "是役也，諸國受創甚。",
          "translations": []
        },
        {
          "id": "s0078",
          "zh": "十年夏，艦隊复集天津大沽口，提督樂善奉命駐兵大沽，至則以關防交僧格林沁，令所部原留者聽，得千馀人，誓死守。",
          "translations": []
        },
        {
          "id": "s0079",
          "zh": "六月，敵兵自北塘登岸，七月一日，自石縫砲台擊敗之。",
          "translations": []
        },
        {
          "id": "s0080",
          "zh": "相持一日，無後援。",
          "translations": []
        },
        {
          "id": "s0081",
          "zh": "火藥局火起，兵多傷死。",
          "translations": []
        },
        {
          "id": "s0082",
          "zh": "樂善知不可守，遂投河死。",
          "translations": []
        },
        {
          "id": "s0083",
          "zh": "從死者副將、守備各一，失其名。",
          "translations": []
        },
        {
          "id": "s0084",
          "zh": "樂善諡威毅。",
          "translations": []
        }
      ],
      "translations": []
    },
    {
      "type": "paragraph",
      "sentences": [
        {
          "id": "s0085",
          "zh": "時副將魁霖在通州巡防，檄至天津助戰，亡於陣，諡威肅。",
          "translations": []
        },
        {
          "id": "s0086",
          "zh": "委翼長阿克東阿、侍衛扎精阿同死之。",
          "translations": []
        },
        {
          "id": "s0087",
          "zh": "八月，敵遂北犯通州，圖佔西倉，監督覺羅貴倫與同官玉潤衣冠對縊殉節。",
          "translations": []
        },
        {
          "id": "s0088",
          "zh": "焚淀園，文豐外，員外郎泰清、苑丞泰衷全家自焚死。",
          "translations": []
        },
        {
          "id": "s0089",
          "zh": "時文宗駐蹕熱河，命恭親王奕訢再議款局，而難始定。",
          "translations": []
        }
      ],
      "translations": []
    },
    {
      "type": "paragraph",
      "sentences": [
        {
          "id": "s0090",
          "zh": "文豐，董氏，內務府漢軍正黃旗人。",
          "translations": []
        },
        {
          "id": "s0091",
          "zh": "內務府筆帖式，歷堂主事、員外郎、造辦處郎中，充杭州織造，授驍騎參領。",
          "translations": []
        },
        {
          "id": "s0092",
          "zh": "道光二十一年，充粵海監督。",
          "translations": []
        },
        {
          "id": "s0093",
          "zh": "二十三年，偕兩廣總督耆英等遵議英吉利五口通商章程十五條，下部議行。",
          "translations": []
        },
        {
          "id": "s0094",
          "zh": "二十六年三月，授熱河副總管，充蘇州織造。",
          "translations": []
        },
        {
          "id": "s0095",
          "zh": "差還，授堂郎中。",
          "translations": []
        },
        {
          "id": "s0096",
          "zh": "咸豐四年，賞總管內務府大臣銜，歷正藍旗漢軍副都統、正藍旗護軍統領。",
          "translations": []
        },
        {
          "id": "s0097",
          "zh": "七年二月，授總管內務府大臣，尋署正黃旗護軍統領。",
          "translations": []
        },
        {
          "id": "s0098",
          "zh": "八年五月，管理圓明園事務，調正紅旗滿洲副都統，充崇文門副監督。",
          "translations": []
        },
        {
          "id": "s0099",
          "zh": "又調正白旗滿洲副都統，署禦藥房、太醫院事務。",
          "translations": []
        },
        {
          "id": "s0100",
          "zh": "十年八月，命在圓明園照料一切事宜，是月英人闖入圓明園，文豐投水殉難。",
          "translations": []
        },
        {
          "id": "s0101",
          "zh": "賜卹如例，贈太子少保銜，入祀京師昭忠祠。",
          "translations": []
        },
        {
          "id": "s0102",
          "zh": "同治元年，追念忠節諸臣，以「文豐從容赴難，不愧完人」褒之，加恩予諡忠毅。",
          "translations": []
        }
      ],
      "translations": []
    },
    {
      "type": "paragraph",
      "sentences": [
        {
          "id": "s0103",
          "zh": "殷明恆，江西南昌人。",
          "translations": []
        },
        {
          "id": "s0104",
          "zh": "由武童投效水師營，擢把總。",
          "translations": []
        },
        {
          "id": "s0105",
          "zh": "光緒四年，赴閩，隸平海中營師船司砲。",
          "translations": []
        },
        {
          "id": "s0106",
          "zh": "時佛郎西既並越南，將窺滇省，其酋領軍艦十四艘先犯福州，圖覆船政局。",
          "translations": []
        },
        {
          "id": "s0107",
          "zh": "十年七月，在馬江發難，明恆陣亡。",
          "translations": []
        },
        {
          "id": "s0108",
          "zh": "時毀兵船七，商船二，及艇哨各船俱燼，死者不可計。",
          "translations": []
        },
        {
          "id": "s0109",
          "zh": "見奏報者，以參將高騰雲死最慘，五品軍功陳英戰最烈。",
          "translations": []
        },
        {
          "id": "s0110",
          "zh": "船廠學生帶揚武艦葉琛，帶建勝艦林森林，均登了台發砲，受彈，猶屹立指揮；",
          "translations": []
        },
        {
          "id": "s0111",
          "zh": "充福星輪三副王漣受砲傷，猶槍斃敵兵多名，均以傷重陣亡。",
          "translations": []
        }
      ],
      "translations": []
    },
    {
      "type": "paragraph",
      "sentences": [
        {
          "id": "s0112",
          "zh": "是役也，戰鎮南關外，隸記名提督劉永福部下者，為武監生楊萼恩、哨弁何承文等；",
          "translations": []
        },
        {
          "id": "s0113",
          "zh": "隸署提督蘇元春部下者，為總兵孫得勝，副將黃政德、邱福初、陳義新、劉德勝、張大壽、劉玉貴，參將胡延慶、王紹斌、蕭有明、黃世昌、石啟官、張興寬，游擊蕭寶臣、李純五、吳少懷，都司黃均、任有錫、李逢楨、吳述元、周同芳，守備黃效忠、楊承祿，千總蘇全璧、蔣全昌、李得勝，把總王有興、李明德、楊春林、徐國慶、葉亞吉、梁玉輝，外委曹正亮，六品軍功勞國豐，從九品黃汝霖等。",
          "translations": []
        }
      ],
      "translations": []
    },
    {
      "type": "paragraph",
      "sentences": [
        {
          "id": "s0114",
          "zh": "隸廣西巡撫潘鼎新部下，紙作社之役，為副將蘇玉標，都司陳福隆，把總張元鴻、顧玉芳；",
          "translations": []
        },
        {
          "id": "s0115",
          "zh": "諒山之役，為提督劉思河，都司劉映谷、黃正寅、鄧晏林、杜光湔，守備羅雲高，千總俞諫臣、蔡得勝、孫其易，把總謝世和，六品軍功萬國發等。",
          "translations": []
        }
      ],
      "translations": []
    },
    {
      "type": "paragraph",
      "sentences": [
        {
          "id": "s0116",
          "zh": "隸福建布政使王德榜部下，戰豐谷等處，為總兵黃喜光，副將胡陽春、武鴻來，參將左廷秀、譚家璐、王得永、蔡玉堂、黃祖富、左占元，游擊陶得玉、聶章壽、王得才、柳臣玖，都司王天喜、陳永發、趙步雲、譚連勝、胡克勝、田玉貴，守備邱正亮、鄧青雲，千總謝廷蘭、張玉魁、楊大德、胡士英，把總蕭恩清、王成吉，外委劉云漢、謝薛昌，六品軍功黎占元、唐復興、譚以明等。",
          "translations": []
        }
      ],
      "translations": []
    },
    {
      "type": "paragraph",
      "sentences": [
        {
          "id": "s0117",
          "zh": "隸福建巡撫劉銘傳部下者，為總兵曾照禮，副將劉義高，千總殷有升，把總尤運農、祁文等。",
          "translations": []
        },
        {
          "id": "s0118",
          "zh": "均分別上聞，贈卹有差，高州鎮總兵楊玉科，則以宿將有功，戰歿諒山，自有傳。",
          "translations": []
        }
      ],
      "translations": []
    },
    {
      "type": "paragraph",
      "sentences": [
        {
          "id": "s0119",
          "zh": "高善繼，字次浦，江西彭澤人。",
          "translations": []
        },
        {
          "id": "s0120",
          "zh": "由附生舉同治元年孝廉方正，朝考用教職，署弋陽縣訓導。",
          "translations": []
        },
        {
          "id": "s0121",
          "zh": "舉優行，皆寒畯士，積弊為清。",
          "translations": []
        },
        {
          "id": "s0122",
          "zh": "尋調贛州府學教授，又調南安。",
          "translations": []
        },
        {
          "id": "s0123",
          "zh": "光緒十四年，舉鄉薦，會試不第，謁李鴻章於天津，鴻章，其父執也，語不合，投通永鎮總兵吳育仁幕下。",
          "translations": []
        },
        {
          "id": "s0124",
          "zh": "二十年，日本侵朝鮮，廷議主戰。",
          "translations": []
        },
        {
          "id": "s0125",
          "zh": "六月，善繼佐營官駱佩德乘英國高升輪船運送軍實。",
          "translations": []
        },
        {
          "id": "s0126",
          "zh": "駛至牙山口外，日本舉旗招撫，善繼不肯屈。",
          "translations": []
        },
        {
          "id": "s0127",
          "zh": "管駕英人先逸去，善繼忿極，令懸紅旗示戰備，且進薄之。",
          "translations": []
        },
        {
          "id": "s0128",
          "zh": "方與佩德指揮禦敵，忽船中魚雷，逾時，水勢注射益洶湧，眾強善繼及佩德亟下，善繼奮然曰：「吾輩自請殺敵，而臨難即避，縱歸，何面目見人？",
          "translations": []
        },
        {
          "id": "s0129",
          "zh": "且吾世受國恩，今日之事，一死而已！",
          "translations": []
        },
        {
          "id": "s0130",
          "zh": "」佩德曰：「如此，吾豈忍獨生？",
          "translations": []
        },
        {
          "id": "s0131",
          "zh": "」高升船遂沉，善繼溺死，佩德從之。",
          "translations": []
        }
      ],
      "translations": []
    },
    {
      "type": "paragraph",
      "sentences": [
        {
          "id": "s0132",
          "zh": "時護行者為濟遠艦，亦為敵船在豐島襲擊，大副都司沈壽昌堅守砲位，竭力還攻。",
          "translations": []
        },
        {
          "id": "s0133",
          "zh": "及中砲陣亡，則守備柯建章繼之；",
          "translations": []
        },
        {
          "id": "s0134",
          "zh": "复陣亡，則黃承勳繼之。",
          "translations": []
        },
        {
          "id": "s0135",
          "zh": "與軍功王錫三、管旗劉鶤同與於難，爭趨死地，奮不顧身，尤為當時所稱。",
          "translations": []
        },
        {
          "id": "s0136",
          "zh": "廣乙快船管輪把總何汝賓，亦於是役中彈陣亡。",
          "translations": []
        }
      ],
      "translations": []
    },
    {
      "type": "paragraph",
      "sentences": [
        {
          "id": "s0137",
          "zh": "林永昇，福建侯官人。",
          "translations": []
        },
        {
          "id": "s0138",
          "zh": "入船政學堂肄業駕駛，派兵輪練習，週曆南北洋險要，以千總留閩，充船政學堂教習。",
          "translations": []
        },
        {
          "id": "s0139",
          "zh": "復出洋留學，歸，晉守備，調直隸。",
          "translations": []
        },
        {
          "id": "s0140",
          "zh": "從平朝鮮之亂，擢都司。",
          "translations": []
        },
        {
          "id": "s0141",
          "zh": "赴德國接收代造經遠快船，保升游擊。",
          "translations": []
        },
        {
          "id": "s0142",
          "zh": "光緒十五年，北洋海軍新設左翼左營副將，以永昇署理。",
          "translations": []
        },
        {
          "id": "s0143",
          "zh": "辦海軍出力，升用總兵。",
          "translations": []
        },
        {
          "id": "s0144",
          "zh": "二十年八月，朝命海軍護送陸軍赴大東溝登岸援朝鮮，日本海軍來襲，我鐵艦十，當敵艦十有二。",
          "translations": []
        },
        {
          "id": "s0145",
          "zh": "副將鄧世昌管帶致遠，都司陳金揆副之；",
          "translations": []
        },
        {
          "id": "s0146",
          "zh": "參將黃建勳管帶超勇；",
          "translations": []
        },
        {
          "id": "s0147",
          "zh": "參將林履中管帶揚威；",
          "translations": []
        },
        {
          "id": "s0148",
          "zh": "經遠，則永昇主之。",
          "translations": []
        },
        {
          "id": "s0149",
          "zh": "永昇夙與世昌等以忠義相激勵，既合諸艦，衝鋒轟擊，沉日艦三，卒以敵軍船快砲快為所勝，世昌戰歿。",
          "translations": []
        },
        {
          "id": "s0150",
          "zh": "提督丁汝昌坐定遠督船，畏葸不知所為，又被傷，總兵劉步蟾代之。",
          "translations": []
        },
        {
          "id": "s0151",
          "zh": "船陣失列，有跳而免者，永昇仍指揮艦勇，冒死與戰，驟中敵彈，腦裂死。",
          "translations": []
        },
        {
          "id": "s0152",
          "zh": "是役也，血戰逾三時，為各國海戰所僅見。",
          "translations": []
        }
      ],
      "translations": []
    },
    {
      "type": "paragraph",
      "sentences": [
        {
          "id": "s0153",
          "zh": "永昇而外，金揆、建勳、履中及守備楊建洛、徐希顏，千總池兆濱、蔡馥，把總孫景仁、史壽箴、王宗墀、張炳福、易文經、王蘭芬，外委郭耀忠，五品軍功張金盛，六品軍功王錫山，均死之。",
          "translations": []
        },
        {
          "id": "s0154",
          "zh": "世昌自有傳。",
          "translations": []
        }
      ],
      "translations": []
    },
    {
      "type": "paragraph",
      "sentences": [
        {
          "id": "s0155",
          "zh": "李大本，安徽六安州人。",
          "translations": []
        },
        {
          "id": "s0156",
          "zh": "咸豐間投效江西軍營，以功累擢游擊，复投效直隸，充哨長，晉副將。",
          "translations": []
        },
        {
          "id": "s0157",
          "zh": "光緒二十年，日本犯朝鮮，葉志超統軍往援，扼守公州，聶士成率五營駐成歡驛。",
          "translations": []
        },
        {
          "id": "s0158",
          "zh": "敵軍來襲，大本與游擊王天培、王國祐同亡於陣。",
          "translations": []
        },
        {
          "id": "s0159",
          "zh": "時武備學生於光炘、周憲章、李國華、辛得林並赳健士，伏要隘，狙擊敵前鋒，以接應不至，皆死焉。",
          "translations": []
        },
        {
          "id": "s0160",
          "zh": "士成旋繞渡大同江至平壤與諸軍合，軍無鬥志，潰退相繼。",
          "translations": []
        },
        {
          "id": "s0161",
          "zh": "獨左寶貴扼險惡戰，死最烈，自有傳。",
          "translations": []
        },
        {
          "id": "s0162",
          "zh": "自是朝鮮無我駐軍，敵遂內犯。",
          "translations": []
        }
      ],
      "translations": []
    },
    {
      "type": "paragraph",
      "sentences": [
        {
          "id": "s0163",
          "zh": "黃祖蓮，安徽懷遠人。",
          "translations": []
        },
        {
          "id": "s0164",
          "zh": "少有志節，嘗思立功異域。",
          "translations": []
        },
        {
          "id": "s0165",
          "zh": "光緒初，入上海廣方言館，列優等，送美國遊學。",
          "translations": []
        },
        {
          "id": "s0166",
          "zh": "調天津水師駕駛學堂，旋派赴威遠兵輪練習。",
          "translations": []
        },
        {
          "id": "s0167",
          "zh": "敘千總，署海軍中軍左營守備，充濟遠駕駛二副。",
          "translations": []
        },
        {
          "id": "s0168",
          "zh": "海軍出力，以都司升用。",
          "translations": []
        },
        {
          "id": "s0169",
          "zh": "中日釁啟，說丁汝昌以「嚴兵扼守海口，而以兵艦往搗之，攻其不備，否則載勁旅抵朝鮮東偏釜山鎮等處，深溝高壘，絕其歸路，分兵徇朝鮮諸郡邑，彼進則迎擊，彼退則尾追，又出偏師撓之。",
          "translations": []
        },
        {
          "id": "s0170",
          "zh": "彼糧盡援竭，人無鬥志，必土崩瓦解，此俄羅斯破法蘭西之計也。",
          "translations": []
        },
        {
          "id": "s0171",
          "zh": "」汝昌不從。",
          "translations": []
        },
        {
          "id": "s0172",
          "zh": "及大東溝將戰，又說以「海戰宜乘上風，兵法貴爭先著。",
          "translations": []
        },
        {
          "id": "s0173",
          "zh": "今西北風利，宜乘其兵輪未集，急擊不可失」。",
          "translations": []
        },
        {
          "id": "s0174",
          "zh": "汝昌復不決，遂失利。",
          "translations": []
        }
      ],
      "translations": []
    },
    {
      "type": "paragraph",
      "sentences": [
        {
          "id": "s0175",
          "zh": "十二月，日人棄西路，南擾山東，祖蓮佐總兵劉步蟾等守威海。",
          "translations": []
        },
        {
          "id": "s0176",
          "zh": "時官軍集關外，東路兵單，日軍由落風港登陸，攻陷榮成，全力萃威海​​。",
          "translations": []
        },
        {
          "id": "s0177",
          "zh": "祖蓮揮將士開砲擊敵，敵少卻，既復大集，諸軍皆潰。",
          "translations": []
        },
        {
          "id": "s0178",
          "zh": "二十一年正月，道員戴宗騫以力盡援絕投海，越數日，祖蓮與劉步蟾及總兵張文宣、楊用霖等俱死之。",
          "translations": []
        },
        {
          "id": "s0179",
          "zh": "時汝昌書降於敵，且要敵軍不得殘馀軍，仰藥死。",
          "translations": []
        },
        {
          "id": "s0180",
          "zh": "後以死綏上聞，旨不予卹。",
          "translations": []
        },
        {
          "id": "s0181",
          "zh": "或謂汝昌實為所部脅降，憤而自盡，降書則死後出洋弁手也。",
          "translations": []
        }
      ],
      "translations": []
    },
    {
      "type": "paragraph",
      "sentences": [
        {
          "id": "s0182",
          "zh": "時旅順先陷，海軍掃地，黃海諸要隘皆失守，將士多死事，以奏報有缺，不得書。",
          "translations": []
        },
        {
          "id": "s0183",
          "zh": "其見奏報者，三等侍衛永山，在鳳凰城戰歿；",
          "translations": []
        },
        {
          "id": "s0184",
          "zh": "游擊李世鴻、副將李仁黨與提督楊壽山分守蓋平，禦敵大將乃木軍，戰最烈，同時以力盡陣亡。",
          "translations": []
        },
        {
          "id": "s0185",
          "zh": "步蟾、宗騫自有傳。",
          "translations": []
        }
      ],
      "translations": []
    }
  ]
}