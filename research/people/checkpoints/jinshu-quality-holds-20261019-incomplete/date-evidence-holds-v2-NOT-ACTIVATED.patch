+// An explicit evidence hold is a publication gate, not a replacement audit.
+// Its fingerprints identify the defective evidence reviewed when the hold was
+// created; they intentionally do not expire when the current files change.
+export function dateAuditEvidenceHold(book, chapter, { peopleDir = PEOPLE_DIR } = {}) {
+  validateDateAuditScope(book, chapter);
+  // The single tracked manifest is included by existing sparse checkout rules.
+  // It is mandatory: absence cannot safely mean an empty set of holds.
+  const file = path.join(peopleDir, 'date-audit-holds.json');
+  const manifest = readJson(file);
+  if (!manifest || manifest.schemaVersion !== 1 || !Array.isArray(manifest.holds)) throw new Error(`Invalid date audit evidence hold manifest: ${file}`);
+  const fingerprint = value => typeof value === 'string' && /^sha256:[a-f0-9]{64}$/.test(value);
+  const seen = new Set();
+  for (const hold of manifest.holds) {
+    if (!hold || typeof hold !== 'object' || Array.isArray(hold) || hold.status !== 'active' ||
+        typeof hold.book !== 'string' || !/^[a-z0-9_-]+$/.test(hold.book) ||
+        typeof hold.chapter !== 'string' || !/^\d{3}$/.test(hold.chapter) ||
+        hold.auditVersion !== DATE_AUDIT_VERSION || !fingerprint(hold.reportFileHash) ||
+        !fingerprint(hold.sourceHash) || !fingerprint(hold.extractionHash) ||
+        typeof hold.reason !== 'string' || hold.reason.trim().length < 20 ||
+        typeof hold.reportedBy !== 'string' || !hold.reportedBy.trim() ||
+        typeof hold.createdAt !== 'string' || !Number.isFinite(Date.parse(hold.createdAt)) ||
+        !Array.isArray(hold.evidence) || !hold.evidence.length || hold.evidence.some(item =>
+          !item || typeof item.path !== 'string' || !item.path.trim() || path.isAbsolute(item.path) ||
+          item.path.split(/[\\/]/).some(part => part === '..' || part === '') || !fingerprint(item.sha256))) {
+      throw new Error(`Invalid date audit evidence hold in ${file}`);
+    }
+    const key = `${hold.book}:${hold.chapter}`;
+    if (seen.has(key)) throw new Error(`Duplicate date audit evidence hold for ${key}`);
+    seen.add(key);
+  }
+  return manifest.holds.find(hold => hold.book === book && hold.chapter === chapter) ?? null;
+}
