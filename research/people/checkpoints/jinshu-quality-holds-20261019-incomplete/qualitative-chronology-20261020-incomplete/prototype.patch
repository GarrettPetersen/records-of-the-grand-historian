+  // descriptions. Do not allow a qualitative value to conceal that work.
+  const numberedYear = /(?:[元正初一二三四五六七八九十百千廿卅兩〇零\d]+年|\b(?:first|second|third|fourth|fifth|sixth|seventh|eighth|ninth|tenth|\d+(?:st|nd|rd|th)?)\s+(?:regnal\s+)?year\b|\b(?:AD|BC|BCE|CE)\s*\d)/iu;
+  return Boolean(value && typeof value.sourceDate?.text === 'string' && value.sourceDate.text.trim() &&
+    value.sourceDate.regnalYear === undefined && !numberedYear.test(sourceText) &&
