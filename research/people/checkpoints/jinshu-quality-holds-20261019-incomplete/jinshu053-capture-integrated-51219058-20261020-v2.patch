+test('mixed death chronology remains held until repaired and independently re-audited', t => {
+  const f = fixture(t);
+  const original = structuredClone(f.report);
+  recordDateAudit(original, f.options);
+  const held = f.extraction.claims[0][2];
+  held.endDate = { sourceDate: { text: 'possibly first year' }, unresolved: true,
+    unresolvedReason: 'The surviving heading may not describe the same death event.' };
+  writeJsonAtomic(f.extractionFile, f.extraction);
+  assert.equal(dateAuditStatus('fixture', '001', f.options).status, 'stale');
+  const packet = buildDateAuditPacket('fixture', '001', f.options);
+  const current = { ...original, sourceHash: packet.sourceHash, extractionHash: packet.extractionHash };
+  assert.throws(() => validateDateAuditReport(current, packet), /Unresolved chronology/);
+  const product = { book: 'fixture', chapters: ['001'] };
+  assert.match(ebookCurrentDateErrors(product, { getStatus: (book, chapter) => dateAuditStatus(book, chapter, f.options) }).join(' '), /stale/);
+  const context = { active: true, catalog: { people: [{ localPeople: ['fixture:001:p001'], curation: { status: 'clear' } }] },
+    siteIndex: { currentPromptVersion: 7, chapters: { 'fixture:001': { promptVersion: 7, dateAudit: dateAuditStatus('fixture', '001', f.options) } } } };
+  assert.equal(assessEbookPeopleReadiness(context, product).ready, false);
+  // This is synthetic evidence only: real repairs need source review and a
+  // fresh independent reviewer, not removal of an inconvenient hold.
+  delete held.endDate;
+  held.dateContext.westernBounds = { before: year(471) };
+  writeJsonAtomic(f.extractionFile, f.extraction);
+  const repaired = buildDateAuditPacket('fixture', '001', f.options);
+  const fresh = { ...original, extractionHash: repaired.extractionHash, reviewer: { name: 'Second independent fixture reviewer', independentOfExtractor: true } };
+  recordDateAudit(fresh, f.options);
+  const repairedStatus = dateAuditStatus('fixture', '001', f.options);
+  assert.equal(repairedStatus.status, 'audited');
+  assert.deepEqual(ebookCurrentDateErrors(product, { getStatus: (book, chapter) => dateAuditStatus(book, chapter, f.options) }), []);
+  context.siteIndex.chapters['fixture:001'].dateAudit = repairedStatus;
+  assert.equal(assessEbookPeopleReadiness(context, product).ready, true);
+});
