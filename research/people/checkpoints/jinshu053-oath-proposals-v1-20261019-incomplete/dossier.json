    {
      "proposal": {
        "id": "jinshu:053:r0115",
        "unit": {
          "id": "s0053",
          "kind": "paragraph-sentence",
          "blockIndex": 5,
          "collection": "sentences",
          "itemIndex": 9
        },
        "field": "literal",
        "before": "We shall eat raw flesh and drink blood beneath the three luminaries; High Heaven grants us leave to sweep away the scourge, enthrone Daowen as king, and install Jiang as inner mistress.",
        "after": "Chewing hair and drinking blood beneath the three luminaries, High Heaven permits it; we shall sweep away the harm, establish Daowen as king, and make Jiang the inner ruler.",
        "reason": "Restore the oath imagery, Daowen and Jiang in the forged document; Hu Sanxing reads the oath as a covenant. The division of 許/當 and modal force remain interpretive; exact-field independent decision and reconciliation are required.",
        "confidence": "high"
      },
      "context": [
        {
          "id": "s0051",
          "focus": false,
          "zh": "不了，吾當手了之。",
          "idiomatic": "Or I will kill her myself.",
          "literal": "If she does not settle them I will finish her with my own hand."
        },
        {
          "id": "s0052",
          "focus": false,
          "zh": "並謝妃共要克期而兩發，勿疑猶豫，致後患。",
          "idiomatic": "Consort Xie and I strike together—no delay.",
          "literal": "Together with Consort Xie we agreed a joint date for simultaneous rising—do not hesitate and breed later trouble."
        },
        {
          "id": "s0053",
          "focus": true,
          "zh": "茹毛飲血於三辰之下，皇天許當掃除患害，立道文為王，蔣為內主。",
          "idiomatic": "Heaven blesses our coup—crown Daowen, empower Lady Jiang.",
          "literal": "We shall eat raw flesh and drink blood beneath the three luminaries; High Heaven grants us leave to sweep away the scourge, enthrone Daowen as king, and install Jiang as inner mistress."
        },
        {
          "id": "s0054",
          "focus": false,
          "zh": "願成，當三牲祠北君，大赦天下。",
          "idiomatic": "Then sacrifice to the Northern Lord and amnesty all.",
          "literal": "When wish is fulfilled we shall sacrifice three victims to the Northern Lord and proclaim an empire-wide amnesty."
        },
        {
          "id": "s0055",
          "focus": false,
          "zh": "要疏如律令。」",
          "idiomatic": "So commands the spell.'",
          "literal": "Let the petition follow lawful summons.'"
        }
      ],
