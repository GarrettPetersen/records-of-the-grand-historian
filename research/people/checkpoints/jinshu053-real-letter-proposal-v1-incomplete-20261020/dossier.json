        },
        "field": "literal",
        "before": "Though not born of the inner palace I served her as my own mother.",
        "after": "Although I was not born to the empress, I served her as if she were my own mother.",
        "reason": "Proposed independently assessed first-person letter wording; requires an authentic decision on this exact dossier and source/mention reconciliation.",
        "confidence": "high"
      },
      "context": [
        {
          "id": "s0073",
          "focus": false,
          "zh": "初，太子之廢也，妃父王衍表請離婚。",
          "idiomatic": "Wang Yan filed for divorce the moment Yu fell.",
          "literal": "When the crown prince was first deposed, his father-in-law Wang Yan memorialized requesting divorce."
        },
        {
          "id": "s0074",
          "focus": false,
          "zh": "太子至許，遺妃書曰：「鄙雖頑愚，心念為善，欲盡忠孝之節，無有惡逆之心。",
          "idiomatic": "After reaching Xu he sent his consort a letter: \"Though I am coarse and foolish, at heart I wished to do good and fulfill loyalty and filial piety—I harbored no rebellious evil.",
          "literal": "After the crown prince reached Xu he sent his consort a letter: 'Though I am coarse and foolish at heart I wished to do good and fulfill loyalty and filial piety—I harbored no rebellious evil."
        },
        {
          "id": "s0075",
          "focus": true,
          "zh": "雖非中宮所生，奉事有如親母。",
          "idiomatic": "He claimed dutiful service to Jia despite birth.",
          "literal": "Though not born of the inner palace I served her as my own mother."
        },
        {
          "id": "s0076",
          "focus": false,
          "zh": "自為太子以來，敕見禁檢，不得見母。",
          "idiomatic": "Palace rules barred him from Lady Xie.",
          "literal": "Since becoming crown prince edicts confined me—I could not see my mother."
        },
        {
          "id": "s0077",
          "focus": false,
          "zh": "自宜城君亡，不見存恤，恆在空室中坐。",
          "idiomatic": "Since the Lady of Yicheng died I received no comforting word—I constantly sat alone in empty rooms.",
          "literal": "Since Princess Dowager Xuan city died I received no comforting word—I constantly sat alone in empty rooms."
        }
      ],
