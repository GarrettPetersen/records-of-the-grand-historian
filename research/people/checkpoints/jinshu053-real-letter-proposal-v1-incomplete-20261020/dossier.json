        "field": "idiomatic",
        "before": "Since the Lady of Yicheng died I received no comforting word—I constantly sat alone in empty rooms.",
        "after": "Since the Lady of Yicheng died, I have received no care or concern, and have constantly sat in an empty room.",
        "reason": "Proposed independently assessed first-person letter wording; requires an authentic decision on this exact dossier and source/mention reconciliation.",
        "confidence": "high"
      },
      "context": [
        {
          "id": "s0075",
          "focus": false,
          "zh": "雖非中宮所生，奉事有如親母。",
          "idiomatic": "He claimed dutiful service to Jia despite birth.",
          "literal": "Though not born of the inner palace I served her as my own mother."
        },
        {
          "id": "s0076",
          "focus": false,
          "zh": "自為太子以來，敕見禁檢，不得見母。",
          "idiomatic": "Palace rules barred him from Lady Xie.",
          "literal": "Since becoming crown prince edicts confined me—I could not see my mother."
        },
        {
          "id": "s0077",
          "focus": true,
          "zh": "自宜城君亡，不見存恤，恆在空室中坐。",
          "idiomatic": "Since the Lady of Yicheng died I received no comforting word—I constantly sat alone in empty rooms.",
          "literal": "Since Princess Dowager Xuan city died I received no comforting word—I constantly sat alone in empty rooms."
        },
        {
          "id": "s0078",
          "focus": false,
          "zh": "去年十二月，道文疾病困篤，父子之情，實相憐湣。",
          "idiomatic": "He mourned son Daowen's fatal illness.",
          "literal": "Last twelfth month Daowen's illness grew desperate—father and son pitied each other truly."
        },
        {
          "id": "s0079",
          "focus": false,
          "zh": "于時表國家乞加徽號，不見聽許。",
          "idiomatic": "His plea for son's title failed.",
          "literal": "Then I petitioned the throne for honors—permission never came."
        }
      ],
