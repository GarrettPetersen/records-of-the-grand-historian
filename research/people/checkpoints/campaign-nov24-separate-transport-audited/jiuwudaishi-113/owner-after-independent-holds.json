        {
          "unit": "jiuwudaishi:113:s0049",
          "zh": "丁酉，詔曰：「京兆、鳳翔府、同、華、邠、延、鄜、耀等州所管州縣軍鎮，頃因唐末藩鎮殊風，久歷歲時，未能厘革，政途不一，何以教民。"
        },
        {
          "unit": "jiuwudaishi:113:s0057",
          "zh": "八月己酉，幸南莊。"
        },
        {
          "unit": "jiuwudaishi:113:s0067",
          "zh": "詔劉言勒歸私第，委王進逵取便安置。"
        },
        {
          "unit": "jiuwudaishi:113:s0016",
          "zh": "五月己卯朔，帝御崇元殿受朝賀，仗衛如儀。"
        }
      ]
    }
