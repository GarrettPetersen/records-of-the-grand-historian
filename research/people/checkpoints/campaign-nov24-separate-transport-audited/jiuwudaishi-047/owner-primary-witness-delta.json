      "primaryWitnessUnits": [
        {
          "unit": "jiuwudaishi:047:s0001",
          "zh": "清泰二年春正月丙申朔，帝御明堂殿受朝賀，仗衛如式。"
        },
        {
          "unit": "jiuwudaishi:047:s0044",
          "zh": "逢陛下惟新之運，是文明革弊之秋，臣請應內外所管軍人，凡勝衣甲者，請宣下本部大將一一考試武藝短長，權謀深淺。"
        },
        {
          "unit": "jiuwudaishi:047:s0050",
          "zh": "帝召學士馬裔孫謂曰：「史在德語太凶，其實難容。"
        },
        {
          "unit": "jiuwudaishi:047:s0072",
          "zh": "夏四月辛巳，宰臣判三司張延朗奏：「州縣官征科條格，其令錄在任征科，依限了絕，一年加階，兩年與試銜，三年皆及限了絕，與服色。"
        },
        {
          "unit": "jiuwudaishi:047:s0079",
          "zh": "從之。"
        },
        {
          "unit": "jiuwudaishi:047:s0082",
          "zh": "詔其新編敕如可施行，付御史台頒行。"
        },
        {
          "unit": "jiuwudaishi:047:s0092",
          "zh": "乙巳，詔：「天下見禁囚徒，自五月十二日以前，除十惡五逆、放火燒舍、持仗殺人、官典犯贓、偽行印信、合造毒藥並見欠省錢外，罪無輕重，一切釋放。」"
        },
        {
          "unit": "jiuwudaishi:047:s0097",
          "zh": "詔曰：「偏旁文字，音韻懸殊，止避正呼，不宜全改。"
        }
      ],
