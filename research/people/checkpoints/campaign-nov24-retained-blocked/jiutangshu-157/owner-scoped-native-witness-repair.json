    {
      "localPersonId": "p019",
      "caseId": "sha256:f987660db9a20dabdea5d7634b18f359a7619741d4617cd3c3e308ae7d49a364",
      "retainedEnglishName": "Grandfather of Liu Nai",
      "retainedChineseKey": "劉迺祖父",
      "witnessUnits": [
        {
          "unitId": "s0054",
          "zh": "高祖武幹，武德初拜侍中，即中書侍郎林甫從祖兄子也。",
          "literal": "His great-grandfather Wu Gan was appointed Palace Attendant at the beginning of Wude; he was the son of the paternal cousin of Zhongshu Vice Director Linpu.",
          "idiomatic": "His great-grandfather Wu Gan was made Palace Attendant at the start of the Wude era; he was a cousin of Zhongshu Vice Director Linpu."
        },
        {
          "unitId": "s0055",
          "zh": "父如璠，昫山丞，以迺貴，贈民部郎中。",
          "literal": "His father Ru Fan was assistant magistrate of Xushan; because of Nai's eminence he was posthumously made Director in the Ministry of Revenue.",
          "idiomatic": "His father Ru Fan had been assistant magistrate of Xushan; because of Nai's eminence he was posthumously made director in the Ministry of Revenue."
        }
      ],
      "conclusion": "outside-named-person-glossary",
      "reason": "Owned units name Liu Nai's great-grandfather Wu Gan (高祖武幹) and father Ru Fan (父如璠) only. No Chinese name span or kinship line names a distinct grandfather figure; p019 is an inferred gap-filler, not a source-named person."
    },
    {
      "localPersonId": "p051",
      "caseId": "sha256:f7dc4675787f7b04283f518be94efd5ba9553ac300b6e7bc8b7cffed23c9d399",
      "pairedLocalPersonId": "p044",
      "witnessUnits": [
        {
          "unitId": "s0098",
          "zh": "子伯芻。",
          "literal": "His son was Boqu.",
          "idiomatic": "His son was Boqu."
        },
        {
          "unitId": "s0099",
          "zh": "伯芻，字素芝，登進士第，誌行修謹。",
          "literal": "Boqu, courtesy name Suzhi, passed the jinshi examination; his conduct and aims were cultivated and careful.",
          "idiomatic": "Boqu, courtesy name Suzhi, passed the jinshi examination. His conduct was cultivated and careful."
        },
        {
          "unitId": "s0112",
          "zh": "子寬夫，登進士第，歷諸府從事。",
          "literal": "His son Kuanfu passed the jinshi examination and served as staff officer in various offices.",
          "idiomatic": "His son Kuanfu passed the jinshi examination and served as staff officer in various provincial offices."
        }
      ],
      "conclusion": "duplicate-local-person-delete-p051-retain-p044",
      "reason": "劉伯芻 / Boqu is independently named on p044 (surfaces s0098–s0111). p051 duplicates the same individual using only s0112, where the father is unstated in Chinese and cannot be quoted without inventing a standalone name span on that unit. No second person is attested."
    },
    {
      "localPersonId": "p062",
      "caseId": "sha256:12a12f1f50f4d91e2c17c7c7157229b83e1329f53e86692b822de79996b44a65",
      "witnessUnits": [
        {
          "unitId": "s0131",
          "zh": "袁高，字公頤，恕己之孫。",
          "literal": "Yuan Gao, courtesy name Gongyi, was the grandson of Shuji.",
          "idiomatic": "Yuan Gao, courtesy name Gongyi, was the grandson of Shuji."
        }
      ],
      "conclusion": "outside-named-person-glossary",
      "reason": "The only owned unit states grandson-of-Shuji; no parent name or separate actor appears. Parent-of-Yuan-Gao is not a named chapter person."
    }
  ],
