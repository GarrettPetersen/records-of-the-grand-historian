    {
      "caseId": "sha256:b4e38bf6246226a0a02eb7a316d39290c54345bb17e1e0d88c13bbb8ea482fcc",
      "localId": "songshu:063:p050",
      "independentVerdict": "hold",
      "canonicalPersonId": "per_K8T9RA3DZS0W6WHPK01K",
      "determination": "outside-named-person-glossary",
      "rationale": "Primary text names Wang Tanshou (王曇首) and titles Hong as 太保弘 but does not supply any personal name, courtesy name, or kinship-labeled personal designation for their father. The local record is an entailed descriptive-kinship placeholder (父 / Father of Wang Hong and Wang Tanshou), not a source-backed named person.",
      "sourceWitnesses": [
        {
          "unitId": "s0056",
          "zh": "王曇首，琅邪臨沂人，太保弘少弟也。",
          "enLiteral": "Wang Tanshou, a native of Linyi in Langye, was the younger brother of Grand Tutor Hong.",
          "enIdiomatic": "Wang Tanshou came from Linyi in Langye and was the younger brother of Grand Tutor Wang Hong."
        },
        {
          "unitId": "s0075",
          "zh": "太祖入奉大統，上及議者皆疑不敢下，曇首與到彥之、從兄華固勸，上猶未許。",
          "enLiteral": "The Taizu entered to receive the great succession. The Emperor and all who deliberated were doubtful and dared not descend. Tanshou with Dao Yanzhi and his cousin Hua firmly urged him, but the Emperor still did not assent.",
          "enIdiomatic": "The prince went in to accept the great succession. The emperor and his advisers were all afraid and hesitated to step down. Tanshou, Dao Yanzhi, and his cousin Hua pressed him hard, but the emperor still would not agree."
        }
      ],
      "proposal": "delete-local-person-and-dependent-rows",
      "retainNamedPeople": ["p025", "p026", "p038", "p023", "p048"],
      "retainExplicitKinship": "p025 sibling-of p026 remains on s0056/s0269 (太保弘少弟); no father person record."
    },
    {
      "caseId": "sha256:51ca36bf2f6ec55518eae7eae0af78dcf3a83b392830583beb654e396627bb9b",
      "localId": "songshu:063:p051",
      "independentVerdict": "hold",
      "canonicalPersonId": "per_EQWGH317BNJY89BQ25FR",
      "determination": "outside-named-person-glossary",
      "rationale": "s0060 names Wang Qiu (球) as Tanshou's paternal cousin (從弟) but does not name Qiu's father. The local record entailed a father person from kinship topology only; there is no blocking personal Chinese name in the witness span.",
      "sourceWitnesses": [
        {
          "unitId": "s0060",
          "zh": "與從弟球俱詣高祖，時謝晦在坐，高祖曰：「此君並膏粱盛德，乃能屈志戎旅。」",
          "enLiteral": "Together with his cousin Qiu he visited Gaozu. Xie Hui was then present. Gaozu said, \"These gentlemen are both noble scions of eminent virtue—yet they can humble their ambition to military service.\"",
          "enIdiomatic": "He went with his cousin Qiu to call on Gaozu while Xie Hui was present. Gaozu said, \"Both of these men are noble scions of great families, yet they are willing to humble themselves to camp life.\""
        }
      ],
      "proposal": "delete-local-person-and-dependent-rows",
      "retainNamedPeople": ["p026", "p038"],
      "retainExplicitKinship": "p026 kin-of p038 on 從弟球 (s0060) without phantom intermediary fathers."
    }
  ],
