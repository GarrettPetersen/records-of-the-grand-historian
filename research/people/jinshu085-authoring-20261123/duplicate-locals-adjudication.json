          "descriptor": "Rebel",
          "units": [
            "s0212"
          ],
          "unitSnippets": [
            {
              "id": "s0212",
              "zh": "及玄篡位，無忌與玄吏部郎曹靖之有舊，請蒞小縣。"
            }
          ]
        },
        {
          "id": "p103",
          "en": "Huan Xuan",
          "descriptor": "Rebel",
          "units": [
            "s0222",
            "s0224",
            "s0225",
            "s0226",
            "s0227"
          ],
          "unitSnippets": [
            {
              "id": "s0222",
              "zh": "初，桓玄聞裕等及無忌之起兵也，甚懼。"
            },
            {
              "id": "s0224",
              "zh": "玄曰：「劉裕勇冠三軍，當今無敵。"
            },
            {
              "id": "s0225",
              "zh": "劉毅家無儋石之儲，樗蒱一擲百萬。"
            }
          ]
        },
