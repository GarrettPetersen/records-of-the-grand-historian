          "id": "p098",
          "en": "Liu Laozhi",
          "descriptor": "General",
          "units": [
            "s0208",
            "s0211"
          ],
          "unitSnippets": [
            {
              "id": "s0208",
              "zh": "鎮北將軍劉牢之，即其舅也，時鎮京口，每有大事，常與參議之。"
            },
            {
              "id": "s0211",
              "zh": "隨牢之南征桓玄，牢之將降于玄也，無忌屢諫，辭旨甚切，牢之不從。"
            }
          ]
        },
        {
          "id": "p107",
          "en": "Liu Laozhi",
          "descriptor": "General",
          "units": [
            "s0226"
          ],
          "unitSnippets": [
            {
              "id": "s0226",
              "zh": "何無忌，劉牢之之甥，酷似其舅。"
            }
          ]
        }
      ]
    },
    {
