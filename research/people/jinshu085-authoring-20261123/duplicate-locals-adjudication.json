            "s0099",
            "s0100",
            "s0101",
            "s0104",
            "s0105",
            "s0123",
            "s0124"
          ],
          "unitSnippets": [
            {
              "id": "s0086",
              "zh": "時否而政不革，人凋而事不損，則無以救急病于已危，拯塗炭於將絕。"
            },
            {
              "id": "s0087",
              "zh": "自頃戎車屢駭，干戈溢境，所統江州，以一隅之地當逆順之沖，自桓玄以來，驅蹙殘敗，至乃男不被養，女無匹對，逃亡去就，不避幽深"
            },
            {
              "id": "s0088",
              "zh": "若不曲心矜理，有所厘改，則靡遺之歎奄焉必及。"
            }
          ]
        },
        {
          "id": "p063",
          "en": "Liu Yi",
          "descriptor": "General",
          "units": [
            "s0126",
            "s0128",
            "s0129",
            "s0130",
            "s0131",
            "s0132",
