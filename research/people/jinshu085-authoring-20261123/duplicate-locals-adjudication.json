          "units": [
            "s0290",
            "s0314"
          ],
          "unitSnippets": [
            {
              "id": "s0290",
              "zh": "及桓玄將皇甫敷之至羅落橋也，憑之與裕各領一隊而戰，軍敗，為敷軍所害。"
            },
            {
              "id": "s0314",
              "zh": "既出，玄鄙其精神不雋，謂坐客曰：「庸神而宅偉幹，不成令器。」"
            }
          ]
        }
