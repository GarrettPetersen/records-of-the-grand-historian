            "s0174"
          ],
          "unitSnippets": [
            {
              "id": "s0174",
              "zh": "于時桓歆聚眾向曆陽，長民擊走之，又與劉敬宣破歆於芍陂，封新淦縣公，食邑二千五百戶，以本官督淮北諸軍事，鎮山陽。"
            }
          ]
        },
        {
          "id": "p136",
          "en": "Huan Xin",
          "descriptor": "Rebel",
          "units": [
            "s0318"
          ],
          "unitSnippets": [
            {
              "id": "s0318",
              "zh": "桓歆寇曆陽，詠之率眾擊走之。"
            }
          ]
        }
      ]
    },
    {
      "chineseName": "劉牢之",
      "englishName": "Liu Laozhi",
      "localIds": [
        "p098",
        "p107"
      ],
      "sourceAdjudication": "same-person-by-source: exact Chinese name and chapter narrative treat these as one historical actor across section-local extractions; do not silently certify canonical membership without native identity review.",
      "unresolvedIdentity": true,
      "mergeApplied": false,
      "locals": [
