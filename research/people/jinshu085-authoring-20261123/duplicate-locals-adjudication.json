            "s0085"
          ],
          "unitSnippets": [
            {
              "id": "s0047",
              "zh": "初，毅丁憂在家，及義旗初興，遂墨絰從事。"
            },
            {
              "id": "s0048",
              "zh": "至是，軍役漸寧，上表乞還京口，以終喪禮，曰：「弘道為國者，理盡於仁孝。"
            },
            {
              "id": "s0049",
              "zh": "訴窮歸天者，莫甚於喪親。"
            }
          ]
        },
        {
          "id": "p049",
          "en": "Liu Yi",
          "descriptor": "General",
          "units": [
            "s0086",
            "s0087",
            "s0088",
            "s0089",
