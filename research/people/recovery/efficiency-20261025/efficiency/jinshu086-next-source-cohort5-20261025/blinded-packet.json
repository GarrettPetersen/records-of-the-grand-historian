  "sourceFields": "Complete unabridged Chinese units with IDs and block indexes. English translations are omitted because they are not independent source evidence; no Chinese units are truncated.",
  "units": [
    {
      "id": "s0495",
      "zh": "駿子重華",
      "blockIndex": 45
    },
    {
      "id": "s0496",
      "zh": "=重華字泰臨，駿之第二子也。",
      "blockIndex": 46
    },
    {
      "id": "s0497",
      "zh": "寬和懿重，沈毅少言。",
      "blockIndex": 46
    },
    {
      "id": "s0498",
      "zh": "父卒，時年十六。",
      "blockIndex": 46
    },
    {
      "id": "s0499",
      "zh": "以永和二年自稱持節、大都督、太尉、護羌校尉、涼州牧、西平公、假涼王，赦其境內。",
      "blockIndex": 46
    },
    {
      "id": "s0500",
      "zh": "尊其母嚴氏為太王太后，居永訓宮；",
      "blockIndex": 46
    },
    {
      "id": "s0501",
      "zh": "所生母馬氏為王太后，居永壽宮。",
      "blockIndex": 46
    },
    {
      "id": "s0502",
      "zh": "輕賦斂，除關稅，省園囿，以恤貧窮。",
      "blockIndex": 46
    },
    {
      "id": "s0503",
      "zh": "遣使奉章于石季龍。",
      "blockIndex": 47
    },
    {
      "id": "s0504",
      "zh": "季龍使王擢、麻秋、孫伏都等侵寇不輟。",
      "blockIndex": 47
    },
    {
      "id": "s0505",
      "zh": "金城太守張沖降於秋。",
      "blockIndex": 47
    },
    {
      "id": "s0506",
      "zh": "於是涼州振動。",
      "blockIndex": 47
    },
    {
      "id": "s0507",
      "zh": "重華掃境內，使其征南將軍裴恆禦之。",
      "blockIndex": 47
    },
    {
      "id": "s0508",
      "zh": "恆壁于廣武，欲以持久弊之。",
      "blockIndex": 47
    },
    {
      "id": "s0509",
      "zh": "牧府相司馬張耽言于重華曰：「臣聞國以兵為強，以將為主。",
      "blockIndex": 47
    },
    {
      "id": "s0510",
      "zh": "主將者，存亡之機，吉凶所系。",
      "blockIndex": 47
    },
    {
      "id": "s0511",
      "zh": "故燕任樂毅，克平全齊，及任騎劫，喪七十城之地。",
      "blockIndex": 47
    },
    {
      "id": "s0512",
      "zh": "是以古之明君靡不慎於將相也。",
      "blockIndex": 47
    },
    {
      "id": "s0513",
      "zh": "今之所要，在於軍師。",
      "blockIndex": 47
    },
    {
      "id": "s0514",
      "zh": "然議者舉將多推宿舊，未必妙盡精才也。",
      "blockIndex": 47
    },
    {
      "id": "s0515",
      "zh": "且韓信之舉，非舊名也；",
      "blockIndex": 47
    },
    {
      "id": "s0516",
      "zh": "穰宜之信，非舊將也；",
      "blockIndex": 47
    },
    {
      "id": "s0517",
      "zh": "呂蒙之進，非舊勳也；",
      "blockIndex": 47
    },
    {
      "id": "s0518",
      "zh": "魏延之用，非舊德也。",
      "blockIndex": 47
    },
    {
      "id": "s0519",
      "zh": "蓋明王之舉，舉無常人，才之所能，則授以大事。",
      "blockIndex": 47
    },
    {
      "id": "s0520",
      "zh": "今強寇在郊，諸將不進，人情騷動，危機稍逼。",
      "blockIndex": 47
    },
    {
      "id": "s0521",
      "zh": "主簿謝艾，兼資文武，明識兵略，若授以斧鉞，委以專征，必能折沖禦侮，殲殄凶類。」",
      "blockIndex": 47
    },
    {
      "id": "s0522",
      "zh": "重華召艾，問以討寇方略。",
      "blockIndex": 47
    },
    {
      "id": "s0523",
      "zh": "艾曰：「昔耿弇不欲以賊遺君父，黃權願以萬人當寇。",
      "blockIndex": 47
    },
    {
      "id": "s0524",
      "zh": "乞假臣兵七千，為殿下吞王擢、麻秋等。」",
      "blockIndex": 47
    },
    {
      "id": "s0525",
      "zh": "重華大悅，以艾為中堅將軍，配步騎五千擊秋。",
      "blockIndex": 47
    },
    {
      "id": "s0526",
      "zh": "引師出振武，夜有二梟鳴於牙中，艾曰：「梟，邀也，六博得梟者勝。",
      "blockIndex": 47
    },
    {
      "id": "s0527",
      "zh": "今梟鳴牙中，克敵之兆。」",
      "blockIndex": 47
    },
    {
      "id": "s0528",
      "zh": "於是進戰，大破之，斬首五千級。",
      "blockIndex": 47
    },
    {
      "id": "s0529",
      "zh": "重華封艾為福祿伯，善待之。",
      "blockIndex": 47
    },
    {
      "id": "s0530",
      "zh": "諸寵貴惡其賢，共毀譖之，乃出為酒泉太守。",
      "blockIndex": 47
    },
    {
      "id": "s0531",
      "zh": "季龍又令麻秋進陷大夏，大夏護軍梁式執太守宋晏，以城應秋。",
      "blockIndex": 48
    },
    {
      "id": "s0532",
      "zh": "秋遣晏以書誘宛戍都尉宋矩。",
      "blockIndex": 48
    },
    {
      "id": "s0533",
      "zh": "宋矩謂秋曰：「辭父事君，當立功義；",
      "blockIndex": 48
    },
    {
      "id": "s0534",
      "zh": "功義不立，當守名節。",
      "blockIndex": 48
    },
    {
      "id": "s0535",
      "zh": "矩終不肯主偷生於世。」",
      "blockIndex": 48
    },
    {
      "id": "s0536",
      "zh": "於是先殺妻子，自刎而死。",
      "blockIndex": 48
    },
    {
      "id": "s0537",
      "zh": "是月，有司議遣司兵趙長迎秋西郊。",
      "blockIndex": 49
    },
    {
      "id": "s0538",
      "zh": "謝艾以《春秋》之義，國有大喪，省蒐狩之禮，宜待逾年。",
      "blockIndex": 49
    },
    {
      "id": "s0539",
      "zh": "別駕從事索遐議曰：「禮，天子崩，諸侯薨，末殯，五祀不行，既殯而行之。",
      "blockIndex": 49
    },
    {
      "id": "s0540",
      "zh": "魯宣三年，天王崩，不廢郊祀。",
      "blockIndex": 49
    },
    {
      "id": "s0541",
      "zh": "今聖上統承大位，百揆惟新，宜在璿璣玉衡以齊七政。",
      "blockIndex": 49
    },
    {
      "id": "s0542",
      "zh": "立秋，萬物將成，殺氣之始，其于王事，杖麾誓眾，釁鼓禮神，所以討逆除暴，成功濟務，寧宗廟社稷，致天下之福，不可廢也。」",
      "blockIndex": 49
    },
    {
      "id": "s0543",
      "zh": "重華從之。",
      "blockIndex": 49
    },
    {
      "id": "s0544",
      "zh": "俄而麻秋進攻枹罕，時晉陽太守郎坦以城大難守，宜棄外城。",
      "blockIndex": 50
    },
    {
      "id": "s0545",
      "zh": "武城太守張悛曰：「棄外城則大事去矣，不可以動眾心。」",
      "blockIndex": 50
    },
    {
      "id": "s0546",
      "zh": "甯戎校尉張璩從之，固守大城。",
      "blockIndex": 50
    },
    {
      "id": "s0547",
      "zh": "秋率眾八萬，圍塹數重，雲梯雹車，地突百道，皆通於內。",
      "blockIndex": 50
    },
    {
      "id": "s0548",
      "zh": "城中亦應之，殺傷秋眾已數萬。",
      "blockIndex": 50
    },
    {
      "id": "s0549",
      "zh": "季龍復遣其將劉渾等率步騎二萬會之。",
      "blockIndex": 50
    },
    {
      "id": "s0550",
      "zh": "郎坦恨言之不從，教軍士李嘉潛與秋通，引賊千餘人上城西北隅。",
      "blockIndex": 50
    },
    {
      "id": "s0551",
      "zh": "璩使宋修、張弘、辛挹、郭普距之，短兵接戰，斬二百餘人，賊乃退。",
      "blockIndex": 50
    },
    {
      "id": "s0552",
      "zh": "璩戮李嘉以徇，燒其攻具。",
      "blockIndex": 50
    },
    {
      "id": "s0553",
      "zh": "秋退保大夏，謂諸將曰：「我用兵於五都之間，攻城掠地，往無不捷。",
      "blockIndex": 50
    },
    {
      "id": "s0554",
      "zh": "及登秦隴，謂有征無戰。",
      "blockIndex": 50
    },
    {
      "id": "s0555",
      "zh": "豈悟南襲仇池，破軍殺將；",
      "blockIndex": 50
    },
    {
      "id": "s0556",
      "zh": "築城長最，匹馬不歸；",
      "blockIndex": 50
    },
    {
      "id": "s0557",
      "zh": "及攻此城，傷兵挫銳。",
      "blockIndex": 50
    },
    {
      "id": "s0558",
      "zh": "殆天所贊，非人力也。」",
      "blockIndex": 50
    },
    {
      "id": "s0559",
      "zh": "季龍聞而歎曰：「吾以偏師定九州，今以九州之力困於枹罕，真所謂彼有人焉，未可圖也。」",
      "blockIndex": 50
    },
    {
      "id": "s0560",
      "zh": "重華以謝艾為使持節、軍師將軍，率步騎三萬，進軍臨河。",
      "blockIndex": 51
    },
    {
      "id": "s0561",
      "zh": "秋以三萬眾距之。",
      "blockIndex": 51
    },
    {
      "id": "s0562",
      "zh": "艾乘軺車，冠白帢，鳴鼓而行。",
      "blockIndex": 51
    },
    {
      "id": "s0563",
      "zh": "秋望而怒曰：「艾年少書生，冠服如此，輕我也。」",
      "blockIndex": 51
    },
    {
      "id": "s0564",
      "zh": "命黑槊龍驤三千人馳擊之。",
      "blockIndex": 51
    },
    {
      "id": "s0565",
      "zh": "艾左右大擾。",
      "blockIndex": 51
    },
    {
      "id": "s0566",
      "zh": "左戰帥李偉勸艾乘馬，艾不從，乃下車踞胡床，指麾處分。",
      "blockIndex": 51
    },
    {
      "id": "s0567",
      "zh": "賊以為伏兵發也，懼不敢進。",
      "blockIndex": 51
    },
    {
      "id": "s0568",
      "zh": "張瑁從左南緣河而截其後，秋軍乃退。",
      "blockIndex": 51
    },
    {
      "id": "s0569",
      "zh": "艾乘勝奔擊，遂大敗之，斬秋將杜勳、汲魚，俘斬一萬三級，秋匹馬奔大夏。",
      "blockIndex": 51
    },
    {
      "id": "s0570",
      "zh": "重華論功，以謝艾為太府左長史，進封福祿縣伯，邑五千戶，帛八千匹。",
      "blockIndex": 51
    },
    {
      "id": "s0571",
      "zh": "麻秋又據枹罕，有眾十二萬，進屯河內，遣王擢略地晉興、廣武，越洪池嶺，至於曲柳，姑臧大震。",
      "blockIndex": 52
    },
    {
      "id": "s0572",
      "zh": "重華議欲親出距之，謝艾固諫以為不可。",
      "blockIndex": 52
    },
    {
      "id": "s0573",
      "zh": "別駕從事索遐進曰：「賊眾甚盛，漸逼京畿。",
      "blockIndex": 52
    },
    {
      "id": "s0574",
      "zh": "君者，國之鎮也，不可以親動。",
      "blockIndex": 52
    },
    {
      "id": "s0575",
      "zh": "左長史謝艾，文武兼資，國之方邵，宜委以推轂之任。",
      "blockIndex": 52
    },
    {
      "id": "s0576",
      "zh": "殿下居中作鎮，授以算略，小賊不足平也。」",
      "blockIndex": 52
    },
    {
      "id": "s0577",
      "zh": "重華納之，於是以艾為使持節、都督征討諸軍事、行衛將軍，遐為軍正將軍，率步騎二萬距之。",
      "blockIndex": 52
    },
    {
      "id": "s0578",
      "zh": "艾建牙旗，盟將士，有西北風吹旌旗東南指。",
      "blockIndex": 52
    },
    {
      "id": "s0579",
      "zh": "遐曰：「風為號令，今能令旗指之，天所贊也，破之必矣。」",
      "blockIndex": 52
    },
    {
      "id": "s0580",
      "zh": "軍次神鳥，王擢與前鋒戰，敗，遁還河南。",
      "blockIndex": 52
    },
    {
      "id": "s0581",
      "zh": "還討叛虜斯骨真萬餘落，破之，斬首千餘級，俘擒二千八百，獲牛羊十餘萬頭。",
      "blockIndex": 52
    },
    {
      "id": "s0582",
      "zh": "重華自以連破勍敵，頗怠政事，希接賓客。",
      "blockIndex": 53
    },
    {
      "id": "s0583",
      "zh": "司直索遐諫曰：「殿下承四聖之基，當升平之會，荷當今之任，憂率土之塗炭。",
      "blockIndex": 53
    },
    {
      "id": "s0584",
      "zh": "宜躬親萬機，開延英乂，夙夜乾乾，勉於庶政。",
      "blockIndex": 53
    },
    {
      "id": "s0585",
      "zh": "自頃內外囂然，皆云去賊投誠者應即撫慰，而彌日不接。",
      "blockIndex": 53
    },
    {
      "id": "s0586",
      "zh": "國老朝賢，當虛己引納，詢訪政事，比多經旬積朔，不留意接之。",
      "blockIndex": 53
    },
    {
      "id": "s0587",
      "zh": "文奏入內，曆月不省，廢替見務，注情於棋弈之間，繾綣左右小臣之娛，不存將相遠大之謀。",
      "blockIndex": 53
    },
    {
      "id": "s0588",
      "zh": "至使親臣不言，朝吏杜口，愚臣所以回惶忘寢與食也。",
      "blockIndex": 53
    },
    {
      "id": "s0589",
      "zh": "今王室如毀，百姓倒懸，正是殿下銜膽茹辛厲心之日。",
      "blockIndex": 53
    },
    {
      "id": "s0590",
      "zh": "深願垂心朝政，延納直言，周爰五美，以成六德，捐彼近習，弭塞外聲，修政聽朝，使下觀而化。」",
      "blockIndex": 53
    },
    {
      "id": "s0591",
      "zh": "重華覽之大悅，優文答謝，然不之改也。",
      "blockIndex": 53
    },
    {
      "id": "s0592",
      "zh": "詔遣侍御史俞歸拜重華護羌校尉、涼州刺史、假節。",
      "blockIndex": 54
    },
    {
      "id": "s0593",
      "zh": "是時石季龍西中郎將王擢屯結隴上，為苻雄所破，奔重華。",
      "blockIndex": 54
    },
    {
      "id": "s0594",
      "zh": "重華厚寵之，以為征虜將軍、秦州刺史、假節，使張弘、宗悠率步騎萬五千配擢，伐苻健。",
      "blockIndex": 54
    },
    {
      "id": "s0595",
      "zh": "健遣苻碩禦之，戰于龍黎。",
      "blockIndex": 54
    },
    {
      "id": "s0596",
      "zh": "擢等大敗，單騎而還，弘、悠皆沒。",
      "blockIndex": 54
    },
    {
      "id": "s0597",
      "zh": "重華痛之，素服為戰亡吏士舉哀號慟，各遣吊問其家。",
      "blockIndex": 54
    },
    {
      "id": "s0598",
      "zh": "復授擢兵，使攻秦州，克之。",
      "blockIndex": 54
    },
    {
      "id": "s0599",
      "zh": "遣使上疏曰：「季龍自斃，遺燼遊魂，取亂侮亡，睹機則發。",
      "blockIndex": 54
    },
    {
      "id": "s0600",
      "zh": "臣今遣前都鋒督裴恆步騎七萬，遙出隴上，以俟聖朝赫然之威。",
      "blockIndex": 54
    },
    {
      "id": "s0601",
      "zh": "山東騷擾不足厝懷，長安膏腴，宜速平蕩。",
      "blockIndex": 54
    },
    {
      "id": "s0602",
      "zh": "臣守任西荒，山川悠遠，大誓六軍，不及聽受之末；",
      "blockIndex": 54
    },
    {
      "id": "s0603",
      "zh": "猛將鷹揚，不豫告成之次，瞻雲望日，孤憤義傷，彈劍慷慨，中情蘊結。」",
      "blockIndex": 54
    },
    {
      "id": "s0604",
      "zh": "於是康獻皇后詔報，遣使進重華為涼州牧。",
      "blockIndex": 54
    },
    {
      "id": "s0605",
      "zh": "是時御史俞歸至涼州，重華方謀為涼王，不肯受詔，使親信人沈猛謂歸曰：「我家主公奕世忠於晉室，而不如鮮卑矣。",
      "blockIndex": 55
    },
    {
      "id": "s0606",
      "zh": "台加慕容皝燕王，今甫授州主大將軍，何以加勸有功忠義之臣乎！",
      "blockIndex": 55
    },
    {
      "id": "s0607",
      "zh": "明台今宜移河右，共勸州主為涼王。",
      "blockIndex": 55
    },
    {
      "id": "s0608",
      "zh": "大夫出使，苟利社稷，專之可也。」",
      "blockIndex": 55
    },
    {
      "id": "s0609",
      "zh": "歸對曰：「王者之制，異姓不得稱王；",
      "blockIndex": 55
    },
    {
      "id": "s0610",
      "zh": "九州之內，重爵不得過公。",
      "blockIndex": 55
    },
    {
      "id": "s0611",
      "zh": "漢高一時王異姓，尋皆誅滅，蓋權時之宜，非舊體也。",
      "blockIndex": 55
    },
    {
      "id": "s0612",
      "zh": "故王陵曰：'非劉氏而王，天下共伐之。",
      "blockIndex": 55
    },
    {
      "id": "s0613",
      "zh": "'至於戎狄，不從此例。",
      "blockIndex": 55
    },
    {
      "id": "s0614",
      "zh": "春秋時吳楚稱王，而諸侯不以為非者，蓋蠻夷畜之也。",
      "blockIndex": 55
    },
    {
      "id": "s0615",
      "zh": "假令齊魯稱王，諸侯豈不伐之！",
      "blockIndex": 55
    },
    {
      "id": "s0616",
      "zh": "故聖上以貴公忠賢，是以爵以上公，位以方伯，鮮卑北狄，豈足為比哉！",
      "blockIndex": 55
    },
    {
      "id": "s0617",
      "zh": "子失問也。",
      "blockIndex": 55
    },
    {
      "id": "s0618",
      "zh": "且吾又聞之，有殊勳絕世者亦有不世之賞，若今便以貴公為王者，設貴公以河右之眾南平巴蜀，東掃趙魏，修復舊都，以迎天子，天子復以何爵何位可以加賞？",
      "blockIndex": 55
    },
    {
      "id": "s0619",
      "zh": "幸三思之。」",
      "blockIndex": 55
    },
    {
      "id": "s0620",
      "zh": "猛具宣歸言，重華遂止。",
      "blockIndex": 55
    },
    {
      "id": "s0621",
      "zh": "重華好與群小遊戲，屢出錢帛以賜左右。",
      "blockIndex": 56
    },
    {
      "id": "s0622",
      "zh": "征事索振諫曰：「先王寢不安席，志平天下，故繕甲兵，積資實。",
      "blockIndex": 56
    },
    {
      "id": "s0623",
      "zh": "大業未就，懷恨九泉。",
      "blockIndex": 56
    },
    {
      "id": "s0624",
      "zh": "殿下遭巨寇於諒闇之中，賴重餌以挫勍敵。",
      "blockIndex": 56
    },
    {
      "id": "s0625",
      "zh": "今遺燼尚廣，倉帑虛竭，金帛之費，所宜慎之。",
      "blockIndex": 56
    },
    {
      "id": "s0626",
      "zh": "昔世祖即位，躬親萬機，章奉詣闕，報不終日，故能隆中興之業，定萬世之功。",
      "blockIndex": 56
    },
    {
      "id": "s0627",
      "zh": "今章奉停滯，動經時月，下情不得上達，哀窮困于囹圄，蓋非明主之事，臣竊未安。」",
      "blockIndex": 56
    },
    {
      "id": "s0628",
      "zh": "重華善之。",
      "blockIndex": 56
    },
    {
      "id": "s0629",
      "zh": "將受詔，未及而卒，時年二十七。",
      "blockIndex": 57
    },
    {
      "id": "s0630",
      "zh": "在位十一年。",
      "blockIndex": 57
    },
    {
      "id": "s0631",
      "zh": "私諡曰昭公，後改曰桓公，穆帝賜諡曰敬烈。",
      "blockIndex": 57
    },
    {
      "id": "s0632",
      "zh": "子耀靈嗣。",
      "blockIndex": 57
    }
  ]
}
