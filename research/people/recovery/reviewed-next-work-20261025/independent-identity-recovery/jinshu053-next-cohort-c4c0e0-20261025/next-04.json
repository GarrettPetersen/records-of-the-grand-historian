      "sourceUnits": [
        {
          "id": "s0074g",
          "zh": "左長史韓壽斬高句麗將阿佛和度加，諸軍乘勝追之，遂入丸都。",
          "blockIndex": 13
        },
        {
          "id": "s0085",
          "zh": "皝將還，韓壽曰：「高句麗之地，不可戍守。",
          "blockIndex": 14
        },
        {
          "id": "s0085a",
          "zh": "今其主亡民散，潛伏山谷；",
          "blockIndex": 14
        },
        {
          "id": "s0085b",
          "zh": "大軍既去，必復鳩聚，收其餘燼，猶足為患。",
          "blockIndex": 14
        },
        {
          "id": "s0085c",
          "zh": "請載其父屍、囚其生母而歸，俟其束身自歸，然後返之，撫以恩信，策之上也。」",
          "blockIndex": 14
        }
      ]
    },
