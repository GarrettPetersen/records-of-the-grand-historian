      "sourceUnits": [
        {
          "id": "s0185",
          "zh": "壬戌，帝幸式乾殿，召公卿入，使黃門令董猛以太子書及青紙詔示之曰：「遹書如此，今賜死。」",
          "blockIndex": 26
        },
        {
          "id": "s0191",
          "zh": "賈后使董猛矯以長廣公主辭白帝曰：「事宜速決，而群臣各不同，其不從詔者，宜以軍法從事。」",
          "blockIndex": 27
        }
      ]
