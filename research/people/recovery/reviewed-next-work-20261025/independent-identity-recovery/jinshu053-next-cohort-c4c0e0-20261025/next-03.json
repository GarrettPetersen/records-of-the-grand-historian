      "sourceUnits": [
        {
          "id": "s0582",
          "zh": "初，誅楊駿及汝南王亮、太保衛瓘、楚王瑋等，皆臨機專斷，宦人董猛參預其事。",
          "blockIndex": 68
        },
        {
          "id": "s0583",
          "zh": "猛，武帝時為寺人監，侍東宮，得親信于后，預誅楊駿，封武安侯，猛三兄皆為亭侯，天下咸怨。",
          "blockIndex": 68
        },
        {
          "id": "s0599",
          "zh": "趙粲、賈午、韓壽、董猛等皆伏誅。",
          "blockIndex": 69
        }
      ]
