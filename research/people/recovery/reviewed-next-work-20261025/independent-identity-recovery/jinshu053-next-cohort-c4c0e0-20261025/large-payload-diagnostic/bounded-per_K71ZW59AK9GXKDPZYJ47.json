      "sourceUnits": [
        {
          "id": "s0263",
          "zh": "倫陰與秀謀篡位，欲先除朝望，且報宿怨，乃執張華、裴頠、解系、解結等於殿前。",
          "blockIndex": 39
        },
        {
          "id": "s0269",
          "zh": "遂皆斬之，仍夷三族。",
          "blockIndex": 39
        },
        {
          "id": "s0270",
          "zh": "解結女適裴氏，明日當嫁而禍起，裴氏欲認活之，女曰：「家既若此，我何以活為！」",
          "blockIndex": 39
        }
      ]
