      "sourceUnits": [
        {
          "id": "s0216",
          "zh": "劾案沛王韜獄，未竟，會解結代楊准為刺史，韜因河間王顒屬結。",
          "blockIndex": 31
        },
        {
          "id": "s0217",
          "zh": "結至大會，問主簿史鳳曰：「沛王貴籓，州據何法而擅拘邪？」",
          "blockIndex": 31
        },
        {
          "id": "s0221",
          "zh": "結曰：「眾人之言不可妄聽，宜依法窮竟。」",
          "blockIndex": 31
        },
        {
          "id": "s0222",
          "zh": "又問僚佐曰：「河北白壤膏粱，何故少人士，每以三品為中正？」",
          "blockIndex": 31
        },
        {
          "id": "s0225",
          "zh": "結曰：「張彥真以為汝潁巧辯，恐不及青徐儒雅也。」",
          "blockIndex": 31
        },
        {
          "id": "s0228",
          "zh": "結甚異之，曰：「豫州人士常半天下，此言非虛。」",
          "blockIndex": 31
        },
        {
          "id": "s0229",
          "zh": "會結遷尚書，結恨不得盡其才用。",
          "blockIndex": 31
        }
      ]
    },
