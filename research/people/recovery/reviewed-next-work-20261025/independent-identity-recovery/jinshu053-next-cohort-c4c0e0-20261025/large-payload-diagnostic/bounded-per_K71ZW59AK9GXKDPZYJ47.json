      "sourceUnits": [
        {
          "id": "s0200",
          "zh": "御史中丞解結以咸劾戎為違典制，越局侵官，干非其分，奏免咸官。",
          "blockIndex": 21
        },
        {
          "id": "s0213",
          "zh": "而結一旦橫挫臣，臣前所以不羅縷者，冀因結奏得從私願也。",
          "blockIndex": 22
        },
        {
          "id": "s0219",
          "zh": "此理灼然，而結以此挫臣。",
          "blockIndex": 22
        }
      ]
    },
