{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://24histories.com/schema/people/canonical-person-v1.json",
  "title": "Canonical person record",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "slug", "preferredName", "description", "historicity", "identificationStatus", "sex", "sexClaims", "names", "roles", "ethnicities", "lineages", "occupations", "life", "rulershipEvents", "polityAssociations", "placeAssociations", "organizationAssociations", "offices", "titlesAndHonors", "statuses", "legalActions", "familyRelationships", "familySummaries", "relationships", "education", "credentials", "beliefs", "skills", "works", "attributions", "events", "assessments", "materialAssociations", "attributes", "sourceIssues", "otherClaims", "references", "externalIds", "media", "localPeople", "retiredIds", "curation"],
  "properties": {
    "id": { "type": "string", "pattern": "^per_[0-9A-HJKMNP-TV-Z]{20,}$" },
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "preferredName": { "$ref": "#/$defs/name" },
    "description": {
      "type": "object",
      "additionalProperties": false,
      "required": ["en", "claimRefs"],
      "properties": {
        "en": { "type": "string", "minLength": 1, "maxLength": 120 },
        "claimRefs": { "type": "array", "minItems": 1, "items": { "type": "string" } }
      }
    },
    "historicity": { "enum": ["historical", "legendary", "uncertain", "literary"] },
    "identificationStatus": { "enum": ["named", "title-only", "anonymous-individuated", "uncertain"] },
    "sex": { "type": ["string", "null"] },
    "sexClaims": { "type": "array", "items": { "type": "object" } },
    "names": { "type": "array", "items": { "$ref": "#/$defs/name" } },
    "roles": { "type": "array", "items": { "type": "object" } },
    "ethnicities": { "type": "array", "items": { "type": "object" } },
    "lineages": { "type": "array", "items": { "type": "object" } },
    "occupations": { "type": "array", "items": { "type": "object" } },
    "life": { "type": "object" },
    "rulershipEvents": { "type": "array", "items": { "type": "object" } },
    "polityAssociations": { "type": "array", "items": { "type": "object" } },
    "placeAssociations": { "type": "array", "items": { "type": "object" } },
    "organizationAssociations": { "type": "array", "items": { "type": "object" } },
    "offices": { "type": "array", "items": { "type": "object" } },
    "titlesAndHonors": { "type": "array", "items": { "type": "object" } },
    "statuses": { "type": "array", "items": { "type": "object" } },
    "legalActions": { "type": "array", "items": { "type": "object" } },
    "familyRelationships": { "type": "array", "items": { "$ref": "#/$defs/familyRelationship" } },
    "familySummaries": { "type": "array", "items": { "type": "object" } },
    "relationships": { "type": "array", "items": { "type": "object" } },
    "education": { "type": "array", "items": { "type": "object" } },
    "credentials": { "type": "array", "items": { "type": "object" } },
    "beliefs": { "type": "array", "items": { "type": "object" } },
    "skills": { "type": "array", "items": { "type": "object" } },
    "works": { "type": "array", "items": { "type": "object" } },
    "attributions": { "type": "array", "items": { "type": "object" } },
    "events": { "type": "array", "items": { "type": "object" } },
    "assessments": { "type": "array", "items": { "type": "object" } },
    "materialAssociations": { "type": "array", "items": { "type": "object" } },
    "attributes": { "type": "array", "items": { "type": "object" } },
    "sourceIssues": { "type": "array", "items": { "type": "object" } },
    "otherClaims": { "type": "array", "items": { "type": "object" } },
    "references": { "type": "array", "items": { "type": "object" } },
    "externalIds": { "type": "object", "additionalProperties": { "type": "string" } },
    "media": { "type": "array", "items": { "type": "object" } },
    "localPeople": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "retiredIds": { "type": "array", "items": { "type": "string" } },
    "curation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "notes"],
      "properties": {
        "status": { "enum": ["machine-reviewed", "human-reviewed", "needs-review"] },
        "notes": { "type": "array", "items": { "type": "string" } }
      }
    }
  },
  "$defs": {
    "familyRelationship": {
      "type": "object",
      "additionalProperties": false,
      "required": ["edgeId", "derivedInverse", "predicate", "value", "certainty", "evidence", "claimRefs"],
      "properties": {
        "edgeId": { "type": "string", "pattern": "^fam_[a-f0-9]{24}$" },
        "derivedInverse": { "type": "boolean" },
        "predicate": { "const": "family-relationship" },
        "value": {
          "type": "object",
          "required": ["relation", "personId"],
          "properties": {
            "relation": { "enum": ["parent-of", "child-of", "sibling-of", "spouse-of", "betrothed-to", "ancestor-of", "descendant-of", "kin-of"] },
            "personId": { "type": "string", "pattern": "^per_[0-9A-HJKMNP-TV-Z]{20,}$" }
          }
        },
        "certainty": { "enum": ["explicit", "explicit-event-contextual-date", "strongly-inferred", "uncertain", "derived", "textual-variant"] },
        "evidence": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "claimRefs": { "type": "array", "minItems": 1, "items": { "type": "string" } }
      }
    },
    "name": {
      "type": "object",
      "additionalProperties": false,
      "required": ["en", "zh"],
      "properties": {
        "kind": { "type": "string" },
        "en": { "type": ["string", "null"] },
        "zh": { "type": ["string", "null"] },
        "pinyin": { "type": ["string", "null"] },
        "preferred": { "type": "boolean" },
        "claimRefs": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
