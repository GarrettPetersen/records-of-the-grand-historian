      "sourceUnits": [
        {
          "id": "s0047",
          "zh": "使黃門侍郎潘岳作書草，若禱神之文，有如太子素意，因醉而書之，令小婢承福以紙筆及書草使太子書之。",
          "en": "She had Gentleman of the Yellow Gate Pan Yue draft a prayer text mimicking the Crown Prince's usual intent; because he was drunk she made him copy it, having the young maid Chengfu bring paper, brush, and draft.",
          "literal": "She had Gentleman of the Yellow Gate Pan Yue draft a prayer text mimicking the crown prince's usual intent; because he was drunk she made him copy it, having the young maid Chengfu bring paper, brush, and draft.",
          "blockIndex": 5
        },
        {
          "id": "s0104",
          "zh": "'又小婢承福持筆研墨黃紙來，使寫。",
          "en": "Chengfu added brush and yellow paper for the copy.",
          "literal": "Another small maid, Chengfu, brought brush, inkstone, and yellow paper, making him write.",
          "blockIndex": 6
        }
