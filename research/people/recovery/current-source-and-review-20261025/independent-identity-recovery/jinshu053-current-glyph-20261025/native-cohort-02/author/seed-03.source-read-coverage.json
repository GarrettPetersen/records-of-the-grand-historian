      "sourceUnits": [
        {
          "id": "s0810",
          "zh": "有二弟：順、斌。"
        },
        {
          "id": "s0811",
          "zh": "弟順、斌"
        },
        {
          "id": "s0817",
          "zh": "西河繆王斌，字子政，魏中郎。"
        },
        {
          "id": "s0818",
          "zh": "武帝受禪，封陳王，邑千七百一十戶。"
        },
        {
          "id": "s0819",
          "zh": "三年，改封西河。"
        },
        {
          "id": "s0820",
          "zh": "咸寧四年薨，子隱立。"
        }
      ]
    },
    {
      "localId": "jinshu:053:p028",
      "sourcePins": {
        "sourcePath": "data/jinshu/053.json",
        "extractionPath": "data/people/extractions/jinshu/053.json",
        "sourceRawSha256": "50ce1c5acbafd396a312495da7d7267eac0c915e25a207adc72db21c2f72d08c",
        "extractionRawSha256": "307d647957cbd4d611d555053bc54e292fdcb42e5156ec91b26316bb0dce587c",
        "sourceSemanticHash": "sha256:0a3e7e9d120a1a64c3c3ccfc4e4f611cde3b949dfc0cdf8cacfb95a95a413c83",
        "extractionSemanticHash": "sha256:d16d6f90f4b65dc8a64413dc5397551cd30f23a8e9230595e3b6f26358783c39"
      },
      "sourceUnits": [
        {
          "id": "s0017",
          "zh": "太子所幸蔣美人生男，又言宜隆其賞賜，多為皇孫造玩弄之器，太子從之。"
        },
        {
          "id": "s0053",
          "zh": "茹毛飲血於三辰之下，皇天許當掃除患害，立道文為王，蔣為內主。"
        },
        {
          "id": "s0078",
          "zh": "去年十二月，道文疾病困篤，父子之情，實相憐湣。"
        },
        {
          "id": "s0081",
          "zh": "自道文病，中宮三遣左右來視，云：'天教呼汝。"
        },
        {
          "id": "s0087",
          "zh": "須臾中宮遣陳舞見語：'聞汝表陛下為道文乞王，不得王是成國耳。"
        },
        {
          "id": "s0092",
          "zh": "天與汝酒，當使道文差也。"
        },
        {
          "id": "s0170",
          "zh": "太子三子：虨、臧、尚，並與父同幽金墉。"
        },
        {
          "id": "s0171",
          "zh": "虨字道文，永康元年正月，薨。"
        },
        {
          "id": "s0172",
          "zh": "四月，追封南陽王。"
        }
      ]
    }
  ]
