      "sourceUnits": [
        {
          "id": "s0077",
          "zh": "頠旦夕說其從母廣城君，令戒諭賈后以親厚太子，賈模亦數為后言禍福；"
        },
        {
          "id": "s0126",
          "zh": "初，廣城君郭槐，以賈后無子，常勸后使慈愛太子。"
        },
        {
          "id": "s0127",
          "zh": "賈謐驕縱，數無禮於太子，廣城君恆切責之。"
        },
        {
          "id": "s0128",
          "zh": "廣城君欲以韓壽女為太子妃，太子亦欲婚韓氏以自固；"
        },
        {
          "id": "s0131",
          "zh": "及廣城君病，臨終，執后手，令盡心於太子，言甚切至。"
        }
      ]
    },
    {
      "localId": "jinshu:053:p033",
      "sourcePins": {
        "sourcePath": "data/jinshu/053.json",
        "extractionPath": "data/people/extractions/jinshu/053.json",
        "sourceRawSha256": "50ce1c5acbafd396a312495da7d7267eac0c915e25a207adc72db21c2f72d08c",
        "extractionRawSha256": "307d647957cbd4d611d555053bc54e292fdcb42e5156ec91b26316bb0dce587c",
        "sourceSemanticHash": "sha256:0a3e7e9d120a1a64c3c3ccfc4e4f611cde3b949dfc0cdf8cacfb95a95a413c83",
        "extractionSemanticHash": "sha256:d16d6f90f4b65dc8a64413dc5397551cd30f23a8e9230595e3b6f26358783c39"
      },
      "sourceUnits": [
        {
          "id": "s0034",
          "zh": "初，賈后母郭槐欲以韓壽女為太子妃，太子亦欲婚韓氏以自固。"
        }
      ]
    },
    {
      "localId": "jinshu:031:p203",
      "sourcePins": {
        "sourcePath": "data/jinshu/031.json",
        "extractionPath": "data/people/extractions/jinshu/031.json",
        "sourceRawSha256": "9afab27df5652e95b23d0c3636a3191e3056d55a456c0cd6c85ba900f1b5ccca",
        "extractionRawSha256": "e55eb12bb921f5c889f33d42abdd0c4d3e3597c77d62f951a730a463f8a872b4",
        "sourceSemanticHash": "sha256:d41396e78126d8575c6fb2b1298ac98ca6aeeb31125c9ad062ad1ac626834e57",
        "extractionSemanticHash": "sha256:09f579c3148c245012286d043593b5ebcb3aaf5b81baf352836774cf70ebaaf8"
      },
      "sourceUnits": [
        {
          "id": "s0556",
          "zh": "后母廣城君養孫賈謐干預國事，權侔人主。"
        },
        {
          "id": "s0574",
          "zh": "后母廣城君以后無子，甚敬重愍懷，每勸厲后，使加慈愛。"
        },
        {
          "id": "s0575",
          "zh": "賈謐恃貴驕縱，不能推崇太子，廣城君恒切責之。"
        },
        {
          "id": "s0576",
          "zh": "及廣城君病篤，占術謂不宜封廣城，乃改封宜城。"
        },
        {
          "id": "s0578",
          "zh": "宜城臨終執后手，令盡意于太子，言甚切至。"
        },
        {
          "id": "s0579",
          "zh": "又曰：「趙粲及午必亂汝事，我死後，勿復聽入，深憶吾言。」"
        }
      ]
    }
  ]
}
