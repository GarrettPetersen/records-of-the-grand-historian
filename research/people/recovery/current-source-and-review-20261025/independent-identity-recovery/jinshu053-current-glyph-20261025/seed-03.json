      },
      "sourceUnits": [
        {
          "id": "s0017",
          "zh": "太子所幸蔣美人生男，又言宜隆其賞賜，多為皇孫造玩弄之器，太子從之。",
          "en": "When Consort Jiang bore a son they pushed costly toys and stipends—Yu complied.",
          "literal": "When Lady Jiang, whom the crown prince favored, bore a son, they also said rewards should be lavish and many toys fashioned for the imperial grandson; the crown prince obeyed.",
          "blockIndex": 3
        },
        {
          "id": "s0053",
          "zh": "茹毛飲血於三辰之下，皇天許當掃除患害，立道文為王，蔣為內主。",
          "en": "Heaven blesses our coup—crown Daowen, empower Lady Jiang.",
          "literal": "We shall eat raw flesh and drink blood beneath the three luminaries; High Heaven grants us leave to sweep away the scourge, enthrone Daowen as king, and install Jiang as inner mistress.",
          "blockIndex": 5
        },
        {
          "id": "s0078",
          "zh": "去年十二月，道文疾病困篤，父子之情，實相憐湣。",
          "en": "He mourned son Daowen's fatal illness.",
          "literal": "Last twelfth month Daowen's illness grew desperate—father and son pitied each other truly.",
          "blockIndex": 6
        },
        {
          "id": "s0081",
          "zh": "自道文病，中宮三遣左右來視，云：'天教呼汝。",
          "en": "Palace runners claimed Heaven summoned Yu.",
          "literal": "Since Daowen fell ill the inner palace thrice sent attendants saying: Heaven summons you.",
          "blockIndex": 6
        },
        {
          "id": "s0087",
          "zh": "須臾中宮遣陳舞見語：'聞汝表陛下為道文乞王，不得王是成國耳。",
          "en": "They mocked his plea for son's kingship.",
          "literal": "Presently the inner palace sent Chen Wu saying: I hear you petitioned His Majesty to make Daowen a prince—you got Cheng principality instead.",
          "blockIndex": 6
        },
        {
          "id": "s0092",
          "zh": "天與汝酒，當使道文差也。",
          "en": "She tied drinking to son's health.",
          "literal": "Heaven gives you ale so Daowen may recover.",
          "blockIndex": 6
        },
        {
          "id": "s0170",
          "zh": "太子三子：虨、臧、尚，並與父同幽金墉。",
          "en": "Three sons shared Yu's prison.",
          "literal": "The crown prince had three sons—Bin, Zang, and Shang—all imprisoned with their father at Jinyong.",
          "blockIndex": 9
