        {
          "id": "s0810",
          "zh": "有二弟：順、斌。",
          "en": "Two brothers: Shun and Bin.",
          "literal": "Had two younger brothers Shun Bin.",
          "blockIndex": 127
        },
        {
          "id": "s0811",
          "zh": "弟順、斌",
          "en": "Brothers Shun and Bin.",
          "literal": "Younger brothers Shun Bin.",
          "blockIndex": 128
        },
        {
          "id": "s0817",
          "zh": "西河繆王斌，字子政，魏中郎。",
          "en": "Sima Bin, Prince Miu of Xihe, styled Zizheng, served Wei as a gentleman of the household.",
          "literal": "Prince Miu of Xihe, Bin, courtesy name Zizheng, was a Gentleman of the Household under Wei.",
          "blockIndex": 130
        },
        {
          "id": "s0818",
          "zh": "武帝受禪，封陳王，邑千七百一十戶。",
          "en": "Sima Yan made him prince of Chen at 1,710 households.",
          "literal": "When Emperor Wu accepted abdication enfeoffed Prince of Chen one thousand seven hundred ten households.",
          "blockIndex": 130
        },
        {
          "id": "s0819",
          "zh": "三年，改封西河。",
          "en": "Year three moved the seat to Xihe.",
          "literal": "Third year changed enfeoffment Xihe.",
          "blockIndex": 130
        },
        {
          "id": "s0820",
          "zh": "咸寧四年薨，子隱立。",
          "en": "In the fourth year of Xianning, Yin inherited.",
          "literal": "In the fourth year of Xianning, Died son Yin succeeded.",
          "blockIndex": 130
        }
      ]
