      "sourceUnits": [
        {
          "id": "s0197",
          "zh": "孝惠皇帝上之下永康元年（",
          "en": "Under Emperor Hui of Jin, Yongkang, year 1 (",
          "literal": "The lower portion of the first reign of Emperor Xiaohui, first year of Yongkang (",
          "blockIndex": 28
        },
        {
          "id": "s0198",
          "zh": "庚申，公元三零零年）",
          "en": "gengshen, CE 300)",
          "literal": "gengshen, common era year 300)",
          "blockIndex": 28
        },
        {
          "id": "s0200",
          "zh": "西戎校尉司馬閻纘輿棺詣闕上書，以為：「漢戾太子稱兵拒命，言者猶曰罪當笞耳。",
          "en": "Yan Xun, Major under the Colonel of the Western Rong, came to the palace gate with his coffin on a cart and submitted a memorial, arguing: \"When Emperor Wu's heir apparent Liu Ju took up arms in rebellion, critics still said his offense deserved only a beating.",
          "literal": "Yan Xun, Major of the Colonel of the Western Rong, came to the gate with his coffin on a cart and submitted a memorial, holding: \"When the Han Heir Apparent Li raised troops and defied orders, those who spoke still said his crime merited only the bastinado.",
          "blockIndex": 30
        },
        {
          "id": "s0204",
          "zh": "纘，圃之孫也。",
          "en": "Xun was the grandson of Yan Pu.",
          "literal": "Xun was the grandson of Yan Pu.",
          "blockIndex": 30
        }
      ]
    }
