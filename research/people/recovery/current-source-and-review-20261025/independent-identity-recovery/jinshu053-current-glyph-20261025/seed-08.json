      "sourceUnits": [
        {
          "id": "s0077",
          "zh": "頠旦夕說其從母廣城君，令戒諭賈后以親厚太子，賈模亦數為后言禍福；",
          "en": "Pei pressed his aunt, the Lady of Guangcheng, day and night to warn Empress Jia to treat the heir apparent kindly. Jia Mo likewise urged the empress repeatedly about the risks she was courting;",
          "literal": "Pei day and night urged his mother's younger sister, the Lady of Guangcheng, to admonish Empress Jia to treat the Heir Apparent with affection; Jia Mo also repeatedly spoke to the empress of fortune and calamity;",
          "blockIndex": 14
        },
        {
          "id": "s0126",
          "zh": "初，廣城君郭槐，以賈后無子，常勸后使慈愛太子。",
          "en": "Earlier Guo Huai, Lady of Guangcheng, because Empress Jia had no son of her own, often urged her to treat the heir apparent kindly.",
          "literal": "Earlier the Lady of Guangcheng, Guo Huai, because Empress Jia had no son, often urged the empress to treat the Heir Apparent with kindness.",
          "blockIndex": 21
        },
        {
          "id": "s0127",
          "zh": "賈謐驕縱，數無禮於太子，廣城君恆切責之。",
          "en": "Jia Mi was arrogant and repeatedly insulted the heir apparent. The Lady of Guangcheng scolded him harshly again and again.",
          "literal": "Jia Mi was arrogant and unrestrained, repeatedly disrespectful toward the Heir Apparent; the Lady of Guangcheng constantly rebuked him sharply.",
          "blockIndex": 21
        },
        {
          "id": "s0128",
          "zh": "廣城君欲以韓壽女為太子妃，太子亦欲婚韓氏以自固；",
          "en": "The Lady of Guangcheng wanted Han Shou's daughter as the heir apparent's consort, and the heir apparent likewise hoped to marry into the Han clan to strengthen his position;",
          "literal": "The Lady of Guangcheng wished to make Han Shou's daughter the Heir Apparent's consort; the Heir Apparent also wished to marry into the Han clan to secure himself;",
          "blockIndex": 21
        },
        {
          "id": "s0131",
          "zh": "及廣城君病，臨終，執后手，令盡心於太子，言甚切至。",
          "en": "When the Lady of Guangcheng fell mortally ill, she took the empress's hand at the end and urged her with utmost earnestness to devote herself to the heir apparent.",
          "literal": "When the Lady of Guangcheng fell ill, at the end she took the empress's hand and ordered her to devote her heart to the Heir Apparent, her words very earnest.",
          "blockIndex": 21
        }
      ]
    },
