        "extractionRawSha256": "46249640910edb6c57640a50b61be52e4845e60a3d32c2508e936e55b080bab4",
        "sourceSemanticHash": "sha256:603e62ccaa33533f4f637b253c48624d9103fa818cef9ebf4e28e57c55834a19",
