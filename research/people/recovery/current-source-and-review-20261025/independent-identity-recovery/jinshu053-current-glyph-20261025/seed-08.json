      "sourceUnits": [
        {
          "id": "s0556",
          "zh": "后母廣城君養孫賈謐干預國事，權侔人主。",
          "en": "Lady Guo raised Jia Mi—his power rivaled the throne.",
          "literal": "Consort mother Lady Guangcheng raised grandson Jia Mi meddling state affairs—authority matched sovereign.",
          "blockIndex": 66
        },
        {
          "id": "s0574",
          "zh": "后母廣城君以后無子，甚敬重愍懷，每勸厲后，使加慈愛。",
          "en": "Lady Guo prized Minhuai—begged Jia to cherish him.",
          "literal": "Consort mother Lady Guangcheng because consort lacked sons greatly revered Crown Prince Minhuai—often urged consort—made her add kindness.",
          "blockIndex": 68
        },
        {
          "id": "s0575",
          "zh": "賈謐恃貴驕縱，不能推崇太子，廣城君恒切責之。",
          "en": "Jia Mi insulted the heir—Lady Guo scolded him.",
          "literal": "Jia Mi relied on pride—could not honor crown prince—Lady Guangcheng constantly scolded.",
          "blockIndex": 68
        },
        {
          "id": "s0576",
          "zh": "及廣城君病篤，占術謂不宜封廣城，乃改封宜城。",
          "en": "Ill diviners forbade “Guangcheng”—she became Princess Yicheng.",
          "literal": "When Lady Guangcheng gravely ill—divination said unsuitable enfeoff Guangcheng—thereupon changed enfeoff Yicheng.",
          "blockIndex": 68
        },
        {
          "id": "s0578",
          "zh": "宜城臨終執后手，令盡意于太子，言甚切至。",
          "en": "She clasped Jia’s hand—beg her shield Minhuai.",
          "literal": "Yicheng dying grasped consort’s hand—ordered exhaust feeling toward crown prince—speech extremely earnest.",
          "blockIndex": 68
        },
        {
          "id": "s0579",
          "zh": "又曰：「趙粲及午必亂汝事，我死後，勿復聽入，深憶吾言。」",
          "en": "She also said, \"Zhao Can and Jia Wu will surely disrupt your affairs; after I die, do not admit them again—remember my words well.\"",
          "literal": "Also said: “Zhao Can and Wu surely ruin your affairs—after I die—never hear them again—deeply remember my words.”",
          "blockIndex": 68
        }
      ]
    }
  ]
}
