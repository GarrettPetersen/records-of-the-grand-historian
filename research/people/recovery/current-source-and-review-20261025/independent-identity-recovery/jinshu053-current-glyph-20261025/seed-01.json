      "sourceUnits": [
        {
          "id": "s0224",
          "zh": "有衛督司馬雅、常從督許超，皆嘗給事東宮，與殿中郎士猗等謀廢賈后，復太子。",
          "en": "Sima Ya, Colonel of the Guards, and Xu Chao, Regular Colonel of the Followers, both former Eastern Palace attendants, joined Palace Gentleman Shi Yi and others to plot deposing Empress Jia and restoring the heir apparent.",
          "literal": "The Colonel of the Guards Sima Ya and the Regular Colonel of the Followers Xu Chao, who had both once served the Eastern Palace, joined the Palace Gentleman Shi Yi and others in plotting to depose Empress Jia and restore the Heir Apparent.",
          "blockIndex": 34
        },
        {
          "id": "s0244",
          "zh": "癸巳，秀使司馬雅告張華曰：「趙王欲與公共匡社稷，為天下除害，使雅以告。」",
          "en": "On guisi Xiu had Sima Ya tell Zhang Hua: \"The Prince of Zhao wishes to join you to save the realm and remove this evil.\"",
          "literal": "On guisi Xiu had Sima Ya tell Zhang Hua: \"The Prince of Zhao wishes to join with you to steady the altars, remove harm for the realm—Ya reports this.\"",
          "blockIndex": 38
        },
        {
          "id": "s0246",
          "zh": "雅怒曰：「刃將加頸，猶為是言邪！」",
          "en": "Ya snapped: \"The blade is at your neck and you still talk like that!\"",
          "literal": "Ya angrily said: \"The blade is at the neck—yet you speak thus!\"",
          "blockIndex": 38
        }
      ]
    }
