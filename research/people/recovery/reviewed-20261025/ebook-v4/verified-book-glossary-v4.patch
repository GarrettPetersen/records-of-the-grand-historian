new file mode 100644
--- /dev/null
+++ b/scripts/lib/ebook-certified-people.mjs
@@ -0,0 +1,136 @@
+import fs from 'node:fs';
+import path from 'node:path';
+import { buildPeopleExtractionPacket } from '../build-people-extraction-packet.mjs';
+import { projectPeopleProduct } from '../compile-people-catalog.mjs';
+import { validateCompactPeopleExtraction, validatePeopleExtraction } from '../validate-people-extraction.mjs';
+import { loadProperNounMatcher } from './people-candidates.mjs';
+import { isCompactPeopleExtraction } from './people-compact.mjs';
+import { DATA_DIR, PEOPLE_DIR, REPO_ROOT, extractionPath, readJson } from './people-content.mjs';
+import { DATE_AUDIT_VERSION, dateAuditStatus } from './people-date-audit.mjs';
+import { editorialDecisionPath, validateAppliedEditorialDecisions } from './people-editorial-decisions.mjs';
+import { readPeopleCatalog, readPeopleSiteIndex } from './people-generated-data.mjs';
+import { assertIdentitySeal, identityInputSeal, peopleDigest, stableJson } from './people-identity-seal.mjs';
+
+export function assertProductScope(product, manifest, sourceChapters) {
+  const expected = manifest?.products?.find(item => item.slug === product?.slug);
+  const valid = item => item && /^[a-z0-9_-]+$/u.test(item.book) &&
+    Array.isArray(item.chapters) && item.chapters.length > 0 &&
+    item.chapters.every(chapter => typeof chapter === 'string' && /^\d{3}$/u.test(chapter)) &&
+    new Set(item.chapters).size === item.chapters.length;
+  if (!valid(product) || !valid(expected) || product.book !== expected.book ||
+      stableJson(product.chapters) !== stableJson(expected.chapters)) {
+    throw new Error('Certified people scope must match the authoritative ordered product manifest');
+  }
+  if (product.slug === product.book && stableJson(product.chapters) !== stableJson(sourceChapters)) {
+    throw new Error('Whole-book product does not cover every authoritative source chapter in order');
+  }
+}
+
+export function assertChapterGates(extraction, currentPromptVersion, dateStatus, editorialDocument) {
+  const scope = `${extraction.book}:${extraction.chapter}`;
+  if (!Number.isInteger(currentPromptVersion) || currentPromptVersion < 1 ||
+      extraction.run?.promptVersion !== currentPromptVersion) throw new Error(`Invalid or legacy prompt version: ${scope}`);
+  if (!Array.isArray(extraction.translationRepairs)) throw new Error(`Missing editorial repair accounting: ${scope}`);
+  if (extraction.translationRepairs.some(repair => repair.status === 'proposed')) {
+    throw new Error(`Pending translation repair: ${scope}`);
+  }
+  if (extraction.translationRepairs.some(repair => repair.status === 'applied') && !editorialDocument) {
+    throw new Error(`Missing independent applied editorial history: ${scope}`);
+  }
+  if (editorialDocument) {
+    if (editorialDocument.book !== extraction.book || editorialDocument.chapter !== extraction.chapter) {
+      throw new Error(`Editorial history scope mismatch: ${scope}`);
+    }
+    validateAppliedEditorialDecisions(editorialDocument, extraction);
+  }
+  if (dateStatus?.status !== 'audited' || dateStatus.auditVersion !== DATE_AUDIT_VERSION) {
+    throw new Error(`Current independent date audit is ${dateStatus?.status ?? 'missing'}: ${scope}`);
+  }
+}
+
+export function assertScopedIdentity(corpus, globalCatalog, seal) {
+  const selected = new Set();
+  for (const localId of corpus.localPeople.keys()) {
+    const id = globalCatalog.localPersonMap[localId];
+    if (!id) throw new Error(`No sealed global canonical identity for ${localId}`);
+    selected.add(id);
+  }
+  if (seal.unresolvedCanonicalPeople.some(id => selected.has(id))) {
+    throw new Error('Unresolved global identity comparison touches this product');
+  }
+}
+
+// Required-glossary mode calls this separately for each authoritative product.
+// Global identities are reused from a hash-sealed normal catalog generation;
+// only product source members are freshly validated and projected into facts.
+export function loadCertifiedEbookPeople(product) {
+  const manifest = readJson(path.join(REPO_ROOT, 'ebooks', 'manifest.json'));
+  const sourceChapters = fs.readdirSync(path.join(DATA_DIR, product.book))
+    .filter(name => /^\d{3}\.json$/u.test(name)).sort().map(name => name.slice(0, -5));
+  assertProductScope(product, manifest, sourceChapters);
+  const catalogPath = path.join(PEOPLE_DIR, 'generated', 'catalog.json');
+  const catalog = readPeopleCatalog(catalogPath);
+  const siteIndex = readPeopleSiteIndex(path.join(PEOPLE_DIR, 'generated', 'site-index.json'));
+  const seal = readJson(`${catalogPath}.identity-seal.json`);
+  const inputs = identityInputSeal();
+  assertIdentitySeal(seal, catalog, siteIndex, inputs);
+  const config = readJson(path.join(PEOPLE_DIR, 'config.json'));
+  if (catalog.currentPromptVersion !== config.promptVersion || siteIndex.currentPromptVersion !== config.promptVersion ||
+      catalog.generatedAt !== siteIndex.generatedAt) throw new Error('Sealed identity generation does not match current configuration');
+  const matcher = loadProperNounMatcher();
+  const corpus = { chapters: [], localPeople: new Map() };
+  const gateEvidence = [];
+  for (const chapter of product.chapters) {
+    const raw = readJson(extractionPath(product.book, chapter));
+    if (raw.book !== product.book || raw.chapter !== chapter) throw new Error(`Extraction scope mismatch: ${product.book}:${chapter}`);
+    const packet = buildPeopleExtractionPacket(product.book, chapter, { properNounMatcher: matcher });
+    const options = { strictAliasDispositions: true };
+    const { normalized: extraction } = isCompactPeopleExtraction(raw)
+      ? validateCompactPeopleExtraction(raw, packet, options) : validatePeopleExtraction(raw, packet, options);
+    const editorialFile = editorialDecisionPath(product.book, chapter);
+    const editorial = fs.existsSync(editorialFile) ? readJson(editorialFile) : null;
+    const dateStatus = dateAuditStatus(product.book, chapter);
+    assertChapterGates(extraction, config.promptVersion, dateStatus, editorial);
+    const report = readJson(path.join(PEOPLE_DIR, 'date-audits', product.book, `${chapter}.json`));
+    gateEvidence.push({ chapter, inputFingerprint: packet.input.chapterFingerprint, inputUnitCount: packet.input.unitCount, extraction: peopleDigest(raw), source: peopleDigest(readJson(path.join(DATA_DIR, product.book, `${chapter}.json`))),
+      editorial: peopleDigest(editorial), dateAudit: peopleDigest(report) });
+    corpus.chapters.push({ extraction });
+    for (const person of extraction.people) {
+      if (corpus.localPeople.has(person.localId)) throw new Error(`Duplicate scoped local person ${person.localId}`);
+      corpus.localPeople.set(person.localId, { ...person, book: extraction.book, chapter: extraction.chapter,
+        promptVersion: extraction.run.promptVersion,
+        claims: extraction.claims.filter(claim => claim.subject === person.localId),
+        mentions: extraction.mentions.filter(mention => mention.person === person.localId) });
+    }
+  }
+  assertScopedIdentity(corpus, catalog, seal);
+  const roles = readJson(path.join(PEOPLE_DIR, 'curation', 'role-vocabulary.json'));
+  const overrides = readJson(path.join(PEOPLE_DIR, 'curation', 'overrides.json'));
+  const projected = projectPeopleProduct(corpus, catalog, new Map(roles.roles.map(role => [role.id, role.label])), overrides.people);
+  if (projected.catalog.people.length === 0) throw new Error('Certified product contains no people');
+  if (identityInputSeal() !== inputs) throw new Error('Identity inputs changed while qualifying product');
+  for (const evidence of gateEvidence) {
+    const chapter = evidence.chapter;
+    const editorialFile = editorialDecisionPath(product.book, chapter);
+    const currentEditorial = fs.existsSync(editorialFile) ? readJson(editorialFile) : null;
+    const report = readJson(path.join(PEOPLE_DIR, 'date-audits', product.book, `${chapter}.json`));
+    const status = dateAuditStatus(product.book, chapter);
+    if (evidence.editorial !== peopleDigest(currentEditorial) || evidence.dateAudit !== peopleDigest(report) ||
+        status.status !== 'audited' || status.auditVersion !== DATE_AUDIT_VERSION) {
+      throw new Error(`Editorial/date evidence changed while qualifying ${product.book}:${chapter}`);
+    }
+  }
+  const certificate = { schemaVersion: 1, kind: 'certified-ebook-people',
+    scope: { slug: product.slug, book: product.book, chapters: product.chapters },
+    manifest: peopleDigest(manifest), identity: peopleDigest(seal), gates: gateEvidence,
+    projection: peopleDigest(projected) };
+  return { active: true, preview: false, reason: null, ...projected, certificate,
+    peopleById: new Map(projected.catalog.people.map(person => [person.id, person])),
+    familyEdgesById: new Map(projected.catalog.familyEdges.map(edge => [edge.id, edge])) };
+}
+
+export function assertEbookPeopleCertificate(actual, expected) {
+  if (stableJson(actual) !== stableJson(expected)) {
+    throw new Error('EPUB people certificate does not match current authoritative source, gates, scope and identity generation');
+  }
+}
diff --git a/scripts/lib/ebook-certified-source.mjs b/scripts/lib/ebook-certified-source.mjs
new file mode 100644
--- /dev/null
+++ b/scripts/lib/ebook-certified-source.mjs
@@ -0,0 +1,36 @@
+import fs from 'node:fs';
+import { REPO_ROOT, buildInputFingerprint, contentUnits } from './people-content.mjs';
+import { peopleDigest, stableJson } from './people-identity-seal.mjs';
+
+export function assertCertifiedEbookRoot(root, label) {
+  const actual = fs.realpathSync(root);
+  const certified = fs.realpathSync(REPO_ROOT);
+  if (actual !== certified) {
+    throw new Error(`Required ebook ${label} ${actual} differs from certified people root ${certified}`);
+  }
+}
+
+export function assertCertifiedEbookChapterSource(context, book, chapter, data) {
+  const certificate = context?.certificate;
+  if (certificate?.schemaVersion !== 1 || certificate.kind !== 'certified-ebook-people' ||
+      certificate.scope?.book !== book || !certificate.scope.chapters?.includes(chapter) ||
+      !Array.isArray(certificate.gates)) throw new Error('Missing certified ebook source scope');
+  const gates = certificate.gates.filter(gate => gate.chapter === chapter);
+  if (gates.length !== 1 || !data) throw new Error(`Missing unique certified source gate for ${book}:${chapter}`);
+  const gate = gates[0];
+  const input = buildInputFingerprint(contentUnits(data));
+  if (gate.source !== peopleDigest(data) || gate.inputFingerprint !== input.chapterFingerprint ||
+      gate.inputUnitCount !== input.unitCount) {
+    throw new Error(`Actual ebook source differs from certified chapter ${book}:${chapter}`);
+  }
+}
+
+export function assertCertifiedEbookSources(context, product, chapters) {
+  const scope = context?.certificate?.scope;
+  if (scope?.slug !== product.slug || scope?.book !== product.book ||
+      stableJson(scope?.chapters) !== stableJson(product.chapters) ||
+      stableJson(chapters.map(item => item.chapter)) !== stableJson(product.chapters)) {
+    throw new Error('Actual ebook chapters differ from certified ordered product scope');
+  }
+  for (const { chapter, data } of chapters) assertCertifiedEbookChapterSource(context, product.book, chapter, data);
+}
diff --git a/scripts/lib/ebook-certified-verification.mjs b/scripts/lib/ebook-certified-verification.mjs
new file mode 100644
--- /dev/null
+++ b/scripts/lib/ebook-certified-verification.mjs
@@ -0,0 +1,60 @@
+import path from 'node:path';
+import { DATA_DIR, readJson, sourceUnitAt } from './people-content.mjs';
+import { loadCertifiedEbookPeople, assertEbookPeopleCertificate } from './ebook-certified-people.mjs';
+import { buildEbookPeople, ebookPersonHref, renderEbookPeopleIndex, renderEbookGlossaryShard } from './ebook-people-render.mjs';
+import { planEbookContentDocuments } from './ebook-content-layout.mjs';
+import { renderUnitWithPeople } from './people-site.mjs';
+import { getMainText } from './ebook-text.mjs';
+import { assertCertifiedEbookSources } from './ebook-certified-source.mjs';
+
+const personLinks = html => [...html.matchAll(/<a class="person-link"(?=\s|>)[^>]*>[\s\S]*?<\/a>/gu)].map(match => match[0]).sort();
+
+// Compare the real packaged reading artifact with fresh qualified source facts.
+// Neither a QA ready flag nor an attacker-adjusted count/hash can replace this.
+export function verifyCertifiedEbookPeople({ product, entries, readEntry, hasAbout,
+  context = loadCertifiedEbookPeople(product), chapterData = null }) {
+  const state = buildEbookPeople(context, product);
+  if (!state.ready || state.preview || !state.certificate) throw new Error('Required glossary has no certified non-preview context');
+  assertEbookPeopleCertificate(JSON.parse(readEntry('EPUB/people/certificate.json')), context.certificate);
+  const chapters = product.chapters.map(chapter => ({ chapter,
+    data: chapterData?.get(chapter) ?? readJson(path.join(DATA_DIR, product.book, `${chapter}.json`)) }));
+  assertCertifiedEbookSources(context, product, chapters);
+  const contentLayout = planEbookContentDocuments(chapters, { hasAbout,
+    peopleActive: true, peopleShards: state.shards.length });
+  const titles = new Map(chapters.map(({ chapter, data }) => [chapter, data.meta.title?.en || `Chapter ${Number.parseInt(chapter, 10)}`]));
+  const sourceByChapter = new Map(chapters.map(({ chapter, data }) => [chapter, data]));
+  const expected = new Map([['EPUB/people/index.xhtml', renderEbookPeopleIndex(state)]]);
+  for (const shard of state.shards) expected.set(`EPUB/people/${shard.file}`,
+    renderEbookGlossaryShard(shard, state, titles, contentLayout, sourceByChapter));
+  const actualFiles = entries.filter(entry => /^EPUB\/people\/.*\.xhtml$/u.test(entry)).sort();
+  if (actualFiles.join('|') !== [...expected.keys()].sort().join('|')) throw new Error('EPUB glossary file inventory differs from current certified product');
+  for (const [file, html] of expected) {
+    if (readEntry(file) !== html) throw new Error(`EPUB glossary content differs from current certified sources: ${file}`);
+  }
+  const expectedLinksByDocument = new Map();
+  for (const { chapter, data } of chapters) {
+    const chapterContext = state.chapterContexts.get(chapter);
+    const entry = `EPUB/text/${contentLayout.documentByChapter.get(chapter).file}`;
+    if (!expectedLinksByDocument.has(entry)) expectedLinksByDocument.set(entry, []);
+    for (const [unitId, mentions] of chapterContext.mentionsByUnit) {
+      const unit = sourceUnitAt(data, mentions[0].unit);
+      const html = renderUnitWithPeople({ unitId, text: getMainText(unit), language: 'en',
+        chapterContext, chineseWordSpans: false,
+        hrefForPerson: ({ personId }) => ebookPersonHref(state, personId, 'chapter') });
+      expectedLinksByDocument.get(entry).push(...personLinks(html));
+    }
+  }
+  for (const [entry, links] of expectedLinksByDocument) {
+    if (JSON.stringify(personLinks(readEntry(entry))) !== JSON.stringify(links.sort())) {
+      throw new Error(`EPUB English person links differ from current scoped extraction: ${entry}`);
+    }
+  }
+  // Extra text documents must not carry unverified person links.
+  for (const entry of entries.filter(value => /^EPUB\/text\/.*\.xhtml$/u.test(value))) {
+    if (!expectedLinksByDocument.has(entry) && personLinks(readEntry(entry)).length) {
+      throw new Error(`Unexpected EPUB person links in ${entry}`);
+    }
+  }
+  return { people: state.people.length, shards: state.shards.length,
+    expectedMentionLinks: state.expectedMentionLinks, expectedBacklinks: state.expectedBacklinks };
+}
diff --git a/scripts/lib/ebook-people-render.mjs b/scripts/lib/ebook-people-render.mjs
new file mode 100644
--- /dev/null
+++ b/scripts/lib/ebook-people-render.mjs
@@ -0,0 +1,215 @@
+import { chineseText, englishText, sourceUnitAt } from './people-content.mjs';
+import { chapterPeopleContext } from './people-site.mjs';
+import { assessEbookPeopleReadiness } from './ebook-people-readiness.mjs';
+import { ebookSentenceHref } from './ebook-content-layout.mjs';
+import { escapeXml, textContent, visibleTableText, formatList } from './ebook-text.mjs';
+import { humanizePeopleValue, personDisplayName, personFullDisplayName, personLifeSummary,
+  personPublicAliases, personPublicDescription } from './people-presentation.mjs';
+const peopleGlossaryTitle = 'People Glossary';
+
+export function ebookPersonAnchor(personId) {
+  return `person-${personId}`;
+}
+
+export function buildEbookPeople(siteContext, product, { allowPreview = false } = {}) {
+  const readiness = assessEbookPeopleReadiness(siteContext, product, {
+    allowPreview,
+  });
+  if (!readiness.active) return readiness;
+  const { chapterIds } = readiness;
+  const people = readiness.people.sort((left, right) =>
+    personDisplayName(left).localeCompare(personDisplayName(right), 'en') || left.id.localeCompare(right.id)
+  );
+  const peopleById = new Map(people.map((person) => [person.id, person]));
+  const shards = [];
+  const shardSize = 350;
+  for (let index = 0; index < people.length; index += shardSize) {
+    const number = shards.length + 1;
+    shards.push({
+      number,
+      file: `glossary-${String(number).padStart(3, '0')}.xhtml`,
+      people: people.slice(index, index + shardSize),
+    });
+  }
+  const fileByPersonId = new Map();
+  for (const shard of shards) {
+    for (const person of shard.people) fileByPersonId.set(person.id, shard.file);
+  }
+  const chapterContexts = new Map(product.chapters.map((chapter) => {
+    const chapterId = String(chapter).padStart(3, '0');
+    return [chapterId, chapterPeopleContext(siteContext, product.book, chapterId)];
+  }));
+  const mentionSpanKeys = new Set();
+  for (const [chapterId, context] of chapterContexts) {
+    for (const mention of context?.record.mentions ?? []) {
+      for (const span of mention.spans?.en ?? []) {
+        mentionSpanKeys.add([
+          chapterId,
+          mention.unit.id,
+          mention.personId,
+          span.startCodePoint,
+          span.endCodePoint,
+        ].join(':'));
+      }
+    }
+  }
+  const backlinks = people.reduce((total, person) =>
+    total + person.references.filter((reference) =>
+      reference.book === product.book && chapterIds.has(reference.chapter)
+    ).length, 0);
+  return {
+    active: true,
+    ready: readiness.ready,
+    preview: readiness.preview,
+    reason: null,
+    book: product.book,
+    chapterIds,
+    people,
+    missingChapters: readiness.missingChapters,
+    legacyChapters: readiness.legacyChapters,
+    dateAuditChapters: readiness.dateAuditChapters,
+    peopleNeedingReview: readiness.peopleNeedingReview,
+    peopleById,
+    familyPeopleById: siteContext.peopleById,
+    certificate: siteContext.certificate ?? null,
+    shards,
+    fileByPersonId,
+    chapterContexts,
+    expectedMentionLinks: mentionSpanKeys.size,
+    expectedBacklinks: backlinks,
+  };
+}
+
+export function ebookPersonHref(ebookPeople, personId, from = 'chapter') {
+  const file = ebookPeople?.fileByPersonId.get(personId);
+  if (!file) throw new Error(`No EPUB glossary target for canonical person ${personId}`);
+  const prefix = from === 'chapter' ? '../people/' : '';
+  return `${prefix}${file}#${ebookPersonAnchor(personId)}`;
+}
+
+function ebookGlossaryReferences(person, ebookPeople) {
+  return person.references.filter((reference) =>
+    reference.book === ebookPeople.book && ebookPeople.chapterIds.has(reference.chapter)
+  );
+}
+
+function renderEbookGlossaryFamily(person, ebookPeople) {
+  const rows = [];
+  const seen = new Set();
+  for (const relationship of person.familyRelationships) {
+    const key = `${relationship.edgeId}:${relationship.value.relation}:${relationship.value.personId}`;
+    if (seen.has(key)) continue;
+    seen.add(key);
+    const target = ebookPeople.familyPeopleById.get(relationship.value.personId);
+    if (!target) throw new Error(`Missing EPUB family target ${relationship.value.personId}`);
+    const label = `${humanizePeopleValue(relationship.value.relation)} ${personFullDisplayName(target)}`;
+    const targetFile = ebookPeople.fileByPersonId.get(target.id);
+    if (ebookPeople.certificate && !targetFile) throw new Error(`Certified family target ${target.id} has no glossary entry`);
+    rows.push(targetFile
+      ? `<li><a href="${escapeXml(targetFile)}#${ebookPersonAnchor(target.id)}">${escapeXml(label)}</a></li>`
+      : `<li>${escapeXml(label)}</li>`);
+  }
+  return rows.length ? `<h3>Family</h3><ul class="glossary-family">${rows.join('')}</ul>` : '';
+}
+
+function renderEbookGlossaryReferences(person, ebookPeople, chapterTitles, contentLayout, chapterDataById) {
+  const groups = new Map();
+  for (const reference of ebookGlossaryReferences(person, ebookPeople)) {
+    if (!groups.has(reference.chapter)) groups.set(reference.chapter, []);
+    groups.get(reference.chapter).push(reference);
+  }
+  if (!groups.size) return '';
+  const rows = [...groups.entries()].sort((left, right) => left[0].localeCompare(right[0])).map(([chapter, refs]) => {
+    const title = chapterTitles.get(chapter) || `Chapter ${Number.parseInt(chapter, 10)}`;
+    const chapterData = chapterDataById.get(chapter);
+    if (!chapterData) throw new Error(`Missing EPUB source chapter ${ebookPeople.book}/${chapter} for glossary reference`);
+    const snippets = refs.map((reference) => {
+      const unit = sourceUnitAt(chapterData, {
+        id: reference.unitId,
+        kind: reference.unitKind,
+        blockIndex: reference.blockIndex,
+        collection: reference.collection,
+        itemIndex: reference.itemIndex,
+      });
+      const href = `../${ebookSentenceHref(contentLayout, chapter, 'en', reference.unitId, 'text/')}`;
+      const zh = visibleTableText(chineseText(unit));
+      const en = visibleTableText(englishText(unit));
+      if (!zh && !en) throw new Error(`Empty EPUB glossary reference ${ebookPeople.book}:${chapter}:${reference.unitId}`);
+      return `<article class="glossary-mention-snippet">` +
+        `${zh ? `<a class="glossary-mention-source" lang="zh-Hant" href="${escapeXml(href)}">${escapeXml(zh)}</a>` : ''}` +
+        `${en ? `<a class="glossary-mention-link" href="${escapeXml(href)}">${escapeXml(en)}</a>` : ''}` +
+        `</article>`;
+    }).join('');
+    return `<li><h4>${escapeXml(title)}</h4>${snippets}</li>`;
+  });
+  return `<h3>Mentions</h3><ul class="glossary-mentions">${rows.join('')}</ul>`;
+}
+
+function renderEbookAliasTable(person) {
+  const aliases = personPublicAliases(person);
+  if (!aliases.length) return '';
+  const rows = aliases.map((name) => `<tr><th>${escapeXml(humanizePeopleValue(name.kind || 'name'))}</th>` +
+    `<td>${escapeXml(name.en || '')}</td><td lang="zh-Hant">${escapeXml(name.zh || '')}</td>` +
+    `<td>${escapeXml(name.pinyin || '')}</td></tr>`).join('');
+  return `<h3>Other names</h3><div class="glossary-aliases"><table><thead><tr>` +
+    `<th>Type</th><th>English</th><th>Chinese</th><th>Pinyin</th>` +
+    `</tr></thead><tbody>${rows}</tbody></table></div>`;
+}
+
+function renderEbookGlossaryEntry(person, ebookPeople, chapterTitles, contentLayout, chapterDataById) {
+  const roles = person.roles.map((role) => role.label);
+  const lifeSummary = personLifeSummary(person);
+  return `<section class="glossary-entry" id="${ebookPersonAnchor(person.id)}">
+  <h2>${escapeXml(personDisplayName(person))}${person.preferredName.zh ? ` <span lang="zh-Hant">${escapeXml(person.preferredName.zh)}</span>` : ''}</h2>
+  <p class="glossary-description">${escapeXml(personPublicDescription(person))}</p>
+  ${lifeSummary ? `<p class="glossary-dates">${escapeXml(lifeSummary)}</p>` : ''}
+  ${roles.length ? `<p><strong>Roles:</strong> ${escapeXml(formatList(roles))}</p>` : ''}
+  ${renderEbookAliasTable(person)}
+  ${renderEbookGlossaryFamily(person, ebookPeople)}
+  ${renderEbookGlossaryReferences(person, ebookPeople, chapterTitles, contentLayout, chapterDataById)}
+</section>`;
+}
+
+export function renderEbookPeopleIndex(ebookPeople) {
+  const items = ebookPeople.people.map((person) => {
+    const file = ebookPeople.fileByPersonId.get(person.id);
+    return `<li><a class="glossary-person-link" href="${escapeXml(file)}#${ebookPersonAnchor(person.id)}">` +
+      `${escapeXml(personDisplayName(person))}${person.preferredName.zh ? ` <span lang="zh-Hant">${escapeXml(person.preferredName.zh)}</span>` : ''}` +
+      `</a><span>${escapeXml(personPublicDescription(person))}</span></li>`;
+  }).join('\n      ');
+  return `<?xml version="1.0" encoding="utf-8"?>
+<!DOCTYPE html>
+<html xmlns="http://www.w3.org/1999/xhtml" xmlns:epub="http://www.idpf.org/2007/ops" xml:lang="en" lang="en">
+<head>
+  <title>${peopleGlossaryTitle}</title>
+  <link rel="stylesheet" type="text/css" href="../styles/ebook.css" />
+</head>
+<body>
+  <nav epub:type="glossary" class="people-glossary-index">
+    <h1>${peopleGlossaryTitle}</h1>
+    <ol>${items}</ol>
+  </nav>
+</body>
+</html>`;
+}
+
+export function renderEbookGlossaryShard(shard, ebookPeople, chapterTitles, contentLayout, chapterDataById) {
+  const entries = shard.people.map((person) =>
+    renderEbookGlossaryEntry(person, ebookPeople, chapterTitles, contentLayout, chapterDataById)
+  ).join('\n');
+  return `<?xml version="1.0" encoding="utf-8"?>
+<!DOCTYPE html>
+<html xmlns="http://www.w3.org/1999/xhtml" xmlns:epub="http://www.idpf.org/2007/ops" xml:lang="en" lang="en">
+<head>
+  <title>${peopleGlossaryTitle} ${shard.number}</title>
+  <link rel="stylesheet" type="text/css" href="../styles/ebook.css" />
+</head>
+<body>
+  <section epub:type="glossary" class="people-glossary">
+    <h1>${peopleGlossaryTitle}</h1>
+    ${entries}
+  </section>
+</body>
+</html>`;
+}
+
diff --git a/scripts/lib/ebook-text.mjs b/scripts/lib/ebook-text.mjs
new file mode 100644
--- /dev/null
+++ b/scripts/lib/ebook-text.mjs
@@ -0,0 +1,46 @@
+export function escapeXml(value) {
+  return String(value ?? '')
+    .replace(/&/g, '&amp;')
+    .replace(/</g, '&lt;')
+    .replace(/>/g, '&gt;')
+    .replace(/"/g, '&quot;')
+    .replace(/'/g, '&#039;');
+}
+
+export function textContent(value) {
+  return String(value ?? '').replace(/\s+/g, ' ').trim();
+}
+
+// Table cells retain a small amount of source layout metadata in the JSON.
+// It is useful to the web renderer but should never leak into a reading excerpt.
+export function visibleTableText(value) {
+  return String(value ?? '').replace(/^((?:(?:rowspan|colspan|valign|align|style|class)\s*=\s*"[^"]*"\s*)+)\|\s*/iu, '');
+}
+
+export function formatList(values) {
+  const items = values.map(textContent).filter(Boolean);
+  if (items.length <= 1) return items.join('');
+  if (items.length === 2) return `${items[0]} and ${items[1]}`;
+  return `${items.slice(0, -1).join(', ')}, and ${items.at(-1)}`;
+}
+
+export function getTranslationObject(item) {
+  if (!item) return null;
+  if (typeof item.idiomatic === 'string' || typeof item.literal === 'string' || typeof item.translation === 'string') {
+    return null;
+  }
+  const translation = item.translations?.find((entry) => entry.lang === 'en') || item.translations?.[0];
+  return translation || null;
+}
+
+export function getMainText(item) {
+  if (!item) return '';
+  const direct = item.idiomatic || item.literal || item.translation;
+  if (typeof direct === 'string' && direct.trim()) return direct.trim();
+  const trans = getTranslationObject(item);
+  if (trans) {
+    return textContent(trans.idiomatic || trans.literal || '');
+  }
+  return '';
+}
+
