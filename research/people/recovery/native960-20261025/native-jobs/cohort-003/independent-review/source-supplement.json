{
  "canonicalRevision": "30e2e9700c2494e6e7abcefeb53b19c24f7197c1",
  "supplements": [
    {
      "sourcePath": "data/jinshu/043.json",
      "rawSha256": "2194242f6445b5be263c15e6b6f6c34ea9381ae2ddf64cca912b87a47b682fbf",
      "units": [
        {
          "id": "s0235",
          "zh": "王戎，字濬沖，琅邪臨沂人也。"
        },
        {
          "id": "s0236",
          "zh": "祖雄，幽州刺史。"
        },
        {
          "id": "s0237",
          "zh": "父渾，涼州刺史、貞陵亭侯。"
        },
        {
          "id": "s0238",
          "zh": "戎幼而穎悟，神彩秀徹。"
        },
        {
          "id": "s0239",
          "zh": "視日不眩，裴楷見而目之曰：「戎眼燦燦，如岩下電。」"
        },
        {
          "id": "s0240",
          "zh": "年六七歲，于宣武場觀戲，猛獸在檻中虓吼震地，眾皆奔走，戎獨立不動，神色自若。"
        },
        {
          "id": "s0241",
          "zh": "魏明帝於閣上見而奇之。"
        },
        {
          "id": "s0242",
          "zh": "又嘗與群兒嬉於道側，見李樹多實，等輩兢趣之，戎獨不往。"
        },
        {
          "id": "s0243",
          "zh": "或問其故，其曰：「樹在道邊而多子，必苦李也。」"
        },
        {
          "id": "s0244",
          "zh": "取之信然。"
        },
        {
          "id": "s0245",
          "zh": "阮籍與渾為友。"
        },
        {
          "id": "s0246",
          "zh": "戎年十五，隨渾在郎舍。"
        },
        {
          "id": "s0247",
          "zh": "戎少籍二十歲，而籍與之交。"
        },
        {
          "id": "s0248",
          "zh": "籍每適渾，俄頃輒去，過視戎，良久然後出。"
        },
        {
          "id": "s0249",
          "zh": "謂渾曰：「濬沖清賞，非卿倫也。"
        },
        {
          "id": "s0250",
          "zh": "共卿言，不如共阿戎談。」"
        },
        {
          "id": "s0251",
          "zh": "及渾卒於涼州，故吏賻贈數百萬，戎辭而不受，由是顯名。"
        },
        {
          "id": "s0252",
          "zh": "為人短小，任率不修威儀，善發談端，賞其要會。"
        },
        {
          "id": "s0253",
          "zh": "朝賢嘗上巳禊洛，或問王濟曰：「昨游有何言談？」"
        },
        {
          "id": "s0254",
          "zh": "濟曰：「張華善說《史》《漢》；"
        },
        {
          "id": "s0255",
          "zh": "裴頠論前言往行，袞袞可聽；"
        },
        {
          "id": "s0256",
          "zh": "王戎談子房、季劄之間，超然玄著。」"
        },
        {
          "id": "s0257",
          "zh": "其為識鑒者所賞如此。"
        },
        {
          "id": "s0258",
          "zh": "戎嘗與阮籍飲，時兗州刺史劉昶字公榮在坐，籍以酒少，酌不及昶，昶無恨色。"
        },
        {
          "id": "s0259",
          "zh": "戎異之，他日問籍曰：「彼何如人也？」"
        },
        {
          "id": "s0260",
          "zh": "答曰：「勝公榮，不可不與飲；"
        },
        {
          "id": "s0261",
          "zh": "若減公榮，則不敢不共飲；"
        },
        {
          "id": "s0262",
          "zh": "惟公榮可不與飲。」"
        },
        {
          "id": "s0263",
          "zh": "戎每與籍為竹林之遊，戎嘗後至。"
        },
        {
          "id": "s0264",
          "zh": "籍曰：「俗物已復來敗人意。」"
        },
        {
          "id": "s0265",
          "zh": "戎笑曰：「卿輩意亦復易敗耳！」"
        },
        {
          "id": "s0266",
          "zh": "鐘會伐蜀，過與戎別，問計將安出。"
        },
        {
          "id": "s0267",
          "zh": "戎曰：「道家有言，'為而不恃'，非成功難，保之難也。」"
        },
        {
          "id": "s0268",
          "zh": "及會敗，議者以為知言。"
        },
        {
          "id": "s0269",
          "zh": "襲父爵，辟相國掾，曆吏部黃門郎、散騎常侍、河東太守、荊州刺史，坐遣吏修園宅，應免官，詔以贖論。"
        },
        {
          "id": "s0270",
          "zh": "遷豫州刺史，加建威將軍，受詔伐吳。"
        },
        {
          "id": "s0271",
          "zh": "戎遣參軍羅尚、劉喬領前鋒，進攻武昌，吳將楊雍、孫述、江夏太守劉朗各率眾詣戎降。"
        },
        {
          "id": "s0272",
          "zh": "戎督大軍臨江，吳牙門將孟泰以蘄春、邾二縣降。"
        },
        {
          "id": "s0273",
          "zh": "吳平，進爵安豐侯，增邑六千戶，賜絹六千匹。"
        },
        {
          "id": "s0274",
          "zh": "戎渡江，綏慰新附，宣揚威惠。"
        },
        {
          "id": "s0275",
          "zh": "吳光祿勳石偉方直，不容皓朝，稱疾歸家。"
        },
        {
          "id": "s0276",
          "zh": "戎嘉其清節，表薦之。"
        },
        {
          "id": "s0277",
          "zh": "詔拜偉為議郎，以二千石祿終其身。"
        },
        {
          "id": "s0278",
          "zh": "荊土悅服。"
        },
        {
          "id": "s0279",
          "zh": "徵為侍中。"
        },
        {
          "id": "s0280",
          "zh": "南郡太守劉肇賂戎筒中細布五十端，為司隸所糾，以知而未納，故得不坐，然議者尤之。"
        },
        {
          "id": "s0281",
          "zh": "帝謂朝臣曰：「戎之為行，豈懷私苟得，正當不欲為異耳！」"
        },
        {
          "id": "s0282",
          "zh": "帝雖以是言釋之，然為清慎者所鄙，由是損名。"
        },
        {
          "id": "s0283",
          "zh": "戎在職雖無殊能，而庶績修理。"
        },
        {
          "id": "s0284",
          "zh": "後遷光祿勳、吏部尚書，以母憂去職。"
        },
        {
          "id": "s0285",
          "zh": "性至孝，不拘禮制，飲酒食肉，或觀弈棋，而容貌毀悴，杖然後起。"
        },
        {
          "id": "s0286",
          "zh": "裴頠往吊之，謂人曰：「若使一慟能傷人，濬沖不免滅性之譏也。」"
        },
        {
          "id": "s0287",
          "zh": "時和嶠亦居父喪，以禮法自持，量米而食，哀毀不逾於戎。"
        },
        {
          "id": "s0288",
          "zh": "帝謂劉毅曰：「和嶠毀頓過禮，使人憂之。」"
        },
        {
          "id": "s0289",
          "zh": "毅曰：「嶠雖寢苫食粥，乃生孝耳。"
        },
        {
          "id": "s0290",
          "zh": "至於王戎，所謂死孝，陛下當先憂之。」"
        },
        {
          "id": "s0291",
          "zh": "戎先有吐疾，居喪增甚。"
        },
        {
          "id": "s0292",
          "zh": "帝遣醫療之，並賜藥物，又斷賓客。"
        },
        {
          "id": "s0293",
          "zh": "楊駿執政，拜太子太傅。"
        },
        {
          "id": "s0294",
          "zh": "駿誅之後，東安公繇專斷刑賞，威震外內。"
        },
        {
          "id": "s0295",
          "zh": "戎誡繇曰：「大事之後，宜深遠之。」"
        },
        {
          "id": "s0296",
          "zh": "繇不從，果得罪。"
        },
        {
          "id": "s0297",
          "zh": "轉中書令，加光祿大夫，給恩信五十人。"
        },
        {
          "id": "s0298",
          "zh": "遷尚書左僕射，領吏部。"
        },
        {
          "id": "s0299",
          "zh": "戎始為甲午制，凡選舉皆先治百姓，然後授用。"
        },
        {
          "id": "s0300",
          "zh": "司隸傅咸奏戎，曰：「《書》稱『三載考績，三考黜陟幽明』。"
        },
        {
          "id": "s0301",
          "zh": "今內外群官，居職未期而戎奏還，既未定其優劣，且送故迎新，相望道路，巧詐由生，傷農害政。"
        },
        {
          "id": "s0302",
          "zh": "戎不仰依堯舜典謨，而驅動浮華，虧敗風俗，非徒無益，乃有大損。"
        },
        {
          "id": "s0303",
          "zh": "宜免戎官，以敦風俗。」"
        },
        {
          "id": "s0304",
          "zh": "戎與賈、郭通親，竟得不坐。"
        },
        {
          "id": "s0305",
          "zh": "尋轉司徒。"
        },
        {
          "id": "s0306",
          "zh": "以王政將圮，苟媚取容，屬湣懷太子之廢，竟無一言匡諫。"
        },
        {
          "id": "s0307",
          "zh": "裴頠，戎之婿也，頠誅，戎坐免官。"
        },
        {
          "id": "s0308",
          "zh": "齊王冏起義，孫秀祿戎於城內，趙王倫子欲取戎為軍司。"
        },
        {
          "id": "s0309",
          "zh": "博士王繇曰：「濬沖譎詐多端，安肯為少年用？」"
        },
        {
          "id": "s0310",
          "zh": "乃止。"
        },
        {
          "id": "s0311",
          "zh": "惠帝反宮，以戎為尚書令。"
        },
        {
          "id": "s0312",
          "zh": "既而河間王顒遣使就說成都王穎，將誅齊王冏。"
        },
        {
          "id": "s0313",
          "zh": "檄書至，冏謂戎曰：「孫秀作逆，天子幽逼。"
        },
        {
          "id": "s0314",
          "zh": "孤糾合義兵，掃除元惡，臣子之節，信著神明。"
        },
        {
          "id": "s0315",
          "zh": "二王聽讒，造構大難，當賴忠謀，以和不協。"
        },
        {
          "id": "s0316",
          "zh": "卿其善為我籌之。」"
        },
        {
          "id": "s0317",
          "zh": "戎曰：「公首舉義眾，匡定大業，開闢以來，未始有也。"
        },
        {
          "id": "s0318",
          "zh": "然論功報嘗，不及有勞，朝野失望，人懷貳志。"
        },
        {
          "id": "s0319",
          "zh": "今二王帶甲百萬，其鋒不可當，若以王就第，不失故爵。"
        },
        {
          "id": "s0320",
          "zh": "委權崇讓，此求安之計也。」"
        },
        {
          "id": "s0321",
          "zh": "冏謀臣葛旟怒曰：「漢魏以來，王公就第，甯有得保妻子乎！"
        },
        {
          "id": "s0322",
          "zh": "議者可斬。」"
        },
        {
          "id": "s0323",
          "zh": "於是百官震悚，戎偽藥發墮廁，得不及禍。"
        },
        {
          "id": "s0324",
          "zh": "戎以晉室方亂，慕蘧伯玉之為人，與時舒卷，無蹇諤之節。"
        },
        {
          "id": "s0325",
          "zh": "自經典選，未嘗進寒素，退虛名，但與時浮沈，戶調門選而已。"
        },
        {
          "id": "s0326",
          "zh": "尋拜司徒，雖位總鼎司，而委事僚采。"
        },
        {
          "id": "s0327",
          "zh": "間乘小馬，從便門而出遊，見者不知其三公也。"
        },
        {
          "id": "s0328",
          "zh": "故吏多至大官，道路相遇輒避之。"
        },
        {
          "id": "s0329",
          "zh": "性好興利，廣收八方園田水碓，周遍天下。"
        },
        {
          "id": "s0330",
          "zh": "積實聚錢，不知紀極，每自執牙籌，晝夜算計，恆若不足。"
        },
        {
          "id": "s0331",
          "zh": "而又儉嗇，不自奉養，天下人謂之膏肓之疾。"
        },
        {
          "id": "s0332",
          "zh": "女適裴頠，貸錢數萬，久而未還。"
        },
        {
          "id": "s0333",
          "zh": "女後歸寧，戎色不悅，女遽還直，然後乃歡。"
        },
        {
          "id": "s0334",
          "zh": "從子將婚，戎遺其一單衣，婚訖而更責取。"
        },
        {
          "id": "s0335",
          "zh": "家有好李，常出貨之，恐人得種，恆鑽其核。"
        },
        {
          "id": "s0336",
          "zh": "以此獲譏於世。"
        },
        {
          "id": "s0337",
          "zh": "其後從帝北伐，王師敗績于蕩陰，戎復詣鄴，隨帝還洛陽。"
        },
        {
          "id": "s0338",
          "zh": "車駕之西遷也，戎出奔於郟。"
        },
        {
          "id": "s0339",
          "zh": "在危難之間，親接鋒刃，談笑自若，未嘗有懼容。"
        },
        {
          "id": "s0340",
          "zh": "時召親賓，歡娛永日，"
        },
        {
          "id": "s0341",
          "zh": "永興二年，薨於郟縣，時年七十二，諡曰元。"
        },
        {
          "id": "s0342",
          "zh": "戎有人倫鑒識，嘗目山濤如璞玉渾金，人皆欽其寶，莫知名其器；"
        },
        {
          "id": "s0343",
          "zh": "王衍神姿高徹，如瑤林瓊樹，自然是風塵表物。"
        },
        {
          "id": "s0344",
          "zh": "謂裴頠拙於用長，荀勖工於用短，陳道寧𦃩𦃩如束長竿。"
        },
        {
          "id": "s0345",
          "zh": "族弟敦有高名，戎惡之。"
        },
        {
          "id": "s0346",
          "zh": "敦每候戎，輒托疾不見。"
        },
        {
          "id": "s0347",
          "zh": "敦後果為逆亂。"
        },
        {
          "id": "s0348",
          "zh": "其鑒嘗先見如此。"
        },
        {
          "id": "s0349",
          "zh": "嘗經黃公酒壚下過，顧謂後車客曰：「吾昔與嵇叔夜、阮嗣宗酣暢于此，竹林之遊亦預其末。"
        },
        {
          "id": "s0350",
          "zh": "自嵇、阮雲亡，吾便為時之所羈絏。"
        },
        {
          "id": "s0351",
          "zh": "今日視之雖近，邈若山河！」"
        },
        {
          "id": "s0352",
          "zh": "初，孫秀為琅邪郡吏，求品於鄉議。"
        },
        {
          "id": "s0353",
          "zh": "戎從弟衍將不許，戎勸品之。"
        },
        {
          "id": "s0354",
          "zh": "及秀得志，朝士有宿怨者皆被誅，而戎、衍獲濟焉。"
        },
        {
          "id": "s0355",
          "zh": "子萬，有美名。"
        },
        {
          "id": "s0356",
          "zh": "少而大肥，戎令食穅，而肥愈甚。"
        },
        {
          "id": "s0357",
          "zh": "年十九卒。"
        },
        {
          "id": "s0358",
          "zh": "有庶子興，戎所不齒。"
        },
        {
          "id": "s0359",
          "zh": "以從弟陽平太守愔子為嗣。"
        }
      ]
    },
    {
      "sourcePath": "data/jinshu/035.json",
      "rawSha256": "8d146043298c4fe0463cebc4f2a88947b790206ee505173496646ecb4ed41e57",
      "units": [
        {
          "id": "s0278",
          "zh": "有五子：輿、瓚、憲、禮、遜。"
        },
        {
          "id": "s0279",
          "zh": "輿字祖明。"
        },
        {
          "id": "s0280",
          "zh": "少襲父爵，官至散騎侍郎，卒諡曰簡。"
        },
        {
          "id": "s0281",
          "zh": "瓚字國寶，中書郎，風神高邁，見者皆敬之。"
        },
        {
          "id": "s0282",
          "zh": "特為王綏所重，每從其遊。"
        },
        {
          "id": "s0283",
          "zh": "綏父戎謂之曰：「國寶初不來，汝數往，何也？」"
        },
        {
          "id": "s0284",
          "zh": "對曰：「國寶雖不知綏，綏自知國寶。」"
        },
        {
          "id": "s0285",
          "zh": "楊駿之誅，為亂兵所害。="
        }
      ]
    },
    {
      "sourcePath": "data/nanshi/063.json",
      "rawSha256": "f7d9e09fefbb46693e9a7a1e22bf1952d8f034fbfcb9183d4212a253c7c7f5f8",
      "units": [
        {
          "id": "s0001",
          "zh": "列傳第五十三"
        },
        {
          "id": "s0002",
          "zh": "王神念羊侃羊鴉仁"
        },
        {
          "id": "s0355",
          "zh": "及侯景降，詔鴉仁督土州刺史桓和之、仁州刺史湛海珍等趣縣瓠應接。"
        },
        {
          "id": "s0356",
          "zh": "景至，仍為都督、司豫二州刺史，鎮縣瓠。"
        },
        {
          "id": "s0357",
          "zh": "會侯景敗于渦陽，魏軍漸逼，鴉仁恐糧運不繼，遂還北司，上表陳謝。"
        }
      ]
    },
    {
      "sourcePath": "data/nanshi/046.json",
      "rawSha256": "2afd8300e52ae7d2ef4bb7e28bffda11182ce5a09237b39569369b7fef33c3ac",
      "units": [
        {
          "id": "s0001",
          "zh": "李安人"
        },
        {
          "id": "s0002",
          "zh": "安人少有大志，常拊髀歎曰：「大丈夫處世，富貴不可希，取三將五校，何難之有。」"
        },
        {
          "id": "s0022",
          "zh": "安人白高帝，欲于東奉江夏王躋起兵。"
        },
        {
          "id": "s0117",
          "zh": "性好酒，醉輒暴怒，上常使人節之。"
        }
      ]
    },
    {
      "sourcePath": "data/jiuwudaishi/067.json",
      "rawSha256": "93fff9ae225d94d3b1c8a96ff32e0ac9d66686d9e8a4802831da7355a96fba70",
      "units": [
        {
          "id": "s0238",
          "zh": "任圜，京兆三原人。"
        },
        {
          "id": "s0239",
          "zh": "祖清，成都少尹。"
        },
        {
          "id": "s0240",
          "zh": "父茂宏，避地太原，奏授西河令；"
        },
        {
          "id": "s0241",
          "zh": "有子五人，曰圖、回、圜、團、冏，風彩俱異。"
        },
        {
          "id": "s0242",
          "zh": "武皇愛之，以宗女妻團，歷代、憲二郡刺史。"
        }
      ]
    },
    {
      "sourcePath": "data/beishi/082.json",
      "rawSha256": "2608be5e3b243dfd90078de2384691224d1be951778f6e0c8c33266ba52a9a47",
      "units": [
        {
          "id": "s0208",
          "zh": "時外史廨宇屢移，未有定所。"
        },
        {
          "id": "s0209",
          "zh": "季明又上言曰：「外史之職，漢之東觀，帝王所寶，此焉攸在。"
        },
        {
          "id": "s0210",
          "zh": "自魏及周，公館不立，臣雖愚瞽，猶知其非。"
        },
        {
          "id": "s0211",
          "zh": "是以去年十一月中，敢冒奏陳，特降中旨，即遣修營。"
        },
        {
          "id": "s0212",
          "zh": "荏苒一周，未知功力。"
        },
        {
          "id": "s0213",
          "zh": "臣職思其憂，敢不重請。」"
        },
        {
          "id": "s0214",
          "zh": "帝納焉，於是廨宇方立。"
        }
      ]
    }
  ]
}
