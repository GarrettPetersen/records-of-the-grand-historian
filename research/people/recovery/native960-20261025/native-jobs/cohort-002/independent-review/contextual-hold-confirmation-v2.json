  "records": [
    {
      "localId": "jinshu:028:p340",
      "result": "confirmed-source-defect-hold",
      "reason": "Confirmed. s0696–s0698 narrate Eastern Jin Changming and explicitly compare 漢宣帝; s0727–s0729 move to Wei Jingchu and 宣帝誅曹爽. The comparison figure and regent are different; quotation frame does not unify them.",
      "sourcePin": {
        "sourcePath": "data/jinshu/028.json",
        "extractionPath": "data/people/extractions/jinshu/028.json",
        "sourceRawSha256": "fa35e2d5d31fbc5cc4e20cef8388238898f2460c6fdf8d0be2195a1cdb8df990",
        "extractionRawSha256": "0577f6b0788418d025e8966d5436740806dd82b88d50cf824c3ac29e18fa9a85",
        "sourceSemanticHash": "sha256:fcbbbce618dd2bd9898ca6bca3735e05530b7a4cf2eaf581383bf0069e66883a",
        "extractionSemanticHash": "sha256:119c82f5158166a97484d417e83c2e36f4c1aac529e02126f5e976503fbc7a00"
      },
      "scope": "Each cited anchor plus two preceding/following canonical units; sufficient explicit dynasty/reign/personal-name contrasts, no generic title inference",
      "canonicalContext": [
        {
          "id": "s0696",
          "zh": "時孝武年始四歲，俄而哀帝崩，海西即位，未幾而廢，簡文越自籓王，入纂大業，登阼享國，又不逾二年，而孝武嗣統。",
          "sourceBlockIndex": 166
        },
        {
          "id": "s0697",
          "zh": "帝諱昌明，識者竊謂西昌修明之祥，帝諱實應焉。",
          "sourceBlockIndex": 166
        },
        {
          "id": "s0698",
          "zh": "是亦與漢宣帝同象也。",
          "sourceBlockIndex": 166
        },
        {
          "id": "s0699",
          "zh": "海西太和元年，涼州楊樹生松。",
          "sourceBlockIndex": 167
        },
        {
          "id": "s0700",
          "zh": "天戒若曰，松者不改柯易葉，楊者柔脆之木，今松生於楊，豈非永久之業將集危亡之地邪？",
          "sourceBlockIndex": 167
        },
        {
          "id": "s0727",
          "zh": "景初元年，又有燕生巨鷇於衛國李蓋家，形若鷹，吻似燕，此羽蟲之孽，又赤眚也。",
          "sourceBlockIndex": 177
        },
        {
          "id": "s0728",
          "zh": "高堂隆曰：「此魏室之大異，宜防鷹揚之臣于蕭牆之內。」",
          "sourceBlockIndex": 177
        },
        {
          "id": "s0729",
          "zh": "其後宣帝起誅曹爽，遂有魏室。",
          "sourceBlockIndex": 177
        },
        {
          "id": "s0730",
          "zh": "漢獻帝建安二十三年，禿鶖鳥集鄴宮文昌殿后池。",
          "sourceBlockIndex": 178
        },
        {
          "id": "s0731",
          "zh": "明年，魏武王薨。",
          "sourceBlockIndex": 178
        }
      ],
      "affectedClaimIds": [
