    {
      "localId": "jinshu:020:p020",
      "result": "confirmed-source-defect-hold",
      "reason": "Confirmed. s0095–s0108 contain an Eastern Jin mourning debate citing 博士吳商 and criticizing 吳商中才小官. The English Wu name claim is attached to that official; s0121 contrasts Wei mourning and s0122–s0123 introduce Jin Wu then Hui. These identities cannot be united.",
      "sourcePin": {
        "sourcePath": "data/jinshu/020.json",
        "extractionPath": "data/people/extractions/jinshu/020.json",
        "sourceRawSha256": "ea4c955dcfebe4b9ec6f7ff187319a9f589b9497cb12c158344b469e44d9c0a2",
        "extractionRawSha256": "076de1941e0271dca7d9e90bfc4333b11efa355f8e010be0bd40d351d350e04e",
        "sourceSemanticHash": "sha256:391b3e98b753006b75ade5b5cb8d029d32c295a67839d26f03d29b4d7bdf5b22",
        "extractionSemanticHash": "sha256:4c037d4190d0cab2dca6b00c83686b26a3a44bc546951ee974b390be0738278e"
      },
      "scope": "Each cited anchor plus two preceding/following canonical units; sufficient explicit dynasty/reign/personal-name contrasts, no generic title inference",
      "canonicalContext": [
        {
          "id": "s0085",
          "zh": "每代禮典質文皆不同耳，何為限以近制，使達喪闕然乎！」",
          "sourceBlockIndex": 3
        },
        {
          "id": "s0086",
          "zh": "群臣又固請，帝流涕久之乃許。",
          "sourceBlockIndex": 3
        },
        {
          "id": "s0087",
          "zh": "文明皇后崩及武元楊后崩，天下將吏發哀三日止。",
          "sourceBlockIndex": 3
        },
        {
          "id": "s0088",
          "zh": "穆帝崩，哀帝立。",
          "sourceBlockIndex": 4
        },
        {
          "id": "s0089",
          "zh": "帝于穆帝為從父昆弟，穆帝舅褚歆有表，中書答表朝廷無其儀，詔下議。",
          "sourceBlockIndex": 4
        },
        {
          "id": "s0095",
          "zh": "寧康二年七月，簡文帝崩再周而遇閏。",
          "sourceBlockIndex": 5
        },
        {
          "id": "s0096",
          "zh": "博士謝攸、孔粲議：「魯襄二十八年十二月乙未，楚子卒，實閏月而言十二月者，附正於前月也。",
          "sourceBlockIndex": 5
        },
        {
          "id": "s0097",
          "zh": "喪事先遠，則應用博士吳商之言，以閏月祥。」",
          "sourceBlockIndex": 5
        },
        {
          "id": "s0098",
          "zh": "尚書僕射謝安、中領軍王劭、散騎常侍鄭襲、右衛將軍殷康、驍騎將軍袁宏、散騎侍郎殷茂、中書郎車胤、左丞劉遵、吏部郎劉耽意皆同。",
          "sourceBlockIndex": 5
        },
        {
          "id": "s0099",
          "zh": "康曰：「過七月而未及八月，豈可謂之逾期。",
          "sourceBlockIndex": 5
        },
        {
          "id": "s0104",
          "zh": "先朝尚用閏之後月，今閏附七月，取之何疑，亦合遠日申情之言。",
          "sourceBlockIndex": 5
        },
        {
          "id": "s0105",
          "zh": "又閏是後七而非八也，豈逾月之嫌乎！」",
          "sourceBlockIndex": 5
        },
        {
          "id": "s0106",
          "zh": "尚書令王彪之、侍中王混、中丞譙王恬、右丞戴謐等議異，彪之曰：「吳商中才小官，非名賢碩儒、公輔重臣、為時所準則者。",
          "sourceBlockIndex": 5
        },
        {
          "id": "s0107",
          "zh": "又取閏無證據，直攬遠日之義，越祥忌，限外取，不合卜遠之理。",
          "sourceBlockIndex": 5
        },
        {
          "id": "s0108",
          "zh": "又丞相桓公嘗論云，《禮》二十五月大祥。",
          "sourceBlockIndex": 5
        },
        {
          "id": "s0120",
          "zh": "執政從而行之，其殆過矣。」",
          "sourceBlockIndex": 5
        },
        {
          "id": "s0121",
          "zh": "魏武以正月崩，魏文以其年七月設妓樂百戲，是則魏不以喪廢樂也。",
          "sourceBlockIndex": 6
        },
        {
          "id": "s0122",
          "zh": "武帝以來，國有大喪，輒廢樂終三年。",
          "sourceBlockIndex": 6
        },
        {
          "id": "s0123",
          "zh": "惠帝太安元年，太子喪未除，及元會亦廢樂。",
          "sourceBlockIndex": 6
        },
        {
          "id": "s0124",
          "zh": "穆帝永和中，為中原山陵未修復，頻年元會廢樂。",
          "sourceBlockIndex": 6
        }
      ],
      "affectedClaimIds": [
