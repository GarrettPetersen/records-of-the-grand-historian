      },
      "scope": "Each cited anchor plus two preceding/following canonical units; sufficient explicit dynasty/reign/personal-name contrasts, no generic title inference",
      "canonicalContext": [
        {
          "id": "s0387",
          "zh": "黃曇子乃是王忱字也。",
          "sourceBlockIndex": 82
        },
        {
          "id": "s0388",
          "zh": "忱小字佛大，是「大佛來上明」也。",
          "sourceBlockIndex": 82
        },
        {
          "id": "s0389",
          "zh": "孝武帝太元末，京口謠曰：「黃雌雞，莫作雄父啼。",
          "sourceBlockIndex": 83
        },
        {
          "id": "s0390",
          "zh": "一旦去毛衣，衣被拉颯棲。」",
          "sourceBlockIndex": 83
        },
        {
          "id": "s0391",
          "zh": "尋而王恭起兵誅王國寶，旋為劉牢之所敗，故言「拉颯棲」也。",
          "sourceBlockIndex": 83
        },
        {
          "id": "s0447",
          "zh": "毛蟲之孽",
          "sourceBlockIndex": 97
        },
        {
          "id": "s0448",
          "zh": "（分段）",
          "sourceBlockIndex": 98
        },
        {
          "id": "s0449",
          "zh": "武帝太康六年，南陽獻兩足猛獸，此毛蟲之孽也。",
          "sourceBlockIndex": 99
        },
        {
          "id": "s0450",
          "zh": "識者為其文曰：「武形有虧，金獸失儀，聖主應天，期異何為！」",
          "sourceBlockIndex": 99
        },
        {
          "id": "s0451",
          "zh": "言兆亂也。",
          "sourceBlockIndex": 99
        },
        {
          "id": "s0457",
          "zh": "至元康九年，始殺太子，距此十四年。",
          "sourceBlockIndex": 99
        },
        {
          "id": "s0458",
          "zh": "二七十四，火始終相乘之數也。",
          "sourceBlockIndex": 99
        },
        {
          "id": "s0459",
          "zh": "自帝受命，至湣懷之廢，凡三十五年焉。",
          "sourceBlockIndex": 99
        },
        {
          "id": "s0460",
          "zh": "太康七年十一月丙辰，四角獸見於河間，河間王顒獲以獻。",
          "sourceBlockIndex": 100
        },
        {
          "id": "s0461",
          "zh": "天戒若曰，角，兵象也，四者，四方之象，當有兵亂起于四方。",
          "sourceBlockIndex": 100
        }
      ],
