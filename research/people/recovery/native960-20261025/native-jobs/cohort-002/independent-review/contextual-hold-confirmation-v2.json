    {
      "localId": "jiutangshu:029:p060",
      "result": "confirmed-source-defect-hold",
      "reason": "Confirmed. s0105–s0108 distinguish Wei Wu/Jin Xuan/Jin Wu; s0112–s0114 explicitly shift to 唐景皇帝始封唐公 and 皇家太廟, with earlier 唐宣光 ancestors. Tang 宣 is not Jin 宣.",
      "sourcePin": {
        "sourcePath": "data/jiutangshu/029.json",
        "extractionPath": "data/people/extractions/jiutangshu/029.json",
        "sourceRawSha256": "7e958a5a7b7c50dbdf6089caee19f3938a6d94077c41146d5e4917443f8ce6e8",
        "extractionRawSha256": "82bb5af9706c5098a24c75da9673dbc038225408ad8f0577880ec3a77cd770f9",
        "sourceSemanticHash": "sha256:e513afb2c82da3a9b3d3bfbd1677f2da7a5fc86feee41d6eaf91a0fa48347999",
        "extractionSemanticHash": "sha256:6222312e8dfeca9142e9480a6c12a94c714929b577b6c49ce60d62df6bea7b88"
      },
      "scope": "Each cited anchor plus two preceding/following canonical units; sufficient explicit dynasty/reign/personal-name contrasts, no generic title inference",
      "canonicalContext": [
        {
          "id": "s0105",
          "zh": "魏武創業，文帝受命，亦即以武帝為太祖。",
          "sourceBlockIndex": 7
        },
        {
          "id": "s0106",
          "zh": "其高皇、太皇、外處君等並為屬尊，不在昭穆合食之列。",
          "sourceBlockIndex": 7
        },
        {
          "id": "s0107",
          "zh": "晉宣創業，武帝受命，亦即以宣帝為太祖。",
          "sourceBlockIndex": 7
        },
        {
          "id": "s0108",
          "zh": "其征西、豫章、潁川、京兆府君等並為屬尊，不在昭穆合食之列。",
          "sourceBlockIndex": 7
        },
        {
          "id": "s0109",
          "zh": "歷茲已降，至於有隋，宗廟之制，斯禮不改。",
          "sourceBlockIndex": 7
        },
        {
          "id": "s0112",
          "zh": "景皇帝始封唐公，實為太祖。",
          "sourceBlockIndex": 7
        },
        {
          "id": "s0113",
          "zh": "中間代數既近，列在三昭三穆之內，故皇家太廟，唯有六室。",
          "sourceBlockIndex": 7
        },
        {
          "id": "s0114",
          "zh": "其弘農府君、宣、光二帝，尊于太祖，親盡則遷，不在昭穆合食之數。",
          "sourceBlockIndex": 7
        },
        {
          "id": "s0115",
          "zh": "今皇極再造，孝思匪寧。",
          "sourceBlockIndex": 7
        },
        {
          "id": "s0116",
          "zh": "奉二月二十九日敕：「七室已下，依舊號尊崇。」",
          "sourceBlockIndex": 7
        }
      ],
      "affectedClaimIds": [
        "jiutangshu:029:c0160",
        "jiutangshu:029:c0161",
