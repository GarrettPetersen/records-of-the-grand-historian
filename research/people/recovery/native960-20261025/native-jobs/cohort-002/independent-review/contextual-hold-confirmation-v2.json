    {
      "localId": "jinshu:028:p205",
      "result": "confirmed-source-defect-hold",
      "reason": "Confirmed. s0389–s0391 explicitly place a rhyme in 孝武帝太元末, followed by Wang Gong/Wang Guobao/Liu Laozhi. A later portent section s0447–s0459 recounts 武帝太康六年 and Minhuai. These are separate annalistic episodes and emperors.",
      "sourcePin": {
        "sourcePath": "data/jinshu/028.json",
        "extractionPath": "data/people/extractions/jinshu/028.json",
        "sourceRawSha256": "fa35e2d5d31fbc5cc4e20cef8388238898f2460c6fdf8d0be2195a1cdb8df990",
