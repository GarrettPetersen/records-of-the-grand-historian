      "scope": "Each cited anchor plus two preceding/following canonical units; sufficient explicit dynasty/reign/personal-name contrasts, no generic title inference",
      "canonicalContext": [
        {
          "id": "s0542",
          "zh": "干寶以為「孫皓承廢故之家得位，其應也。」",
          "sourceBlockIndex": 126
        },
        {
          "id": "s0543",
          "zh": "或曰孫休見立之祥也。",
          "sourceBlockIndex": 126
        },
        {
          "id": "s0544",
          "zh": "武帝太康十年，洛陽宮西宜秋裏石生地中，始高三尺，如香鈩形，後如傴人，槃薄不可掘。",
          "sourceBlockIndex": 127
        },
        {
          "id": "s0545",
          "zh": "案劉向說，此白眚也。",
          "sourceBlockIndex": 127
        },
        {
          "id": "s0546",
          "zh": "明年宮車晏駕，王室始騷，卒以亂亡。",
          "sourceBlockIndex": 127
        },
        {
          "id": "s0547",
          "zh": "京房《易傳》曰：「石立如人，庶士為天下雄。」",
          "sourceBlockIndex": 127
        },
        {
          "id": "s0548",
          "zh": "此近之矣。",
          "sourceBlockIndex": 127
        },
        {
          "id": "s0557",
          "zh": "案占，此白祥也。",
          "sourceBlockIndex": 129
        },
        {
          "id": "s0558",
          "zh": "是後騰為汲桑所殺，而天下遂亂。",
          "sourceBlockIndex": 129
        },
        {
          "id": "s0559",
          "zh": "武帝泰始八年五月，蜀地雨白毛，此白祥也。",
          "sourceBlockIndex": 130
        },
        {
          "id": "s0560",
          "zh": "時益州刺史皇甫晏伐汶山胡，從事何旅固諫，不從，牙門張弘等困眾之怨，誣晏謀逆，害之。",
          "sourceBlockIndex": 130
        },
        {
          "id": "s0561",
          "zh": "京房《易傳》曰：「前樂後憂，厥妖天雨羽。」",
          "sourceBlockIndex": 130
        },
        {
          "id": "s0590",
          "zh": "郊禖壇者，求子之神位，無故自毀，太子將危之象也。",
          "sourceBlockIndex": 142
        },
        {
          "id": "s0591",
          "zh": "明年湣懷廢死。",
          "sourceBlockIndex": 142
        },
        {
          "id": "s0592",
          "zh": "孝武帝太元十年四月，謝安出鎮廣陵，始發石頭，金鼓無故自破。",
          "sourceBlockIndex": 143
        },
        {
          "id": "s0593",
          "zh": "此木沴金之異也，天意也。",
          "sourceBlockIndex": 143
        },
        {
          "id": "s0594",
          "zh": "天戒若曰，安徒揚經略之聲，終無其實，鉦鼓不用之象也。",
          "sourceBlockIndex": 143
        }
      ],
