        {
          "id": "s0103",
          "zh": "其後漢高祖受命，無始封祖，即以高皇帝為太祖。",
          "sourceBlockIndex": 7
        },
        {
          "id": "s0104",
          "zh": "太上皇高帝之父，立廟享祀，不在昭穆合食之列，為尊于太祖故也。",
          "sourceBlockIndex": 7
        },
        {
          "id": "s0105",
          "zh": "魏武創業，文帝受命，亦即以武帝為太祖。",
          "sourceBlockIndex": 7
        },
        {
          "id": "s0106",
          "zh": "其高皇、太皇、外處君等並為屬尊，不在昭穆合食之列。",
          "sourceBlockIndex": 7
        },
        {
          "id": "s0107",
          "zh": "晉宣創業，武帝受命，亦即以宣帝為太祖。",
          "sourceBlockIndex": 7
        },
        {
          "id": "s0108",
          "zh": "其征西、豫章、潁川、京兆府君等並為屬尊，不在昭穆合食之列。",
          "sourceBlockIndex": 7
        },
        {
          "id": "s0109",
          "zh": "歷茲已降，至於有隋，宗廟之制，斯禮不改。",
          "sourceBlockIndex": 7
        }
      ],
