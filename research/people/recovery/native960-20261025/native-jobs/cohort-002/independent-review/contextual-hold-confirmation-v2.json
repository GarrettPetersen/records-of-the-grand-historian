      "scope": "Each cited anchor plus two preceding/following canonical units; sufficient explicit dynasty/reign/personal-name contrasts, no generic title inference",
      "canonicalContext": [
        {
          "id": "s0762",
          "zh": "案《瑞應圖》，大鳥似鳳而為孽者非一，宜皆是也。",
          "sourceBlockIndex": 183
        },
        {
          "id": "s0763",
          "zh": "孫皓建衡三年，西苑言鳳皇集，以之改元，義同於亮。",
          "sourceBlockIndex": 184
        },
        {
          "id": "s0764",
          "zh": "武帝泰始四年八月，有翟雉飛上閶闔門。",
          "sourceBlockIndex": 185
        },
        {
          "id": "s0765",
          "zh": "天戒若曰，閶闔門非雉所止，猶殷宗雉登鼎耳之戒也。",
          "sourceBlockIndex": 185
        },
        {
          "id": "s0766",
          "zh": "惠帝永康元年，趙王倫既篡，京師得異鳥，莫能名。",
          "sourceBlockIndex": 186
        },
        {
          "id": "s0796",
          "zh": "此羽蟲之孽也。",
          "sourceBlockIndex": 192
        },
        {
          "id": "s0797",
          "zh": "尋為桓溫所廢也。",
          "sourceBlockIndex": 192
        },
        {
          "id": "s0798",
          "zh": "孝武帝太元十六年六月，鵲巢太極東頭鴟尾，又巢國子學堂西頭。",
          "sourceBlockIndex": 193
        },
        {
          "id": "s0799",
          "zh": "十八年東宮始成，十九年正月鵲又巢其西門。",
          "sourceBlockIndex": 193
        },
        {
          "id": "s0800",
          "zh": "此殆與魏景初同占。",
          "sourceBlockIndex": 193
        },
        {
          "id": "s0822",
          "zh": "後人白喜謀北叛，闔門被誅。",
          "sourceBlockIndex": 203
        },
        {
          "id": "s0823",
          "zh": "京房《易傳》曰：「山見葆，江於邑，邑有兵，狀如人頭，赤色。」",
          "sourceBlockIndex": 203
        },
        {
          "id": "s0824",
          "zh": "武帝太康五年四月壬子，魯國池水變赤如血。",
          "sourceBlockIndex": 204
        },
        {
          "id": "s0825",
          "zh": "七年十月，河陰有赤雪二頃。",
          "sourceBlockIndex": 205
        },
        {
          "id": "s0826",
          "zh": "此赤祥也。",
          "sourceBlockIndex": 205
        },
        {
          "id": "s0827",
          "zh": "是後四載而帝崩，王室遂亂。",
          "sourceBlockIndex": 205
        },
        {
          "id": "s0828",
          "zh": "惠帝元康五年三月，呂縣有流血，東西百餘步，此赤祥也。",
          "sourceBlockIndex": 206
        },
        {
          "id": "s0829",
          "zh": "至元康末，窮凶極亂，僵屍流血之應也。",
          "sourceBlockIndex": 206
        }
      ],
