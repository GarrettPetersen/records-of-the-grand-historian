    {
      "localId": "jinshu:020:p167",
      "result": "confirmed-source-defect-hold",
      "reason": "Confirmed. s0368 is explicitly a retrospective 魏武帝建安 precedent quoted in a Jin recommendation (s0369 大晉采以著令). Quoted Cao Cao stays a separate referent from 武帝泰始四年 s0404 and the Jin tomb visitor s0436.",
      "sourcePin": {
        "sourcePath": "data/jinshu/020.json",
        "extractionPath": "data/people/extractions/jinshu/020.json",
        "sourceRawSha256": "ea4c955dcfebe4b9ec6f7ff187319a9f589b9497cb12c158344b469e44d9c0a2",
        "extractionRawSha256": "076de1941e0271dca7d9e90bfc4333b11efa355f8e010be0bd40d351d350e04e",
        "sourceSemanticHash": "sha256:391b3e98b753006b75ade5b5cb8d029d32c295a67839d26f03d29b4d7bdf5b22",
        "extractionSemanticHash": "sha256:4c037d4190d0cab2dca6b00c83686b26a3a44bc546951ee974b390be0738278e"
      },
      "scope": "Each cited anchor plus two preceding/following canonical units; sufficient explicit dynasty/reign/personal-name contrasts, no generic title inference",
      "canonicalContext": [
        {
          "id": "s0366",
          "zh": "未同于古，則其尊未全，不宜便從絕期之制，而令傍親服斬衰之重也。",
          "sourceBlockIndex": 30
        },
        {
          "id": "s0367",
          "zh": "諸侯既然，則公孤之爵亦宜如舊。",
          "sourceBlockIndex": 30
        },
        {
          "id": "s0368",
          "zh": "昔魏武帝建安中已曾表上，漢朝依古為制，事與古異，皆不施行，施行者著在魏科。",
          "sourceBlockIndex": 30
        },
        {
          "id": "s0369",
          "zh": "大晉采以著令，宜定新禮皆如舊。」",
          "sourceBlockIndex": 30
        },
        {
          "id": "s0370",
          "zh": "詔從之。",
          "sourceBlockIndex": 30
        },
        {
          "id": "s0402",
          "zh": "景、文皆謹奉成命，無所加焉。",
          "sourceBlockIndex": 33
        },
        {
          "id": "s0403",
          "zh": "景帝崩，喪事制度又依宣帝故事。",
          "sourceBlockIndex": 33
        },
        {
          "id": "s0404",
          "zh": "武帝泰始四年，文明王皇后崩，將合葬，開崇陽陵，使太尉司馬望奉祭，進皇帝密璽綬于便房神坐。",
          "sourceBlockIndex": 33
        },
        {
          "id": "s0405",
          "zh": "魏氏金璽，此又儉矣。",
          "sourceBlockIndex": 33
        },
        {
          "id": "s0406",
          "zh": "江左初，元、明崇儉，且百度草創，山陵奉終，省約備矣。",
          "sourceBlockIndex": 33
        },
        {
          "id": "s0434",
          "zh": "及宣帝，遺詔「子弟群官皆不得謁陵」。",
          "sourceBlockIndex": 36
        },
        {
          "id": "s0435",
          "zh": "於是景、文遵旨。",
          "sourceBlockIndex": 36
        },
        {
          "id": "s0436",
          "zh": "至武帝，猶再謁崇陽陵，一謁峻平陵，然遂不敢謁高原陵，至惠帝復止也。",
          "sourceBlockIndex": 36
        },
        {
          "id": "s0437",
          "zh": "逮于江左，元帝崩後，諸公始有謁陵辭告之事。",
          "sourceBlockIndex": 37
        },
        {
          "id": "s0438",
          "zh": "蓋由眷同友執，率情而舉，非洛京之舊也。",
          "sourceBlockIndex": 37
        }
      ],
