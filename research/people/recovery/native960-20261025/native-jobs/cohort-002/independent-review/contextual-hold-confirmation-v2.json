    {
      "localId": "jinshu:020:p092",
      "result": "confirmed-source-defect-hold",
      "reason": "Confirmed. s0167–s0172 concern Western Jin Wu’s Yang empress and Hui/Huai-era posthumous rites; s0200/s0206 explicitly date 孝武帝太元十五/二十一 and his death. Later speech frames do not equate Eastern Jin Xiaowu with Sima Yan.",
      "sourcePin": {
        "sourcePath": "data/jinshu/020.json",
        "extractionPath": "data/people/extractions/jinshu/020.json",
        "sourceRawSha256": "ea4c955dcfebe4b9ec6f7ff187319a9f589b9497cb12c158344b469e44d9c0a2",
        "extractionRawSha256": "076de1941e0271dca7d9e90bfc4333b11efa355f8e010be0bd40d351d350e04e",
        "sourceSemanticHash": "sha256:391b3e98b753006b75ade5b5cb8d029d32c295a67839d26f03d29b4d7bdf5b22",
        "extractionSemanticHash": "sha256:4c037d4190d0cab2dca6b00c83686b26a3a44bc546951ee974b390be0738278e"
      },
      "scope": "Each cited anchor plus two preceding/following canonical units; sufficient explicit dynasty/reign/personal-name contrasts, no generic title inference",
      "canonicalContext": [
        {
          "id": "s0165",
          "zh": "其傳記有與今議同者，亦具列之，博舉二隅，明其會歸，以證斯事。",
          "sourceBlockIndex": 10
        },
        {
          "id": "s0166",
          "zh": "文多不載。",
          "sourceBlockIndex": 10
        },
        {
          "id": "s0167",
          "zh": "武帝楊悼皇后既母養懷帝，后遇難時，懷帝尚幼，及即位，中詔述后恩愛。",
          "sourceBlockIndex": 11
        },
        {
          "id": "s0168",
          "zh": "及后祖載，群官議帝應為追制服，或以庶母慈己，依禮制小功五月，或以謂慈母服如母服齊衰者，眾議不同。",
          "sourceBlockIndex": 11
        },
        {
          "id": "s0169",
          "zh": "閭丘沖議云：「楊后母養聖上，蓋以曲情。",
          "sourceBlockIndex": 11
        },
        {
          "id": "s0170",
          "zh": "今以恩禮追崇，不配世祖廟。",
          "sourceBlockIndex": 11
        },
        {
          "id": "s0171",
          "zh": "王者無慈養之服，謂宜祖載之日，可三朝素服發哀而已。」",
          "sourceBlockIndex": 11
        },
        {
          "id": "s0172",
          "zh": "於是從之。",
          "sourceBlockIndex": 11
        },
        {
          "id": "s0198",
          "zh": "永安皇后無服，但一舉哀，百官亦一期。」",
          "sourceBlockIndex": 15
        },
        {
          "id": "s0199",
          "zh": "詔可。",
          "sourceBlockIndex": 15
        },
        {
          "id": "s0200",
          "zh": "孝武帝太元十五年，淑媛陳氏卒，皇太子所生也。",
          "sourceBlockIndex": 16
        },
        {
          "id": "s0201",
          "zh": "有司參詳母以子貴，贈淑媛為夫人，置家令典喪事。",
          "sourceBlockIndex": 16
        },
        {
          "id": "s0202",
          "zh": "太子前衛率徐邈議：「《喪服傳》稱與尊者為體，則不服其私親。",
          "sourceBlockIndex": 16
        },
        {
          "id": "s0204",
          "zh": "故王公妾子服其所生母練冠麻衣，既葬而除，非五服之常，則謂之無服。」",
          "sourceBlockIndex": 16
        },
        {
          "id": "s0205",
          "zh": "從之，",
          "sourceBlockIndex": 16
        },
        {
          "id": "s0206",
          "zh": "太元二十一年，孝武帝崩，孝武太后制三年之服。",
          "sourceBlockIndex": 17
        },
        {
          "id": "s0207",
          "zh": "惠帝太安元年三月，皇太孫尚薨。",
          "sourceBlockIndex": 18
        },
        {
          "id": "s0208",
          "zh": "有司奏，御服齊衰期。",
          "sourceBlockIndex": 18
        }
      ],
