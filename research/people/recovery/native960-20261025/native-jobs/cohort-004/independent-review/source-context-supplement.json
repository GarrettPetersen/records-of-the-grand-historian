{
  "baseline": "30e2e9700c2494e6e7abcefeb53b19c24f7197c1",
  "purpose": "Independent source context only; does not modify or replace sealed input. Complete selected blocks retained.",
  "sources": [
    {
      "chapter": "sanguozhi:064",
      "sourcePath": "data/sanguozhi/064.json",
      "baselineRawSha256": "ece8ed2bbea65d9e41e2ac77e7a2efb4086a306ac08b7330be4a157425db3fa3",
      "blocks": [
        {
          "blockIndex": 36,
          "sentences": [
            {
              "id": "s0474",
              "zh": "典軍施正勸綝徵立琅邪王休，綝從之。"
            },
            {
              "id": "s0475",
              "zh": "遣宗正楷奉書於休曰："
            }
          ]
        },
        {
          "blockIndex": 37,
          "sentences": [
            {
              "id": "s0476",
              "zh": "綝以薄才，見授大任，不能輔導陛下。"
            },
            {
              "id": "s0477",
              "zh": "頃月以來，多所造立。"
            },
            {
              "id": "s0478",
              "zh": "親近劉承，悅於美色；"
            },
            {
              "id": "s0479",
              "zh": "發吏民婦女，料其好者，留於宮內，取兵弟十八已下三千餘人，習之苑中，連日續夜，大小呼嗟，敗壞藏中矛戈五千餘枚，以作戲具。"
            },
            {
              "id": "s0480",
              "zh": "朱據先帝舊臣，子男熊、損皆承父之基，以忠議自立，昔殺小主。"
            },
            {
              "id": "s0481",
              "zh": "自是大主所創，帝不復精其本未，便殺熊、損，諫不見用。"
            },
            {
              "id": "s0482",
              "zh": "諸下莫不側息。"
            },
            {
              "id": "s0483",
              "zh": "帝於宮中作小船三百餘艘，成以金銀，師工晝夜不息。"
            },
            {
              "id": "s0484",
              "zh": "太常全尚，累世受恩，不能督諸宗親，而全端等委城就魏。"
            },
            {
              "id": "s0485",
              "zh": "尚位過重，曾無一言以諫陛下，而與敵往來，使傳國消息，懼必傾危社稷。"
            },
            {
              "id": "s0486",
              "zh": "推案舊典，運集大王，輒以今月二十七日擒尚斬承。"
            },
            {
              "id": "s0487",
              "zh": "以帝為會稽王，遣楷牽迎。"
            },
            {
              "id": "s0488",
              "zh": "百寮喁喁。"
            },
            {
              "id": "s0489",
              "zh": "立任道側。"
            }
          ]
        },
        {
          "blockIndex": 38,
          "sentences": [
            {
              "id": "s0573",
              "zh": "綝遣將軍孫耽送亮之國，徙尚於零陵，遷公主於豫章。"
            },
            {
              "id": "s0574",
              "zh": "綝意彌溢，侮慢民神，遂燒大橋頭伍子胥廟，又壞浮屠祠，斬道人。"
            },
            {
              "id": "s0575",
              "zh": "休既即位，稱草莽臣。"
            },
            {
              "id": "s0576",
              "zh": "詣闕上書曰：「臣伏自省，才非干國，因緣肺腑，位極人臣，傷錦敗駕，罪負彰露，尋愆惟闕，夙夜憂懼。"
            },
            {
              "id": "s0577",
              "zh": "臣聞天命棐諶，必就有德，是以幽、厲失度，閡宣中興，陛下聖德，纂承大統，宜得良輔；"
            },
            {
              "id": "s0578",
              "zh": "以協雍熙，雖堯之盛，猶求稷契之佐；"
            },
            {
              "id": "s0579",
              "zh": "以協明聖之德。"
            },
            {
              "id": "s0580",
              "zh": "古人有言：『陳力就列，不能者止。』"
            },
            {
              "id": "s0581",
              "zh": "臣雖自展竭，無益庶政，謹上印綬節鉞，退還田裡，以避賢路。」"
            },
            {
              "id": "s0582",
              "zh": "休引見慰喻。"
            },
            {
              "id": "s0583",
              "zh": "又下詔曰：「朕以不德，守藩於外，值茲際會，群公卿士，暨於朕躬，以奉宗廟。"
            },
            {
              "id": "s0584",
              "zh": "朕用撫然，若涉淵冰。"
            },
            {
              "id": "s0585",
              "zh": "大將軍忠計內發，扶危定傾，安康社稷，功勳赫然。"
            },
            {
              "id": "s0586",
              "zh": "昔漢孝宣踐阼，霍光尊顯，褒德賞功，古今之通義也。"
            },
            {
              "id": "s0587",
              "zh": "其以大將軍為丞相、荊州牧，食五縣。」"
            },
            {
              "id": "s0588",
              "zh": "恩為禦史大夫、衛將軍，據右將軍。"
            },
            {
              "id": "s0589",
              "zh": "皆縣侯。"
            },
            {
              "id": "s0590",
              "zh": "幹雜號將軍、亭侯。"
            },
            {
              "id": "s0591",
              "zh": "闓亦封亭侯。"
            },
            {
              "id": "s0592",
              "zh": "綝一門五侯，皆典禁兵，權傾人主，自吳國朝臣未嘗有也。"
            }
          ]
        },
        {
          "blockIndex": 39,
          "sentences": [
            {
              "id": "s0490",
              "zh": "綝奉牛酒詣休，休不受，齎詣左將軍張布。"
            },
            {
              "id": "s0491",
              "zh": "酒酣，出怨言曰：「徹廢少主時，多勸吾自為之者。"
            },
            {
              "id": "s0492",
              "zh": "吾以陛下賢明，故迎之。"
            },
            {
              "id": "s0493",
              "zh": "帝非我不立，今上禮見拒，是與凡臣無異，當復改圖耳。」"
            },
            {
              "id": "s0494",
              "zh": "布以言聞休，休銜之。"
            },
            {
              "id": "s0495",
              "zh": "鞏其有變，數加賞賜，又復加恩侍中，與綝分省文書。"
            },
            {
              "id": "s0496",
              "zh": "或有告綝懷怨侮上欲圖反者，休執以付綝，綝殺之。"
            },
            {
              "id": "s0497",
              "zh": "由是愈懼，因孟宗求出屯武昌，休許焉，盡敕所督中營精兵萬餘人，皆令裝載，所取武庫兵器，咸令給與。"
            },
            {
              "id": "s0498",
              "zh": "〈《吳曆》曰：綝求中書兩郎，典知荊州諸軍事，主者奏中書不應外出，休特聽之，其所請求，一皆給與。〉"
            },
            {
              "id": "s0499",
              "zh": "將軍魏邈說休曰「綝居外必有變」，武衛士施朔又告「綝欲反有徵」休密問張布，布與丁奉謀於會殺綝。"
            }
          ]
        },
        {
          "blockIndex": 40,
          "sentences": [
            {
              "id": "s0593",
              "zh": "永安元年258年十二月丁卯，建業中謠言明會有變。"
            },
            {
              "id": "s0594",
              "zh": "綝聞之，不悅。"
            },
            {
              "id": "s0595",
              "zh": "夜大風發木揚沙，綝益恐。"
            },
            {
              "id": "s0596",
              "zh": "戊辰臘會，綝稱疾。"
            },
            {
              "id": "s0597",
              "zh": "休強起之，使者十餘輩。"
            },
            {
              "id": "s0598",
              "zh": "綝不得已，將人，眾止焉。"
            },
            {
              "id": "s0599",
              "zh": "綝曰：「國家屢有命，不可辭。"
            },
            {
              "id": "s0600",
              "zh": "可豫整兵，令府內起火，因是可得速還。」"
            },
            {
              "id": "s0601",
              "zh": "遂入，尋而火起，綝求出，休曰：「外兵自多，不足煩丞相也。」"
            },
            {
              "id": "s0602",
              "zh": "綝起離席，奉、布目左右縛之。"
            },
            {
              "id": "s0603",
              "zh": "綝叩首曰：「願徙交州。」"
            },
            {
              "id": "s0604",
              "zh": "休曰：「卿何以不徙滕胤、呂據？」"
            },
            {
              "id": "s0605",
              "zh": "綝復曰：「願沒為官奴。」"
            },
            {
              "id": "s0606",
              "zh": "休曰：「何不以胤、據為奴乎！」"
            },
            {
              "id": "s0607",
              "zh": "遂斬之。"
            },
            {
              "id": "s0608",
              "zh": "以綝首令其眾曰：「諸與綝同謀皆赦。」"
            },
            {
              "id": "s0609",
              "zh": "放仗者五千人。"
            },
            {
              "id": "s0610",
              "zh": "闓乘船欲北降，追殺之。"
            },
            {
              "id": "s0611",
              "zh": "夷三族。"
            },
            {
              "id": "s0612",
              "zh": "發孫峻棺，取其印綬，綝其木而埋之，以殺魯育等故也。"
            }
          ]
        },
        {
          "blockIndex": 41,
          "sentences": [
            {
              "id": "s0500",
              "zh": "綝死時年二十八。"
            },
            {
              "id": "s0501",
              "zh": "休耽與峻、綝同族，特除其屬籍，稱之曰故峻、故綝雲​​。"
            },
            {
              "id": "s0502",
              "zh": "休又下詔曰：「諸葛恪、滕胤、呂據蓋以無罪為峻、綝兄弟所見殘害，可為痛心，促皆改葬，各為祭奠。"
            },
            {
              "id": "s0503",
              "zh": "其罹恪等事見遠徙者，一切召還。」"
            }
          ]
        },
        {
          "blockIndex": 42,
          "sentences": [
            {
              "id": "s0613",
              "zh": "濮陽興字子元，陳留人也。"
            },
            {
              "id": "s0614",
              "zh": "父逸，漢末避亂江東，官至長沙太守。"
            },
            {
              "id": "s0615",
              "zh": "逸事見《陸瑁傳》。"
            },
            {
              "id": "s0616",
              "zh": "興少有士名，孫權時除上虞令，稍遷至尚書左曹，以五官中郎將使蜀，還為會稽太守。"
            },
            {
              "id": "s0617",
              "zh": "時琅邪王休居會稽，興深與相結。"
            },
            {
              "id": "s0618",
              "zh": "及休即位，徵興為太常衛將軍、平軍國事，封外黃侯。"
            },
            {
              "id": "s0619",
              "zh": "永安三年260年，都尉嚴密建丹楊湖田，作浦裡塘。"
            }
          ]
        },
        {
          "blockIndex": 44,
          "sentences": [
            {
              "id": "s0505",
              "zh": "永安三年，都尉嚴密建丹楊湖田，作浦裡塘。"
            },
            {
              "id": "s0506",
              "zh": "詔百官會議，咸以為用功多而田不保成，唯興以為可成。"
            },
            {
              "id": "s0507",
              "zh": "遂會諸兵民就作，功傭之費不可勝數，士卒死亡，或自賊殺，百姓大怨之。"
            },
            {
              "id": "s0508",
              "zh": "興遷為丞相，與休寵臣左將軍張共布相表裡，邦內失望。"
            },
            {
              "id": "s0509",
              "zh": "七年七月，休薨。"
            },
            {
              "id": "s0510",
              "zh": "左典軍萬彧素與烏程侯孫皓善，乃勸興、布，於是興、布廢休適子而迎立皓。"
            },
            {
              "id": "s0511",
              "zh": "皓既踐阼，加興侍中，領青州牧。"
            },
            {
              "id": "s0512",
              "zh": "俄彧譖興、布追悔前事。"
            },
            {
              "id": "s0513",
              "zh": "十一月朔入朝，皓因收興、布，徙廣州，道追殺之，夷三族。"
            }
          ]
        }
      ]
    },
    {
      "chapter": "sanguozhi:065",
      "sourcePath": "data/sanguozhi/065.json",
      "baselineRawSha256": "b38a8225a265183350949296c52d6dc1eda45a0ac9617dcb87b7378e46af07c2",
      "blocks": [
        {
          "blockIndex": 8,
          "sentences": [
            {
              "id": "s0065",
              "zh": "賀邵字興伯，會稽山陰人也，"
            },
            {
              "id": "s0066",
              "zh": "〈吴书曰：邵，贺齐之孙，景之子。〉"
            },
            {
              "id": "s0067",
              "zh": "孫休即位，從中郎為散騎中常侍，出為吳郡太守。"
            },
            {
              "id": "s0068",
              "zh": "孫皓時，入為左典軍，遷中書令，領太子太傅。"
            }
          ]
        },
        {
          "blockIndex": 9,
          "sentences": [
            {
              "id": "s0069",
              "zh": "皓兇暴驕矜，政事日弊。"
            },
            {
              "id": "s0070",
              "zh": "邵上疏諫曰："
            }
          ]
        },
        {
          "blockIndex": 10,
          "sentences": [
            {
              "id": "s0071",
              "zh": "古之聖王，所以潛處重闈之內而知萬里之情，垂拱衽席之上，明照八極之際者，任賢之功也。"
            },
            {
              "id": "s0072",
              "zh": "陛下以至德淑姿，統承皇業，宜率身履道，恭奉神器，旌賢表善，以康庶政。"
            },
            {
              "id": "s0073",
              "zh": "自頃年以來，朝列紛錯，真偽相貿，上下空任，文武曠位，外無山嶽之鎮，內無拾遺之臣。"
            },
            {
              "id": "s0074",
              "zh": "佞諛之徒拊冀天飛，干弄朝威，盜竊榮利，而忠良排墜，信臣被害。"
            },
            {
              "id": "s0075",
              "zh": "是以正士摧方，而庸臣苟媚，先意承旨，各希時趣。"
            },
            {
              "id": "s0076",
              "zh": "人執反理之評，士吐詭道之論，遂使清流變濁，忠臣結舌。"
            },
            {
              "id": "s0077",
              "zh": "陛下處九天之上，隱百重之室，言出風靡，令行景從，親洽寵媚之臣，日聞順意之辭，將謂此輩實賢，而天下已平也。"
            },
            {
              "id": "s0078",
              "zh": "臣心所不安，敢不以聞。"
            }
          ]
        },
        {
          "blockIndex": 11,
          "sentences": [
            {
              "id": "s0079",
              "zh": "臣聞興國之君樂聞其過，荒亂之主樂聞其譽。"
            },
            {
              "id": "s0080",
              "zh": "聞其過者過日消而福臻，聞其譽者譽日損而禍至。"
            },
            {
              "id": "s0081",
              "zh": "是以古之人君，捐讓以進賢，虛己以求過，譬天位於乘□，以虎尾為警戒。"
            },
            {
              "id": "s0082",
              "zh": "至於陛下，嚴刑法以禁直辭，黜善士以逆諫臣，眩耀毀譽之實，沉淪近習之言。"
            },
            {
              "id": "s0083",
              "zh": "昔高宗思佐，夢寐得賢，而陛下求之如忘，忽之如遺。"
            },
            {
              "id": "s0084",
              "zh": "故常侍王蕃忠恪在公，才任輔弼，以醉酒之間加之大戮。"
            },
            {
              "id": "s0085",
              "zh": "近鴻臚葛奚，先帝舊臣，偶有逆迕，昏醉之言耳，三爵之後，禮所不諱，陛下猥發雷霆，謂之輕慢，飲之醇酒，中毒隕命。"
            },
            {
              "id": "s0086",
              "zh": "自是之後，海內悼心，朝臣失圖，仕者以退為幸，居者以出為福，誠非所以保光洪緒，臣隆道化也。"
            }
          ]
        }
      ]
    },
    {
      "chapter": "sanguozhi:051",
      "sourcePath": "data/sanguozhi/051.json",
      "baselineRawSha256": "a3f7c52a1cfe41a7f69bafe5d7311ad762ae67411ec6040a2f4c1fdae40ac120",
      "blocks": [
        {
          "blockIndex": 14,
          "sentences": [
            {
              "id": "s0236",
              "zh": "孫匡字季佐，翊弟也。"
            },
            {
              "id": "s0237",
              "zh": "舉孝廉茂才，未試用，卒。"
            },
            {
              "id": "s0238",
              "zh": "時年二十餘。"
            },
            {
              "id": "s0239",
              "zh": "〈江表传曰：曹休出洞口，吕范率军御之。"
            },
            {
              "id": "s0240",
              "zh": "时匡为定武中郎将，"
            },
            {
              "id": "s0241",
              "zh": "（遣）"
            },
            {
              "id": "s0242",
              "zh": "范令放火，烧损茅芒，以乏军用，范即启送匡还吴。"
            },
            {
              "id": "s0243",
              "zh": "权别其族为丁氏，禁固终身。"
            },
            {
              "id": "s0244",
              "zh": "臣松之案本传曰：“匡未试用卒，时年二十餘。”"
            },
            {
              "id": "s0245",
              "zh": "而江表传云吕范在洞口，匡为定武中郎将。"
            },
            {
              "id": "s0246",
              "zh": "既为定武，非为未试用。"
            },
            {
              "id": "s0247",
              "zh": "且孙坚以初平二年卒，洞口之役在黄初三年，坚卒至此合三十一年，匡时若尚在，本传不得云卒时年二十餘也。"
            },
            {
              "id": "s0248",
              "zh": "此盖权别生弟朗，江表传误以为匡也。"
            },
            {
              "id": "s0249",
              "zh": "朗之名位见三朝录及虞喜志林也。〉"
            }
          ]
        },
        {
          "blockIndex": 15,
          "sentences": [
            {
              "id": "s0250",
              "zh": "子泰，曹氏之甥也，為長水校尉。"
            },
            {
              "id": "s0251",
              "zh": "嘉禾三年，從權圍新城，中流矢死。"
            },
            {
              "id": "s0252",
              "zh": "泰子秀為前將軍、夏口督。"
            },
            {
              "id": "s0253",
              "zh": "秀公室至親，握兵在外，皓意不能平。"
            },
            {
              "id": "s0254",
              "zh": "建衡二年，皓遣何定將五千人至夏口獵。"
            },
            {
              "id": "s0255",
              "zh": "先是，民間歛言秀當見圖，而定遠獵，秀遂驚，夜將妻子親兵數百人奔晉。"
            },
            {
              "id": "s0256",
              "zh": "晉以秀為驃騎將軍、儀同三司，封會稽公。"
            },
            {
              "id": "s0257",
              "zh": "〈江表传曰：皓大怒，追改秀姓曰厉。"
            },
            {
              "id": "s0258",
              "zh": "干宝《晋纪》曰：秀在晋朝，初闻皓降，群臣毕贺，秀称疾不与，南向流涕曰：“昔讨逆弱冠以一校尉创业，今后主举江南而弃之，宗庙山陵，於此为墟。"
            },
            {
              "id": "s0259",
              "zh": "悠悠苍天，此何人哉！”"
            },
            {
              "id": "s0260",
              "zh": "朝廷美之。"
            },
            {
              "id": "s0261",
              "zh": "晋诸公赞曰：吴平，降为伏波将军，开府如故。"
            },
            {
              "id": "s0262",
              "zh": "永宁中卒，追赠骠骑、开府。"
            },
            {
              "id": "s0263",
              "zh": "子俭，字仲节，给事中。〉"
            }
          ]
        },
        {
          "blockIndex": 18,
          "sentences": [
            {
              "id": "s0295",
              "zh": "及翊遇害，河馳赴宛陵，責怒覽、員，以不能全權，令使奸變得施。"
            },
            {
              "id": "s0296",
              "zh": "二人議曰：\"伯海與將軍疏遠，而責我乃耳。"
            },
            {
              "id": "s0297",
              "zh": "討虜若來，吾屬無遺矣。"
            },
            {
              "id": "s0298",
              "zh": "\"遂殺河，使人北迎揚州刺史劉馥，令住歷陽，以丹陽應之。"
            },
            {
              "id": "s0299",
              "zh": "會翊帳下徐元、孫高、傅嬰等殺覽、員。"
            },
            {
              "id": "s0300",
              "zh": "〈吴历曰：妫览、戴员亲近边洪等，数为翊所困，常欲叛逆，因吴主出征，遂其奸计。"
            },
            {
              "id": "s0301",
              "zh": "时诸县令长并会见翊，翊以妻徐氏颇晓卜，翊入语徐：“吾明日欲为长吏作主人，卿试卜之。”"
            },
            {
              "id": "s0302",
              "zh": "徐言：“卦不能佳，可须异日。”"
            },
            {
              "id": "s0303",
              "zh": "翊以长吏来久，宜速遣，乃大请宾客。"
            },
            {
              "id": "s0304",
              "zh": "翊出入常持刀，尔时有酒色，空手送客，洪从后斫翊，郡中扰乱，无救翊者，遂为洪所杀，迸走入山。"
            },
            {
              "id": "s0305",
              "zh": "徐氏购募追捕，中宿乃得，览、员归罪杀洪。"
            },
            {
              "id": "s0306",
              "zh": "诸将皆知览、员所为，而力不能讨。"
            },
            {
              "id": "s0307",
              "zh": "览入居军府中，悉取翊嫔妾及左右侍御，欲复取徐。"
            },
            {
              "id": "s0308",
              "zh": "恐逆之见害，乃绐之曰：“乞须晦日设祭除服。”"
            },
            {
              "id": "s0309",
              "zh": "时月垂竟，览听须祭毕。"
            },
            {
              "id": "s0310",
              "zh": "徐潜使所亲信语翊亲近旧将孙高、傅婴等，说：“览已虏略婢妾，今又欲见偪，所以外许之者，欲安其意以免祸耳。"
            },
            {
              "id": "s0311",
              "zh": "欲立微计，原二君哀救。”"
            },
            {
              "id": "s0312",
              "zh": "高、婴涕泣答言：“受府君恩遇，所以不即死难者，以死无益，欲思惟事计，事计未立，未敢启夫人耳。"
            },
            {
              "id": "s0313",
              "zh": "今日之事，实夙夜所怀也。”"
            },
            {
              "id": "s0314",
              "zh": "乃密呼翊时侍养者二十餘人，以徐意语之，共盟誓，合谋。"
            },
            {
              "id": "s0315",
              "zh": "到晦日，设祭，徐氏哭泣尽哀毕，乃除服，薰香沐浴，更於他室，安施帏帐，言笑欢悦，示无戚容。"
            },
            {
              "id": "s0316",
              "zh": "大小凄怆，怪其如此。"
            },
            {
              "id": "s0317",
              "zh": "览密觇视，无复疑意。"
            },
            {
              "id": "s0318",
              "zh": "徐呼高、婴与诸婢罗住户内，使人报览，说已除凶即吉，惟府君敕命。"
            },
            {
              "id": "s0319",
              "zh": "览盛意入，徐出户拜。"
            },
            {
              "id": "s0320",
              "zh": "览適得一拜，徐便大呼：“二君可起！”"
            },
            {
              "id": "s0321",
              "zh": "高、婴俱出，共得杀览，餘人即就外杀员。"
            },
            {
              "id": "s0322",
              "zh": "夫人乃还缞绖，奉览、员首以祭翊墓。"
            },
            {
              "id": "s0323",
              "zh": "举军震骇，以为神异。"
            },
            {
              "id": "s0324",
              "zh": "吴主续至，悉族诛览、员餘党，擢高、婴为牙门，其餘皆加赐金帛，殊其门户。〉"
            }
          ]
        },
        {
          "blockIndex": 19,
          "sentences": [
            {
              "id": "s0325",
              "zh": "韶年十七，收河餘眾，繕治京城。"
            },
            {
              "id": "s0326",
              "zh": "起樓櫓，修器備議禦敵。"
            },
            {
              "id": "s0327",
              "zh": "權聞亂，從椒丘還，過定丹楊，引軍歸吳。"
            },
            {
              "id": "s0328",
              "zh": "夜至京城下營，試攻驚之，兵皆乘城傳檄備警，歡聲動地，頗射外人，權使曉喻乃止。"
            },
            {
              "id": "s0329",
              "zh": "明日見韶，甚器之。"
            },
            {
              "id": "s0330",
              "zh": "即拜承烈校尉，統河部曲，食曲阿、丹徒二縣，自置長吏，一如河舊。"
            },
            {
              "id": "s0331",
              "zh": "後為廣陵太守、偏將軍。"
            },
            {
              "id": "s0332",
              "zh": "權為吳王，遷揚威將軍，封建德侯。"
            },
            {
              "id": "s0333",
              "zh": "權稱尊號，為鎮北將軍。"
            },
            {
              "id": "s0334",
              "zh": "韶為邊將數十年，善養士卒，得其死力。"
            },
            {
              "id": "s0335",
              "zh": "常以警疆場遠斥候為務，先知動靜而為之備，故鮮有負敗。"
            },
            {
              "id": "s0336",
              "zh": "青、徐、汝、沛頗來歸附，淮南濱江屯候皆徹兵遠徙，徐、泗、江、淮之地，不居者各數百里。"
            },
            {
              "id": "s0337",
              "zh": "自權西征，還都武昌，韶不進見者十餘年。"
            },
            {
              "id": "s0338",
              "zh": "權還建業，乃得朝覲。"
            },
            {
              "id": "s0339",
              "zh": "權問青、徐諸屯要害，遠近人馬眾寡，魏將帥姓名，盡具識之，有問鹹對。"
            },
            {
              "id": "s0340",
              "zh": "身長八尺，儀貌都雅。"
            },
            {
              "id": "s0341",
              "zh": "權歡悅曰：\"吾久不見公禮，不圖進益乃爾。"
            },
            {
              "id": "s0342",
              "zh": "\"加領幽州牧、假節。"
            },
            {
              "id": "s0343",
              "zh": "赤烏四年卒。"
            },
            {
              "id": "s0344",
              "zh": "子越嗣，至右將軍，越兄楷武衛大將軍、臨成侯，代越為京下督。"
            },
            {
              "id": "s0345",
              "zh": "楷弟異至領軍將軍，奕宗正卿，恢武陵太守。"
            },
            {
              "id": "s0346",
              "zh": "天璽元年，征楷為宮下鎮驃騎將軍。"
            },
            {
              "id": "s0347",
              "zh": "初永安賊施但等劫皓弟謙，襲建業，或白楷二端不即赴討者，皓數遣詰楷。"
            },
            {
              "id": "s0348",
              "zh": "楷常惶怖，而卒被召，遂將妻子親兵數百人歸晉，晉以為車騎將軍，封丹楊侯。"
            },
            {
              "id": "s0349",
              "zh": "〈晋诸公赞曰：吴平，降为渡辽将军，永安元年卒。"
            },
            {
              "id": "s0350",
              "zh": "吴录曰：楷处事严整不如孙秀，而人间知名，过也。〉"
            }
          ]
        }
      ]
    },
    {
      "chapter": "songshu:032",
      "sourcePath": "data/songshu/032.json",
      "baselineRawSha256": "10760dc99644bddbc36af37361cbb696f4fb2b9302d4b76bb4b0c57ac0ca2ed4",
      "blocks": [
        {
          "blockIndex": 11,
          "sentences": [
            {
              "id": "s0060",
              "zh": "十年四月癸丑，崇賢殿災。"
            },
            {
              "id": "s0061",
              "zh": "十月庚辰，含章鞠室、脩成堂前廡、丙坊東屋、煇章殿南閣火。"
            },
            {
              "id": "s0062",
              "zh": "時有上書者曰：「漢王氏五侯兄弟迭任，今楊氏三公並在大位。"
            },
            {
              "id": "s0063",
              "zh": "天變屢見，竊為陛下憂之。」"
            },
            {
              "id": "s0064",
              "zh": "楊珧由是乞退。"
            },
            {
              "id": "s0065",
              "zh": "是時帝納馮紞之間，廢張華之功；"
            },
            {
              "id": "s0066",
              "zh": "聽楊駿之讒，離衞瓘之寵。"
            },
            {
              "id": "s0067",
              "zh": "此逐功臣之罰也。"
            },
            {
              "id": "s0068",
              "zh": "明年，宮車晏駕。"
            },
            {
              "id": "s0069",
              "zh": "其後楚王承竊發之旨，戮害二公，身亦不免。"
            },
            {
              "id": "s0070",
              "zh": "震災其坊，又天意乎。"
            }
          ]
        },
        {
          "blockIndex": 12,
          "sentences": [
            {
              "id": "s0071",
              "zh": "晉惠帝元康五年閏月庚寅，武庫火。"
            },
            {
              "id": "s0072",
              "zh": "張華疑有亂，先固守，然後救災。"
            },
            {
              "id": "s0073",
              "zh": "是以累代異寶，王莽頭，孔子履，漢高斷白蛇劍及二百萬人器械，一時蕩盡。"
            },
            {
              "id": "s0074",
              "zh": "是後愍懷見殺，殺太子之罰也。"
            },
            {
              "id": "s0075",
              "zh": "天戒若曰，夫設險擊柝，所以固其國，儲積戎器，所以戒不虞。"
            },
            {
              "id": "s0076",
              "zh": "今冢嗣將傾，社稷將泯，禁兵無所復施，皇旅又將誰衞。"
            },
            {
              "id": "s0077",
              "zh": "帝后不悟，終喪四海，是其應也。"
            },
            {
              "id": "s0078",
              "zh": "張華、閻纂皆曰，武庫火而氐、羌反，太子見廢，則四海可知矣。"
            }
          ]
        },
        {
          "blockIndex": 13,
          "sentences": [
            {
              "id": "s0079",
              "zh": "元康八年十一月，高原陵火。"
            },
            {
              "id": "s0080",
              "zh": "是時賈后凶恣，賈謐擅朝，惡積罪稔，宜見誅絕。"
            },
            {
              "id": "s0081",
              "zh": "天戒若曰，臣妾之不可者，雖親貴莫比，猶宜忍而誅之，如吾燔高原陵也。"
            },
            {
              "id": "s0082",
              "zh": "帝既眊弱，而張華又不納裴頠、劉卞之謀，故后遂與謐誣殺太子也。"
            },
            {
              "id": "s0083",
              "zh": "干寶云：「高原陵火，太子廢，其應也。"
            },
            {
              "id": "s0084",
              "zh": "漢武帝世，高園便殿火，董仲舒對與此占同。」"
            }
          ]
        },
        {
          "blockIndex": 48,
          "sentences": [
            {
              "id": "s0189",
              "zh": "元康九年六月庚子，有桑生東宮西廂，日長尺餘；"
            },
            {
              "id": "s0190",
              "zh": "甲辰，枯死。"
            },
            {
              "id": "s0191",
              "zh": "此與殷太戊同妖。"
            },
            {
              "id": "s0192",
              "zh": "太子不能悟，故至廢戮也。"
            },
            {
              "id": "s0193",
              "zh": "班固稱「野木生朝而暴長，小人將暴居大臣之位，危亡國家，象朝將為墟也」。"
            },
            {
              "id": "s0194",
              "zh": "是後孫秀、張林尋用事，遂至大亂。"
            }
          ]
        },
        {
          "blockIndex": 50,
          "sentences": [
            {
              "id": "s0200",
              "zh": "永康元年四月，壯武國有桑化為柏。"
            },
            {
              "id": "s0201",
              "zh": "是月，張華遇害。"
            }
          ]
        }
      ]
    },
    {
      "chapter": "nanqishu:011",
      "sourcePath": "data/nanqishu/011.json",
      "baselineRawSha256": "3a028b5d37dddf8873fae6ce0cef47dbc6d684fbf89b4327298ebe074c8c4ae7",
      "blocks": [
        {
          "blockIndex": 98,
          "sentences": [
            {
              "id": "s0396",
              "zh": "宋世王韶之造七廟登歌七篇。"
            },
            {
              "id": "s0397",
              "zh": "昇明中，太祖爲齊王，令司空褚淵造太廟登歌二章。"
            },
            {
              "id": "s0398",
              "zh": "建元初，詔黃門侍郎謝超宗造廟樂歌詩十六章，"
            }
          ]
        },
        {
          "blockIndex": 99,
          "sentences": [
            {
              "id": "s0399",
              "zh": "永明二年，尚書殿中曹奏：「太祖高皇帝廟神室奏《高德宣烈之舞》，未有歌詩，郊應須歌辭。"
            },
            {
              "id": "s0400",
              "zh": "穆皇后廟神室，亦未有歌辭。"
            },
            {
              "id": "s0401",
              "zh": "案傅玄云：『登歌廟異其文，饗神七室同辭。』"
            },
            {
              "id": "s0402",
              "zh": "此議爲允。"
            },
            {
              "id": "s0403",
              "zh": "又尋漢世歌篇，多少無定，皆稱事立文，竝多八句，然後轉韻。"
            },
            {
              "id": "s0404",
              "zh": "時有兩三韻而轉，其例甚寡。"
            },
            {
              "id": "s0405",
              "zh": "張華、夏侯湛亦同前式。"
            },
            {
              "id": "s0406",
              "zh": "傅玄改韻頗數，更傷簡節之美。"
            },
            {
              "id": "s0407",
              "zh": "近世王韶之、顏延之並四韻乃轉，得賒促之中。"
            },
            {
              "id": "s0408",
              "zh": "顏延之、謝莊作三廟歌，皆各三章章八句，此于序述功業詳略爲宜，今宜依之。"
            },
            {
              "id": "s0409",
              "zh": "郊配之日，改降尊作主，禮殊宗廟；"
            },
            {
              "id": "s0410",
              "zh": "穆后母儀之化，事異經綸。"
            },
            {
              "id": "s0411",
              "zh": "此二歌爲一章八句，別奏事御奉行。」"
            },
            {
              "id": "s0412",
              "zh": "詔「可」。"
            },
            {
              "id": "s0413",
              "zh": "尚書令王儉造太廟二室及郊配辭。"
            }
          ]
        },
        {
          "blockIndex": 146,
          "sentences": [
            {
              "id": "s0571",
              "zh": ":瓊斝旣飾，繡簋以陳。"
            },
            {
              "id": "s0572",
              "zh": "方燮嘉種，永毓宵民。"
            }
          ]
        },
        {
          "blockIndex": 147,
          "sentences": [
            {
              "id": "s0575",
              "zh": "元會大饗四廂樂歌辭，晉泰始五年太僕傅玄撰。"
            },
            {
              "id": "s0576",
              "zh": "正旦大會行禮歌詩四章，壽酒詩一章，食舉東西廂樂十三章，黃門郎張華作。"
            },
            {
              "id": "s0577",
              "zh": "上壽食舉行禮詩十八章，中書監荀勗、侍郎成公綏，言數各異。"
            },
            {
              "id": "s0578",
              "zh": "宋黃門郎王韶之造《肆夏》四章，行禮一章，上壽一章，登歌三章，食舉十章，《前後舞歌》一章。"
            },
            {
              "id": "s0579",
              "zh": "齊微改革，多仍舊辭。"
            },
            {
              "id": "s0580",
              "zh": "其《前後舞》二章新改。"
            },
            {
              "id": "s0581",
              "zh": "其臨軒樂，亦奏《肆夏·於鑠》四章。"
            }
          ]
        },
        {
          "blockIndex": 189,
          "sentences": [
            {
              "id": "s0753",
              "zh": "《凱容舞》，執羽籥。"
            },
            {
              "id": "s0754",
              "zh": "郊廟，冠委貌，服如前。"
            },
            {
              "id": "s0755",
              "zh": "朝廷，進賢冠，黑介幘，生黃袍單衣，白合幅袴，餘如前。"
            },
            {
              "id": "s0756",
              "zh": "本舜《韶舞》，漢高改曰《文始》，魏復曰《大韶》。"
            },
            {
              "id": "s0757",
              "zh": "又造《咸熙》爲《文舞》。"
            },
            {
              "id": "s0758",
              "zh": "晉傅玄六代舞有《虞韶舞》辭。"
            },
            {
              "id": "s0759",
              "zh": "宋以《凱容》繼《韶》爲《文舞》。"
            },
            {
              "id": "s0760",
              "zh": "相承用魏咸熙冠服。"
            }
          ]
        },
        {
          "blockIndex": 190,
          "sentences": [
            {
              "id": "s0761",
              "zh": "《前舞》、《後舞》，晉泰始九年造。"
            },
            {
              "id": "s0762",
              "zh": "《正德大豫舞》，傅玄、張華各爲歌辭。"
            },
            {
              "id": "s0763",
              "zh": "宋元嘉中，改《正德》爲《前舞》，《大豫》爲《後舞》。"
            }
          ]
        }
      ]
    },
    {
      "chapter": "jinshu:020",
      "sourcePath": "data/jinshu/020.json",
      "baselineRawSha256": "ea4c955dcfebe4b9ec6f7ff187319a9f589b9497cb12c158344b469e44d9c0a2",
      "blocks": [
        {
          "blockIndex": 45,
          "sentences": [
            {
              "id": "s0563",
              "zh": "時吳國朱某娶妻陳氏，生子東伯。"
            },
            {
              "id": "s0564",
              "zh": "入晉，晉賜妻某氏，生子綏伯。"
            },
            {
              "id": "s0565",
              "zh": "太康之中，某已亡，綏伯將母以歸邦族，兄弟交愛敬之道，二母篤先後之序，雍雍人無間焉。"
            },
            {
              "id": "s0566",
              "zh": "及其終也，二子交相為服，君子以為賢。"
            }
          ]
        },
        {
          "blockIndex": 46,
          "sentences": [
            {
              "id": "s0567",
              "zh": "安豐太守程諒先已有妻，後又娶，遂立二嫡。"
            },
            {
              "id": "s0568",
              "zh": "前妻亡，後妻子勳疑所服。"
            },
            {
              "id": "s0569",
              "zh": "中書令張華造甲乙之問曰：「甲娶乙為妻，後又娶丙，匿不說有乙，居家如二嫡，無有貴賤之差。"
            },
            {
              "id": "s0570",
              "zh": "乙亡，丙之子當何服？"
            },
            {
              "id": "s0571",
              "zh": "本實並列，嫡庶不殊，雖二嫡非正，此失在先人，人子何得專制析其親也。"
            },
            {
              "id": "s0572",
              "zh": "若為庶母服，又不成為庶。"
            },
            {
              "id": "s0573",
              "zh": "進退不知所從。」"
            },
            {
              "id": "s0574",
              "zh": "太傅鄭沖議曰：「甲失禮於家，二嫡並在，誠非人子所得正。"
            },
            {
              "id": "s0575",
              "zh": "則乙丙之子並當三年，禮疑從重。」"
            },
            {
              "id": "s0576",
              "zh": "車騎賈充、侍中少傅任愷議略與鄭同。"
            },
            {
              "id": "s0577",
              "zh": "太尉荀顗議曰：「《春秋》並后匹嫡，古之明典也。"
            },
            {
              "id": "s0578",
              "zh": "今不可以犯禮並立二妻，不別尊卑而遂其失也。"
            },
            {
              "id": "s0579",
              "zh": "故當斷之以禮，先至為嫡，後至為庶。"
            },
            {
              "id": "s0580",
              "zh": "丙子宜以嫡母服乙，乙子宜以庶母事丙。"
            },
            {
              "id": "s0581",
              "zh": "昔屈建去芰，古人以為違禮而得禮。"
            },
            {
              "id": "s0582",
              "zh": "丙子非為抑其親，斯自奉禮先後貴賤順敘之義也。」"
            },
            {
              "id": "s0583",
              "zh": "中書監荀勖議曰：「昔鄉里鄭子群娶陳司空從妹，後隔呂布之亂，不復相知存亡，更娶鄉里蔡氏女。"
            },
            {
              "id": "s0584",
              "zh": "徐州平定，陳氏得還，遂二妃並存。"
            },
            {
              "id": "s0585",
              "zh": "蔡氏之子字元釁，為陳氏服嫡母之服，事陳公以從舅之禮。"
            },
            {
              "id": "s0586",
              "zh": "族兄宗伯曾責元釁，謂抑其親，鄉里先達以元釁為合宜。"
            },
            {
              "id": "s0587",
              "zh": "不審此事粗相似否。」，"
            }
          ]
        }
      ]
    },
    {
      "chapter": "weishu:066",
      "sourcePath": "data/weishu/066.json",
      "baselineRawSha256": "fa15c9dc3faf154393d720b6e8df5aba3e9fa6e271a1740ec78568605e7d8170",
      "blocks": [
        {
          "blockIndex": 70,
          "sentences": [
            {
              "id": "s0391",
              "zh": "張讜，字處言，清河東武城人也。"
            },
            {
              "id": "s0392",
              "zh": "六世祖名犯顯祖諱，晉長秋卿。"
            },
            {
              "id": "s0393",
              "zh": "父華，為慕容超左僕射。"
            },
            {
              "id": "s0394",
              "zh": "讜仕劉駿，歷給事中、泰山太守、青冀二州輔國府長史，帶魏郡太守。"
            },
            {
              "id": "s0395",
              "zh": "劉彧之立，遙授冠軍將軍、東徐州刺史。"
            }
          ]
        }
      ]
    },
    {
      "chapter": "jinshi:122",
      "sourcePath": "data/jinshi/122.json",
      "baselineRawSha256": "4c2b8de2976cd7ef3e2d3048e1f992d60130daaffa3d1f380dc946d571cd8abf",
      "blocks": [
        {
          "blockIndex": 29,
          "sentences": [
            {
              "id": "s0179",
              "zh": "賈邦獻"
            }
          ]
        },
        {
          "blockIndex": 30,
          "sentences": [
            {
              "id": "s0180",
              "zh": "賈邦獻，霍州霍邑縣陳村人也。"
            },
            {
              "id": "s0181",
              "zh": "舉進士第。"
            },
            {
              "id": "s0182",
              "zh": "質直有勇略。"
            },
            {
              "id": "s0183",
              "zh": "大元攻河東，邦獻集居民為守禦計。"
            },
            {
              "id": "s0184",
              "zh": "既而，兵大至，居民悉降。"
            },
            {
              "id": "s0185",
              "zh": "邦獻棄其家，獨與子懿保于松平寨。"
            },
            {
              "id": "s0186",
              "zh": "是時，權知州事劉珍在寨，與之共守，竟能成功。"
            },
            {
              "id": "s0187",
              "zh": "珍每欲辟之，邦獻輒以衰老為辭。"
            },
            {
              "id": "s0188",
              "zh": "興定四年十月，兵複大至，病不能避，與懿俱被執。"
            },
            {
              "id": "s0189",
              "zh": "欲以為鎮西元帥，且持刃脅之，邦獻不屈，密遣懿歸松平，遂自剄。"
            },
            {
              "id": "s0190",
              "zh": "贈奉直大夫、本縣令。"
            }
          ]
        }
      ]
    }
  ]
}
