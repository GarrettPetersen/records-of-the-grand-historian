},{"id":"s0321","zh":"胤因殺之，並殺允子秦王郁、漢王迪，坐允夷滅者數千人。","blockIndex":50},{"id":"s0325","zh":"及淮南王允敗，秀因稱石崇、潘岳、歐陽建奉允為亂，收之。","blockIndex":50},{"id":"s0332","zh":"相國倫收淮南王母弟吳王晏，欲殺之。","blockIndex":50}],"mentionCount":29}],"priorConstraintDocuments":[],"hostContext":{"file":"host-context.json","registryFile":"../selected-registry.json","registrySha256":"b6c78223d4801d1f6908bf3d892b9774d441bd61479d11673bc2f75b2c3dbc1f","omittedOwnedField":"mentions: full bilingual offset arrays, retained exactly in selected registry; mentionCount supplied here"}}
