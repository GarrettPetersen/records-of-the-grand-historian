dex":46},{"id":"s0311","zh":"署從事中郎，出為長樂太守。","blockIndex":46},{"id":"s0312","zh":"及勒僭號，未遑制度，與王波為之撰朝儀，於是憲章文物，擬于王者。","blockIndex":46},{"id":"s0313","zh":"勒大悅，署太中大夫，遷司徒。","blockIndex":46},{"id":"s0314","zh":"及季龍之世，彌加禮重。","blockIndex":47},{"id":"s0315","zh":"憲有二子：挹、㲄，並以文才知名。","blockIndex":47},{"id":"s0320","zh":"季龍悉誅挹、㲄，憲亦坐免。","blockIndex":47},{"id":"s0321","zh":"未幾，復以為右光祿大夫、司徒、太傅，封安定郡公。","blockIndex":47},{"id":"s0322","zh":"憲曆官無干績之稱，然在朝玄默，未嘗以物務經懷。","blockIndex":48},{"id":"s0323","zh":"但以德重名高，動見尊禮。","blockIndex":48},{"id":"s0324","zh":"竟卒于石氏，以族人峙子邁為嗣。","blockIndex":48}],"mentionCount":21},{"localId":"jinshu:053:p022","currentCanonicalPersonId":"per_9NZYPWAY8FFN16SP97C8","canonicalMappingScope":"matches saved exact global graph","record":{"localId":"jinshu:053:p022","preferredNameSuggestion":{"en":"Pei Xian","zh":"裴憲","pinyin":"Pei Xian"},"historicity":"historical","descriptorSuggestion":"Son of Pei Kai; companion to crown prince","identityHints":{"nativePlaces":[],"relatedLocalPeople":["jinshu:053:p001","jinshu:053:p014"],"activeDateHints":["AD 291"],"polityHints":["Western Jin","晉"]}},"aliasesAndNameKeys":[{"key":"en:pei xian","language":"en","value":"Pei Xian","kinds":["personal-name","preferred"],"sources":["jinshu:053:c0084","preferred"],"blocking":true},{"key":"zh:裴憲","language":"zh","value":"裴憲","kinds":["preferred"],"sources":["preferred"],"blocking":true},{"key":"zh:憲","language":"zh","value":"憲","kinds":["given","personal-name"],"sources":["jinshu:053:c0084","jinshu:053:c0085"],"blocking":false},{"key":"en:xian","language":"en","value":"Xian","kinds":["given"],"sources":["jinshu:053:c0085"],"blocking":false}],"claims":[{"id":"jinshu:053:c0084","subject":"jinshu:053:p022","predicate":"name","value":{"kind":"personal-name","en":"Pei Xian","zh":"憲","pinyin":"Xian"},"certainty":"explicit","evidence":["jinshu:053:s0205"]},{"id":"jinshu:053:c0085","subject":"jinshu:053:p022","predicate":"name","value":{"kind":"given","en":"Xian","zh":"憲","pinyin":"Xian"},"certainty":"