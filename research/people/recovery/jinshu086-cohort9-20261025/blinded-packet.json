  "units": [
    {
      "id": "s0255",
      "zh": "寔弟茂",
      "blockIndex": 22
    },
    {
      "id": "s0256",
      "zh": "=茂字成遜，虛靖好學，不以世利嬰心。",
      "blockIndex": 23
    },
    {
      "id": "s0257",
      "zh": "建興初，南陽王保辟從事中郎，又薦為散騎侍郎、中壘將軍，皆不就。",
      "blockIndex": 23
    },
    {
      "id": "s0258",
      "zh": "二年，徵為侍中，以父老固辭。",
      "blockIndex": 23
    },
    {
      "id": "s0259",
      "zh": "尋拜平西將軍、秦州刺史。",
      "blockIndex": 23
    },
    {
      "id": "s0260",
      "zh": "太興三年，寔既遇害，州人推茂為大都督、太尉、涼州牧，茂不從，但受使持節、平西將軍、涼州牧。",
      "blockIndex": 23
    },
    {
      "id": "s0287",
      "zh": "未幾，茂復大城姑臧，修靈鈞台，別駕吳紹諫曰：「伏惟修城築台，蓋是懲既往之事。",
      "blockIndex": 26
    },
    {
      "id": "s0288",
      "zh": "愚以為恩德未洽於近侍，雖處層樓，適所以疑諸下，徒見不安之意而失士民系托之本心，示怯弱之形，乖匡霸之勢。",
      "blockIndex": 26
    },
    {
      "id": "s0289",
      "zh": "遐方異境窺我之齷齱也，必有乘人之規。",
      "blockIndex": 26
    },
    {
      "id": "s0290",
      "zh": "嘗願止役省勞，與下休息。",
      "blockIndex": 26
    },
    {
      "id": "s0291",
      "zh": "而更興功動眾，百姓豈所望於明君哉！」",
      "blockIndex": 26
    },
    {
      "id": "s0292",
      "zh": "茂曰：「亡兄怛然失身於物。",
      "blockIndex": 26
    },
    {
      "id": "s0293",
      "zh": "王公設險，武夫重閉，亦達人之至戒也。",
      "blockIndex": 26
    },
    {
      "id": "s0294",
      "zh": "且忠臣義士豈不欲盡節義于亡兄哉？",
      "blockIndex": 26
    },
    {
      "id": "s0295",
      "zh": "直以危機密發，雖有賁育之勇，無所復施。",
      "blockIndex": 26
    },
    {
      "id": "s0296",
      "zh": "今事未靖，不可以拘系常言，以太平之理責人於迍邅之世。」",
      "blockIndex": 26
    },
    {
      "id": "s0297",
      "zh": "紹無以對。",
      "blockIndex": 26
    },
    {
      "id": "s0298",
      "zh": "茂雅有志節，能斷大事。",
      "blockIndex": 27
    },
    {
      "id": "s0299",
      "zh": "涼州大姓賈摹，寔之妻弟也，勢傾西土。",
      "blockIndex": 27
    },
    {
      "id": "s0300",
      "zh": "先是，謠曰：「手莫頭，圖涼州。」",
      "blockIndex": 27
    },
    {
      "id": "s0301",
      "zh": "茂以為信，誘而殺之，於是豪右屏跡，威行涼域。",
      "blockIndex": 27
    },
    {
      "id": "s0302",
      "zh": "永昌初，茂使將軍韓璞率眾取隴西南安之地，以置秦州。",
      "blockIndex": 27
    },
    {
      "id": "s0303",
      "zh": "太寧三年卒，臨終，執駿手泣曰：「昔吾先人以孝友見稱。",
      "blockIndex": 28
    },
    {
      "id": "s0304",
      "zh": "自漢初以來，世執忠順。",
      "blockIndex": 28
    },
    {
      "id": "s0305",
      "zh": "今雖華夏大亂，皇輿播遷，汝當謹守人臣之節，無或失墜。",
      "blockIndex": 28
    },
    {
      "id": "s0306",
      "zh": "吾遭擾攘之運，承先人餘德，假攝此州，以全性命，上欲不負晉室，下欲保完百姓。",
      "blockIndex": 28
    },
    {
      "id": "s0307",
      "zh": "然官非王命，位由私議，苟以集事，豈榮之哉！",
      "blockIndex": 28
    },
    {
      "id": "s0308",
      "zh": "氣絕之日，白帢入棺，無以朝服，以彰吾志焉。」",
      "blockIndex": 28
    },
    {
      "id": "s0309",
      "zh": "年四十八。",
      "blockIndex": 28
    },
    {
      "id": "s0310",
      "zh": "在位五年。",
      "blockIndex": 28
    },
    {
      "id": "s0311",
      "zh": "私諡曰成。",
      "blockIndex": 28
    },
    {
      "id": "s0312",
      "zh": "茂無子，駿嗣位。",
      "blockIndex": 28
    },
    {
      "id": "s0487",
      "zh": "永和元年，以世子重華為五官中郎將、涼州刺史。",
      "blockIndex": 44
    },
    {
      "id": "s0488",
      "zh": "酒泉太守馬岌上言：「酒泉南山，即昆侖之體也。",
      "blockIndex": 44
    },
    {
      "id": "s0489",
      "zh": "周穆王見西王母，樂而忘歸，即謂此山。",
      "blockIndex": 44
    },
    {
      "id": "s0490",
      "zh": "此山有石室玉堂，珠璣鏤飾，煥若神宮。",
      "blockIndex": 44
    },
    {
      "id": "s0491",
      "zh": "宜立西王母祠，以裨朝廷無疆之福。」",
      "blockIndex": 44
    },
    {
      "id": "s0492",
      "zh": "駿從之。",
      "blockIndex": 44
    },
    {
      "id": "s0493",
      "zh": "駿在位二十二年卒，時年四十，私諡曰文公，穆帝追諡曰忠成公。",
      "blockIndex": 44
    },
    {
      "id": "s0495",
      "zh": "駿子重華",
      "blockIndex": 45
    },
    {
      "id": "s0496",
      "zh": "=重華字泰臨，駿之第二子也。",
      "blockIndex": 46
    },
    {
      "id": "s0497",
      "zh": "寬和懿重，沈毅少言。",
      "blockIndex": 46
    },
    {
      "id": "s0498",
      "zh": "父卒，時年十六。",
      "blockIndex": 46
    },
    {
      "id": "s0499",
      "zh": "以永和二年自稱持節、大都督、太尉、護羌校尉、涼州牧、西平公、假涼王，赦其境內。",
      "blockIndex": 46
    },
    {
      "id": "s0740",
      "zh": "玄靚年既幼沖，性又仁弱，天錫既克邕，專掌朝政，改建興四十九年，奉升平之號，",
      "blockIndex": 71
    },
    {
      "id": "s0741",
      "zh": "興寧元年，駿妻馬氏卒，玄靚以其庶母郭氏為太妃。",
      "blockIndex": 71
    },
    {
      "id": "s0742",
      "zh": "郭氏以天錫專政，與大臣張欽等謀討之。",
      "blockIndex": 71
    },
    {
      "id": "s0743",
      "zh": "事泄，欽等伏法。",
      "blockIndex": 71
    },
    {
      "id": "s0744",
      "zh": "是歲，天錫率眾入禁門，潛害玄靚，宣言暴薨，時年十四。",
      "blockIndex": 71
    },
    {
      "id": "s0745",
      "zh": "在位九年。",
      "blockIndex": 71
    },
    {
      "id": "s0746",
      "zh": "私諡曰沖公，孝武帝賜諡曰敬悼公。",
      "blockIndex": 71
    },
    {
      "id": "s0748",
      "zh": "玄靚叔天錫",
      "blockIndex": 72
    },
    {
      "id": "s0749",
      "zh": "=天錫字純嘏，駿少子也，小名獨活。",
      "blockIndex": 73
    },
    {
      "id": "s0750",
      "zh": "初字公純嘏，入朝，人笑其三字，因自改焉。",
      "blockIndex": 73
    },
    {
      "id": "s0751",
      "zh": "玄靚死，國人立之，自號大將軍、校尉、涼州牧、西平公。",
      "blockIndex": 73
    },
    {
      "id": "s0752",
      "zh": "遣司馬綸騫奉章請命，並送御史俞歸還京都。",
      "blockIndex": 73
    },
    {
      "id": "s0753",
      "zh": "太和初，詔以天錫為大將軍、大都督、督隴右關中諸軍事、護羌校尉、涼州刺史、西平公。",
      "blockIndex": 73
    },
    {
      "id": "s0754",
      "zh": "天錫數宴園池，政事頗廢。",
      "blockIndex": 74
    },
    {
      "id": "s0755",
      "zh": "蕩難將軍、校書祭酒索商上疏極諫，天錫答曰：「吾非好行，行有得也。",
      "blockIndex": 74
    },
    {
      "id": "s0756",
      "zh": "觀朝榮，則敬才秀之士；",
      "blockIndex": 74
    },
    {
      "id": "s0757",
      "zh": "玩芝蘭，則愛德行之臣；",
      "blockIndex": 74
    },
    {
      "id": "s0758",
      "zh": "睹松竹，則思貞操之賢；",
      "blockIndex": 74
    },
    {
      "id": "s0759",
      "zh": "臨清流，則貴廉潔之行；",
      "blockIndex": 74
    },
    {
      "id": "s0760",
      "zh": "覽蔓草，則賤貪穢之吏；",
      "blockIndex": 74
    },
    {
      "id": "s0761",
      "zh": "逢飆風，則惡凶狡之徒。",
      "blockIndex": 74
    },
    {
      "id": "s0762",
      "zh": "若引而申之，觸類而長之，庶無遺漏矣。」",
      "blockIndex": 74
    },
    {
      "id": "s0763",
      "zh": "羌廉岐自稱益州刺史，率略陽四千家背苻堅就李儼。",
      "blockIndex": 75
    },
    {
      "id": "s0764",
      "zh": "天錫自往討之，以別駕楊遹為監前鋒軍事、前將軍，趣金城。",
      "blockIndex": 75
    },
    {
      "id": "s0765",
      "zh": "晉興相常據為使持節、征東將軍，向左南，遊擊將軍張統出白土，天錫自率三萬人次倉松，伐儼。",
      "blockIndex": 75
    },
    {
      "id": "s0766",
      "zh": "儼大敗，入城固守，遣子純求救於苻堅。",
      "blockIndex": 75
    },
    {
      "id": "s0767",
      "zh": "堅使其將王猛救之。",
      "blockIndex": 75
    },
    {
      "id": "s0768",
      "zh": "天錫敗績，死者十二三，天錫乃還。",
      "blockIndex": 75
    },
    {
      "id": "s0769",
      "zh": "立子大懷為世子。",
      "blockIndex": 75
    },
    {
      "id": "s0770",
      "zh": "自天錫之嗣事也，連年地震山崩，水泉湧出，柳化為松，火生泥中。",
      "blockIndex": 76
    },
    {
      "id": "s0771",
      "zh": "而天錫荒於聲色，不恤政事。",
      "blockIndex": 76
    },
    {
      "id": "s0772",
      "zh": "初，安定梁景、敦煌劉肅並以門胄，總角與天錫友昵。",
      "blockIndex": 76
    },
    {
      "id": "s0773",
      "zh": "張邕之誅，肅、景有勳，天錫深德之賜姓張氏，又改其字，以為己子。",
      "blockIndex": 76
    },
    {
      "id": "s0774",
      "zh": "天錫諸子皆以大為字，故景曰大奕，肅曰大誠。",
      "blockIndex": 76
    },
    {
      "id": "s0775",
      "zh": "廢大懷為高昌公，更立嬖子大豫為世子，景、肅等俱參政事。",
      "blockIndex": 76
    },
    {
      "id": "s0776",
      "zh": "人情怨懼，從弟從事中郎憲切諫，不納。",
      "blockIndex": 76
    },
    {
      "id": "s0777",
      "zh": "時苻堅強盛，每攻之，兵無寧歲。",
      "blockIndex": 77
    },
    {
      "id": "s0778",
      "zh": "天賜甚懼，乃立壇刑牲，率典軍將軍張甯、中堅將軍馬芮等，遙與晉三公盟誓，獻書大司馬桓溫，克六年夏誓同大舉。",
      "blockIndex": 77
    },
    {
      "id": "s0779",
      "zh": "遣從事中郎韓博、奮節將軍康妙奉表，並送盟文。",
      "blockIndex": 77
    },
    {
      "id": "s0780",
      "zh": "博有口才，溫甚稱之。",
      "blockIndex": 77
    },
    {
      "id": "s0781",
      "zh": "嘗大會，溫使司馬刁彝嘲之，彝謂博曰：「君是韓盧後邪？」",
      "blockIndex": 77
    },
    {
      "id": "s0782",
      "zh": "博曰：「卿是韓盧後。」",
      "blockIndex": 77
    },
    {
      "id": "s0783",
      "zh": "溫笑曰：「刁以君姓韓，故相問焉。",
      "blockIndex": 77
    },
    {
      "id": "s0784",
      "zh": "他自姓刁，那得韓盧後邪！」",
      "blockIndex": 77
    },
    {
      "id": "s0785",
      "zh": "博曰：「明公脫未之思，短尾者則為刁也。」",
      "blockIndex": 77
    },
    {
      "id": "s0786",
      "zh": "一坐推歎焉。",
      "blockIndex": 77
    },
    {
      "id": "s0787",
      "zh": "太元元年，苻堅遣其將苟萇、毛當、梁熙、姚萇來寇，渡石城津。",
      "blockIndex": 78
    }
  ]
}
