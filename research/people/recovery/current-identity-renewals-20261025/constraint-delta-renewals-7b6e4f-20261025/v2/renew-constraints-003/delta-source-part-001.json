it","evidence":["jinshu:071:s0216"]},{"id":"jinshu:071:c1190","subject":"jinshu:071:p106","predicate":"attestation","value":{"sourceDate":{"text":"解結代楊准為刺史"},"westernBounds":{"onOrBefore":{"era":"AD","year":300,"precision":"year"}},"event":"Xie Jie served as inspector before being killed in AD 300."},"certainty":"explicit-event-contextual-date","evidence":["jinshu:071:s0216"]},{"id":"jinshu:071:c1241","subject":"jinshu:071:p106","predicate":"office","value":{"label":{"en":"regional inspector","zh":"刺史"},"action":"held"},"certainty":"explicit","evidence":["jinshu:071:s0216"]}],"mentions":[{"id":"jinshu:071:m0429","person":"jinshu:071:p106","unit":{"id":"s0216","kind":"paragraph-sentence","blockIndex":31,"collection":"sentences","itemIndex":0},"kind":"personal-name","spans":{"zh":[],"en":[{"exact":"Yang Zhun","occurrence":0,"startCodePoint":64,"endCodePoint":73,"unitTextHash":"sha256:3590be7027e9167fc3d40e3d26a1739ee87666428e877f9cfa78c15d33d24d07"}]},"candidateRefs":["jinshu:071:cand_f8ddd318af36a4c0"]},{"id":"jinshu:071:m0437","person":"jinshu:071:p106","unit":{"id":"s0216","kind":"paragraph-sentence","blockIndex":31,"collection":"sentences","itemIndex":0},"kind":"personal-name","spans":{"zh":[{"exact":"楊准","occurrence":0,"startCodePoint":14,"endCodePoint":16,"unitTextHash":"sha256:f1bea98f6504e3b637a2b36a0a8f18183cbe321135b1df26351b7c3898b04595"}],"en":[]},"candidateRefs":[]}]},"currentGoldenRecordRef":{"manifestSha256":"487ad815d6bba5af42fdd057454176373f48a8249fcc6ae9011a96cb29b5f43d","field":"people","key":"jinshu:071:p106"},"actualChineseOwnedOccurrenceDelta":{"comparison":"Flatten actual Chinese spans across mention grouping; English-only empty-zh rows contribute no occurrence","added":[],"removed":[]}}},{"type":"complete-current-primary-frame-for-changed-record","value":{"book":"jinshu","chapter":"053","blockIndex":2,"completeCurrentGoverningBlock":{"type":"paragraph","sentences":[{"id":"s0199","zh":"時望氣者言廣陵有天子氣，故封為廣陵王，邑五萬戶。","translations":[{"lang":"en","literal":"At the time, observers of celestial portents said Guangling had the aura of a Son of Heaven; therefore he was enfeoffed as Prince of Guangling with a fief of fifty thousand households.","idiomatic":"Astrologers said Guangling bore an emperor's aura, so Yu was made Prince of Guangling with fifty thousand households.","translator":"Garrett M. Petersen (2026)","model":"Composer 2.5"}]},{"id":"s0200","zh":"以劉寔為師，孟珩為友，楊准、馮蓀為文學。","translations":[{"lang":"en","literal":"Liu Shi was made tutor, Meng Heng companion, and Yang Zhun and Feng Sun literary aides.","idiomatic":"Liu Shi served as tutor, Meng Heng as companion, and Yang Zhun and Feng Sun as literary aides.","translator":"Garrett M. Petersen (2026)","model":"Composer 2.5"}]},{"id":"s0201","zh":"惠帝即位，立為皇太子。","translations":[{"lang":"en","literal":"When Emperor Hui succeeded to the throne, he was established as crown prince.","idiomatic":"When Hui Di took the throne, Yu was made crown prince.","translator":"Garrett M. Petersen (2026)","model":"Composer 2.5"}]},{"id":"s0202","zh":"盛選德望以為師傅，以何劭為太師，王戎為太傅，楊濟為太保，裴楷為少師，張華為少傅，和嶠為少保。","translations":[{"lang":"en","literal":"Worthy men of virtue and repute were abundantly selected as tutors and guardians: He Shao as Grand Tutor, Wang Rong as Grand Mentor, Yang Ji as Grand Guardian, Pei Kai as Junior Tutor, Zhang Hua as Junior Mentor, and He Qiao as Junior Guardian.","idiomatic":"The court recruited eminent tutors—He Shao as Grand Tutor, Wang Rong as Grand Mentor, Yang Ji as Grand Guardian, Pei Kai as Junior Tutor, Zhang Hua as Junior Mentor, and He Qiao as Junior Guardian.","translator":"Garrett M. Petersen (2026)","model":"Composer 2.5"}]},{"id":"s0203","zh":"元康元年，出就東宮，又詔曰：「遹尚幼蒙，今出東宮，惟當賴師傅群賢之訓。","translations":[{"lang":"en","literal":"In the first year of Yuankang he moved out to the Eastern Palace; an edict further said: \"Yu is still young and untutored; now that he is moving out to the Eastern Palace he should rely solely on the instruction of his tutors and the worthy assembly.","idiomatic":"In Yuankang year one he moved to the Eastern Palace, and an edict declared: \"Yu is still young and inexperienced; now that he has moved to the Eastern Palace he must rely on his tutors and worthy mentors for instruction.","translator":"Garrett M. Petersen (2026)","model":"Composer 2.5"}]},{"id":"s0204","zh":"其遊處左右，宜得正人使共周旋，能相長益者。」","translations":[{"lang":"en","literal":"Those who attend him in leisure and service should be upright men who may keep company with him and mutually aid one another's growth.\"","idiomatic":"Those about him in leisure and attendance should be upright men who keep company with him and help one another improve.\"","translator":"Garrett M. Petersen (2026)","model":"Composer 2.5"}]},{"id":"s0205","zh":"於是使太保衛瓘息庭、司空泰息略、太子太傅楊濟息毖、太子少師裴楷息憲、太子少傅張華息禕、尚書令華暠息恆與太子游處，以相輔導焉。","translations":[{"lang":"en","literal":"Thereupon Grand Guardian Wei Guan's son Ting, Director of Works Tai's son Lue, Grand Mentor to the Crown Prince Yang Ji's son Bi, Junior Tutor to the Crown Prince Pei Kai's son Xian, Junior Mentor to the Crown Prince Zhang Hua's son Yi, and Minister Director Hua Gao's son Heng were assigned to keep company with the crown prince and assist in his guidance.","idiomatic":"Thereupon Wei Guan's son Ting, Director of Works Tai's son Lue, Yang Ji's son Bi, Pei Kai's son Xian, Zhang Hua's son Yi, and Hua Gao's son Heng were sent to keep company with the crown prince and guide him.","translator":"Garrett M. Petersen (2026)","model":"Composer 2.5"}]}]},"exactCurrentRawSourcePin":{"path":"data/jinshu/053.json","sha256":"5d4005b63b036a2c4edce99124189d56fedc90d92eb4a77280d284d012101fd8","bytes":121897}}}]}
