:0,"startCodePoint":3,"endCodePoint":5,"unitTextHash":"sha256:c851eb7ce4a28cba61b7d0696de9cb0ed21de0bbc0cf173c44002df21ff180d6"}],"en":[]},"candidateRefs":[]},{"id":"zizhitongjian:097:m0173","person":"zizhitongjian:097:p031","unit":{"id":"s0085","kind":"paragraph-sentence","blockIndex":14,"collection":"sentences","itemIndex":0},"kind":"personal-name","spans":{"zh":[],"en":[{"exact":"Han Shou","occurrence":0,"startCodePoint":31,"endCodePoint":39,"unitTextHash":"sha256:51b38e245e3c24a701db3b649dc1706fc069973e880b516657f5958a8d2976cc"}]},"candidateRefs":["zizhitongjian:097:cand_773076c41202c78d"]},{"id":"zizhitongjian:097:m0175","person":"zizhitongjian:097:p031","unit":{"id":"s0085","kind":"paragraph-sentence","blockIndex":14,"collection":"sentences","itemIndex":0},"kind":"personal-name","spans":{"zh":[{"exact":"韓壽","occurrence":0,"startCodePoint":4,"endCodePoint":6,"unitTextHash":"sha256:2e5d6efa53002a3ce434cc6c992c38696fcdd686385924010a6c72f7f3465820"}],"en":[]},"candidateRefs":[]}]},"currentGoldenRecordRef":{"manifestSha256":"487ad815d6bba5af42fdd057454176373f48a8249fcc6ae9011a96cb29b5f43d","field":"people","key":"zizhitongjian:097:p031"},"actualChineseOwnedOccurrenceDelta":{"comparison":"Flatten actual Chinese spans across mention grouping; English-only empty-zh rows contribute no occurrence","added":[],"removed":[]}}},{"type":"complete-current-primary-frame-for-changed-record","value":{"book":"jinshu","chapter":"053","blockIndex":4,"completeCurrentGoverningBlock":{"type":"paragraph","sentences":[{"id":"s0029","zh":"太子性剛，知賈謐恃後之貴，不能假借之。","translations":[{"lang":"en","literal":"The crown prince's temper was stiff; knowing Jia Mi relied on the empress's power, he would not indulge him.","idiomatic":"Yu refused to flatter Jia Mi.","translator":"Garrett M. Petersen (2026)","model":"Composer 2"}]},{"id":"s0030","zh":"謐至東宮，或舍之而於後庭遊戲。","translations":[{"lang":"en","literal":"When Mi came to the Eastern Palace he sometimes left him waiting while he played in the inner courts.","idiomatic":"He left Jia Mi cooling heels while he played inside.","translator":"Garrett M. Petersen (2026)","model":"Composer 2"}]},{"id":"s0031","zh":"詹事裴權諫曰：「賈謐甚有寵于中宮，而有不順之色，若一旦交構，大事去矣。","translations":[{"lang":"en","literal":"Household Superintendent Pei Quan remonstrated: 'Jia Mi is deeply favored in the inner palace yet shows disrespectful looks—if they ever turn on you, the great enterprise is lost.","idiomatic":"Household Superintendent Pei Quan remonstrated: \"Jia Mi is deeply favored in the inner palace yet shows disrespectful looks—if they ever turn on you, the great enterprise is lost.","translator":"Garrett M. Petersen (2026)","model":"Composer 2"}]},{"id":"s0032","zh":"宜深自謙屈，以防其變，廣延賢士，用自輔翼。」","translations":[{"lang":"en","literal":"You should humble yourself deeply to guard against change and broadly recruit worthy men to aid your wings.'","idiomatic":"You should humble yourself deeply to guard against change and broadly recruit worthy men to aid your wings.\"","translator":"Garrett M. Petersen (2026)","model":"Composer 2"}]},{"id":"s0033","zh":"太子不能從。","translations":[{"lang":"en","literal":"The crown prince would not follow.","idiomatic":"Yu ignored him.","translator":"Garrett M. Petersen (2026)","model":"Composer 2"}]},{"id":"s0034","zh":"初，賈后母郭槐欲以韓壽女為太子妃，太子亦欲婚韓氏以自固。","translations":[{"lang":"en","literal":"Earlier Empress Jia's mother Guo Huai had wished to take Han Shou's daughter as crown princess; the crown prince also wished to marry the Hans to strengthen himself.","idiomatic":"Guo Huai once pushed a Han match—Yu wanted it too.","translator":"Garrett M. Petersen (2026)","model":"Composer 2"}]},{"id":"s0035","zh":"而壽妻賈午及後皆不聽，而為太子聘王衍小女惠風。","translations":[{"lang":"en","literal":"But Han Shou's wife Jia Wu and the empress both refused and instead betrothed the crown prince to Wang Yan's younger daughter Huifeng.","idiomatic":"Jia Wu and the empress forced Wang Yan's younger daughter Huifeng instead.","translator":"Garrett M. Petersen (2026)","model":"Composer 2"}]},{"id":"s0036","zh":"太子聞衍長女美，而賈后為謐聘之，心不能平，頗以為言。","translations":[{"lang":"en","literal":"The crown prince heard Wang's elder daughter was beautiful while the empress betrothed her to Jia Mi; his heart could not rest easy and he spoke of it often.","idiomatic":"Yu resented losing Wang's elder beauty to Jia Mi.","translator":"Garrett M. Petersen (2026)","model":"Composer 2"}]},{"id":"s0037","zh":"謐嘗與太子圍棋，爭道，成都王穎見而訶謐，謐意愈不平，因此譖太子于後曰：「太子廣買田業，多畜私財以結小人者，為賈氏故也。","translations":[{"lang":"en","literal":"Once Mi played go with the crown prince and they quarreled over the move; Ying, Prince of Chengdu, saw and rebuked Mi; Mi grew more resentful and therefore slandered the crown prince to the empress: 'The crown prince buys fields wholesale, hoards private wealth, and courts petty men—all because of the Jia clan.","idiomatic":"Once while playing go with the crown prince Mi quarreled over a move; Ying, Prince of Chengdu, saw and rebuked Mi; Mi grew more resentful and slandered the crown prince to the empress: \"The crown prince buys fields wholesale, hoards private wealth, and courts petty men—all because of the Jia clan.","translator":"Garrett M. Petersen (2026)","model":"Composer 2"}]},{"id":"s0038","zh":"密聞其言云：'皇后萬歲後，吾當魚肉之。","translations":[{"lang":"en","literal":"I have secretly heard him say: \"After the empress dies, I shall butcher them.\"","idiomatic":"Mi quoted Yu vowing to slaughter the Jias after Jia died.","translator":"Garrett M. Petersen (2026)","model":"Composer 2"}]},{"id":"s0039","zh":"'非但如是也，若宮車晏駕，彼居大位，依楊氏故事，誅臣等而廢後於金墉，如反手耳。","translations":[{"lang":"en","literal":"Not only that—if the imperial carriage halts and he reaches the great seat, following Lady Yang's precedent he will execute us ministers and lock you away at Jinyong like turning his hand.","idiomatic":"Not only that—if the imperial carriage halts and he reaches the great seat, following Lady Yang's precedent he will execute us ministers and lock you away at Jinyong like turning his hand.","translator":"Garrett M. Petersen (2026)","model":"Composer 2"}]},{"id":"s0040","zh":"不如早為之所，更立慈順者以自防衛。」","translations":[{"lang":"en","literal":"Better strike early, remove him, and set up someone kindly and tractable to defend ourselves.'","idiomatic":"Better strike early, remove him, and set up someone kindly and tractable to defend ourselves.\"","translator":"Garrett M. Petersen (2026)","model":"Composer 2"}]},{"id":"s0041","zh":"後納其言，又宣揚太子之短，布諸遠近。","translations":[{"lang":"en","literal":"The empress accepted his words and further broadcast the crown prince's faults throughout near and far.","idiomatic":"Jia adopted the plot and smeared Yu empire-wide.","translator":"Garrett M. Petersen (2026)","model":"Composer 2"}]},{"id":"s0042","zh":"于時朝野咸知賈后有害太子意。","translations":[{"lang":"en","literal":"Then court and countryside knew the empress meant to harm the crown prince.","idiomatic":"Everyone saw Jia meant to kill the heir.","translator":"Garrett M. Petersen (2026)","model":"Composer 2"}]},{"id":"s0043","zh":"中護軍趙俊請太子廢後，太子不聽。","translations":[{"lang":"en","literal":"Central Guard Zhao Jun asked the crown prince to depose the empress first; the crown prince refused.","idiomatic":"Zhao Jun urged preemptive deposition—Yu declined.","translator":"Garrett M. Petersen (2026)","model":"Composer 2"}]}]},"exactCurrentRawSourcePin":{"path":"data/jinshu/053.json","sha256":"5d4005b63b036a2c4edce99124189d56fedc90d92eb4a77280d284d012101fd8","bytes":121897}}}]}
