        "leftSourceAnchors": [
          {
            "unit": "zizhitongjian:083:s0206",
            "zh": "詔以黃門首辭班示公卿，遣東武公澹以千兵防衛太子，幽於許昌宮，令持書御史劉振持節守之，詔宮臣不得辭送。"
          },
          {
            "unit": "zizhitongjian:083:s0239",
            "zh": "慮以告劉振，振乃徙太子於小坊中，絕其食，宮人猶竊於牆上過食與之。"
          },
          {
            "unit": "zizhitongjian:083:s0274",
            "zh": "誅劉振、董猛、孫慮、程據等；"
          }
        ],
        "rightSourceAnchors": [
          {
            "unit": "jinshu:053:s0068",
            "zh": "又遣澹以千兵防送太子，更幽于許昌宮之別坊，令治書御史劉振持節守之。"
          },
          {
            "unit": "jinshu:053:s0122",
            "zh": "慮以告劉振，振乃徙太子于小坊中，絕不與食，宮中猶於牆壁上過食與太子。"
          },
          {
            "unit": "jinshu:053:s0131",
            "zh": "及賈庶人死，乃誅劉振、孫慮、程據等，冊復太子曰：「皇帝使使持節、兼司空、衛尉伊策故皇太子之靈曰：嗚呼！"
          }
        ],
        "reason": "Individualized complete-frame identification above; name spelling alone is insufficient and foreign s0386 evidence excluded."
