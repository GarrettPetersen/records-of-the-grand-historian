  "members": [
    {
      "localPersonId": "jinshu:053:p064",
      "conclusion": "same-person",
      "rationale": "Restoration edict explicitly names 孝己 beside 申生 as the historical/legendary parallel of a wronged heir brought to an unnatural death. Its 復見於今 is an exemplum, not literal rebirth or a new Jin contemporary.",
      "primaryQuotes": [
        {
          "unit": "jinshu:053:s0135",
          "zh": "而朕昧於凶構，致爾於非命之禍，俾申生、孝己復見於今。"
        }
      ]
    },
    {
      "localPersonId": "sanguozhi:040:p027",
      "conclusion": "same-person",
      "rationale": "Meng Da’s argument explicitly lists 孝己 among filial sons and loyal men harmed despite virtue, inside an extended warning about fathers, heirs, slander and deposition. This supplies the same distinctive filial-victim exemplum as Jin053; no competing individual or present participant is introduced.",
      "primaryQuotes": [
        {
          "unit": "sanguozhi:040:s0038",
          "zh": "若乃權君譎主，賢父慈親，猶有忠臣蹈功以罹禍，孝子抱仁以陷難，種、商、白起、孝己、伯奇，皆其類也。"
        }
      ]
    },
    {
      "localPersonId": "shiji:056:p025",
      "conclusion": "same-person",
      "rationale": "Wei Wuzhi invokes 孝己之行 alongside Weisheng as an exemplary moral quality contrasted with strategic usefulness. The rare exact name and filial-exemplar role fit the same traditional Xiao Ji in the other two witnesses, rather than a contemporary officer.",
      "primaryQuotes": [
        {
          "unit": "shiji:056:s0063",
          "zh": "今有尾生、孝己之行而無益處於勝負之數，陛下何暇用之乎？"
        }
      ]
    }
  ],
