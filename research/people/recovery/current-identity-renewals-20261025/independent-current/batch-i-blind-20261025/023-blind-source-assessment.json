  "members": [
    {
      "localPersonId": "jinshu:053:p037",
      "conclusion": "same-person-anchor",
      "rationale": "王衍 is father of the younger daughter Huifeng betrothed to the crown prince, and an elder daughter betrothed to Jia Mi. The same father petitions for divorce after the prince’s deposition. Both inbound child-of edges and the full letter frame preserve that identity.",
      "primaryQuotes": [
        {
          "unit": "jinshu:053:s0035",
          "zh": "而壽妻賈午及後皆不聽，而為太子聘王衍小女惠風。"
        },
        {
          "unit": "jinshu:053:s0036",
          "zh": "太子聞衍長女美，而賈后為謐聘之，心不能平，頗以為言。"
        },
        {
          "unit": "jinshu:053:s0073",
          "zh": "初，太子之廢也，妃父王衍表請離婚。"
        }
      ]
    },
    {
      "localPersonId": "zizhitongjian:083:p026",
      "conclusion": "same-person",
      "rationale": "The same Han Shou/Jia Wu rejected match, Wang Yan’s younger daughter for the crown prince and elder daughter for Jia Mi reproduce the distinctive two-daughter arrangement in Jin053, with full named 王衍 and anaphoric 衍.",
      "primaryQuotes": [
        {
          "unit": "zizhitongjian:083:s0129",
          "zh": "壽妻賈午及后皆不聽，而為太子聘王衍少女。"
        },
        {
          "unit": "zizhitongjian:083:s0130",
          "zh": "太子聞衍長女美，而后為賈謐聘之，心不能平，頗以為言。"
        }
      ]
    },
    {
      "localPersonId": "zizhitongjian:083:p050",
      "conclusion": "same-person",
      "rationale": "王衍 petitions for his daughter’s divorce immediately after the crown prince and his consort Wang are confined. This is the same father-in-law and same deposition episode as Jin053s0073; the following consent clause is not imported into Jin053’s more limited claim.",
      "primaryQuotes": [
        {
          "unit": "zizhitongjian:083:s0195",
          "zh": "王衍自表離婚，許之，妃慟哭而歸。"
        }
      ]
    },
    {
      "localPersonId": "zizhitongjian:083:p066",
      "conclusion": "same-person",
      "rationale": "The deposed prince sends his consort a letter protesting false accusation; 妃父衍 does not dare report it. The same consort/father/letter/deposition continuity connects this anaphoric Yan to Wang Yan in the prior marriage and divorce episodes.",
      "primaryQuotes": [
        {
          "unit": "zizhitongjian:083:s0218",
          "zh": "太子至許，遺王妃書，自陳誣枉，妃父衍不敢以聞。"
        }
      ]
    },
    {
      "localPersonId": "weishu:091:p119",
      "conclusion": "possible-same-as",
      "rationale": "The sealed Chinese only invokes 夷甫 in Li Kai’s moral comparison after Wen Zisheng escapes captivity. It is an earlier courtesy-name allusion, compatible with the inherited Wang Yan reading, not a contemporary Northern Wei Wang Yan. However, no supplied primary unit explicitly bridges 夷甫 to 王衍 or to the distinctive crown-prince-family episodes. Preferred-name expansion and AD291–311 metadata are extractor assertions, not independent primary bridges. On this packet alone I retain possible-same-as rather than certify a confident merge or invent a different person.",
      "primaryQuotes": [
        {
          "unit": "weishu:091:s0165",
          "zh": "還京，李楷執其手曰：「卿今得免，足使夷甫慚德。」"
        }
      ]
    }
  ],
