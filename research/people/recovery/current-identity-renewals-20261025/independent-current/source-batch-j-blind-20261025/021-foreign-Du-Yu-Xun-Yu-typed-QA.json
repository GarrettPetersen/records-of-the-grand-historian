      },
      "completeChineseGoverningFrame": [
        {
          "id": "zizhitongjian:083:s0136",
          "zh": "太子幼有令名，及長，不好學，惟與左右嬉戲。"
        },
        {
          "id": "zizhitongjian:083:s0137",
          "zh": "賈后復使黃門輩誘之為奢靡威虐，由是名譽浸減，驕慢益彰。"
        },
        {
          "id": "zizhitongjian:083:s0138",
          "zh": "或廢朝侍而縱游逸，於宮中為市，使人屠酤，手揣斤兩，輕重不差。"
        },
        {
          "id": "zizhitongjian:083:s0139",
          "zh": "其母，本屠家女也，故太子好之。"
        },
        {
          "id": "zizhitongjian:083:s0140",
          "zh": "東宮月俸錢五十萬，太子常探取二月，用之猶不足。"
        },
        {
          "id": "zizhitongjian:083:s0141",
          "zh": "又令西園賣葵菜、藍子、雞、面等物而收其利。"
        },
        {
          "id": "zizhitongjian:083:s0142",
          "zh": "又好陰陽小數，多所拘忌。"
        },
        {
          "id": "zizhitongjian:083:s0143",
          "zh": "洗馬江統上書陳五事：「一曰雖有微苦，宜力疾朝侍。"
        },
        {
          "id": "zizhitongjian:083:s0144",
          "zh": "二曰宜勤見保傅，咨讒善道。"
        },
        {
          "id": "zizhitongjian:083:s0145",
          "zh": "三曰畫室之功，可且減省，後園刻鏤雜作，一皆罷遣。"
        },
        {
          "id": "zizhitongjian:083:s0146",
          "zh": "四曰西園賣葵、藍之屬，虧敗國體，貶損令聞。"
        },
        {
          "id": "zizhitongjian:083:s0147",
          "zh": "五曰繕牆正瓦，不必拘攣小忌。」"
        },
        {
