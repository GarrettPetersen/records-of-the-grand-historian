  {
    "localPersonId": "zizhitongjian:083:p097",
    "canonicalPersonId": "per_BX5GDB4ZB111PPVF04P1",
    "conclusionRelativeToTarget": "same-person",
    "confidence": "high",
    "rationale": "Explicit former prince 遹 restored with Bin/Zang/Shang sons, posthumous Minhuai and Xianping burial directly identify the same target. Reject English Yu inside Xun Yu0290 and He Yu0285 as identity evidence, not genuine homonym uncertainty.",
    "primarySourceAnchors": [
      {
        "unitId": "zizhitongjian:083:s0285",
        "zh": "詔追復故太子遹位號，使尚書和郁帥東宮官屬迎太子喪於許昌，追封遹子虨為南陽王，封虨弟臧為臨淮王，尚為襄陽王。"
      },
      {
        "unitId": "zizhitongjian:083:s0293",
        "zh": "太子遹之廢也，將立淮南王允為太弟，議者不合。"
      },
      {
