itRef":"jinshu:053:s0201"},{"unitRef":"jinshu:053:s0202"},{"unitRef":"jinshu:053:s0203"},{"unitRef":"jinshu:053:s0204"},{"unitRef":"jinshu:053:s0205"}]},"unitRefs":["jinshu:053:s0199","jinshu:053:s0200","jinshu:053:s0201","jinshu:053:s0202","jinshu:053:s0203","jinshu:053:s0204","jinshu:053:s0205"]}},{"kind":"complete-governing-block-structure","key":"songshu:047:block:0","value":{"chapterPinRef":"songshu:047","blockIndex":0,"structure":{"type":"paragraph","sentences":[{"unitRef":"songshu:047:s0001"},{"unitRef":"songshu:047:s0002"},{"unitRef":"songshu:047:s0003"}]},"unitRefs":["songshu:047:s0001","songshu:047:s0002","songshu:047:s0003"]}},{"kind":"complete-governing-block-structure","key":"songshu:047:block:9","value":{"chapterPinRef":"songshu:047","blockIndex":9,"structure":{"type":"paragraph","sentences":[{"unitRef":"songshu:047:s0084"},{"unitRef":"songshu:047:s0085"},{"unitRef":"songshu:047:s0086"},{"unitRef":"songshu:047:s0087"},{"unitRef":"songshu:047:s0088"}]},"unitRefs":["songshu:047:s0084","songshu:047:s0085","songshu:047:s0086","songshu:047:s0087","songshu:047:s0088"]}},{"kind":"source-unit","key":"jinshu:053:s0001","value":{"id":"jinshu:053:s0001","kind":"paragraph-sentence","blockIndex":0,"collection":"sentences","itemIndex":0,"zh":"愍懷太子","en":"Crown Prince Minhuai","literal":"Crown Prince Minhuai"}},{"kind":"source-unit","key":"jinshu:053:s0199","value":{"id":"jinshu:053:s0199","kind":"paragraph-sentence","blockIndex":2,"collection":"sentences","itemIndex":0,"zh":"時望氣者言廣陵有天子氣，故封為廣陵王，邑五萬戶。","en":"Astrologers said Guangling bore an emperor's aura, so Yu was made Prince of Guangling with fifty thousand households.","literal":"At the time, observers of celestial portents said Guangling had the aura of a Son of Heaven; therefore he was enfeoffed as Prince of Guangling with a fief of fifty thousand households."}},{"kind":"source-unit","key":"jinshu:053:s0200","value":{"id":"jinshu:053:s0200","kind":"paragraph-sentence","blockIndex":2,"collection":"sentences","itemIndex":1,"zh":"以劉寔為師，孟珩為友，楊准、馮蓀為文學。","en":"Liu Shi served as tutor, Meng Heng as companion, and Yang Zhun and Feng Sun as literary aides.","literal":"Liu Shi was made tutor, Meng Heng companion, and Yang Zhun and Feng Sun literary aides."}},{"kind":"source-unit","key":"jinshu:053:s0201","value":{"id":"jinshu:053:s0201","kind":"paragraph-sentence","blockIndex":2,"collection":"sentences","itemIndex":2,"zh":"惠帝即位，立為皇太子。","en":"When Hui Di took the throne, Yu was made crown prince.","literal":"When Emperor Hui succeeded to the throne, he was established as crown prince."}},{"kind":"source-unit","key":"jinshu:053:s0202","value":{"id":"jinshu:053:s0202","kind":"paragraph-sentence","blockIndex":2,"collection":"sentences","itemIndex":3,"zh":"盛選德望以為師傅，以何劭為太師，王戎為太傅，楊濟為太保，裴楷為少師，張華為少傅，和嶠為少保。","en":"The court recruited eminent tutors—He Shao as Grand Tutor, Wang Rong as Grand Mentor, Yang Ji as Grand Guardian, Pei Kai as Junior Tutor, Zhang Hua as Junior Mentor, and He Qiao as Junior Guardian.","literal":"Worthy men of virtue and repute were abundantly selected as tutors and guardians: He Shao as Grand Tutor, Wang Rong as Grand Mentor, Yang Ji as Grand Guardian, Pei Kai as Junior Tutor, Zhang Hua as Junior Mentor, and He Qiao as Junior Guardian."}},{"kind":"source-unit","key":"jinshu:053:s0203","value":{"id":"jinshu:053:s0203","kind":"paragraph-sentence","blockIndex":2,"collection":"sentences","itemIndex":4,"zh":"元康元年，出就東宮，又詔曰：「遹尚幼蒙，今出東宮，惟當賴師傅群賢之訓。","en":"In Yuankang year one he moved to the Eastern Palace, and an edict declared: \"Yu is still young and inexperienced; now that he has moved to the Eastern Palace he must rely on his tutors and worthy mentors for instruction.","literal":"In the first year of Yuankang he moved out to the Eastern Palace; an edict further said: \"Yu is still young and untutored; now that he is moving out to the Eastern Palace he should rely solely on the instruction of his tutors and the worthy assembly."}},{"kind":"source-unit","key":"jinshu:053:s0204","value":{"id":"jinshu:053:s0204","kind":"paragraph-sentence","blockIndex":2,"collection":"sentences","itemIndex":5,"zh":"其遊處左右，宜得正人使共周旋，能相長益者。」","en":"Those about him in leisure and attendance should be upright men who keep company with him and help one another improve.\"","literal":"Those who attend him in leisure and service should be upright men who may keep company with him and mutually aid one another's growth.\""}},{"kind":"source-unit","key":"jinshu:053:s0205","value":{"id":"jinshu:053:s0205","kind":"paragraph-sentence","blockIndex":2,"collection":"sentences","itemIndex":6,"zh":"於是使太保衛瓘息庭、司空泰息略、太子太傅楊濟息毖、太子少師裴楷息憲、太子少傅張華息禕、尚書令華暠息恆與太子游處，以相輔導焉。","en":"Thereupon Wei Guan's son Ting, Director of Works Tai's son Lue, Yang Ji's son Bi, Pei Kai's son Xian, Zhang Hua's son Yi, and Hua Gao's son Heng were sent to keep company with the crown prince and guide him.","literal":"Thereupon Grand Guardian Wei Guan's son Ting, Director of Works Tai's son Lue, Grand Mentor to the Crown Prince Yang Ji's son Bi, Junior Tutor to the Crown Prince Pei Kai's son Xian, Junior Mentor to the Crown Prince Zhang Hua's son Yi, and Minister Director Hua Gao's son Heng were assigned to keep company with the crown prince and assist in his guidance."}},{"kind":"source-unit","key":"songshu:047:s0001","value":{"id":"songshu:047:s0001","kind":"paragraph-sentence","blockIndex":0,"collection":"sentences","itemIndex":0,"zh":"列傳第七 劉懷肅 孟懷玉","en":"Biographies 7: Liu Huaisu and Meng Huaiyu","literal":"Biographies 7: Liu Huaisu, Meng Huaiyu"}},{"kind":"source-unit","key":"songshu:047:s0002","value":{"id":"songshu:047:s0002","kind":"paragraph-sentence","blockIndex":0,"collection":"sentences","itemIndex":1,"zh":"〈弟龍符〉","en":"〈Younger brother Longfu〉","literal":"〈Younger brother Longfu〉"}},{"kind":"source-unit","key":"songshu:047:s0003","value":{"id":"songshu:047:s0003","kind":"paragraph-sentence","blockIndex":0,"collection":"sentences","itemIndex":2,"zh":"劉敬宣 檀祗","en":"Liu Jingxuan and Tan Zhi","literal":"Liu Jingxuan, Tan Zhi"}},{"kind":"source-unit","key":"songshu:047:s0084","value":{"id":"songshu:047:s0084","kind":"paragraph-sentence","blockIndex":9,"collection":"sentences","itemIndex":0,"zh":"孟懷玉，平昌安丘人也。","en":"Meng Huaiyu was a native of Anqiu in Pingchang.","literal":"Meng Huaiyu was a man of Anqiu in Pingchang."}},{"kind":"source-unit","key":"songshu:047:s0085","value":{"id":"songshu:047:s0085","kind":"paragraph-sentence","blockIndex":9,"collection":"sentences","itemIndex":1,"zh":"高祖珩，晉河南尹。","en":"Emperor Wu's father Heng had been Jin administrator of Henan.","literal":"The Gaozu's father Heng was Jin Administrator of Henan."}},{"kind":"source-unit","key":"songshu:047:s0086","value":{"id":"songshu:047:s0086","kind":"paragraph-sentence","blockIndex":9,"collection":"sentences","itemIndex":2,"zh":"祖淵，右光祿大夫。","en":"His grandfather Yuan was right grand master for splendid happiness.","literal":"His grandfather Yuan was Right Grand Master for Splendid Happiness."}},{"kind":"source-unit","key":"songshu:047:s0087","value":{"id":"songshu:047:s0087","kind":"paragraph-sentence","blockIndex":9,"collection":"sentences","itemIndex":3,"zh":"父綽，義旗後為給事中，光祿勳，追贈金紫光祿大夫。","en":"His father Chuo, after the founding uprising, became palace attendant and grand master for splendid happiness, and was posthumously made grand master for the palace with golden seal and purple ribbon.","literal":"His father Chuo, after the righteous banner was raised, became Palace Attendant and Grand Master for Splendid Happiness, and was posthumously given Grand Master for the Palace with Golden Seal and Purple Ribbon."}},{"kind":"source-unit","key":"songshu:047:s0088","value":{"id":"songshu:047:s0088","kind":"paragraph-sentence","blockIndex":9,"collection":"sentences","itemIndex":4,"zh":"世居京口。","en":"The family had long lived at Jingkou.","literal":"For generations they dwelt at Jingkou."}},{"kind":"person-record","key":"jinshu:053:p008","value":{"localId":"jinshu:053:p008","preferredNameSuggestion"