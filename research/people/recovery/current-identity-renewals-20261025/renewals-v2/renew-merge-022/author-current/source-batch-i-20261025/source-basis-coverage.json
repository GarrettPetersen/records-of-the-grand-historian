        "jinshu:053:m0464"
      ],
      "inboundClaimIds": []
    },
    {
      "localPersonId": "sanguozhi:040:p027",
      "canonicalPersonId": "per_HF411Y1WQQ17WV8F2S9W",
      "conclusion": "same-person",
      "rationale": "Meng Da’s argument explicitly names 孝己 among filial sons who embraced benevolence yet fell into hardship and then invokes Shen Sheng among legitimate heirs endangered by altered parental favor. This specific moral exemplum matches the wronged-son comparison in the target, rather than a living Three Kingdoms person.",
      "primaryUnitCitations": [
        {
          "unit": "sanguozhi:040:s0038",
          "zh": "若乃權君譎主，賢父慈親，猶有忠臣蹈功以罹禍，孝子抱仁以陷難，種、商、白起、孝己、伯奇，皆其類也。"
        }
      ],
      "completeGoverningBlocks": [
        "sanguozhi:040:block:2"
      ],
      "claimIds": [
        "sanguozhi:040:c0053",
        "sanguozhi:040:c0054",
        "sanguozhi:040:c0431"
      ],
      "mentionIds": [
        "sanguozhi:040:m0119",
        "sanguozhi:040:m0123"
      ],
      "inboundClaimIds": []
    },
    {
      "localPersonId": "shiji:056:p025",
      "canonicalPersonId": "per_KDSJ6J3AN602PCZNJ4F0",
      "conclusion": "same-person",
      "rationale": "Wei Wuzhi names 孝己 with Weisheng as a recognized moral exemplar whose conduct alone cannot win a war. Together with Sanguozhi’s explicit filial-son characterization and Jinshu’s named wronged-son analogy, this identifies the same traditional 孝己 exemplum across reception contexts. The merger identifies that literary referent; no Shang father, reign, birth or death date is inferred.",
      "primaryUnitCitations": [
        {
          "unit": "shiji:056:s0063",
          "zh": "今有尾生、孝己之行而無益處於勝負之數，陛下何暇用之乎？"
        }
      ],
      "completeGoverningBlocks": [
