  "memberAssessments": [
    {
      "localPersonId": "jinshu:053:p064",
      "canonicalPersonId": "per_VW68KHPPSF7K2GP5KY8H",
      "conclusion": "target",
      "rationale": "The restoration edict places named 孝己 beside Shen Sheng as an earlier example of a son unjustly brought to an unnatural end. 復見於今 is analogy to Minhuai, not literal survival or activity in the Jin edict year.",
      "primaryUnitCitations": [
        {
          "unit": "jinshu:053:s0135",
          "zh": "而朕昧於凶構，致爾於非命之禍，俾申生、孝己復見於今。"
        }
      ],
      "completeGoverningBlocks": [
        "jinshu:053:block:8"
      ],
      "claimIds": [
        "jinshu:053:c0229",
        "jinshu:053:c0230",
