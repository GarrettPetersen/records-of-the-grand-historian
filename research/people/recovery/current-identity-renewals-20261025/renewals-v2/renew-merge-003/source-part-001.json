f":"jinshu:053:s0031"},{"unitRef":"jinshu:053:s0032"},{"unitRef":"jinshu:053:s0033"},{"unitRef":"jinshu:053:s0034"},{"unitRef":"jinshu:053:s0035"},{"unitRef":"jinshu:053:s0036"},{"unitRef":"jinshu:053:s0037"},{"unitRef":"jinshu:053:s0038"},{"unitRef":"jinshu:053:s0039"},{"unitRef":"jinshu:053:s0040"},{"unitRef":"jinshu:053:s0041"},{"unitRef":"jinshu:053:s0042"},{"unitRef":"jinshu:053:s0043"}]},"unitRefs":["jinshu:053:s0029","jinshu:053:s0030","jinshu:053:s0031","jinshu:053:s0032","jinshu:053:s0033","jinshu:053:s0034","jinshu:053:s0035","jinshu:053:s0036","jinshu:053:s0037","jinshu:053:s0038","jinshu:053:s0039","jinshu:053:s0040","jinshu:053:s0041","jinshu:053:s0042","jinshu:053:s0043"]}},{"kind":"complete-governing-block-structure","key":"zizhitongjian:083:block:0","value":{"chapterPinRef":"zizhitongjian:083","blockIndex":0,"structure":{"type":"paragraph","sentences":[{"unitRef":"zizhitongjian:083:s0001"}]},"unitRefs":["zizhitongjian:083:s0001"]}},{"kind":"complete-governing-block-structure","key":"zizhitongjian:083:block:23","value":{"chapterPinRef":"zizhitongjian:083","blockIndex":23,"structure":{"type":"paragraph","sentences":[{"unitRef":"zizhitongjian:083:s0151"},{"unitRef":"zizhitongjian:083:s0152"},{"unitRef":"zizhitongjian:083:s0153"},{"unitRef":"zizhitongjian:083:s0154"},{"unitRef":"zizhitongjian:083:s0155"},{"unitRef":"zizhitongjian:083:s0156"},{"unitRef":"zizhitongjian:083:s0157"},{"unitRef":"zizhitongjian:083:s0158"},{"unitRef":"zizhitongjian:083:s0159"}]},"unitRefs":["zizhitongjian:083:s0151","zizhitongjian:083:s0152","zizhitongjian:083:s0153","zizhitongjian:083:s0154","zizhitongjian:083:s0155","zizhitongjian:083:s0156","zizhitongjian:083:s0157","zizhitongjian:083:s0158","zizhitongjian:083:s0159"]}},{"kind":"source-unit","key":"jinshu:053:s0001","value":{"id":"jinshu:053:s0001","kind":"paragraph-sentence","blockIndex":0,"collection":"sentences","itemIndex":0,"zh":"愍懷太子","en":"Crown Prince Minhuai","literal":"Crown Prince Minhuai"}},{"kind":"source-unit","key":"jinshu:053:s0029","value":{"id":"jinshu:053:s0029","kind":"paragraph-sentence","blockIndex":4,"collection":"sentences","itemIndex":0,"zh":"太子性剛，知賈謐恃後之貴，不能假借之。","en":"Yu refused to flatter Jia Mi.","literal":"The crown prince's temper was stiff; knowing Jia Mi relied on the empress's power, he would not indulge him."}},{"kind":"source-unit","key":"jinshu:053:s0030","value":{"id":"jinshu:053:s0030","kind":"paragraph-sentence","blockIndex":4,"collection":"sentences","itemIndex":1,"zh":"謐至東宮，或舍之而於後庭遊戲。","en":"He left Jia Mi cooling heels while he played inside.","literal":"When Mi came to the Eastern Palace he sometimes left him waiting while he played in the inner courts."}},{"kind":"source-unit","key":"jinshu:053:s0031","value":{"id":"jinshu:053:s0031","kind":"paragraph-sentence","blockIndex":4,"collection":"sentences","itemIndex":2,"zh":"詹事裴權諫曰：「賈謐甚有寵于中宮，而有不順之色，若一旦交構，大事去矣。","en":"Household Superintendent Pei Quan remonstrated: \"Jia Mi is deeply favored in the inner palace yet shows disrespectful looks—if they ever turn on you, the great enterprise is lost.","literal":"Household Superintendent Pei Quan remonstrated: 'Jia Mi is deeply favored in the inner palace yet shows disrespectful looks—if they ever turn on you, the great enterprise is lost."}},{"kind":"source-unit","key":"jinshu:053:s0032","value":{"id":"jinshu:053:s0032","kind":"paragraph-sentence","blockIndex":4,"collection":"sentences","itemIndex":3,"zh":"宜深自謙屈，以防其變，廣延賢士，用自輔翼。」","en":"You should humble yourself deeply to guard against change and broadly recruit worthy men to aid your wings.\"","literal":"You should humble yourself deeply to guard against change and broadly recruit worthy men to aid your wings.'"}},{"kind":"source-unit","key":"jinshu:053:s0033","value":{"id":"jinshu:053:s0033","kind":"paragraph-sentence","blockIndex":4,"collection":"sentences","itemIndex":4,"zh":"太子不能從。","en":"Yu ignored him.","literal":"The crown prince would not follow."}},{"kind":"source-unit","key":"jinshu:053:s0034","value":{"id":"jinshu:053:s0034","kind":"paragraph-sentence","blockIndex":4,"collection":"sentences","itemIndex":5,"zh":"初，賈后母郭槐欲以韓壽女為太子妃，太子亦欲婚韓氏以自固。","en":"Guo Huai once pushed a Han match—Yu wanted it too.","literal":"Earlier Empress Jia's mother Guo Huai had wished to take Han Shou's daughter as crown princess; the crown prince also wished to marry the Hans to strengthen himself."}},{"kind":"source-unit","key":"jinshu:053:s0035","value":{"id":"jinshu:053:s0035","kind":"paragraph-sentence","blockIndex":4,"collection":"sentences","itemIndex":6,"zh":"而壽妻賈午及後皆不聽，而為太子聘王衍小女惠風。","en":"Jia Wu and the empress forced Wang Yan's younger daughter Huifeng instead.","literal":"But Han Shou's wife Jia Wu and the empress both refused and instead betrothed the crown prince to Wang Yan's younger daughter Huifeng."}},{"kind":"source-unit","key":"jinshu:053:s0036","value":{"id":"jinshu:053:s0036","kind":"paragraph-sentence","blockIndex":4,"collection":"sentences","itemIndex":7,"zh":"太子聞衍長女美，而賈后為謐聘之，心不能平，頗以為言。","en":"Yu resented losing Wang's elder beauty to Jia Mi.","literal":"The crown prince heard Wang's elder daughter was beautiful while the empress betrothed her to Jia Mi; his heart could not rest easy and he spoke of it often."}},{"kind":"source-unit","key":"jinshu:053:s0037","value":{"id":"jinshu:053:s0037","kind":"paragraph-sentence","blockIndex":4,"collection":"sentences","itemIndex":8,"zh":"謐嘗與太子圍棋，爭道，成都王穎見而訶謐，謐意愈不平，因此譖太子于後曰：「太子廣買田業，多畜私財以結小人者，為賈氏故也。","en":"Once while playing go with the crown prince Mi quarreled over a move; Ying, Prince of Chengdu, saw and rebuked Mi; Mi grew more resentful and slandered the crown prince to the empress: \"The crown prince buys fields wholesale, hoards private wealth, and courts petty men—all because of the Jia clan.","literal":"Once Mi played go with the crown prince and they quarreled over the move; Ying, Prince of Chengdu, saw and rebuked Mi; Mi grew more resentful and therefore slandered the crown prince to the empress: 'The crown prince buys fields wholesale, hoards private wealth, and courts petty men—all because of the Jia clan."}},{"kind":"source-unit","key":"jinshu:053:s0038","value":{"id":"jinshu:053:s0038","kind":"paragraph-sentence","blockIndex":4,"collection":"sentences","itemIndex":9,"zh":"密聞其言云：'皇后萬歲後，吾當魚肉之。","en":"Mi quoted Yu vowing to slaughter the Jias after Jia died.","literal":"I have secretly heard him say: \"After the empress dies, I shall butcher them.\""}},{"kind":"source-unit","key":"jinshu:053:s0039","value":{"id":"jinshu:053:s0039","kind":"paragraph-sentence","blockIndex":4,"collection":"sentences","itemIndex":10,"zh":"'非但如是也，若宮車晏駕，彼居大位，依楊氏故事，誅臣等而廢後於金墉，如反手耳。","en":"Not only that—if the imperial carriage halts and he reaches the great seat, following Lady Yang's precedent he will execute us ministers and lock you away at Jinyong like turning his hand.","literal":"Not only that—if the imperial carriage halts and he reaches the great seat, following Lady Yang's precedent he will execute us ministers and lock you away at Jinyong like turning his hand."}},{"kind":"source-unit","key":"jinshu:053:s0040","value":{"id":"jinshu:053:s0040","kind":"paragraph-sentence","blockIndex":4,"collection":"sentences","itemIndex":11,"zh":"不如早為之所，更立慈順者以自防衛。」","en":"Better strike early, remove him, and set up someone kindly and tractable to defend ourselves.\"","literal":"Better strike early, remove him, and set up someone kindly and tractable to defend ourselves.'"}},{"kind":"source-unit","key":"jinshu:053:s0041","value":{"id":"jinshu:053:s0041","kind":"paragraph-sentence","blockIndex":4,"collection":"sentences","itemIndex":12,"zh":"後納其言，又宣揚太子之短，布諸遠近。","en":"Jia adopted the plot and smeared Yu empire-wide.","literal":"The empress accepted his words and further broadcast the crown prince's faults throughout near and far."}},{"kind":"source-unit","key":"jinshu:053:s0042","value":{"id":"jinshu:053:s0042","kind":"paragraph-sentence","blockIndex":4,"collection":"sentences","itemIndex":13,"zh":"于時朝野咸知賈后有害太子意。","en":"Everyone saw Jia meant to kill the heir.","literal":"Then court and countryside knew the empress meant to harm the crown prince."}},{"kind":"source-unit","key":"jinshu:053:s0043","value":{"id":"jinshu:053:s0043","kind":"paragraph-sentence","blockIndex":4,"collection":"sentences","itemIndex":14,"zh":"中護軍趙俊請太子廢後，太子不聽。","en":"Zhao Jun urged preemptive deposition—Yu declined.","literal":"Central Guard Zhao Jun asked the crown prince to depose the empress first; the crown prince refused."}},{"kind":"source-unit","key":"zizhitongjian:083:s0001","value":{"id":"zizhitongjian:083:s0001","kind":"paragraph-sentence","blockIndex":0,"collection":"sentences","itemIndex":0,"zh":"資治通鑑第083卷","en":"Zizhi Tongjian, Volume 83","literal":"Comprehensive Mirror to Aid in Government, Volume 83"}},{"kind":"source-unit","key":"zizhitongjian:083:s0151","value":{"id":"zizhitongjian:083:s0151","kind":"paragraph-sentence","blockIndex":23,"collection":"sentences","itemIndex":0,"zh":"太子性剛，知賈謐恃中宮驕貴，不能假借之。","en":"The heir apparent was proud by nature. Knowing Jia Mi relied on the empress's power, he would not indulge him.","literal":"The Heir Apparent was by nature stern; knowing that Jia Mi relied on the central palace's arrogant eminence, he could not show him favor."}},{"kind":"source-unit","key":"zizhitongjian:083:s0152","value":{"id":"zizhitongjian:083:s0152","kind":"paragraph-sentence","blockIndex":23,"collection":"sentences","itemIndex":1,"zh":"謐時為侍中，至東宮，或捨之，於後庭遊戲。","en":"Mi was then Attendant of the Yellow Gate. When he visited the Eastern Palace the heir apparent sometimes dismissed him and amused himself in the rear court.","literal":"Mi was then Attendant of the Yellow Gate; when he came to the Eastern Palace the Heir Apparent sometimes dismissed him and played in the rear court."}},{"kind":"source-unit","key":"zizhitongjian:083:s0153","value":{"id":"zizhitongjian:083:s0153","kind":"paragraph-sentence","blockIndex":23,"collection":"sentences","itemIndex":2,"zh":"詹事裴權諫曰：「謐，后所親暱，一旦交構，則事危矣。」","en":"Steward Pei Quan warned him: \"Mi is the empress's favorite. If you quarrel with him, disaster will follow.\"","literal":"The Steward Pei Quan remonstrated: \"Mi is one the empress cherishes; if you should clash, the affair would be perilous.\""}},{"kind":"source-unit","key":"zizhitongjian:083:s0154","value":{"id":"zizhitongjian:083:s0154","kind":"paragraph-sentence","blockIndex":23,"collection":"sentences","itemIndex":3,"zh":"不從。","en":"He would not listen.","literal":"He did not heed him."}},{"kind":"source-unit","key":"zizhitongjian:083:s0155","value":{"id":"zizhitongjian:083:s0155","kind":"paragraph-sentence","blockIndex":23,"collection":"sentences","itemIndex":4,"zh":"謐譖太子於后曰：「太子多畜私財以結小人者，為賈氏故也。","en":"Mi slandered the heir apparent to the empress, saying: \"He hoards private wealth to win over petty men because he means to destroy the Jia clan.","literal":"Mi slandered the Heir Apparent to the empress, saying: \"The Heir Apparent amasses private wealth to win over petty men because of the Jia clan."}},{"kind":"source-unit","key":"zizhitongjian:083:s0156","value":{"id":"zizhitongjian:083:s0156","kind":"paragraph-sentence","blockIndex":23,"collection":"sentences","itemIndex":5,"zh":"若宮車晏駕，彼居大位，依楊氏故事，誅臣等，廢后於金墉，如反手耳。","en":"When the emperor dies and he takes the throne, he will follow the Yang clan precedent, execute us, and imprison you at Jinyong. It will be as easy as turning his hand.","literal":"If the imperial carriage should halt forever and he take the great position, following the Yang clan precedent he would execute us ministers and depose the empress at Jinyong—it would be like turning the hand."}},{"kind":"source-unit","key":"zizhitongjian:083:s0157","value":{"id":"zizhitongjian:083:s0157","kind":"paragraph-sentence","blockIndex":23,"collection":"sentences","itemIndex":6,"zh":"不如早圖之，更立慈順者，可以自安。」","en":"Better act early and set up another heir who is mild and obedient. Then we may be safe.\"","literal":"Better to plot early, set up another who is kindly and obedient, and thus secure ourselves.\""}},{"kind":"source-unit","key":"zizhitongjian:083:s0158","value":{"id":"zizhitongjian:083:s0158","kind":"paragraph-sentence","blockIndex":23,"collection":"sentences","itemIndex":7,"zh":"后納其言，乃宣揚太子之短，佈於遠近。","en":"The empress accepted his counsel and spread the heir apparent's faults far and wide.","literal":"The empress accepted his words and thereupon spread abroad the Heir Apparent's faults, broadcasting them far and near."}},{"kind":"source-unit","key":"zizhitongjian:083:s0159","value":{"id":"zizhitongjian:083:s0159","kind":"paragraph-sentence","blockIndex":23,"collection":"sentences","itemIndex":8,"zh":"又詐為有娠，內蒿物、產具，取妹夫韓壽子慰祖養之，欲以代太子。","en":"She also feigned pregnancy, hid birthing supplies inside, took her brother-in-law Han Shou's son Weizu to rear, and planned to replace the heir apparent with him.","literal":"She also feigned pregnancy, hid artemisia and birthing gear within, took her brother-in-law Han Shou's son Weizu to rear, and intended to replace the Heir Apparent with him."}},{"kind":"person-record","key":"jinshu:053:p032","value":{"localId":"jinshu:053:p032","preferredNameSuggestion":{"en":"Pei Quan","zh":"裴權","pinyin":"Pei Quan"},"historicity":"historical","descriptorSuggestion":"Household Superintendent","identityHints":{"nativePlaces":[],"relatedLocalPeople":["jinshu:053:p001"],"activeDateHints":[],"polityHints":["Western Jin","晉"]},"book":"jinshu","chapter":"053","promptVersion":7,"sourceUnitRefs":["jinshu:053:s0031","jinshu:053:s0032"],"chapterPinRef":"jinshu:053","aliasesAndNameKeys":[{"key":"en:pei quan","language":"en","value":"Pei Quan","kinds":["personal-name","preferred"],"sources":["jinshu:053:c0126","preferred"],"blocking":true},{"key":"zh:裴權","language":"zh","value":"裴權","kinds":["personal-name","preferred"],"sources":["jinshu:053:c0126","preferred"],"blocking":true},{"key":"en:household superintendent pei quan","language":"en","value":"Household Superintendent Pei Quan",