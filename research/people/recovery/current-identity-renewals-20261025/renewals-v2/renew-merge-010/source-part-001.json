nitRef":"jinshu:053:s0201"},{"unitRef":"jinshu:053:s0202"},{"unitRef":"jinshu:053:s0203"},{"unitRef":"jinshu:053:s0204"},{"unitRef":"jinshu:053:s0205"}]},"unitRefs":["jinshu:053:s0199","jinshu:053:s0200","jinshu:053:s0201","jinshu:053:s0202","jinshu:053:s0203","jinshu:053:s0204","jinshu:053:s0205"]}},{"kind":"source-unit","key":"jinshu:037:s0002","value":{"id":"jinshu:037:s0002","kind":"paragraph-sentence","blockIndex":0,"collection":"sentences","itemIndex":0,"zh":"安平獻王孚","en":"Prince Xian of Anping, Sima Fu.","literal":"Prince Fu of Anping with posthumous title Xian (section heading)."}},{"kind":"source-unit","key":"jinshu:037:s0367","value":{"id":"jinshu:037:s0367","kind":"paragraph-sentence","blockIndex":62,"collection":"sentences","itemIndex":0,"zh":"孝王略，字元簡，孝敬慈順，小心下士，少有父風。","en":"Sima Lue, styled Yuanjian, echoed his father's modest courtesy.","literal":"Prince Xiao Lue courtesy Yuanjian was respectful, mild, and obedient, humble toward scholars, having somewhat his father's manner."}},{"kind":"source-unit","key":"jinshu:037:s0368","value":{"id":"jinshu:037:s0368","kind":"paragraph-sentence","blockIndex":62,"collection":"sentences","itemIndex":1,"zh":"元康初，湣懷太子在東宮，選大臣子弟有名稱者以為賓友，略與華恆等並侍左右。","en":"Yuankang saw Lue among Minhuai's cultivated companions with Hua Heng.","literal":"Early Yuankang Crown Prince Minhuai was in the eastern palace and chose sons of eminent ministers with reputation as guests and friends; Lue together with Hua Heng and others attended left and right."}},{"kind":"source-unit","key":"jinshu:037:s0369","value":{"id":"jinshu:037:s0369","kind":"paragraph-sentence","blockIndex":62,"collection":"sentences","itemIndex":2,"zh":"曆散騎黃門侍郎、散騎常侍、秘書監，出為安南將軍、持節、都督沔南諸軍事，遷安北將軍、都督青州諸軍事。","en":"He successively served as Yellow-Gate Gentleman Attendant, Regular Palace Attendant, and Director of the Palace Library; then he was sent out as General Who Pacifies the South, Bearer of the Staff, and commander of the armies south of the Mian, before being promoted to General Who Pacifies the North and commander of Qing Province military affairs.","literal":"He successively held irregular cavalry yellow-gate gentleman, irregular cavalry attendant, palace library supervisor; went out Pacifying South General credential-bearing supervising Hannan military affairs; promoted Pacifying North General supervising Qing province military affairs."}},{"kind":"source-unit","key":"jinshu:037:s0370","value":{"id":"jinshu:037:s0370","kind":"paragraph-sentence","blockIndex":62,"collection":"sentences","itemIndex":3,"zh":"略逼青州刺史程牧，牧避之，略自領州。","en":"He bullied Cheng Mu aside and seized Qingzhou himself.","literal":"Lue pressured Qing Inspector Cheng Mu until Mu yielded and Lue personally headed the province."}},{"kind":"source-unit","key":"jinshu:037:s0371","value":{"id":"jinshu:037:s0371","kind":"paragraph-sentence","blockIndex":62,"collection":"sentences","itemIndex":4,"zh":"永興初，㡉令劉根起兵東萊，誑惑百姓，眾以萬數，攻略於臨淄，略不能距，走保聊城。","en":"Yongxing opened with Liu Gen's Donglai rising that drove Lue from Linzi to Liaocheng.","literal":"Early Yongxing Magistrate Liu Gen of Yi county raised troops in Donglai deluding commoners tens of thousands strong raiding Lue at Linzi; Lue could not resist and fled defending Liaocheng."}},{"kind":"source-unit","key":"jinshu:037:s0372","value":{"id":"jinshu:037:s0372","kind":"paragraph-sentence","blockIndex":62,"collection":"sentences","itemIndex":5,"zh":"懷帝即位，遷使持節、都督荊州諸軍事、征南大將軍、開府儀同三司。","en":"Huai made him credential-bearing Jing commander with three-dukes parity staff.","literal":"When Emperor Huai ascended Lue was promoted credential-bearing supervisor of Jing military affairs, southern expedition grand marshal with independent headquarters matching Three Lords."}},{"kind":"source-unit","key":"jinshu:037:s0373","value":{"id":"jinshu:037:s0373","kind":"paragraph-sentence","blockIndex":62,"collection":"sentences","itemIndex":6,"zh":"京兆流人王逌與叟人郝洛聚眾數千，屯于冠軍。","en":"Wang You, a displaced person from Jingzhao, and Hao Luo of the Sou people gathered several thousand followers and encamped at Guanjun.","literal":"Wang You, a displaced person from Jingzhao, and Hao Luo of the Sou people gathered several thousand followers and encamped at Guanjun."}},{"kind":"source-unit","key":"jinshu:037:s0374","value":{"id":"jinshu:037:s0374","kind":"paragraph-sentence","blockIndex":62,"collection":"sentences","itemIndex":7,"zh":"略遣參軍崔曠率將軍皮初、張洛等討逌，為逌所譎，戰敗。","en":"Lue sent his military adviser Cui Kuang to lead the generals Pi Chu, Zhang Luo, and others against You, but You deceived them and they were defeated in battle.","literal":"Lue sent his military adviser Cui Kuang to lead the generals Pi Chu, Zhang Luo, and others against You, but You deceived them and they were defeated in battle."}},{"kind":"source-unit","key":"jinshu:037:s0375","value":{"id":"jinshu:037:s0375","kind":"paragraph-sentence","blockIndex":62,"collection":"sentences","itemIndex":8,"zh":"略更遣左司馬曹攄統曠等進逼逌。","en":"Lue then sent Left Sima Cao Shu to lead Kuang and the others in advancing against You.","literal":"Lue then sent Left Sima Cao Shu to lead Kuang and the others in advancing against You."}},{"kind":"source-unit","key":"jinshu:037:s0376","value":{"id":"jinshu:037:s0376","kind":"paragraph-sentence","blockIndex":62,"collection":"sentences","itemIndex":9,"zh":"將大戰，曠在後密自退走，攄軍無繼，戰敗，死之。","en":"As they were about to fight a major battle, Kuang, who was in the rear, secretly withdrew; Shu's army was left without support, was defeated, and Shu died in the fighting.","literal":"As they were about to fight a major battle, Kuang, who was in the rear, secretly withdrew; Shu's army was left without support, was defeated, and Shu died in the fighting."}},{"kind":"source-unit","key":"jinshu:037:s0377","value":{"id":"jinshu:037:s0377","kind":"paragraph-sentence","blockIndex":62,"collection":"sentences","itemIndex":10,"zh":"略乃赦曠罪，復遣部將韓松又督曠攻逌，逌降。","en":"Lue then pardoned Kuang's offense and again sent his subordinate Han Song to lead Kuang against Wang You, who surrendered.","literal":"Lue then pardoned Kuang's offense and again sent his subordinate general Han Song to command Kuang in attacking You; You surrendered."}},{"kind":"source-unit","key":"jinshu:037:s0378","value":{"id":"jinshu:037:s0378","kind":"paragraph-sentence","blockIndex":62,"collection":"sentences","itemIndex":11,"zh":"尋進開府，加散騎常侍。","en":"Soon he was advanced and allowed to establish his own office, with the additional appointment of Regular Mounted Attendant.","literal":"Soon he was advanced and allowed to establish his own office, with the additional appointment of Regular Mounted Attendant."}},{"kind":"source-unit","key":"jinshu:037:s0379","value":{"id":"jinshu:037:s0379","kind":"paragraph-sentence","blockIndex":62,"collection":"sentences","itemIndex":12,"zh":"永嘉三年薨，追贈侍中、太尉，子據立。","en":"He died in the third year of Yongjia and was posthumously granted the offices of Palace Attendant and Grand Commandant; his son Ju succeeded him.","literal":"In the third year of Yongjia, he died and was posthumously granted the offices of Palace Attendant and Grand Commandant; his son Ju succeeded him."}},{"kind":"source-unit","key":"jinshu:037:s0380","value":{"id":"jinshu:037:s0380","kind":"paragraph-sentence","blockIndex":62,"collection":"sentences","itemIndex":13,"zh":"薨，無子，以彭城康王子紘為嗣。","en":"Childless, he passed to Hong from Pengcheng's Kang line.","literal":"He died without sons; Prince Kang of Pengcheng's son Hong was appointed successor."}},{"kind":"source-unit","key":"jinshu:037:s0381","value":{"id":"jinshu:037:s0381","kind":"paragraph-sentence","blockIndex":62,"collection":"sentences","itemIndex":14,"zh":"其後紘歸本宗，立紘子俊以奉其祀。","en":"Hong reverted to his birth house; Jun kept Lue's line alive.","literal":"Later Hong returned to root lineage; Hong's son Jun was established to maintain his sacrifices."}},{"kind":"source-unit","key":"jinshu:053:s0001","value":{"id":"jinshu:053:s0001","kind":"paragraph-sentence","blockIndex":0,"collection":"sentences","itemIndex":0,"zh":"愍懷太子","en":"Crown Prince Minhuai","literal":"Crown Prince Minhuai"}},{"kind":"source-unit","key":"jinshu:053:s0199","value":{"id":"jinshu:053:s0199","kind":"paragraph-sentence","blockIndex":2,"collection":"sentences","itemIndex":0,"zh":"時望氣者言廣陵有天子氣，故封為廣陵王，邑五萬戶。","en":"Astrologers said Guangling bore an emperor's aura, so Yu was made Prince of Guangling with fifty thousand households.","literal":"At the time, observers of celestial portents said Guangling had the aura of a Son of Heaven; therefore he was enfeoffed as Prince of Guangling with a fief of fifty thousand households."}},{"kind":"source-unit","key":"jinshu:053:s0200","value":{"id":"jinshu:053:s0200","kind":"paragraph-sentence","blockIndex":2,"collection":"sentences","itemIndex":1,"zh":"以劉寔為師，孟珩為友，楊准、馮蓀為文學。","en":"Liu Shi served as tutor, Meng Heng as companion, and Yang Zhun and Feng Sun as literary aides.","literal":"Liu Shi was made tutor, Meng Heng companion, and Yang Zhun and Feng Sun literary aides."}},{"kind":"source-unit","key":"jinshu:053:s0201","value":{"id":"jinshu:053:s0201","kind":"paragraph-sentence","blockIndex":2,"collection":"sentences","itemIndex":2,"zh":"惠帝即位，立為皇太子。","en":"When Hui Di took the throne, Yu was made crown prince.","literal":"When Emperor Hui succeeded to the throne, he was established as crown prince."}},{"kind":"source-unit","key":"jinshu:053:s0202","value":{"id":"jinshu:053:s0202","kind":"paragraph-sentence","blockIndex":2,"collection":"sentences","itemIndex":3,"zh":"盛選德望以為師傅，以何劭為太師，王戎為太傅，楊濟為太保，裴楷為少師，張華為少傅，和嶠為少保。","en":"The court recruited eminent tutors—He Shao as Grand Tutor, Wang Rong as Grand Mentor, Yang Ji as Grand Guardian, Pei Kai as Junior Tutor, Zhang Hua as Junior Mentor, and He Qiao as Junior Guardian.","literal":"Worthy men of virtue and repute were abundantly selected as tutors and guardians: He Shao as Grand Tutor, Wang Rong as Grand Mentor, Yang Ji as Grand Guardian, Pei Kai as Junior Tutor, Zhang Hua as Junior Mentor, and He Qiao as Junior Guardian."}},{"kind":"source-unit","key":"jinshu:053:s0203","value":{"id":"jinshu:053:s0203","kind":"paragraph-sentence","blockIndex":2,"collection":"sentences","itemIndex":4,"zh":"元康元年，出就東宮，又詔曰：「遹尚幼蒙，今出東宮，惟當賴師傅群賢之訓。","en":"In Yuankang year one he moved to the Eastern Palace, and an edict declared: \"Yu is still young and inexperienced; now that he has moved to the Eastern Palace he must rely on his tutors and worthy mentors for instruction.","literal":"In the first year of Yuankang he moved out to the Eastern Palace; an edict further said: \"Yu is still young and untutored; now that he is moving out to the Eastern Palace he should rely solely on the instruction of his tutors and the worthy assembly."}},{"kind":"source-unit","key":"jinshu:053:s0204","value":{"id":"jinshu:053:s0204","kind":"paragraph-sentence","blockIndex":2,"collection":"sentences","itemIndex":5,"zh":"其遊處左右，宜得正人使共周旋，能相長益者。」","en":"Those about him in leisure and attendance should be upright men who keep company with him and help one another improve.\"","literal":"Those who attend him in leisure and service should be upright men who may keep company with him and mutually aid one another's growth.\""}},{"kind":"source-unit","key":"jinshu:053:s0205","value":{"id":"jinshu:053:s0205","kind":"paragraph-sentence","blockIndex":2,"collection":"sentences","itemIndex":6,"zh":"於是使太保衛瓘息庭、司空泰息略、太子太傅楊濟息毖、太子少師裴楷息憲、太子少傅張華息禕、尚書令華暠息恆與太子游處，以相輔導焉。","en":"Thereupon Wei Guan's son Ting, Director of Works Tai's son Lue, Yang Ji's son Bi, Pei Kai's son Xian, Zhang Hua's son Yi, and Hua Gao's son Heng were sent to keep company with the crown prince and guide him.","literal":"Thereupon Grand Guardian Wei Guan's son Ting, Director of Works Tai's son Lue, Grand Mentor to the Crown Prince Yang Ji's son Bi, Junior Tutor to the Crown Prince Pei Kai's son Xian, Junior Mentor to the Crown Prince Zhang Hua's son Yi, and Minister Director Hua Gao's son Heng were assigned to keep company with the crown prince and assist in his guidance."}},{"kind":"person-record","key":"jinshu:037:p199","value":{"localId":"jinshu:037:p199","preferredNameSuggestion":{"en":"Hua Heng","zh":"華恆"},"historicity":"historical","descriptorSuggestion":"Official","identityHints":{"nativePlaces":[],"relatedLocalPeople":[],"activeDateHints":[]},"book":"jinshu","chapter":"037","promptVersion":7,"sourceUnitRefs":["jinshu:037:s0368"],"chapterPinRef":"jinshu:037","aliasesAndNameKeys":[{"key":"en:hua heng","language":"en","value":"Hua Heng","kinds":["personal","preferred"],"sources":["jinshu:037:c0608","preferred"],"blocking":true},{"key":"zh:華恆","language":"zh","value":"華恆","kinds":["personal","preferred"],"sources":["jinshu:037:c0608","preferred"],"blocking":true}],"governingBlockRefs":["jinshu:037:block:62"],"currentCanonicalPersonId":"per_DKV34EBDM9ZXT1W4A6MQ","inboundSourceUnitRefs":[],"inboundGoverningBlockRefs":[]}},{"kind":"person-claims","key":"jinshu:037:p199","index":0,"value":{"id":"jinshu:037:c0608","subject":"jinshu:037:p199","predicate":"name","value":{"kind":"personal","en":"Hua Heng","zh":"華恆"},"certainty":"explicit","evidence":["jinshu:037:s0368"]}},{"kind":"person-claims","key":"jinshu:037:p199","index":1,"value":{"id":"jinshu:037:c0609","subject":"jinshu:037:p199","predicate":"role","value":{"roleId":"official"},"certainty":"explicit","evidence":["jinshu:037:s0368"]}},{"kind":"person-claims","key":"jinshu:037:p199","index":2,"value":{"id":"jinshu:037:c2021","subject":"jinshu:037:p199","predicate":"sex","value":{"sex":"male"},"certainty":"strongly-inferred","evidence":["jinshu:037:s0368"]}},{"kind":"person-claims","key":"jinshu:037:p199","index":3,"value":{"id":"jinshu:037:c2022","subject":"jinshu:037:p199","predicate":"attestation","value":{"undatedSourceAttestation":true,"event":"Hua Heng was a companion of Crown Prince Minhuai with Sima Lue."},"certainty":"explicit","evidence":["jinshu:037:s0368"]}},{"kind":"person-mentions","key":"jinshu:037:p199","index":0,"value":{"id":"jinshu:037:m0973","person":"jinshu:037:p199","unit"