  "appliedAfterTexts": [
    {
      "repairId": "jinshu:023:r0001",
      "unit": "s0007",
      "field": "idiomatic",
      "decision": "accept",
      "after": "Bells and chimes hung on all four sides in the courtyard, qin and se on the dais, the eight instrument families alternating in concert—court music and ya ensemble together, antiphonal song above and wind below—each with its prescribed lyrics: the Zhou legacy."
    },
    {
      "repairId": "jinshu:023:r0002",
      "unit": "s0042",
      "field": "idiomatic",
      "decision": "accept",
      "after": "He embraced the lands of the Shen field; his fame knows no end."
    },
    {
      "repairId": "jinshu:023:r0003",
      "unit": "s0077",
      "field": "idiomatic",
      "decision": "accept",
      "after": "Xiaozong, wise from youth, his fine renown long lay hidden."
    },
    {
      "repairId": "jinshu:023:r0004",
      "unit": "s0099",
      "field": "idiomatic",
      "decision": "accept",
      "after": "He matched the pattern of his cultured late father—silent, humble harmony."
    },
    {
      "repairId": "jinshu:023:r0005",
      "unit": "s0137",
      "field": "idiomatic",
      "decision": "accept",
      "after": "《Ascending to the Turn》 became 《Wulin》, when Cao Cao swept downriver after taking Jingzhou and Sun Quan ordered Zhou Yu to meet him at Wulin and drove him back."
    },
    {
      "repairId": "jinshu:023:r0006",
      "unit": "s0168",
      "field": "literal",
      "decision": "accept",
      "after": "They changed 《Yellow Sparrow March》 to 《Bo Yi》, referring to how the red crow bore writing—Zhou rose thereby—and now the sage emperor received the mandate and spirit magpies came."
    },
    {
      "repairId": "jinshu:023:r0007",
      "unit": "s0179",
      "field": "idiomatic",
      "decision": "accept",
      "after": "Like You-Hu of old, he threw the five norms into disorder."
    },
    {
      "repairId": "jinshu:023:r0008",
      "unit": "s0367",
      "field": "idiomatic",
      "decision": "accept",
      "after": "Abdications matched heaven's chronology; sage passed sage."
    },
    {
      "repairId": "jinshu:023:r0009",
      "unit": "s0388",
      "field": "idiomatic",
      "decision": "accept",
      "after": "Bo Yi helped Shun and Yu and ruled hill and stream."
    },
    {
      "repairId": "jinshu:023:r0010",
      "unit": "s0388",
      "field": "literal",
      "decision": "accept",
      "after": "Bo Yi aided Shun and Yu--office grasping mountains and rivers."
    },
    {
      "repairId": "jinshu:023:r0011",
      "unit": "s0375",
      "field": "literal",
      "decision": "accept",
      "after": "In ages past at the court of Tang and Yu--sometimes seen amid cyan clouds."
    },
    {
      "repairId": "jinshu:023:r0012",
      "unit": "s0432",
      "field": "idiomatic",
      "decision": "accept",
      "after": "Emperors Xuan and Wen launched the great enterprise; prime virtue settled in Taishi."
    },
    {
      "repairId": "jinshu:023:r0013",
      "unit": "s0459",
      "field": "idiomatic",
      "decision": "accept",
      "after": "Five Thearchs followed the Three Sovereigns; the Three Sovereigns were ages men admired."
    },
    {
      "repairId": "jinshu:023:r0014",
      "unit": "s0478",
      "field": "idiomatic",
      "decision": "accept",
      "after": "Entrusted with the late ruler's charge, he aligned the seven powers; then Cao Shuang overreached heaven."
    },
    {
      "repairId": "jinshu:023:r0015",
      "unit": "s0505",
      "field": "idiomatic",
      "decision": "accept",
      "after": "August Great Jin; solemn indeed is King Wen."
    },
    {
      "repairId": "jinshu:023:r0016",
      "unit": "s0644",
      "field": "idiomatic",
      "decision": "accept",
      "after": "Zhang Qian entered the Western Regions and brought its method to the Western Capital, but obtained only the 《Mahā-dūra》 tune."
    },
    {
      "repairId": "jinshu:023:r0017",
      "unit": "s0646",
      "field": "idiomatic",
      "decision": "accept",
      "after": "Later Han gave them to frontier commanders; under Emperor He generals commanding ten thousand men were permitted to use them."
    },
    {
      "repairId": "jinshu:023:r0018",
      "unit": "s0692",
      "field": "idiomatic",
      "decision": "accept",
      "after": "In the seventh year of Xiankang under Emperor Cheng, Cai Mo memorialized: \"For the eighth-year Great Audience protocol, only wind-and-drum and bells should be performed; all other entertainments should be omitted.\""
    },
    {
      "repairId": "jinshu:023:r0019",
      "unit": "s0670",
      "field": "idiomatic",
      "decision": "accept",
      "after": "Secretariat Director Wang Min loved his sister-in-law's maid, whom the sister-in-law beat cruelly; the maid sang well and Wang Min liked to hold a white round fan—hence the 《Round Fan》 ballad."
    },
    {
      "repairId": "jinshu:023:r0020",
      "unit": "s0692",
      "field": "literal",
      "decision": "accept",
      "after": "In Emperor Cheng’s seventh Xiankang year, Minister Cai Mo memorialized: “For the eighth-year Great Audience protocol, perform only wind-and-drum bells; omit all remaining entertainments.”"
    }
  ],
  "selfApproval": false,
