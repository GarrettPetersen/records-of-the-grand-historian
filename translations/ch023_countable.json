[
  {
    "id": "s0001",
    "blockIndex": 0,
    "zh": "起旃蒙協洽，盡柔兆敦牂，凡十二年。"
  },
  {
    "id": "s0002",
    "blockIndex": 1,
    "zh": "1夏，益州夷二十四邑、三萬餘人皆反。"
  },
  {
    "id": "s0003",
    "blockIndex": 1,
    "zh": "遣水衡都尉呂辟胡募吏民及發犍為、蜀郡奔命往擊，大破之。"
  },
  {
    "id": "s0004",
    "blockIndex": 1,
    "zh": "----2秋，七月，赦天下。"
  },
  {
    "id": "s0005",
    "blockIndex": 1,
    "zh": "----3大雨，至於十月，渭橋絕。"
  },
  {
    "id": "s0006",
    "blockIndex": 1,
    "zh": "----4武帝初崩，賜諸侯王璽書。"
  },
  {
    "id": "s0007",
    "blockIndex": 1,
    "zh": "燕王旦得書不肯哭，曰：「璽書封小，京師疑有變。"
  },
  {
    "id": "s0008",
    "blockIndex": 1,
    "zh": "」遣幸臣壽西長、孫縱之、王孺等之長安，以問禮儀為名，陰刺候朝廷事。"
  },
  {
    "id": "s0009",
    "blockIndex": 1,
    "zh": "及有詔褒賜旦錢三十萬，益封萬三千戶，旦怒曰：「我當為帝，何賜也！"
  },
  {
    "id": "s0010",
    "blockIndex": 1,
    "zh": "」遂與宗室中山哀王子長、齊孝王孫澤等結謀，詐言以武帝時受詔，得職吏事，修武備，備非常。"
  },
  {
    "id": "s0011",
    "blockIndex": 1,
    "zh": "郎中成軫謂旦曰：「大王失職，獨可起而索，不可坐而得也。"
  },
  {
    "id": "s0012",
    "blockIndex": 1,
    "zh": "大王壹起，國中雖女子皆奮臂隨大王。"
  },
  {
    "id": "s0013",
    "blockIndex": 1,
    "zh": "」旦即與澤謀，為奸書，言：「少帝非武帝子，大臣所共立；"
  },
  {
    "id": "s0014",
    "blockIndex": 1,
    "zh": "天下宜共伐之！"
  },
  {
    "id": "s0015",
    "blockIndex": 1,
    "zh": "」使人傳行郡國以搖動百姓。"
  },
  {
    "id": "s0016",
    "blockIndex": 1,
    "zh": "澤謀歸發兵臨菑，殺青州刺史雋不疑。"
  },
  {
    "id": "s0017",
    "blockIndex": 1,
    "zh": "旦招來郡國奸人，賦斂銅鐵作甲兵，數閱其車騎、材官卒，發民大獵以講士馬，須期日。"
  },
  {
    "id": "s0018",
    "blockIndex": 1,
    "zh": "郎中韓義等數諫旦，旦殺義等凡十五人。"
  },
  {
    "id": "s0019",
    "blockIndex": 1,
    "zh": "會缾侯成知澤等謀，以告雋不疑。"
  },
  {
    "id": "s0020",
    "blockIndex": 1,
    "zh": "八月，不疑收捕澤等以聞。"
  },
  {
    "id": "s0021",
    "blockIndex": 1,
    "zh": "天子遣大鴻臚丞治，連引燕王。"
  },
  {
    "id": "s0022",
    "blockIndex": 1,
    "zh": "有詔，以燕王至親，勿治；"
  },
  {
    "id": "s0023",
    "blockIndex": 1,
    "zh": "而澤等皆伏誅。"
  },
  {
    "id": "s0024",
    "blockIndex": 1,
    "zh": "遷雋不疑為京兆尹。"
  },
  {
    "id": "s0025",
    "blockIndex": 2,
    "zh": "不疑為京兆尹，吏民敬其威信。"
  },
  {
    "id": "s0026",
    "blockIndex": 2,
    "zh": "每行縣、錄囚徒還，其母輒問不疑：「有所平反？"
  },
  {
    "id": "s0027",
    "blockIndex": 2,
    "zh": "活幾何人？"
  },
  {
    "id": "s0028",
    "blockIndex": 2,
    "zh": "」即不疑多有所平反，母喜笑異於他時；"
  },
  {
    "id": "s0029",
    "blockIndex": 2,
    "zh": "或無所出，母怒，為不食。"
  },
  {
    "id": "s0030",
    "blockIndex": 2,
    "zh": "故不疑為吏，嚴而不殘。"
  },
  {
    "id": "s0031",
    "blockIndex": 2,
    "zh": "----5九月，丙子，秺敬侯金日磾薨。"
  },
  {
    "id": "s0032",
    "blockIndex": 2,
    "zh": "初，武帝病，有遺詔，封金日磾為秺侯，上官桀為安陽侯，霍光為博陸侯；"
  },
  {
    "id": "s0033",
    "blockIndex": 2,
    "zh": "皆以前捕反者馬何羅等功封。"
  },
  {
    "id": "s0034",
    "blockIndex": 2,
    "zh": "日磾以帝少，不受封，光等亦不敢受。"
  },
  {
    "id": "s0035",
    "blockIndex": 2,
    "zh": "及日磾病困，光白封，日磾臥受印綬；"
  },
  {
    "id": "s0036",
    "blockIndex": 2,
    "zh": "一日薨。"
  },
  {
    "id": "s0037",
    "blockIndex": 2,
    "zh": "日磾兩子賞、建俱侍中，與帝略同年，共臥起。"
  },
  {
    "id": "s0038",
    "blockIndex": 2,
    "zh": "賞為奉車，建駙馬都尉。"
  },
  {
    "id": "s0039",
    "blockIndex": 2,
    "zh": "及賞嗣侯，佩兩綬，上謂霍將軍曰：「金氏兄弟兩人，不可使俱兩綬邪？"
  },
  {
    "id": "s0040",
    "blockIndex": 2,
    "zh": "」對曰：「賞自嗣父為侯耳。"
  },
  {
    "id": "s0041",
    "blockIndex": 2,
    "zh": "」上笑曰：「侯不在我與將軍乎？"
  },
  {
    "id": "s0042",
    "blockIndex": 2,
    "zh": "」對曰：「先帝之約，有功乃得封侯。"
  },
  {
    "id": "s0043",
    "blockIndex": 2,
    "zh": "」遂止。"
  },
  {
    "id": "s0044",
    "blockIndex": 2,
    "zh": "----6閏月，遣故廷尉王平等五人持節行郡國，舉賢良，問民疾苦、冤、失職者。"
  },
  {
    "id": "s0045",
    "blockIndex": 2,
    "zh": "----7冬，無冰。"
  },
  {
    "id": "s0047",
    "blockIndex": 3,
    "zh": "1春，正月，封大將軍光為博陸侯，左將軍桀為安陽侯。"
  },
  {
    "id": "s0048",
    "blockIndex": 3,
    "zh": "----2或說霍光曰：「將軍不見諸呂之事乎？"
  },
  {
    "id": "s0049",
    "blockIndex": 3,
    "zh": "處伊尹、周公之位，攝政擅權，而背宗室，不與共職，是以天下不信，卒至於滅亡。"
  },
  {
    "id": "s0050",
    "blockIndex": 3,
    "zh": "今將軍當盛位，帝春秋富，宜納宗室，又多與大臣共事，反諸呂道。"
  },
  {
    "id": "s0051",
    "blockIndex": 3,
    "zh": "如是，則可以免患。"
  },
  {
    "id": "s0052",
    "blockIndex": 3,
    "zh": "」光然之，乃擇宗室可用者，遂拜楚元王孫辟疆及宗室劉長樂皆為光祿大夫，辟疆守長樂衛尉。"
  },
  {
    "id": "s0053",
    "blockIndex": 3,
    "zh": "----3三月，遣使者振貸貧民無種、食者。"
  },
  {
    "id": "s0054",
    "blockIndex": 3,
    "zh": "----4秋，八月，詔曰：「往年災害多，今年蠶、麥傷，所振貸種、食勿收責，毋令民出今年田租。"
  },
  {
    "id": "s0055",
    "blockIndex": 3,
    "zh": "」----5初，武帝征伐匈奴，深入窮追，二十餘年，匈奴馬畜孕重墮殰，罷極，苦之。"
  },
  {
    "id": "s0056",
    "blockIndex": 3,
    "zh": "常有欲和親意，未能得。"
  },
  {
    "id": "s0057",
    "blockIndex": 3,
    "zh": "狐鹿孤單于有異母弟為左大都尉，賢，國人鄉之，母閼氏恐單于不立子而立左大都尉也，乃私使殺之。"
  },
  {
    "id": "s0058",
    "blockIndex": 3,
    "zh": "左大都尉同母兄怨，遂不肯復會單于庭。"
  },
  {
    "id": "s0059",
    "blockIndex": 3,
    "zh": "是歲，單于病且死，謂諸貴人：「我子少，不能治國，立弟右谷蠡王。"
  },
  {
    "id": "s0060",
    "blockIndex": 3,
    "zh": "」及單于死，衛律等與顓渠閼氏謀，匿其喪，矯單于令，更立子左谷蠡王為壺衍鞮單于。"
  },
  {
    "id": "s0061",
    "blockIndex": 3,
    "zh": "左賢王、右谷蠡王怨望，率其眾欲南歸漢，恐不能自致，即脅盧屠王，欲與西降烏孫。"
  },
  {
    "id": "s0062",
    "blockIndex": 3,
    "zh": "盧屠王告之單于，使人驗問，右谷蠡王不服，反以其罪罪盧屠王，國人皆冤之。"
  },
  {
    "id": "s0063",
    "blockIndex": 3,
    "zh": "於是二王去居其所，不復肯會龍城，匈奴始衰。"
  },
  {
    "id": "s0065",
    "blockIndex": 4,
    "zh": "1春，二月，有星孛於西北。"
  },
  {
    "id": "s0066",
    "blockIndex": 4,
    "zh": "----2冬，十一月，壬辰朔，日有食之。"
  },
  {
    "id": "s0067",
    "blockIndex": 4,
    "zh": "----3初，霍光與上官桀相親善。"
  },
  {
    "id": "s0068",
    "blockIndex": 4,
    "zh": "光每休沐出，桀常代光入決事。"
  },
  {
    "id": "s0069",
    "blockIndex": 4,
    "zh": "光女為桀子安妻，生女，年甫五歲，安欲因光內之宮中；"
  },
  {
    "id": "s0070",
    "blockIndex": 4,
    "zh": "光以為尚幼，不聽。"
  },
  {
    "id": "s0071",
    "blockIndex": 4,
    "zh": "蓋長公主私近子客河間丁外人，安素與外人善，說外人曰：「安子容貌端正，誠因長主時得入為-{后}-，以臣父子在朝而有椒房之重，成之在於足下。"
  },
  {
    "id": "s0072",
    "blockIndex": 4,
    "zh": "漢家故事，常以列侯尚主，足下何憂不封侯乎！"
  },
  {
    "id": "s0073",
    "blockIndex": 4,
    "zh": "」外人喜，言於長主。"
  },
  {
    "id": "s0074",
    "blockIndex": 4,
    "zh": "長主以為然，詔召安女入為倢伃，安為騎都尉。"
  },
  {
    "id": "s0076",
    "blockIndex": 5,
    "zh": "1春，三月，甲寅，立皇后上官氏，赦天下。"
  },
  {
    "id": "s0077",
    "blockIndex": 5,
    "zh": "----2西南夷姑繒、葉榆復反，遣水衡都尉呂辟胡將益州兵擊之。"
  },
  {
    "id": "s0078",
    "blockIndex": 5,
    "zh": "辟胡不進，蠻夷遂殺益州太守，乘勝與辟胡戰，士戰及溺死者四千餘人。"
  },
  {
    "id": "s0079",
    "blockIndex": 5,
    "zh": "冬，遣大鴻臚田廣明擊之。"
  },
  {
    "id": "s0080",
    "blockIndex": 5,
    "zh": "----3廷尉李種坐故縱死罪棄市。"
  },
  {
    "id": "s0081",
    "blockIndex": 5,
    "zh": "----4是歲，上官安為車騎將軍。"
  },
  {
    "id": "s0083",
    "blockIndex": 6,
    "zh": "1春，正月，追尊帝外祖趙父為順成侯。"
  },
  {
    "id": "s0084",
    "blockIndex": 6,
    "zh": "順成侯有姊君姁，賜錢二百萬、奴婢、第宅以充實焉。"
  },
  {
    "id": "s0085",
    "blockIndex": 6,
    "zh": "諸昆弟各以親疏受賞賜，無在位者。"
  },
  {
    "id": "s0086",
    "blockIndex": 6,
    "zh": "----2有男子乘黃犢車詣北闕，自謂衛太子；"
  },
  {
    "id": "s0087",
    "blockIndex": 6,
    "zh": "公車以聞。"
  },
  {
    "id": "s0088",
    "blockIndex": 6,
    "zh": "詔使公、卿、將軍、中二千石雜識視。"
  },
  {
    "id": "s0089",
    "blockIndex": 6,
    "zh": "長安中吏民聚觀者數萬人。"
  },
  {
    "id": "s0090",
    "blockIndex": 6,
    "zh": "右將軍勒兵闕下以備非常。"
  },
  {
    "id": "s0091",
    "blockIndex": 6,
    "zh": "丞相、御史、中二千石至者並莫敢發言。"
  },
  {
    "id": "s0092",
    "blockIndex": 6,
    "zh": "京兆尹不疑後到，叱從吏收縛。"
  },
  {
    "id": "s0093",
    "blockIndex": 6,
    "zh": "或曰：「是非未可知，且安之。"
  },
  {
    "id": "s0094",
    "blockIndex": 6,
    "zh": "」不疑曰：「諸君何患於衛太子！"
  },
  {
    "id": "s0095",
    "blockIndex": 6,
    "zh": "昔蒯聵違命出奔，輒距而不納，《春秋》是之。"
  },
  {
    "id": "s0096",
    "blockIndex": 6,
    "zh": "衛太子得罪先帝，亡不即死，今來自詣，此罪人也！"
  },
  {
    "id": "s0097",
    "blockIndex": 6,
    "zh": "」遂送詔獄。"
  },
  {
    "id": "s0098",
    "blockIndex": 6,
    "zh": "天子與大將軍霍光聞而嘉之曰：「公卿大臣當用有經術、明於大誼者。"
  },
  {
    "id": "s0099",
    "blockIndex": 6,
    "zh": "」繇是不疑名聲重於朝廷，在位者皆自以不及也。"
  },
  {
    "id": "s0100",
    "blockIndex": 6,
    "zh": "廷尉驗治何人，竟得奸詐，本夏陽人，姓成，名方遂，居湖，以卜筮為事。"
  },
  {
    "id": "s0101",
    "blockIndex": 6,
    "zh": "有故太子舍人嘗從方遂卜，謂曰：「子狀貌甚似衛太子。"
  },
  {
    "id": "s0102",
    "blockIndex": 6,
    "zh": "」方遂心利其言，冀得以富貴。"
  },
  {
    "id": "s0103",
    "blockIndex": 6,
    "zh": "坐誣罔不道，要斬。"
  },
  {
    "id": "s0104",
    "blockIndex": 6,
    "zh": "----3夏，六月，封上官安為桑樂侯。"
  },
  {
    "id": "s0105",
    "blockIndex": 6,
    "zh": "安日以驕淫，受賜殿中，對賓客言：「與我婿飲，大樂！"
  },
  {
    "id": "s0106",
    "blockIndex": 6,
    "zh": "」見其服飾，使人歸，欲自燒物。"
  },
  {
    "id": "s0107",
    "blockIndex": 6,
    "zh": "子病死，仰而罵天。"
  },
  {
    "id": "s0108",
    "blockIndex": 6,
    "zh": "其頑悖如此。"
  },
  {
    "id": "s0109",
    "blockIndex": 6,
    "zh": "----4罷儋耳、真番郡。"
  },
  {
    "id": "s0110",
    "blockIndex": 6,
    "zh": "----5秋，大鴻臚廣明、軍正王平擊益州，斬首、捕虜三萬餘人，獲畜產五萬餘頭。"
  },
  {
    "id": "s0111",
    "blockIndex": 6,
    "zh": "----6諫大夫杜延年見國家承武帝奢侈、師旅之後，數為大將軍光言：「年歲比不登，流民未盡還，宜修孝文時政，示以儉約、寬和，順天心，說民意，年歲宜應。"
  },
  {
    "id": "s0112",
    "blockIndex": 6,
    "zh": "」光納其言。"
  },
  {
    "id": "s0113",
    "blockIndex": 6,
    "zh": "延年，故御史大夫周之子也。"
  },
  {
    "id": "s0115",
    "blockIndex": 7,
    "zh": "1春，二月，詔有司問郡國所舉賢良、文學，民所疾苦、教化之要，皆對：「願罷鹽、鐵、酒榷、均輸官，毋與天下爭利，示以儉節，然後教化可興。"
  },
  {
    "id": "s0116",
    "blockIndex": 7,
    "zh": "」桑弘羊難，以為：「此國家大業，所以制四夷，安邊足用之本，不可廢也。"
  },
  {
    "id": "s0117",
    "blockIndex": 7,
    "zh": "」於是鹽鐵之議起焉。"
  },
  {
    "id": "s0118",
    "blockIndex": 7,
    "zh": "----2初，蘇武既徙北海上，稟食不至，掘野鼠、去草實而食之。"
  },
  {
    "id": "s0119",
    "blockIndex": 7,
    "zh": "杖漢節牧羊，臥起操持，節旄盡落。"
  },
  {
    "id": "s0120",
    "blockIndex": 7,
    "zh": "武在漢，與李陵俱為侍中；"
  },
  {
    "id": "s0121",
    "blockIndex": 7,
    "zh": "陵降匈奴，不敢求武。"
  },
  {
    "id": "s0122",
    "blockIndex": 7,
    "zh": "久之，單于使陵至海上，為武置酒設樂，因謂武曰：「單于聞陵與子卿素厚，故使來說足下，虛心欲相待，終不得歸漢，空自苦；"
  },
  {
    "id": "s0123",
    "blockIndex": 7,
    "zh": "亡人之地，信義安所見乎！"
  },
  {
    "id": "s0124",
    "blockIndex": 7,
    "zh": "足下兄弟二人，前皆坐事自殺；"
  },
  {
    "id": "s0125",
    "blockIndex": 7,
    "zh": "來時，太夫人已不幸；"
  },
  {
    "id": "s0126",
    "blockIndex": 7,
    "zh": "子卿婦年少，聞已更嫁矣；"
  },
  {
    "id": "s0127",
    "blockIndex": 7,
    "zh": "獨有女弟二人、兩女、一男，今復十餘年，存亡不可知。"
  },
  {
    "id": "s0128",
    "blockIndex": 7,
    "zh": "人生如朝露，何久自苦如此！"
  },
  {
    "id": "s0129",
    "blockIndex": 7,
    "zh": "陵始降時，忽忽如狂，自痛負漢，加以老母系保宮。"
  },
  {
    "id": "s0130",
    "blockIndex": 7,
    "zh": "子卿不欲降，何以過陵！"
  },
  {
    "id": "s0131",
    "blockIndex": 7,
    "zh": "且陛下春秋高，法令無常，大臣無罪夷滅者數十家。"
  },
  {
    "id": "s0132",
    "blockIndex": 7,
    "zh": "安危不可知，子卿尚復誰為乎！"
  },
  {
    "id": "s0133",
    "blockIndex": 7,
    "zh": "」武曰：「武父子無功德，皆為陛下所成就，位列將，爵通侯，兄弟親近，常願肝腦塗地。"
  },
  {
    "id": "s0134",
    "blockIndex": 7,
    "zh": "今得殺身自效，雖斧鉞、湯鑊，誠甘樂之！"
  },
  {
    "id": "s0135",
    "blockIndex": 7,
    "zh": "臣事君，猶子事父也。"
  },
  {
    "id": "s0136",
    "blockIndex": 7,
    "zh": "子為父死，無所恨。"
  },
  {
    "id": "s0137",
    "blockIndex": 7,
    "zh": "願勿復再言！"
  },
  {
    "id": "s0138",
    "blockIndex": 7,
    "zh": "」陵與武飲數日，復曰：「子卿壹聽陵言！"
  },
  {
    "id": "s0139",
    "blockIndex": 7,
    "zh": "」武曰：「自分已死久矣，王必欲降武，請畢今日之歡，效死於前！"
  },
  {
    "id": "s0140",
    "blockIndex": 7,
    "zh": "」陵見其至誠，喟然歎曰：「嗟乎，義士！"
  },
  {
    "id": "s0141",
    "blockIndex": 7,
    "zh": "陵與衛律之罪上通於天！"
  },
  {
    "id": "s0142",
    "blockIndex": 7,
    "zh": "」因泣下沾衿，與武決去。"
  },
  {
    "id": "s0143",
    "blockIndex": 7,
    "zh": "賜武牛羊數十頭。"
  },
  {
    "id": "s0144",
    "blockIndex": 8,
    "zh": "後陵復至北海上，語武以武帝崩。"
  },
  {
    "id": "s0145",
    "blockIndex": 8,
    "zh": "武南鄉號哭歐血，旦夕臨，數月。"
  },
  {
    "id": "s0146",
    "blockIndex": 8,
    "zh": "及壺衍鞮單于立，母閼氏不正，國內乖離，常恐漢兵襲之，於是衛律為單于謀，與漢和親。"
  },
  {
    "id": "s0147",
    "blockIndex": 8,
    "zh": "漢使至，求蘇武等，匈奴詭言武死。"
  },
  {
    "id": "s0148",
    "blockIndex": 8,
    "zh": "後漢使復至匈奴，常惠私見漢使，教使者謂單于，言：「天子射上林中，得雁，足有系帛書，言武等在某澤中。"
  },
  {
    "id": "s0149",
    "blockIndex": 8,
    "zh": "」使者大喜，如惠語以讓單于。"
  },
  {
    "id": "s0150",
    "blockIndex": 8,
    "zh": "單于視左右而驚，謝漢使曰：「武等實在。"
  },
  {
    "id": "s0151",
    "blockIndex": 8,
    "zh": "」乃歸武及馬宏等。"
  },
  {
    "id": "s0152",
    "blockIndex": 8,
    "zh": "馬宏者，前副光祿大夫王忠使西國，為匈奴所遮；"
  },
  {
    "id": "s0153",
    "blockIndex": 8,
    "zh": "忠戰死，馬宏生得，亦不肯降。"
  },
  {
    "id": "s0154",
    "blockIndex": 8,
    "zh": "故匈奴歸此二人，欲以通善意。"
  },
  {
    "id": "s0155",
    "blockIndex": 8,
    "zh": "於是李陵置酒賀武曰：「今足下還歸，揚名於匈奴，功顯於漢室，雖古竹帛所載，丹青所畫，何以過子卿！"
  },
  {
    "id": "s0156",
    "blockIndex": 8,
    "zh": "陵雖駑怯，令漢貰陵罪，全其老母，使得奮大辱之積志，庶幾乎曹柯之盟，此陵宿昔之所不忘也。"
  },
  {
    "id": "s0157",
    "blockIndex": 8,
    "zh": "收族陵家，為世大戮，陵尚復何顧乎！"
  },
  {
    "id": "s0158",
    "blockIndex": 8,
    "zh": "已矣，令子卿知吾心耳！"
  },
  {
    "id": "s0159",
    "blockIndex": 8,
    "zh": "」陵泣下數行，因與武決。"
  },
  {
    "id": "s0160",
    "blockIndex": 9,
    "zh": "單于召會武官屬，前已降及物故，凡隨武還者九人。"
  },
  {
    "id": "s0161",
    "blockIndex": 9,
    "zh": "既至京師，詔武奉一太牢謁武帝園廟，拜為典屬國，秩中二千石，賜錢二百萬，公田二頃，宅一區。"
  },
  {
    "id": "s0162",
    "blockIndex": 9,
    "zh": "武留匈奴凡十九歲，始以強壯出，及還，鬚髮盡白。"
  },
  {
    "id": "s0163",
    "blockIndex": 9,
    "zh": "霍光、上官桀與李陵素善，遣陵故人隴西任立政等三人俱至匈奴招之。"
  },
  {
    "id": "s0164",
    "blockIndex": 9,
    "zh": "陵曰：「歸易耳，丈夫不能再辱！"
  },
  {
    "id": "s0165",
    "blockIndex": 9,
    "zh": "」遂死於匈奴。"
  },
  {
    "id": "s0166",
    "blockIndex": 9,
    "zh": "----3夏，旱。"
  },
  {
    "id": "s0167",
    "blockIndex": 9,
    "zh": "----4秋，七月，罷榷酤官，從賢良、文學之議也。"
  },
  {
    "id": "s0168",
    "blockIndex": 9,
    "zh": "武帝之末，海內虛耗，戶口減半，霍光知時務之要，輕徭薄賦，與民休息。"
  },
  {
    "id": "s0169",
    "blockIndex": 9,
    "zh": "至是匈奴和親，百姓充實，稍復文、景之業焉。"
  },
  {
    "id": "s0170",
    "blockIndex": 9,
    "zh": "----5詔以鉤町侯毋波率其邑君長、人民擊反者有功，立以為鉤町王。"
  },
  {
    "id": "s0171",
    "blockIndex": 9,
    "zh": "賜田廣明爵關內侯。"
  },
  {
    "id": "s0173",
    "blockIndex": 10,
    "zh": "1春，武都氐人反，遣執金吾馬適建、龍額侯韓增、大鴻臚田廣明將三輔、太常徒，皆免刑，擊之。"
  },
  {
    "id": "s0174",
    "blockIndex": 10,
    "zh": "----2夏，六月，赦天下。"
  },
  {
    "id": "s0175",
    "blockIndex": 10,
    "zh": "----3秋，七月，乙亥晦，日有食之，既。"
  },
  {
    "id": "s0176",
    "blockIndex": 10,
    "zh": "----4八月，改元。"
  },
  {
    "id": "s0177",
    "blockIndex": 10,
    "zh": "----5上官桀父子既尊，盛德長公主，欲為丁外人求封侯，霍光不許。"
  },
  {
    "id": "s0178",
    "blockIndex": 10,
    "zh": "又為外人求光祿大夫，欲令得召見，又不許。"
  },
  {
    "id": "s0179",
    "blockIndex": 10,
    "zh": "長主大以是怨光，而桀、安數為外人求官爵弗能得，亦慚。"
  },
  {
    "id": "s0180",
    "blockIndex": 10,
    "zh": "又桀妻父所幸充國為太醫監，闌入殿中，下獄當死；"
  },
  {
    "id": "s0181",
    "blockIndex": 10,
    "zh": "冬月且盡，蓋主為充國入馬二十匹贖罪，乃得減死論。"
  },
  {
    "id": "s0182",
    "blockIndex": 10,
    "zh": "於是桀、安父子深怨光而重德蓋主。"
  },
  {
    "id": "s0183",
    "blockIndex": 10,
    "zh": "自先帝時，桀已為九卿，位在光右，及父子並為將軍，皇后親安女，光乃其外祖，而顧專制朝事，由是與光爭權。"
  },
  {
    "id": "s0184",
    "blockIndex": 10,
    "zh": "燕王旦自以帝兄不得立，常懷怨望。"
  },
  {
    "id": "s0185",
    "blockIndex": 10,
    "zh": "及御史大夫桑弘羊建造酒榷、鹽、鐵，為國興利，伐其功，欲為子弟得官，亦怨恨光。"
  },
  {
    "id": "s0186",
    "blockIndex": 10,
    "zh": "於是蓋主、桀、安、弘羊皆與旦通謀。"
  },
  {
    "id": "s0187",
    "blockIndex": 11,
    "zh": "旦遣孫縱之等前後十餘輩，多賫金寶、走馬賂遺蓋主、桀、弘羊等。"
  },
  {
    "id": "s0188",
    "blockIndex": 11,
    "zh": "桀等又詐令人為燕王上書，言：「光出都肄郎、羽林，道上稱蹕，太官先置。"
  },
  {
    "id": "s0189",
    "blockIndex": 11,
    "zh": "」又引「蘇武使匈奴二十年不降，乃為典屬國；"
  },
  {
    "id": "s0190",
    "blockIndex": 11,
    "zh": "大將軍長史敞無功，為搜粟都尉；"
  },
  {
    "id": "s0191",
    "blockIndex": 11,
    "zh": "又擅調益莫府校尉。"
  },
  {
    "id": "s0192",
    "blockIndex": 11,
    "zh": "光專權自恣，疑有非常。"
  },
  {
    "id": "s0193",
    "blockIndex": 11,
    "zh": "臣旦願歸符璽，入宿衛，察奸臣變。"
  },
  {
    "id": "s0194",
    "blockIndex": 11,
    "zh": "」候司光出沐日奏之，桀欲從中下其事，弘羊當與諸大臣共執退光。"
  },
  {
    "id": "s0195",
    "blockIndex": 11,
    "zh": "書奏，帝不肯下。"
  },
  {
    "id": "s0196",
    "blockIndex": 11,
    "zh": "明旦，光聞之，止畫室中不入。"
  },
  {
    "id": "s0197",
    "blockIndex": 11,
    "zh": "上問：「大將軍安在？"
  },
  {
    "id": "s0198",
    "blockIndex": 11,
    "zh": "」左將軍桀對曰：「以燕王告其罪，故不敢入。"
  },
  {
    "id": "s0199",
    "blockIndex": 11,
    "zh": "」有詔：「召大將軍。"
  },
  {
    "id": "s0200",
    "blockIndex": 11,
    "zh": "」光入，免冠、頓首謝。"
  },
  {
    "id": "s0201",
    "blockIndex": 11,
    "zh": "上曰：「將軍冠！"
  },
  {
    "id": "s0202",
    "blockIndex": 11,
    "zh": "朕知是書詐也，將軍無罪。"
  },
  {
    "id": "s0203",
    "blockIndex": 11,
    "zh": "」光曰：「陛下何以知之？"
  },
  {
    "id": "s0204",
    "blockIndex": 11,
    "zh": "」上曰：「將軍之廣明都郎，近耳；"
  },
  {
    "id": "s0205",
    "blockIndex": 11,
    "zh": "調校尉以來，未能十日，燕王何以得知之！"
  },
  {
    "id": "s0206",
    "blockIndex": 11,
    "zh": "且將軍為非，不須校尉。"
  },
  {
    "id": "s0207",
    "blockIndex": 11,
    "zh": "」是時帝年十四，尚書、左右皆驚。"
  },
  {
    "id": "s0208",
    "blockIndex": 11,
    "zh": "而上書者果亡，捕之甚急。"
  },
  {
    "id": "s0209",
    "blockIndex": 11,
    "zh": "桀等懼，白上：「小事不足遂。"
  },
  {
    "id": "s0210",
    "blockIndex": 11,
    "zh": "」上不聽。"
  },
  {
    "id": "s0211",
    "blockIndex": 11,
    "zh": "後桀黨與有譖光者，上輒怒曰：「大將軍忠臣，先帝所屬以輔朕身，敢有毀者坐之！"
  },
  {
    "id": "s0212",
    "blockIndex": 11,
    "zh": "」自是桀等不敢復言。"
  },
  {
    "id": "s0213",
    "blockIndex": 12,
    "zh": ":李德裕論曰：人君之德，莫大於至明，明以照奸，則百邪不能蔽矣。"
  },
  {
    "id": "s0214",
    "blockIndex": 12,
    "zh": "漢昭帝是也。"
  },
  {
    "id": "s0215",
    "blockIndex": 12,
    "zh": "周成王有慚德矣；"
  },
  {
    "id": "s0216",
    "blockIndex": 12,
    "zh": "高祖、文、景俱不如也。"
  },
  {
    "id": "s0217",
    "blockIndex": 12,
    "zh": "成王聞管、蔡流言，遂使周公狼跋而東。"
  },
  {
    "id": "s0218",
    "blockIndex": 12,
    "zh": "漢高聞陳平去魏背楚，欲捨腹心臣。"
  },
  {
    "id": "s0219",
    "blockIndex": 12,
    "zh": "漢文惑季布使酒難近，罷歸股肱郡；"
  },
  {
    "id": "s0220",
    "blockIndex": 12,
    "zh": "疑賈生擅權紛亂，復疏賢士。"
  },
  {
    "id": "s0221",
    "blockIndex": 12,
    "zh": "景帝信誅晁錯兵解，遂戮三公。"
  },
  {
    "id": "s0222",
    "blockIndex": 12,
    "zh": "所謂「執狐疑之心，來讒賊之口」。"
  },
  {
    "id": "s0223",
    "blockIndex": 12,
    "zh": "使昭帝得伊、呂之佐，則成、康不足侔矣。"
  },
  {
    "id": "s0224",
    "blockIndex": 12,
    "zh": "----6桀等謀令長公主置酒請光，伏兵格殺之，因廢帝，迎立燕王為天子。"
  },
  {
    "id": "s0225",
    "blockIndex": 12,
    "zh": "旦置驛書往來相報，許立桀為王，外連郡國豪桀以千數。"
  },
  {
    "id": "s0226",
    "blockIndex": 12,
    "zh": "旦以語相平，平曰：「大王前與劉澤結謀，事未成而發覺者，以劉澤素誇，好侵陵也。"
  },
  {
    "id": "s0227",
    "blockIndex": 12,
    "zh": "平聞左將軍素輕易，車騎將軍少而驕，臣恐其如劉澤時不能成，又恐既成反大王也。"
  },
  {
    "id": "s0228",
    "blockIndex": 12,
    "zh": "」旦曰：「前日一男子詣闕，自謂故太子，長安中民趣鄉之，正讙不可止。"
  },
  {
    "id": "s0229",
    "blockIndex": 12,
    "zh": "大將軍恐，出兵陳之，以自備耳。"
  },
  {
    "id": "s0230",
    "blockIndex": 12,
    "zh": "我，帝長子，天下所信，何憂見反！"
  },
  {
    "id": "s0231",
    "blockIndex": 12,
    "zh": "」後謂群臣：「蓋主報言，獨患大將軍與右將軍王莽。"
  },
  {
    "id": "s0232",
    "blockIndex": 12,
    "zh": "今右將軍物故，丞相病，幸事必成，征不久。"
  },
  {
    "id": "s0233",
    "blockIndex": 12,
    "zh": "」令群臣皆裝。"
  },
  {
    "id": "s0234",
    "blockIndex": 13,
    "zh": "安又謀誘燕王至而誅之，因廢帝而立桀。"
  },
  {
    "id": "s0235",
    "blockIndex": 13,
    "zh": "或曰：「當如皇后何？"
  },
  {
    "id": "s0236",
    "blockIndex": 13,
    "zh": "」安曰：「逐麋之狗，當顧菟邪！"
  },
  {
    "id": "s0237",
    "blockIndex": 13,
    "zh": "且用皇后為尊，一旦人主意有所移，雖欲為家人亦不可得。"
  },
  {
    "id": "s0238",
    "blockIndex": 13,
    "zh": "此百世之一時也！"
  },
  {
    "id": "s0239",
    "blockIndex": 13,
    "zh": "」會蓋主舍人父稻田使者燕倉知其謀，以告大司農楊敞。"
  },
  {
    "id": "s0240",
    "blockIndex": 13,
    "zh": "敞素謹，畏事，不敢言，乃移病臥，以告諫大夫杜延年；"
  },
  {
    "id": "s0241",
    "blockIndex": 13,
    "zh": "延年以聞。"
  },
  {
    "id": "s0242",
    "blockIndex": 13,
    "zh": "九月，詔丞相部中二千石逐捕孫縱之及桀、安、弘羊、外人等，並宗族悉誅之；"
  },
  {
    "id": "s0243",
    "blockIndex": 13,
    "zh": "蓋主自殺。"
  },
  {
    "id": "s0244",
    "blockIndex": 13,
    "zh": "燕王旦聞之，召相平曰：「事敗，遂發兵乎？"
  },
  {
    "id": "s0245",
    "blockIndex": 13,
    "zh": "」平曰：「左將軍已死，百姓皆知之，不可發也。"
  },
  {
    "id": "s0246",
    "blockIndex": 13,
    "zh": "」王憂懣，置酒與群臣、妃妾別。"
  },
  {
    "id": "s0247",
    "blockIndex": 13,
    "zh": "會天子以璽書讓旦，旦以綬自絞死，-{后}-、夫人隨旦自殺者二十餘人。"
  },
  {
    "id": "s0248",
    "blockIndex": 13,
    "zh": "天子加恩，赦王太子建為庶人，賜量謚曰剌王。"
  },
  {
    "id": "s0249",
    "blockIndex": 13,
    "zh": "皇后以年少，不與謀，亦霍光外孫，故得不廢。"
  },
  {
    "id": "s0250",
    "blockIndex": 13,
    "zh": "----7庚午，右扶風王訢為御史大夫。"
  },
  {
    "id": "s0251",
    "blockIndex": 13,
    "zh": "----8冬，十月，封杜延年為建平侯；"
  },
  {
    "id": "s0252",
    "blockIndex": 13,
    "zh": "燕倉為宜城侯；"
  },
  {
    "id": "s0253",
    "blockIndex": 13,
    "zh": "故丞相征事任宮捕得桀，為弋陽侯；"
  },
  {
    "id": "s0254",
    "blockIndex": 13,
    "zh": "丞相少史王山壽誘安入府，為商利侯。"
  },
  {
    "id": "s0255",
    "blockIndex": 13,
    "zh": "久之，文學濟陰魏相對策，以為：「日者燕王為無道，韓義出身強諫，為王所殺。"
  },
  {
    "id": "s0256",
    "blockIndex": 13,
    "zh": "義無比干之親而蹈比干之節，宜顯賞其子以示天下，明為人臣之義。"
  },
  {
    "id": "s0257",
    "blockIndex": 13,
    "zh": "」乃擢義子延壽為諫大夫。"
  },
  {
    "id": "s0258",
    "blockIndex": 13,
    "zh": "----9大將軍光以朝無舊臣，光祿勳張安世自先帝時為尚書令，志行純篤，乃白用安世為右將軍兼光祿勳以自副焉。"
  },
  {
    "id": "s0259",
    "blockIndex": 13,
    "zh": "安世，故御史大夫湯之子也。"
  },
  {
    "id": "s0260",
    "blockIndex": 13,
    "zh": "光又以杜延年有忠節，擢為太僕、右曹、給事中。"
  },
  {
    "id": "s0261",
    "blockIndex": 13,
    "zh": "光持刑罰嚴，延年常輔之以寬。"
  },
  {
    "id": "s0262",
    "blockIndex": 13,
    "zh": "吏民上書言便宜，輒下延年平處復奏。"
  },
  {
    "id": "s0263",
    "blockIndex": 13,
    "zh": "言可官試者，至為縣令；"
  },
  {
    "id": "s0264",
    "blockIndex": 13,
    "zh": "或丞相、御史除用，滿歲，以狀聞；"
  },
  {
    "id": "s0265",
    "blockIndex": 13,
    "zh": "或抵其罪法。"
  },
  {
    "id": "s0266",
    "blockIndex": 13,
    "zh": "----10是歲匈奴發左、右部二萬騎為四隊，並入邊為寇。"
  },
  {
    "id": "s0267",
    "blockIndex": 13,
    "zh": "漢兵追之，斬首、獲虜九千人，生得甌脫王；"
  },
  {
    "id": "s0268",
    "blockIndex": 13,
    "zh": "漢無所失亡。"
  },
  {
    "id": "s0269",
    "blockIndex": 13,
    "zh": "匈奴見甌脫王在漢，恐，以為道擊之，即西北遠去，不敢南逐水草；"
  },
  {
    "id": "s0270",
    "blockIndex": 13,
    "zh": "發人民屯甌脫。"
  },
  {
    "id": "s0272",
    "blockIndex": 14,
    "zh": "1夏，四月，上自建章宮徙未央宮。"
  },
  {
    "id": "s0273",
    "blockIndex": 14,
    "zh": "----2六月，赦天下。"
  },
  {
    "id": "s0274",
    "blockIndex": 14,
    "zh": "----3是歲，匈奴復遣九千騎屯受降城以備漢，北橋余吾水，令可度，以備奔走；"
  },
  {
    "id": "s0275",
    "blockIndex": 14,
    "zh": "欲求和親，而恐漢不聽，故不肯先言，常使左右風漢使者。"
  },
  {
    "id": "s0276",
    "blockIndex": 14,
    "zh": "然其侵盜益希，遇漢使愈厚，欲以漸致和親。"
  },
  {
    "id": "s0277",
    "blockIndex": 14,
    "zh": "漢亦羈縻之。"
  },
  {
    "id": "s0279",
    "blockIndex": 15,
    "zh": "1春，正月，泰山有大石自起立；"
  },
  {
    "id": "s0280",
    "blockIndex": 15,
    "zh": "上林有柳樹枯僵自起生；"
  },
  {
    "id": "s0281",
    "blockIndex": 15,
    "zh": "有蟲食其葉成文，曰「公孫病已立」。"
  },
  {
    "id": "s0282",
    "blockIndex": 15,
    "zh": "符節令魯國眭弘上書，言：「大石自立，僵柳復起，當有匹庶為天子者。"
  },
  {
    "id": "s0283",
    "blockIndex": 15,
    "zh": "枯樹復生，故廢之家公孫氏當復興乎？"
  },
  {
    "id": "s0284",
    "blockIndex": 15,
    "zh": "漢家承堯之後，有傳國之運，當求賢人禪帝位，退自封百里，以順天命。"
  },
  {
    "id": "s0285",
    "blockIndex": 15,
    "zh": "」弘坐設妖言惑眾伏誅。"
  },
  {
    "id": "s0286",
    "blockIndex": 15,
    "zh": "----2匈奴單于使犁汙王窺邊，言酒泉、張掖兵益弱，出兵試擊，冀可復得其地。"
  },
  {
    "id": "s0287",
    "blockIndex": 15,
    "zh": "時漢先得降者，聞其計，天子詔邊警備。"
  },
  {
    "id": "s0288",
    "blockIndex": 15,
    "zh": "後無幾，右賢王、犁汙王四千騎分三隊，入日勒、屋蘭、番和。"
  },
  {
    "id": "s0289",
    "blockIndex": 15,
    "zh": "張掖太守、屬國都尉發兵擊，大破之，得脫者數百人。"
  },
  {
    "id": "s0290",
    "blockIndex": 15,
    "zh": "屬國義渠王射殺犁汙王，賜黃金二百斤，馬二百匹，因封為犁汙王。"
  },
  {
    "id": "s0291",
    "blockIndex": 15,
    "zh": "自是後，匈奴不敢入張掖。"
  },
  {
    "id": "s0292",
    "blockIndex": 15,
    "zh": "----3燕、蓋之亂，桑弘羊子遷亡，過父故吏侯史吳，後遷捕得，伏法。"
  },
  {
    "id": "s0293",
    "blockIndex": 15,
    "zh": "會赦，侯史吳自出繫獄。"
  },
  {
    "id": "s0294",
    "blockIndex": 15,
    "zh": "廷尉王平、少府徐仁雜治反事，皆以為「桑遷坐父謀反而侯史吳臧之，非匿反者，乃匿為隨者也」，即以赦令除吳罪。"
  },
  {
    "id": "s0295",
    "blockIndex": 15,
    "zh": "後侍御史治實，以「桑遷通經術，知父謀反而不諫爭，與反者身無異。"
  },
  {
    "id": "s0296",
    "blockIndex": 15,
    "zh": "侯史吳故三百石吏，首匿遷，不與庶人匿隨從者等，吳不得赦。"
  },
  {
    "id": "s0297",
    "blockIndex": 15,
    "zh": "」奏請覆治，劾廷尉、少府縱反者。"
  },
  {
    "id": "s0298",
    "blockIndex": 15,
    "zh": "少府徐仁，即丞相車千秋女婿也，故千秋數為侯史吳言；"
  },
  {
    "id": "s0299",
    "blockIndex": 15,
    "zh": "恐大將軍光不聽，千秋即召中二千石、博士會公車門，議問吳法。"
  },
  {
    "id": "s0300",
    "blockIndex": 15,
    "zh": "議者知大將軍指，皆執吳為不道。"
  },
  {
    "id": "s0301",
    "blockIndex": 15,
    "zh": "明日，千秋封上眾議。"
  },
  {
    "id": "s0302",
    "blockIndex": 15,
    "zh": "光於是以千秋擅召中二千石以下，外內異言，遂下廷尉平、少府仁獄。"
  },
  {
    "id": "s0303",
    "blockIndex": 15,
    "zh": "朝廷皆恐丞相坐之。"
  },
  {
    "id": "s0304",
    "blockIndex": 15,
    "zh": "太僕杜延年奏記光曰：「吏縱罪人，有常法。"
  },
  {
    "id": "s0305",
    "blockIndex": 15,
    "zh": "今更詆吳為不道，恐於法深。"
  },
  {
    "id": "s0306",
    "blockIndex": 15,
    "zh": "又，丞相素無所守持而為好言於下，盡其素行也。"
  },
  {
    "id": "s0307",
    "blockIndex": 15,
    "zh": "至擅召中二千石，甚無狀。"
  },
  {
    "id": "s0308",
    "blockIndex": 15,
    "zh": "延年愚以為丞相久故及先帝用事，非有大故，不可棄也。"
  },
  {
    "id": "s0309",
    "blockIndex": 15,
    "zh": "間者民頗言獄深，吏為峻詆；"
  },
  {
    "id": "s0310",
    "blockIndex": 15,
    "zh": "今丞相所議，又獄事也，如是以及丞相，恐不合眾心，群下讙嘩，庶人私議，流言四布。"
  },
  {
    "id": "s0311",
    "blockIndex": 15,
    "zh": "延年竊重將軍失此名於天下也。"
  },
  {
    "id": "s0312",
    "blockIndex": 15,
    "zh": "」光以廷尉、少府弄法輕重，卒下之獄。"
  },
  {
    "id": "s0313",
    "blockIndex": 15,
    "zh": "夏，四月，仁自殺，平與左馮翊賈勝胡皆要斬。"
  },
  {
    "id": "s0314",
    "blockIndex": 15,
    "zh": "而不以及丞相，終與相竟。"
  },
  {
    "id": "s0315",
    "blockIndex": 15,
    "zh": "延年論議持平，合和朝廷，皆此類也。"
  },
  {
    "id": "s0316",
    "blockIndex": 15,
    "zh": "----4冬，遼東烏桓反。"
  },
  {
    "id": "s0317",
    "blockIndex": 15,
    "zh": "初，冒頓破東胡，東胡餘眾散保烏桓及鮮卑山為二族，世役屬匈奴。"
  },
  {
    "id": "s0318",
    "blockIndex": 15,
    "zh": "武帝出破匈奴左地，因徙烏桓於上谷、漁陽、右北平、遼東塞外，為漢偵察匈奴動靜。"
  },
  {
    "id": "s0319",
    "blockIndex": 15,
    "zh": "置護烏桓校尉監領之，使不得與匈奴交通。"
  },
  {
    "id": "s0320",
    "blockIndex": 15,
    "zh": "至是，部眾漸強，遂反。"
  },
  {
    "id": "s0321",
    "blockIndex": 16,
    "zh": "先是，匈奴三千餘騎入五原，殺略數千人；"
  },
  {
    "id": "s0322",
    "blockIndex": 16,
    "zh": "後數萬騎南旁塞獵，行攻塞外亭障，略取吏民去。"
  },
  {
    "id": "s0323",
    "blockIndex": 16,
    "zh": "是時漢邊郡烽火候望精明，匈奴為邊寇者少利，希復犯塞。"
  },
  {
    "id": "s0324",
    "blockIndex": 16,
    "zh": "漢復得匈奴降者，言烏桓嘗發先單于塚，匈奴怨之，方發二萬騎擊烏桓。"
  },
  {
    "id": "s0325",
    "blockIndex": 16,
    "zh": "霍光欲發兵邀擊之，以問護軍都尉趙充國，充國以為：「烏桓間數犯塞，今匈奴擊之，於漢便。"
  },
  {
    "id": "s0326",
    "blockIndex": 16,
    "zh": "又匈奴希寇盜，北邊幸無事，蠻夷自相攻擊而發兵要之，招寇生事，非計也。"
  },
  {
    "id": "s0327",
    "blockIndex": 16,
    "zh": "」光更問中郎將范明友，明友言可擊，於是拜明友為度遼將軍，將二萬騎出遼東。"
  },
  {
    "id": "s0328",
    "blockIndex": 16,
    "zh": "匈奴聞漢兵至，引去。"
  },
  {
    "id": "s0329",
    "blockIndex": 16,
    "zh": "初，光誡明友：「兵不空出；"
  },
  {
    "id": "s0330",
    "blockIndex": 16,
    "zh": "即後匈奴，遂擊烏桓。"
  },
  {
    "id": "s0331",
    "blockIndex": 16,
    "zh": "」烏桓時新中匈奴兵，明友既後匈奴，因乘烏桓敝，擊之，斬首六千餘級，獲三王首。"
  },
  {
    "id": "s0332",
    "blockIndex": 16,
    "zh": "匈奴由是恐，不能復出兵。"
  },
  {
    "id": "s0334",
    "blockIndex": 17,
    "zh": "1春，正月，丁亥，帝加元服。"
  },
  {
    "id": "s0335",
    "blockIndex": 17,
    "zh": "----2甲戌，富民定侯田千秋薨。"
  },
  {
    "id": "s0336",
    "blockIndex": 17,
    "zh": "時政事壹決大將軍光；"
  },
  {
    "id": "s0337",
    "blockIndex": 17,
    "zh": "千秋居丞相位，謹厚自守而已。"
  },
  {
    "id": "s0338",
    "blockIndex": 17,
    "zh": "----3夏，五月，丁丑，孝文廟正殿火。"
  },
  {
    "id": "s0339",
    "blockIndex": 17,
    "zh": "上及群臣皆素服，發中二千石將五校作治，六日，成。"
  },
  {
    "id": "s0340",
    "blockIndex": 17,
    "zh": "太常及廟令丞、郎、吏，皆劾大不敬；"
  },
  {
    "id": "s0341",
    "blockIndex": 17,
    "zh": "會赦，太常轑陽侯德免為庶人。"
  },
  {
    "id": "s0342",
    "blockIndex": 17,
    "zh": "----4六月，赦天下。"
  },
  {
    "id": "s0343",
    "blockIndex": 17,
    "zh": "----5初，杅冞遣太子賴丹為質於龜茲；"
  },
  {
    "id": "s0344",
    "blockIndex": 17,
    "zh": "貳師擊大宛還，將賴丹入至京師。"
  },
  {
    "id": "s0345",
    "blockIndex": 17,
    "zh": "霍光用桑弘羊前議，以賴丹為校尉，將軍田輪台。"
  },
  {
    "id": "s0346",
    "blockIndex": 17,
    "zh": "龜茲貴人姑翼謂其王曰：「賴丹本臣屬吾國，今佩漢印綬來，迫吾國而田，必為害。"
  },
  {
    "id": "s0347",
    "blockIndex": 17,
    "zh": "」王即殺賴丹而上書謝漢。"
  },
  {
    "id": "s0348",
    "blockIndex": 18,
    "zh": "樓蘭王死，匈奴先聞之，遣其質子安歸歸，得立為王。"
  },
  {
    "id": "s0349",
    "blockIndex": 18,
    "zh": "漢遣使詔新王令入朝，王辭不至。"
  },
  {
    "id": "s0350",
    "blockIndex": 18,
    "zh": "樓蘭國最在東垂，近漢，當白龍堆，乏水草，常主發導，負水擔糧，送迎漢使；"
  },
  {
    "id": "s0351",
    "blockIndex": 18,
    "zh": "又數為官吏卒所寇，懲艾，不便與漢通。"
  },
  {
    "id": "s0352",
    "blockIndex": 18,
    "zh": "後復為匈奴反間，數遮殺漢使。"
  },
  {
    "id": "s0353",
    "blockIndex": 18,
    "zh": "其弟尉屠耆降漢，具言狀。"
  },
  {
    "id": "s0354",
    "blockIndex": 18,
    "zh": "駿馬監北地傅介子使大宛，詔因令責樓蘭、龜茲。"
  },
  {
    "id": "s0355",
    "blockIndex": 18,
    "zh": "介子至樓蘭、龜茲，責其王，皆謝服。"
  },
  {
    "id": "s0356",
    "blockIndex": 18,
    "zh": "介子從大宛還，到龜茲，會匈奴使從烏孫還，在龜茲，介子因率其吏士共誅斬匈奴使者。"
  },
  {
    "id": "s0357",
    "blockIndex": 18,
    "zh": "還，奏事，詔拜介子為中郎，遷平樂監。"
  },
  {
    "id": "s0358",
    "blockIndex": 19,
    "zh": "介子謂大將軍霍光曰：「樓蘭、龜茲數反覆，而不誅，無所懲艾。"
  },
  {
    "id": "s0359",
    "blockIndex": 19,
    "zh": "介子過龜茲時，其王近就人，易得也；"
  },
  {
    "id": "s0360",
    "blockIndex": 19,
    "zh": "願往刺之，以威示諸國。"
  },
  {
    "id": "s0361",
    "blockIndex": 19,
    "zh": "」大將軍曰：「龜茲道遠，且驗之於樓蘭。"
  },
  {
    "id": "s0362",
    "blockIndex": 19,
    "zh": "」於是白遣之。"
  },
  {
    "id": "s0363",
    "blockIndex": 19,
    "zh": "介子與士卒俱賫金幣，揚言以賜外國為名，至樓蘭。"
  },
  {
    "id": "s0364",
    "blockIndex": 19,
    "zh": "樓蘭王意不親介子，介子陽引去，至其西界，使譯謂曰：「漢使者持黃金、錦繡行賜諸國。"
  },
  {
    "id": "s0365",
    "blockIndex": 19,
    "zh": "王不來受，我去之西國矣。"
  },
  {
    "id": "s0366",
    "blockIndex": 19,
    "zh": "」即出金、幣以示譯。"
  },
  {
    "id": "s0367",
    "blockIndex": 19,
    "zh": "譯還報王，王貪漢物，來見使者。"
  },
  {
    "id": "s0368",
    "blockIndex": 19,
    "zh": "介子與坐飲，陳物示之，飲酒皆醉。"
  },
  {
    "id": "s0369",
    "blockIndex": 19,
    "zh": "介子謂王曰：「天子使我私報王。"
  },
  {
    "id": "s0370",
    "blockIndex": 19,
    "zh": "」王起，隨介子入帳中屏語，壯士二人從後刺之，刃交匈，立死；"
  },
  {
    "id": "s0371",
    "blockIndex": 19,
    "zh": "其貴人、左右皆散走。"
  },
  {
    "id": "s0372",
    "blockIndex": 19,
    "zh": "介子告諭以王負漢罪，「天子遣我誅王，當更立王弟尉屠耆在漢者。"
  },
  {
    "id": "s0373",
    "blockIndex": 19,
    "zh": "漢兵方至，毋敢動，自令滅國矣！"
  },
  {
    "id": "s0374",
    "blockIndex": 19,
    "zh": "」介子遂斬王安歸首，馳傳詣闕，縣首北闕下。"
  },
  {
    "id": "s0375",
    "blockIndex": 20,
    "zh": "乃立尉屠耆為王，更名其國為鄯善，為刻印章；"
  },
  {
    "id": "s0376",
    "blockIndex": 20,
    "zh": "賜以宮女為夫人，備車騎、輜重。"
  },
  {
    "id": "s0377",
    "blockIndex": 20,
    "zh": "丞相率百官送至橫門外，祖而遣之。"
  },
  {
    "id": "s0378",
    "blockIndex": 20,
    "zh": "王自請天子曰：「身在漢久，今歸單弱，而前王有子在，恐為所殺。"
  },
  {
    "id": "s0379",
    "blockIndex": 20,
    "zh": "國中有伊循城，其地肥美，願漢遣一將屯田積穀，令臣得依其威重。"
  },
  {
    "id": "s0380",
    "blockIndex": 20,
    "zh": "」於是漢遣司馬一人、吏士四十人田伊循以填撫之。"
  },
  {
    "id": "s0381",
    "blockIndex": 21,
    "zh": "秋，七月，乙巳，封范明友為平陵侯，傅介子為義陽侯。"
  },
  {
    "id": "s0382",
    "blockIndex": 22,
    "zh": ":臣光曰：王者之於戎狄，叛則討之，服則捨之。"
  },
  {
    "id": "s0383",
    "blockIndex": 22,
    "zh": "今樓蘭王既服其罪，又從而誅之，後有叛者，不可得而懷矣。"
  },
  {
    "id": "s0384",
    "blockIndex": 22,
    "zh": "必以為有罪而討之，則宜陳師鞠旅，明致其罰。"
  },
  {
    "id": "s0385",
    "blockIndex": 22,
    "zh": "今乃遣使者誘以金幣而殺之，後有奉使諸國者，復可信乎！"
  },
  {
    "id": "s0386",
    "blockIndex": 22,
    "zh": "且以大漢之強而為盜賊之謀於蠻夷，不亦可羞哉！"
  },
  {
    "id": "s0387",
    "blockIndex": 22,
    "zh": "論者或美介子以為奇功，過矣！"
  },
  {
    "id": "s0389",
    "blockIndex": 23,
    "zh": "1夏，大旱。"
  },
  {
    "id": "s0390",
    "blockIndex": 23,
    "zh": "----2秋，罷象郡，分屬鬱林、牂柯。"
  },
  {
    "id": "s0391",
    "blockIndex": 23,
    "zh": "----3冬，十一月，大雷。"
  },
  {
    "id": "s0392",
    "blockIndex": 23,
    "zh": "----4十二月，庚戌，宜春敬侯王訴薨。"
  },
  {
    "id": "s0394",
    "blockIndex": 24,
    "zh": "1春，正月，募郡國徒築遼東、玄菟城。"
  },
  {
    "id": "s0395",
    "blockIndex": 24,
    "zh": "----2夏，赦天下。"
  },
  {
    "id": "s0396",
    "blockIndex": 24,
    "zh": "----3烏桓復犯塞，遣度遼將軍范明友擊之。"
  },
  {
    "id": "s0397",
    "blockIndex": 24,
    "zh": "----4冬，十一月，乙丑，以楊敞為丞相，少府河內蔡義為御史大夫。"
  },
  {
    "id": "s0398",
    "blockIndex": 24,
    "zh": "----category:資治通鑑"
  }
]
