[
  {
    "id": "s0001",
    "blockIndex": 0,
    "zh": "資治通鑑 第165卷卷第一百六十五"
  },
  {
    "id": "s0002",
    "blockIndex": 1,
    "zh": "【梁紀二十一】　起昭陽作噩，盡閼逢閹茂，凡二年。"
  },
  {
    "id": "s0003",
    "blockIndex": 2,
    "zh": "世祖孝元皇帝下承聖二年（"
  },
  {
    "id": "s0003",
    "blockIndex": 2,
    "zh": "癸酉，公元五五三年）"
  },
  {
    "id": "s0005",
    "blockIndex": 3,
    "zh": "春，正月，王僧辯發建康，承製使陳霸先代鎮揚州。"
  },
  {
    "id": "s0006",
    "blockIndex": 4,
    "zh": "丙子，山胡圍齊離石。"
  },
  {
    "id": "s0006",
    "blockIndex": 4,
    "zh": "戊寅，齊主討之，未至，胡已走，因巡三堆，大獵而歸。"
  },
  {
    "id": "s0008",
    "blockIndex": 5,
    "zh": "以吏部尚書王褒為左僕射。"
  },
  {
    "id": "s0009",
    "blockIndex": 6,
    "zh": "己丑，齊改鑄錢，文曰「常平五銖」。"
  },
  {
    "id": "s0010",
    "blockIndex": 7,
    "zh": "二月，庚子，李洪雅力屈，以空雲城降陸納。"
  },
  {
    "id": "s0010",
    "blockIndex": 7,
    "zh": "納囚洪雅，殺丁道貴。"
  },
  {
    "id": "s0010",
    "blockIndex": 7,
    "zh": "納以沙門寶志詩識有「十八子」，以為李氏當王，甲辰，推洪雅為主，號大將軍，使乘平肩輿，列鼓吹，納帥眾數千，左右翼從。"
  },
  {
    "id": "s0013",
    "blockIndex": 8,
    "zh": "魏太師泰去丞相、大行台，為都督中外諸軍事。"
  },
  {
    "id": "s0014",
    "blockIndex": 9,
    "zh": "王雄至東梁州，黃眾寶帥眾降。"
  },
  {
    "id": "s0014",
    "blockIndex": 9,
    "zh": "太師泰赦之，遷其豪帥於雍州。"
  },
  {
    "id": "s0016",
    "blockIndex": 10,
    "zh": "齊主送柔然可汗鐵伐之父登注及兄庫提還其國。"
  },
  {
    "id": "s0016",
    "blockIndex": 10,
    "zh": "鐵伐尋為契丹所殺，國人立登注為可汗。"
  },
  {
    "id": "s0016",
    "blockIndex": 10,
    "zh": "登注復為其大人阿富提所殺，國人立庫提。"
  },
  {
    "id": "s0016",
    "blockIndex": 10,
    "zh": "突厥伊利可汗卒，子科羅立，號乙息記可汗；"
  },
  {
    "id": "s0016",
    "blockIndex": 10,
    "zh": "三月，遣使獻馬五萬於魏。"
  },
  {
    "id": "s0016",
    "blockIndex": 10,
    "zh": "柔然別部又立阿那瓖叔父鄧叔子為可汗。"
  },
  {
    "id": "s0016",
    "blockIndex": 10,
    "zh": "乙息記擊破鄧叔子於沃野北木賴山。"
  },
  {
    "id": "s0016",
    "blockIndex": 10,
    "zh": "乙息記卒，捨其子攝圖而立其弟俟斤，號木桿可汗。"
  },
  {
    "id": "s0016",
    "blockIndex": 10,
    "zh": "木桿狀貌奇異，性剛勇，多智略，善用兵，鄰國畏之。"
  },
  {
    "id": "s0025",
    "blockIndex": 11,
    "zh": "上聞武陵王紀東下，使方士畫版為紀像，親釘支體以厭之，又執侯景之俘以報紀。"
  },
  {
    "id": "s0025",
    "blockIndex": 11,
    "zh": "初，紀之舉兵，皆太子圓照之謀也。"
  },
  {
    "id": "s0025",
    "blockIndex": 11,
    "zh": "圓照時鎮巴東，執留使者。"
  },
  {
    "id": "s0025",
    "blockIndex": 11,
    "zh": "啟紀云：「侯景未平，宜急進討；"
  },
  {
    "id": "s0025",
    "blockIndex": 11,
    "zh": "已聞荊鎮為景所破。"
  },
  {
    "id": "s0025",
    "blockIndex": 11,
    "zh": "」紀信之，趣兵東下。"
  },
  {
    "id": "s0025",
    "blockIndex": 11,
    "zh": "上甚懼，與魏書曰：「子糾，親也，請君討之。"
  },
  {
    "id": "s0025",
    "blockIndex": 11,
    "zh": "」太師泰曰：「取蜀制梁，在茲一舉。"
  },
  {
    "id": "s0025",
    "blockIndex": 11,
    "zh": "」諸將鹹難之。"
  },
  {
    "id": "s0025",
    "blockIndex": 11,
    "zh": "大將軍代人尉遲迥，泰之甥也，獨以為可克。"
  },
  {
    "id": "s0025",
    "blockIndex": 11,
    "zh": "泰問以方略，迥曰：「蜀與中國隔絕百有餘年，恃其險遠，不虞我至。"
  },
  {
    "id": "s0025",
    "blockIndex": 11,
    "zh": "若以鐵騎兼行襲之，無不克矣。"
  },
  {
    "id": "s0025",
    "blockIndex": 11,
    "zh": "」泰乃遣迥督開府儀同三司原珍等六軍，甲士萬二千，騎萬匹，自散關伐蜀。"
  },
  {
    "id": "s0038",
    "blockIndex": 12,
    "zh": "陸納遣其將吳藏、潘烏黑、李賢明等下據車輪。"
  },
  {
    "id": "s0038",
    "blockIndex": 12,
    "zh": "王僧辯至巴陵，宜豐侯循讓都督於僧辯，僧辯弗受。"
  },
  {
    "id": "s0038",
    "blockIndex": 12,
    "zh": "上乃以僧辯、循為東、西都督。"
  },
  {
    "id": "s0038",
    "blockIndex": 12,
    "zh": "夏，四月，丙申，僧辯軍於車輪。"
  },
  {
    "id": "s0042",
    "blockIndex": 13,
    "zh": "吐谷渾可汗誇呂，雖通使於魏而寇抄不息，宇文泰將騎三萬逾隴，至姑臧，討之。"
  },
  {
    "id": "s0042",
    "blockIndex": 13,
    "zh": "誇呂懼，請服；"
  },
  {
    "id": "s0042",
    "blockIndex": 13,
    "zh": "既而復通使於齊。"
  },
  {
    "id": "s0042",
    "blockIndex": 13,
    "zh": "涼州刺史史寧覘知其還，襲之於赤泉，獲其僕射乞伏觸狀。"
  },
  {
    "id": "s0046",
    "blockIndex": 14,
    "zh": "陸納夾岸為城，以拒王僧辯。"
  },
  {
    "id": "s0046",
    "blockIndex": 14,
    "zh": "納士卒皆百戰之餘，僧辯憚之，不敢輕進，稍作連城以逼之。"
  },
  {
    "id": "s0046",
    "blockIndex": 14,
    "zh": "納以僧辯為怯，不設備；"
  },
  {
    "id": "s0046",
    "blockIndex": 14,
    "zh": "五月，甲子，僧辯命諸軍水陸齊進，急攻之，僧辯親執旗鼓，宜豐侯循身受矢石，拔其二城；"
  },
  {
    "id": "s0046",
    "blockIndex": 14,
    "zh": "納眾大敗，步走，保長沙。"
  },
  {
    "id": "s0046",
    "blockIndex": 14,
    "zh": "乙丑，僧辯進圍之。"
  },
  {
    "id": "s0046",
    "blockIndex": 14,
    "zh": "僧辯坐壟上視築圍壘，吳藏、李賢明帥銳卒千人開門突出，蒙楯直進，趨僧辯。"
  },
  {
    "id": "s0046",
    "blockIndex": 14,
    "zh": "時杜崱、杜龕並侍左右，甲士衛者止百餘人，力戰拒之。"
  },
  {
    "id": "s0046",
    "blockIndex": 14,
    "zh": "僧辯據胡床不動，裴之橫從旁擊藏等，藏等敗退，賢明死，藏脫走入城。"
  },
  {
    "id": "s0055",
    "blockIndex": 15,
    "zh": "武陵王紀至巴郡，聞有魏兵，遣前梁州刺史巴西譙淹還軍救蜀。"
  },
  {
    "id": "s0055",
    "blockIndex": 15,
    "zh": "初，楊乾運求為梁州刺史，紀以為潼州；"
  },
  {
    "id": "s0055",
    "blockIndex": 15,
    "zh": "楊法琛求為黎州刺史，以為沙州：二人皆不悅。"
  },
  {
    "id": "s0055",
    "blockIndex": 15,
    "zh": "乾運兄子略說乾運曰：「今侯景初平，宜同心戮力，保國寧民，而兄弟尋戈，此自亡之道也。"
  },
  {
    "id": "s0055",
    "blockIndex": 15,
    "zh": "夫木朽不雕，世衰難佐。"
  },
  {
    "id": "s0055",
    "blockIndex": 15,
    "zh": "不如送款關中，可以功名兩全。"
  },
  {
    "id": "s0055",
    "blockIndex": 15,
    "zh": "」乾運然之，令略將二千人鎮劍閣，又遣其婿樂廣鎮安州，與法琛皆潛通於魏。"
  },
  {
    "id": "s0055",
    "blockIndex": 15,
    "zh": "魏太師泰密賜乾運鐵券，授驃騎大將軍、開府儀同三司、梁州刺史。"
  },
  {
    "id": "s0055",
    "blockIndex": 15,
    "zh": "尉遲迥以開府儀同三司侯呂陵始為前軍，至劍閣，略退就樂廣，翻城應始，始入據安州。"
  },
  {
    "id": "s0055",
    "blockIndex": 15,
    "zh": "甲戌，迥至涪水，乾運以州降。"
  },
  {
    "id": "s0055",
    "blockIndex": 15,
    "zh": "迥分軍守之，進襲成都。"
  },
  {
    "id": "s0055",
    "blockIndex": 15,
    "zh": "時成都見兵不滿萬人，倉庫空竭，永豐侯摠嬰城自守，迥圍之。"
  },
  {
    "id": "s0055",
    "blockIndex": 15,
    "zh": "譙淹遣江州刺史景欣、幽州刺史趙拔扈援成都，迥使原珍等擊走之。"
  },
  {
    "id": "s0068",
    "blockIndex": 16,
    "zh": "武陵王紀至巴東，知侯景已平，乃自悔，召太子圓照責之，對曰：「侯景雖平，江陵未服。"
  },
  {
    "id": "s0068",
    "blockIndex": 16,
    "zh": "」紀亦以既稱尊號，不可復為人下，欲遂東進。"
  },
  {
    "id": "s0068",
    "blockIndex": 16,
    "zh": "將卒日夜思歸，其江州刺史王開業以為宜還救根本，更思後圖；"
  },
  {
    "id": "s0068",
    "blockIndex": 16,
    "zh": "諸將皆以為然。"
  },
  {
    "id": "s0068",
    "blockIndex": 16,
    "zh": "圓照及劉孝勝固言不可，紀從之，宣言於眾曰：「敢諫者死！"
  },
  {
    "id": "s0068",
    "blockIndex": 16,
    "zh": "」己丑，紀至西陵，軍勢甚盛，舳艫翳川。"
  },
  {
    "id": "s0068",
    "blockIndex": 16,
    "zh": "護軍陸法和築二城於峽口兩岸，運石填江，鐵鎖斷之。"
  },
  {
    "id": "s0075",
    "blockIndex": 17,
    "zh": "帝拔任約於獄，以為晉安王司馬，使助法和拒紀，謂之曰：「汝罪不容誅，我不殺汝，本為今日！"
  },
  {
    "id": "s0075",
    "blockIndex": 17,
    "zh": "」因撤禁兵以配之，仍許妻以廬陵王續之女，使宣猛將軍劉棻與之俱。"
  },
  {
    "id": "s0077",
    "blockIndex": 18,
    "zh": "庚辰，巴州刺史余孝頃將兵萬人會王僧辯於長沙。"
  },
  {
    "id": "s0078",
    "blockIndex": 19,
    "zh": "豫章太守觀寧侯永，昏而少斷。"
  },
  {
    "id": "s0078",
    "blockIndex": 19,
    "zh": "左右武蠻奴用事，軍主文重疾之。"
  },
  {
    "id": "s0078",
    "blockIndex": 19,
    "zh": "永將兵討陸納，至宮亭湖，重殺蠻奴。"
  },
  {
    "id": "s0078",
    "blockIndex": 19,
    "zh": "永軍潰，奔江陵。"
  },
  {
    "id": "s0078",
    "blockIndex": 19,
    "zh": "重將其眾奔開建侯蕃，蕃殺之而有其眾。"
  },
  {
    "id": "s0083",
    "blockIndex": 20,
    "zh": "六月，壬辰，武陵王紀築連城，攻絕鐵鎖，陸法和告急相繼。"
  },
  {
    "id": "s0083",
    "blockIndex": 20,
    "zh": "上復拔謝答仁於獄，以為步兵校尉，配兵使助法和；"
  },
  {
    "id": "s0083",
    "blockIndex": 20,
    "zh": "又遣使送王琳，令說諭陸納。"
  },
  {
    "id": "s0083",
    "blockIndex": 20,
    "zh": "乙未，琳至長沙，僧辯使送示之，納眾悉拜且泣，使謂僧辯曰：「朝廷若赦王郎，乞聽入城。"
  },
  {
    "id": "s0083",
    "blockIndex": 20,
    "zh": "」僧辯不許，復送江陵。"
  },
  {
    "id": "s0083",
    "blockIndex": 20,
    "zh": "陸法和求救不已，上欲召長沙兵，恐失陸納，乃復遣琳許其入城。"
  },
  {
    "id": "s0083",
    "blockIndex": 20,
    "zh": "琳既入，納遂降，湘州平。"
  },
  {
    "id": "s0083",
    "blockIndex": 20,
    "zh": "上復琳官爵，使將兵西援峽口。"
  },
  {
    "id": "s0091",
    "blockIndex": 21,
    "zh": "甲辰，齊章武景王庫狄干卒。"
  },
  {
    "id": "s0092",
    "blockIndex": 22,
    "zh": "武陵王紀遣將軍侯睿將眾七千，築壘與陸法和相拒。"
  },
  {
    "id": "s0092",
    "blockIndex": 22,
    "zh": "上遣使與紀書，許其還蜀，專制一方；"
  },
  {
    "id": "s0092",
    "blockIndex": 22,
    "zh": "紀不從，報書如家人禮。"
  },
  {
    "id": "s0092",
    "blockIndex": 22,
    "zh": "陸納既平，湘州諸軍相繼西上，上復與紀書曰：「吾年為一日之長，屬有平亂之功，膺此樂推，事歸當璧。"
  },
  {
    "id": "s0092",
    "blockIndex": 22,
    "zh": "倘遣使乎，良所遲也。"
  },
  {
    "id": "s0092",
    "blockIndex": 22,
    "zh": "如曰不然，於此投筆。"
  },
  {
    "id": "s0092",
    "blockIndex": 22,
    "zh": "友于兄弟，分形共氣，兄肥弟瘦，無復相見之期，讓棗推梨，永罷歡愉之日。"
  },
  {
    "id": "s0092",
    "blockIndex": 22,
    "zh": "心乎愛矣，書不盡言。"
  },
  {
    "id": "s0092",
    "blockIndex": 22,
    "zh": "」紀頓兵日久，頻戰不利，又聞魏寇深入，成都孤危，憂懣不知所為。"
  },
  {
    "id": "s0092",
    "blockIndex": 22,
    "zh": "乃遣其度支尚書樂奉業詣江陵求和，請依前旨還蜀。"
  },
  {
    "id": "s0092",
    "blockIndex": 22,
    "zh": "奉業知紀必敗，啟上曰：「蜀軍乏糧，士卒多死，危亡可待。"
  },
  {
    "id": "s0092",
    "blockIndex": 22,
    "zh": "」上遂不許其和。"
  },
  {
    "id": "s0104",
    "blockIndex": 23,
    "zh": "紀以黃金一斤為餅，餅百為篋，至有百篋，銀五倍於金，錦罽、繒彩稱是，每戰，懸示將士，不以為賞。"
  },
  {
    "id": "s0104",
    "blockIndex": 23,
    "zh": "寧州刺史陳智祖請散之以募勇士，弗聽，智祖哭而死。"
  },
  {
    "id": "s0104",
    "blockIndex": 23,
    "zh": "有請事者，紀辭疾不見，由是將卒解體。"
  },
  {
    "id": "s0107",
    "blockIndex": 24,
    "zh": "秋，七月，辛未，巴東民符升等斬峽口城主公孫晃，降於王琳。"
  },
  {
    "id": "s0107",
    "blockIndex": 24,
    "zh": "謝答仁、任約進攻侯睿，破之，拔其三壘。"
  },
  {
    "id": "s0107",
    "blockIndex": 24,
    "zh": "於是兩岸十四城俱降。"
  },
  {
    "id": "s0107",
    "blockIndex": 24,
    "zh": "紀不獲退，順流東下，游擊將軍南陽樊猛追擊之，紀眾大潰，赴水死者八千餘人，猛圍而守之。"
  },
  {
    "id": "s0107",
    "blockIndex": 24,
    "zh": "上密敕猛曰：「生還，不成功也。"
  },
  {
    "id": "s0107",
    "blockIndex": 24,
    "zh": "」猛引兵至紀所，紀在舟中繞床而走，以金囊擲猛曰：「以此雇卿，送我一見七官。"
  },
  {
    "id": "s0107",
    "blockIndex": 24,
    "zh": "」猛曰：「天子何由可見！"
  },
  {
    "id": "s0107",
    "blockIndex": 24,
    "zh": "殺足下，金將安之！"
  },
  {
    "id": "s0107",
    "blockIndex": 24,
    "zh": "」遂斬紀及其幼子圓滿。"
  },
  {
    "id": "s0107",
    "blockIndex": 24,
    "zh": "陸法和收太子圓照兄弟三人送江陵。"
  },
  {
    "id": "s0107",
    "blockIndex": 24,
    "zh": "上絕紀屬籍，賜姓饕餮氏。"
  },
  {
    "id": "s0107",
    "blockIndex": 24,
    "zh": "下劉孝勝獄，已而釋之。"
  },
  {
    "id": "s0107",
    "blockIndex": 24,
    "zh": "上使謂江安侯圓正曰：「西軍已敗，汝父不知存亡。"
  },
  {
    "id": "s0107",
    "blockIndex": 24,
    "zh": "」意欲使其自裁。"
  },
  {
    "id": "s0107",
    "blockIndex": 24,
    "zh": "圓正聞之號哭，稱世子不絕聲。"
  },
  {
    "id": "s0107",
    "blockIndex": 24,
    "zh": "上頻使覘之，知不能死，移送廷尉獄，見圓照，曰：「兄何乃亂人骨肉，使痛酷如此！"
  },
  {
    "id": "s0107",
    "blockIndex": 24,
    "zh": "」圓照唯云「計誤」。"
  },
  {
    "id": "s0107",
    "blockIndex": 24,
    "zh": "上並命絕食於獄，至嚙臂啖之，十三日而死，遠近聞而悲之。"
  },
  {
    "id": "s0125",
    "blockIndex": 25,
    "zh": "乙未，王僧辯還江陵。"
  },
  {
    "id": "s0125",
    "blockIndex": 25,
    "zh": "詔諸軍各還所鎮。"
  },
  {
    "id": "s0127",
    "blockIndex": 26,
    "zh": "魏尉遲迥圍成都五旬，永豐侯摠屢出戰，皆敗，乃請降。"
  },
  {
    "id": "s0127",
    "blockIndex": 26,
    "zh": "諸將欲不許，迥曰：「降之則將士全，遠人悅；"
  },
  {
    "id": "s0127",
    "blockIndex": 26,
    "zh": "攻之則將士傷，遠人懼。"
  },
  {
    "id": "s0127",
    "blockIndex": 26,
    "zh": "」遂受之。"
  },
  {
    "id": "s0127",
    "blockIndex": 26,
    "zh": "八月，戊戌，摠與宜都王圓肅帥文武詣軍門降；"
  },
  {
    "id": "s0127",
    "blockIndex": 26,
    "zh": "迥以禮接之，與盟於益州城北。"
  },
  {
    "id": "s0127",
    "blockIndex": 26,
    "zh": "吏民皆復其業，唯收奴婢及儲積以賞將士，軍無私焉。"
  },
  {
    "id": "s0127",
    "blockIndex": 26,
    "zh": "魏以摠及圓肅並為開府儀同三司，以迥為大都督益、潼等十二州諸軍事、益州刺史。"
  },
  {
    "id": "s0135",
    "blockIndex": 27,
    "zh": "庚子，下詔將還建康，領軍將軍胡僧祐、太府卿黃羅漢、吏部尚書宗懍、御史中丞劉彀諫曰：「建業王氣已盡，與虜正隔一江，若有不虞，悔無及也！"
  },
  {
    "id": "s0135",
    "blockIndex": 27,
    "zh": "且古老相承云：『荊州洲數滿百，當出天子。"
  },
  {
    "id": "s0135",
    "blockIndex": 27,
    "zh": "』今枝江生洲，百數已滿，陛下龍飛，是其應也。"
  },
  {
    "id": "s0135",
    "blockIndex": 27,
    "zh": "」上令朝臣議之。"
  },
  {
    "id": "s0135",
    "blockIndex": 27,
    "zh": "黃門侍郎周弘正、尚書右僕射王褒曰：「今百姓未見輿駕入建康，謂是列國諸王；"
  },
  {
    "id": "s0135",
    "blockIndex": 27,
    "zh": "願陛下從四海之望。"
  },
  {
    "id": "s0135",
    "blockIndex": 27,
    "zh": "」時群臣多荊州人，皆曰：「弘正等東人也，志願東下，恐非良計。"
  },
  {
    "id": "s0135",
    "blockIndex": 27,
    "zh": "」弘正面折之曰：「東人勸東，謂非良計；"
  },
  {
    "id": "s0135",
    "blockIndex": 27,
    "zh": "君等西人欲西，豈成長策？"
  },
  {
    "id": "s0135",
    "blockIndex": 27,
    "zh": "」上笑。"
  },
  {
    "id": "s0135",
    "blockIndex": 27,
    "zh": "又議於後堂，會者五百人，上問之曰：「吾欲還建康，諸卿以為如何？"
  },
  {
    "id": "s0135",
    "blockIndex": 27,
    "zh": "」眾莫敢先對。"
  },
  {
    "id": "s0135",
    "blockIndex": 27,
    "zh": "上曰：「勸吾去者左袒。"
  },
  {
    "id": "s0135",
    "blockIndex": 27,
    "zh": "」左袒者過半。"
  },
  {
    "id": "s0135",
    "blockIndex": 27,
    "zh": "武昌太守朱買臣言於上曰：「建康舊都，山陵所在；"
  },
  {
    "id": "s0135",
    "blockIndex": 27,
    "zh": "荊鎮邊韁，非王者之宅。"
  },
  {
    "id": "s0135",
    "blockIndex": 27,
    "zh": "願陛下勿疑，以致後悔。"
  },
  {
    "id": "s0135",
    "blockIndex": 27,
    "zh": "臣家在荊州，豈不願陛下居此，但恐是臣富貴，非陛下富貴耳！"
  },
  {
    "id": "s0135",
    "blockIndex": 27,
    "zh": "」上使術士杜景豪卜之，不吉，對上曰：「未去。"
  },
  {
    "id": "s0135",
    "blockIndex": 27,
    "zh": "」退而言曰：「此兆為鬼賊所留也。"
  },
  {
    "id": "s0135",
    "blockIndex": 27,
    "zh": "」上以建康凋殘，江陵全盛，意亦安之，卒從僧祐等議。"
  },
  {
    "id": "s0156",
    "blockIndex": 28,
    "zh": "以湘州刺史王琳為衡州刺史。"
  },
  {
    "id": "s0157",
    "blockIndex": 29,
    "zh": "九月，庚午，詔王僧辯還鎮建康，陳霸先復還京口。"
  },
  {
    "id": "s0157",
    "blockIndex": 29,
    "zh": "丙子，以護軍將軍陸法和為郢州刺史。"
  },
  {
    "id": "s0157",
    "blockIndex": 29,
    "zh": "法和為政，不用刑獄，專以沙門法及西域幻術教化，部曲數千人，通謂之弟子。"
  },
  {
    "id": "s0160",
    "blockIndex": 30,
    "zh": "契丹寇齊邊。"
  },
  {
    "id": "s0160",
    "blockIndex": 30,
    "zh": "壬午，齊主北巡冀、定、幽、安，遂伐契丹。"
  },
  {
    "id": "s0160",
    "blockIndex": 30,
    "zh": "齊主使郭元建治水軍二萬餘人於合肥，將襲建康，納湘潭侯退，又遣將軍邢景遠、步大汗薩帥眾繼之。"
  },
  {
    "id": "s0160",
    "blockIndex": 30,
    "zh": "陳霸先在建康聞之，白上；"
  },
  {
    "id": "s0160",
    "blockIndex": 30,
    "zh": "上詔王僧辯鎮姑孰以御之。"
  },
  {
    "id": "s0165",
    "blockIndex": 31,
    "zh": "冬，十月，丁酉，齊主至平州，從西道趣長塹，使司徒潘相樂帥精騎五千自東道趣青山。"
  },
  {
    "id": "s0165",
    "blockIndex": 31,
    "zh": "辛丑，至白狼城。"
  },
  {
    "id": "s0165",
    "blockIndex": 31,
    "zh": "壬寅，至昌黎城，使安德王韓軌帥精騎四千東斷契丹走路。"
  },
  {
    "id": "s0165",
    "blockIndex": 31,
    "zh": "癸卯，至陽師水，倍道兼行，掩襲契丹。"
  },
  {
    "id": "s0165",
    "blockIndex": 31,
    "zh": "齊主露髻肉袒，晝夜不息，行千餘里，逾越山嶺，為士卒先，唯食肉飲水，壯氣彌厲。"
  },
  {
    "id": "s0165",
    "blockIndex": 31,
    "zh": "甲辰，與契丹遇，奮擊，大破之，虜獲十萬餘口，雜畜數百萬頭。"
  },
  {
    "id": "s0165",
    "blockIndex": 31,
    "zh": "潘相樂又於青山破契丹別部。"
  },
  {
    "id": "s0165",
    "blockIndex": 31,
    "zh": "丁未，齊主還至營州。"
  },
  {
    "id": "s0173",
    "blockIndex": 32,
    "zh": "己酉，王僧辯至姑孰，遣婺州刺史侯瑱、吳郡太守張彪、吳興太守裴之橫築壘東關，以待齊師。"
  },
  {
    "id": "s0174",
    "blockIndex": 33,
    "zh": "丁巳，齊主登碣石山，臨滄海，遂如晉陽。"
  },
  {
    "id": "s0174",
    "blockIndex": 33,
    "zh": "以肆州刺史斛律金為太師，乃還晉陽，拜其子豐樂為武衛大將軍，命其孫武都尚義寧公主，寵待之厚，群臣莫及。"
  },
  {
    "id": "s0176",
    "blockIndex": 34,
    "zh": "閏月，丁丑，南豫州刺史侯瑱與郭元建戰於東關，齊師大敗，溺死者萬計。"
  },
  {
    "id": "s0176",
    "blockIndex": 34,
    "zh": "湘潭侯退復歸於鄴，王僧辯還建康。"
  },
  {
    "id": "s0178",
    "blockIndex": 35,
    "zh": "吳州刺史開建侯蕃，恃其兵強，貢獻不入，上密令其將徐佛受圖之。"
  },
  {
    "id": "s0178",
    "blockIndex": 35,
    "zh": "佛受使其徒詐為訟者，詣蕃，遂執之。"
  },
  {
    "id": "s0178",
    "blockIndex": 35,
    "zh": "上以佛受為建安太守，以侍中王質為吳州刺史。"
  },
  {
    "id": "s0178",
    "blockIndex": 35,
    "zh": "質至鄱陽，佛受置之金城，自據羅城，掌門管，繕治舟艦甲兵，質不敢與爭。"
  },
  {
    "id": "s0178",
    "blockIndex": 35,
    "zh": "故開建侯部曲數千人攻佛受，佛受奔南豫州，侯瑱殺之，質始得行州事。"
  },
  {
    "id": "s0183",
    "blockIndex": 36,
    "zh": "十一月，戊戌，以尚書右僕射王褒為左僕射，湘東太守張綰為右僕射。"
  },
  {
    "id": "s0184",
    "blockIndex": 37,
    "zh": "己未，突厥復攻柔然，柔然舉國奔齊。"
  },
  {
    "id": "s0185",
    "blockIndex": 38,
    "zh": "癸亥，齊主自晉陽北擊突厥，迎納柔然，廢其可汗庫提，立阿那瑰子庵羅辰為可汗，置之馬邑川，給其廩餼繒帛；"
  },
  {
    "id": "s0185",
    "blockIndex": 38,
    "zh": "親追突厥於朔州，突厥請降，許之而還。"
  },
  {
    "id": "s0185",
    "blockIndex": 38,
    "zh": "自是貢獻相繼。"
  },
  {
    "id": "s0188",
    "blockIndex": 39,
    "zh": "魏尚書元烈謀殺宇文泰，事洩，泰殺之。"
  },
  {
    "id": "s0189",
    "blockIndex": 40,
    "zh": "丙寅，上使侍中王琛使於魏。"
  },
  {
    "id": "s0189",
    "blockIndex": 40,
    "zh": "太師泰陰有圖江陵之志，梁王察聞之，益重其貢獻。"
  },
  {
    "id": "s0191",
    "blockIndex": 41,
    "zh": "十二月，齊宿預民東方白額以城降，江西州郡皆起兵應之。"
  },
  {
    "id": "s0192",
    "blockIndex": 42,
    "zh": "世祖孝元皇帝下承聖三年（"
  },
  {
    "id": "s0192",
    "blockIndex": 42,
    "zh": "甲戌，公元五五四年）"
  },
  {
    "id": "s0194",
    "blockIndex": 43,
    "zh": "春，正月，癸巳，齊主自離石道討山胡，遣斛律金從顯州道，常山王演從晉州道夾攻，大破之，男子十三以上皆斬，女子及幼弱以賞軍，遂平石樓。"
  },
  {
    "id": "s0194",
    "blockIndex": 43,
    "zh": "石樓絕險，自魏世所不能至，於是遠近山胡莫不懾服。"
  },
  {
    "id": "s0194",
    "blockIndex": 43,
    "zh": "有都督戰傷，其什長路暉禮不能救，帝命刳其五藏，令九人食之，肉及穢惡皆盡。"
  },
  {
    "id": "s0194",
    "blockIndex": 43,
    "zh": "自是始為威虐。"
  },
  {
    "id": "s0194",
    "blockIndex": 43,
    "zh": "陳霸先自丹徒濟江，圍齊廣陵，秦州刺史嚴超達自秦郡進圍涇州，南豫州刺史侯瑱、吳郡太守張彪皆出石樑，為之聲援。"
  },
  {
    "id": "s0194",
    "blockIndex": 43,
    "zh": "辛丑，使晉陵太守杜僧明帥三千人助東方白額。"
  },
  {
    "id": "s0200",
    "blockIndex": 44,
    "zh": "魏太師泰始作九命之典，以敘內外官爵，改流外品為九秩。"
  },
  {
    "id": "s0201",
    "blockIndex": 45,
    "zh": "魏主自元烈之死，有怨言，密謀誅太師泰；"
  },
  {
    "id": "s0201",
    "blockIndex": 45,
    "zh": "臨淮王育、廣平王贊垂涕切諫，不聽。"
  },
  {
    "id": "s0201",
    "blockIndex": 45,
    "zh": "泰諸子皆幼，兄子章武公導、中山公護皆出鎮，唯以諸婿為心膂，大都督清河公李基、義城公李暉、常山公於翼俱為武衛將軍，分掌禁兵。"
  },
  {
    "id": "s0201",
    "blockIndex": 45,
    "zh": "基，遠之子；"
  },
  {
    "id": "s0201",
    "blockIndex": 45,
    "zh": "暉，弼之子；"
  },
  {
    "id": "s0201",
    "blockIndex": 45,
    "zh": "翼，謹之子也。"
  },
  {
    "id": "s0201",
    "blockIndex": 45,
    "zh": "由是魏主謀洩，泰廢魏主，置之雍州，立其弟齊王廓。"
  },
  {
    "id": "s0201",
    "blockIndex": 45,
    "zh": "去年號，稱元年，複姓拓跋氏。"
  },
  {
    "id": "s0201",
    "blockIndex": 45,
    "zh": "九十九姓改為單者，皆復其舊。"
  },
  {
    "id": "s0201",
    "blockIndex": 45,
    "zh": "魏初統國三十六，大姓九十九，後多滅絕。"
  },
  {
    "id": "s0201",
    "blockIndex": 45,
    "zh": "泰乃以諸將功高者為三十六國，次者為九十九姓，所將士卒亦改從其姓。"
  },
  {
    "id": "s0212",
    "blockIndex": 46,
    "zh": "三月，丁亥，長沙王韶取巴郡。"
  },
  {
    "id": "s0213",
    "blockIndex": 47,
    "zh": "甲辰，以王僧辯為太尉、車騎大將軍。"
  },
  {
    "id": "s0214",
    "blockIndex": 48,
    "zh": "丁未，齊將王球攻宿預，杜僧明出擊，大破之，球歸彭城。"
  },
  {
    "id": "s0215",
    "blockIndex": 49,
    "zh": "郢州刺史陸法和上啟自稱司徒，上怪之。"
  },
  {
    "id": "s0215",
    "blockIndex": 49,
    "zh": "王褒曰：「法和既有道術，容或先知。"
  },
  {
    "id": "s0215",
    "blockIndex": 49,
    "zh": "」戊申，上就拜法和為司徒。"
  },
  {
    "id": "s0218",
    "blockIndex": 50,
    "zh": "己酉，魏侍中宇文仁恕來聘。"
  },
  {
    "id": "s0218",
    "blockIndex": 50,
    "zh": "會齊使者亦至江陵，帝接仁恕不及齊使，仁恕歸，以告太師泰。"
  },
  {
    "id": "s0218",
    "blockIndex": 50,
    "zh": "帝又請據舊圖定疆境，辭頗不遜，泰曰：「古人有言，『天之所棄，誰能興之』，其蕭繹之謂乎！"
  },
  {
    "id": "s0218",
    "blockIndex": 50,
    "zh": "」荊州刺史長孫儉屢陳攻取之策，泰征儉入朝，問以經略，覆命還鎮，密為之備。"
  },
  {
    "id": "s0218",
    "blockIndex": 50,
    "zh": "馬伯符密使告帝，帝弗之信。"
  },
  {
    "id": "s0223",
    "blockIndex": 51,
    "zh": "柔然可汗庵羅辰叛齊，齊主自將出擊，大破之，庵羅辰父子北走。"
  },
  {
    "id": "s0223",
    "blockIndex": 51,
    "zh": "太保安定王賀拔仁獻馬不甚駿，齊主怒，拔其發，免為庶人，輸晉陽負炭。"
  },
  {
    "id": "s0225",
    "blockIndex": 52,
    "zh": "齊中書令魏收撰《魏書》，頗用愛憎為褒貶，每謂人曰：「何物小子，敢與魏收作色！"
  },
  {
    "id": "s0225",
    "blockIndex": 52,
    "zh": "舉之則使升天，按之則使入地！"
  },
  {
    "id": "s0225",
    "blockIndex": 52,
    "zh": "」既成，中書舍人盧潛奏：「收誣罔一代，罪當誅！"
  },
  {
    "id": "s0225",
    "blockIndex": 52,
    "zh": "」尚書左丞盧斐、頓丘李庶皆言《魏史》不直。"
  },
  {
    "id": "s0225",
    "blockIndex": 52,
    "zh": "收啟齊主云：「臣既結怨強宗，將為刺客所殺。"
  },
  {
    "id": "s0225",
    "blockIndex": 52,
    "zh": "」帝怒，於是斐、庶及尚書郎中王松年皆坐謗史，鞭二百，配甲坊。"
  },
  {
    "id": "s0225",
    "blockIndex": 52,
    "zh": "斐、庶死於獄中，潛亦坐繫獄。"
  },
  {
    "id": "s0225",
    "blockIndex": 52,
    "zh": "然時人終不服，謂之「穢史」。"
  },
  {
    "id": "s0225",
    "blockIndex": 52,
    "zh": "潛，度世之曾孫；"
  },
  {
    "id": "s0225",
    "blockIndex": 52,
    "zh": "斐，同之子；"
  },
  {
    "id": "s0225",
    "blockIndex": 52,
    "zh": "松年，遵業之子也。"
  },
  {
    "id": "s0236",
    "blockIndex": 53,
    "zh": "夏，四月，柔然寇齊肆州，齊主自晉陽討之，至恆州，柔然散走。"
  },
  {
    "id": "s0236",
    "blockIndex": 53,
    "zh": "帝以二千餘騎為殿，宿黃瓜堆。"
  },
  {
    "id": "s0236",
    "blockIndex": 53,
    "zh": "柔然別部數萬騎奄至，帝安臥，平明乃起，神色自若，指畫形勢，縱兵奮擊。"
  },
  {
    "id": "s0236",
    "blockIndex": 53,
    "zh": "柔然披靡，因潰圍而出。"
  },
  {
    "id": "s0236",
    "blockIndex": 53,
    "zh": "柔然走，追擊之，伏屍二十餘里，獲庵羅辰妻子，虜三萬餘口，令都督善無高阿那肱帥騎數千塞其走路。"
  },
  {
    "id": "s0236",
    "blockIndex": 53,
    "zh": "時柔然軍猶盛，阿那肱以兵少，請益，帝更減其半。"
  },
  {
    "id": "s0236",
    "blockIndex": 53,
    "zh": "阿那肱奮擊，大破之。"
  },
  {
    "id": "s0236",
    "blockIndex": 53,
    "zh": "庵羅辰超越巖谷，僅以身免。"
  },
  {
    "id": "s0244",
    "blockIndex": 54,
    "zh": "丙寅，上使散騎常侍庾信等聘於魏。"
  },
  {
    "id": "s0245",
    "blockIndex": 55,
    "zh": "癸酉，以陳霸先為司空。"
  },
  {
    "id": "s0246",
    "blockIndex": 56,
    "zh": "丁未，齊主復自擊柔然，大破之。"
  },
  {
    "id": "s0247",
    "blockIndex": 57,
    "zh": "庚戌，魏太師泰鴆殺廢帝。"
  },
  {
    "id": "s0248",
    "blockIndex": 58,
    "zh": "五月，魏直州人樂熾、洋州人黃國等作亂，開府儀同三司高平田弘、河南賀若敦討之，不克。"
  },
  {
    "id": "s0248",
    "blockIndex": 58,
    "zh": "太師泰命車騎大將軍李遷哲與敦共討熾等，平之。"
  },
  {
    "id": "s0248",
    "blockIndex": 58,
    "zh": "仍與敦南出，徇地至巴州，巴州刺史牟安民降之，巴、濮之民皆附於魏。"
  },
  {
    "id": "s0248",
    "blockIndex": 58,
    "zh": "蠻酋向五子王等陷白帝，遷哲擊之，五子王等遁去，遷哲追擊，破之。"
  },
  {
    "id": "s0248",
    "blockIndex": 58,
    "zh": "泰以遷哲為信州刺史，鎮白帝。"
  },
  {
    "id": "s0248",
    "blockIndex": 58,
    "zh": "信州先無儲蓄，遷哲與軍士共采葛根為糧，時有異味，輒分嘗之，軍士感悅。"
  },
  {
    "id": "s0248",
    "blockIndex": 58,
    "zh": "屢擊叛蠻，破之，群蠻懾服，皆送糧餼，遣子弟入質。"
  },
  {
    "id": "s0248",
    "blockIndex": 58,
    "zh": "由是州境安息，軍儲亦贍。"
  },
  {
    "id": "s0256",
    "blockIndex": 59,
    "zh": "柔然乙旃達官寇魏廣武，柱國李弼追擊，破之。"
  },
  {
    "id": "s0257",
    "blockIndex": 60,
    "zh": "廣州刺史曲江侯勃，自以非上所授，內不自安，上亦疑之。"
  },
  {
    "id": "s0257",
    "blockIndex": 60,
    "zh": "勃啟求入朝；"
  },
  {
    "id": "s0257",
    "blockIndex": 60,
    "zh": "五月，乙巳，上以王琳為廣州刺史，勃為晉州刺史。"
  },
  {
    "id": "s0257",
    "blockIndex": 60,
    "zh": "上以琳部眾強盛，又得眾心，故欲遠之。"
  },
  {
    "id": "s0257",
    "blockIndex": 60,
    "zh": "琳與主書廣漢李膺厚善，私謂膺曰：「琳，小人也，蒙官拔擢至此。"
  },
  {
    "id": "s0257",
    "blockIndex": 60,
    "zh": "今天下未定，遷琳嶺南，如有不虞，安得琳力！"
  },
  {
    "id": "s0257",
    "blockIndex": 60,
    "zh": "竊揆官意不過疑琳，琳分望有限，豈與官爭為帝乎！"
  },
  {
    "id": "s0257",
    "blockIndex": 60,
    "zh": "何不以琳為雍州刺史，鎮武寧，琳自放兵作田，為國御捍。"
  },
  {
    "id": "s0257",
    "blockIndex": 60,
    "zh": "」膺然其言而弗敢啟。"
  },
  {
    "id": "s0266",
    "blockIndex": 61,
    "zh": "散騎郎新野庾季才言於上曰：「去年八月丙申，月犯心中星，今月丙戌，赤氣干北斗。"
  },
  {
    "id": "s0266",
    "blockIndex": 61,
    "zh": "心為天王，丙主楚分，臣恐建子之月有大兵入江陵。"
  },
  {
    "id": "s0266",
    "blockIndex": 61,
    "zh": "陛下宜留重臣鎮江陵，整旆還都以避其患。"
  },
  {
    "id": "s0266",
    "blockIndex": 61,
    "zh": "假令魏虜侵蹙，止失荊、湘，在於社稷，猶得無慮。"
  },
  {
    "id": "s0266",
    "blockIndex": 61,
    "zh": "」上亦曉天文，知楚有災，歎曰：「禍福在天，避之何益！"
  },
  {
    "id": "s0272",
    "blockIndex": 62,
    "zh": "六月，壬午，齊步大汗薩將兵四萬趣涇州，王僧辯使侯瑱、張彪自石樑引兵助嚴超達拒之，瑱、彪遲留不進。"
  },
  {
    "id": "s0272",
    "blockIndex": 62,
    "zh": "將軍尹令思將萬餘人謀襲盱眙。"
  },
  {
    "id": "s0272",
    "blockIndex": 62,
    "zh": "齊冀州刺史段韶將兵討東方白額於宿預，廣陵、涇州皆來告急，諸將患之。"
  },
  {
    "id": "s0272",
    "blockIndex": 62,
    "zh": "韶曰：「梁氏喪亂，國無定主，人懷去就，強者從之。"
  },
  {
    "id": "s0272",
    "blockIndex": 62,
    "zh": "霸先等外托同德，內有離心，諸君不足憂，吾揣之熟矣！"
  },
  {
    "id": "s0272",
    "blockIndex": 62,
    "zh": "」乃留儀同三司敬顯攜等圍宿預，自引兵倍道趣涇州，塗出盱眙。"
  },
  {
    "id": "s0272",
    "blockIndex": 62,
    "zh": "令思不意齊兵猝至，望風退走。"
  },
  {
    "id": "s0272",
    "blockIndex": 62,
    "zh": "韶進擊超達，破之，回趣廣陵，陳霸先解圍走。"
  },
  {
    "id": "s0272",
    "blockIndex": 62,
    "zh": "杜僧明還丹徒，侯瑱、張彪還秦郡。"
  },
  {
    "id": "s0272",
    "blockIndex": 62,
    "zh": "吳明徹圍海西，鎮將中山郎基固守，削木為箭，剪紙為羽。"
  },
  {
    "id": "s0272",
    "blockIndex": 62,
    "zh": "圍之十旬，卒不能克而還。"
  },
  {
    "id": "s0283",
    "blockIndex": 63,
    "zh": "柔然帥餘眾東徙，且欲南寇，齊主帥輕騎邀之於金川。"
  },
  {
    "id": "s0283",
    "blockIndex": 63,
    "zh": "柔然聞之，遠遁，營州刺史靈丘王峻設伏擊之，獲其名王數十人。"
  },
  {
    "id": "s0285",
    "blockIndex": 64,
    "zh": "鄧至羌簷桁失國，奔魏，太師泰使秦州刺史宇文導將兵納之。"
  },
  {
    "id": "s0286",
    "blockIndex": 65,
    "zh": "齊段韶還至宿預，使辯士說東方白額，白額開門請盟，因執而斬之。"
  },
  {
    "id": "s0287",
    "blockIndex": 66,
    "zh": "秋，七月，庚戌，齊主還鄴。"
  },
  {
    "id": "s0288",
    "blockIndex": 67,
    "zh": "魏太師泰西巡，至原州。"
  },
  {
    "id": "s0289",
    "blockIndex": 68,
    "zh": "八月，千辰，齊以司州牧清河王岳為太保，司空尉粲為司徒，太子太師侯莫陳相為司空，尚書令平陽王淹錄尚書事，常山王演為尚書令，中書令上黨王渙為左僕射。"
  },
  {
    "id": "s0290",
    "blockIndex": 69,
    "zh": "乙亥，齊儀同三司元旭坐事賜死。"
  },
  {
    "id": "s0290",
    "blockIndex": 69,
    "zh": "丁丑，齊主如晉陽。"
  },
  {
    "id": "s0290",
    "blockIndex": 69,
    "zh": "齊主之未為魏相也，太保、錄尚書事平原王高隆之常侮之，及將受禪，隆之復以為不可，齊主由是銜之。"
  },
  {
    "id": "s0290",
    "blockIndex": 69,
    "zh": "崔季舒譖「隆之每見訴訟者輒加哀矜之意，以示非己能裁。"
  },
  {
    "id": "s0290",
    "blockIndex": 69,
    "zh": "」帝禁之尚書省。"
  },
  {
    "id": "s0290",
    "blockIndex": 69,
    "zh": "隆之嘗與元旭飲，謂旭曰：「與王交，當生死不相負。"
  },
  {
    "id": "s0290",
    "blockIndex": 69,
    "zh": "」人有密言之者，帝由是發怒，令壯士築百餘拳而捨之。"
  },
  {
    "id": "s0290",
    "blockIndex": 69,
    "zh": "辛巳，卒於路。"
  },
  {
    "id": "s0290",
    "blockIndex": 69,
    "zh": "久之，帝追忿隆之，執其子慧登等二十人於前，帝以鞭叩鞍，一時頭絕，並投屍漳水；"
  },
  {
    "id": "s0290",
    "blockIndex": 69,
    "zh": "又發隆之塚，出其屍，斬截骸骨焚之，棄於漳水。"
  },
  {
    "id": "s0300",
    "blockIndex": 70,
    "zh": "齊主使常山王演、上黨王渙、清河王岳、平原王段韶帥眾於洛陽西南築伐惡城、新城、嚴城、河南城。"
  },
  {
    "id": "s0300",
    "blockIndex": 70,
    "zh": "九月，齊主巡四城，欲以致魏師，魏師不出，乃如晉陽。"
  },
  {
    "id": "s0302",
    "blockIndex": 71,
    "zh": "魏宇文泰命侍中崔猷開回車路以通漢中。"
  },
  {
    "id": "s0303",
    "blockIndex": 72,
    "zh": "帝好玄談，辛卯，於龍光殿講《老子》。"
  },
  {
    "id": "s0304",
    "blockIndex": 73,
    "zh": "曲江侯勃遷居始興，王琳使副將孫瑒先行據番禺。"
  },
  {
    "id": "s0305",
    "blockIndex": 74,
    "zh": "乙巳，魏遣柱國常山公於謹、中山公宇文護、大將軍楊忠將兵五萬入寇。"
  },
  {
    "id": "s0305",
    "blockIndex": 74,
    "zh": "冬，十月，壬戌，發長安。"
  },
  {
    "id": "s0305",
    "blockIndex": 74,
    "zh": "長孫儉問謹曰：「為蕭繹之計，將如何？"
  },
  {
    "id": "s0305",
    "blockIndex": 74,
    "zh": "」謹曰：「耀兵漢、沔，席捲度江，直據丹楊，上策也；"
  },
  {
    "id": "s0305",
    "blockIndex": 74,
    "zh": "移郭內居民退保子城，峻其陴堞，以待援軍，中策也；"
  },
  {
    "id": "s0305",
    "blockIndex": 74,
    "zh": "若難於移動，據守羅郭，下策也。"
  },
  {
    "id": "s0305",
    "blockIndex": 74,
    "zh": "」儉曰：「揣繹定出何策？"
  },
  {
    "id": "s0305",
    "blockIndex": 74,
    "zh": "」謹曰：「下策。"
  },
  {
    "id": "s0305",
    "blockIndex": 74,
    "zh": "」儉曰：「何故？"
  },
  {
    "id": "s0305",
    "blockIndex": 74,
    "zh": "」謹曰：「蕭氏保據江南，綿歷數紀，屬中原多故，未遑外略；"
  },
  {
    "id": "s0305",
    "blockIndex": 74,
    "zh": "又以我有齊氏之患，必謂力不能分。"
  },
  {
    "id": "s0305",
    "blockIndex": 74,
    "zh": "且繹懦而無謀，多疑少斷。"
  },
  {
    "id": "s0305",
    "blockIndex": 74,
    "zh": "愚民難與慮始，皆戀邑居，所以知其用下策也。"
  },
  {
    "id": "s0319",
    "blockIndex": 75,
    "zh": "癸亥，武寧太守宗均告魏兵且至，帝召公卿議之。"
  },
  {
    "id": "s0319",
    "blockIndex": 75,
    "zh": "領軍胡僧祐、太府卿黃羅漢曰：「二國通好，未有嫌隙，必應不爾。"
  },
  {
    "id": "s0319",
    "blockIndex": 75,
    "zh": "」侍中王琛曰：「臣揣宇文容色，必無此理。"
  },
  {
    "id": "s0319",
    "blockIndex": 75,
    "zh": "」乃復使琛使魏。"
  },
  {
    "id": "s0319",
    "blockIndex": 75,
    "zh": "丙寅，於謹至樊、鄧，梁王察帥眾會之。"
  },
  {
    "id": "s0319",
    "blockIndex": 75,
    "zh": "丁卯，帝停講，內外戒嚴。"
  },
  {
    "id": "s0319",
    "blockIndex": 75,
    "zh": "王琛至石梵，未見魏軍，馳書報黃羅漢曰：「吾至石梵，境上帖然，前言皆兒戲耳。"
  },
  {
    "id": "s0319",
    "blockIndex": 75,
    "zh": "」帝聞而疑之。"
  },
  {
    "id": "s0319",
    "blockIndex": 75,
    "zh": "庚午，復講，百官戎服以聽。"
  },
  {
    "id": "s0319",
    "blockIndex": 75,
    "zh": "辛未，帝使主書李膺至建康，征王僧辯為大都督、荊州刺史，命陳霸先徙鎮揚州。"
  },
  {
    "id": "s0319",
    "blockIndex": 75,
    "zh": "僧辯遣豫州刺史侯瑱帥程靈洗等為前軍，兗州刺史杜僧明帥吳明徹等為後軍。"
  },
  {
    "id": "s0319",
    "blockIndex": 75,
    "zh": "甲戌，帝夜登鳳皇閣，徙倚歎息曰：「客星入翼、軫、今必敗矣！"
  },
  {
    "id": "s0319",
    "blockIndex": 75,
    "zh": "」嬪御皆泣。"
  },
  {
    "id": "s0332",
    "blockIndex": 76,
    "zh": "陸法和聞魏師至，自郢州入漢口，將赴江陵。"
  },
  {
    "id": "s0332",
    "blockIndex": 76,
    "zh": "帝使逆之曰：「此自能破賊，但鎮郢州，不須動也！"
  },
  {
    "id": "s0332",
    "blockIndex": 76,
    "zh": "」法和還州，堊其城門，著衰絰，坐葦席，終日，乃脫之。"
  },
  {
    "id": "s0335",
    "blockIndex": 77,
    "zh": "十一月，帝大閱於津陽門外，遇北風暴雨，輕輦還宮。"
  },
  {
    "id": "s0335",
    "blockIndex": 77,
    "zh": "癸未，魏軍濟漢，於謹令宇文護、楊忠帥精騎先據江津，斷東路。"
  },
  {
    "id": "s0335",
    "blockIndex": 77,
    "zh": "甲申，護克武寧，執宗均。"
  },
  {
    "id": "s0335",
    "blockIndex": 77,
    "zh": "是日，帝乘馬出城行柵，插木為之，周圍六十餘里。"
  },
  {
    "id": "s0335",
    "blockIndex": 77,
    "zh": "以領軍將軍胡僧祐都督城東諸軍事，尚書右僕射張綰為之副，左僕射王褒都督城西諸軍事，四廂領直元景亮為之副；"
  },
  {
    "id": "s0335",
    "blockIndex": 77,
    "zh": "王公已下各有所守。"
  },
  {
    "id": "s0335",
    "blockIndex": 77,
    "zh": "丙戌，命太子巡行城樓，令居人助運木石。"
  },
  {
    "id": "s0335",
    "blockIndex": 77,
    "zh": "夜，魏軍至黃華，去江陵四十里，丁亥，至柵下。"
  },
  {
    "id": "s0335",
    "blockIndex": 77,
    "zh": "戊子，巂州刺史裴畿、畿弟新興太守機、武昌太守朱買臣、衡陽太守謝答仁開枇杷門出戰，裴機殺魏儀同三司胡文伐。"
  },
  {
    "id": "s0335",
    "blockIndex": 77,
    "zh": "畿，之高之子也。"
  },
  {
    "id": "s0345",
    "blockIndex": 78,
    "zh": "帝征廣州刺史王琳為湘州刺史，使引兵入援。"
  },
  {
    "id": "s0345",
    "blockIndex": 78,
    "zh": "丁酉，柵內火，焚數千家及城樓二十五，帝臨所焚樓，望魏軍濟江，四顧歎息。"
  },
  {
    "id": "s0345",
    "blockIndex": 78,
    "zh": "是夜，遂止宮外，宿民家。"
  },
  {
    "id": "s0345",
    "blockIndex": 78,
    "zh": "己亥，稱居示氐洹寺。"
  },
  {
    "id": "s0345",
    "blockIndex": 78,
    "zh": "於謹令築長圍，中外信命始絕。"
  },
  {
    "id": "s0350",
    "blockIndex": 79,
    "zh": "庚子，信州刺史徐世譜、晉安王司馬任約等築壘於馬頭，遙為聲援。"
  },
  {
    "id": "s0350",
    "blockIndex": 79,
    "zh": "是夜，帝巡城，猶口占為詩，群臣亦有和者。"
  },
  {
    "id": "s0350",
    "blockIndex": 79,
    "zh": "帝裂帛為書，趣王僧辯曰：「吾忍死待公，可以至矣！"
  },
  {
    "id": "s0350",
    "blockIndex": 79,
    "zh": "」壬寅，還宮；"
  },
  {
    "id": "s0350",
    "blockIndex": 79,
    "zh": "癸卯，出長沙寺。"
  },
  {
    "id": "s0350",
    "blockIndex": 79,
    "zh": "戊申，王褒、胡僧祐、朱買臣、謝答仁等開門出戰，皆敗還。"
  },
  {
    "id": "s0350",
    "blockIndex": 79,
    "zh": "己酉，帝移居天居寺；"
  },
  {
    "id": "s0350",
    "blockIndex": 79,
    "zh": "癸丑，移居長沙寺。"
  },
  {
    "id": "s0350",
    "blockIndex": 79,
    "zh": "朱買臣按劍進曰：「唯斬宗懍、黃羅漢，可以謝天下！"
  },
  {
    "id": "s0350",
    "blockIndex": 79,
    "zh": "」帝曰：「曩實吾意，宗、黃何罪！"
  },
  {
    "id": "s0350",
    "blockIndex": 79,
    "zh": "」二人退入眾中。"
  },
  {
    "id": "s0361",
    "blockIndex": 80,
    "zh": "王琳軍至長沙，鎮南府長史裴政請間道先報江陵，至百里洲，為魏人所獲。"
  },
  {
    "id": "s0361",
    "blockIndex": 80,
    "zh": "梁王察謂政曰：「我，武皇帝之孫也，不可為爾君乎？"
  },
  {
    "id": "s0361",
    "blockIndex": 80,
    "zh": "若從我計，貴及子孫；"
  },
  {
    "id": "s0361",
    "blockIndex": 80,
    "zh": "如或不然，腰領分矣。"
  },
  {
    "id": "s0361",
    "blockIndex": 80,
    "zh": "」政詭對曰：「唯命。"
  },
  {
    "id": "s0361",
    "blockIndex": 80,
    "zh": "」察鎖之至城下，使言曰：「王僧辯聞台城被圍，已自為帝。"
  },
  {
    "id": "s0361",
    "blockIndex": 80,
    "zh": "王琳孤弱，不復能來。"
  },
  {
    "id": "s0361",
    "blockIndex": 80,
    "zh": "」政告城中曰：「援兵大至，各思自勉。"
  },
  {
    "id": "s0361",
    "blockIndex": 80,
    "zh": "吾以間使被擒，當碎身報國。"
  },
  {
    "id": "s0361",
    "blockIndex": 80,
    "zh": "」監者擊其口，察怒，命速殺之。"
  },
  {
    "id": "s0361",
    "blockIndex": 80,
    "zh": "西中郎參軍蔡大業諫曰：「此民望也，殺之，則荊州不可下矣。"
  },
  {
    "id": "s0361",
    "blockIndex": 80,
    "zh": "」乃釋之。"
  },
  {
    "id": "s0361",
    "blockIndex": 80,
    "zh": "政，之禮之子；"
  },
  {
    "id": "s0361",
    "blockIndex": 80,
    "zh": "大業，大寶之弟也。"
  },
  {
    "id": "s0375",
    "blockIndex": 81,
    "zh": "時徵兵四方，皆未至。"
  },
  {
    "id": "s0375",
    "blockIndex": 81,
    "zh": "甲寅，魏人百道攻城，城中負戶蒙楯，胡僧祐親當矢石，盡夜督戰，獎勵將士，明行賞罰，眾鹹致死，所向摧殄，魏不得前。"
  },
  {
    "id": "s0375",
    "blockIndex": 81,
    "zh": "俄而僧祐中流矢死，內外大駭。"
  },
  {
    "id": "s0375",
    "blockIndex": 81,
    "zh": "魏悉眾攻柵，反者開西門納魏師，帝與太子、王褒、謝答仁、朱買臣退保金城，令汝南王大封、晉熙王大圓質于于謹以請和。"
  },
  {
    "id": "s0375",
    "blockIndex": 81,
    "zh": "魏軍之初至也，眾以王僧辯子侍中顗可為都督，帝不用，更奪其兵，使與左右十人入守殿中；"
  },
  {
    "id": "s0375",
    "blockIndex": 81,
    "zh": "及胡僧祐死，乃用為都督城諸軍事。"
  },
  {
    "id": "s0375",
    "blockIndex": 81,
    "zh": "裴畿、裴機、歷陽侯峻皆出降。"
  },
  {
    "id": "s0375",
    "blockIndex": 81,
    "zh": "於謹以機手殺胡文伐，並畿殺之。"
  },
  {
    "id": "s0375",
    "blockIndex": 81,
    "zh": "峻，淵猷之子也。"
  },
  {
    "id": "s0375",
    "blockIndex": 81,
    "zh": "時城南雖破，而城北諸將猶苦戰。"
  },
  {
    "id": "s0375",
    "blockIndex": 81,
    "zh": "日暝，聞城陷，乃散。"
  },
  {
    "id": "s0386",
    "blockIndex": 82,
    "zh": "帝入東閣竹殿，命舍人高善寶焚古今圖書十四萬卷，將自赴火，宮人左右共止之。"
  },
  {
    "id": "s0386",
    "blockIndex": 82,
    "zh": "又以寶劍斫柱令折，歎曰：「文武之道，今夜盡矣！"
  },
  {
    "id": "s0386",
    "blockIndex": 82,
    "zh": "」乃使御史中丞王孝祀作降文。"
  },
  {
    "id": "s0386",
    "blockIndex": 82,
    "zh": "謝答仁、朱買臣諫曰：「城中兵眾猶強，乘暗突圍而出，賊必驚，因而薄之，可渡江就任約。"
  },
  {
    "id": "s0386",
    "blockIndex": 82,
    "zh": "」帝素不便走馬，曰：「事必無成，只增辱耳！"
  },
  {
    "id": "s0386",
    "blockIndex": 82,
    "zh": "」答仁求自扶，帝以問王褒，褒曰：「答仁，侯景之黨，豈足可信！"
  },
  {
    "id": "s0386",
    "blockIndex": 82,
    "zh": "成彼之勳，不如降也。"
  },
  {
    "id": "s0386",
    "blockIndex": 82,
    "zh": "」答仁又請守子城，收兵可得五千人，帝然之，即授城中大都督，配以公主。"
  },
  {
    "id": "s0386",
    "blockIndex": 82,
    "zh": "既而召王褒謀之，以為不可。"
  },
  {
    "id": "s0386",
    "blockIndex": 82,
    "zh": "答仁請入不得，歐血而去。"
  },
  {
    "id": "s0386",
    "blockIndex": 82,
    "zh": "於謹征太子為質，帝使王褒送之。"
  },
  {
    "id": "s0386",
    "blockIndex": 82,
    "zh": "謹子以褒善書，給之紙筆，褒乃書曰：「柱國常山公家奴王褒。"
  },
  {
    "id": "s0386",
    "blockIndex": 82,
    "zh": "」有頃，黃門郎裴政犯門而出。"
  },
  {
    "id": "s0386",
    "blockIndex": 82,
    "zh": "帝遂去羽儀文物，白馬素衣出東門，抽劍擊闔曰：「蕭世誠一至此乎！"
  },
  {
    "id": "s0386",
    "blockIndex": 82,
    "zh": "」魏軍士度塹牽其轡，至白馬寺北，奪其所乘駿馬，以駑馬代之，遣長壯胡人手扼其背以行，逢於謹，胡人牽帝使拜。"
  },
  {
    "id": "s0386",
    "blockIndex": 82,
    "zh": "梁王察使鐵騎擁帝入營，囚於烏幔之下，甚為察所詰辱。"
  },
  {
    "id": "s0386",
    "blockIndex": 82,
    "zh": "乙卯，於謹令開府儀同三司長孫儉入據金城。"
  },
  {
    "id": "s0386",
    "blockIndex": 82,
    "zh": "帝紿儉云：「城中埋金千斤，欲以相贈。"
  },
  {
    "id": "s0386",
    "blockIndex": 82,
    "zh": "」儉乃將帝入城。"
  },
  {
    "id": "s0386",
    "blockIndex": 82,
    "zh": "帝因述察見辱之狀，謂儉曰：「向聊相紿，欲言此耳，豈有天子自埋金乎！"
  },
  {
    "id": "s0386",
    "blockIndex": 82,
    "zh": "」儉乃留帝於主衣庫。"
  },
  {
    "id": "s0407",
    "blockIndex": 83,
    "zh": "帝性殘忍，且懲高祖寬縱之弊，故為政尚嚴。"
  },
  {
    "id": "s0407",
    "blockIndex": 83,
    "zh": "及魏師圍城，獄中死囚且數千人，有司請釋之以充戰士；"
  },
  {
    "id": "s0407",
    "blockIndex": 83,
    "zh": "帝不許，悉令棓殺之，事未成而城陷。"
  },
  {
    "id": "s0410",
    "blockIndex": 84,
    "zh": "中書郎殷不害先於別所督戰，城陷，失其母。"
  },
  {
    "id": "s0410",
    "blockIndex": 84,
    "zh": "時冰雪交積，凍死者填滿溝塹。"
  },
  {
    "id": "s0410",
    "blockIndex": 84,
    "zh": "不害行哭於道，求其母屍，無所不至。"
  },
  {
    "id": "s0410",
    "blockIndex": 84,
    "zh": "見溝中死人，輒投下捧視，舉體凍濕，水漿不入口，號哭不輟聲。"
  },
  {
    "id": "s0410",
    "blockIndex": 84,
    "zh": "如是七日，乃得之。"
  },
  {
    "id": "s0415",
    "blockIndex": 85,
    "zh": "十二月，丙辰，徐世譜、任約退戍巴陵。"
  },
  {
    "id": "s0415",
    "blockIndex": 85,
    "zh": "於謹逼帝使為書召王僧辯，帝不可。"
  },
  {
    "id": "s0415",
    "blockIndex": 85,
    "zh": "使者曰：「王今豈得自由？"
  },
  {
    "id": "s0415",
    "blockIndex": 85,
    "zh": "」帝曰：「我既不自由，僧辯亦不由我。"
  },
  {
    "id": "s0415",
    "blockIndex": 85,
    "zh": "」又從長孫儉求宮人王氏、苟氏及幼子犀首，儉並還之。"
  },
  {
    "id": "s0415",
    "blockIndex": 85,
    "zh": "或問：「何意焚書？"
  },
  {
    "id": "s0415",
    "blockIndex": 85,
    "zh": "」帝曰：「讀書萬卷，猶有今日，故焚之！"
  },
  {
    "id": "s0423",
    "blockIndex": 86,
    "zh": "庚申，齊主北巡，至達速嶺，行視山川險要，將起長城。"
  },
  {
    "id": "s0424",
    "blockIndex": 87,
    "zh": "辛未，帝為魏人所殺。"
  },
  {
    "id": "s0424",
    "blockIndex": 87,
    "zh": "梁王察遣尚書傅准監刑，以土囊隕之。"
  },
  {
    "id": "s0424",
    "blockIndex": 87,
    "zh": "察使以布帕纏屍，斂以蒲席，束以白茅，葬於津陽門外。"
  },
  {
    "id": "s0424",
    "blockIndex": 87,
    "zh": "並殺愍懷太子元良、始安王方略、桂陽王大成等。"
  },
  {
    "id": "s0424",
    "blockIndex": 87,
    "zh": "世祖性好書，常令左右讀書，晝夜不絕，雖熟睡，卷猶不釋，或差誤及欺之，帝輒驚寤。"
  },
  {
    "id": "s0424",
    "blockIndex": 87,
    "zh": "作文章，援筆立就。"
  },
  {
    "id": "s0424",
    "blockIndex": 87,
    "zh": "常言：「我韜於文士，愧於武夫。"
  },
  {
    "id": "s0424",
    "blockIndex": 87,
    "zh": "」論者以為得言。"
  },
  {
    "id": "s0424",
    "blockIndex": 87,
    "zh": "魏立梁王察為梁主，資以荊州之地，延袤三百里，仍取其雍州之地。"
  },
  {
    "id": "s0424",
    "blockIndex": 87,
    "zh": "察居江陵東城，魏置防主，將兵居西城，名曰助防，外示助察備御，內實防之。"
  },
  {
    "id": "s0424",
    "blockIndex": 87,
    "zh": "以前儀同三司王悅留鎮江陵。"
  },
  {
    "id": "s0424",
    "blockIndex": 87,
    "zh": "於謹收府庫珍寶及宋渾天儀、梁銅晷表、大玉徑四尺及諸法物；"
  },
  {
    "id": "s0424",
    "blockIndex": 87,
    "zh": "盡俘王公以下及選百姓男女數萬口為奴婢，分賞三軍，驅歸長安，小弱者皆殺之。"
  },
  {
    "id": "s0424",
    "blockIndex": 87,
    "zh": "得免者三百餘家，而人馬所踐及凍死者什二三。"
  },
  {
    "id": "s0438",
    "blockIndex": 88,
    "zh": "魏師之在江陵也，梁王察將尹德毅說察曰：「魏虜貪惏，肆其殘忍，殺掠士民，不可勝紀。"
  },
  {
    "id": "s0438",
    "blockIndex": 88,
    "zh": "江東之人塗炭至此，鹹謂殿下為之。"
  },
  {
    "id": "s0438",
    "blockIndex": 88,
    "zh": "殿下既殺人父兄，孤人子弟，人盡仇也，誰與為國！"
  },
  {
    "id": "s0438",
    "blockIndex": 88,
    "zh": "今魏之精銳盡萃於此，若殿下為設享會，請於謹等為歡，預伏武士，因而斃之，分命諸將，掩其營壘，大殲群丑，俾無遺類。"
  },
  {
    "id": "s0438",
    "blockIndex": 88,
    "zh": "收江陵百姓，撫而安之，文武群寮，隨材銓授。"
  },
  {
    "id": "s0438",
    "blockIndex": 88,
    "zh": "魏人懾息，未敢送死，王僧辯之徒，折簡可致。"
  },
  {
    "id": "s0438",
    "blockIndex": 88,
    "zh": "然後朝服濟江，入踐皇極，晷刻之間，大功可立。"
  },
  {
    "id": "s0438",
    "blockIndex": 88,
    "zh": "古人云：『天與不取，反受其咎。"
  },
  {
    "id": "s0438",
    "blockIndex": 88,
    "zh": "』願殿下恢弘遠略，勿懷匹夫之行。"
  },
  {
    "id": "s0438",
    "blockIndex": 88,
    "zh": "」察曰：「卿此策非不善也，然魏人待我厚，未可背德。"
  },
  {
    "id": "s0438",
    "blockIndex": 88,
    "zh": "若遽為卿計，人將不食吾餘。"
  },
  {
    "id": "s0438",
    "blockIndex": 88,
    "zh": "」既擊闔城長幼被虜，又失襄陽，察乃歎曰：「恨不用尹德毅之言！"
  },
  {
    "id": "s0451",
    "blockIndex": 89,
    "zh": "王僧辯、陳霸先等共奉江州刺史晉安王方智為太宰，承製。"
  },
  {
    "id": "s0452",
    "blockIndex": 90,
    "zh": "王褒、王克、劉□、宗懍、殷不害及尚書右丞吳興沈炯至長安，太師泰厚禮之。"
  },
  {
    "id": "s0452",
    "blockIndex": 90,
    "zh": "泰親至於謹第，宴勞極歡，賞謹奴婢千口及梁之寶物並雅樂一部，別封新野公；"
  },
  {
    "id": "s0452",
    "blockIndex": 90,
    "zh": "謹固辭，不許。"
  },
  {
    "id": "s0452",
    "blockIndex": 90,
    "zh": "謹自以久居重任，功名既立，欲保優閒，乃上先所乘駿馬及所著鎧甲等。"
  },
  {
    "id": "s0452",
    "blockIndex": 90,
    "zh": "泰識其意，曰：「今巨猾未平，公豈得遽爾獨善！"
  },
  {
    "id": "s0452",
    "blockIndex": 90,
    "zh": "」遂不受。"
  },
  {
    "id": "s0458",
    "blockIndex": 91,
    "zh": "是歲，魏秦州刺史章武孝公宇文導卒。"
  },
  {
    "id": "s0459",
    "blockIndex": 92,
    "zh": "魏加益州刺史尉遲迥督六州，通前十八州，自劍閣以南，得承製封拜及黜陟。"
  },
  {
    "id": "s0459",
    "blockIndex": 92,
    "zh": "迥明賞罰，布威恩，綏輯新民，經略未附，華、夷懷之。"
  },
  {
    "id": "s0461",
    "blockIndex": 93,
    "zh": "category:資治通鑑"
  }
]
