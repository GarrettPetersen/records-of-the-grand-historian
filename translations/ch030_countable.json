[
  {
    "id": "s0001",
    "blockIndex": 0,
    "zh": "起屠維赤奮若，盡著雍閹茂，凡十年。"
  },
  {
    "id": "s0003",
    "blockIndex": 1,
    "zh": "1　春，正月，乙丑，悼考廟災。"
  },
  {
    "id": "s0003",
    "blockIndex": 1,
    "zh": "----2　石顯遷長信中太僕，秩中二千石。"
  },
  {
    "id": "s0003",
    "blockIndex": 1,
    "zh": "顯旣失倚，離權，於是丞相、御史條奏顯舊惡；"
  },
  {
    "id": "s0003",
    "blockIndex": 1,
    "zh": "及其黨牢梁、陳順皆免官，顯與妻子徙歸故郡，憂懣不食，道死。"
  },
  {
    "id": "s0003",
    "blockIndex": 1,
    "zh": "諸所交結以顯爲官者，皆廢罷；"
  },
  {
    "id": "s0003",
    "blockIndex": 1,
    "zh": "少府五鹿充宗左遷玄菟太守，御史中丞伊嘉為鴈門都尉。"
  },
  {
    "id": "s0009",
    "blockIndex": 2,
    "zh": "司隸校尉涿郡王尊劾奏：「丞相衡、御史大夫譚，知顯等顓權擅勢，大作威福，爲海內患害，不以時白奏行罰；"
  },
  {
    "id": "s0009",
    "blockIndex": 2,
    "zh": "而阿諛曲從，附下罔上，懷邪迷國，無大臣輔政之義，皆不道！"
  },
  {
    "id": "s0009",
    "blockIndex": 2,
    "zh": "在赦令前。"
  },
  {
    "id": "s0009",
    "blockIndex": 2,
    "zh": "赦後，衡、譚舉奏顯，不自陳不忠之罪，而反揚著先帝任用傾覆之徒，妄言『百官畏之，甚於主上』；"
  },
  {
    "id": "s0009",
    "blockIndex": 2,
    "zh": "卑君尊臣，非所宜稱，失大臣體！"
  },
  {
    "id": "s0015",
    "blockIndex": 3,
    "zh": "於是衡慙懼，免冠謝罪，上丞相、侯印綬。"
  },
  {
    "id": "s0015",
    "blockIndex": 3,
    "zh": "天子以新卽位，重傷大臣，乃左遷尊爲高陵令。"
  },
  {
    "id": "s0015",
    "blockIndex": 3,
    "zh": "然羣下多是尊者。"
  },
  {
    "id": "s0015",
    "blockIndex": 3,
    "zh": "衡嘿嘿不自安，每有水旱，連乞骸骨讓位；"
  },
  {
    "id": "s0015",
    "blockIndex": 3,
    "zh": "上輒以詔書慰撫，不許。"
  },
  {
    "id": "s0015",
    "blockIndex": 3,
    "zh": "----3　立故河間王元弟上郡庫令良為河間王。"
  },
  {
    "id": "s0015",
    "blockIndex": 3,
    "zh": "----4　有星孛于營室。"
  },
  {
    "id": "s0015",
    "blockIndex": 3,
    "zh": "----5　赦天下。"
  },
  {
    "id": "s0015",
    "blockIndex": 3,
    "zh": "----6　壬子，封舅諸吏、光祿大夫、關內侯王崇爲安成侯；"
  },
  {
    "id": "s0015",
    "blockIndex": 3,
    "zh": "賜舅譚、商、立、根、逢時爵關內侯。"
  },
  {
    "id": "s0025",
    "blockIndex": 4,
    "zh": "夏，四月，黃霧四塞，詔博問公卿大夫，無有所諱。"
  },
  {
    "id": "s0025",
    "blockIndex": 4,
    "zh": "諫大夫楊興、博士駟勝等皆以為「陰盛侵陽之氣也。"
  },
  {
    "id": "s0025",
    "blockIndex": 4,
    "zh": "高祖之約，非功臣不侯；"
  },
  {
    "id": "s0025",
    "blockIndex": 4,
    "zh": "今太后諸弟皆以無功爲侯，外戚未曾有也，故天為見異。"
  },
  {
    "id": "s0025",
    "blockIndex": 4,
    "zh": "」於是大將軍鳳懼，上書乞骸骨，辭職；"
  },
  {
    "id": "s0025",
    "blockIndex": 4,
    "zh": "上優詔不許。"
  },
  {
    "id": "s0025",
    "blockIndex": 4,
    "zh": "----7　御史中丞東海薛宣上疏曰：「陛下至德仁厚，而嘉氣尚凝，陰陽不和，殆吏多苛政。"
  },
  {
    "id": "s0025",
    "blockIndex": 4,
    "zh": "部刺史或不循守條職，舉錯各以其意，多與郡縣事，至開私門，聽讒佞，以求吏民過，譴呵及細微，責義不量力；"
  },
  {
    "id": "s0025",
    "blockIndex": 4,
    "zh": "郡縣相迫促，亦內相刻，流及衆庶。"
  },
  {
    "id": "s0025",
    "blockIndex": 4,
    "zh": "是故鄕黨闕於嘉賓之懽，九族忘其親親之恩，飲食周急之厚彌衰，送往勞來之禮不行。"
  },
  {
    "id": "s0025",
    "blockIndex": 4,
    "zh": "夫人道不通則陰陽否隔，和氣不通，未必不由此也！"
  },
  {
    "id": "s0025",
    "blockIndex": 4,
    "zh": "《詩》云：『民之失德，乾餱以愆。"
  },
  {
    "id": "s0025",
    "blockIndex": 4,
    "zh": "』鄙語曰：『苛政不親，煩苦傷恩。"
  },
  {
    "id": "s0025",
    "blockIndex": 4,
    "zh": "』方刺史奏事時，宜明申敕，使昭然知本朝之要務。"
  },
  {
    "id": "s0025",
    "blockIndex": 4,
    "zh": "」上嘉納之。"
  },
  {
    "id": "s0025",
    "blockIndex": 4,
    "zh": "----8　八月，有兩月相承，晨見東方。"
  },
  {
    "id": "s0025",
    "blockIndex": 4,
    "zh": "----9　冬，十二月，作長安南、北郊，罷甘泉、汾陰祠，及紫壇偽飾、女樂、鸞路、騂駒、龍馬、石壇之屬。"
  },
  {
    "id": "s0043",
    "blockIndex": 5,
    "zh": "1　春，正月，罷雍五畤及陳寶祠，皆從匡衡之請也。"
  },
  {
    "id": "s0043",
    "blockIndex": 5,
    "zh": "辛巳，上始郊祀長安南郊。"
  },
  {
    "id": "s0043",
    "blockIndex": 5,
    "zh": "赦奉郊縣及中都官耐罪徒；"
  },
  {
    "id": "s0043",
    "blockIndex": 5,
    "zh": "減天下賦錢，算四十。"
  },
  {
    "id": "s0043",
    "blockIndex": 5,
    "zh": "----2　閏月，以渭城延陵亭部爲初陵。"
  },
  {
    "id": "s0043",
    "blockIndex": 5,
    "zh": "----3　三月，辛丑，上始祠-{后}-土于北郊。"
  },
  {
    "id": "s0043",
    "blockIndex": 5,
    "zh": "----4　丙午，立皇后許氏。"
  },
  {
    "id": "s0043",
    "blockIndex": 5,
    "zh": "后，車騎將軍嘉之女也。"
  },
  {
    "id": "s0043",
    "blockIndex": 5,
    "zh": "元帝傷母恭哀后居位日淺而遭霍氏之辜，故選嘉女以配太子。"
  },
  {
    "id": "s0043",
    "blockIndex": 5,
    "zh": "----5　上自爲太子時，以好色聞；"
  },
  {
    "id": "s0043",
    "blockIndex": 5,
    "zh": "及卽位，皇太后詔采良家女以備後宮。"
  },
  {
    "id": "s0043",
    "blockIndex": 5,
    "zh": "大將軍武庫令杜欽說王鳳曰：「禮，一娶九女，所以廣嗣重祖也；"
  },
  {
    "id": "s0043",
    "blockIndex": 5,
    "zh": "娣姪雖缺不復補，所以養壽塞爭也。"
  },
  {
    "id": "s0043",
    "blockIndex": 5,
    "zh": "故后妃有貞淑之行，則胤嗣有賢聖之君；"
  },
  {
    "id": "s0043",
    "blockIndex": 5,
    "zh": "制度有威儀之節，則人君有壽考之福。"
  },
  {
    "id": "s0043",
    "blockIndex": 5,
    "zh": "廢而不由，則女德不厭；"
  },
  {
    "id": "s0043",
    "blockIndex": 5,
    "zh": "女德不厭，則壽命不究於高年。"
  },
  {
    "id": "s0043",
    "blockIndex": 5,
    "zh": "男子五十，好色未衰；"
  },
  {
    "id": "s0043",
    "blockIndex": 5,
    "zh": "婦人四十，容貌改前；"
  },
  {
    "id": "s0043",
    "blockIndex": 5,
    "zh": "以改前之容侍於未衰之年，而不以禮爲制，則其原不可救而後徠異態；"
  },
  {
    "id": "s0043",
    "blockIndex": 5,
    "zh": "後徠異態，則正后自疑而支庶有間適之心；"
  },
  {
    "id": "s0043",
    "blockIndex": 5,
    "zh": "是以晉獻被納讒之謗，申生蒙無罪之辜。"
  },
  {
    "id": "s0043",
    "blockIndex": 5,
    "zh": "今聖主富於春秋，未有適嗣，方鄕術入學，未親后妃之議。"
  },
  {
    "id": "s0043",
    "blockIndex": 5,
    "zh": "將軍輔政，宜因始初之隆，建九女之制，詳擇有行義之家，求淑女之質，毋必有聲色技能，爲萬世大法。"
  },
  {
    "id": "s0043",
    "blockIndex": 5,
    "zh": "夫少戒之在色，《小卞》之作，可爲寒心。"
  },
  {
    "id": "s0043",
    "blockIndex": 5,
    "zh": "唯將軍常以爲憂！"
  },
  {
    "id": "s0043",
    "blockIndex": 5,
    "zh": "」鳳白之太后，太后以爲故事無有；"
  },
  {
    "id": "s0043",
    "blockIndex": 5,
    "zh": "鳳不能自立法度，循故事而已。"
  },
  {
    "id": "s0043",
    "blockIndex": 5,
    "zh": "鳳素重欽，故置之莫府，國家政謀常與欽慮之，數稱達名士，裨正闕失；"
  },
  {
    "id": "s0043",
    "blockIndex": 5,
    "zh": "當世善政多出於欽者。"
  },
  {
    "id": "s0043",
    "blockIndex": 5,
    "zh": "----6　夏，大旱。"
  },
  {
    "id": "s0043",
    "blockIndex": 5,
    "zh": "----7　匈奴呼韓邪單于嬖左伊秩訾兄女二人；"
  },
  {
    "id": "s0043",
    "blockIndex": 5,
    "zh": "長女顓渠閼氏生二子，長曰且莫車，次曰囊知牙斯；"
  },
  {
    "id": "s0043",
    "blockIndex": 5,
    "zh": "少女爲大閼氏，生四子，長曰雕陶莫皋，次曰且麋胥，皆長於且莫車，少子咸、樂二人，皆小於囊知牙斯。"
  },
  {
    "id": "s0043",
    "blockIndex": 5,
    "zh": "又他閼氏子十餘人。"
  },
  {
    "id": "s0043",
    "blockIndex": 5,
    "zh": "顓渠閼氏貴，且莫車愛，呼韓邪病且死，欲立且莫車。"
  },
  {
    "id": "s0043",
    "blockIndex": 5,
    "zh": "顓渠閼氏曰：「匈奴亂十餘年，不絕如髮，賴蒙漢力，故得復安。"
  },
  {
    "id": "s0043",
    "blockIndex": 5,
    "zh": "今平定未久，人民創艾戰鬭。"
  },
  {
    "id": "s0043",
    "blockIndex": 5,
    "zh": "且莫車年少，百姓未附，恐復危國。"
  },
  {
    "id": "s0043",
    "blockIndex": 5,
    "zh": "我與大閼氏一家共子，不如立雕陶莫皋。"
  },
  {
    "id": "s0043",
    "blockIndex": 5,
    "zh": "」大閼氏曰：「且莫車雖少，大臣共持國事。"
  },
  {
    "id": "s0043",
    "blockIndex": 5,
    "zh": "今舍貴立賤，後世必亂。"
  },
  {
    "id": "s0043",
    "blockIndex": 5,
    "zh": "」單于卒從顓渠閼氏計，立雕陶莫皋，約令傳國與弟。"
  },
  {
    "id": "s0043",
    "blockIndex": 5,
    "zh": "呼韓邪死，雕陶莫皋立，爲復株累若鞮單于。"
  },
  {
    "id": "s0043",
    "blockIndex": 5,
    "zh": "復株累若鞮單于以且麋胥爲左賢王，且莫車爲左谷蠡王，囊知牙斯爲右賢王。"
  },
  {
    "id": "s0043",
    "blockIndex": 5,
    "zh": "復株累單于復妻王昭君，生二女，長女云爲須卜居次，小女爲當于居次。"
  },
  {
    "id": "s0090",
    "blockIndex": 6,
    "zh": "1　春，三月，赦天下徒。"
  },
  {
    "id": "s0090",
    "blockIndex": 6,
    "zh": "----2　秋，關內大雨四十餘日。"
  },
  {
    "id": "s0090",
    "blockIndex": 6,
    "zh": "京師民相驚，言大水至；"
  },
  {
    "id": "s0090",
    "blockIndex": 6,
    "zh": "百姓奔走相蹂躪，老弱號呼，長安中大亂。"
  },
  {
    "id": "s0090",
    "blockIndex": 6,
    "zh": "天子親御前殿，召公卿議。"
  },
  {
    "id": "s0090",
    "blockIndex": 6,
    "zh": "大將軍鳳以為：「太后與上及後宮可御船，令吏民上長安城以避水。"
  },
  {
    "id": "s0090",
    "blockIndex": 6,
    "zh": "」君臣皆從鳳議。"
  },
  {
    "id": "s0090",
    "blockIndex": 6,
    "zh": "左將軍王商獨曰：「自古無道之國，水猶不冒城郭；"
  },
  {
    "id": "s0090",
    "blockIndex": 6,
    "zh": "今政治和平，世無兵革，上下相安，何因當有大水一日暴至，此必訛言也！"
  },
  {
    "id": "s0090",
    "blockIndex": 6,
    "zh": "不宜令上城，重驚百姓。"
  },
  {
    "id": "s0090",
    "blockIndex": 6,
    "zh": "」上乃止。"
  },
  {
    "id": "s0090",
    "blockIndex": 6,
    "zh": "有頃，長安中稍定；"
  },
  {
    "id": "s0090",
    "blockIndex": 6,
    "zh": "問之，果訛言。"
  },
  {
    "id": "s0090",
    "blockIndex": 6,
    "zh": "上於是美壯商之固守，數稱其議；"
  },
  {
    "id": "s0090",
    "blockIndex": 6,
    "zh": "而鳳大慚，自恨失言。"
  },
  {
    "id": "s0090",
    "blockIndex": 6,
    "zh": "----3　上欲專委任王鳳，八月，策免車騎將軍許嘉，以特進侯就朝位。"
  },
  {
    "id": "s0090",
    "blockIndex": 6,
    "zh": "----4　張譚坐選舉不實，免。"
  },
  {
    "id": "s0090",
    "blockIndex": 6,
    "zh": "冬，十月，光祿大夫尹忠為御史大夫。"
  },
  {
    "id": "s0090",
    "blockIndex": 6,
    "zh": "----5　十二月，戊申朔，日有食之。"
  },
  {
    "id": "s0090",
    "blockIndex": 6,
    "zh": "其夜，地震未央宮殿中。"
  },
  {
    "id": "s0090",
    "blockIndex": 6,
    "zh": "詔舉賢良方正能直言極諫之士。"
  },
  {
    "id": "s0090",
    "blockIndex": 6,
    "zh": "杜欽及太常丞谷永上對，皆以為後宮女寵太盛，嫉妒專上，將害繼嗣之咎。"
  },
  {
    "id": "s0090",
    "blockIndex": 6,
    "zh": "----6　越巂山崩。"
  },
  {
    "id": "s0090",
    "blockIndex": 6,
    "zh": "----7　丁丑，匡衡坐多取封邑四百頃，監臨盜所主守直十金以上，免為庶人。"
  },
  {
    "id": "s0115",
    "blockIndex": 7,
    "zh": "1　春，正月，癸卯，隕石於亳四，隕於肥累二。"
  },
  {
    "id": "s0115",
    "blockIndex": 7,
    "zh": "-----2　罷中書宦官。"
  },
  {
    "id": "s0115",
    "blockIndex": 7,
    "zh": "初置尚書員五人。"
  },
  {
    "id": "s0115",
    "blockIndex": 7,
    "zh": "三月，甲申，以左將軍樂昌侯王商為丞相。"
  },
  {
    "id": "s0115",
    "blockIndex": 7,
    "zh": "-----3　夏，上悉召前所舉直言之士，詣白虎殿對策。"
  },
  {
    "id": "s0115",
    "blockIndex": 7,
    "zh": "是時上委政王鳳，議者多歸咎焉。"
  },
  {
    "id": "s0115",
    "blockIndex": 7,
    "zh": "谷永知鳳方見柄用，陰欲自托，乃曰：「方今四夷賓服，皆為臣妾，北無熏葷、冒頓之患，南無趙佗、呂嘉之難，三垂晏然，靡有兵革之警。"
  },
  {
    "id": "s0115",
    "blockIndex": 7,
    "zh": "諸侯大者乃食數縣，漢吏制其權柄，不得有為，無吳、楚、燕、梁之勢。"
  },
  {
    "id": "s0115",
    "blockIndex": 7,
    "zh": "百官盤互，親疏相錯，骨肉大臣有申伯之忠，洞洞屬屬，小心畏忌，無重合、安陽、博陸之亂。"
  },
  {
    "id": "s0115",
    "blockIndex": 7,
    "zh": "三者無毛髮之辜，竊恐陛下捨昭昭之白過，忽天地之明戒，聽晻昧之瞽說，歸咎乎無辜，倚異乎政事，重失天心，不可之大者也。"
  },
  {
    "id": "s0115",
    "blockIndex": 7,
    "zh": "陛下誠深察愚臣之言，抗湛溺之意，解偏駁之愛，奮乾剛之威，平天覆之施，使列妾得人人更進，益納宜子婦人，毋擇好醜，毋避嘗字，毋論年齒。"
  },
  {
    "id": "s0115",
    "blockIndex": 7,
    "zh": "推法言之，陛下得繼嗣於微賤之間，乃反為福；"
  },
  {
    "id": "s0115",
    "blockIndex": 7,
    "zh": "得繼嗣而已，母非有賤也。"
  },
  {
    "id": "s0115",
    "blockIndex": 7,
    "zh": "後宮女史、使令有直意者，廣求於微賤之間，以遇天所開右，慰釋皇太后之憂慍，解謝上帝之譴怒，則繼嗣蕃滋，災異訖息！"
  },
  {
    "id": "s0115",
    "blockIndex": 7,
    "zh": "」杜欽亦仿此意。"
  },
  {
    "id": "s0115",
    "blockIndex": 7,
    "zh": "上皆以其書示後宮，擢永為光祿大夫。"
  },
  {
    "id": "s0115",
    "blockIndex": 7,
    "zh": "-----4　夏，四月，雨雪。"
  },
  {
    "id": "s0115",
    "blockIndex": 7,
    "zh": "-----5　秋，桃、李實。"
  },
  {
    "id": "s0115",
    "blockIndex": 7,
    "zh": "-----6　大雨水十餘日，河決東郡金堤。"
  },
  {
    "id": "s0115",
    "blockIndex": 7,
    "zh": "先是清河都尉馮逡奏言：「郡承河下流，土壤輕脆易傷，頃所以闊無大害者，以屯氏河通兩川分流也。"
  },
  {
    "id": "s0115",
    "blockIndex": 7,
    "zh": "今屯氏河塞，靈鳴犢口又益不利，獨一川兼受數河之任，雖高增堤防，終不能洩。"
  },
  {
    "id": "s0115",
    "blockIndex": 7,
    "zh": "如有霖雨，旬日不霽，必盈溢。"
  },
  {
    "id": "s0115",
    "blockIndex": 7,
    "zh": "九河故跡，今既滅難明，屯氏河新絕未久，其處易浚；"
  },
  {
    "id": "s0115",
    "blockIndex": 7,
    "zh": "又其口所居高，於以分殺水力，道裡便宜，可復浚以助大河，洩暴水，備非常。"
  },
  {
    "id": "s0115",
    "blockIndex": 7,
    "zh": "不豫修治，北決病四、五郡，南決病十餘郡，然後憂之，晚矣！"
  },
  {
    "id": "s0115",
    "blockIndex": 7,
    "zh": "」事下丞相、御史，白遣博士許商行視，以為「方用度不足，可且勿浚。"
  },
  {
    "id": "s0115",
    "blockIndex": 7,
    "zh": "」後三歲，河果決於館陶及東郡金堤，氾濫兗、豫，入平原、千乘、濟南，凡灌四郡、三十二縣，水居地十五萬餘頃，深者三丈；"
  },
  {
    "id": "s0115",
    "blockIndex": 7,
    "zh": "壞敗官亭、室廬且四萬所。"
  },
  {
    "id": "s0115",
    "blockIndex": 7,
    "zh": "-----7　冬，十一月，御史大夫尹忠以對方略疏闊，上切責其不憂職，自殺。"
  },
  {
    "id": "s0115",
    "blockIndex": 7,
    "zh": "遣大司農非調調均錢谷河決所灌之郡，謁者二人發河南以東船五百□叟，徙民避水居丘陵九萬七千餘口。"
  },
  {
    "id": "s0115",
    "blockIndex": 7,
    "zh": "-----8　壬戌，以少府張忠為御史大夫。"
  },
  {
    "id": "s0115",
    "blockIndex": 7,
    "zh": "-----9　南山群盜傰宗等數百人為吏民害。"
  },
  {
    "id": "s0115",
    "blockIndex": 7,
    "zh": "詔發兵千人逐捕，歲餘不能禽。"
  },
  {
    "id": "s0115",
    "blockIndex": 7,
    "zh": "或說大將軍鳳，以「賊數百人在轂下，討不能得，難以示四夷；"
  },
  {
    "id": "s0115",
    "blockIndex": 7,
    "zh": "獨選賢京兆尹乃可。"
  },
  {
    "id": "s0115",
    "blockIndex": 7,
    "zh": "」於是鳳薦故高陵令王尊，征為諫大夫，守京輔都尉，行京兆尹事。"
  },
  {
    "id": "s0115",
    "blockIndex": 7,
    "zh": "旬月間，盜賊清；"
  },
  {
    "id": "s0115",
    "blockIndex": 7,
    "zh": "後拜為京兆尹。"
  },
  {
    "id": "s0115",
    "blockIndex": 7,
    "zh": "-----10　上即位之初，丞相匡衡復奏：「射聲校尉陳湯以吏二千石奉使，顓命蠻夷中，不正身以先下，而盜所收康居財物，戒官屬曰：『絕域事不覆校。"
  },
  {
    "id": "s0115",
    "blockIndex": 7,
    "zh": "』雖在赦前，不宜處位。"
  },
  {
    "id": "s0115",
    "blockIndex": 7,
    "zh": "」湯坐免。"
  },
  {
    "id": "s0115",
    "blockIndex": 7,
    "zh": "後湯上言：「康居王侍子，非王子。"
  },
  {
    "id": "s0115",
    "blockIndex": 7,
    "zh": "」按驗，實王子也。"
  },
  {
    "id": "s0115",
    "blockIndex": 7,
    "zh": "湯下獄當死。"
  },
  {
    "id": "s0159",
    "blockIndex": 8,
    "zh": "太中大夫谷永上疏訟湯曰：「臣聞楚有子玉得臣，文公為之仄席而坐；"
  },
  {
    "id": "s0159",
    "blockIndex": 8,
    "zh": "趙有廉頗、馬服，強秦不敢窺兵井陘；"
  },
  {
    "id": "s0159",
    "blockIndex": 8,
    "zh": "近漢有郅都、魏尚，匈奴不敢南鄉沙幕。"
  },
  {
    "id": "s0159",
    "blockIndex": 8,
    "zh": "由是言之，戰克之將，國之爪牙，不可不重也。"
  },
  {
    "id": "s0159",
    "blockIndex": 8,
    "zh": "蓋君子聞鼓鼙之聲，則思將帥之臣。"
  },
  {
    "id": "s0159",
    "blockIndex": 8,
    "zh": "竊見關內侯陳湯，前斬郅支，威震百蠻，武暢西海，漢元以來，征伐方外之將，未嘗有也。"
  },
  {
    "id": "s0159",
    "blockIndex": 8,
    "zh": "今湯坐言事非是，幽囚久系，歷時不決，執憲之吏欲致之大辟。"
  },
  {
    "id": "s0159",
    "blockIndex": 8,
    "zh": "昔白起為秦將，南拔郢都，北坑趙括，以纖介之過，賜死杜郵；"
  },
  {
    "id": "s0159",
    "blockIndex": 8,
    "zh": "秦民憐之，莫不隕涕。"
  },
  {
    "id": "s0159",
    "blockIndex": 8,
    "zh": "今湯親秉鉞席捲，喋血萬里之外，薦功祖廟，告類上帝，介冑之士靡不慕義。"
  },
  {
    "id": "s0159",
    "blockIndex": 8,
    "zh": "以言事為罪，無赫赫之惡。"
  },
  {
    "id": "s0159",
    "blockIndex": 8,
    "zh": "《周書》曰：『記人之功，忘人之過，宜為君者也。"
  },
  {
    "id": "s0159",
    "blockIndex": 8,
    "zh": "』夫犬馬有勞於人，尚加帷蓋之報，況國之功臣者哉！"
  },
  {
    "id": "s0159",
    "blockIndex": 8,
    "zh": "竊恐陛下忽於鼙鼓之聲，不察《周書》之意，而忘帷蓋之施，庸臣遇湯，卒從吏議，使百姓介然有秦民之恨，非所以厲死難之臣也！"
  },
  {
    "id": "s0174",
    "blockIndex": 9,
    "zh": "書奏，天子出湯，奪爵為士伍。"
  },
  {
    "id": "s0174",
    "blockIndex": 9,
    "zh": "會西域都護段會宗為烏孫兵所圍，驛騎上書，願發城郭、敦煌兵以自救；"
  },
  {
    "id": "s0174",
    "blockIndex": 9,
    "zh": "丞相商、大將軍鳳及百寮議數日不決。"
  },
  {
    "id": "s0174",
    "blockIndex": 9,
    "zh": "鳳言：「陳湯多籌策，習外國事，可問。"
  },
  {
    "id": "s0174",
    "blockIndex": 9,
    "zh": "」上召湯見宣室。"
  },
  {
    "id": "s0174",
    "blockIndex": 9,
    "zh": "湯擊郅支時中寒，病兩臂不屈申；"
  },
  {
    "id": "s0174",
    "blockIndex": 9,
    "zh": "湯入見，有詔毋拜，示以會宗奏。"
  },
  {
    "id": "s0174",
    "blockIndex": 9,
    "zh": "湯對曰：「臣以為此必無可憂也。"
  },
  {
    "id": "s0174",
    "blockIndex": 9,
    "zh": "」上曰：「何以言之？"
  },
  {
    "id": "s0174",
    "blockIndex": 9,
    "zh": "」湯曰：「夫胡兵五而當漢兵一，何者？"
  },
  {
    "id": "s0174",
    "blockIndex": 9,
    "zh": "兵刃樸鈍，弓弩不利。"
  },
  {
    "id": "s0174",
    "blockIndex": 9,
    "zh": "今聞頗得漢巧，然猶三而當一。"
  },
  {
    "id": "s0174",
    "blockIndex": 9,
    "zh": "又《兵法》曰：『客倍而主人半，然後敵。"
  },
  {
    "id": "s0174",
    "blockIndex": 9,
    "zh": "』今圍會宗者人眾不足以勝會宗。"
  },
  {
    "id": "s0174",
    "blockIndex": 9,
    "zh": "唯陛下勿憂！"
  },
  {
    "id": "s0174",
    "blockIndex": 9,
    "zh": "且兵輕行五十里，重行三十里，今會宗欲發城郭、敦煌，歷時乃至，所謂報讎之兵，非救急之用也。"
  },
  {
    "id": "s0174",
    "blockIndex": 9,
    "zh": "」上曰：「奈何？"
  },
  {
    "id": "s0174",
    "blockIndex": 9,
    "zh": "其解可必乎？"
  },
  {
    "id": "s0174",
    "blockIndex": 9,
    "zh": "度何時解？"
  },
  {
    "id": "s0174",
    "blockIndex": 9,
    "zh": "」湯知烏孫瓦合，不能久攻，故事不過數日，因對曰：「已解矣！"
  },
  {
    "id": "s0174",
    "blockIndex": 9,
    "zh": "」屈指計其日，曰：「不出五日，當有吉語聞。"
  },
  {
    "id": "s0174",
    "blockIndex": 9,
    "zh": "」居四日，軍書到，言已解。"
  },
  {
    "id": "s0174",
    "blockIndex": 9,
    "zh": "大將軍鳳奏以為從事中郎，莫府事壹決於湯。"
  },
  {
    "id": "s0198",
    "blockIndex": 10,
    "zh": "1 　 春，杜欽薦犍為王延世於王鳳，使塞決河。"
  },
  {
    "id": "s0198",
    "blockIndex": 10,
    "zh": "鳳以延世為河堤使者。"
  },
  {
    "id": "s0198",
    "blockIndex": 10,
    "zh": "延世以竹落長四丈，大九圍，盛以小石，兩船夾載而下之。"
  },
  {
    "id": "s0198",
    "blockIndex": 10,
    "zh": "三十六日，河堤成。"
  },
  {
    "id": "s0198",
    "blockIndex": 10,
    "zh": "三月，詔以延世為光祿大夫，秩中二千石，賜爵關內侯、黃金百斤。"
  },
  {
    "id": "s0204",
    "blockIndex": 11,
    "zh": "2　  夏，四月，己亥晦，日有食之。"
  },
  {
    "id": "s0204",
    "blockIndex": 11,
    "zh": "詔公卿百僚陳過失，無有所諱。"
  },
  {
    "id": "s0204",
    "blockIndex": 11,
    "zh": "大赦天下。"
  },
  {
    "id": "s0204",
    "blockIndex": 11,
    "zh": "光祿大夫劉向對曰：「四月交於五月，月同孝惠，日同孝昭，其占恐害繼嗣。"
  },
  {
    "id": "s0204",
    "blockIndex": 11,
    "zh": "」是時許皇后專寵，後宮希得進見，中外皆憂上無繼嗣，故杜欽、谷永及向所對皆及之。"
  },
  {
    "id": "s0209",
    "blockIndex": 12,
    "zh": "上於是減省椒房、掖廷用度，服御、輿駕所發諸官署及所造作，遺賜外家、群臣妾，皆如竟寧以前故事。"
  },
  {
    "id": "s0209",
    "blockIndex": 12,
    "zh": "皇后上疏自陳，以為：「時世異制，長短相補，不出漢制而已，纖微之間未必可同。"
  },
  {
    "id": "s0209",
    "blockIndex": 12,
    "zh": "若竟寧前與黃龍前，豈相放哉！"
  },
  {
    "id": "s0209",
    "blockIndex": 12,
    "zh": "家吏不曉，今壹受詔如此，且使妾搖手不得。"
  },
  {
    "id": "s0209",
    "blockIndex": 12,
    "zh": "設妾欲作某屏風張於某所，曰：『故事無有。"
  },
  {
    "id": "s0209",
    "blockIndex": 12,
    "zh": "』或不能得，則必繩妾以詔書矣。"
  },
  {
    "id": "s0209",
    "blockIndex": 12,
    "zh": "此誠不可行，唯陛下省察！"
  },
  {
    "id": "s0209",
    "blockIndex": 12,
    "zh": "故事，以特牛祠大父母，戴侯、敬侯皆得蒙恩以太牢祠，今當率如故事，唯陛下哀之！"
  },
  {
    "id": "s0209",
    "blockIndex": 12,
    "zh": "今吏甫受詔讀記，直豫言使後知之，非可復若私府有所取也。"
  },
  {
    "id": "s0209",
    "blockIndex": 12,
    "zh": "其萌牙所以約制妾者，恐失人理。"
  },
  {
    "id": "s0209",
    "blockIndex": 12,
    "zh": "唯陛下深察焉！"
  },
  {
    "id": "s0209",
    "blockIndex": 12,
    "zh": "」上於是采谷永、劉向所言災異咎驗皆在後宮之意以報之，且曰：「吏拘於法，亦安足過！"
  },
  {
    "id": "s0209",
    "blockIndex": 12,
    "zh": "蓋矯枉者過直，古今同之。"
  },
  {
    "id": "s0209",
    "blockIndex": 12,
    "zh": "且財幣之省，特牛之祠，其於皇后，所以扶助德美，為華寵也。"
  },
  {
    "id": "s0209",
    "blockIndex": 12,
    "zh": "咎根不除，災變相襲，祖宗且不血食，何戴侯也！"
  },
  {
    "id": "s0209",
    "blockIndex": 12,
    "zh": "傳不云乎：『以約失之者鮮』，審皇后欲從其奢與？"
  },
  {
    "id": "s0209",
    "blockIndex": 12,
    "zh": "朕亦當法孝武皇帝也。"
  },
  {
    "id": "s0209",
    "blockIndex": 12,
    "zh": "如此，則甘泉、建章可復興矣。"
  },
  {
    "id": "s0209",
    "blockIndex": 12,
    "zh": "孝文皇帝，朕之師也。"
  },
  {
    "id": "s0209",
    "blockIndex": 12,
    "zh": "皇太后，皇后成法也。"
  },
  {
    "id": "s0209",
    "blockIndex": 12,
    "zh": "假使太后在彼時不如職，今見親厚，又惡可以逾乎！"
  },
  {
    "id": "s0209",
    "blockIndex": 12,
    "zh": "皇后其刻心秉德，謙約為右，垂則列妾，使有法焉！"
  },
  {
    "id": "s0232",
    "blockIndex": 13,
    "zh": "3　給事中平陵平當上言：「太上皇，漢之始祖，廢其寢廟園，非是。"
  },
  {
    "id": "s0232",
    "blockIndex": 13,
    "zh": "」上亦以無繼嗣，遂納當言。"
  },
  {
    "id": "s0232",
    "blockIndex": 13,
    "zh": "秋，九月，復太上皇寢廟園。"
  },
  {
    "id": "s0236",
    "blockIndex": 14,
    "zh": "4　詔曰：「今大辟之刑千有餘條，律令煩多，百有餘萬言；"
  },
  {
    "id": "s0236",
    "blockIndex": 14,
    "zh": "奇請，它比，日以益滋。"
  },
  {
    "id": "s0236",
    "blockIndex": 14,
    "zh": "自明習者不知所由，欲以曉喻眾庶，不亦難乎！"
  },
  {
    "id": "s0236",
    "blockIndex": 14,
    "zh": "於以羅元元之民，夭絕亡辜，豈不哀哉！"
  },
  {
    "id": "s0236",
    "blockIndex": 14,
    "zh": "其議減死刑及可蠲除約省者，令較然易知，條奏！"
  },
  {
    "id": "s0236",
    "blockIndex": 14,
    "zh": "」時有司不能廣宣上意，徒鉤摭微細，毛舉數事，以塞詔而已。"
  },
  {
    "id": "s0242",
    "blockIndex": 15,
    "zh": "----5　匈奴單于遣右皋林王伊邪莫演等奉獻，朝正月。"
  },
  {
    "id": "s0244",
    "blockIndex": 16,
    "zh": "1　春，伊邪莫演罷歸，自言欲降：「即不受我，我自殺，終不敢還歸。"
  },
  {
    "id": "s0244",
    "blockIndex": 16,
    "zh": "」使者以聞，下公卿議。"
  },
  {
    "id": "s0244",
    "blockIndex": 16,
    "zh": "議者或言：「宜如故事，受其降。"
  },
  {
    "id": "s0244",
    "blockIndex": 16,
    "zh": "」光祿大夫谷永、議郎杜欽以為：「漢興，匈奴數為邊害，故設金爵之賞以待降者。"
  },
  {
    "id": "s0244",
    "blockIndex": 16,
    "zh": "今單于屈體稱臣，列為北籓，遣使朝賀，無有二心。"
  },
  {
    "id": "s0244",
    "blockIndex": 16,
    "zh": "漢家接之，宜異於往時。"
  },
  {
    "id": "s0244",
    "blockIndex": 16,
    "zh": "今既享單于聘貢之質，而更受其逋逃之臣，是貪一夫之得而失一國之心，擁有罪之臣而絕慕義之君也。"
  },
  {
    "id": "s0244",
    "blockIndex": 16,
    "zh": "假令單于初立，欲委身中國，未知利害，私使伊邪莫演詐降以卜吉凶，受之，虧德沮善，令單于自疏，不親邊吏；"
  },
  {
    "id": "s0244",
    "blockIndex": 16,
    "zh": "或者設為反間，欲因而生隙，受之，適合其策，使得歸曲而責直。"
  },
  {
    "id": "s0244",
    "blockIndex": 16,
    "zh": "此誠邊境安危之原，師旅動靜之首，不可不詳也。"
  },
  {
    "id": "s0244",
    "blockIndex": 16,
    "zh": "不如勿受，以昭日月之信，抑詐諼之謀，懷附親之心，便！"
  },
  {
    "id": "s0244",
    "blockIndex": 16,
    "zh": "」對奏，天子從之。"
  },
  {
    "id": "s0244",
    "blockIndex": 16,
    "zh": "遣中郎將王舜往問降狀，伊邪莫演曰：「我病狂，妄言耳。"
  },
  {
    "id": "s0244",
    "blockIndex": 16,
    "zh": "」遣去。"
  },
  {
    "id": "s0244",
    "blockIndex": 16,
    "zh": "歸到，官位如故，不肯令見漢使。"
  },
  {
    "id": "s0244",
    "blockIndex": 16,
    "zh": "----2　夏，四月，楚國雨雹，大如釜。"
  },
  {
    "id": "s0244",
    "blockIndex": 16,
    "zh": "----3　徙山陽王康為定陶王。"
  },
  {
    "id": "s0244",
    "blockIndex": 16,
    "zh": "----4　六月，上悉封諸舅：王譚為平阿侯，商為成都侯，立為紅陽侯，根為曲陽侯，逢時為高平侯。"
  },
  {
    "id": "s0244",
    "blockIndex": 16,
    "zh": "五人同日封，故世謂之「五侯」。"
  },
  {
    "id": "s0244",
    "blockIndex": 16,
    "zh": "太后母李氏更嫁為河內苟賓妻，生子參；"
  },
  {
    "id": "s0244",
    "blockIndex": 16,
    "zh": "太后欲以田□分為比而封之。"
  },
  {
    "id": "s0244",
    "blockIndex": 16,
    "zh": "上曰：「封田氏，非正也。"
  },
  {
    "id": "s0244",
    "blockIndex": 16,
    "zh": "」以參為侍中、水衡都尉。"
  },
  {
    "id": "s0244",
    "blockIndex": 16,
    "zh": "----5　御史大夫張忠奏京兆尹王尊暴虐倨慢，尊坐免官；"
  },
  {
    "id": "s0244",
    "blockIndex": 16,
    "zh": "吏民多稱惜之。"
  },
  {
    "id": "s0244",
    "blockIndex": 16,
    "zh": "湖三老公乘興等上書訟：「尊治京兆，撥劇整亂，誅暴禁邪，皆前所稀有，名將所不及；"
  },
  {
    "id": "s0244",
    "blockIndex": 16,
    "zh": "雖拜為真，未有殊絕褒賞加於尊身。"
  },
  {
    "id": "s0244",
    "blockIndex": 16,
    "zh": "今御史大夫奏尊『傷害陰陽，為國家憂，無承用詔書意，『靖言庸違，像龔滔天。"
  },
  {
    "id": "s0244",
    "blockIndex": 16,
    "zh": "』」源其所以，出御史丞楊輔，素與尊有私怨，外依公事建畫為此議，傅致奏文，浸潤加誣，臣等竊痛傷。"
  },
  {
    "id": "s0244",
    "blockIndex": 16,
    "zh": "尊修身潔己，砥節首公，刺譏不憚將相，誅惡不避豪強，誅不制之賊，解國家之憂，功著職修，威信不廢，誠國家爪牙之吏，折衝之臣。"
  },
  {
    "id": "s0244",
    "blockIndex": 16,
    "zh": "今一旦無辜制於仇人之手，傷於詆欺之文，上不得以功除罪，下不得蒙棘木之聽，獨掩怨讎之偏奏，被共工之大惡，無所陳冤訴罪。"
  },
  {
    "id": "s0244",
    "blockIndex": 16,
    "zh": "尊以京師廢亂，群盜並興，選賢徵用，起家為卿。"
  },
  {
    "id": "s0244",
    "blockIndex": 16,
    "zh": "賊亂既除，豪猾伏辜，即以佞巧廢黜。"
  },
  {
    "id": "s0244",
    "blockIndex": 16,
    "zh": "一尊之身，三期之間，乍賢乍佞，豈不甚哉！"
  },
  {
    "id": "s0244",
    "blockIndex": 16,
    "zh": "孔子曰：『愛之欲其生，惡之欲其死，是惑也。"
  },
  {
    "id": "s0244",
    "blockIndex": 16,
    "zh": "』『浸潤之譖不行焉，可謂明矣。"
  },
  {
    "id": "s0244",
    "blockIndex": 16,
    "zh": "』願下公卿、大夫、博士、議郎定尊素行！"
  },
  {
    "id": "s0244",
    "blockIndex": 16,
    "zh": "夫人臣而『傷害陰陽』，死誅之罪也；"
  },
  {
    "id": "s0244",
    "blockIndex": 16,
    "zh": "『靖言庸違』，放殛之刑也。"
  },
  {
    "id": "s0244",
    "blockIndex": 16,
    "zh": "審如御史章，尊乃當伏觀闕之誅，放於無人之域，不得苟免；"
  },
  {
    "id": "s0244",
    "blockIndex": 16,
    "zh": "及任舉尊者，當獲選舉之辜，不可但已。"
  },
  {
    "id": "s0244",
    "blockIndex": 16,
    "zh": "即不如章，飾文深詆以訴無罪，亦宜有誅，以懲讒賊之口，絕詐欺之路。"
  },
  {
    "id": "s0244",
    "blockIndex": 16,
    "zh": "唯明主參詳，使白黑分別！"
  },
  {
    "id": "s0244",
    "blockIndex": 16,
    "zh": "」書奏，天子復以尊為徐州刺史。"
  },
  {
    "id": "s0244",
    "blockIndex": 16,
    "zh": "----6　夜郎王興、金句町王禹、漏臥侯俞更舉兵相攻。"
  },
  {
    "id": "s0244",
    "blockIndex": 16,
    "zh": "牂柯太守請發兵誅興等。"
  },
  {
    "id": "s0244",
    "blockIndex": 16,
    "zh": "議者以為道遠不可擊，乃遣太中大夫蜀郡張匡持節和解。"
  },
  {
    "id": "s0244",
    "blockIndex": 16,
    "zh": "興等不從命，刻木象漢吏，立道旁，射之。"
  },
  {
    "id": "s0292",
    "blockIndex": 17,
    "zh": "杜欽說大將軍王鳳曰：「蠻夷王侯輕易漢使，不憚國威，恐議者選耎，復守和解；"
  },
  {
    "id": "s0292",
    "blockIndex": 17,
    "zh": "太守察動靜有變，乃以聞。"
  },
  {
    "id": "s0292",
    "blockIndex": 17,
    "zh": "如此，則復曠一時，王侯得收獵其眾，申固其謀，黨助眾多，各不勝忿，必相殄滅。"
  },
  {
    "id": "s0292",
    "blockIndex": 17,
    "zh": "自知罪成，狂犯守尉，遠臧溫暑毒草之地；"
  },
  {
    "id": "s0292",
    "blockIndex": 17,
    "zh": "雖有孫、吳將，賁、育士，若入水火，往必焦沒，智勇亡所施。"
  },
  {
    "id": "s0292",
    "blockIndex": 17,
    "zh": "屯田守之，費不可勝量。"
  },
  {
    "id": "s0292",
    "blockIndex": 17,
    "zh": "宜因其罪惡未成，未疑漢家加誅，陰敕旁郡守尉練士馬，大司農豫調谷積要害處，選任職太守往。"
  },
  {
    "id": "s0292",
    "blockIndex": 17,
    "zh": "以秋涼時入，誅其王侯尤不軌者。"
  },
  {
    "id": "s0292",
    "blockIndex": 17,
    "zh": "即以為不毛之地，無用之民，聖王不以勞中國，宜罷郡，放棄其民，絕其王侯勿復通。"
  },
  {
    "id": "s0292",
    "blockIndex": 17,
    "zh": "如以先帝所立累世之功不可墮壞，亦宜因其萌牙，早斷絕之。"
  },
  {
    "id": "s0292",
    "blockIndex": 17,
    "zh": "及已成形然後戰師，則萬姓被害。"
  },
  {
    "id": "s0292",
    "blockIndex": 17,
    "zh": "」大將軍鳳於是薦金城司馬臨邛陳立為牂柯太守。"
  },
  {
    "id": "s0292",
    "blockIndex": 17,
    "zh": "立至牂柯，諭告夜郎王興，興不從命；"
  },
  {
    "id": "s0292",
    "blockIndex": 17,
    "zh": "立請誅之，未報。"
  },
  {
    "id": "s0292",
    "blockIndex": 17,
    "zh": "乃從吏數十人出行縣，至興國且同亭，召興。"
  },
  {
    "id": "s0292",
    "blockIndex": 17,
    "zh": "興將數千人往至亭，從邑君數十人入見立。"
  },
  {
    "id": "s0292",
    "blockIndex": 17,
    "zh": "立數責，因斷頭。"
  },
  {
    "id": "s0292",
    "blockIndex": 17,
    "zh": "邑君曰：「將軍誅無狀，為民除害，願出曉士眾！"
  },
  {
    "id": "s0292",
    "blockIndex": 17,
    "zh": "」以興頭示之，皆釋兵降。"
  },
  {
    "id": "s0292",
    "blockIndex": 17,
    "zh": "金句町王禹、漏臥侯俞震恐，入粟千斛、牛羊勞吏士。"
  },
  {
    "id": "s0292",
    "blockIndex": 17,
    "zh": "立還歸郡。"
  },
  {
    "id": "s0292",
    "blockIndex": 17,
    "zh": "興妻父翁指，與子邪務收餘兵，迫脅旁二十二邑反。"
  },
  {
    "id": "s0292",
    "blockIndex": 17,
    "zh": "至冬，立奏募諸夷，與都尉、長史分將攻翁指等。"
  },
  {
    "id": "s0292",
    "blockIndex": 17,
    "zh": "翁指據厄為壘，立使奇兵絕其饟道，縱反間以誘其眾。"
  },
  {
    "id": "s0292",
    "blockIndex": 17,
    "zh": "都尉萬年曰：「兵久不決，費不可共。"
  },
  {
    "id": "s0292",
    "blockIndex": 17,
    "zh": "」引兵獨進。"
  },
  {
    "id": "s0292",
    "blockIndex": 17,
    "zh": "敗走，趨立營。"
  },
  {
    "id": "s0292",
    "blockIndex": 17,
    "zh": "立怒，叱戲下令格之。"
  },
  {
    "id": "s0292",
    "blockIndex": 17,
    "zh": "都尉復還戰，立救之。"
  },
  {
    "id": "s0292",
    "blockIndex": 17,
    "zh": "時天大旱，立攻絕其水道。"
  },
  {
    "id": "s0292",
    "blockIndex": 17,
    "zh": "蠻夷共斬翁指，持首出降，西夷遂平。"
  },
  {
    "id": "s0324",
    "blockIndex": 18,
    "zh": "1　春，正月，楚王囂來朝。"
  },
  {
    "id": "s0324",
    "blockIndex": 18,
    "zh": "二月，乙亥，詔以囂素行純茂，特加顯異，封其子勳為廣戚侯。"
  },
  {
    "id": "s0324",
    "blockIndex": 18,
    "zh": "----2　丙戌，犍為地震，山崩，壅江水，水逆流。"
  },
  {
    "id": "s0324",
    "blockIndex": 18,
    "zh": "----3　秋，八月，乙卯晦，日有食之。"
  },
  {
    "id": "s0324",
    "blockIndex": 18,
    "zh": "----4　上以中秘書頗散亡，使謁者陳農求遺書於天下。"
  },
  {
    "id": "s0324",
    "blockIndex": 18,
    "zh": "詔光祿大夫劉向校經傳、諸子、詩賦，步兵校尉任宏校兵書，太史令尹鹹校數術，侍醫李柱國校方技。"
  },
  {
    "id": "s0324",
    "blockIndex": 18,
    "zh": "每一書已，向輒條其篇目，撮其指意，錄而奏之。"
  },
  {
    "id": "s0331",
    "blockIndex": 19,
    "zh": "劉向以王氏權位太盛，而上方向《詩》、《書》古文，向乃因《尚書‧洪範》，集合上古以來，歷春秋、六國至秦、漢符瑞、災異之記，推跡行事，連傅禍福，著其占驗，比類相從，各有條目，凡十一篇，號曰《洪範五行傳論》，奏之。"
  },
  {
    "id": "s0331",
    "blockIndex": 19,
    "zh": "天子心知向忠精，故為鳳兄弟起此論也；"
  },
  {
    "id": "s0331",
    "blockIndex": 19,
    "zh": "然終不能奪王氏權。"
  },
  {
    "id": "s0331",
    "blockIndex": 19,
    "zh": "----5　河復決平原，流入濟南、千乘，所壞敗者半建始時。"
  },
  {
    "id": "s0331",
    "blockIndex": 19,
    "zh": "復遣王延世與丞相史楊焉及將作大匠許商、諫大夫乘馬延年同作治，六月乃成。"
  },
  {
    "id": "s0331",
    "blockIndex": 19,
    "zh": "復賜延世黃金百斤。"
  },
  {
    "id": "s0331",
    "blockIndex": 19,
    "zh": "治河卒非受平賈者，為著外繇六月。"
  },
  {
    "id": "s0339",
    "blockIndex": 20,
    "zh": "1　春，正月，匈奴單于來朝。"
  },
  {
    "id": "s0339",
    "blockIndex": 20,
    "zh": "----2　赦天下徒。"
  },
  {
    "id": "s0339",
    "blockIndex": 20,
    "zh": "----3　三月，癸丑朔，日有食之。"
  },
  {
    "id": "s0339",
    "blockIndex": 20,
    "zh": "----4　琅邪太守楊肜與王鳳連昏，其郡有災害，丞相王商按問之。"
  },
  {
    "id": "s0339",
    "blockIndex": 20,
    "zh": "鳳以為請，商不聽，竟奏免肜，奏果寢不下。"
  },
  {
    "id": "s0339",
    "blockIndex": 20,
    "zh": "鳳以是怨商，陰求其短，使頻陽耿定上書，言「商與父傅婢通；"
  },
  {
    "id": "s0339",
    "blockIndex": 20,
    "zh": "及女弟淫亂，奴殺其私夫，疑商教使。"
  },
  {
    "id": "s0339",
    "blockIndex": 20,
    "zh": "」天子以為暗昧之過，不足以傷大臣。"
  },
  {
    "id": "s0339",
    "blockIndex": 20,
    "zh": "鳳固爭，下其事司隸。"
  },
  {
    "id": "s0339",
    "blockIndex": 20,
    "zh": "太中大夫蜀郡張匡，素佞巧，復上書極言詆毀商。"
  },
  {
    "id": "s0339",
    "blockIndex": 20,
    "zh": "有司奏請召商詣詔獄。"
  },
  {
    "id": "s0339",
    "blockIndex": 20,
    "zh": "上素重商，知匡言多險，制曰：「勿治！"
  },
  {
    "id": "s0339",
    "blockIndex": 20,
    "zh": "」鳳固爭之。"
  },
  {
    "id": "s0352",
    "blockIndex": 21,
    "zh": "夏，四月，壬寅，詔收商丞相印綬。"
  },
  {
    "id": "s0352",
    "blockIndex": 21,
    "zh": "商免相三日，發病，歐血薨，謚曰戾侯。"
  },
  {
    "id": "s0352",
    "blockIndex": 21,
    "zh": "而商子弟親屬為駙馬都尉、侍中、中常侍、諸曹、大夫、郎吏者，皆出補吏，莫得留給事、宿衛者。"
  },
  {
    "id": "s0352",
    "blockIndex": 21,
    "zh": "有司奏請除國邑；"
  },
  {
    "id": "s0352",
    "blockIndex": 21,
    "zh": "有詔：「長子安嗣爵為樂昌侯。"
  },
  {
    "id": "s0352",
    "blockIndex": 21,
    "zh": "」----5　上之為太子也，受《論語》於蓮勺張禹，及即位，賜爵關內侯，拜為諸吏、光祿大夫，秩中二千石，給事中，領尚書事。"
  },
  {
    "id": "s0352",
    "blockIndex": 21,
    "zh": "禹與王鳳並領尚書，內不自安，數病，上書乞骸骨，欲退避鳳；"
  },
  {
    "id": "s0352",
    "blockIndex": 21,
    "zh": "上不許，撫待愈厚。"
  },
  {
    "id": "s0352",
    "blockIndex": 21,
    "zh": "六月，丙戌，以禹為丞相，封安昌侯。"
  },
  {
    "id": "s0352",
    "blockIndex": 21,
    "zh": "----6　庚戌，楚孝王囂薨。"
  },
  {
    "id": "s0352",
    "blockIndex": 21,
    "zh": "----7　初，武帝通西域，罽賓自以絕遠，漢兵不能至，獨不服，數剽殺漢使。"
  },
  {
    "id": "s0352",
    "blockIndex": 21,
    "zh": "久之，漢使者文忠與容屈王子陰末赴合謀攻殺其王；"
  },
  {
    "id": "s0352",
    "blockIndex": 21,
    "zh": "立陰末赴為罽賓王。"
  },
  {
    "id": "s0352",
    "blockIndex": 21,
    "zh": "後軍候趙德使罽賓，與陰末赴相失；"
  },
  {
    "id": "s0352",
    "blockIndex": 21,
    "zh": "陰末赴鎖琅當德，殺副已下七十餘人，遣使者上書謝。"
  },
  {
    "id": "s0352",
    "blockIndex": 21,
    "zh": "孝元帝以其絕域，不錄，放其使者於縣度，絕而不通。"
  },
  {
    "id": "s0352",
    "blockIndex": 21,
    "zh": "及帝即位，復遣使獻謝罪。"
  },
  {
    "id": "s0352",
    "blockIndex": 21,
    "zh": "漢欲遣使者報送其使。"
  },
  {
    "id": "s0352",
    "blockIndex": 21,
    "zh": "杜欽說王鳳曰：「前罽賓王陰末赴，本漢所立，後卒畔逆。"
  },
  {
    "id": "s0352",
    "blockIndex": 21,
    "zh": "夫德莫大於有國子民，罪莫大於執殺使者，所以不報恩，不懼誅者，自知絕遠，兵不至也。"
  },
  {
    "id": "s0352",
    "blockIndex": 21,
    "zh": "有求則卑辭，無慾則驕嫚，終不可懷服。"
  },
  {
    "id": "s0352",
    "blockIndex": 21,
    "zh": "凡中國所以為通厚蠻夷，愜快其求者，為壤比而為寇。"
  },
  {
    "id": "s0352",
    "blockIndex": 21,
    "zh": "今縣度之厄，非罽賓所能越也；"
  },
  {
    "id": "s0352",
    "blockIndex": 21,
    "zh": "其鄉慕，不足以安西域；"
  },
  {
    "id": "s0352",
    "blockIndex": 21,
    "zh": "雖不附，不能危城郭。"
  },
  {
    "id": "s0352",
    "blockIndex": 21,
    "zh": "前親逆節，惡暴西域，故絕而不通；"
  },
  {
    "id": "s0352",
    "blockIndex": 21,
    "zh": "今悔過來，而無親屬、貴人，奉獻者皆行賈賤人，欲通貨市買，以獻為名，故煩使者送至縣度，恐失實見欺。"
  },
  {
    "id": "s0352",
    "blockIndex": 21,
    "zh": "凡遣使送客者，欲為防護寇害也。"
  },
  {
    "id": "s0352",
    "blockIndex": 21,
    "zh": "起皮山，南更不屬漢之國四、五，斥候士百餘人，五分夜擊刁斗自守，尚時為所侵盜。"
  },
  {
    "id": "s0352",
    "blockIndex": 21,
    "zh": "驢畜負糧，須諸國稟食，得以自贍。"
  },
  {
    "id": "s0352",
    "blockIndex": 21,
    "zh": "國或貧小不能食，或桀黠不肯給，擁強漢之節，餒山谷之間，乞丐無所得，離一、二旬，則人畜棄捐曠野而不反。"
  },
  {
    "id": "s0352",
    "blockIndex": 21,
    "zh": "又歷大頭痛、小頭痛之山，赤土、身熱之阪，令人身熱無色，頭痛嘔吐，驢畜盡然。"
  },
  {
    "id": "s0352",
    "blockIndex": 21,
    "zh": "又有三池盤、石阪道，狹者尺六七寸，長者徑三十里，臨崢嶸不測之深，行者騎步相持，繩索相引，二千餘里，乃到縣度。"
  },
  {
    "id": "s0352",
    "blockIndex": 21,
    "zh": "畜墜，未半坑谷盡靡碎；"
  },
  {
    "id": "s0352",
    "blockIndex": 21,
    "zh": "人墮，勢不得相收視；"
  },
  {
    "id": "s0352",
    "blockIndex": 21,
    "zh": "險阻危害，不可勝言。"
  },
  {
    "id": "s0352",
    "blockIndex": 21,
    "zh": "聖王分九州，制五服，務盛內，不求外；"
  },
  {
    "id": "s0352",
    "blockIndex": 21,
    "zh": "今遣使者承至尊之命，送蠻夷之賈，勞吏士之眾，涉危難之路，罷敝所恃以事無用，非久長計也。"
  },
  {
    "id": "s0352",
    "blockIndex": 21,
    "zh": "使者業已受節，可至皮山而還。"
  },
  {
    "id": "s0352",
    "blockIndex": 21,
    "zh": "」於是鳳白從欽言。"
  },
  {
    "id": "s0352",
    "blockIndex": 21,
    "zh": "罽賓實利賞賜賈市，其使數年而壹至云。"
  },
  {
    "id": "s0394",
    "blockIndex": 22,
    "zh": "1　春，二月，丁未晦，日有食之。"
  },
  {
    "id": "s0394",
    "blockIndex": 22,
    "zh": "----2　三月，赦天下徒。"
  },
  {
    "id": "s0394",
    "blockIndex": 22,
    "zh": "----3　冬，京兆尹泰山王章下獄，死。"
  },
  {
    "id": "s0397",
    "blockIndex": 23,
    "zh": "時大將軍鳳用事，上謙讓無所顓。"
  },
  {
    "id": "s0397",
    "blockIndex": 23,
    "zh": "左右嘗薦光祿大夫劉向少子歆通達有異材，上召見歆，誦讀詩賦，甚悅之，欲以為中常侍；"
  },
  {
    "id": "s0397",
    "blockIndex": 23,
    "zh": "召取衣冠，臨當拜，左右皆曰：「未曉大將軍。"
  },
  {
    "id": "s0397",
    "blockIndex": 23,
    "zh": "」上曰：「此小事，何須關大將軍！"
  },
  {
    "id": "s0397",
    "blockIndex": 23,
    "zh": "」左右叩頭爭之，上於是語鳳，鳳以為不可，乃止。"
  },
  {
    "id": "s0397",
    "blockIndex": 23,
    "zh": "王氏子弟皆卿、大夫、侍中、諸曹，分據勢官，滿朝廷。"
  },
  {
    "id": "s0397",
    "blockIndex": 23,
    "zh": "杜欽見鳳專政泰重，戒之曰：「願將軍由周公之謙懼，損穰侯之威，放武安之欲，毋使范雎之徒得間其說。"
  },
  {
    "id": "s0397",
    "blockIndex": 23,
    "zh": "」鳳不聽。"
  },
  {
    "id": "s0405",
    "blockIndex": 24,
    "zh": "時上無繼嗣，體常不平。"
  },
  {
    "id": "s0405",
    "blockIndex": 24,
    "zh": "定陶共王來朝，太后與上承先帝意，遇共王甚厚，賞賜十倍於它王，不以往事為纖介；"
  },
  {
    "id": "s0405",
    "blockIndex": 24,
    "zh": "留之京師，不遣歸國。"
  },
  {
    "id": "s0405",
    "blockIndex": 24,
    "zh": "上謂共王：「我未有子，人命不諱。"
  },
  {
    "id": "s0405",
    "blockIndex": 24,
    "zh": "一朝有它，且不復相見，爾長留侍我矣！"
  },
  {
    "id": "s0405",
    "blockIndex": 24,
    "zh": "」其後天子疾益有瘳，共王因留國邸，旦夕侍上。"
  },
  {
    "id": "s0405",
    "blockIndex": 24,
    "zh": "上甚親重之。"
  },
  {
    "id": "s0405",
    "blockIndex": 24,
    "zh": "大將軍鳳心不便共王在京師，會日食，鳳因言：「日食，陰盛之象。"
  },
  {
    "id": "s0405",
    "blockIndex": 24,
    "zh": "定陶王雖親，於禮當奉籓在國；"
  },
  {
    "id": "s0405",
    "blockIndex": 24,
    "zh": "今留侍京師，詭正非常，故天見戒，宜遣王之國。"
  },
  {
    "id": "s0405",
    "blockIndex": 24,
    "zh": "」上不得已於鳳而許之。"
  },
  {
    "id": "s0405",
    "blockIndex": 24,
    "zh": "共王辭去，上與相對涕泣而決。"
  },
  {
    "id": "s0417",
    "blockIndex": 25,
    "zh": "王章素剛直敢言，雖為鳳所舉，非鳳專權，不親附鳳，乃奏封事，言：「日食之咎，皆鳳專權蔽主之過。"
  },
  {
    "id": "s0417",
    "blockIndex": 25,
    "zh": "」上召見章，延問以事。"
  },
  {
    "id": "s0417",
    "blockIndex": 25,
    "zh": "章對曰：「天道聰明，佑善而災惡，以瑞異為符效。"
  },
  {
    "id": "s0417",
    "blockIndex": 25,
    "zh": "今陛下以未有繼嗣，引近定陶王，所以承宗廟，重社稷，上順天心，下安百姓，此正議善事，當有祥瑞，何故致災異！"
  },
  {
    "id": "s0417",
    "blockIndex": 25,
    "zh": "災異之發，為大臣顓政者也。"
  },
  {
    "id": "s0417",
    "blockIndex": 25,
    "zh": "今聞大將軍猥歸日食之咎於定陶王，建遣之國，苟欲使天子孤立於上，顓擅朝事以便其私，非忠臣也。"
  },
  {
    "id": "s0417",
    "blockIndex": 25,
    "zh": "且日食，陰侵陽，臣顓君之咎。"
  },
  {
    "id": "s0417",
    "blockIndex": 25,
    "zh": "今政事大小皆自鳳出，天子曾不壹舉手，鳳不內省責，反歸咎善人，推遠定陶王。"
  },
  {
    "id": "s0417",
    "blockIndex": 25,
    "zh": "且鳳誣罔不忠，非一事也。"
  },
  {
    "id": "s0417",
    "blockIndex": 25,
    "zh": "前丞相樂昌侯商，本以先帝外屬，內行篤，有威重，位歷將相，國家柱石臣也，其人守正，不肯屈節隨鳳委曲；"
  },
  {
    "id": "s0417",
    "blockIndex": 25,
    "zh": "卒用閨門之事為鳳所罷，身以憂死，眾庶愍之。"
  },
  {
    "id": "s0417",
    "blockIndex": 25,
    "zh": "又鳳知其小婦弟張美人已嘗適人，於禮不宜配御至尊，托以為宜子，內之後宮，苟以私其妻弟；"
  },
  {
    "id": "s0417",
    "blockIndex": 25,
    "zh": "聞張美人未嘗任身就館也。"
  },
  {
    "id": "s0417",
    "blockIndex": 25,
    "zh": "且羌、胡尚殺首子以蕩腸正世，況於天子，而近已出之女也！"
  },
  {
    "id": "s0417",
    "blockIndex": 25,
    "zh": "此三者皆大事，陛下所自見，足以知其餘及它所不見者。"
  },
  {
    "id": "s0417",
    "blockIndex": 25,
    "zh": "鳳不可令久典事，宜退使就第，選忠賢以代之！"
  },
  {
    "id": "s0417",
    "blockIndex": 25,
    "zh": "」自鳳之白罷商，後遣定陶王也，上不能平；"
  },
  {
    "id": "s0417",
    "blockIndex": 25,
    "zh": "及聞章言，天子感寤，納之，謂章曰：「微京兆尹直言，吾不聞社稷計。"
  },
  {
    "id": "s0417",
    "blockIndex": 25,
    "zh": "且唯賢知賢，君試為朕求可以自輔者。"
  },
  {
    "id": "s0417",
    "blockIndex": 25,
    "zh": "」於是章奏封事，薦信都王舅琅邪太守馮野王，忠信質直，知謀有餘。"
  },
  {
    "id": "s0417",
    "blockIndex": 25,
    "zh": "以王舅出，以賢復入，明聖主樂進賢也。"
  },
  {
    "id": "s0417",
    "blockIndex": 25,
    "zh": "上自為太子時，數聞野王先帝名卿，聲譽出鳳遠甚，方倚欲以代鳳。"
  },
  {
    "id": "s0417",
    "blockIndex": 25,
    "zh": "章每召見，上輒辟左右。"
  },
  {
    "id": "s0417",
    "blockIndex": 25,
    "zh": "時太后從弟子侍中音獨側聽，具知章言，以語鳳。"
  },
  {
    "id": "s0417",
    "blockIndex": 25,
    "zh": "鳳聞之，甚憂懼。"
  },
  {
    "id": "s0417",
    "blockIndex": 25,
    "zh": "杜欽令鳳稱病出就第，上疏乞骸骨，其辭指甚哀。"
  },
  {
    "id": "s0417",
    "blockIndex": 25,
    "zh": "太后聞之，為垂涕，不御食。"
  },
  {
    "id": "s0417",
    "blockIndex": 25,
    "zh": "上少而親倚鳳，弗忍廢，乃優詔報鳳，強起之；"
  },
  {
    "id": "s0417",
    "blockIndex": 25,
    "zh": "於是鳳起視事。"
  },
  {
    "id": "s0446",
    "blockIndex": 26,
    "zh": "上使尚書劾奏章：「知野王前以王舅出補吏，而私薦之，欲令在朝，阿附諸侯；"
  },
  {
    "id": "s0446",
    "blockIndex": 26,
    "zh": "又知張美人體御至尊，而妄稱引羌胡殺子蕩腸，非所宜言。"
  },
  {
    "id": "s0446",
    "blockIndex": 26,
    "zh": "」下章吏。"
  },
  {
    "id": "s0446",
    "blockIndex": 26,
    "zh": "廷尉致其大逆罪，以為「比上夷狄，欲絕繼嗣之端，背畔天子，私為定陶王。"
  },
  {
    "id": "s0446",
    "blockIndex": 26,
    "zh": "」章竟死獄中，妻子徙合浦。"
  },
  {
    "id": "s0446",
    "blockIndex": 26,
    "zh": "自是公卿見鳳，側目而視。"
  },
  {
    "id": "s0446",
    "blockIndex": 26,
    "zh": "馮野王懼不自安，遂病；"
  },
  {
    "id": "s0446",
    "blockIndex": 26,
    "zh": "滿三月，賜告，與妻子歸杜陵就醫藥。"
  },
  {
    "id": "s0446",
    "blockIndex": 26,
    "zh": "大將軍鳳風御史中丞劾奏「野王賜告養病而私自便，持虎符出界歸家，奉詔不敬。"
  },
  {
    "id": "s0446",
    "blockIndex": 26,
    "zh": "」杜欽奏記於鳳曰：「二千石病，賜告得歸，有故事；"
  },
  {
    "id": "s0446",
    "blockIndex": 26,
    "zh": "不得去郡，亡著令。"
  },
  {
    "id": "s0446",
    "blockIndex": 26,
    "zh": "《傳》曰：『賞疑從予，』所以廣恩勸功也；"
  },
  {
    "id": "s0446",
    "blockIndex": 26,
    "zh": "『罰疑從去，』所以慎刑，闕難知也。"
  },
  {
    "id": "s0446",
    "blockIndex": 26,
    "zh": "今釋令與故事而假不敬之法，甚違『闕疑從去』之意。"
  },
  {
    "id": "s0446",
    "blockIndex": 26,
    "zh": "即以二千石守千里之地，任兵馬之重，不宜去郡，將以制刑為後法者，則野王之罪在未制令前也。"
  },
  {
    "id": "s0446",
    "blockIndex": 26,
    "zh": "刑賞大信，不可不慎。"
  },
  {
    "id": "s0446",
    "blockIndex": 26,
    "zh": "」鳳不聽，竟免野王官。"
  },
  {
    "id": "s0446",
    "blockIndex": 26,
    "zh": "時眾庶多冤王章譏朝廷者，欽欲救其過，復說鳳曰：「京兆尹章，所坐事密，自京師不曉，況於遠方！"
  },
  {
    "id": "s0446",
    "blockIndex": 26,
    "zh": "恐天下不知章實有罪，而以為坐言事。"
  },
  {
    "id": "s0446",
    "blockIndex": 26,
    "zh": "如是，塞爭引之原，損寬明之德。"
  },
  {
    "id": "s0446",
    "blockIndex": 26,
    "zh": "欽愚以為宜因章事舉直言極諫，並見郎從官，展盡其意，加於往前，以明示四方，使天下咸知主上聖明，不以言罪下也。"
  },
  {
    "id": "s0446",
    "blockIndex": 26,
    "zh": "若此，則流言消釋，疑惑著明。"
  },
  {
    "id": "s0446",
    "blockIndex": 26,
    "zh": "」鳳白行其策焉。"
  },
  {
    "id": "s0446",
    "blockIndex": 26,
    "zh": "----4　是歲，陳留太守薛宣為左馮翊。"
  },
  {
    "id": "s0446",
    "blockIndex": 26,
    "zh": "宣為郡，所至有聲跡。"
  },
  {
    "id": "s0446",
    "blockIndex": 26,
    "zh": "宣子惠為彭城令，宣嘗過其縣，心知惠不能，不問以吏事。"
  },
  {
    "id": "s0446",
    "blockIndex": 26,
    "zh": "或問宣：「何不教戒惠以吏職？"
  },
  {
    "id": "s0446",
    "blockIndex": 26,
    "zh": "」宣笑曰：「吏道以法令為師，可問而知；"
  },
  {
    "id": "s0446",
    "blockIndex": 26,
    "zh": "及能與不能，自有資材，何可學也！"
  },
  {
    "id": "s0446",
    "blockIndex": 26,
    "zh": "」眾人傳稱，以宣言為然。"
  },
  {
    "id": "s0477",
    "blockIndex": 27,
    "zh": "1　春，三月，大赦天下。"
  },
  {
    "id": "s0477",
    "blockIndex": 27,
    "zh": "----2　御史大夫張忠卒。"
  },
  {
    "id": "s0479",
    "blockIndex": 28,
    "zh": "夏，四月，丁卯，以侍中、太僕王音為御史大夫。"
  },
  {
    "id": "s0479",
    "blockIndex": 28,
    "zh": "於是王氏愈盛，郡國守相、刺史皆出其門下。"
  },
  {
    "id": "s0479",
    "blockIndex": 28,
    "zh": "五侯群弟爭為奢侈，賂遺珍寶，四面而至，皆通敏人事，好士養賢，傾財施予以相高尚；"
  },
  {
    "id": "s0479",
    "blockIndex": 28,
    "zh": "賓客滿門，競為之聲譽。"
  },
  {
    "id": "s0479",
    "blockIndex": 28,
    "zh": "劉向謂陳湯曰：「今災異如此，而外家日盛，其漸必危劉氏。"
  },
  {
    "id": "s0479",
    "blockIndex": 28,
    "zh": "吾幸得以同姓末屬，累世蒙漢厚恩，身為宗室遺老，歷事三主。"
  },
  {
    "id": "s0479",
    "blockIndex": 28,
    "zh": "上以我先帝舊臣，每進見，常加優禮。"
  },
  {
    "id": "s0479",
    "blockIndex": 28,
    "zh": "吾而不言，孰當言者！"
  },
  {
    "id": "s0479",
    "blockIndex": 28,
    "zh": "」遂上封事極諫曰：「臣聞人君莫不欲安，然而常危；"
  },
  {
    "id": "s0479",
    "blockIndex": 28,
    "zh": "莫不欲存，然而常亡；"
  },
  {
    "id": "s0479",
    "blockIndex": 28,
    "zh": "失御臣之術也。"
  },
  {
    "id": "s0479",
    "blockIndex": 28,
    "zh": "夫大臣操權柄，持國政，未有不為害者也。"
  },
  {
    "id": "s0479",
    "blockIndex": 28,
    "zh": "故《書》曰：『臣之有作威作福，害於而家，凶於而國。"
  },
  {
    "id": "s0479",
    "blockIndex": 28,
    "zh": "』孔子曰：『祿去公室，政逮大夫，』危亡之兆也。"
  },
  {
    "id": "s0479",
    "blockIndex": 28,
    "zh": "今王氏一姓，乘朱輪華轂者二十三人，青、紫、貂、蟬充盈幄內，魚鱗左右。"
  },
  {
    "id": "s0479",
    "blockIndex": 28,
    "zh": "大將軍秉事用權，五侯驕奢僭盛，並作威福，擊斷自恣，行污而寄治，身私而托公，依東宮之尊，假甥舅之親，以為威重。"
  },
  {
    "id": "s0479",
    "blockIndex": 28,
    "zh": "尚書、九卿、州牧、郡守皆出其門，管執樞機，朋黨比周；"
  },
  {
    "id": "s0479",
    "blockIndex": 28,
    "zh": "稱譽者登進，忤恨者誅傷；"
  },
  {
    "id": "s0479",
    "blockIndex": 28,
    "zh": "游談者助之說，執政者為之言，排擯宗室，孤弱公族，其有智能者，尤非毀而不進，遠絕宗室之任，不令得給事朝省，恐其與己分權；"
  },
  {
    "id": "s0479",
    "blockIndex": 28,
    "zh": "數稱燕王、蓋主以疑上心，避諱呂、霍而弗肯稱。"
  },
  {
    "id": "s0479",
    "blockIndex": 28,
    "zh": "內有管、蔡之萌，外假周公之論，兄弟據重，宗族磐互，歷上古至秦、漢，外戚僭貴未有如王氏者也。"
  },
  {
    "id": "s0479",
    "blockIndex": 28,
    "zh": "物盛必有非常之變先見，為其人微象。"
  },
  {
    "id": "s0479",
    "blockIndex": 28,
    "zh": "孝昭帝時，冠石立於泰山，僕柳起於上林，而孝宣帝即位。"
  },
  {
    "id": "s0479",
    "blockIndex": 28,
    "zh": "今王氏先祖墳墓在濟南者，其梓柱生枝葉，扶疏上出屋，根垂地中，雖立石起柳，無以過此之明也。"
  },
  {
    "id": "s0479",
    "blockIndex": 28,
    "zh": "事勢不兩大，王氏與劉氏亦且不並立，如下有泰山之安，則上有累卵之危。"
  },
  {
    "id": "s0479",
    "blockIndex": 28,
    "zh": "陛下為人子孫，守持宗廟，而令國祚移於外親，降為皁隸，縱不為身，奈宗廟何！"
  },
  {
    "id": "s0479",
    "blockIndex": 28,
    "zh": "婦人內夫家而外父母家，此亦非皇太后之福也。"
  },
  {
    "id": "s0479",
    "blockIndex": 28,
    "zh": "孝宣皇帝不與舅平昌侯權，所以全安之也。"
  },
  {
    "id": "s0479",
    "blockIndex": 28,
    "zh": "夫明者起福於無形，銷患於未然，宜發明詔，吐德音，援近宗室，親而納信，黜遠外戚，毋授以政，皆罷令就弟，以則效先帝之所行，厚安外戚，全其宗族，誠東宮之意，外家之福也。"
  },
  {
    "id": "s0479",
    "blockIndex": 28,
    "zh": "王氏永存，保其爵祿，劉氏長安，不失社稷，所以褒睦外內之姓，子子孫孫無疆之計也。"
  },
  {
    "id": "s0479",
    "blockIndex": 28,
    "zh": "如不行此策，田氏復見於今，六卿必起於漢，為後嗣憂，昭昭甚明。"
  },
  {
    "id": "s0479",
    "blockIndex": 28,
    "zh": "唯陛下深留聖思！"
  },
  {
    "id": "s0479",
    "blockIndex": 28,
    "zh": "」書奏，天子召見向，歎息悲傷其意，謂曰：「君且休矣，吾將思之。"
  },
  {
    "id": "s0479",
    "blockIndex": 28,
    "zh": "」然終不能用其言。"
  },
  {
    "id": "s0479",
    "blockIndex": 28,
    "zh": "----3　秋，關東大水。"
  },
  {
    "id": "s0479",
    "blockIndex": 28,
    "zh": "----4　八月，甲申，定陶共王康薨。"
  },
  {
    "id": "s0479",
    "blockIndex": 28,
    "zh": "----5　是歲，徙信都王興為中山王。"
  },
  {
    "id": "s0479",
    "blockIndex": 28,
    "zh": "----category:資治通鑑"
  }
]
