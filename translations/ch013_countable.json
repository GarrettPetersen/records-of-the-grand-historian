[
  {
    "id": "s0001",
    "blockIndex": 0,
    "zh": "起閼逢攝提格，盡昭陽大淵獻，凡十年。"
  },
  {
    "id": "s0002",
    "blockIndex": 0,
    "zh": "1冬，太后議欲立諸呂為王，問右丞相陵。"
  },
  {
    "id": "s0003",
    "blockIndex": 0,
    "zh": "陵曰：「高帝刑白馬盟曰：『非劉氏而王，天下共擊之。"
  },
  {
    "id": "s0004",
    "blockIndex": 0,
    "zh": "』今王呂氏，非約也。"
  },
  {
    "id": "s0005",
    "blockIndex": 0,
    "zh": "」太后不說，問左丞相平、太尉勃，對曰：「高帝定天下，王子弟；"
  },
  {
    "id": "s0006",
    "blockIndex": 0,
    "zh": "今太后稱制，王諸呂，無所不可。"
  },
  {
    "id": "s0007",
    "blockIndex": 0,
    "zh": "」太后喜，罷朝。"
  },
  {
    "id": "s0008",
    "blockIndex": 0,
    "zh": "王陵讓陳平、絳侯曰：「始與高帝啑血盟，諸君不在邪？"
  },
  {
    "id": "s0009",
    "blockIndex": 0,
    "zh": "今高帝崩，太后女主，欲王呂氏；"
  },
  {
    "id": "s0010",
    "blockIndex": 0,
    "zh": "諸君縱欲阿意背約，何面目見高帝於地下乎？"
  },
  {
    "id": "s0011",
    "blockIndex": 0,
    "zh": "」陳平、降侯曰：「於今，面折廷爭，臣不如君；"
  },
  {
    "id": "s0012",
    "blockIndex": 0,
    "zh": "全社稷，定劉氏之後，君亦不如臣。"
  },
  {
    "id": "s0013",
    "blockIndex": 0,
    "zh": "」陵無以應之。"
  },
  {
    "id": "s0014",
    "blockIndex": 0,
    "zh": "十一月，甲子，太后以王陵為帝太傅，實奪之相權。"
  },
  {
    "id": "s0015",
    "blockIndex": 0,
    "zh": "陵遂病免歸。"
  },
  {
    "id": "s0016",
    "blockIndex": 1,
    "zh": "乃以左丞相平為右丞相，以辟陽侯審食其為左丞相，不治事，令監宮中，如郎中令。"
  },
  {
    "id": "s0017",
    "blockIndex": 1,
    "zh": "食其故得幸於太后，公卿皆因而決事。"
  },
  {
    "id": "s0018",
    "blockIndex": 2,
    "zh": "太后怨趙堯為趙隱王謀，乃抵堯罪。"
  },
  {
    "id": "s0019",
    "blockIndex": 3,
    "zh": "上黨守任敖嘗為沛獄吏，有德於太后，乃以為御史大夫。"
  },
  {
    "id": "s0020",
    "blockIndex": 4,
    "zh": "太后又追尊其父臨泗侯呂公為宣王，兄周呂令武侯澤為悼武王，欲以王諸呂為漸。"
  },
  {
    "id": "s0021",
    "blockIndex": 4,
    "zh": "----2春，正月，除三族罪、妖言令。"
  },
  {
    "id": "s0022",
    "blockIndex": 4,
    "zh": "----3夏，四月，魯元公主薨。"
  },
  {
    "id": "s0023",
    "blockIndex": 4,
    "zh": "封公主子張偃為魯王，謚公主曰魯元太后。"
  },
  {
    "id": "s0024",
    "blockIndex": 4,
    "zh": "----4辛卯，封所名孝惠子山為襄城侯，朝為軹侯，武為壺關侯。"
  },
  {
    "id": "s0025",
    "blockIndex": 5,
    "zh": "太后欲王呂氏，乃先立所名孝惠子強為淮陽王，不疑為恆山王；"
  },
  {
    "id": "s0026",
    "blockIndex": 5,
    "zh": "使大謁者張釋風大臣。"
  },
  {
    "id": "s0027",
    "blockIndex": 5,
    "zh": "大臣乃請立悼武王長子酈侯台為呂王，割齊之濟南郡為呂國。"
  },
  {
    "id": "s0028",
    "blockIndex": 5,
    "zh": "----5五月，丙申，趙王宮叢台災。"
  },
  {
    "id": "s0029",
    "blockIndex": 5,
    "zh": "----6秋，桃、李華。"
  },
  {
    "id": "s0030",
    "blockIndex": 5,
    "zh": "----1冬，十一月，呂肅王台薨。"
  },
  {
    "id": "s0031",
    "blockIndex": 5,
    "zh": "----2春，正月，乙卯，地震；"
  },
  {
    "id": "s0032",
    "blockIndex": 5,
    "zh": "羌道、武都道山崩。"
  },
  {
    "id": "s0033",
    "blockIndex": 5,
    "zh": "----3夏，五月，丙申，封楚元王子郢客為上邳侯，齊悼惠王子章為朱虛侯，令入宿衛，又以呂祿女妻章。"
  },
  {
    "id": "s0034",
    "blockIndex": 5,
    "zh": "----4六月，丙戌晦，日有食之。"
  },
  {
    "id": "s0035",
    "blockIndex": 5,
    "zh": "----5秋，七月，恆山哀王不疑薨。"
  },
  {
    "id": "s0036",
    "blockIndex": 5,
    "zh": "----6行八銖錢。"
  },
  {
    "id": "s0037",
    "blockIndex": 5,
    "zh": "----7癸丑，立襄成侯山為恆山王，更名義。"
  },
  {
    "id": "s0038",
    "blockIndex": 5,
    "zh": "----1夏，江水、漢水溢，流四千餘家。"
  },
  {
    "id": "s0039",
    "blockIndex": 5,
    "zh": "----2秋，星晝見。"
  },
  {
    "id": "s0040",
    "blockIndex": 5,
    "zh": "----3伊水、洛水溢，流千六百餘家。"
  },
  {
    "id": "s0041",
    "blockIndex": 5,
    "zh": "汝水溢，流八百餘家。"
  },
  {
    "id": "s0042",
    "blockIndex": 5,
    "zh": "----1春，二月，癸未，立所名孝惠子太為昌平侯。"
  },
  {
    "id": "s0043",
    "blockIndex": 5,
    "zh": "----2夏，四月，丙申，太后封女弟嬃為臨光侯。"
  },
  {
    "id": "s0044",
    "blockIndex": 5,
    "zh": "----3少帝浸長，自知非皇后子，乃出言曰：「-{后}-安能殺吾母而名我？"
  },
  {
    "id": "s0045",
    "blockIndex": 5,
    "zh": "我壯，即為變！"
  },
  {
    "id": "s0046",
    "blockIndex": 5,
    "zh": "」太后聞之，幽之永巷中，言帝病，左右莫得見。"
  },
  {
    "id": "s0047",
    "blockIndex": 5,
    "zh": "太后語群臣曰：「今皇帝病久不已，失惑昏亂，不能繼嗣治天下；"
  },
  {
    "id": "s0048",
    "blockIndex": 5,
    "zh": "其代之。"
  },
  {
    "id": "s0049",
    "blockIndex": 5,
    "zh": "」群臣皆頓首言：「皇太后為天下齊民計，所以安宗廟、社稷甚深。"
  },
  {
    "id": "s0050",
    "blockIndex": 5,
    "zh": "群臣頓首奉詔。"
  },
  {
    "id": "s0051",
    "blockIndex": 5,
    "zh": "」遂廢帝，幽殺之。"
  },
  {
    "id": "s0052",
    "blockIndex": 5,
    "zh": "五月，丙辰，立恆山王義為帝，更名曰弘，不稱元年，以太后制天下事故也。"
  },
  {
    "id": "s0053",
    "blockIndex": 5,
    "zh": "以軹侯朝為恆山王。"
  },
  {
    "id": "s0054",
    "blockIndex": 5,
    "zh": "----4是歲，以平陽侯曹窋為御史大夫。"
  },
  {
    "id": "s0055",
    "blockIndex": 5,
    "zh": "----5有司請禁南越關市、鐵器。"
  },
  {
    "id": "s0056",
    "blockIndex": 5,
    "zh": "南越王佗曰：「高帝立我，通使物。"
  },
  {
    "id": "s0057",
    "blockIndex": 5,
    "zh": "今高后聽讒臣，別異蠻夷，隔絕器物，此必長沙王計，欲倚中國擊滅南越而並王之，自為功也。"
  },
  {
    "id": "s0059",
    "blockIndex": 6,
    "zh": "1春，佗自稱南越武帝，發兵攻長沙，敗數縣而去。"
  },
  {
    "id": "s0060",
    "blockIndex": 6,
    "zh": "----2秋，八月，淮陽懷王強薨，以壺關侯武為淮陽王。"
  },
  {
    "id": "s0061",
    "blockIndex": 6,
    "zh": "----3九月，發河東、上黨騎屯北地。"
  },
  {
    "id": "s0062",
    "blockIndex": 6,
    "zh": "----4初令戍卒歲更。"
  },
  {
    "id": "s0063",
    "blockIndex": 6,
    "zh": "----1冬，十月，太后以呂王嘉居處驕恣，廢之。"
  },
  {
    "id": "s0064",
    "blockIndex": 6,
    "zh": "十一月，立肅王弟產為呂王。"
  },
  {
    "id": "s0065",
    "blockIndex": 6,
    "zh": "----2春，星晝見。"
  },
  {
    "id": "s0066",
    "blockIndex": 6,
    "zh": "----3夏，四月，丁酉，赦天下。"
  },
  {
    "id": "s0067",
    "blockIndex": 6,
    "zh": "----4封朱虛侯章弟興居為東牟侯，亦入宿衛。"
  },
  {
    "id": "s0068",
    "blockIndex": 6,
    "zh": "----5匈奴寇狄道，攻阿陽。"
  },
  {
    "id": "s0069",
    "blockIndex": 6,
    "zh": "----6行五分錢。"
  },
  {
    "id": "s0070",
    "blockIndex": 6,
    "zh": "----7宣平侯張敖卒，賜謚曰魯元王。"
  },
  {
    "id": "s0071",
    "blockIndex": 6,
    "zh": "----1冬，十二月，匈奴寇狄道，略二千餘人。"
  },
  {
    "id": "s0072",
    "blockIndex": 6,
    "zh": "----2春，正月，太后召趙幽王友。"
  },
  {
    "id": "s0073",
    "blockIndex": 6,
    "zh": "友以諸呂女為-{后}-，弗愛，愛他姬。"
  },
  {
    "id": "s0074",
    "blockIndex": 6,
    "zh": "諸呂女怒，去，讒之於太后曰：「王言『呂氏安得王？"
  },
  {
    "id": "s0075",
    "blockIndex": 6,
    "zh": "太后百歲後，吾必擊之。"
  },
  {
    "id": "s0076",
    "blockIndex": 6,
    "zh": "』」太后以故召趙王，趙王至，置邸，不得見，令衛圍守之，弗與食；"
  },
  {
    "id": "s0077",
    "blockIndex": 6,
    "zh": "其群臣或竊饋，輒捕論之。"
  },
  {
    "id": "s0078",
    "blockIndex": 6,
    "zh": "丁丑，趙王餓死，以民禮葬之長安民塚次。"
  },
  {
    "id": "s0079",
    "blockIndex": 6,
    "zh": "----3己丑，日食，晝晦。"
  },
  {
    "id": "s0080",
    "blockIndex": 6,
    "zh": "太后惡之，謂左右曰：「此為我也！"
  },
  {
    "id": "s0081",
    "blockIndex": 6,
    "zh": "」----4二月，徙梁王恢為趙王，呂王產為梁王。"
  },
  {
    "id": "s0082",
    "blockIndex": 6,
    "zh": "梁王不之國，為帝太傅。"
  },
  {
    "id": "s0083",
    "blockIndex": 6,
    "zh": "----5秋，七月，丁巳，立平昌侯太為濟川王。"
  },
  {
    "id": "s0084",
    "blockIndex": 6,
    "zh": "----6呂嬃女為將軍、營陵侯劉澤妻。"
  },
  {
    "id": "s0085",
    "blockIndex": 6,
    "zh": "澤者，高祖從祖昆弟也。"
  },
  {
    "id": "s0086",
    "blockIndex": 6,
    "zh": "齊人田生為之說大謁者張卿曰：「諸呂之王也，諸大臣未大服。"
  },
  {
    "id": "s0087",
    "blockIndex": 6,
    "zh": "今營陵侯澤，諸劉最長；"
  },
  {
    "id": "s0088",
    "blockIndex": 6,
    "zh": "今卿言太后王之，呂氏王益固矣。"
  },
  {
    "id": "s0089",
    "blockIndex": 6,
    "zh": "」張卿入言太后，太后然之，乃割齊之琅邪郡封澤為琅邪王。"
  },
  {
    "id": "s0090",
    "blockIndex": 6,
    "zh": "----7趙王恢之徙趙，心懷不樂。"
  },
  {
    "id": "s0091",
    "blockIndex": 6,
    "zh": "太后以呂產女為王后，王后從官皆諸呂，擅權，微伺趙王，趙王不得自恣。"
  },
  {
    "id": "s0092",
    "blockIndex": 6,
    "zh": "王有所愛姬，王后使人鴆殺之。"
  },
  {
    "id": "s0093",
    "blockIndex": 6,
    "zh": "六月，王不勝悲憤，自殺。"
  },
  {
    "id": "s0094",
    "blockIndex": 6,
    "zh": "太后聞之，以為王用婦人棄宗廟禮，廢其嗣。"
  },
  {
    "id": "s0095",
    "blockIndex": 6,
    "zh": "----8是時，諸呂擅權用事。"
  },
  {
    "id": "s0096",
    "blockIndex": 6,
    "zh": "朱虛侯章，年二十，有氣力，忿劉氏不得職。"
  },
  {
    "id": "s0097",
    "blockIndex": 6,
    "zh": "嘗入侍太后燕飲，太后令章為酒吏。"
  },
  {
    "id": "s0098",
    "blockIndex": 6,
    "zh": "章自請曰：「臣將種也，請得以軍法行酒。"
  },
  {
    "id": "s0099",
    "blockIndex": 6,
    "zh": "」太后曰：「可。"
  },
  {
    "id": "s0100",
    "blockIndex": 6,
    "zh": "」酒酣，章請為《耕田歌》，太后許之。"
  },
  {
    "id": "s0101",
    "blockIndex": 6,
    "zh": "章曰：「深耕穊種，立苗欲疏；"
  },
  {
    "id": "s0102",
    "blockIndex": 6,
    "zh": "非其種者，鋤而去之！"
  },
  {
    "id": "s0103",
    "blockIndex": 6,
    "zh": "」太后默然。"
  },
  {
    "id": "s0104",
    "blockIndex": 6,
    "zh": "頃之，諸呂有一人醉，亡酒，章追，拔劍斬之而還，報曰：「有亡酒一人，臣謹行法斬之！"
  },
  {
    "id": "s0105",
    "blockIndex": 6,
    "zh": "」太后左右皆大驚，業已許其軍法，無以罪也，因罷。"
  },
  {
    "id": "s0106",
    "blockIndex": 6,
    "zh": "自是之後，諸呂憚朱虛侯，雖大臣皆依朱虛侯，劉氏為益強。"
  },
  {
    "id": "s0107",
    "blockIndex": 7,
    "zh": "陳平患諸呂，力不能制，恐禍及己。"
  },
  {
    "id": "s0108",
    "blockIndex": 7,
    "zh": "嘗燕居深念，陸賈往，直入坐，而陳丞相不見。"
  },
  {
    "id": "s0109",
    "blockIndex": 7,
    "zh": "陸生曰：「何念之深也！"
  },
  {
    "id": "s0110",
    "blockIndex": 7,
    "zh": "」陳平曰：「生揣我何念？"
  },
  {
    "id": "s0111",
    "blockIndex": 7,
    "zh": "」陸生曰：「足下極富貴，無欲矣；"
  },
  {
    "id": "s0112",
    "blockIndex": 7,
    "zh": "然有憂念，不過患諸呂、少主耳。"
  },
  {
    "id": "s0113",
    "blockIndex": 7,
    "zh": "」陳平曰：「然！"
  },
  {
    "id": "s0114",
    "blockIndex": 7,
    "zh": "為之奈何？"
  },
  {
    "id": "s0115",
    "blockIndex": 7,
    "zh": "」陸生曰：「天下安，注意相；"
  },
  {
    "id": "s0116",
    "blockIndex": 7,
    "zh": "天下危，注意將。"
  },
  {
    "id": "s0117",
    "blockIndex": 7,
    "zh": "將相和調，則士豫附；"
  },
  {
    "id": "s0118",
    "blockIndex": 7,
    "zh": "天下雖有變，權不分。"
  },
  {
    "id": "s0119",
    "blockIndex": 7,
    "zh": "為社稷計，在兩君掌握耳。"
  },
  {
    "id": "s0120",
    "blockIndex": 7,
    "zh": "臣常欲謂太尉絳侯，絳侯與我戲，易吾言。"
  },
  {
    "id": "s0121",
    "blockIndex": 7,
    "zh": "君何不交歡太尉，深相結？"
  },
  {
    "id": "s0122",
    "blockIndex": 7,
    "zh": "」因為陳平畫呂氏數事。"
  },
  {
    "id": "s0123",
    "blockIndex": 7,
    "zh": "陳平用其計，乃以五百金為絳侯壽，厚具樂飲；"
  },
  {
    "id": "s0124",
    "blockIndex": 7,
    "zh": "太尉報亦如之。"
  },
  {
    "id": "s0125",
    "blockIndex": 7,
    "zh": "兩人深相結，呂氏謀益衰。"
  },
  {
    "id": "s0126",
    "blockIndex": 7,
    "zh": "陳平以奴婢百人、車馬五十乘、錢五百萬遺陸生為飲食費。"
  },
  {
    "id": "s0127",
    "blockIndex": 7,
    "zh": "----9太后使使告代王，欲徙王趙。"
  },
  {
    "id": "s0128",
    "blockIndex": 7,
    "zh": "代王謝之，願守代邊。"
  },
  {
    "id": "s0129",
    "blockIndex": 7,
    "zh": "太后乃立兄子呂祿為趙王，追尊祿父建成康侯釋之為趙昭王。"
  },
  {
    "id": "s0130",
    "blockIndex": 7,
    "zh": "----10九月，燕靈王建薨，有美人子，太后使人殺之。"
  },
  {
    "id": "s0131",
    "blockIndex": 7,
    "zh": "國除。"
  },
  {
    "id": "s0132",
    "blockIndex": 7,
    "zh": "----11遣隆慮侯周灶將兵擊南越。"
  },
  {
    "id": "s0133",
    "blockIndex": 7,
    "zh": "----1冬，十月，辛丑，立呂肅王子東平侯通為燕王，封通弟莊為東平侯。"
  },
  {
    "id": "s0134",
    "blockIndex": 7,
    "zh": "----2三月，太后祓，還，過軹道，見物如蒼犬，撠太后掖，忽不復見。"
  },
  {
    "id": "s0135",
    "blockIndex": 7,
    "zh": "卜之，云「趙王如意為祟」。"
  },
  {
    "id": "s0136",
    "blockIndex": 7,
    "zh": "太后遂病掖傷。"
  },
  {
    "id": "s0137",
    "blockIndex": 8,
    "zh": "太后為外孫魯王偃年少孤弱，夏，四月，丁酉，封張敖前姬兩子侈為新都侯，壽為樂昌侯，以輔魯王。"
  },
  {
    "id": "s0138",
    "blockIndex": 8,
    "zh": "又封中大謁者張釋為建陵侯，以其勸王諸呂，賞之也。"
  },
  {
    "id": "s0139",
    "blockIndex": 8,
    "zh": "----3江、漢水溢，流萬餘家。"
  },
  {
    "id": "s0140",
    "blockIndex": 8,
    "zh": "----4秋，七月，太后病甚，乃令趙王祿為上將軍，居北軍；"
  },
  {
    "id": "s0141",
    "blockIndex": 8,
    "zh": "呂王產居南軍。"
  },
  {
    "id": "s0142",
    "blockIndex": 8,
    "zh": "太后誡產、祿曰：「呂氏之王，大臣弗平。"
  },
  {
    "id": "s0143",
    "blockIndex": 8,
    "zh": "我即崩，帝年少，大臣恐為變。"
  },
  {
    "id": "s0144",
    "blockIndex": 8,
    "zh": "必據兵衛宮，慎毋送喪，為人所制！"
  },
  {
    "id": "s0145",
    "blockIndex": 8,
    "zh": "」辛巳，太后崩，遺詔：大赦天下，以呂王產為相國，以呂祿女為帝后。"
  },
  {
    "id": "s0146",
    "blockIndex": 8,
    "zh": "高後已葬，以左丞相審食其為帝太傅。"
  },
  {
    "id": "s0147",
    "blockIndex": 8,
    "zh": "----5諸呂欲為亂，畏大臣絳、灌等，未敢發。"
  },
  {
    "id": "s0148",
    "blockIndex": 8,
    "zh": "朱虛侯以呂祿女為婦，故知其謀，乃陰令人告其兄齊王，欲令發兵西，朱虛侯、東牟侯為內應，以誅諸呂，立齊王為帝。"
  },
  {
    "id": "s0149",
    "blockIndex": 8,
    "zh": "齊王乃與其舅駟鈞、郎中令祝午、中尉魏勃陰謀發兵。"
  },
  {
    "id": "s0150",
    "blockIndex": 8,
    "zh": "齊相召平弗聽。"
  },
  {
    "id": "s0151",
    "blockIndex": 8,
    "zh": "八月，丙午，齊王欲使人誅相。"
  },
  {
    "id": "s0152",
    "blockIndex": 8,
    "zh": "相聞之，乃發卒衛王宮。"
  },
  {
    "id": "s0153",
    "blockIndex": 8,
    "zh": "魏勃紿召平曰：「王欲發兵，非有漢虎符驗也。"
  },
  {
    "id": "s0154",
    "blockIndex": 8,
    "zh": "而相君圍王固善，勃請為君將兵衛王。"
  },
  {
    "id": "s0155",
    "blockIndex": 8,
    "zh": "」召平信之。"
  },
  {
    "id": "s0156",
    "blockIndex": 8,
    "zh": "勃既將兵，遂圍相府，召平自殺。"
  },
  {
    "id": "s0157",
    "blockIndex": 8,
    "zh": "於是齊王以駟鈞為相，魏勃為將軍，祝午為內史，悉發國中兵。"
  },
  {
    "id": "s0158",
    "blockIndex": 9,
    "zh": "使祝午東詐琅邪王曰：「呂氏作亂，齊王發兵欲西誅之。"
  },
  {
    "id": "s0159",
    "blockIndex": 9,
    "zh": "齊王自以年少，不習兵革之事，願舉國委大王。"
  },
  {
    "id": "s0160",
    "blockIndex": 9,
    "zh": "大王，自高帝將也。"
  },
  {
    "id": "s0161",
    "blockIndex": 9,
    "zh": "請大王幸之臨菑，見齊王計事。"
  },
  {
    "id": "s0162",
    "blockIndex": 9,
    "zh": "」琅邪王信之，西馳見齊王。"
  },
  {
    "id": "s0163",
    "blockIndex": 9,
    "zh": "齊王因留琅邪王，而使祝午盡發琅邪國兵，並將之。"
  },
  {
    "id": "s0164",
    "blockIndex": 9,
    "zh": "琅邪王說齊王曰：「大王，高皇帝適長孫也，當立。"
  },
  {
    "id": "s0165",
    "blockIndex": 9,
    "zh": "今諸大臣狐疑未有所定，而澤於劉氏最為長年，大臣固待澤決計。"
  },
  {
    "id": "s0166",
    "blockIndex": 9,
    "zh": "今大王留臣，無為也，不如使我入關計事。"
  },
  {
    "id": "s0167",
    "blockIndex": 9,
    "zh": "」齊王以為然，乃益具車送琅邪王。"
  },
  {
    "id": "s0168",
    "blockIndex": 9,
    "zh": "琅邪王既行，齊遂舉兵西攻濟南。"
  },
  {
    "id": "s0169",
    "blockIndex": 9,
    "zh": "遺諸侯王書，陳諸呂之罪，欲舉兵誅之。"
  },
  {
    "id": "s0170",
    "blockIndex": 10,
    "zh": "相國呂產等聞之，乃遣穎陰侯灌嬰將兵擊之。"
  },
  {
    "id": "s0171",
    "blockIndex": 10,
    "zh": "灌嬰至滎陽，謀曰：「諸呂擁兵關中，欲危劉氏而自立。"
  },
  {
    "id": "s0172",
    "blockIndex": 10,
    "zh": "今我破齊還報，此益呂氏之資也。"
  },
  {
    "id": "s0173",
    "blockIndex": 10,
    "zh": "」乃留屯滎陽，使使諭齊王及諸侯與連和，以待呂氏變，共誅之。"
  },
  {
    "id": "s0174",
    "blockIndex": 10,
    "zh": "齊王聞之，乃還兵西界待約。"
  },
  {
    "id": "s0175",
    "blockIndex": 11,
    "zh": "呂祿、呂產欲作亂，內憚絳侯、朱虛等，外畏齊、楚兵，又恐灌嬰畔之。"
  },
  {
    "id": "s0176",
    "blockIndex": 11,
    "zh": "欲待灌嬰兵與齊合而發，猶豫未決。"
  },
  {
    "id": "s0177",
    "blockIndex": 12,
    "zh": "當是時，濟川王太、淮陽王武、常山王朝及魯王張偃皆年少，未之國，居長安；"
  },
  {
    "id": "s0178",
    "blockIndex": 12,
    "zh": "趙王祿、梁王產各將兵居南、北軍。"
  },
  {
    "id": "s0179",
    "blockIndex": 12,
    "zh": "皆呂氏之人也。"
  },
  {
    "id": "s0180",
    "blockIndex": 12,
    "zh": "列侯群臣莫自堅其命。"
  },
  {
    "id": "s0181",
    "blockIndex": 13,
    "zh": "太尉絳侯勃不得主兵。"
  },
  {
    "id": "s0182",
    "blockIndex": 13,
    "zh": "曲周侯酈商老病，其子寄與呂祿善。"
  },
  {
    "id": "s0183",
    "blockIndex": 13,
    "zh": "絳侯乃與丞相陳平謀，使人劫酈商，令其子寄往紿說呂祿曰：「高帝與-{呂后}-共定天下，劉氏所立九王，呂氏所立三王，皆大臣之議，事已佈告諸侯，皆以為宜。"
  },
  {
    "id": "s0184",
    "blockIndex": 13,
    "zh": "今太后崩，帝少，而足下佩趙王印，不急之國守籓，乃為上將，將兵留此，為大臣諸侯所疑。"
  },
  {
    "id": "s0185",
    "blockIndex": 13,
    "zh": "足下何不歸將印，以兵屬太尉，請梁王歸相國印，與大臣盟而之國。"
  },
  {
    "id": "s0186",
    "blockIndex": 13,
    "zh": "齊兵必罷，大臣得安，足下高枕而王千里，此萬世之利也。"
  },
  {
    "id": "s0187",
    "blockIndex": 13,
    "zh": "」呂祿信然其計，欲以兵屬太尉。"
  },
  {
    "id": "s0188",
    "blockIndex": 13,
    "zh": "使人報呂產及諸呂老人，或以為便，或曰不便，計猶豫未有所決。"
  },
  {
    "id": "s0189",
    "blockIndex": 14,
    "zh": "呂祿信酈寄，時與出遊獵，過其姑呂嬃。"
  },
  {
    "id": "s0190",
    "blockIndex": 14,
    "zh": "嬃大怒曰：「若為將而棄軍，呂氏今無處矣！"
  },
  {
    "id": "s0191",
    "blockIndex": 14,
    "zh": "」乃悉出珠玉、寶器散堂下，曰：「毋為他人守也！"
  },
  {
    "id": "s0193",
    "blockIndex": 15,
    "zh": "九月，庚申旦，平陽侯窋行御史大夫事，見相國產計事。"
  },
  {
    "id": "s0194",
    "blockIndex": 15,
    "zh": "郎中令賈壽使從齊來，因數產曰：「王不早之國，今雖欲行，尚可得邪！"
  },
  {
    "id": "s0195",
    "blockIndex": 15,
    "zh": "」具以灌嬰與齊、楚合從欲誅諸呂告產，且趣產急入宮。"
  },
  {
    "id": "s0196",
    "blockIndex": 15,
    "zh": "平陽侯頗聞其語，馳告丞相、太尉。"
  },
  {
    "id": "s0197",
    "blockIndex": 16,
    "zh": "太尉欲入北軍，不得入。"
  },
  {
    "id": "s0198",
    "blockIndex": 16,
    "zh": "襄平侯紀通尚符節，乃令持節矯內太尉北軍。"
  },
  {
    "id": "s0199",
    "blockIndex": 16,
    "zh": "太尉復令酈寄與典客劉揭先說呂祿曰：「帝使太尉守北軍，欲足下之國。"
  },
  {
    "id": "s0200",
    "blockIndex": 16,
    "zh": "急歸將印辭去。"
  },
  {
    "id": "s0201",
    "blockIndex": 16,
    "zh": "不然，禍且起。"
  },
  {
    "id": "s0202",
    "blockIndex": 16,
    "zh": "」呂祿以為酈況不欺己，遂解印屬典客，而以兵授太尉。"
  },
  {
    "id": "s0203",
    "blockIndex": 16,
    "zh": "太尉至軍，呂祿已去。"
  },
  {
    "id": "s0204",
    "blockIndex": 16,
    "zh": "太尉入軍門，行令軍中曰：「為呂氏右袒，為劉氏左袒！"
  },
  {
    "id": "s0205",
    "blockIndex": 16,
    "zh": "」軍中皆左袒，太尉遂將北軍。"
  },
  {
    "id": "s0206",
    "blockIndex": 16,
    "zh": "然尚有南軍。"
  },
  {
    "id": "s0207",
    "blockIndex": 16,
    "zh": "丞相平乃召朱虛侯章佐太尉，太尉令朱虛侯監軍門，令平陽侯告衛尉：「毋入相國產殿門。"
  },
  {
    "id": "s0209",
    "blockIndex": 17,
    "zh": "呂產不知呂祿已去北軍，乃入未央宮，欲為亂。"
  },
  {
    "id": "s0210",
    "blockIndex": 17,
    "zh": "至殿門，弗得入，徘徊往來。"
  },
  {
    "id": "s0211",
    "blockIndex": 17,
    "zh": "平陽侯恐弗勝，馳語太尉。"
  },
  {
    "id": "s0212",
    "blockIndex": 17,
    "zh": "太尉尚恐不勝諸呂，未敢公言誅之，乃謂朱虛侯曰：「急入宮衛帝！"
  },
  {
    "id": "s0213",
    "blockIndex": 17,
    "zh": "」朱虛侯請卒，太尉予卒千餘人。"
  },
  {
    "id": "s0214",
    "blockIndex": 17,
    "zh": "入未央宮門，見產廷中。"
  },
  {
    "id": "s0215",
    "blockIndex": 17,
    "zh": "日哺時，遂擊產，產走。"
  },
  {
    "id": "s0216",
    "blockIndex": 17,
    "zh": "天風大起，以故其從官亂，莫敢鬬，逐產，殺之郎中府吏廁中。"
  },
  {
    "id": "s0217",
    "blockIndex": 17,
    "zh": "朱虛侯已殺產，帝命謁者持節勞朱虛侯。"
  },
  {
    "id": "s0218",
    "blockIndex": 17,
    "zh": "朱虛侯欲奪其節，謁者不肯。"
  },
  {
    "id": "s0219",
    "blockIndex": 17,
    "zh": "朱虛侯則從與載，因節信馳走，斬長樂衛尉呂更始。"
  },
  {
    "id": "s0220",
    "blockIndex": 17,
    "zh": "還，馳入北軍報太尉。"
  },
  {
    "id": "s0221",
    "blockIndex": 17,
    "zh": "太尉起，拜賀朱虛侯曰：「所患獨呂產。"
  },
  {
    "id": "s0222",
    "blockIndex": 17,
    "zh": "今已誅，天下定矣！"
  },
  {
    "id": "s0223",
    "blockIndex": 17,
    "zh": "」遂遣人分部悉捕諸呂男女，無少長皆斬之。"
  },
  {
    "id": "s0224",
    "blockIndex": 17,
    "zh": "辛酉，捕斬呂祿而笞殺呂嬃，使人誅燕王呂通而廢魯王張偃。"
  },
  {
    "id": "s0225",
    "blockIndex": 17,
    "zh": "戊辰，徙濟川王王梁。"
  },
  {
    "id": "s0226",
    "blockIndex": 17,
    "zh": "遣朱虛侯章以誅諸呂事告齊王，令罷兵。"
  },
  {
    "id": "s0227",
    "blockIndex": 18,
    "zh": "灌嬰在滎陽，聞魏勃本教齊王舉兵，使使召魏勃至，責問之。"
  },
  {
    "id": "s0228",
    "blockIndex": 18,
    "zh": "勃曰：「失火之家，豈暇先言丈人而後救火乎！"
  },
  {
    "id": "s0229",
    "blockIndex": 18,
    "zh": "」因退立，股戰而栗，恐不能言者，終無他語。"
  },
  {
    "id": "s0230",
    "blockIndex": 18,
    "zh": "灌將軍熟視笑曰：「人謂魏勃勇，妄庸人耳，何能為乎！"
  },
  {
    "id": "s0231",
    "blockIndex": 18,
    "zh": "」乃罷魏勃。"
  },
  {
    "id": "s0232",
    "blockIndex": 18,
    "zh": "灌嬰兵亦罷滎陽歸。"
  },
  {
    "id": "s0233",
    "blockIndex": 19,
    "zh": "::班固贊曰：孝文時，天下以酈寄為賣友。"
  },
  {
    "id": "s0234",
    "blockIndex": 19,
    "zh": "夫賣友者，謂見利而忘義也。"
  },
  {
    "id": "s0235",
    "blockIndex": 19,
    "zh": "若寄父為功臣而又執劫，雖摧呂祿以安社稷，誼存君親可也。"
  },
  {
    "id": "s0236",
    "blockIndex": 19,
    "zh": "----6諸大臣相與陰謀曰：「少帝及梁、淮陽、恆山王，皆非真孝惠子也。"
  },
  {
    "id": "s0237",
    "blockIndex": 19,
    "zh": "-{呂后}-以計詐名他人子，殺其母養後宮，令孝惠子之，立以為後及諸王，以強呂氏。"
  },
  {
    "id": "s0238",
    "blockIndex": 19,
    "zh": "今皆已夷滅諸呂，而所立即長，用事，吾屬無類矣。"
  },
  {
    "id": "s0239",
    "blockIndex": 19,
    "zh": "不如視諸王最賢者立之。"
  },
  {
    "id": "s0240",
    "blockIndex": 19,
    "zh": "」或言：「齊王，高帝長孫，可立也。"
  },
  {
    "id": "s0241",
    "blockIndex": 19,
    "zh": "」大臣皆曰：「呂氏以外家惡而幾危宗廟，亂功臣。"
  },
  {
    "id": "s0242",
    "blockIndex": 19,
    "zh": "今齊王舅駟鈞，虎而冠。"
  },
  {
    "id": "s0243",
    "blockIndex": 19,
    "zh": "即立齊王，復為呂氏矣。"
  },
  {
    "id": "s0244",
    "blockIndex": 19,
    "zh": "代王方今高帝見子最長，仁孝寬厚，太后家薄氏謹良。"
  },
  {
    "id": "s0245",
    "blockIndex": 19,
    "zh": "且立長固順，況以仁孝聞天下乎！"
  },
  {
    "id": "s0246",
    "blockIndex": 19,
    "zh": "」乃相與共陰使人召代王。"
  },
  {
    "id": "s0247",
    "blockIndex": 20,
    "zh": "代王問左右，郎中令張武等曰：「漢大臣皆故高帝時大將，習兵，多謀詐。"
  },
  {
    "id": "s0248",
    "blockIndex": 20,
    "zh": "此其屬意非止此也，特畏高帝、呂太后威耳。"
  },
  {
    "id": "s0249",
    "blockIndex": 20,
    "zh": "今已誅諸呂，新啑血京師，此以迎大王為名，實不可信。"
  },
  {
    "id": "s0250",
    "blockIndex": 20,
    "zh": "願大王稱疾毋往，以觀其變。"
  },
  {
    "id": "s0251",
    "blockIndex": 20,
    "zh": "」中尉宋昌進曰：「群臣之議皆非也。"
  },
  {
    "id": "s0252",
    "blockIndex": 20,
    "zh": "夫秦失其政，諸侯、豪桀並起，人人自以為得之者以萬數，然卒踐天子之位者，劉氏也，天下絕望，一矣。"
  },
  {
    "id": "s0253",
    "blockIndex": 20,
    "zh": "高帝封王子弟，地犬牙相制，此所謂磐石之宗也，天下服其強，二矣。"
  },
  {
    "id": "s0254",
    "blockIndex": 20,
    "zh": "漢興，除秦苛政，約法令，施德惠，人人自安，難動搖，三矣。"
  },
  {
    "id": "s0255",
    "blockIndex": 20,
    "zh": "夫以呂太后之嚴，立諸呂為三王，擅權專制；"
  },
  {
    "id": "s0256",
    "blockIndex": 20,
    "zh": "然而太尉以一節入北軍一呼，士皆左袒為劉氏，叛諸呂，卒以滅之。"
  },
  {
    "id": "s0257",
    "blockIndex": 20,
    "zh": "此乃天授，非人力也。"
  },
  {
    "id": "s0258",
    "blockIndex": 20,
    "zh": "今大臣雖欲為變，百姓弗為使，其黨寧能專一邪？"
  },
  {
    "id": "s0259",
    "blockIndex": 20,
    "zh": "方今內有朱虛、東牟之親，外畏吳、楚、淮陽、琅邪、齊、代之強。"
  },
  {
    "id": "s0260",
    "blockIndex": 20,
    "zh": "方今高帝子，獨淮南王與大王。"
  },
  {
    "id": "s0261",
    "blockIndex": 20,
    "zh": "大王又長，賢聖仁孝聞於天下，故大臣因天下之心而欲迎立大王。"
  },
  {
    "id": "s0262",
    "blockIndex": 20,
    "zh": "大王勿疑也。"
  },
  {
    "id": "s0263",
    "blockIndex": 20,
    "zh": "」代王報太后計之。"
  },
  {
    "id": "s0264",
    "blockIndex": 20,
    "zh": "猶豫未定，卜之，兆得大橫。"
  },
  {
    "id": "s0265",
    "blockIndex": 20,
    "zh": "占曰：「大橫庚庚，余為天王，夏啟以光。"
  },
  {
    "id": "s0266",
    "blockIndex": 20,
    "zh": "」代王曰：「寡人固已為王矣，又何王？"
  },
  {
    "id": "s0267",
    "blockIndex": 20,
    "zh": "」卜人曰：「所謂天王者，乃天子也。"
  },
  {
    "id": "s0268",
    "blockIndex": 20,
    "zh": "」於是代王遣太后弟薄昭往見絳侯，絳侯等具為昭言所以迎立王意。"
  },
  {
    "id": "s0269",
    "blockIndex": 20,
    "zh": "薄昭還報曰：「信矣，無可疑者。"
  },
  {
    "id": "s0270",
    "blockIndex": 20,
    "zh": "」代王乃笑謂宋昌曰：「果如公言。"
  },
  {
    "id": "s0272",
    "blockIndex": 21,
    "zh": "乃命宋昌參乘，張武等六人乘傳，從詣長安。"
  },
  {
    "id": "s0273",
    "blockIndex": 21,
    "zh": "至高陵，休止，而使宋昌先馳之長安觀變。"
  },
  {
    "id": "s0274",
    "blockIndex": 21,
    "zh": "昌至渭橋，丞相以下皆迎。"
  },
  {
    "id": "s0275",
    "blockIndex": 21,
    "zh": "昌還報。"
  },
  {
    "id": "s0276",
    "blockIndex": 21,
    "zh": "代王馳至渭橋，群臣拜謁稱臣，代王下車答拜。"
  },
  {
    "id": "s0277",
    "blockIndex": 21,
    "zh": "太尉勃進曰：「願請間。"
  },
  {
    "id": "s0278",
    "blockIndex": 21,
    "zh": "」宋昌曰：「所言公，公言之；"
  },
  {
    "id": "s0279",
    "blockIndex": 21,
    "zh": "所言私，王者無私。"
  },
  {
    "id": "s0280",
    "blockIndex": 21,
    "zh": "」太尉乃跪上天子璽、符。"
  },
  {
    "id": "s0281",
    "blockIndex": 21,
    "zh": "代王謝曰：「至代邸而議之。"
  },
  {
    "id": "s0283",
    "blockIndex": 22,
    "zh": "後九月，己酉晦，代王至長安，舍代邸，群臣從至邸。"
  },
  {
    "id": "s0284",
    "blockIndex": 22,
    "zh": "丞相陳平等皆再拜言曰：「子弘等皆非孝惠子，不當奉宗廟。"
  },
  {
    "id": "s0285",
    "blockIndex": 22,
    "zh": "大王，高帝長子，宜為嗣。"
  },
  {
    "id": "s0286",
    "blockIndex": 22,
    "zh": "願大王即天子位。"
  },
  {
    "id": "s0287",
    "blockIndex": 22,
    "zh": "」代王西鄉讓者三，南鄉讓者再，遂即天子位。"
  },
  {
    "id": "s0288",
    "blockIndex": 22,
    "zh": "群臣以禮次侍。"
  },
  {
    "id": "s0289",
    "blockIndex": 23,
    "zh": "東牟侯興居曰：「誅呂氏，臣無功，請得除宮。"
  },
  {
    "id": "s0290",
    "blockIndex": 23,
    "zh": "」乃與太僕汝陰侯滕公入宮，前謂少帝曰：「足下非劉氏子，不當立！"
  },
  {
    "id": "s0291",
    "blockIndex": 23,
    "zh": "」乃顧麾左右執戟者掊兵罷去；"
  },
  {
    "id": "s0292",
    "blockIndex": 23,
    "zh": "有數人不肯去兵，宦者令張釋諭告，亦去兵。"
  },
  {
    "id": "s0293",
    "blockIndex": 23,
    "zh": "滕公乃召乘輿車載少帝出。"
  },
  {
    "id": "s0294",
    "blockIndex": 23,
    "zh": "少帝曰：「欲將我安之乎？"
  },
  {
    "id": "s0295",
    "blockIndex": 23,
    "zh": "」滕公曰：「出就舍。"
  },
  {
    "id": "s0296",
    "blockIndex": 23,
    "zh": "」舍少府。"
  },
  {
    "id": "s0297",
    "blockIndex": 23,
    "zh": "乃奉天子法駕迎代王於邸，報曰：「宮謹除。"
  },
  {
    "id": "s0298",
    "blockIndex": 23,
    "zh": "」代王即夕入未央宮。"
  },
  {
    "id": "s0299",
    "blockIndex": 23,
    "zh": "有謁者十人持戟衛端門，曰：「天子在也，足下何為者而入？"
  },
  {
    "id": "s0300",
    "blockIndex": 23,
    "zh": "」代王乃謂太尉。"
  },
  {
    "id": "s0301",
    "blockIndex": 23,
    "zh": "太尉往諭，謁者十人皆掊兵而去，代王遂入。"
  },
  {
    "id": "s0302",
    "blockIndex": 23,
    "zh": "夜，拜宋昌為衛將軍，鎮撫南北軍；"
  },
  {
    "id": "s0303",
    "blockIndex": 23,
    "zh": "以張武為郎中令，行殿中。"
  },
  {
    "id": "s0304",
    "blockIndex": 23,
    "zh": "有司分部誅滅梁、淮陽、恆山王及少帝於邸。"
  },
  {
    "id": "s0305",
    "blockIndex": 23,
    "zh": "文帝還坐前殿，夜，下詔書赦天下。"
  },
  {
    "id": "s0306",
    "blockIndex": 24,
    "zh": "1冬，十月，庚戌，徙琅邪王澤為燕王；"
  },
  {
    "id": "s0307",
    "blockIndex": 24,
    "zh": "封趙幽王子遂為趙王。"
  },
  {
    "id": "s0308",
    "blockIndex": 24,
    "zh": "----2陳平謝病。"
  },
  {
    "id": "s0309",
    "blockIndex": 24,
    "zh": "上問之，平曰：「高祖時，勃功不如臣，及誅諸呂，臣功亦不如勃，願以右丞相讓勃。"
  },
  {
    "id": "s0310",
    "blockIndex": 24,
    "zh": "」十一月，辛巳，上徙平為左丞相，太尉勃為右丞相，大將軍灌嬰為太尉。"
  },
  {
    "id": "s0311",
    "blockIndex": 24,
    "zh": "諸呂所奪齊、楚故地，皆復與之。"
  },
  {
    "id": "s0312",
    "blockIndex": 24,
    "zh": "----3論誅諸呂功，右丞相勃以下益戶、賜金各有差。"
  },
  {
    "id": "s0313",
    "blockIndex": 24,
    "zh": "絳侯朝罷趨出，意得甚。"
  },
  {
    "id": "s0314",
    "blockIndex": 24,
    "zh": "上禮之恭，常目送之。"
  },
  {
    "id": "s0315",
    "blockIndex": 24,
    "zh": "郎中安陵袁盎諫曰：「諸呂悖逆，大臣相與共誅之。"
  },
  {
    "id": "s0316",
    "blockIndex": 24,
    "zh": "是時丞相為太尉，本兵柄，適會其成功。"
  },
  {
    "id": "s0317",
    "blockIndex": 24,
    "zh": "今丞相如有驕主色，陛下謙讓。"
  },
  {
    "id": "s0318",
    "blockIndex": 24,
    "zh": "臣主失禮，竊為陛下弗取也！"
  },
  {
    "id": "s0319",
    "blockIndex": 24,
    "zh": "」後朝，上益莊，丞相益畏。"
  },
  {
    "id": "s0320",
    "blockIndex": 24,
    "zh": "----4十二月，詔曰：「法者，治之正也。"
  },
  {
    "id": "s0321",
    "blockIndex": 24,
    "zh": "今犯法已論，而使無罪之父母、妻子、同產坐之，及為收帑，朕甚不取！"
  },
  {
    "id": "s0322",
    "blockIndex": 24,
    "zh": "其除收帑諸相坐律令。"
  },
  {
    "id": "s0323",
    "blockIndex": 24,
    "zh": "」----5春，正月，有司請蚤建太子。"
  },
  {
    "id": "s0324",
    "blockIndex": 24,
    "zh": "上曰；"
  },
  {
    "id": "s0325",
    "blockIndex": 24,
    "zh": "「朕既不德，縱不能博求天下賢聖有德之人而禪天下焉，而曰豫建太子，是重吾不德也。"
  },
  {
    "id": "s0326",
    "blockIndex": 24,
    "zh": "其安之！"
  },
  {
    "id": "s0327",
    "blockIndex": 24,
    "zh": "」有司曰：「豫建太子，所以重宗廟、社稷，不忘天下也。"
  },
  {
    "id": "s0328",
    "blockIndex": 24,
    "zh": "」上曰：「楚王，季父也；"
  },
  {
    "id": "s0329",
    "blockIndex": 24,
    "zh": "吳王，兄也；"
  },
  {
    "id": "s0330",
    "blockIndex": 24,
    "zh": "淮南王，弟也，豈不豫哉？"
  },
  {
    "id": "s0331",
    "blockIndex": 24,
    "zh": "今不選舉焉，而曰必子，人其以朕為忘賢有德者而專於子，非所以憂天下也！"
  },
  {
    "id": "s0332",
    "blockIndex": 24,
    "zh": "」有司固請曰：「古者殷、周有國，治安皆千餘歲，用此道也。"
  },
  {
    "id": "s0333",
    "blockIndex": 24,
    "zh": "立嗣必子，所從來遠矣。"
  },
  {
    "id": "s0334",
    "blockIndex": 24,
    "zh": "高帝平天下為太祖，子孫繼嗣世世不絕，今釋宜建而更選於諸侯及宗室，非高帝之志也。"
  },
  {
    "id": "s0335",
    "blockIndex": 24,
    "zh": "更議不宜。"
  },
  {
    "id": "s0336",
    "blockIndex": 24,
    "zh": "子啟最長，純厚慈仁，請建以為太子。"
  },
  {
    "id": "s0337",
    "blockIndex": 24,
    "zh": "」上乃許之。"
  },
  {
    "id": "s0338",
    "blockIndex": 24,
    "zh": "----6三月，立太子母竇氏為皇后。"
  },
  {
    "id": "s0339",
    "blockIndex": 24,
    "zh": "皇后，清河觀津人。"
  },
  {
    "id": "s0340",
    "blockIndex": 24,
    "zh": "有弟廣國，字少君，幼為人所略賣，傳十餘家，聞-{竇后}-立，乃上書自陳。"
  },
  {
    "id": "s0341",
    "blockIndex": 24,
    "zh": "召見，驗問，得實，乃厚賜田宅、金錢，與兄長君家於長安。"
  },
  {
    "id": "s0342",
    "blockIndex": 24,
    "zh": "絳侯、灌將軍等曰：「吾屬不死，命乃且縣此兩人。"
  },
  {
    "id": "s0343",
    "blockIndex": 24,
    "zh": "兩人所出微，不可不為擇師傅、賓客；"
  },
  {
    "id": "s0344",
    "blockIndex": 24,
    "zh": "又復效呂氏，大事也！"
  },
  {
    "id": "s0345",
    "blockIndex": 24,
    "zh": "」於是乃選士之有節行者與居。"
  },
  {
    "id": "s0346",
    "blockIndex": 24,
    "zh": "竇長君、少君由此為退讓君子，不敢以尊貴驕人。"
  },
  {
    "id": "s0347",
    "blockIndex": 24,
    "zh": "----7詔振貸鰥、寡、孤、獨、窮困之人。"
  },
  {
    "id": "s0348",
    "blockIndex": 24,
    "zh": "又令：「八十已上，月賜米、肉、酒；"
  },
  {
    "id": "s0349",
    "blockIndex": 24,
    "zh": "九十已上，加賜帛、絮。"
  },
  {
    "id": "s0350",
    "blockIndex": 24,
    "zh": "賜物當稟鬻米者，長吏閱視，丞若尉致；"
  },
  {
    "id": "s0351",
    "blockIndex": 24,
    "zh": "不滿九十，嗇夫、令史致；"
  },
  {
    "id": "s0352",
    "blockIndex": 24,
    "zh": "二千石遣都吏循行，不稱者督之。"
  },
  {
    "id": "s0353",
    "blockIndex": 24,
    "zh": "」----8楚元王交薨。"
  },
  {
    "id": "s0354",
    "blockIndex": 24,
    "zh": "----9夏，四月，齊、楚地震，二十九山同日崩，大水潰出。"
  },
  {
    "id": "s0355",
    "blockIndex": 24,
    "zh": "----10時有獻千里馬者。"
  },
  {
    "id": "s0356",
    "blockIndex": 24,
    "zh": "帝曰：「鸞旗在前，屬車在後，吉行日五十里，師行三十里。"
  },
  {
    "id": "s0357",
    "blockIndex": 24,
    "zh": "朕乘千里馬，獨先安之？"
  },
  {
    "id": "s0358",
    "blockIndex": 24,
    "zh": "」於是還其馬，與道里費，而下詔曰：「朕不受獻也。"
  },
  {
    "id": "s0359",
    "blockIndex": 24,
    "zh": "其令四方毋求來獻。"
  },
  {
    "id": "s0360",
    "blockIndex": 24,
    "zh": "」----11帝既施惠天下，諸侯、四夷遠近歡洽。"
  },
  {
    "id": "s0361",
    "blockIndex": 24,
    "zh": "乃修代來功，封宋昌為壯武侯。"
  },
  {
    "id": "s0362",
    "blockIndex": 24,
    "zh": "----12帝益明習國家事。"
  },
  {
    "id": "s0363",
    "blockIndex": 24,
    "zh": "朝而問右丞相勃曰：「天下一歲決獄幾何？"
  },
  {
    "id": "s0364",
    "blockIndex": 24,
    "zh": "」勃謝不知。"
  },
  {
    "id": "s0365",
    "blockIndex": 24,
    "zh": "又問：「一歲錢穀出入幾何？"
  },
  {
    "id": "s0366",
    "blockIndex": 24,
    "zh": "」勃又謝不知，惶愧，汗出沾背。"
  },
  {
    "id": "s0367",
    "blockIndex": 24,
    "zh": "上問左丞相平。"
  },
  {
    "id": "s0368",
    "blockIndex": 24,
    "zh": "平曰：「有主者。"
  },
  {
    "id": "s0369",
    "blockIndex": 24,
    "zh": "」上曰：「主者謂誰？"
  },
  {
    "id": "s0370",
    "blockIndex": 24,
    "zh": "」曰：「陛下即問決獄，責廷尉；"
  },
  {
    "id": "s0371",
    "blockIndex": 24,
    "zh": "問錢穀，責治粟內史。"
  },
  {
    "id": "s0372",
    "blockIndex": 24,
    "zh": "」上曰：「苟各有主者，而君所主者何事也？"
  },
  {
    "id": "s0373",
    "blockIndex": 24,
    "zh": "」平謝曰：「陛下不知其駑下，使待罪宰相。"
  },
  {
    "id": "s0374",
    "blockIndex": 24,
    "zh": "宰相者，上佐天子，理陰陽，順四時；"
  },
  {
    "id": "s0375",
    "blockIndex": 24,
    "zh": "下遂萬物之宜；"
  },
  {
    "id": "s0376",
    "blockIndex": 24,
    "zh": "外鎮撫四夷諸侯；"
  },
  {
    "id": "s0377",
    "blockIndex": 24,
    "zh": "內親附百姓，使卿大夫各得任其職焉。"
  },
  {
    "id": "s0378",
    "blockIndex": 24,
    "zh": "」帝乃稱善。"
  },
  {
    "id": "s0379",
    "blockIndex": 24,
    "zh": "右丞相大慚，出而讓陳平曰：「君獨不素教我對！"
  },
  {
    "id": "s0380",
    "blockIndex": 24,
    "zh": "」陳平笑曰：「君居其位，不知其任邪？"
  },
  {
    "id": "s0381",
    "blockIndex": 24,
    "zh": "且陛下即問長安中盜賊數，君欲強對邪？"
  },
  {
    "id": "s0382",
    "blockIndex": 24,
    "zh": "」於是絳侯自知其能不如平遠矣。"
  },
  {
    "id": "s0383",
    "blockIndex": 24,
    "zh": "居頃之，人或說勃曰：「君既誅諸呂，立代王，威震天下。"
  },
  {
    "id": "s0384",
    "blockIndex": 24,
    "zh": "而君受厚賞，處尊位，久之，即禍及身矣。"
  },
  {
    "id": "s0385",
    "blockIndex": 24,
    "zh": "」勃亦自危，乃謝病，請歸相印，上許之。"
  },
  {
    "id": "s0386",
    "blockIndex": 24,
    "zh": "秋，八月，辛未，右丞相勃免，左丞相平專為丞相。"
  },
  {
    "id": "s0387",
    "blockIndex": 24,
    "zh": "----13初，隆慮侯灶擊南越，會暑濕，士卒大疫，兵不能隃領。"
  },
  {
    "id": "s0388",
    "blockIndex": 24,
    "zh": "歲餘，-{高后}-崩，即罷兵。"
  },
  {
    "id": "s0389",
    "blockIndex": 24,
    "zh": "趙佗因此以兵威財物賂遺閩越、西甌、駱，役屬焉。"
  },
  {
    "id": "s0390",
    "blockIndex": 24,
    "zh": "東西萬餘里，乘黃屋左纛，稱制與中國侔。"
  },
  {
    "id": "s0391",
    "blockIndex": 25,
    "zh": "帝乃為佗親塚在真定者置守邑，歲時奉祀；"
  },
  {
    "id": "s0392",
    "blockIndex": 25,
    "zh": "召其昆弟，尊官、厚賜寵之。"
  },
  {
    "id": "s0393",
    "blockIndex": 25,
    "zh": "復使陸賈使南越，賜佗書曰：「朕，高皇帝側室之子也，棄外，奉北籓於代。"
  },
  {
    "id": "s0394",
    "blockIndex": 25,
    "zh": "道里遼遠，壅蔽樸愚，未嘗致書。"
  },
  {
    "id": "s0395",
    "blockIndex": 25,
    "zh": "高皇帝棄群臣，孝惠皇帝即世；"
  },
  {
    "id": "s0396",
    "blockIndex": 25,
    "zh": "-{高后}-自臨事，不幸有疾，諸呂為變，賴功臣之力，誅之已畢，朕以王、侯、吏不釋之故，不得不立。"
  },
  {
    "id": "s0397",
    "blockIndex": 25,
    "zh": "今即位。"
  },
  {
    "id": "s0398",
    "blockIndex": 25,
    "zh": "乃者聞王遺將軍隆慮侯書，求親昆弟，請罷長沙兩將軍。"
  },
  {
    "id": "s0399",
    "blockIndex": 25,
    "zh": "朕以王書罷將軍博陽侯；"
  },
  {
    "id": "s0400",
    "blockIndex": 25,
    "zh": "親昆弟在真定者，已遣人存問，修治先人塚。"
  },
  {
    "id": "s0401",
    "blockIndex": 25,
    "zh": "前日聞王發兵於邊，為寇災不止。"
  },
  {
    "id": "s0402",
    "blockIndex": 25,
    "zh": "當其時，長沙苦之，南郡尤甚。"
  },
  {
    "id": "s0403",
    "blockIndex": 25,
    "zh": "雖王之國，庸獨利乎！"
  },
  {
    "id": "s0404",
    "blockIndex": 25,
    "zh": "必多殺士卒，傷良將吏，寡人之妻，孤人之子，獨人父母，得一亡十，朕不忍為也。"
  },
  {
    "id": "s0405",
    "blockIndex": 25,
    "zh": "朕欲定地犬牙相入者，以問吏，吏曰：『高皇帝所以介長沙土也。"
  },
  {
    "id": "s0406",
    "blockIndex": 25,
    "zh": "』朕不得擅變焉。"
  },
  {
    "id": "s0407",
    "blockIndex": 25,
    "zh": "今得王之地，不足以為大；"
  },
  {
    "id": "s0408",
    "blockIndex": 25,
    "zh": "得王之財，不足以為富。"
  },
  {
    "id": "s0409",
    "blockIndex": 25,
    "zh": "服領以南，王自治之。"
  },
  {
    "id": "s0410",
    "blockIndex": 25,
    "zh": "雖然，王之號為帝。"
  },
  {
    "id": "s0411",
    "blockIndex": 25,
    "zh": "兩帝並立，亡一乘之使以通其道，是爭也；"
  },
  {
    "id": "s0412",
    "blockIndex": 25,
    "zh": "爭而不讓，仁者不為也。"
  },
  {
    "id": "s0413",
    "blockIndex": 25,
    "zh": "願與王分棄前惡，終今以來，通使如故。"
  },
  {
    "id": "s0415",
    "blockIndex": 26,
    "zh": "賈至南越，南越王恐，頓首謝罪，願奉明詔，長為籓臣，奉貢職。"
  },
  {
    "id": "s0416",
    "blockIndex": 26,
    "zh": "於是下令國中曰：「吾聞兩雄不俱立，兩賢不並世。"
  },
  {
    "id": "s0417",
    "blockIndex": 26,
    "zh": "漢皇帝，賢天子。"
  },
  {
    "id": "s0418",
    "blockIndex": 26,
    "zh": "自今以來，去帝制、黃屋、左纛。"
  },
  {
    "id": "s0419",
    "blockIndex": 26,
    "zh": "」因為書，稱：「蠻夷大長、老夫臣佗昧死再拜上書皇帝陛下：老夫，故越吏也，高皇帝幸賜臣佗璽，以為南越王。"
  },
  {
    "id": "s0420",
    "blockIndex": 26,
    "zh": "孝惠皇帝即位，義不忍絕，所以賜老夫者甚厚。"
  },
  {
    "id": "s0421",
    "blockIndex": 26,
    "zh": "-{高后}-用事，別異蠻夷，出令曰：『毋與蠻夷越金、鐵、田器、馬、牛、羊。"
  },
  {
    "id": "s0422",
    "blockIndex": 26,
    "zh": "即予，予牡，毋予牝。"
  },
  {
    "id": "s0423",
    "blockIndex": 26,
    "zh": "』老夫處僻，馬、牛、羊齒已長。"
  },
  {
    "id": "s0424",
    "blockIndex": 26,
    "zh": "自以祭祀不修，有死罪，使內史籓、中尉高、御史平凡三輩上書謝過，皆不反。"
  },
  {
    "id": "s0425",
    "blockIndex": 26,
    "zh": "又風聞老夫父母墳墓已壞削，兄弟宗族已誅論。"
  },
  {
    "id": "s0426",
    "blockIndex": 26,
    "zh": "吏相與議曰：『今內不得振於漢，外無以自高異。"
  },
  {
    "id": "s0427",
    "blockIndex": 26,
    "zh": "』故更號為帝，自帝其國，非敢有害於天下。"
  },
  {
    "id": "s0428",
    "blockIndex": 26,
    "zh": "高皇后聞之，大怒，削去南越之籍，使使不通。"
  },
  {
    "id": "s0429",
    "blockIndex": 26,
    "zh": "老夫竊疑長沙王讒臣，故發兵以伐其邊。"
  },
  {
    "id": "s0430",
    "blockIndex": 26,
    "zh": "老夫處越四十九年，於今抱孫焉。"
  },
  {
    "id": "s0431",
    "blockIndex": 26,
    "zh": "然夙興夜寐，寢不安席，食不甘味，目不視靡曼之色，耳不聽鐘鼓之音者，以不得事漢也。"
  },
  {
    "id": "s0432",
    "blockIndex": 26,
    "zh": "今陛下幸哀憐，復故號，通使漢如故；"
  },
  {
    "id": "s0433",
    "blockIndex": 26,
    "zh": "老夫死，骨不腐。"
  },
  {
    "id": "s0434",
    "blockIndex": 26,
    "zh": "改號，不敢為帝矣！"
  },
  {
    "id": "s0435",
    "blockIndex": 26,
    "zh": "」----14齊哀王襄薨。"
  },
  {
    "id": "s0436",
    "blockIndex": 26,
    "zh": "----15上聞河南守吳公治平為天下第一，召以為廷尉。"
  },
  {
    "id": "s0437",
    "blockIndex": 26,
    "zh": "吳公薦洛陽人賈誼，帝召以為博士。"
  },
  {
    "id": "s0438",
    "blockIndex": 26,
    "zh": "是時賈生年二十餘。"
  },
  {
    "id": "s0439",
    "blockIndex": 26,
    "zh": "帝愛其辭博，一歲中，超遷至太中大夫。"
  },
  {
    "id": "s0440",
    "blockIndex": 26,
    "zh": "賈生請改正朔，易服色，定官名，興禮樂，以立漢制，更秦法。"
  },
  {
    "id": "s0441",
    "blockIndex": 26,
    "zh": "帝謙讓未遑也。"
  },
  {
    "id": "s0442",
    "blockIndex": 26,
    "zh": "----1冬，十月，曲逆獻侯陳平薨。"
  },
  {
    "id": "s0443",
    "blockIndex": 26,
    "zh": "----2詔列侯各之國，為吏及詔所止者，遣太子。"
  },
  {
    "id": "s0444",
    "blockIndex": 26,
    "zh": "----3十一月，乙亥，周勃復為丞相。"
  },
  {
    "id": "s0445",
    "blockIndex": 26,
    "zh": "----4癸卯晦，日有食之。"
  },
  {
    "id": "s0446",
    "blockIndex": 26,
    "zh": "詔：「群臣悉思朕之過失及知見之所不及，匄以啟告朕。"
  },
  {
    "id": "s0447",
    "blockIndex": 26,
    "zh": "及舉賢良、方正、能直言極諫者，以匡朕之不逮。"
  },
  {
    "id": "s0448",
    "blockIndex": 26,
    "zh": "」因各敕以職任，務省繇費以便民，罷衛將軍。"
  },
  {
    "id": "s0449",
    "blockIndex": 26,
    "zh": "太僕見馬遺財足，餘皆以給傳置。"
  },
  {
    "id": "s0450",
    "blockIndex": 27,
    "zh": "穎陰侯騎賈山上書言治亂之道曰："
  },
  {
    "id": "s0451",
    "blockIndex": 28,
    "zh": ":「臣聞雷霆之所擊，無不摧折者；"
  },
  {
    "id": "s0452",
    "blockIndex": 28,
    "zh": "萬鈞之所壓，無不糜滅者。"
  },
  {
    "id": "s0453",
    "blockIndex": 28,
    "zh": "今人主之威，非特雷霆也；"
  },
  {
    "id": "s0454",
    "blockIndex": 28,
    "zh": "執重，非特萬鈞也。"
  },
  {
    "id": "s0455",
    "blockIndex": 28,
    "zh": "開道而求諫，和顏色而受之，用其言而顯其身，士猶恐懼而不敢自盡；"
  },
  {
    "id": "s0456",
    "blockIndex": 28,
    "zh": "又況於縱欲恣暴、惡聞其過乎！"
  },
  {
    "id": "s0457",
    "blockIndex": 28,
    "zh": "震之以威，壓之以重，雖有堯、舜之智，孟賁之勇，豈有不摧折者哉！"
  },
  {
    "id": "s0458",
    "blockIndex": 28,
    "zh": "如此，則人主不得聞其過，社稷危矣。"
  },
  {
    "id": "s0459",
    "blockIndex": 29,
    "zh": ":昔者周蓋千八百國，以九州之民養千八百國之君，君有餘財，民有餘力，而頌聲作。"
  },
  {
    "id": "s0460",
    "blockIndex": 29,
    "zh": "秦皇帝以千八百國之民自養，力罷不能勝其役，財盡不能勝其求。"
  },
  {
    "id": "s0461",
    "blockIndex": 29,
    "zh": "一君之身耳，所自養者馳騁弋獵之娛，天下弗能供也。"
  },
  {
    "id": "s0462",
    "blockIndex": 29,
    "zh": "秦皇帝計其功德，度其後嗣世世無窮；"
  },
  {
    "id": "s0463",
    "blockIndex": 29,
    "zh": "然身死才數月耳，天下四面而攻之，宗廟滅絕矣。"
  },
  {
    "id": "s0464",
    "blockIndex": 29,
    "zh": "秦皇帝居滅絕之中而不自知者，何也？"
  },
  {
    "id": "s0465",
    "blockIndex": 29,
    "zh": "天下莫敢告也。"
  },
  {
    "id": "s0466",
    "blockIndex": 29,
    "zh": "其所以莫敢告者，何也？"
  },
  {
    "id": "s0467",
    "blockIndex": 29,
    "zh": "亡養老之義，亡輔弼之臣，退誹謗之人，殺直諫之士。"
  },
  {
    "id": "s0468",
    "blockIndex": 29,
    "zh": "是以道諛、媮合苟容，比其德則賢於堯、舜，課其功則賢於湯、武；"
  },
  {
    "id": "s0469",
    "blockIndex": 29,
    "zh": "天下已潰而莫之告也。"
  },
  {
    "id": "s0470",
    "blockIndex": 30,
    "zh": ":今陛下使天下舉賢良方正之士，天下皆欣欣焉曰：『將興堯舜之道、三王之功矣。"
  },
  {
    "id": "s0471",
    "blockIndex": 30,
    "zh": "』天下之士，莫不精白以承休德。"
  },
  {
    "id": "s0472",
    "blockIndex": 30,
    "zh": "今方正之士皆在朝廷矣；"
  },
  {
    "id": "s0473",
    "blockIndex": 30,
    "zh": "又選其賢者，使為常侍、諸吏，與之馳驅射獵，一日再三出。"
  },
  {
    "id": "s0474",
    "blockIndex": 30,
    "zh": "臣恐朝廷之解馳，百官之墮於事也。"
  },
  {
    "id": "s0475",
    "blockIndex": 30,
    "zh": "陛下即位，親自勉以厚天下，節用愛民，平獄緩刑；"
  },
  {
    "id": "s0476",
    "blockIndex": 30,
    "zh": "天下莫不說喜。"
  },
  {
    "id": "s0477",
    "blockIndex": 30,
    "zh": "臣聞山東吏布詔令，民雖老羸癃疾，扶杖而往聽之，願少須臾毋死，思見德化之成也。"
  },
  {
    "id": "s0478",
    "blockIndex": 30,
    "zh": "今功業方就，名聞方昭，四方鄉風而從；"
  },
  {
    "id": "s0479",
    "blockIndex": 30,
    "zh": "豪俊之臣，方正之士，直與之日日獵射，擊兔、伐狐，以傷大業，絕天下之望，臣竊悼之。"
  },
  {
    "id": "s0480",
    "blockIndex": 30,
    "zh": "古者大臣不得與宴游，使皆務其方而高其節，則群臣莫敢不正身修行，盡心以稱大體。"
  },
  {
    "id": "s0481",
    "blockIndex": 30,
    "zh": "夫士，修之於家而壞之於天子之廷，臣竊愍之。"
  },
  {
    "id": "s0482",
    "blockIndex": 30,
    "zh": "陛下與眾臣宴游，與大臣、方正朝廷論議，游不失樂，朝不失禮，議不失計，軌事之大者也。"
  },
  {
    "id": "s0484",
    "blockIndex": 31,
    "zh": "上嘉納其言。"
  },
  {
    "id": "s0485",
    "blockIndex": 32,
    "zh": "上每朝，郎、從官上書疏，未嘗不止輦受其言。"
  },
  {
    "id": "s0486",
    "blockIndex": 32,
    "zh": "言不可用置之，言可用采之，未嘗不稱善。"
  },
  {
    "id": "s0487",
    "blockIndex": 33,
    "zh": "帝從霸陵上欲西馳下峻阪。"
  },
  {
    "id": "s0488",
    "blockIndex": 33,
    "zh": "中郎將袁盎騎，並車攬轡。"
  },
  {
    "id": "s0489",
    "blockIndex": 33,
    "zh": "上曰：「將軍怯邪？"
  },
  {
    "id": "s0490",
    "blockIndex": 33,
    "zh": "」盎曰：「臣聞『千金之子，坐不垂堂』。"
  },
  {
    "id": "s0491",
    "blockIndex": 33,
    "zh": "聖主不乘危，不徼幸。"
  },
  {
    "id": "s0492",
    "blockIndex": 33,
    "zh": "今陛下騁六飛馳下峻山，有如馬驚車敗，陛下縱自輕，奈高廟、太后何！"
  },
  {
    "id": "s0493",
    "blockIndex": 33,
    "zh": "」上乃止。"
  },
  {
    "id": "s0494",
    "blockIndex": 34,
    "zh": "上所幸慎夫人，在禁中常與皇后同席坐。"
  },
  {
    "id": "s0495",
    "blockIndex": 34,
    "zh": "及坐郎置，袁盎引卻慎夫人坐。"
  },
  {
    "id": "s0496",
    "blockIndex": 34,
    "zh": "慎夫人怒，不肯坐；"
  },
  {
    "id": "s0497",
    "blockIndex": 34,
    "zh": "上亦怒，起，入禁中。"
  },
  {
    "id": "s0498",
    "blockIndex": 34,
    "zh": "盎因前說曰：「臣聞『尊卑有序，則上下和』。"
  },
  {
    "id": "s0499",
    "blockIndex": 34,
    "zh": "今陛下既已立-{后}-，慎夫人乃妾。"
  },
  {
    "id": "s0500",
    "blockIndex": 34,
    "zh": "妾、主豈可與同坐哉！"
  },
  {
    "id": "s0501",
    "blockIndex": 34,
    "zh": "且陛下幸之，即厚賜之。"
  },
  {
    "id": "s0502",
    "blockIndex": 34,
    "zh": "陛下所以為慎夫人，適所以禍之也。"
  },
  {
    "id": "s0503",
    "blockIndex": 34,
    "zh": "陛下獨不見『人彘』乎！"
  },
  {
    "id": "s0504",
    "blockIndex": 34,
    "zh": "」於是上乃說，召語慎夫人，慎夫人賜盎金五十斤。"
  },
  {
    "id": "s0505",
    "blockIndex": 35,
    "zh": "賈誼說上曰："
  },
  {
    "id": "s0506",
    "blockIndex": 36,
    "zh": ":「《管子》曰：『倉廩實而知禮節，衣食足而知榮辱。"
  },
  {
    "id": "s0507",
    "blockIndex": 36,
    "zh": "』民不足而可治者，自古及今，未之嘗聞。"
  },
  {
    "id": "s0508",
    "blockIndex": 36,
    "zh": "古之人曰：『一夫不耕，或受之饑；"
  },
  {
    "id": "s0509",
    "blockIndex": 36,
    "zh": "一女不織，或受之寒。"
  },
  {
    "id": "s0510",
    "blockIndex": 36,
    "zh": "』生之有時而用之亡度，則物力必屈。"
  },
  {
    "id": "s0511",
    "blockIndex": 36,
    "zh": "古之治天下，至纖至悉，故其畜積足恃。"
  },
  {
    "id": "s0512",
    "blockIndex": 36,
    "zh": "今背本而趨末者甚眾，是天下之大殘也！"
  },
  {
    "id": "s0513",
    "blockIndex": 36,
    "zh": "淫侈之俗，日日以長，是天下之大賊也！"
  },
  {
    "id": "s0514",
    "blockIndex": 36,
    "zh": "殘、賊公行，莫之或止；"
  },
  {
    "id": "s0515",
    "blockIndex": 36,
    "zh": "大命將泛，莫之振救。"
  },
  {
    "id": "s0516",
    "blockIndex": 36,
    "zh": "生之者甚少而靡之者甚多，天下財產何得不厥。"
  },
  {
    "id": "s0517",
    "blockIndex": 37,
    "zh": ":漢之為漢，幾四十年矣，公私之積，猶可哀痛。"
  },
  {
    "id": "s0518",
    "blockIndex": 37,
    "zh": "失時不雨，民且狼顧；"
  },
  {
    "id": "s0519",
    "blockIndex": 37,
    "zh": "歲惡不入，請賣爵子。"
  },
  {
    "id": "s0520",
    "blockIndex": 37,
    "zh": "既聞耳矣，安有為天下阽危者若是而上不驚者！"
  },
  {
    "id": "s0521",
    "blockIndex": 38,
    "zh": ":世之有饑、穰，天之行也；"
  },
  {
    "id": "s0522",
    "blockIndex": 38,
    "zh": "禹、湯被之矣。"
  },
  {
    "id": "s0523",
    "blockIndex": 38,
    "zh": "即不幸有方二三千里之旱，國胡以相恤？"
  },
  {
    "id": "s0524",
    "blockIndex": 38,
    "zh": "卒然邊境有急，數十百萬之眾，國胡以饋之？"
  },
  {
    "id": "s0525",
    "blockIndex": 38,
    "zh": "兵、旱相乘，天下大屈，有勇力者聚徒而衡擊，罷夫、羸老，易子上咬其骨。"
  },
  {
    "id": "s0526",
    "blockIndex": 38,
    "zh": "政治未畢通也，遠方之能僭擬者並舉而爭起矣；"
  },
  {
    "id": "s0527",
    "blockIndex": 38,
    "zh": "乃駭而圖之，豈將有及乎！"
  },
  {
    "id": "s0528",
    "blockIndex": 38,
    "zh": "夫積貯者，天下之大命也。"
  },
  {
    "id": "s0529",
    "blockIndex": 38,
    "zh": "苟粟多而財有餘，何為而不成！"
  },
  {
    "id": "s0530",
    "blockIndex": 38,
    "zh": "以攻則取，以守則固，以戰則勝，懷敵附遠，何招而不至！"
  },
  {
    "id": "s0531",
    "blockIndex": 39,
    "zh": ":今驅民而歸之農，皆著於本。"
  },
  {
    "id": "s0532",
    "blockIndex": 39,
    "zh": "使天下各食其力，末技、游食之民轉而緣南晦則畜積足而人樂其所矣。"
  },
  {
    "id": "s0533",
    "blockIndex": 39,
    "zh": "可以為富安天下，而直為此廩廩也，竊為陛下惜之！"
  },
  {
    "id": "s0535",
    "blockIndex": 40,
    "zh": "上感誼言，春，正月，丁亥，詔開藉田，上親耕以率天下之民。"
  },
  {
    "id": "s0536",
    "blockIndex": 40,
    "zh": "----5三月，有司請立皇子為諸侯王。"
  },
  {
    "id": "s0537",
    "blockIndex": 40,
    "zh": "詔先立趙幽王少子辟強為河間王，朱虛侯章為城陽王，東牟侯興居為濟北王；"
  },
  {
    "id": "s0538",
    "blockIndex": 40,
    "zh": "然後立皇子武為代王，參為太原王，揖為梁王。"
  },
  {
    "id": "s0539",
    "blockIndex": 40,
    "zh": "----6五月，詔曰：「古之治天下，朝有進善之旌，誹謗之木，所以通治道而來諫者也。"
  },
  {
    "id": "s0540",
    "blockIndex": 40,
    "zh": "今法有誹謗、妖言之罪，是使眾臣不敢盡情而上無由聞過失也，將何以來遠方之賢良！"
  },
  {
    "id": "s0541",
    "blockIndex": 40,
    "zh": "其除之！"
  },
  {
    "id": "s0542",
    "blockIndex": 40,
    "zh": "」----7九月，詔曰：「農，天下之大本也，民所恃以生也；"
  },
  {
    "id": "s0543",
    "blockIndex": 40,
    "zh": "而民或不務本而事末，故生不遂。"
  },
  {
    "id": "s0544",
    "blockIndex": 40,
    "zh": "朕憂其然，故今茲親率群臣農以勸之；"
  },
  {
    "id": "s0545",
    "blockIndex": 40,
    "zh": "其賜天下民今年田租之半。"
  },
  {
    "id": "s0546",
    "blockIndex": 40,
    "zh": "」----8燕敬王澤薨。"
  },
  {
    "id": "s0547",
    "blockIndex": 41,
    "zh": "category:資治通鑑"
  }
]
