    },
    {
      "id": "s0746",
      "originalId": "s0746",
      "blockIndex": 98,
      "chinese": "惠帝之後，冀州淪沒於石勒。",
      "literal": "",
      "idiomatic": ""
    },
    {
      "id": "s0747",
      "originalId": "s0747",
      "blockIndex": 98,
      "chinese": "勒以太興二年僭號於襄國，稱趙。",
      "literal": "",
      "idiomatic": ""
    },
    {
      "id": "s0748",
      "originalId": "s0748",
      "blockIndex": 98,
      "chinese": "後爲慕容雋所滅，慕容氏又爲苻堅所滅。",
      "literal": "",
      "idiomatic": ""
    },
    {
      "id": "s0749",
      "originalId": "s0749",
      "blockIndex": 98,
      "chinese": "孝武太元八年，堅敗，其地入慕容垂。",
      "literal": "",
      "idiomatic": ""
    },
    {
      "id": "s0750",
      "originalId": "s0750",
      "blockIndex": 98,
      "chinese": "垂僭號於中山，是爲後燕。",
      "literal": "",
      "idiomatic": ""
    },
    {
      "id": "s0751",
      "originalId": "s0751",
      "blockIndex": 98,
      "chinese": "後燕卒滅於魏。",
      "literal": "",
      "idiomatic": ""
    },
    {
      "id": "s0752",
      "originalId": "s0752",
      "blockIndex": 99,
      "chinese": "范陽國",
      "literal": "",
      "idiomatic": ""
    },
    {
      "id": "s0753",
      "originalId": "s0753",
      "blockIndex": 99,
      "chinese": "〈漢置涿郡。",
      "literal": "",
      "idiomatic": ""
    },
    {
      "id": "s0754",
      "originalId": "s0754",
      "blockIndex": 99,
      "chinese": "魏文更名范陽郡。",
      "literal": "",
      "idiomatic": ""
    },
    {
      "id": "s0755",
      "originalId": "s0755",
      "blockIndex": 99,
      "chinese": "武帝置國，封宣帝弟子綏爲王。",
      "literal": "",
      "idiomatic": ""
    },
    {
      "id": "s0756",
      "originalId": "s0756",
      "blockIndex": 99,
