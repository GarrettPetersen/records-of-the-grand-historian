      "literal": "",
      "idiomatic": ""
    },
    {
      "id": "s0790",
      "originalId": "s0790",
      "blockIndex": 111,
      "chinese": "統縣三，戶二千八百。〉",
      "literal": "",
      "idiomatic": ""
    },
    {
      "id": "s0791",
      "originalId": "s0791",
      "blockIndex": 112,
      "chinese": "陽樂 肥如 海陽",
      "literal": "",
      "idiomatic": ""
    },
    {
      "id": "s0792",
      "originalId": "s0792",
      "blockIndex": 113,
      "chinese": "惠帝之後，幽州沒於石勒。",
      "literal": "",
      "idiomatic": ""
    },
    {
      "id": "s0793",
      "originalId": "s0793",
      "blockIndex": 113,
      "chinese": "及穆帝永和五年，慕容雋僭號於薊，是爲前燕。",
      "literal": "",
      "idiomatic": ""
    },
    {
      "id": "s0794",
      "originalId": "s0794",
      "blockIndex": 113,
      "chinese": "七年，雋移都於鄴。",
      "literal": "",
      "idiomatic": ""
    },
    {
      "id": "s0795",
      "originalId": "s0795",
      "blockIndex": 113,
      "chinese": "雋死，子暐爲苻堅所滅。",
      "literal": "",
      "idiomatic": ""
    },
    {
      "id": "s0796",
      "originalId": "s0796",
      "blockIndex": 113,
      "chinese": "堅敗，地復入慕容垂，是爲後燕。",
      "literal": "",
      "idiomatic": ""
    },
    {
      "id": "s0797",
      "originalId": "s0797",
      "blockIndex": 113,
      "chinese": "垂死，寶遷于和龍。",
      "literal": "",
      "idiomatic": ""
    },
    {
      "id": "s0798",
      "originalId": "s0798",
      "blockIndex": 114,
      "chinese": "案禹貢冀州之域，於周爲幽州界，漢屬右北平郡。",
      "literal": "",
      "idiomatic": ""
    },
    {
      "id": "s0799",
      "originalId": "s0799",
      "blockIndex": 114,
      "chinese": "後漢末，公孫度自號平州牧。",
      "literal": "",
      "idiomatic": ""
    },
    {
      "id": "s0800",
      "originalId": "s0800",
      "blockIndex": 114,
      "chinese": "及其子康、康子文懿並擅據遼東，東夷九種皆服事焉。",
      "literal": "",
      "idiomatic": ""
    }
  ]
}