      "literal": "",
      "idiomatic": ""
    },
    {
      "id": "s0742",
      "originalId": "s0742",
      "blockIndex": 97,
      "chinese": "真定 石邑 井陘 上曲陽",
      "literal": "",
      "idiomatic": ""
    },
    {
      "id": "s0743",
      "originalId": "s0743",
      "blockIndex": 97,
      "chinese": "〈山在縣西北，有阪號飛狐口。〉",
      "literal": "",
      "idiomatic": ""
    },
    {
      "id": "s0744",
      "originalId": "s0744",
      "blockIndex": 97,
      "chinese": "蒲吾 南行唐 靈壽 九門",
