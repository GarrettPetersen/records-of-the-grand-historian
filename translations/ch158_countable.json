[
  {
    "id": "s0001",
    "blockIndex": 0,
    "zh": "資治通鑑 第158卷"
  },
  {
    "id": "s0002",
    "blockIndex": 1,
    "zh": "【梁紀十四】　起著雍敦牂，盡閼逢困敦，凡七年。"
  },
  {
    "id": "s0003",
    "blockIndex": 2,
    "zh": "高祖武皇帝十四大同四年（"
  },
  {
    "id": "s0003",
    "blockIndex": 2,
    "zh": "戊午，公元五三八年）"
  },
  {
    "id": "s0005",
    "blockIndex": 3,
    "zh": "春，正月，辛酉朔，日有食之。"
  },
  {
    "id": "s0006",
    "blockIndex": 4,
    "zh": "東魏碭郡獲巨像，送鄴。"
  },
  {
    "id": "s0006",
    "blockIndex": 4,
    "zh": "丁卯，大赦，改元元象。"
  },
  {
    "id": "s0008",
    "blockIndex": 5,
    "zh": "二月，己亥，上耕藉田。"
  },
  {
    "id": "s0009",
    "blockIndex": 6,
    "zh": "東魏大都督善無賀拔仁攻魏南汾州，刺史韋子粲降之，丞相泰滅子粲之族。"
  },
  {
    "id": "s0009",
    "blockIndex": 6,
    "zh": "東魏大行台侯景等治兵於虎牢，將復河南諸州，魏梁回、韋孝寬、趙繼宗皆棄城西歸。"
  },
  {
    "id": "s0009",
    "blockIndex": 6,
    "zh": "侯景攻廣州，數旬，未拔，聞魏救兵將至，集諸將議之，行洛州事盧勇請進觀形勢。"
  },
  {
    "id": "s0009",
    "blockIndex": 6,
    "zh": "乃帥百騎至大隗山，遇魏師。"
  },
  {
    "id": "s0009",
    "blockIndex": 6,
    "zh": "日已暮，勇多置幡旗於樹顛；"
  },
  {
    "id": "s0009",
    "blockIndex": 6,
    "zh": "夜，分騎為十隊，鳴角直前，擒魏儀同三司程華，斬儀同三司王征蠻而還。"
  },
  {
    "id": "s0009",
    "blockIndex": 6,
    "zh": "廣州守將駱超遂以城降東魏，丞相歡以勇行廣州事。"
  },
  {
    "id": "s0009",
    "blockIndex": 6,
    "zh": "勇，辯之從弟也。"
  },
  {
    "id": "s0009",
    "blockIndex": 6,
    "zh": "於是南汾、穎、豫、廣四州復入東魏。"
  },
  {
    "id": "s0018",
    "blockIndex": 7,
    "zh": "初，柔然頭兵可汗始得返國，事魏盡禮。"
  },
  {
    "id": "s0018",
    "blockIndex": 7,
    "zh": "及永安以後，雄據北方，禮漸驕倨，雖信使不絕，不復稱臣。"
  },
  {
    "id": "s0018",
    "blockIndex": 7,
    "zh": "頭兵嘗至洛陽，心慕中國，乃置侍中、黃門等官；"
  },
  {
    "id": "s0018",
    "blockIndex": 7,
    "zh": "後得魏汝陽王典簽淳於覃，親寵任事，以為秘書監，使典文翰。"
  },
  {
    "id": "s0018",
    "blockIndex": 7,
    "zh": "及兩魏分裂，頭兵轉不遜，數為邊患。"
  },
  {
    "id": "s0018",
    "blockIndex": 7,
    "zh": "魏丞相泰以新都關中，方有事山東，欲結婚以撫之，以舍人元翌女為化政公主，妻頭兵弟塔寒。"
  },
  {
    "id": "s0018",
    "blockIndex": 7,
    "zh": "又言於魏主，請廢乙弗後，納頭兵之女。"
  },
  {
    "id": "s0018",
    "blockIndex": 7,
    "zh": "甲辰，以乙弗後為尼，使扶風王孚迎頭兵女為後。"
  },
  {
    "id": "s0018",
    "blockIndex": 7,
    "zh": "頭兵遂留東魏使者元整，不報其使。"
  },
  {
    "id": "s0027",
    "blockIndex": 8,
    "zh": "三月，辛酉，東魏丞相歡以沙苑之敗，請解大丞相，詔許之；"
  },
  {
    "id": "s0027",
    "blockIndex": 8,
    "zh": "頃之，復故。"
  },
  {
    "id": "s0029",
    "blockIndex": 9,
    "zh": "柔然送悼後於魏，車七百乘、馬萬匹、駝二千頭。"
  },
  {
    "id": "s0029",
    "blockIndex": 9,
    "zh": "至黑鹽池，遇魏所遣鹵簿儀衛。"
  },
  {
    "id": "s0029",
    "blockIndex": 9,
    "zh": "柔然營幕，戶席皆東向，扶風王孚請正南面，後曰：「我未見魏主，固柔然女也。"
  },
  {
    "id": "s0029",
    "blockIndex": 9,
    "zh": "魏仗南面，我自東向。"
  },
  {
    "id": "s0029",
    "blockIndex": 9,
    "zh": "」丙子，立皇后郁久閭氏。"
  },
  {
    "id": "s0029",
    "blockIndex": 9,
    "zh": "丁丑，大赦。"
  },
  {
    "id": "s0029",
    "blockIndex": 9,
    "zh": "以王盟為司徒。"
  },
  {
    "id": "s0029",
    "blockIndex": 9,
    "zh": "丞相泰朝於長安，還屯華州。"
  },
  {
    "id": "s0037",
    "blockIndex": 10,
    "zh": "夏，四月，庚寅，東魏高歡朝於鄴；"
  },
  {
    "id": "s0037",
    "blockIndex": 10,
    "zh": "壬辰，還晉陽。"
  },
  {
    "id": "s0039",
    "blockIndex": 11,
    "zh": "五月，甲戌，東魏遣兼散騎常侍鄭伯猷來聘。"
  },
  {
    "id": "s0040",
    "blockIndex": 12,
    "zh": "秋，七月，東魏荊州刺史王則寇淮南。"
  },
  {
    "id": "s0041",
    "blockIndex": 13,
    "zh": "癸亥，詔以東冶徒李胤之得如來捨利，大赦。"
  },
  {
    "id": "s0042",
    "blockIndex": 14,
    "zh": "東魏侯景、高敖曹等圍魏獨孤信於金墉，太師歡帥大軍繼之；"
  },
  {
    "id": "s0042",
    "blockIndex": 14,
    "zh": "景悉燒洛陽內外官寺民居，存者什二三。"
  },
  {
    "id": "s0042",
    "blockIndex": 14,
    "zh": "魏主將如洛陽拜園陵，會信等告急，遂與丞相泰俱東，命尚書左僕射周惠達輔太子欽守長安，開府儀同三司李弼、車騎大將軍達奚武帥千騎為前驅。"
  },
  {
    "id": "s0045",
    "blockIndex": 15,
    "zh": "八月，庚寅，丞相泰至谷城，侯景等欲整陳以待其至，儀同三司太安莫多婁貸文請帥所部擊其前鋒，景等固止之。"
  },
  {
    "id": "s0045",
    "blockIndex": 15,
    "zh": "貸文勇而專，不受命，與可朱渾道元以千騎前進。"
  },
  {
    "id": "s0045",
    "blockIndex": 15,
    "zh": "夜，遇李弼、達奚武於孝水。"
  },
  {
    "id": "s0045",
    "blockIndex": 15,
    "zh": "弼命軍士鼓噪，曳柴揚塵，貸文走，弼追斬之，道元單騎獲免，悉俘其眾送恆農。"
  },
  {
    "id": "s0049",
    "blockIndex": 16,
    "zh": "泰進軍瀍東，侯景等夜解圍去。"
  },
  {
    "id": "s0049",
    "blockIndex": 16,
    "zh": "辛卯，泰帥輕騎追景至河上，景為陳，北據河橋，南屬邙山，與泰合戰。"
  },
  {
    "id": "s0049",
    "blockIndex": 16,
    "zh": "泰馬中流矢驚逸，遂失所之。"
  },
  {
    "id": "s0049",
    "blockIndex": 16,
    "zh": "泰墜地，東魏兵追及之，左右皆散，都督李穆下馬，以策抶泰背罵曰：「籠東軍士！"
  },
  {
    "id": "s0049",
    "blockIndex": 16,
    "zh": "爾曹主何在，而獨留此？"
  },
  {
    "id": "s0049",
    "blockIndex": 16,
    "zh": "」追者不疑其貴人，捨之而過。"
  },
  {
    "id": "s0049",
    "blockIndex": 16,
    "zh": "穆以馬授泰，與之俱逸。"
  },
  {
    "id": "s0056",
    "blockIndex": 17,
    "zh": "魏兵復振，擊東魏兵，大破之，東魏兵北走。"
  },
  {
    "id": "s0056",
    "blockIndex": 17,
    "zh": "京兆忠武公高敖曹，意輕泰，建旗蓋以陵陳，魏人盡銳攻之，一軍皆沒，敖曹單騎走投河陽南城。"
  },
  {
    "id": "s0056",
    "blockIndex": 17,
    "zh": "守將北豫州刺史高永樂，歡之從祖兄子也，與敖曹有怨，閉門不受。"
  },
  {
    "id": "s0056",
    "blockIndex": 17,
    "zh": "敖曹仰呼求繩，不得，拔刀穿闔未徹而追兵至。"
  },
  {
    "id": "s0056",
    "blockIndex": 17,
    "zh": "敖曹伏橋下，追者見其從奴持金帶，問敖曹所在，奴指示之。"
  },
  {
    "id": "s0056",
    "blockIndex": 17,
    "zh": "敖曹知不免，奮頭曰：「來！"
  },
  {
    "id": "s0056",
    "blockIndex": 17,
    "zh": "與汝開國公。"
  },
  {
    "id": "s0056",
    "blockIndex": 17,
    "zh": "」追者斬其首去。"
  },
  {
    "id": "s0056",
    "blockIndex": 17,
    "zh": "高歡聞之，如喪肝膽，杖高永樂二百，贈敖曹太師、大司馬、太尉。"
  },
  {
    "id": "s0056",
    "blockIndex": 17,
    "zh": "泰賞殺敖曹者布絹萬段，歲歲稍與之，比及周亡，猶未能足。"
  },
  {
    "id": "s0056",
    "blockIndex": 17,
    "zh": "魏又殺東魏西兗州刺史宋顯等，虜甲士萬五千人，赴河死者以萬數。"
  },
  {
    "id": "s0056",
    "blockIndex": 17,
    "zh": "初，歡以-{万俟}-普尊老，特禮之，嘗親扶上馬。"
  },
  {
    "id": "s0056",
    "blockIndex": 17,
    "zh": "其子洛免冠稽首曰：「願出死力以報深恩。"
  },
  {
    "id": "s0056",
    "blockIndex": 17,
    "zh": "」及邙山之戰，諸軍北度橋，洛獨勒兵不動，謂魏人曰：「-{万俟}-受洛干在此，能來可來也！"
  },
  {
    "id": "s0056",
    "blockIndex": 17,
    "zh": "」魏人畏之而去，歡名其所營地為回洛。"
  },
  {
    "id": "s0071",
    "blockIndex": 18,
    "zh": "是日，東、西魏置陳既大，首尾懸遠，從旦至未，戰數十合，氛霧四塞，莫能相知。"
  },
  {
    "id": "s0071",
    "blockIndex": 18,
    "zh": "魏獨孤信、李遠居右，趙貴、怡峰居左，戰並不利；"
  },
  {
    "id": "s0071",
    "blockIndex": 18,
    "zh": "又未知魏主及丞相泰所在，皆棄其卒先歸。"
  },
  {
    "id": "s0071",
    "blockIndex": 18,
    "zh": "開府儀同三司李虎、念賢等為後軍，見信等退，即與俱去。"
  },
  {
    "id": "s0071",
    "blockIndex": 18,
    "zh": "泰由是燒營而歸，留儀同三司長孫子彥守金墉。"
  },
  {
    "id": "s0076",
    "blockIndex": 19,
    "zh": "王思政下馬，舉長槊左右橫擊，一舉輒踣數人。"
  },
  {
    "id": "s0076",
    "blockIndex": 19,
    "zh": "陷陳既深，從者盡死，思政被重創，悶絕。"
  },
  {
    "id": "s0076",
    "blockIndex": 19,
    "zh": "會日暮，敵亦收兵。"
  },
  {
    "id": "s0076",
    "blockIndex": 19,
    "zh": "思政每戰常著破衣弊甲，敵不知其將帥，故得免。"
  },
  {
    "id": "s0076",
    "blockIndex": 19,
    "zh": "帳下督雷五安於戰處哭求思政，會其已蘇，割衣裹創，扶思政上馬。"
  },
  {
    "id": "s0076",
    "blockIndex": 19,
    "zh": "夜久，始得還營。"
  },
  {
    "id": "s0082",
    "blockIndex": 20,
    "zh": "平東將軍蔡祐下馬步鬥，左右勸乘馬以備倉猝，祐怒曰：「丞相愛我如子，今日豈惜生乎！"
  },
  {
    "id": "s0082",
    "blockIndex": 20,
    "zh": "」帥左右十餘人合聲大呼，擊東魏兵，殺傷甚眾。"
  },
  {
    "id": "s0082",
    "blockIndex": 20,
    "zh": "東魏人圍之十餘重，祐彎弓持滿，四面拒之。"
  },
  {
    "id": "s0082",
    "blockIndex": 20,
    "zh": "東魏人募厚甲長刀者直進取之，去祐可三十步，左右勸射之，祐曰：「吾曹之命，在此一矢，豈可虛發！"
  },
  {
    "id": "s0082",
    "blockIndex": 20,
    "zh": "」將至十步，祐乃射之，應弦而倒，東魏兵稍卻，祐徐引還。"
  },
  {
    "id": "s0082",
    "blockIndex": 20,
    "zh": "魏主至恆農，守將已棄城走，所虜降卒在恆農者相與閉門拒守，丞相泰攻拔之，誅其魁首數百人。"
  },
  {
    "id": "s0082",
    "blockIndex": 20,
    "zh": "蔡祐追及泰於恆農，夜，見泰，泰曰：「承先，爾來，吾無憂矣。"
  },
  {
    "id": "s0082",
    "blockIndex": 20,
    "zh": "」泰驚不得寢，枕祐股，然後安。"
  },
  {
    "id": "s0082",
    "blockIndex": 20,
    "zh": "祐每從泰戰，常為士卒先。"
  },
  {
    "id": "s0082",
    "blockIndex": 20,
    "zh": "戰還，諸將皆爭功，祐終無所言。"
  },
  {
    "id": "s0082",
    "blockIndex": 20,
    "zh": "泰每歎曰：「承先口不言勳，我當代其論敘。"
  },
  {
    "id": "s0082",
    "blockIndex": 20,
    "zh": "」泰留王思政鎮恆農，除侍中、東道行台。"
  },
  {
    "id": "s0094",
    "blockIndex": 21,
    "zh": "魏之東伐也，關中留守兵少，前後所虜東魏士卒散在民間，聞魏兵敗，謀作亂。"
  },
  {
    "id": "s0094",
    "blockIndex": 21,
    "zh": "李虎等至長安，計無所出，與太尉王盟、僕射周惠達等奉太子欽出屯渭北。"
  },
  {
    "id": "s0094",
    "blockIndex": 21,
    "zh": "百姓互相剽掠，關中大擾。"
  },
  {
    "id": "s0094",
    "blockIndex": 21,
    "zh": "於是沙苑所虜東魏都督趙青雀、雍州民於伏德等遂反，青雀據長安子城，伏德保咸陽，與咸陽太守慕容思慶各收降卒以拒還兵。"
  },
  {
    "id": "s0094",
    "blockIndex": 21,
    "zh": "長安大城民相帥以拒青雀，日與之戰。"
  },
  {
    "id": "s0094",
    "blockIndex": 21,
    "zh": "大都督侯莫陳順擊賊，屢破之，賊不敢出。"
  },
  {
    "id": "s0094",
    "blockIndex": 21,
    "zh": "順，崇之兄也。"
  },
  {
    "id": "s0101",
    "blockIndex": 22,
    "zh": "扶風公王羆鎮河東，大開城門，悉召軍士謂曰：「今聞大軍失利，青雀作亂，諸人莫有固志。"
  },
  {
    "id": "s0101",
    "blockIndex": 22,
    "zh": "王羆受委於此，以死報恩。"
  },
  {
    "id": "s0101",
    "blockIndex": 22,
    "zh": "有能同心者可共固守；"
  },
  {
    "id": "s0101",
    "blockIndex": 22,
    "zh": "必恐城陷，任自出城。"
  },
  {
    "id": "s0101",
    "blockIndex": 22,
    "zh": "」眾感其言，皆無異志。"
  },
  {
    "id": "s0106",
    "blockIndex": 23,
    "zh": "魏主留閿鄉。"
  },
  {
    "id": "s0106",
    "blockIndex": 23,
    "zh": "丞相泰以士馬疲弊，不可速進，且謂青雀等烏合，不能為患，曰：「我至長安，以輕騎臨之，必當面縛。"
  },
  {
    "id": "s0106",
    "blockIndex": 23,
    "zh": "」通直散騎常侍吳郡陸通諫曰：「賊逆謀久定，必無遷善之心。"
  },
  {
    "id": "s0106",
    "blockIndex": 23,
    "zh": "蜂蠆有毒，安可輕也！"
  },
  {
    "id": "s0106",
    "blockIndex": 23,
    "zh": "且賊詐言東寇將至，今若以輕騎臨之，百姓謂為信然，益當驚擾。"
  },
  {
    "id": "s0106",
    "blockIndex": 23,
    "zh": "今軍雖疲弊，精銳尚多。"
  },
  {
    "id": "s0106",
    "blockIndex": 23,
    "zh": "以明公之威，總大軍以臨之，何憂不克！"
  },
  {
    "id": "s0106",
    "blockIndex": 23,
    "zh": "」泰從之，引兵西入。"
  },
  {
    "id": "s0106",
    "blockIndex": 23,
    "zh": "父老見泰至，莫不悲喜，士女相賀。"
  },
  {
    "id": "s0106",
    "blockIndex": 23,
    "zh": "華州刺史宇文導引兵襲咸陽，斬思慶，擒伏德。"
  },
  {
    "id": "s0106",
    "blockIndex": 23,
    "zh": "南度渭，與泰會攻青雀，破之。"
  },
  {
    "id": "s0106",
    "blockIndex": 23,
    "zh": "太保梁景睿以疾留長安，與青雀通謀，泰殺之。"
  },
  {
    "id": "s0118",
    "blockIndex": 24,
    "zh": "東魏太師歡自晉陽將七千騎至孟津，未濟，聞魏師已循，遂濟河，遣別將追魏師至崤，不及而還。"
  },
  {
    "id": "s0118",
    "blockIndex": 24,
    "zh": "歡攻金墉，長孫子彥棄城走，焚城中室屋俱盡，歡毀金墉而還。"
  },
  {
    "id": "s0120",
    "blockIndex": 25,
    "zh": "東魏之遷鄴也，主客郎中裴讓之留洛陽。"
  },
  {
    "id": "s0120",
    "blockIndex": 25,
    "zh": "獨孤信之敗也，讓之弟諏之隨丞相泰入關，為大行台倉曹郎中。"
  },
  {
    "id": "s0120",
    "blockIndex": 25,
    "zh": "歡囚讓之兄弟五人，讓之曰：「昔諸葛亮兄弟，事吳、蜀各盡其心，況讓之老母在此，不忠不孝，必不為也。"
  },
  {
    "id": "s0120",
    "blockIndex": 25,
    "zh": "明公推誠待物，物亦歸心；"
  },
  {
    "id": "s0120",
    "blockIndex": 25,
    "zh": "若用猜忌，去霸業遠矣。"
  },
  {
    "id": "s0120",
    "blockIndex": 25,
    "zh": "」歡皆釋之。"
  },
  {
    "id": "s0126",
    "blockIndex": 26,
    "zh": "九月，魏主入長安，丞相泰還屯華州。"
  },
  {
    "id": "s0127",
    "blockIndex": 27,
    "zh": "東魏大都督賀拔仁擊邢磨納、盧仲禮等，平之。"
  },
  {
    "id": "s0128",
    "blockIndex": 28,
    "zh": "盧景裕本儒生，太師歡釋之，召館於家，使教諸子。"
  },
  {
    "id": "s0128",
    "blockIndex": 28,
    "zh": "景裕講論精微，難者或相詆訶，大聲厲色，言至不遜，而景裕神采儼然，風調如一，從容往復，無際可尋。"
  },
  {
    "id": "s0128",
    "blockIndex": 28,
    "zh": "性清靜，歷官屢有進退，無得失之色；"
  },
  {
    "id": "s0128",
    "blockIndex": 28,
    "zh": "弊衣粗食，恬然自安，終日端嚴，如對賓客。"
  },
  {
    "id": "s0132",
    "blockIndex": 29,
    "zh": "冬，十月，魏歸高敖曹、竇泰、莫多婁貸文之首於東魏。"
  },
  {
    "id": "s0133",
    "blockIndex": 30,
    "zh": "散騎常侍劉孝儀等聘於東魏。"
  },
  {
    "id": "s0134",
    "blockIndex": 31,
    "zh": "十二月，魏是雲寶襲洛陽，東魏洛州刺史王元軌棄城走。"
  },
  {
    "id": "s0134",
    "blockIndex": 31,
    "zh": "都督趙剛襲廣州，拔之。"
  },
  {
    "id": "s0134",
    "blockIndex": 31,
    "zh": "於是自襄、廣已西城鎮復為魏。"
  },
  {
    "id": "s0137",
    "blockIndex": 32,
    "zh": "魏自正光以後，四方多事，民避賦役，多為僧尼，至二百萬人，寺有三萬餘區。"
  },
  {
    "id": "s0137",
    "blockIndex": 32,
    "zh": "至是，東魏始詔「牧守、令長擅立寺者，計其功庸，以枉法論。"
  },
  {
    "id": "s0140",
    "blockIndex": 33,
    "zh": "初，魏伊川土豪李長壽為防蠻都督，積功至北華州刺史。"
  },
  {
    "id": "s0140",
    "blockIndex": 33,
    "zh": "孝武帝西遷，長壽帥其徒拒東魏，魏以長壽為廣州刺史。"
  },
  {
    "id": "s0140",
    "blockIndex": 33,
    "zh": "侯景攻拔其壁，殺之。"
  },
  {
    "id": "s0140",
    "blockIndex": 33,
    "zh": "其子延孫復收集父兵以拒東魏，魏之貴臣廣陵王欣、錄尚書長孫稚等皆攜家往依之，延孫資遣衛送，使達關中。"
  },
  {
    "id": "s0140",
    "blockIndex": 33,
    "zh": "東魏高歡患之，數遣兵攻延孫，不能克。"
  },
  {
    "id": "s0140",
    "blockIndex": 33,
    "zh": "魏以延孫為京南行台、節度河南諸軍事、廣州刺史。"
  },
  {
    "id": "s0140",
    "blockIndex": 33,
    "zh": "延孫以澄清伊、洛為己任，魏以延孫兵少，更以長壽之婿京兆韋法保為東洛州刺史，配兵數百以助之。"
  },
  {
    "id": "s0140",
    "blockIndex": 33,
    "zh": "法保名祐，以字行，既至，與延孫連兵置柵於伏流。"
  },
  {
    "id": "s0140",
    "blockIndex": 33,
    "zh": "獨孤信之入洛陽也，欲繕修宮室，使外兵郎中天水權景宣帥徒兵三千出采運。"
  },
  {
    "id": "s0140",
    "blockIndex": 33,
    "zh": "會東魏兵至，河南皆叛，景宣間道西走，與李延孫相會，攻孔城，拔之，洛陽以南尋亦西附。"
  },
  {
    "id": "s0140",
    "blockIndex": 33,
    "zh": "丞相泰即留景宣守張白塢，節度東南諸軍應關西者。"
  },
  {
    "id": "s0140",
    "blockIndex": 33,
    "zh": "是歲，延孫為其長史楊伯蘭所殺，韋法保即引兵據延孫之柵。"
  },
  {
    "id": "s0152",
    "blockIndex": 34,
    "zh": "東魏將段琛等據宜陽，遣陽州刺史牛道恆誘魏邊民。"
  },
  {
    "id": "s0152",
    "blockIndex": 34,
    "zh": "魏南兗州刺史韋孝寬患之，乃詐為道恆與孝寬書，論歸款之意，使諜人遺之於琛營，琛果疑道恆。"
  },
  {
    "id": "s0152",
    "blockIndex": 34,
    "zh": "孝寬乘其猜阻，出兵襲之，擒道恆及琛，崤、澠遂清。"
  },
  {
    "id": "s0152",
    "blockIndex": 34,
    "zh": "東道行台王思政以玉壁險要，請築城，自恆農徙鎮之，詔加都督汾、晉、并州諸軍事、并州刺史，行台如故。"
  },
  {
    "id": "s0156",
    "blockIndex": 35,
    "zh": "東魏以高澄攝吏部尚書，始改崔亮年勞之制，銓擢賢能；"
  },
  {
    "id": "s0156",
    "blockIndex": 35,
    "zh": "又沙汰尚書郎，妙選人地以充之。"
  },
  {
    "id": "s0156",
    "blockIndex": 35,
    "zh": "凡才名之士，雖未薦擢，皆引致門下，與之遊宴、講論、賦詩，士大夫以是稱之。"
  },
  {
    "id": "s0159",
    "blockIndex": 36,
    "zh": "高祖武皇帝十四大同五年（"
  },
  {
    "id": "s0159",
    "blockIndex": 36,
    "zh": "己未，公元五三九年）"
  },
  {
    "id": "s0161",
    "blockIndex": 37,
    "zh": "春，正月，乙卯，以尚書左僕射蕭淵藻為中衛將軍，丹楊尹何敬容為尚書令，吏部尚書張纘為僕射。"
  },
  {
    "id": "s0161",
    "blockIndex": 37,
    "zh": "纘，弘策之子也。"
  },
  {
    "id": "s0161",
    "blockIndex": 37,
    "zh": "自晉、宋以來，宰相皆以文義自逸，敬容獨勤簿領，日旰不休，為時俗所嗤鄙。"
  },
  {
    "id": "s0161",
    "blockIndex": 37,
    "zh": "自徐勉、周捨既卒，當權要者，外朝則何敬容，內省則朱異。"
  },
  {
    "id": "s0161",
    "blockIndex": 37,
    "zh": "敬容質愨無文，以綱維為己任；"
  },
  {
    "id": "s0161",
    "blockIndex": 37,
    "zh": "異文華敏洽，曲營世譽。"
  },
  {
    "id": "s0161",
    "blockIndex": 37,
    "zh": "二人行異而俱得幸於上。"
  },
  {
    "id": "s0161",
    "blockIndex": 37,
    "zh": "異善伺候人主意為阿諛，用事三十年，廣納貨賂，欺罔視聽，遠近莫不忿疾。"
  },
  {
    "id": "s0161",
    "blockIndex": 37,
    "zh": "園宅、玩好、飲膳、聲色窮一時之盛。"
  },
  {
    "id": "s0161",
    "blockIndex": 37,
    "zh": "每休下，車馬填門，唯王承、王稚及褚翔不往。"
  },
  {
    "id": "s0161",
    "blockIndex": 37,
    "zh": "承、稚，暕之子；"
  },
  {
    "id": "s0161",
    "blockIndex": 37,
    "zh": "翔，淵之曾孫也。"
  },
  {
    "id": "s0173",
    "blockIndex": 38,
    "zh": "丁巳，御史中丞參禮儀事賀琛奏：「南、北二郊及藉田，往還並宜御輦，不復乘輅。"
  },
  {
    "id": "s0173",
    "blockIndex": 38,
    "zh": "」詔從之，祀宗廟仍乘玉輦。"
  },
  {
    "id": "s0173",
    "blockIndex": 38,
    "zh": "琛，瑒之弟子也。"
  },
  {
    "id": "s0176",
    "blockIndex": 39,
    "zh": "辛酉，東魏以尚書令孫騰為司徒。"
  },
  {
    "id": "s0177",
    "blockIndex": 40,
    "zh": "辛未，上祀南郊。"
  },
  {
    "id": "s0178",
    "blockIndex": 41,
    "zh": "魏丞相泰於行台置學，取丞郎、府佐德行明敏者充學生，悉令旦治公務，晚就講習。"
  },
  {
    "id": "s0179",
    "blockIndex": 42,
    "zh": "東魏丞相歡，以徐州刺史房謨、廣平太守羊孰、廣宗太守竇瑗、平原太守許惇有政績清能，與諸刺史書，褒稱謨等以勸之。"
  },
  {
    "id": "s0180",
    "blockIndex": 43,
    "zh": "夏，五月，甲戌，東魏立丞相歡女為皇后；"
  },
  {
    "id": "s0180",
    "blockIndex": 43,
    "zh": "乙亥，大赦。"
  },
  {
    "id": "s0182",
    "blockIndex": 44,
    "zh": "魏以開府儀同三司李弼為司空。"
  },
  {
    "id": "s0183",
    "blockIndex": 45,
    "zh": "秋，七月，魏以扶風王孚為太尉。"
  },
  {
    "id": "s0184",
    "blockIndex": 46,
    "zh": "九月，甲子，東魏發畿內十萬人城鄴，四十日罷。"
  },
  {
    "id": "s0184",
    "blockIndex": 46,
    "zh": "冬，十月，癸亥，以新宮成，大赦，改元興和。"
  },
  {
    "id": "s0186",
    "blockIndex": 47,
    "zh": "魏置紙筆於陽武門外以求得失。"
  },
  {
    "id": "s0187",
    "blockIndex": 48,
    "zh": "十一月，乙亥，東魏使散騎常侍王元景、魏收來聘。"
  },
  {
    "id": "s0188",
    "blockIndex": 49,
    "zh": "東魏人以《正光歷》浸差，命校書郎李業興更加修正，以甲子為元，號曰《興光歷》，既成，行之。"
  },
  {
    "id": "s0189",
    "blockIndex": 50,
    "zh": "散騎常侍朱異奏：「頃來置州稍廣，而小大不倫，請分為五品，其位秩高卑，參僚多少，皆以是為差。"
  },
  {
    "id": "s0189",
    "blockIndex": 50,
    "zh": "」詔從之。"
  },
  {
    "id": "s0189",
    "blockIndex": 50,
    "zh": "於是上品二十州，次品十州，次品八州，次品二十三州，下品二十一州。"
  },
  {
    "id": "s0189",
    "blockIndex": 50,
    "zh": "時上方事征伐，恢拓境宇，北逾淮、汝，東距彭城，西開牂柯，南平俚洞，建置州郡，紛綸甚眾，故異請分之。"
  },
  {
    "id": "s0189",
    "blockIndex": 50,
    "zh": "其下品皆異國之人來歸附者，徒有州名而無土地，或因荒徼之民所居村落置州及郡縣，刺史守令皆用彼人為之，尚書不能悉領，山川險遠，職貢罕通。"
  },
  {
    "id": "s0189",
    "blockIndex": 50,
    "zh": "五品之外，又有二十餘州不知處所。"
  },
  {
    "id": "s0189",
    "blockIndex": 50,
    "zh": "凡一百七州。"
  },
  {
    "id": "s0189",
    "blockIndex": 50,
    "zh": "又以邊境鎮戍，雖領民不多，欲重其將帥，皆建為郡，或一人領二三郡太守，州郡雖多而戶口日耗矣。"
  },
  {
    "id": "s0197",
    "blockIndex": 51,
    "zh": "魏自西遷以來，禮樂散逸，丞相泰命左僕射周惠達、吏部郎中北海唐瑾損益舊章，至是稍備。"
  },
  {
    "id": "s0198",
    "blockIndex": 52,
    "zh": "高祖武皇帝十四大同六年（"
  },
  {
    "id": "s0198",
    "blockIndex": 52,
    "zh": "庚申，公元五四零年）"
  },
  {
    "id": "s0200",
    "blockIndex": 53,
    "zh": "春，正月，壬申，東魏以廣平公庫狄干為太保。"
  },
  {
    "id": "s0201",
    "blockIndex": 54,
    "zh": "丁丑，東魏主入新宮，大赦。"
  },
  {
    "id": "s0202",
    "blockIndex": 55,
    "zh": "魏扶風王孚卒。"
  },
  {
    "id": "s0203",
    "blockIndex": 56,
    "zh": "二月，己亥，上耕藉田。"
  },
  {
    "id": "s0204",
    "blockIndex": 57,
    "zh": "魏鑄五銖錢。"
  },
  {
    "id": "s0205",
    "blockIndex": 58,
    "zh": "東魏大行台侯景出三鴉，將復荊州，魏丞相泰遣李弼、獨孤信各將五千騎出武關，景乃還。"
  },
  {
    "id": "s0206",
    "blockIndex": 59,
    "zh": "魏文後既為尼，居別宮，悼後猶忌之，乃以其子武都王戊為秦州刺史，使文後隨之官。"
  },
  {
    "id": "s0206",
    "blockIndex": 59,
    "zh": "魏主雖限以大計，而恩好不忘，密令養發，有追還之意。"
  },
  {
    "id": "s0206",
    "blockIndex": 59,
    "zh": "會柔然舉國度河南侵，時頗有言柔然以悼後故興師者，帝曰：「豈有興百萬之眾為一女子邪！"
  },
  {
    "id": "s0206",
    "blockIndex": 59,
    "zh": "雖然，致人此言，朕亦何顏以見將帥！"
  },
  {
    "id": "s0206",
    "blockIndex": 59,
    "zh": "」乃遣中常侍曹寵繼手敕賜文後自盡。"
  },
  {
    "id": "s0206",
    "blockIndex": 59,
    "zh": "文後泣謂寵曰：「願至尊千萬歲，天下康寧，死無恨也！"
  },
  {
    "id": "s0206",
    "blockIndex": 59,
    "zh": "」遂自殺。"
  },
  {
    "id": "s0206",
    "blockIndex": 59,
    "zh": "鑿麥積崖而葬之，號曰寂陵。"
  },
  {
    "id": "s0214",
    "blockIndex": 60,
    "zh": "夏，丞相泰召諸軍屯沙苑以備柔然。"
  },
  {
    "id": "s0214",
    "blockIndex": 60,
    "zh": "右僕射周惠達發士馬守京城，塹諸街巷，召雍州刺史王羆議之，羆不應召，謂使者曰：「若蠕蠕至渭北者，王羆自帥鄉里破之，不煩國家兵馬，何為天子城中作如此驚擾！"
  },
  {
    "id": "s0214",
    "blockIndex": 60,
    "zh": "由周家小兒恇怯致此。"
  },
  {
    "id": "s0214",
    "blockIndex": 60,
    "zh": "」柔然至夏州而退。"
  },
  {
    "id": "s0214",
    "blockIndex": 60,
    "zh": "未幾，悼後遇疾殂。"
  },
  {
    "id": "s0219",
    "blockIndex": 61,
    "zh": "五月，乙酉，魏行台宮延和、陝州刺史宮延慶降於東魏，東魏以河北馬場為義州以處之。"
  },
  {
    "id": "s0220",
    "blockIndex": 62,
    "zh": "東魏陽州武公高永樂卒。"
  },
  {
    "id": "s0221",
    "blockIndex": 63,
    "zh": "閏月，丁丑朔，日有食之。"
  },
  {
    "id": "s0222",
    "blockIndex": 64,
    "zh": "己丑，東魏封皇兄景植為宜陽王，皇弟威為清河王，謙為穎川王。"
  },
  {
    "id": "s0223",
    "blockIndex": 65,
    "zh": "六月，壬子，東魏華山王鷙卒。"
  },
  {
    "id": "s0224",
    "blockIndex": 66,
    "zh": "秋，七月，丁亥，東魏使兼散騎常侍李象等來聘。"
  },
  {
    "id": "s0224",
    "blockIndex": 66,
    "zh": "八月，戊午，大赦。"
  },
  {
    "id": "s0226",
    "blockIndex": 67,
    "zh": "九月，戊戌，司空袁昂卒，遺疏不受贈謚，敕諸子勿上行狀及立銘志。"
  },
  {
    "id": "s0226",
    "blockIndex": 67,
    "zh": "上不許，贈本官，謚穆正公。"
  },
  {
    "id": "s0228",
    "blockIndex": 68,
    "zh": "冬，十一月，魏太師念賢卒。"
  },
  {
    "id": "s0229",
    "blockIndex": 69,
    "zh": "吐谷渾自莫折念生之亂，不通於魏。"
  },
  {
    "id": "s0229",
    "blockIndex": 69,
    "zh": "伏連籌卒，子誇呂立，始稱可汗，居伏俟城。"
  },
  {
    "id": "s0229",
    "blockIndex": 69,
    "zh": "其地東西三千里，南北千餘里，官有王、公、僕射、尚書、郎中、將軍之號。"
  },
  {
    "id": "s0229",
    "blockIndex": 69,
    "zh": "是歲，始遣使假道柔然，聘於東魏。"
  },
  {
    "id": "s0233",
    "blockIndex": 70,
    "zh": "高祖武皇帝十四大同七年（"
  },
  {
    "id": "s0233",
    "blockIndex": 70,
    "zh": "辛酉，公元五四一年）"
  },
  {
    "id": "s0235",
    "blockIndex": 71,
    "zh": "春，正月，辛巳，上祀南郊，大赦。"
  },
  {
    "id": "s0235",
    "blockIndex": 71,
    "zh": "辛丑，祀明堂。"
  },
  {
    "id": "s0237",
    "blockIndex": 72,
    "zh": "宕昌王梁企定為其下所殺，弟彌定立。"
  },
  {
    "id": "s0237",
    "blockIndex": 72,
    "zh": "二月，乙巳，以彌定為河、梁二州刺史、宕昌王。"
  },
  {
    "id": "s0239",
    "blockIndex": 73,
    "zh": "辛亥，上耕藉田。"
  },
  {
    "id": "s0240",
    "blockIndex": 74,
    "zh": "魏幽州刺史順陽王仲景坐事賜死。"
  },
  {
    "id": "s0241",
    "blockIndex": 75,
    "zh": "三月，魏夏州刺史劉平伏據上郡反，大都督於謹討擒之。"
  },
  {
    "id": "s0242",
    "blockIndex": 76,
    "zh": "夏，五月，遣兼散騎常侍明少遐等聘於東魏。"
  },
  {
    "id": "s0243",
    "blockIndex": 77,
    "zh": "秋，七月，己卯，東魏宜陽王景植卒。"
  },
  {
    "id": "s0244",
    "blockIndex": 78,
    "zh": "魏以侍中宇文測為大都督、行汾州事。"
  },
  {
    "id": "s0244",
    "blockIndex": 78,
    "zh": "測，深之兄也，為政簡惠，得士民心。"
  },
  {
    "id": "s0244",
    "blockIndex": 78,
    "zh": "地接東魏，東魏人數來寇抄，測擒獲之，命解縛，引與相見，為設酒殽，待以客禮，並給糧餼，衛送出境。"
  },
  {
    "id": "s0244",
    "blockIndex": 78,
    "zh": "東魏人大慚，不復為寇，汾、晉之間遂通慶吊，時論稱之。"
  },
  {
    "id": "s0244",
    "blockIndex": 78,
    "zh": "或告測交通境外者，丞相泰怒曰：「測為我安邊，我知其志，何得間我骨肉！"
  },
  {
    "id": "s0244",
    "blockIndex": 78,
    "zh": "」命斬之。"
  },
  {
    "id": "s0250",
    "blockIndex": 79,
    "zh": "魏丞相泰欲革易時政，為強國富民之法，大行台度支尚書兼司農卿蘇綽盡其智能，贊成其事，減官員，置二長，並置屯田以資軍國。"
  },
  {
    "id": "s0250",
    "blockIndex": 79,
    "zh": "又為六條詔書，九月，始奏行之：一曰清心，二曰敦教化，三曰盡地利，四曰擢賢良，五曰恤獄訟，六曰均賦役。"
  },
  {
    "id": "s0250",
    "blockIndex": 79,
    "zh": "泰甚重之，嘗置諸坐右，又令百司習誦之，其牧守令長非通六條及計帳者，不得居官。"
  },
  {
    "id": "s0253",
    "blockIndex": 80,
    "zh": "東魏詔群官於麟趾閣議定法制，謂之《麟趾格》，冬，十月，甲寅，頒行之。"
  },
  {
    "id": "s0254",
    "blockIndex": 81,
    "zh": "乙巳，東魏發夫五萬築漳濱堰，三十五日罷。"
  },
  {
    "id": "s0255",
    "blockIndex": 82,
    "zh": "十一月，丙戌，東魏以彭城王韶為太尉，度支尚書胡僧敬為司空。"
  },
  {
    "id": "s0255",
    "blockIndex": 82,
    "zh": "僧敬名虔，以字行，國珍之兄孫，東魏主之舅也。"
  },
  {
    "id": "s0257",
    "blockIndex": 83,
    "zh": "十二月，東魏遣兼散騎常侍李騫來聘。"
  },
  {
    "id": "s0258",
    "blockIndex": 84,
    "zh": "交趾李賁世為豪右，仕不得志。"
  },
  {
    "id": "s0258",
    "blockIndex": 84,
    "zh": "有並韶者，富於詞藻，詣選求官，吏部尚書蔡撙以並姓無前賢，除廣陽門郎；"
  },
  {
    "id": "s0258",
    "blockIndex": 84,
    "zh": "韶恥之。"
  },
  {
    "id": "s0258",
    "blockIndex": 84,
    "zh": "賁與韶還鄉里，謀作亂，會交州刺史武林侯咨以刻暴失眾心，時賁監德州，因連結數州豪傑俱反。"
  },
  {
    "id": "s0258",
    "blockIndex": 84,
    "zh": "咨輸賄於賁，奔還廣州。"
  },
  {
    "id": "s0258",
    "blockIndex": 84,
    "zh": "上遣咨與高州刺史孫冏、新州刺史盧子雄將兵擊之。"
  },
  {
    "id": "s0258",
    "blockIndex": 84,
    "zh": "咨，恢之子也。"
  },
  {
    "id": "s0265",
    "blockIndex": 85,
    "zh": "是歲，魏又益新制十二條。"
  },
  {
    "id": "s0266",
    "blockIndex": 86,
    "zh": "東魏丞相歡以諸州調絹不依舊式，民甚苦之，奏令悉以四十尺為匹。"
  },
  {
    "id": "s0267",
    "blockIndex": 87,
    "zh": "魏自喪亂以來，農商失業，六鎮之民相帥內徙，就食齊、晉，歡因之以成霸業。"
  },
  {
    "id": "s0267",
    "blockIndex": 87,
    "zh": "東西分裂，連年戰爭，河南州郡鞠為茂草，公私困竭，民多餓死。"
  },
  {
    "id": "s0267",
    "blockIndex": 87,
    "zh": "歡命諸州濱河及津、梁皆置倉積穀以相轉漕，供軍旅，備饑饉，又於幽、瀛、滄、青四州傍海煮鹽。"
  },
  {
    "id": "s0267",
    "blockIndex": 87,
    "zh": "軍國之費，粗得周贍。"
  },
  {
    "id": "s0267",
    "blockIndex": 87,
    "zh": "至是，東方連歲大稔，谷斛至九錢，山東之民稍復甦息矣。"
  },
  {
    "id": "s0272",
    "blockIndex": 88,
    "zh": "東魏尚書令高澄尚靜帝妹馮翊長公主，生子孝琬，朝貴賀之，澄曰：「此至尊之甥，先賀至尊。"
  },
  {
    "id": "s0272",
    "blockIndex": 88,
    "zh": "」三日，帝幸其第，賜錦彩布絹萬匹。"
  },
  {
    "id": "s0272",
    "blockIndex": 88,
    "zh": "於是諸貴競致禮遺，貨滿十室。"
  },
  {
    "id": "s0275",
    "blockIndex": 89,
    "zh": "東魏臨淮王孝友表曰：「令制百家為族，二十五家為閭，五家為比。"
  },
  {
    "id": "s0275",
    "blockIndex": 89,
    "zh": "百家之內有帥二十五，征發皆免，苦樂不均，羊少狼多，復有蠶食，此之為弊久矣。"
  },
  {
    "id": "s0275",
    "blockIndex": 89,
    "zh": "京邑諸坊，或七八百家唯一里正、二史，庶事無闕，而況外州乎！"
  },
  {
    "id": "s0275",
    "blockIndex": 89,
    "zh": "請依舊置三正之名不改，而每閭止為二比，計族省十二丁，貲絹、番兵，所益甚多。"
  },
  {
    "id": "s0275",
    "blockIndex": 89,
    "zh": "」事下尚書，寢不行。"
  },
  {
    "id": "s0280",
    "blockIndex": 90,
    "zh": "安成望族劉敬躬以妖術惑眾，人多信之。"
  },
  {
    "id": "s0281",
    "blockIndex": 91,
    "zh": "高祖武皇帝十四大同八年（"
  },
  {
    "id": "s0281",
    "blockIndex": 91,
    "zh": "壬戌，公元五四二年）"
  },
  {
    "id": "s0283",
    "blockIndex": 92,
    "zh": "春，正月，敬躬據郡反，改元永漢，署官屬，進攻廬陵，逼豫章。"
  },
  {
    "id": "s0283",
    "blockIndex": 92,
    "zh": "南方久不習兵，人情擾駭，豫章內史張綰募兵以拒之。"
  },
  {
    "id": "s0283",
    "blockIndex": 92,
    "zh": "綰，纘之弟也。"
  },
  {
    "id": "s0283",
    "blockIndex": 92,
    "zh": "二月，戊戌，江州刺史湘東王繹遣司馬王僧辯、中兵曹子郢討敬躬，受綰節度。"
  },
  {
    "id": "s0283",
    "blockIndex": 92,
    "zh": "三月，戊辰，擒敬躬，送建康，斬之。"
  },
  {
    "id": "s0283",
    "blockIndex": 92,
    "zh": "僧辯，神念之子也，該博辯捷，器宇肅然，雖射不穿札，而志氣高遠。"
  },
  {
    "id": "s0289",
    "blockIndex": 93,
    "zh": "魏初置六軍。"
  },
  {
    "id": "s0290",
    "blockIndex": 94,
    "zh": "夏，四月，丙寅，東魏使兼散騎常侍李繪來聘。"
  },
  {
    "id": "s0290",
    "blockIndex": 94,
    "zh": "繪，元忠之從子也。"
  },
  {
    "id": "s0292",
    "blockIndex": 95,
    "zh": "東魏丞相歡朝於鄴。"
  },
  {
    "id": "s0292",
    "blockIndex": 95,
    "zh": "司徒孫騰坐事免；"
  },
  {
    "id": "s0292",
    "blockIndex": 95,
    "zh": "乙酉，以彭城王韶錄尚書事，侍中廣陽王湛為太尉，尚書右僕射高隆之為司徒。"
  },
  {
    "id": "s0292",
    "blockIndex": 95,
    "zh": "初，太傅尉景與丞相歡同歸爾朱榮，其妻，歡之姊也，自恃勳戚，貪縱不法，為有司所劾，繫獄；"
  },
  {
    "id": "s0292",
    "blockIndex": 95,
    "zh": "歡三詣闕泣請，乃得免死。"
  },
  {
    "id": "s0292",
    "blockIndex": 95,
    "zh": "丁亥，降為驃騎大將軍、開府儀同三司。"
  },
  {
    "id": "s0292",
    "blockIndex": 95,
    "zh": "歡往造之，景臥不起，大叫曰：「殺我時趣邪！"
  },
  {
    "id": "s0292",
    "blockIndex": 95,
    "zh": "」歡撫而拜謝之。"
  },
  {
    "id": "s0292",
    "blockIndex": 95,
    "zh": "辛卯，以庫狄干為太傅，以領軍將軍婁昭為大司馬，封祖裔為尚書右僕射。"
  },
  {
    "id": "s0292",
    "blockIndex": 95,
    "zh": "六月，甲辰，歡還晉陽。"
  },
  {
    "id": "s0302",
    "blockIndex": 96,
    "zh": "八月，庚戌，東魏以開府儀同三司、吏部尚書侯景為兼尚書僕射、河南道大行台，隨機防討。"
  },
  {
    "id": "s0303",
    "blockIndex": 97,
    "zh": "魏以王盟為太保。"
  },
  {
    "id": "s0303",
    "blockIndex": 97,
    "zh": "東魏丞相歡擊魏，入自汾、絳，連營四十里，丞相泰使王思政守玉壁以斷其道。"
  },
  {
    "id": "s0303",
    "blockIndex": 97,
    "zh": "歡以書招思政曰：「若降，當授以并州。"
  },
  {
    "id": "s0303",
    "blockIndex": 97,
    "zh": "」思政復書曰：「可朱渾道元降，何以不得？"
  },
  {
    "id": "s0303",
    "blockIndex": 97,
    "zh": "」冬，十月，己亥，歡圍玉壁，凡九日，遇大雪，士卒饑凍，多死者，遂解圍去。"
  },
  {
    "id": "s0303",
    "blockIndex": 97,
    "zh": "魏遣太子欽鎮蒲板。"
  },
  {
    "id": "s0303",
    "blockIndex": 97,
    "zh": "丞相泰出軍蒲板，至皁莢，聞歡退渡汾，追之不及。"
  },
  {
    "id": "s0303",
    "blockIndex": 97,
    "zh": "十一月，東魏以可朱渾道元為并州刺史。"
  },
  {
    "id": "s0311",
    "blockIndex": 98,
    "zh": "十二月，魏主狩於華陰，大享將士，丞相泰帥諸將朝之。"
  },
  {
    "id": "s0311",
    "blockIndex": 98,
    "zh": "起萬壽殿於沙苑北。"
  },
  {
    "id": "s0313",
    "blockIndex": 99,
    "zh": "辛亥，東魏遣兼散騎常侍楊斐來聘。"
  },
  {
    "id": "s0314",
    "blockIndex": 100,
    "zh": "孫冏、盧子雄討李賁，以春瘴方起，請待至秋；"
  },
  {
    "id": "s0314",
    "blockIndex": 100,
    "zh": "廣州刺史新渝侯映不許，武林侯咨又趣之。"
  },
  {
    "id": "s0314",
    "blockIndex": 100,
    "zh": "冏等至合浦，死者什六七，眾潰而歸。"
  },
  {
    "id": "s0314",
    "blockIndex": 100,
    "zh": "映，憺之子也。"
  },
  {
    "id": "s0314",
    "blockIndex": 100,
    "zh": "武林侯咨奏冏及子雄與賊交通，逗留不進，敕於廣州賜死。"
  },
  {
    "id": "s0314",
    "blockIndex": 100,
    "zh": "子雄弟子略、子烈、主帥廣陵杜天合及弟僧明、新安周文育等帥子雄之眾攻廣州，欲殺映、咨，為子雄復冤。"
  },
  {
    "id": "s0314",
    "blockIndex": 100,
    "zh": "西江督護、高要太守吳興陳霸先帥精甲三千救之，大破子略等，殺天合，擒僧明、文育。"
  },
  {
    "id": "s0314",
    "blockIndex": 100,
    "zh": "霸先以僧明、文育驍勇過人，釋之，以為主帥。"
  },
  {
    "id": "s0314",
    "blockIndex": 100,
    "zh": "詔以霸先為直閣將軍。"
  },
  {
    "id": "s0323",
    "blockIndex": 101,
    "zh": "魏丞相泰妻馮翊公主生子覺。"
  },
  {
    "id": "s0324",
    "blockIndex": 102,
    "zh": "東魏以光州刺史李元忠為侍中。"
  },
  {
    "id": "s0324",
    "blockIndex": 102,
    "zh": "元忠雖處要任，不以物務干懷，唯飲酒自娛。"
  },
  {
    "id": "s0324",
    "blockIndex": 102,
    "zh": "丞相歡欲用為僕射，世子澄言其放達常醉，不可委以台閣。"
  },
  {
    "id": "s0324",
    "blockIndex": 102,
    "zh": "其子搔聞之，請節酒，元忠曰：「我言作僕射不勝飲酒樂，爾愛僕射，宜勿飲酒。"
  },
  {
    "id": "s0329",
    "blockIndex": 103,
    "zh": "高祖武皇帝十四大同九年（"
  },
  {
    "id": "s0329",
    "blockIndex": 103,
    "zh": "癸亥，公元五四三年）"
  },
  {
    "id": "s0331",
    "blockIndex": 104,
    "zh": "春，正月，壬戌，東魏大赦，改元武定。"
  },
  {
    "id": "s0332",
    "blockIndex": 105,
    "zh": "東魏御史中尉高仲密取吏部郎崔暹之妹，既而棄之，由是與暹有隙。"
  },
  {
    "id": "s0332",
    "blockIndex": 105,
    "zh": "仲密選用御史，多其親戚鄉黨，高澄奏令改選；"
  },
  {
    "id": "s0332",
    "blockIndex": 105,
    "zh": "暹方為澄所寵任，仲密疑其構己，愈恨之。"
  },
  {
    "id": "s0332",
    "blockIndex": 105,
    "zh": "仲密後妻李氏艷而慧，澄見而悅之，李氏不從，衣服皆裂，以告仲密，仲密益怨。"
  },
  {
    "id": "s0332",
    "blockIndex": 105,
    "zh": "尋出為北豫州刺史，陰謀外叛。"
  },
  {
    "id": "s0332",
    "blockIndex": 105,
    "zh": "丞相歡疑之，遣鎮城奚壽興典軍事，仲密但知民務。"
  },
  {
    "id": "s0332",
    "blockIndex": 105,
    "zh": "仲密置酒延壽興，伏壯士，執之，二月，壬申，以虎牢叛，降魏。"
  },
  {
    "id": "s0332",
    "blockIndex": 105,
    "zh": "魏以仲密為侍中、司徒。"
  },
  {
    "id": "s0340",
    "blockIndex": 106,
    "zh": "歡以仲密之叛由崔暹，將殺之，高澄匿暹，為之固請，歡曰：「我丐其命，須與苦手。"
  },
  {
    "id": "s0340",
    "blockIndex": 106,
    "zh": "」澄乃出暹，而謂大行台都官郎陳元康曰：「卿使崔暹得杖，勿復相見。"
  },
  {
    "id": "s0340",
    "blockIndex": 106,
    "zh": "」元康為之言於歡曰：「大王方以天下付大將軍，大將軍有一崔暹不能免其杖，父子尚爾，況於它人！"
  },
  {
    "id": "s0340",
    "blockIndex": 106,
    "zh": "」歡乃釋之。"
  },
  {
    "id": "s0344",
    "blockIndex": 107,
    "zh": "高季式在永安戍，仲密遣信報之；"
  },
  {
    "id": "s0344",
    "blockIndex": 107,
    "zh": "季式走告歡，歡待之如舊。"
  },
  {
    "id": "s0346",
    "blockIndex": 108,
    "zh": "魏丞相泰帥諸軍以應仲密，以太子少傅李遠為前驅，至洛陽，遣開府儀同三司於謹攻柏谷，拔之；"
  },
  {
    "id": "s0346",
    "blockIndex": 108,
    "zh": "三月，壬申，圍河橋南城。"
  },
  {
    "id": "s0346",
    "blockIndex": 108,
    "zh": "東魏丞相歡將兵十萬至河北，泰退軍瀍上，縱火船於上流以燒河橋。"
  },
  {
    "id": "s0346",
    "blockIndex": 108,
    "zh": "斛律金使行台郎中張亮以小艇百餘載長鎖，伺火船將至，以釘釘之，引鎖向岸，橋遂獲全。"
  },
  {
    "id": "s0350",
    "blockIndex": 109,
    "zh": "歡渡河，據邙山為陳，不進者數日。"
  },
  {
    "id": "s0350",
    "blockIndex": 109,
    "zh": "泰留輜重於瀍曲，夜，登邙山以襲歡。"
  },
  {
    "id": "s0350",
    "blockIndex": 109,
    "zh": "候騎白歡曰：「賊距此四十餘里，蓐食乾飲而來。"
  },
  {
    "id": "s0350",
    "blockIndex": 109,
    "zh": "」歡曰：「自當渴死！"
  },
  {
    "id": "s0350",
    "blockIndex": 109,
    "zh": "」乃正陣以待之。"
  },
  {
    "id": "s0350",
    "blockIndex": 109,
    "zh": "戊申，黎明，泰軍與歡軍遇。"
  },
  {
    "id": "s0350",
    "blockIndex": 109,
    "zh": "東魏彭樂以數千騎為右甄，沖魏軍之北垂，所向奔潰，遂馳入魏營。"
  },
  {
    "id": "s0350",
    "blockIndex": 109,
    "zh": "人告彭樂叛，歡甚怒。"
  },
  {
    "id": "s0350",
    "blockIndex": 109,
    "zh": "俄而西北塵起，樂使來告捷，虜魏侍中、開府儀同三司、大都督臨洮王柬、蜀郡王榮宗、江夏王升、巨鹿王闡、譙郡王亮、詹事趙善及督將僚佐四十八人。"
  },
  {
    "id": "s0350",
    "blockIndex": 109,
    "zh": "諸將乘勝擊魏，大破之，斬首三萬餘級。"
  },
  {
    "id": "s0360",
    "blockIndex": 110,
    "zh": "歡使彭樂追泰，泰窘，謂樂曰：「汝非彭樂邪？"
  },
  {
    "id": "s0360",
    "blockIndex": 110,
    "zh": "癡男子！"
  },
  {
    "id": "s0360",
    "blockIndex": 110,
    "zh": "今日無我，明日豈有汝邪！"
  },
  {
    "id": "s0360",
    "blockIndex": 110,
    "zh": "何不急還營，收汝金寶！"
  },
  {
    "id": "s0360",
    "blockIndex": 110,
    "zh": "」樂從其言，獲泰金帶一囊以歸，言於歡曰：「黑獺漏刃，破膽矣！"
  },
  {
    "id": "s0360",
    "blockIndex": 110,
    "zh": "」歡雖喜其勝而怒其失泰，令伏諸地，親捽其頭，連頓之，並數以沙苑之敗，舉刃將下者三，噤齘良久。"
  },
  {
    "id": "s0360",
    "blockIndex": 110,
    "zh": "樂曰：「乞五千騎，復為王取之。"
  },
  {
    "id": "s0360",
    "blockIndex": 110,
    "zh": "」歡曰：「汝縱之何意？"
  },
  {
    "id": "s0360",
    "blockIndex": 110,
    "zh": "而言復取邪！"
  },
  {
    "id": "s0360",
    "blockIndex": 110,
    "zh": "」命取絹三千匹壓樂背，因以賜之。"
  },
  {
    "id": "s0360",
    "blockIndex": 110,
    "zh": "明日，復戰，泰為中軍，中山公趙貴為左軍，領軍若干惠等為右軍。"
  },
  {
    "id": "s0360",
    "blockIndex": 110,
    "zh": "中軍、右軍合擊東魏，大破之，悉俘其步卒。"
  },
  {
    "id": "s0360",
    "blockIndex": 110,
    "zh": "歡失馬，赫連陽順下馬以授歡。"
  },
  {
    "id": "s0360",
    "blockIndex": 110,
    "zh": "歡上馬走，從者步騎七人，追兵至，親信都督尉興慶曰：「王速去，興慶腰有百箭，足殺百人。"
  },
  {
    "id": "s0360",
    "blockIndex": 110,
    "zh": "」歡曰：「事濟，以爾為懷州刺史；"
  },
  {
    "id": "s0360",
    "blockIndex": 110,
    "zh": "若死，用爾子！"
  },
  {
    "id": "s0360",
    "blockIndex": 110,
    "zh": "」興慶曰：「兒小，願用兄！"
  },
  {
    "id": "s0360",
    "blockIndex": 110,
    "zh": "」歡許之。"
  },
  {
    "id": "s0360",
    "blockIndex": 110,
    "zh": "興慶拒戰，矢盡而死。"
  },
  {
    "id": "s0379",
    "blockIndex": 111,
    "zh": "東魏軍士有逃奔魏者，告以歡所在，泰募勇敢三千人，皆執短兵，配大都督賀拔勝以攻之。"
  },
  {
    "id": "s0379",
    "blockIndex": 111,
    "zh": "勝識歡於行間，執槊與十三騎逐之，馳數里，槊刃垂及，因字之曰：「賀六渾，賀拔破胡必殺汝！"
  },
  {
    "id": "s0379",
    "blockIndex": 111,
    "zh": "」歡氣殆絕，河州刺史劉洪徽從傍射勝，中其二騎，武衛將軍段韶射勝馬，斃之。"
  },
  {
    "id": "s0379",
    "blockIndex": 111,
    "zh": "比副馬至，歡已逸去。"
  },
  {
    "id": "s0379",
    "blockIndex": 111,
    "zh": "勝歎曰：「今日不執弓矢，天也！"
  },
  {
    "id": "s0385",
    "blockIndex": 112,
    "zh": "魏南郢州刺史耿令貴，大呼，獨入敵中，鋒刃亂下，人皆謂已死，俄奮刀而還。"
  },
  {
    "id": "s0385",
    "blockIndex": 112,
    "zh": "如是數四，當令貴前者死傷相繼。"
  },
  {
    "id": "s0385",
    "blockIndex": 112,
    "zh": "乃謂左右曰：「吾豈樂殺人！"
  },
  {
    "id": "s0385",
    "blockIndex": 112,
    "zh": "壯士除賊，不得不爾。"
  },
  {
    "id": "s0385",
    "blockIndex": 112,
    "zh": "若不能殺賊，又不為賊所傷，何異逐坐人也！"
  },
  {
    "id": "s0391",
    "blockIndex": 113,
    "zh": "左軍趙貴等五將戰不利，東魏兵復振。"
  },
  {
    "id": "s0391",
    "blockIndex": 113,
    "zh": "泰與戰，又不利。"
  },
  {
    "id": "s0391",
    "blockIndex": 113,
    "zh": "會日暮，魏兵遂遁，東魏兵追之；"
  },
  {
    "id": "s0391",
    "blockIndex": 113,
    "zh": "獨孤信、於謹收散卒自後擊之，追兵驚擾，魏諸軍由是得全。"
  },
  {
    "id": "s0391",
    "blockIndex": 113,
    "zh": "若於惠夜引去，東魏兵追之；"
  },
  {
    "id": "s0391",
    "blockIndex": 113,
    "zh": "惠徐下馬，顧命廚人營食，食畢，謂左右曰：「長安死，此中死，有以異乎？"
  },
  {
    "id": "s0391",
    "blockIndex": 113,
    "zh": "」乃建旗鳴角，收散卒徐還；"
  },
  {
    "id": "s0391",
    "blockIndex": 113,
    "zh": "追騎疑有伏兵，不敢逼。"
  },
  {
    "id": "s0391",
    "blockIndex": 113,
    "zh": "泰遂入關，屯渭上。"
  },
  {
    "id": "s0400",
    "blockIndex": 114,
    "zh": "歡進至陝，泰使開府儀同三司達奚武等拒之。"
  },
  {
    "id": "s0400",
    "blockIndex": 114,
    "zh": "行台郎中封子繪言於歡曰：「混壹東西，正在今日。"
  },
  {
    "id": "s0400",
    "blockIndex": 114,
    "zh": "昔魏太祖平漢中，不乘勝取巴、蜀，失在遲疑，後悔無及。"
  },
  {
    "id": "s0400",
    "blockIndex": 114,
    "zh": "願大王不以為疑。"
  },
  {
    "id": "s0400",
    "blockIndex": 114,
    "zh": "」歡深然之，集諸將議進止，鹹以為「野無青草，人馬疲瘦，不可遠追。"
  },
  {
    "id": "s0400",
    "blockIndex": 114,
    "zh": "」陳元康曰：「兩雄交爭，歲月已久。"
  },
  {
    "id": "s0400",
    "blockIndex": 114,
    "zh": "今幸而大捷，天授我也，時不可失，當乘勝追之。"
  },
  {
    "id": "s0400",
    "blockIndex": 114,
    "zh": "」歡曰：「若遇伏兵，孤何以濟？"
  },
  {
    "id": "s0400",
    "blockIndex": 114,
    "zh": "」元康曰：「王前沙苑失利，彼尚無伏；"
  },
  {
    "id": "s0400",
    "blockIndex": 114,
    "zh": "今奔敗若此，何能遠謀！"
  },
  {
    "id": "s0400",
    "blockIndex": 114,
    "zh": "若捨而不追，必成後患。"
  },
  {
    "id": "s0400",
    "blockIndex": 114,
    "zh": "」歡不從，使劉豐生將數千騎追泰，遂東歸。"
  },
  {
    "id": "s0412",
    "blockIndex": 115,
    "zh": "泰召王思政於玉壁，將使鎮虎牢，未至而泰敗，乃使守恆農。"
  },
  {
    "id": "s0412",
    "blockIndex": 115,
    "zh": "思政入城，令開門解衣而臥，慰勉將士，示不足畏。"
  },
  {
    "id": "s0412",
    "blockIndex": 115,
    "zh": "後數日，劉豐生至城下，憚之，不敢進，引軍還。"
  },
  {
    "id": "s0412",
    "blockIndex": 115,
    "zh": "思政乃修城郭，起樓櫓，營農田，積芻粟，由是恆農始有守禦之備。"
  },
  {
    "id": "s0416",
    "blockIndex": 116,
    "zh": "丞相泰求自貶，魏主不許。"
  },
  {
    "id": "s0416",
    "blockIndex": 116,
    "zh": "是役也，魏諸將皆無功，唯耿令貴與太子武衛率王胡仁、都督王文達力戰功多。"
  },
  {
    "id": "s0416",
    "blockIndex": 116,
    "zh": "泰欲以雍、岐、北雍三州授之，以州有優劣，使探籌取之。"
  },
  {
    "id": "s0416",
    "blockIndex": 116,
    "zh": "仍賜胡仁名勇，令貴名豪，文達名信，用彰其功。"
  },
  {
    "id": "s0416",
    "blockIndex": 116,
    "zh": "於是廣募關、隴豪右以增軍旅。"
  },
  {
    "id": "s0421",
    "blockIndex": 117,
    "zh": "高仲密之將叛也，陰遣人扇動冀州豪傑，使為內應，東魏遣高隆之馳驛慰撫，由是得安。"
  },
  {
    "id": "s0421",
    "blockIndex": 117,
    "zh": "高澄密書與隆之曰：「仲密枝黨與之俱西者，宜悉收其家屬，以懲將來。"
  },
  {
    "id": "s0421",
    "blockIndex": 117,
    "zh": "」隆之以為恩旨既行，理無追改，若復收治，示民不信，脫致驚擾，所虧不細，乃啟丞相歡而罷之。"
  },
  {
    "id": "s0424",
    "blockIndex": 118,
    "zh": "以太子詹事謝舉為尚書僕射。"
  },
  {
    "id": "s0425",
    "blockIndex": 119,
    "zh": "夏，四月，林邑王攻李賁，賁將范修破林邑於九德。"
  },
  {
    "id": "s0426",
    "blockIndex": 120,
    "zh": "清水氐酋李鼠仁，乘魏之敗，據險作亂；"
  },
  {
    "id": "s0426",
    "blockIndex": 120,
    "zh": "隴右大都督獨孤信屢遣軍擊之，不克。"
  },
  {
    "id": "s0426",
    "blockIndex": 120,
    "zh": "丞相泰遣典簽天水趙昶往諭之，諸酋長聚議，或從或否；"
  },
  {
    "id": "s0426",
    "blockIndex": 120,
    "zh": "其不從者欲加刃於昶，昶神色自若，辭氣逾厲，鼠仁感悟，遂相帥降。"
  },
  {
    "id": "s0426",
    "blockIndex": 120,
    "zh": "氐酋梁道顯叛，泰復遣昶諭降之，徙其豪帥四十餘人並部落於華州，泰即以昶為都督，使領之。"
  },
  {
    "id": "s0431",
    "blockIndex": 121,
    "zh": "泰使諜潛入虎牢，令守將魏光固守。"
  },
  {
    "id": "s0431",
    "blockIndex": 121,
    "zh": "侯景獲之，改其書云：「宜速去。"
  },
  {
    "id": "s0431",
    "blockIndex": 121,
    "zh": "」縱諜入城，光宵遁。"
  },
  {
    "id": "s0431",
    "blockIndex": 121,
    "zh": "景獲高仲密妻子送鄴，北豫、洛二州復入於東魏。"
  },
  {
    "id": "s0431",
    "blockIndex": 121,
    "zh": "五月，壬辰，東魏以克復虎牢，降死罪已下囚，唯不赦高仲密家。"
  },
  {
    "id": "s0431",
    "blockIndex": 121,
    "zh": "丞相歡以高乾有義勳，高昂死王事，季式先自告，皆為之請，免其從坐。"
  },
  {
    "id": "s0431",
    "blockIndex": 121,
    "zh": "仲密妻李氏當死，高澄盛服見之，曰：「今日何如？"
  },
  {
    "id": "s0431",
    "blockIndex": 121,
    "zh": "」李氏默然，遂納之。"
  },
  {
    "id": "s0431",
    "blockIndex": 121,
    "zh": "乙未，以侯景為司空。"
  },
  {
    "id": "s0440",
    "blockIndex": 122,
    "zh": "秋，七月，魏大赦。"
  },
  {
    "id": "s0440",
    "blockIndex": 122,
    "zh": "以王盟為太傅，廣平王贊為司空。"
  },
  {
    "id": "s0442",
    "blockIndex": 123,
    "zh": "八月，乙丑，東魏以汾州刺史斛律金為大司馬。"
  },
  {
    "id": "s0443",
    "blockIndex": 124,
    "zh": "東魏遣兼散騎常侍李渾等來聘。"
  },
  {
    "id": "s0444",
    "blockIndex": 125,
    "zh": "冬，十一月，甲午，東魏主狩於西山；"
  },
  {
    "id": "s0444",
    "blockIndex": 125,
    "zh": "乙巳，還宮。"
  },
  {
    "id": "s0444",
    "blockIndex": 125,
    "zh": "高澄啟解侍中，東魏主以其弟并州刺史太原公洋代之。"
  },
  {
    "id": "s0444",
    "blockIndex": 125,
    "zh": "丞相歡築長城於肆州北山，西自馬陵，東至土□登，四十日罷。"
  },
  {
    "id": "s0448",
    "blockIndex": 126,
    "zh": "魏諸牧守共謁丞相泰，泰命河北太守裴俠別立，謂諸牧守曰：「裴俠清慎奉公，為天下最。"
  },
  {
    "id": "s0448",
    "blockIndex": 126,
    "zh": "有如俠者，可與俱立！"
  },
  {
    "id": "s0448",
    "blockIndex": 126,
    "zh": "」眾默然，無敢應者。"
  },
  {
    "id": "s0448",
    "blockIndex": 126,
    "zh": "泰乃厚賜俠，朝野歎服，號為「獨立君」。"
  },
  {
    "id": "s0452",
    "blockIndex": 127,
    "zh": "高祖武皇帝十四大同十年（"
  },
  {
    "id": "s0452",
    "blockIndex": 127,
    "zh": "甲子，公元五四四年）"
  },
  {
    "id": "s0454",
    "blockIndex": 128,
    "zh": "春，正月，李賁自稱越帝，置百官，改元天德。"
  },
  {
    "id": "s0455",
    "blockIndex": 129,
    "zh": "三月，癸巳，東魏丞相歡巡行冀、定二州，校河北戶口損益，因朝於鄴。"
  },
  {
    "id": "s0456",
    "blockIndex": 130,
    "zh": "甲午，上幸蘭陵，謁建寧陵，使太子入守宮城；"
  },
  {
    "id": "s0456",
    "blockIndex": 130,
    "zh": "辛丑，謁脩陵。"
  },
  {
    "id": "s0458",
    "blockIndex": 131,
    "zh": "丙午，東魏以開府儀同三司孫騰為太保。"
  },
  {
    "id": "s0459",
    "blockIndex": 132,
    "zh": "己酉，上幸京口城北固樓，更名北顧；"
  },
  {
    "id": "s0459",
    "blockIndex": 132,
    "zh": "庚戌，幸回賓亭，宴鄉里故老及所經近縣迎候者，少長數千人，各賚錢二千。"
  },
  {
    "id": "s0461",
    "blockIndex": 133,
    "zh": "壬子，東魏以高澄為大將軍、領中書監，元弼為錄尚書事，左僕射司馬子如為尚書令，侍中高洋為左僕射。"
  },
  {
    "id": "s0462",
    "blockIndex": 134,
    "zh": "丞相歡多在晉陽，孫騰、司馬子如、高岳、高隆之，皆歡之親舊，委以朝政，鄴中謂之四貴，其權勢熏灼中外，率多專恣驕貪。"
  },
  {
    "id": "s0462",
    "blockIndex": 134,
    "zh": "歡欲損奪其權，故以澄為大將軍、領中書監，移門下機事總歸中書，文武賞罰皆稟於澄。"
  },
  {
    "id": "s0462",
    "blockIndex": 134,
    "zh": "孫騰見澄，不肯盡敬，澄叱左右牽下於床，築以刀環，立之門外。"
  },
  {
    "id": "s0462",
    "blockIndex": 134,
    "zh": "太原公洋於澄前拜高隆之，呼為叔父，澄怒罵之。"
  },
  {
    "id": "s0462",
    "blockIndex": 134,
    "zh": "歡謂群公曰：「兒子浸長，公宜避之。"
  },
  {
    "id": "s0462",
    "blockIndex": 134,
    "zh": "」於是公卿以下，見澄無不聳懼。"
  },
  {
    "id": "s0462",
    "blockIndex": 134,
    "zh": "庫狄干，澄姑之婿也，自定州來謁，立於門外，三日乃得見。"
  },
  {
    "id": "s0469",
    "blockIndex": 135,
    "zh": "澄欲置腹心於東魏主左右，擢中兵參軍崔季舒為中書侍郎。"
  },
  {
    "id": "s0469",
    "blockIndex": 135,
    "zh": "澄每進書於帝，有所諫請，或文辭繁雜，季舒輒修飾通之。"
  },
  {
    "id": "s0469",
    "blockIndex": 135,
    "zh": "帝報澄父子之語，常與季舒論之，曰：「崔中書，我乳母也。"
  },
  {
    "id": "s0469",
    "blockIndex": 135,
    "zh": "」季舒，挺之從子也。"
  },
  {
    "id": "s0473",
    "blockIndex": 136,
    "zh": "夏，四月，乙卯，上還自蘭陵。"
  },
  {
    "id": "s0474",
    "blockIndex": 137,
    "zh": "五月，甲申朔，魏丞相泰朝於長安。"
  },
  {
    "id": "s0475",
    "blockIndex": 138,
    "zh": "甲午，東魏遣散騎常侍魏季景來聘。"
  },
  {
    "id": "s0475",
    "blockIndex": 138,
    "zh": "季景，收之族叔也。"
  },
  {
    "id": "s0477",
    "blockIndex": 139,
    "zh": "尚書令何敬容妾弟盜官米，以書屬領軍河東王譽；"
  },
  {
    "id": "s0477",
    "blockIndex": 139,
    "zh": "丁酉，敬容坐免官。"
  },
  {
    "id": "s0479",
    "blockIndex": 140,
    "zh": "東魏廣陽王湛卒。"
  },
  {
    "id": "s0480",
    "blockIndex": 141,
    "zh": "魏琅邪貞獻公賀拔勝諸子在東者，丞相歡盡殺之，勝憤恨發疾而卒。"
  },
  {
    "id": "s0480",
    "blockIndex": 141,
    "zh": "丞相泰常謂人曰：「諸將對敵神色皆動，唯賀拔公臨陳如平時，真大勇也！"
  },
  {
    "id": "s0483",
    "blockIndex": 142,
    "zh": "秋，七月，魏更權衡度量，命尚書蘇綽損益三十六條之制，總為五卷，頒行之。"
  },
  {
    "id": "s0483",
    "blockIndex": 142,
    "zh": "搜簡賢才為牧守令長，皆依新制而遣焉。"
  },
  {
    "id": "s0483",
    "blockIndex": 142,
    "zh": "數年之間，百姓便之。"
  },
  {
    "id": "s0486",
    "blockIndex": 143,
    "zh": "魏自正光以後，政刑弛縱，在位多貪污。"
  },
  {
    "id": "s0486",
    "blockIndex": 143,
    "zh": "丞相歡啟以司州中從事宋游道為御史中尉，澄固請以吏部郎崔暹為之，以游道為尚書左丞。"
  },
  {
    "id": "s0486",
    "blockIndex": 143,
    "zh": "澄謂暹、游道曰：「卿一人處南台，一人處北省，當使天下肅然。"
  },
  {
    "id": "s0486",
    "blockIndex": 143,
    "zh": "」暹選畢義雲等為御史，時稱得人。"
  },
  {
    "id": "s0486",
    "blockIndex": 143,
    "zh": "義雲，眾敬之曾孫也。"
  },
  {
    "id": "s0486",
    "blockIndex": 143,
    "zh": "澄欲假暹威勢，諸公在坐，令暹後至，通名，高視徐步，兩人挈裾而入；"
  },
  {
    "id": "s0486",
    "blockIndex": 143,
    "zh": "澄分庭對揖，暹不讓而坐，觴再行，即辭去。"
  },
  {
    "id": "s0486",
    "blockIndex": 143,
    "zh": "澄留之食，暹曰：「適受敕在台檢校。"
  },
  {
    "id": "s0486",
    "blockIndex": 143,
    "zh": "」遂不待食而去，澄降階送之。"
  },
  {
    "id": "s0486",
    "blockIndex": 143,
    "zh": "它日，澄與諸公出，之東山，遇暹於道，前驅為赤棒所擊，澄回馬避之。"
  },
  {
    "id": "s0496",
    "blockIndex": 144,
    "zh": "尚書令司馬子如以丞相歡故人，當重任，意氣自高，與太師咸陽王坦貪黷無厭；"
  },
  {
    "id": "s0496",
    "blockIndex": 144,
    "zh": "暹前後彈子如、坦及并州刺史可朱渾道元等罪狀，無不極筆。"
  },
  {
    "id": "s0496",
    "blockIndex": 144,
    "zh": "宋游道亦劾子如、坦及太保孫騰、司徒高隆之、司空侯景、尚書元羨等。"
  },
  {
    "id": "s0496",
    "blockIndex": 144,
    "zh": "澄收子如繫獄，一宿，發盡白，辭曰：「司馬子如從夏州策杖投相王，王給露車一乘，豢牸牛犢，犢在道死，唯豢角存，此外皆取之於人。"
  },
  {
    "id": "s0496",
    "blockIndex": 144,
    "zh": "」丞相歡以書敕澄曰：「司馬令，吾之故舊，汝宜寬之。"
  },
  {
    "id": "s0496",
    "blockIndex": 144,
    "zh": "」澄駐馬行街，出子如，脫其鎖；"
  },
  {
    "id": "s0496",
    "blockIndex": 144,
    "zh": "子如懼曰：「非作事邪？"
  },
  {
    "id": "s0496",
    "blockIndex": 144,
    "zh": "」八月，癸酉，削子如官爵。"
  },
  {
    "id": "s0496",
    "blockIndex": 144,
    "zh": "九月，甲申，以濟陰王暉業為太尉；"
  },
  {
    "id": "s0496",
    "blockIndex": 144,
    "zh": "太師咸陽王坦以王還第，元羨等皆免官，其餘死黜者甚眾。"
  },
  {
    "id": "s0496",
    "blockIndex": 144,
    "zh": "久之，歡見子如，哀其憔悴，以膝承其首，親為擇虱，賜酒百瓶，羊五百口，米五百石。"
  },
  {
    "id": "s0507",
    "blockIndex": 145,
    "zh": "高澄對諸貴極言褒美崔暹，且戒屬之。"
  },
  {
    "id": "s0507",
    "blockIndex": 145,
    "zh": "丞相歡書與鄴下諸貴曰：「崔暹居憲台，咸陽王、司馬令皆吾布衣之舊，尊貴親暱，無過二人，同時獲罪，吾不能救，諸君其慎之！"
  },
  {
    "id": "s0510",
    "blockIndex": 146,
    "zh": "宋游道奏駁尚書違失數百條，省中豪吏王儒之徒並鞭斥之，令、僕已下皆側目。"
  },
  {
    "id": "s0510",
    "blockIndex": 146,
    "zh": "高隆之誣游道有不臣之言，罪當死。"
  },
  {
    "id": "s0510",
    "blockIndex": 146,
    "zh": "給事黃門侍郎楊愔曰：「畜狗求吠；"
  },
  {
    "id": "s0510",
    "blockIndex": 146,
    "zh": "今以數吠殺之，恐將來無復吠狗。"
  },
  {
    "id": "s0510",
    "blockIndex": 146,
    "zh": "」游道竟坐除名。"
  },
  {
    "id": "s0510",
    "blockIndex": 146,
    "zh": "澄謂游道曰：「卿早從我向并州，不爾，彼經略殺卿。"
  },
  {
    "id": "s0510",
    "blockIndex": 146,
    "zh": "」游道從澄至晉陽，以為大行台吏部。"
  },
  {
    "id": "s0517",
    "blockIndex": 147,
    "zh": "己丑，大赦。"
  },
  {
    "id": "s0518",
    "blockIndex": 148,
    "zh": "東魏以喪亂之後，戶口失實，徭賦不均。"
  },
  {
    "id": "s0518",
    "blockIndex": 148,
    "zh": "冬，十月，丁巳，以太保孫騰、大司徒高隆之為括戶大使，分行諸州，得無籍之戶六十餘萬，僑居者皆勒還本屬。"
  },
  {
    "id": "s0518",
    "blockIndex": 148,
    "zh": "十一月，甲申，以高隆之錄尚書事，以前大司馬婁昭為司徒。"
  },
  {
    "id": "s0521",
    "blockIndex": 149,
    "zh": "庚子，東魏主祀圜丘。"
  },
  {
    "id": "s0522",
    "blockIndex": 150,
    "zh": "東魏丞相歡襲擊山胡，破之，俘萬餘戶，分配諸州。"
  },
  {
    "id": "s0523",
    "blockIndex": 151,
    "zh": "是歲，東魏以散騎常侍魏收兼中書侍郎，修國史。"
  },
  {
    "id": "s0523",
    "blockIndex": 151,
    "zh": "自梁、魏通好，魏書每云：「想彼境內寧靜，此率土安和。"
  },
  {
    "id": "s0523",
    "blockIndex": 151,
    "zh": "」上復書，去「彼」字而已。"
  },
  {
    "id": "s0523",
    "blockIndex": 151,
    "zh": "收始定書云：「想境內清晏，今萬里安和。"
  },
  {
    "id": "s0523",
    "blockIndex": 151,
    "zh": "」上亦效之。"
  },
  {
    "id": "s0528",
    "blockIndex": 152,
    "zh": "category:資治通鑑"
  }
]
