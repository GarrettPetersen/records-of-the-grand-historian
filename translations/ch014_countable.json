[
  {
    "id": "s0001",
    "blockIndex": 0,
    "zh": "起閼逢困敦，盡重光協洽，凡八年。"
  },
  {
    "id": "s0002",
    "blockIndex": 0,
    "zh": "1冬，十月，丁酉晦，日有食之。"
  },
  {
    "id": "s0003",
    "blockIndex": 0,
    "zh": "----2十一月，丁卯晦，日有食之。"
  },
  {
    "id": "s0004",
    "blockIndex": 0,
    "zh": "----3詔曰：「前遣列侯之國，或辭未行。"
  },
  {
    "id": "s0005",
    "blockIndex": 0,
    "zh": "丞相，朕之所重，其為朕率列侯之國！"
  },
  {
    "id": "s0006",
    "blockIndex": 0,
    "zh": "」十二月，免丞相勃，遣就國。"
  },
  {
    "id": "s0007",
    "blockIndex": 0,
    "zh": "乙亥，以太尉灌嬰為丞相；"
  },
  {
    "id": "s0008",
    "blockIndex": 0,
    "zh": "罷太尉官，屬丞相。"
  },
  {
    "id": "s0009",
    "blockIndex": 0,
    "zh": "----4夏，四月，城陽景王章薨。"
  },
  {
    "id": "s0010",
    "blockIndex": 0,
    "zh": "----5初，趙王敖獻美人於高祖，得幸，有娠。"
  },
  {
    "id": "s0011",
    "blockIndex": 0,
    "zh": "及貫高事發，美人亦坐系河內。"
  },
  {
    "id": "s0012",
    "blockIndex": 0,
    "zh": "美人母弟趙兼因辟陽侯審食其言-{呂后}-，呂后妒，弗肯白。"
  },
  {
    "id": "s0013",
    "blockIndex": 0,
    "zh": "美人已生子，恚，即自殺。"
  },
  {
    "id": "s0014",
    "blockIndex": 0,
    "zh": "吏奉其子詣上，上悔，名之曰長，令-{呂后}-母之，而葬其母真定。"
  },
  {
    "id": "s0015",
    "blockIndex": 0,
    "zh": "後封長為淮南王。"
  },
  {
    "id": "s0016",
    "blockIndex": 1,
    "zh": "淮南王蚤失母，常附呂后，故孝惠、-{呂后}-時得無患；"
  },
  {
    "id": "s0017",
    "blockIndex": 1,
    "zh": "而常心怨辟陽侯，以為不強爭之於-{呂后}-，使其母恨而死也。"
  },
  {
    "id": "s0018",
    "blockIndex": 1,
    "zh": "及帝即位，淮南王自以最親，驕蹇，數不奉法；"
  },
  {
    "id": "s0019",
    "blockIndex": 1,
    "zh": "上常寬假之。"
  },
  {
    "id": "s0020",
    "blockIndex": 1,
    "zh": "是歲，入朝，從上入苑囿獵，與上同車，常謂上「大兄」。"
  },
  {
    "id": "s0021",
    "blockIndex": 1,
    "zh": "王有材力，能扛鼎。"
  },
  {
    "id": "s0022",
    "blockIndex": 1,
    "zh": "乃往見辟陽侯，自袖鐵椎椎辟陽侯，令從者魏敬剄之；"
  },
  {
    "id": "s0023",
    "blockIndex": 1,
    "zh": "馳走闕下，肉袒謝罪。"
  },
  {
    "id": "s0024",
    "blockIndex": 1,
    "zh": "帝傷其志為親，故赦弗治。"
  },
  {
    "id": "s0025",
    "blockIndex": 1,
    "zh": "當是時，薄太后及太子、諸大臣皆憚淮南王。"
  },
  {
    "id": "s0026",
    "blockIndex": 1,
    "zh": "淮南王以此，歸國益驕恣，出入稱警蹕，稱制擬於天子。"
  },
  {
    "id": "s0027",
    "blockIndex": 1,
    "zh": "袁盎諫曰：「諸侯太驕，必生患。"
  },
  {
    "id": "s0028",
    "blockIndex": 1,
    "zh": "」上不聽。"
  },
  {
    "id": "s0029",
    "blockIndex": 1,
    "zh": "----6五月，匈奴右賢王入居河南地，侵盜上郡保塞蠻夷，殺略人民。"
  },
  {
    "id": "s0030",
    "blockIndex": 1,
    "zh": "上幸甘泉。"
  },
  {
    "id": "s0031",
    "blockIndex": 1,
    "zh": "遣丞相灌嬰發車騎八萬五千，詣高奴擊右賢王；"
  },
  {
    "id": "s0032",
    "blockIndex": 1,
    "zh": "發中尉材官屬衛將軍，軍長安。"
  },
  {
    "id": "s0033",
    "blockIndex": 1,
    "zh": "右賢王走出塞。"
  },
  {
    "id": "s0034",
    "blockIndex": 1,
    "zh": "----7上自甘泉之高奴，因幸太原，見故群臣，皆賜之；"
  },
  {
    "id": "s0035",
    "blockIndex": 1,
    "zh": "復晉陽、中都民三歲租。"
  },
  {
    "id": "s0036",
    "blockIndex": 1,
    "zh": "留游太原十餘日。"
  },
  {
    "id": "s0037",
    "blockIndex": 1,
    "zh": "----8初，大臣之誅諸呂也，朱虛侯功尤大。"
  },
  {
    "id": "s0038",
    "blockIndex": 1,
    "zh": "大臣許盡以趙地王朱虛侯，盡以梁地王東牟侯。"
  },
  {
    "id": "s0039",
    "blockIndex": 1,
    "zh": "及帝立，聞朱虛、東牟之初欲立齊王，故絀其功，及王諸子，乃割齊二郡以王之。"
  },
  {
    "id": "s0040",
    "blockIndex": 1,
    "zh": "興居自以失職奪功，頗怏怏；"
  },
  {
    "id": "s0041",
    "blockIndex": 1,
    "zh": "聞帝幸太原，以為天子且自擊胡，遂發兵反。"
  },
  {
    "id": "s0042",
    "blockIndex": 1,
    "zh": "帝聞之，罷丞相及行兵皆歸長安，以棘浦侯柴武為大將軍，將四將軍、十萬眾擊之；"
  },
  {
    "id": "s0043",
    "blockIndex": 1,
    "zh": "祁侯繒賀為將軍，軍滎陽。"
  },
  {
    "id": "s0044",
    "blockIndex": 1,
    "zh": "秋，七月，上自太原至長安。"
  },
  {
    "id": "s0045",
    "blockIndex": 1,
    "zh": "詔：「濟北吏民，兵未至先自定及以軍城邑降者，皆赦之，復官爵；"
  },
  {
    "id": "s0046",
    "blockIndex": 1,
    "zh": "與王興居去來者，赦之。"
  },
  {
    "id": "s0047",
    "blockIndex": 1,
    "zh": "」八月，濟北王興居兵敗，自殺。"
  },
  {
    "id": "s0048",
    "blockIndex": 1,
    "zh": "----9初，南陽張釋之為騎郎，十年不得調，欲免歸。"
  },
  {
    "id": "s0049",
    "blockIndex": 1,
    "zh": "袁盎知其賢而薦之，為謁者僕射。"
  },
  {
    "id": "s0050",
    "blockIndex": 2,
    "zh": "釋之從行，登虎圈，上問上林尉諸禽獸簿。"
  },
  {
    "id": "s0051",
    "blockIndex": 2,
    "zh": "十餘問，尉左右視，盡不能對。"
  },
  {
    "id": "s0052",
    "blockIndex": 2,
    "zh": "虎圈嗇夫從旁代尉對。"
  },
  {
    "id": "s0053",
    "blockIndex": 2,
    "zh": "上所問禽獸簿甚悉，欲以觀其能；"
  },
  {
    "id": "s0054",
    "blockIndex": 2,
    "zh": "口對響應，無窮者。"
  },
  {
    "id": "s0055",
    "blockIndex": 2,
    "zh": "帝曰：「吏不當若是邪！"
  },
  {
    "id": "s0056",
    "blockIndex": 2,
    "zh": "尉無賴！"
  },
  {
    "id": "s0057",
    "blockIndex": 2,
    "zh": "」乃詔釋之拜嗇夫為上林令。"
  },
  {
    "id": "s0058",
    "blockIndex": 2,
    "zh": "釋之久之前，曰：「陛下以絳侯周勃何如人也？"
  },
  {
    "id": "s0059",
    "blockIndex": 2,
    "zh": "」上曰：「長者也。"
  },
  {
    "id": "s0060",
    "blockIndex": 2,
    "zh": "」又復問：「東陽侯張相如何如人也？"
  },
  {
    "id": "s0061",
    "blockIndex": 2,
    "zh": "」上復曰：「長者。"
  },
  {
    "id": "s0062",
    "blockIndex": 2,
    "zh": "」釋之曰：「夫絳侯、東陽侯稱為長者，此兩人言事曾不能出口，豈效此嗇夫喋喋利口捷給哉！"
  },
  {
    "id": "s0063",
    "blockIndex": 2,
    "zh": "且秦以任刀筆之吏，爭以亟疾苛察相高。"
  },
  {
    "id": "s0064",
    "blockIndex": 2,
    "zh": "其敝，徒文具而無實，不聞其過，陵遲至於土崩。"
  },
  {
    "id": "s0065",
    "blockIndex": 2,
    "zh": "今陛下以嗇夫口辨而超遷之，臣恐天下隨風而靡，爭為口辨而無其實。"
  },
  {
    "id": "s0066",
    "blockIndex": 2,
    "zh": "夫下之化上，疾於景響，舉錯不可不審也。"
  },
  {
    "id": "s0067",
    "blockIndex": 2,
    "zh": "」帝曰：「善！"
  },
  {
    "id": "s0068",
    "blockIndex": 2,
    "zh": "」乃不拜嗇夫。"
  },
  {
    "id": "s0069",
    "blockIndex": 2,
    "zh": "上就車，詔釋之參乘。"
  },
  {
    "id": "s0070",
    "blockIndex": 2,
    "zh": "徐行，問釋之秦之敝，具以質言。"
  },
  {
    "id": "s0071",
    "blockIndex": 2,
    "zh": "至宮，上拜釋之為公車令。"
  },
  {
    "id": "s0072",
    "blockIndex": 3,
    "zh": "頃之，太子與梁王共車入朝，不下司馬門。"
  },
  {
    "id": "s0073",
    "blockIndex": 3,
    "zh": "於是釋之追止太子、梁王，無得入殿門，遂劾「不下公門，不敬」，奏之。"
  },
  {
    "id": "s0074",
    "blockIndex": 3,
    "zh": "薄太后聞之；"
  },
  {
    "id": "s0075",
    "blockIndex": 3,
    "zh": "帝免冠，謝教兒子不謹。"
  },
  {
    "id": "s0076",
    "blockIndex": 3,
    "zh": "薄太后乃使使承詔赦太子、梁王，然後得入。"
  },
  {
    "id": "s0077",
    "blockIndex": 3,
    "zh": "帝由是奇釋之，拜為中大夫；"
  },
  {
    "id": "s0078",
    "blockIndex": 3,
    "zh": "頃之，至中郎將。"
  },
  {
    "id": "s0079",
    "blockIndex": 4,
    "zh": "從行至霸陵，上謂群臣曰：「嗟乎！"
  },
  {
    "id": "s0080",
    "blockIndex": 4,
    "zh": "以北山石為槨，用紵絮昔斮陳漆其間，豈可動哉！"
  },
  {
    "id": "s0081",
    "blockIndex": 4,
    "zh": "」左右皆曰：「善！"
  },
  {
    "id": "s0082",
    "blockIndex": 4,
    "zh": "」釋之曰：「使其中有可欲者，雖錮南山猶有隙；"
  },
  {
    "id": "s0083",
    "blockIndex": 4,
    "zh": "使其中無可欲者，雖無石槨，又何戚焉！"
  },
  {
    "id": "s0084",
    "blockIndex": 4,
    "zh": "」帝稱善。"
  },
  {
    "id": "s0085",
    "blockIndex": 5,
    "zh": "是歲，釋之為廷尉。"
  },
  {
    "id": "s0086",
    "blockIndex": 5,
    "zh": "上行出中渭橋，有一人從橋下走，乘輿馬驚。"
  },
  {
    "id": "s0087",
    "blockIndex": 5,
    "zh": "於是使騎捕之，屬廷尉。"
  },
  {
    "id": "s0088",
    "blockIndex": 5,
    "zh": "釋之奏當：「此人犯蹕，當罰金。"
  },
  {
    "id": "s0089",
    "blockIndex": 5,
    "zh": "」上怒曰：「此人親驚吾馬，馬賴和柔，令它馬，固不敗傷我乎！"
  },
  {
    "id": "s0090",
    "blockIndex": 5,
    "zh": "而廷尉乃當之罰金。"
  },
  {
    "id": "s0091",
    "blockIndex": 5,
    "zh": "」釋之曰：「法者，天下公共也。"
  },
  {
    "id": "s0092",
    "blockIndex": 5,
    "zh": "今法如是，更重之，是法不信於民也。"
  },
  {
    "id": "s0093",
    "blockIndex": 5,
    "zh": "且方其時，上使使誅之則已。"
  },
  {
    "id": "s0094",
    "blockIndex": 5,
    "zh": "今已下廷尉。"
  },
  {
    "id": "s0095",
    "blockIndex": 5,
    "zh": "廷尉，天下之平也，壹傾，天下用法皆為之輕重，民安所錯其手足！"
  },
  {
    "id": "s0096",
    "blockIndex": 5,
    "zh": "唯陛下察之。"
  },
  {
    "id": "s0097",
    "blockIndex": 5,
    "zh": "」上良久曰：「廷尉當是也。"
  },
  {
    "id": "s0099",
    "blockIndex": 6,
    "zh": "其後人有盜高廟坐前玉環，得；"
  },
  {
    "id": "s0100",
    "blockIndex": 6,
    "zh": "帝怒，下廷尉治。"
  },
  {
    "id": "s0101",
    "blockIndex": 6,
    "zh": "釋之按「盜宗廟服御物者」為奏當：棄市。"
  },
  {
    "id": "s0102",
    "blockIndex": 6,
    "zh": "上大怒曰：「人無道，乃盜先帝器！"
  },
  {
    "id": "s0103",
    "blockIndex": 6,
    "zh": "吾屬廷尉者，欲致之族；"
  },
  {
    "id": "s0104",
    "blockIndex": 6,
    "zh": "而君以法奏之，非吾所以共承宗廟意也。"
  },
  {
    "id": "s0105",
    "blockIndex": 6,
    "zh": "」釋之免冠頓首謝曰：「法如是，足也。"
  },
  {
    "id": "s0106",
    "blockIndex": 6,
    "zh": "且罪等，然以逆順為差。"
  },
  {
    "id": "s0107",
    "blockIndex": 6,
    "zh": "今盜宗廟器而族之，有如萬分一，假令愚民取長陵一抔土，陛下且何以加其法乎？"
  },
  {
    "id": "s0108",
    "blockIndex": 6,
    "zh": "」帝乃白太后許之。"
  },
  {
    "id": "s0110",
    "blockIndex": 7,
    "zh": "1冬，十二月，穎陰懿侯灌嬰薨。"
  },
  {
    "id": "s0111",
    "blockIndex": 7,
    "zh": "----2春，正月，甲午，以御史大夫陽武張蒼為丞相。"
  },
  {
    "id": "s0112",
    "blockIndex": 7,
    "zh": "蒼好書，博聞，尤邃律曆。"
  },
  {
    "id": "s0113",
    "blockIndex": 7,
    "zh": "----3上召河東守季布，欲以為御史大夫。"
  },
  {
    "id": "s0114",
    "blockIndex": 7,
    "zh": "有言其勇、使酒、難近者；"
  },
  {
    "id": "s0115",
    "blockIndex": 7,
    "zh": "至，留邸一月，見罷。"
  },
  {
    "id": "s0116",
    "blockIndex": 7,
    "zh": "季布因進曰：「臣無功竊寵，待罪河東，陛下無故召臣，此人必有以臣欺陛下者。"
  },
  {
    "id": "s0117",
    "blockIndex": 7,
    "zh": "今臣至，無所受事，罷去，此人必有毀臣者。"
  },
  {
    "id": "s0118",
    "blockIndex": 7,
    "zh": "夫陛下以一人之譽而召臣，以一人之毀而去臣，臣恐天下有識聞之，有以窺陛下之淺深也！"
  },
  {
    "id": "s0119",
    "blockIndex": 7,
    "zh": "」上默然，慚，良久曰：「河東，吾股肱郡，故特召君耳。"
  },
  {
    "id": "s0120",
    "blockIndex": 7,
    "zh": "」----4上議以賈誼任公卿之位。"
  },
  {
    "id": "s0121",
    "blockIndex": 7,
    "zh": "大臣多短之曰：「洛陽之人，年少初學，專欲擅權，紛亂諸事。"
  },
  {
    "id": "s0122",
    "blockIndex": 7,
    "zh": "」於是天子後亦疏之，不用其議，以為長沙王太傅。"
  },
  {
    "id": "s0123",
    "blockIndex": 7,
    "zh": "----5絳侯周勃既就國，每河東守、尉行縣至絳，勃自畏恐誅，常被甲，令家人持兵以見之。"
  },
  {
    "id": "s0124",
    "blockIndex": 7,
    "zh": "其後人有上書告勃欲反，下廷尉。"
  },
  {
    "id": "s0125",
    "blockIndex": 7,
    "zh": "廷尉逮捕勃，治之。"
  },
  {
    "id": "s0126",
    "blockIndex": 7,
    "zh": "勃恐，不知置辭。"
  },
  {
    "id": "s0127",
    "blockIndex": 7,
    "zh": "吏稍侵辱之，勃以千金與獄吏，獄吏乃書牘背示之曰：「以公主為證。"
  },
  {
    "id": "s0128",
    "blockIndex": 7,
    "zh": "」公主者，帝女也，勃太子勝之尚之。"
  },
  {
    "id": "s0129",
    "blockIndex": 7,
    "zh": "薄太后亦以為勃無反事。"
  },
  {
    "id": "s0130",
    "blockIndex": 7,
    "zh": "帝朝太后，太后以冒絮提帝曰：「絳侯始誅諸呂，綰皇帝璽，將兵於北軍，不以此時反，今居一小縣，顧欲反邪？"
  },
  {
    "id": "s0131",
    "blockIndex": 7,
    "zh": "」帝既見絳侯獄辭，乃謝曰：「吏方驗而出之。"
  },
  {
    "id": "s0132",
    "blockIndex": 7,
    "zh": "」於是使使持節赦絳侯，復爵邑。"
  },
  {
    "id": "s0133",
    "blockIndex": 7,
    "zh": "絳侯既出，曰：「吾嘗將百萬軍，然安知獄吏之貴乎！"
  },
  {
    "id": "s0134",
    "blockIndex": 7,
    "zh": "」----6作顧成廟。"
  },
  {
    "id": "s0135",
    "blockIndex": 7,
    "zh": "----1春，二月，地震。"
  },
  {
    "id": "s0136",
    "blockIndex": 7,
    "zh": "----2初，秦用半兩錢，高祖嫌其重，難用，更鑄莢錢。"
  },
  {
    "id": "s0137",
    "blockIndex": 7,
    "zh": "於是物價騰踴，米至石萬錢。"
  },
  {
    "id": "s0138",
    "blockIndex": 7,
    "zh": "夏，四月，更造四銖錢，除盜鑄錢令，使民得自鑄。"
  },
  {
    "id": "s0139",
    "blockIndex": 8,
    "zh": "賈誼諫曰：「法使天下公得雇租鑄銅、錫為錢，敢雜以鉛、鐵為它巧者，其罪黥。"
  },
  {
    "id": "s0140",
    "blockIndex": 8,
    "zh": "然鑄錢之情，非殽雜為巧，則不可得贏；"
  },
  {
    "id": "s0141",
    "blockIndex": 8,
    "zh": "而殽之甚微，為利其厚。"
  },
  {
    "id": "s0142",
    "blockIndex": 8,
    "zh": "夫事有召禍而法有起奸；"
  },
  {
    "id": "s0143",
    "blockIndex": 8,
    "zh": "今令細民人操造幣之勢，各隱屏而鑄作，因欲禁其厚利微奸，雖黥罪日報，其勢不止。"
  },
  {
    "id": "s0144",
    "blockIndex": 8,
    "zh": "乃者，民人抵罪多者一縣百數，及吏之所疑搒笞奔走者甚眾。"
  },
  {
    "id": "s0145",
    "blockIndex": 8,
    "zh": "夫縣法以誘民，使入隱阱，孰多於此！"
  },
  {
    "id": "s0146",
    "blockIndex": 8,
    "zh": "又民用錢，郡縣不同：或用輕錢，百加若干；"
  },
  {
    "id": "s0147",
    "blockIndex": 8,
    "zh": "或用重錢，平稱不受。"
  },
  {
    "id": "s0148",
    "blockIndex": 8,
    "zh": "法錢不立，吏急而壹之乎？"
  },
  {
    "id": "s0149",
    "blockIndex": 8,
    "zh": "則大為煩苛而力不能勝；"
  },
  {
    "id": "s0150",
    "blockIndex": 8,
    "zh": "縱而弗呵乎？"
  },
  {
    "id": "s0151",
    "blockIndex": 8,
    "zh": "則市肆異用，錢文大亂；"
  },
  {
    "id": "s0152",
    "blockIndex": 8,
    "zh": "苟非其術，何鄉而可哉！"
  },
  {
    "id": "s0153",
    "blockIndex": 8,
    "zh": "今農事棄捐而采銅者日蕃，釋其耒耨，冶熔炊炭；"
  },
  {
    "id": "s0154",
    "blockIndex": 8,
    "zh": "奸錢日多，五穀不為多。"
  },
  {
    "id": "s0155",
    "blockIndex": 8,
    "zh": "善人怵而為奸邪，願民陷而之刑戮；"
  },
  {
    "id": "s0156",
    "blockIndex": 8,
    "zh": "刑戮將甚不詳，奈何而忽！"
  },
  {
    "id": "s0157",
    "blockIndex": 8,
    "zh": "國知患此，吏議必曰『禁之』。"
  },
  {
    "id": "s0158",
    "blockIndex": 8,
    "zh": "禁之不得其術，其傷必大。"
  },
  {
    "id": "s0159",
    "blockIndex": 8,
    "zh": "令禁鑄錢，則錢必重；"
  },
  {
    "id": "s0160",
    "blockIndex": 8,
    "zh": "重則其利深，盜鑄如雲而起，棄市之罪又不足以禁矣。"
  },
  {
    "id": "s0161",
    "blockIndex": 8,
    "zh": "奸數不勝而法禁數潰，銅使之然也。"
  },
  {
    "id": "s0162",
    "blockIndex": 8,
    "zh": "銅佈於天下，其為禍博矣，故不如收之。"
  },
  {
    "id": "s0163",
    "blockIndex": 8,
    "zh": "」賈山亦上書諫，以為：「錢者，亡用器也，而可以易富貴。"
  },
  {
    "id": "s0164",
    "blockIndex": 8,
    "zh": "富貴者，人主之操柄也；"
  },
  {
    "id": "s0165",
    "blockIndex": 8,
    "zh": "令民為之，是與人主共操柄，不可長也。"
  },
  {
    "id": "s0166",
    "blockIndex": 8,
    "zh": "」上不聽。"
  },
  {
    "id": "s0167",
    "blockIndex": 9,
    "zh": "是時，太中大夫鄧通方寵幸，上欲其富，賜之蜀嚴道銅山，使鑄錢。"
  },
  {
    "id": "s0168",
    "blockIndex": 9,
    "zh": "吳王濞有豫章銅山，招致天下亡命者以鑄錢；"
  },
  {
    "id": "s0169",
    "blockIndex": 9,
    "zh": "東煮海水為鹽；"
  },
  {
    "id": "s0170",
    "blockIndex": 9,
    "zh": "以故無賦而國用饒足。"
  },
  {
    "id": "s0171",
    "blockIndex": 9,
    "zh": "於是吳、鄧錢布天下。"
  },
  {
    "id": "s0172",
    "blockIndex": 9,
    "zh": "----3初，帝分代為二國，立皇子武為代王，參為太原王。"
  },
  {
    "id": "s0173",
    "blockIndex": 9,
    "zh": "是歲，徙代王武為淮陽王；"
  },
  {
    "id": "s0174",
    "blockIndex": 9,
    "zh": "以太原王參為代王，盡得故地。"
  },
  {
    "id": "s0175",
    "blockIndex": 9,
    "zh": "----1冬，十月，桃、李華。"
  },
  {
    "id": "s0176",
    "blockIndex": 9,
    "zh": "----2淮南厲王長自作法令行於其國，逐漢所置吏，請自置相、二千石；"
  },
  {
    "id": "s0177",
    "blockIndex": 9,
    "zh": "帝曲意從之。"
  },
  {
    "id": "s0178",
    "blockIndex": 9,
    "zh": "又擅刑殺不辜及爵人至關內侯；"
  },
  {
    "id": "s0179",
    "blockIndex": 9,
    "zh": "數上書不遜順。"
  },
  {
    "id": "s0180",
    "blockIndex": 9,
    "zh": "帝重自切責之，乃令薄昭與書風諭之，引管、蔡及代頃王、濟北王興居以為儆戒。"
  },
  {
    "id": "s0181",
    "blockIndex": 10,
    "zh": "王不說，令大夫但、士伍開章等七十人與棘蒲侯柴武太子奇謀以輦車四十乘反谷口；"
  },
  {
    "id": "s0182",
    "blockIndex": 10,
    "zh": "令人使閩越、匈奴。"
  },
  {
    "id": "s0183",
    "blockIndex": 10,
    "zh": "事覺，有司治之。"
  },
  {
    "id": "s0184",
    "blockIndex": 10,
    "zh": "使使召淮南王。"
  },
  {
    "id": "s0185",
    "blockIndex": 10,
    "zh": "王至長安，丞相張蒼、典客馮敬行御史大夫事，與宗正、廷尉奏：「長罪當棄市。"
  },
  {
    "id": "s0186",
    "blockIndex": 10,
    "zh": "」制曰：「其赦長死罪，廢，勿王；"
  },
  {
    "id": "s0187",
    "blockIndex": 10,
    "zh": "徙處蜀郡嚴道邛郵。"
  },
  {
    "id": "s0188",
    "blockIndex": 10,
    "zh": "」盡誅所與謀者。"
  },
  {
    "id": "s0189",
    "blockIndex": 10,
    "zh": "載長以輜車，令縣以次傳之。"
  },
  {
    "id": "s0190",
    "blockIndex": 11,
    "zh": "袁盎諫曰：「上素驕淮南王，弗為置嚴傅、相，以故至此。"
  },
  {
    "id": "s0191",
    "blockIndex": 11,
    "zh": "淮南王為人剛，今暴摧折之，臣恐卒逢霧露病死，陛下有殺弟之名，奈何？"
  },
  {
    "id": "s0192",
    "blockIndex": 11,
    "zh": "」上曰：「吾特苦之耳，今復之。"
  },
  {
    "id": "s0194",
    "blockIndex": 12,
    "zh": "淮南王果憤恚不食死。"
  },
  {
    "id": "s0195",
    "blockIndex": 12,
    "zh": "縣傳至雍，雍令發封，以死聞。"
  },
  {
    "id": "s0196",
    "blockIndex": 12,
    "zh": "上哭甚悲，謂袁盎曰：「吾不聽公言，卒亡淮南王！"
  },
  {
    "id": "s0197",
    "blockIndex": 12,
    "zh": "今為奈何？"
  },
  {
    "id": "s0198",
    "blockIndex": 12,
    "zh": "」盎曰：「獨斬丞相、御史以謝天下乃可。"
  },
  {
    "id": "s0199",
    "blockIndex": 12,
    "zh": "」上即令丞相、御史逮考諸縣傳送淮南王不發封饋侍者，皆棄市；"
  },
  {
    "id": "s0200",
    "blockIndex": 12,
    "zh": "以列侯葬淮南王於雍，置守塚三十戶。"
  },
  {
    "id": "s0201",
    "blockIndex": 12,
    "zh": "----3匈奴單于遣漢書曰：「前時，皇帝言和親事，稱書意，合歡。"
  },
  {
    "id": "s0202",
    "blockIndex": 12,
    "zh": "漢邊吏侵侮右賢王；"
  },
  {
    "id": "s0203",
    "blockIndex": 12,
    "zh": "右賢王不請，聽後義盧侯難支等計，與漢吏相距。"
  },
  {
    "id": "s0204",
    "blockIndex": 12,
    "zh": "絕二主之約，離兄弟之親，故罰右賢王，使之西求月氏擊之。"
  },
  {
    "id": "s0205",
    "blockIndex": 12,
    "zh": "以天之福，吏卒良，馬力強，以夷滅月氏，盡斬殺、降下，定之；"
  },
  {
    "id": "s0206",
    "blockIndex": 12,
    "zh": "樓蘭、烏孫、呼揭及其旁二十六國，皆已為匈奴，諸引弓之民並為一家，北州以定。"
  },
  {
    "id": "s0207",
    "blockIndex": 12,
    "zh": "願寢兵，休士卒，養馬，除前事，復故約，以安邊民。"
  },
  {
    "id": "s0208",
    "blockIndex": 12,
    "zh": "皇帝即不欲匈奴近塞，則且詔吏民遠舍。"
  },
  {
    "id": "s0209",
    "blockIndex": 12,
    "zh": "」帝報書曰：「單于欲除前事，復故約，朕甚嘉之。"
  },
  {
    "id": "s0210",
    "blockIndex": 12,
    "zh": "此古聖王之志也。"
  },
  {
    "id": "s0211",
    "blockIndex": 12,
    "zh": "漢與匈奴約為兄弟，所以遺單于甚厚；"
  },
  {
    "id": "s0212",
    "blockIndex": 12,
    "zh": "倍約、離兄弟之親者，常在匈奴。"
  },
  {
    "id": "s0213",
    "blockIndex": 12,
    "zh": "然右賢王事已在赦前，單于勿深誅！"
  },
  {
    "id": "s0214",
    "blockIndex": 12,
    "zh": "單于若稱書意，明告諸吏，使無負約，有信，敬如單于書。"
  },
  {
    "id": "s0216",
    "blockIndex": 13,
    "zh": "後頃之，冒頓死，子稽粥立，號曰老上單于。"
  },
  {
    "id": "s0217",
    "blockIndex": 13,
    "zh": "老上單于初立，帝復遣宗室女翁主為單于閼氏，使宦者燕人中行說傅翁主。"
  },
  {
    "id": "s0218",
    "blockIndex": 13,
    "zh": "說不欲行，漢強使之。"
  },
  {
    "id": "s0219",
    "blockIndex": 13,
    "zh": "說曰：「必我也，為漢患者！"
  },
  {
    "id": "s0220",
    "blockIndex": 13,
    "zh": "」中行說既至，因降單于，單于甚親幸之。"
  },
  {
    "id": "s0221",
    "blockIndex": 14,
    "zh": "初，匈奴好漢繒絮、食物。"
  },
  {
    "id": "s0222",
    "blockIndex": 14,
    "zh": "中行說曰：「匈奴人眾不能當漢之一郡，然所以強者，以衣食異，無仰於漢也。"
  },
  {
    "id": "s0223",
    "blockIndex": 14,
    "zh": "今單于變俗，好漢物；"
  },
  {
    "id": "s0224",
    "blockIndex": 14,
    "zh": "漢物不過什二，則匈奴盡歸於漢矣。"
  },
  {
    "id": "s0225",
    "blockIndex": 14,
    "zh": "」其得漢繒絮，以馳草棘中，衣胯皆裂敝，以示不如旃裘之完善也；"
  },
  {
    "id": "s0226",
    "blockIndex": 14,
    "zh": "得漢食物，皆去之，以示不如湩酪之便美也。"
  },
  {
    "id": "s0227",
    "blockIndex": 14,
    "zh": "於是說教單于左右疏記，以計課其人眾、畜牧。"
  },
  {
    "id": "s0228",
    "blockIndex": 14,
    "zh": "其遺漢書牘及印封，皆令長大，倨傲其辭，自稱「天地所生、日月所置匈奴大單于」。"
  },
  {
    "id": "s0229",
    "blockIndex": 15,
    "zh": "漢使或訾笑匈奴俗無禮義者，中行說輒窮漢使曰：「匈奴約束徑，易行；"
  },
  {
    "id": "s0230",
    "blockIndex": 15,
    "zh": "君臣簡，可久；"
  },
  {
    "id": "s0231",
    "blockIndex": 15,
    "zh": "一國之政，猶一體也。"
  },
  {
    "id": "s0232",
    "blockIndex": 15,
    "zh": "故匈奴雖亂，必立宗種。"
  },
  {
    "id": "s0233",
    "blockIndex": 15,
    "zh": "今中國雖-{云}-有禮義，及親屬益疏則相殺奪，以至易姓，皆從此類也。"
  },
  {
    "id": "s0234",
    "blockIndex": 15,
    "zh": "嗟！"
  },
  {
    "id": "s0235",
    "blockIndex": 15,
    "zh": "土室之人，顧無多辭，喋喋占占！"
  },
  {
    "id": "s0236",
    "blockIndex": 15,
    "zh": "顧漢所輸匈奴繒絮、米薛，令其量中，必善美而已矣，何以言為乎！"
  },
  {
    "id": "s0237",
    "blockIndex": 15,
    "zh": "且所給，備、善，則已；"
  },
  {
    "id": "s0238",
    "blockIndex": 15,
    "zh": "不備、苦惡，則候秋熟，以騎馳蹂而稼穡耳！"
  },
  {
    "id": "s0239",
    "blockIndex": 15,
    "zh": "」----4梁太傅賈誼上疏曰："
  },
  {
    "id": "s0240",
    "blockIndex": 16,
    "zh": ":「臣竊惟今之事勢，可為痛哭者一，可為流涕者二，可為長太息者六；"
  },
  {
    "id": "s0241",
    "blockIndex": 16,
    "zh": "若其它背理而傷道者，難遍以疏舉。"
  },
  {
    "id": "s0242",
    "blockIndex": 16,
    "zh": "進言者皆曰：『天下已安已治矣，』臣獨以為未也。"
  },
  {
    "id": "s0243",
    "blockIndex": 16,
    "zh": "曰安且治者，非愚則諛，皆非事實知治亂之體者也。"
  },
  {
    "id": "s0244",
    "blockIndex": 16,
    "zh": "夫抱火厝之積薪之下而寢其上，火未及然，因謂之安；"
  },
  {
    "id": "s0245",
    "blockIndex": 16,
    "zh": "方今之勢，何以異此！"
  },
  {
    "id": "s0246",
    "blockIndex": 16,
    "zh": "陛下何不壹令臣得孰數之於前，因陳治安之策，試詳擇焉！"
  },
  {
    "id": "s0247",
    "blockIndex": 17,
    "zh": ":使為治，勞智慮，苦身體，乏鐘、鼓之樂，勿為可也。"
  },
  {
    "id": "s0248",
    "blockIndex": 17,
    "zh": "樂與今同，而加之諸侯軌道，兵革不動，匈奴賓服，百姓素樸，生為明帝，沒為明神，名譽之美垂於無窮，使顧成之廟稱為太宗，上配太祖，與漢亡極，立經陳紀，為萬世法。"
  },
  {
    "id": "s0249",
    "blockIndex": 17,
    "zh": "雖有愚幼、不肖之嗣，猶得蒙業而安。"
  },
  {
    "id": "s0250",
    "blockIndex": 17,
    "zh": "以陛下之明達，因使少知治體者得佐下風，致此非難也。"
  },
  {
    "id": "s0251",
    "blockIndex": 18,
    "zh": ":夫樹國固必相疑之勢，下數被其殃，上數爽其憂，甚非所以安上而全下也。"
  },
  {
    "id": "s0252",
    "blockIndex": 18,
    "zh": "今或親弟謀為東帝，親兄之子西鄉而擊，今吳又見告矣。"
  },
  {
    "id": "s0253",
    "blockIndex": 18,
    "zh": "天子春秋鼎盛，行義未過，德澤有加焉，猶尚如是；"
  },
  {
    "id": "s0254",
    "blockIndex": 18,
    "zh": "況莫大諸侯，權力且十此者虖！"
  },
  {
    "id": "s0255",
    "blockIndex": 19,
    "zh": ":然而天下少安，何也？"
  },
  {
    "id": "s0256",
    "blockIndex": 19,
    "zh": "大國之王幼弱未壯，漢之所置傅、相方握其事。"
  },
  {
    "id": "s0257",
    "blockIndex": 19,
    "zh": "數年之後，諸侯之王大抵皆冠，血氣方剛；"
  },
  {
    "id": "s0258",
    "blockIndex": 19,
    "zh": "漢之傅、相稱病而賜罷，彼自丞、尉以上遍置私人。"
  },
  {
    "id": "s0259",
    "blockIndex": 19,
    "zh": "如此，有異淮南、濟北之為邪？"
  },
  {
    "id": "s0260",
    "blockIndex": 19,
    "zh": "此時而欲為治安，雖堯、舜不治。"
  },
  {
    "id": "s0261",
    "blockIndex": 20,
    "zh": ":黃帝曰：『日中必熭，操刀必割！"
  },
  {
    "id": "s0262",
    "blockIndex": 20,
    "zh": "』今令此道順而全安甚易，不肯蚤為，已乃墮骨肉之屬而抗剄之，豈有異秦之季世虖！"
  },
  {
    "id": "s0263",
    "blockIndex": 20,
    "zh": "其異姓負強而動者，漢已幸而勝之矣，又不易其所以然；"
  },
  {
    "id": "s0264",
    "blockIndex": 20,
    "zh": "同姓襲是跡而動，既有征矣，其勢盡又復然。"
  },
  {
    "id": "s0265",
    "blockIndex": 20,
    "zh": "殃禍之變，未知所移，明帝處之尚不能以安，後世將如之何！"
  },
  {
    "id": "s0266",
    "blockIndex": 21,
    "zh": ":臣竊跡前事，大抵強者先反。"
  },
  {
    "id": "s0267",
    "blockIndex": 21,
    "zh": "長沙乃二萬五千戶耳，功少而最完，勢疏而最忠，非獨性異人也，亦形勢然也。"
  },
  {
    "id": "s0268",
    "blockIndex": 21,
    "zh": "曩令樊、酈、絳、灌據數十城而王，今雖以殘亡可也；"
  },
  {
    "id": "s0269",
    "blockIndex": 21,
    "zh": "令信、越之倫列為徹侯而居，雖至今存可也。"
  },
  {
    "id": "s0270",
    "blockIndex": 21,
    "zh": "然則天下之大計可知已：欲諸王之皆忠附，則莫若令如長沙王；"
  },
  {
    "id": "s0271",
    "blockIndex": 21,
    "zh": "欲臣子勿菹醢，則莫若令如樊、酈等；"
  },
  {
    "id": "s0272",
    "blockIndex": 21,
    "zh": "欲天下之治安，莫若眾建諸侯而少其力。"
  },
  {
    "id": "s0273",
    "blockIndex": 21,
    "zh": "力少則易使以義，國小則亡邪心。"
  },
  {
    "id": "s0274",
    "blockIndex": 21,
    "zh": "令海內之勢，如身之使臂，臂之使指，莫不制從，諸侯之君不敢有異心，輻湊並進而歸命天子。"
  },
  {
    "id": "s0275",
    "blockIndex": 21,
    "zh": "割地定製，令齊、趙、楚各為若干國，使悼惠王、幽王、元王之子孫畢以次各受祖之分地，地盡而止；"
  },
  {
    "id": "s0276",
    "blockIndex": 21,
    "zh": "其分地眾而子孫少者，建以為國，空而置之，須其子孫生者舉使君之；"
  },
  {
    "id": "s0277",
    "blockIndex": 21,
    "zh": "一寸之地，一人之眾，天子亡所利焉，誠以定治而已。"
  },
  {
    "id": "s0278",
    "blockIndex": 21,
    "zh": "如此，則臥赤子天下之上而安，植遺腹，朝委裘而天下不亂；"
  },
  {
    "id": "s0279",
    "blockIndex": 21,
    "zh": "當時大治，後世誦聖。"
  },
  {
    "id": "s0280",
    "blockIndex": 21,
    "zh": "陛下誰憚而久不為此！"
  },
  {
    "id": "s0281",
    "blockIndex": 22,
    "zh": ":天下之勢方病大瘇，一脛之大幾如要，一指之大幾如股，平居不可屈伸，一二指慉，身慮亡聊。"
  },
  {
    "id": "s0282",
    "blockIndex": 22,
    "zh": "失今不治，必為錮疾，後雖有扁鵲，不能為已。"
  },
  {
    "id": "s0283",
    "blockIndex": 22,
    "zh": "病非徒腫也。"
  },
  {
    "id": "s0284",
    "blockIndex": 22,
    "zh": "又苦蹠盭。"
  },
  {
    "id": "s0285",
    "blockIndex": 22,
    "zh": "元王之子，帝之從弟也；"
  },
  {
    "id": "s0286",
    "blockIndex": 22,
    "zh": "今之王者，從弟之子也。"
  },
  {
    "id": "s0287",
    "blockIndex": 22,
    "zh": "惠王之子，親兄子也，今之王者，兄子之子也。"
  },
  {
    "id": "s0288",
    "blockIndex": 22,
    "zh": "親者或亡分地以安天下，疏者或制大權以逼天子，臣故曰非徒病腫也，又苦蹠炙盭。"
  },
  {
    "id": "s0289",
    "blockIndex": 22,
    "zh": "可痛哭者，此病是也。"
  },
  {
    "id": "s0290",
    "blockIndex": 23,
    "zh": ":天下之勢方倒懸。"
  },
  {
    "id": "s0291",
    "blockIndex": 23,
    "zh": "凡天子者，天下之首。"
  },
  {
    "id": "s0292",
    "blockIndex": 23,
    "zh": "何也？"
  },
  {
    "id": "s0293",
    "blockIndex": 23,
    "zh": "上也。"
  },
  {
    "id": "s0294",
    "blockIndex": 23,
    "zh": "蠻夷者，天下之足。"
  },
  {
    "id": "s0295",
    "blockIndex": 23,
    "zh": "何也？"
  },
  {
    "id": "s0296",
    "blockIndex": 23,
    "zh": "下也。"
  },
  {
    "id": "s0297",
    "blockIndex": 23,
    "zh": "今匈奴嫚侮侵掠，至不敬也；"
  },
  {
    "id": "s0298",
    "blockIndex": 23,
    "zh": "而漢歲致金絮采繒以奉之。"
  },
  {
    "id": "s0299",
    "blockIndex": 23,
    "zh": "足反居上，首顧居下，倒縣如此，莫之能解，猶為國有人乎？"
  },
  {
    "id": "s0300",
    "blockIndex": 23,
    "zh": "可為流涕者此也。"
  },
  {
    "id": "s0301",
    "blockIndex": 24,
    "zh": ":今不獵猛敵而獵田彘，不搏反寇而搏畜菟，翫玩細娛而不圖大患，德可遠加而直數百里外，威令不伸，可為流涕者此也。"
  },
  {
    "id": "s0302",
    "blockIndex": 25,
    "zh": ":今庶人屋壁得為帝服，倡優下賤得為-{后}-飾；"
  },
  {
    "id": "s0303",
    "blockIndex": 25,
    "zh": "且帝之身自衣皁綈，而富民牆屋被文繡；"
  },
  {
    "id": "s0304",
    "blockIndex": 25,
    "zh": "天子之-{后}-以緣其領，庶人孽妾以緣其履；"
  },
  {
    "id": "s0305",
    "blockIndex": 25,
    "zh": "此臣所謂舛也。"
  },
  {
    "id": "s0306",
    "blockIndex": 25,
    "zh": "夫百人作之不能衣一人，欲天下亡寒，胡可得也；"
  },
  {
    "id": "s0307",
    "blockIndex": 25,
    "zh": "一人耕之，十人聚而食之，欲天下亡饑，不可得也；"
  },
  {
    "id": "s0308",
    "blockIndex": 25,
    "zh": "饑寒切於民之肌膚，欲其亡為奸邪，不可得也。"
  },
  {
    "id": "s0309",
    "blockIndex": 25,
    "zh": "可為長太息者此也。"
  },
  {
    "id": "s0310",
    "blockIndex": 26,
    "zh": ":商君遺禮義，棄仁恩，並心於進取；"
  },
  {
    "id": "s0311",
    "blockIndex": 26,
    "zh": "行之二歲，秦俗日敗。"
  },
  {
    "id": "s0312",
    "blockIndex": 26,
    "zh": "故秦人家富子壯則出分，家貧子壯則出贅；"
  },
  {
    "id": "s0313",
    "blockIndex": 26,
    "zh": "借父櫌鉏，慮有德色；"
  },
  {
    "id": "s0314",
    "blockIndex": 26,
    "zh": "母取箕帚，立而誶語；"
  },
  {
    "id": "s0315",
    "blockIndex": 26,
    "zh": "抱哺其子，與公並居；"
  },
  {
    "id": "s0316",
    "blockIndex": 26,
    "zh": "婦姑不相說，則反脣而相稽；"
  },
  {
    "id": "s0317",
    "blockIndex": 26,
    "zh": "其慈子、耆利，不同禽獸者亡幾耳。"
  },
  {
    "id": "s0318",
    "blockIndex": 26,
    "zh": "今其遺見餘俗，猶尚未改，棄禮誼，捐廉恥日甚，可謂月異而歲不同矣。"
  },
  {
    "id": "s0319",
    "blockIndex": 26,
    "zh": "逐利不耳，慮非顧行也；"
  },
  {
    "id": "s0320",
    "blockIndex": 26,
    "zh": "今其甚者殺父兄矣。"
  },
  {
    "id": "s0321",
    "blockIndex": 26,
    "zh": "而大臣特以簿書不報、期會之間以為大故，至於俗流失，世壞敗，因恬而不知怪，慮不動於耳目，以為是適然耳。"
  },
  {
    "id": "s0322",
    "blockIndex": 26,
    "zh": "夫移風易俗，使天下回心而鄉道，類非俗吏之所能為也。"
  },
  {
    "id": "s0323",
    "blockIndex": 26,
    "zh": "俗吏之所務，在於刀筆、筐篋而不知大體。"
  },
  {
    "id": "s0324",
    "blockIndex": 26,
    "zh": "陛下又不自憂，竊為陛下惜之！"
  },
  {
    "id": "s0325",
    "blockIndex": 26,
    "zh": "豈如今定經制，令君君、臣臣，上下有差，父子六親各得其宜。"
  },
  {
    "id": "s0326",
    "blockIndex": 26,
    "zh": "此業壹定，世世常安，而後有所持循矣；"
  },
  {
    "id": "s0327",
    "blockIndex": 26,
    "zh": "若夫經制不定，是猶渡江河亡維楫，中流而遇風波，船必覆矣。"
  },
  {
    "id": "s0328",
    "blockIndex": 26,
    "zh": "可為長太息者此也。"
  },
  {
    "id": "s0329",
    "blockIndex": 27,
    "zh": ":夏、殷、周為天子皆數十世，秦為天子二世而亡。"
  },
  {
    "id": "s0330",
    "blockIndex": 27,
    "zh": "人性不甚相遠也，何三代之君有道之長而秦無道之暴也？"
  },
  {
    "id": "s0331",
    "blockIndex": 27,
    "zh": "其故可知也。"
  },
  {
    "id": "s0332",
    "blockIndex": 27,
    "zh": "古之王者，太子乃生，固舉以禮，有司齊肅端冕，見之南郊，過闕則下，過廟則趨，故自為赤子，而教固已行矣。"
  },
  {
    "id": "s0333",
    "blockIndex": 27,
    "zh": "孩提有識，三公、三少明孝仁禮義以道習之，逐去邪人，不使見惡行，於是皆選天下之端士、孝悌博聞有道術者以衛翼之，使與太子居處出入。"
  },
  {
    "id": "s0334",
    "blockIndex": 27,
    "zh": "故太子乃生而見正事，聞正言，行正道，左右前後皆正人也。"
  },
  {
    "id": "s0335",
    "blockIndex": 27,
    "zh": "夫習與正人居之不能毋正，猶生長於齊不能不齊言也；"
  },
  {
    "id": "s0336",
    "blockIndex": 27,
    "zh": "習與不正人居之不能毋不正，猶生長於楚之地不能不楚言也。"
  },
  {
    "id": "s0337",
    "blockIndex": 27,
    "zh": "孔子曰：『少成若天性，習貫如自然。"
  },
  {
    "id": "s0338",
    "blockIndex": 27,
    "zh": "』習與智長，故切而不愧；"
  },
  {
    "id": "s0339",
    "blockIndex": 27,
    "zh": "化與心成，故中道若性。"
  },
  {
    "id": "s0340",
    "blockIndex": 27,
    "zh": "夫三代之所以長久者，以其輔翼太子有此具也。"
  },
  {
    "id": "s0341",
    "blockIndex": 27,
    "zh": "及秦而不然，使趙高傅胡亥而教之獄，所習者非斬、劓人，則夷人之三族也。"
  },
  {
    "id": "s0342",
    "blockIndex": 27,
    "zh": "胡亥今日即位而明日射人，忠諫者謂之誹謗，深計者謂之妖言，其視殺人若艾草菅然。"
  },
  {
    "id": "s0343",
    "blockIndex": 27,
    "zh": "豈惟胡亥之性惡哉？"
  },
  {
    "id": "s0344",
    "blockIndex": 27,
    "zh": "彼其所以道之者非其理故也。"
  },
  {
    "id": "s0345",
    "blockIndex": 27,
    "zh": "鄙諺曰：『前車覆，後車誡。"
  },
  {
    "id": "s0346",
    "blockIndex": 27,
    "zh": "』秦世之所以亟絕者，其轍跡可見也；"
  },
  {
    "id": "s0347",
    "blockIndex": 27,
    "zh": "然而不避，是後車又將覆也。"
  },
  {
    "id": "s0348",
    "blockIndex": 27,
    "zh": "天下之命，縣於太子，太子之善，在於早諭教與選左右。"
  },
  {
    "id": "s0349",
    "blockIndex": 27,
    "zh": "夫心未濫而先諭都，則化易成也；"
  },
  {
    "id": "s0350",
    "blockIndex": 27,
    "zh": "開於道術智誼之指，則教之力也；"
  },
  {
    "id": "s0351",
    "blockIndex": 27,
    "zh": "若其服習積貫，則左右而已。"
  },
  {
    "id": "s0352",
    "blockIndex": 27,
    "zh": "夫胡、粵之人，生而同聲，嗜欲不異；"
  },
  {
    "id": "s0353",
    "blockIndex": 27,
    "zh": "及其長而成俗，累數譯而不能相通，有雖死而不相為者，則教習然也。"
  },
  {
    "id": "s0354",
    "blockIndex": 27,
    "zh": "臣故曰選左右、早諭教最急。"
  },
  {
    "id": "s0355",
    "blockIndex": 27,
    "zh": "夫教得而左右正，則太子正矣，太子正而天下定矣。"
  },
  {
    "id": "s0356",
    "blockIndex": 27,
    "zh": "《書》曰：『一人有慶，兆民賴之。"
  },
  {
    "id": "s0357",
    "blockIndex": 27,
    "zh": "』此時務也。"
  },
  {
    "id": "s0358",
    "blockIndex": 28,
    "zh": ":凡人之智，能見已然，不能見將然。"
  },
  {
    "id": "s0359",
    "blockIndex": 28,
    "zh": "夫禮者禁於將然之前，而法者禁於已然之後，是故法之所為用易見而禮之所為生難知也。"
  },
  {
    "id": "s0360",
    "blockIndex": 28,
    "zh": "若夫慶賞以勸善，刑罰以懲惡，先王執此之政，堅如金石；"
  },
  {
    "id": "s0361",
    "blockIndex": 28,
    "zh": "行此之令，信如四時；"
  },
  {
    "id": "s0362",
    "blockIndex": 28,
    "zh": "據此之公，無私如天地，豈顧不用哉？"
  },
  {
    "id": "s0363",
    "blockIndex": 28,
    "zh": "然而曰禮雲、禮雲者，貴絕惡於未萌而起教於微眇，使民日遷善、遠罪而不自知也。"
  },
  {
    "id": "s0364",
    "blockIndex": 28,
    "zh": "孔子曰：『聽訟，吾猶人也；"
  },
  {
    "id": "s0365",
    "blockIndex": 28,
    "zh": "必也使毋訟乎！"
  },
  {
    "id": "s0366",
    "blockIndex": 28,
    "zh": "』為人主計者，莫如先審取舍，取舍之極定於內而安危之萌應於外矣。"
  },
  {
    "id": "s0367",
    "blockIndex": 28,
    "zh": "秦王之欲尊宗廟而安子孫，與湯、武同。"
  },
  {
    "id": "s0368",
    "blockIndex": 28,
    "zh": "然而湯、武廣大其德行，六七百歲而弗失，秦王治天下十餘歲則大敗。"
  },
  {
    "id": "s0369",
    "blockIndex": 28,
    "zh": "此亡他故矣：湯、武之定取舍審而秦王之定取舍不審矣。"
  },
  {
    "id": "s0370",
    "blockIndex": 28,
    "zh": "夫天下，大器也；"
  },
  {
    "id": "s0371",
    "blockIndex": 28,
    "zh": "今人之置器，置諸安處則安，置諸危處則危。"
  },
  {
    "id": "s0372",
    "blockIndex": 28,
    "zh": "天下之情，與器無以異，在天子之所置之。"
  },
  {
    "id": "s0373",
    "blockIndex": 28,
    "zh": "湯、武置天下於仁、義、禮、樂，累子孫數十世，此天下所共聞也；"
  },
  {
    "id": "s0374",
    "blockIndex": 28,
    "zh": "秦王置天下於法令、刑罰，禍幾及身，子孫誅絕，此天下之所共見也。"
  },
  {
    "id": "s0375",
    "blockIndex": 28,
    "zh": "是非其明效大驗邪！"
  },
  {
    "id": "s0376",
    "blockIndex": 28,
    "zh": "人之言曰：『聽言之道，必以其事觀之，則言者莫敢妄言。"
  },
  {
    "id": "s0377",
    "blockIndex": 28,
    "zh": "』今或言禮誼之不如法令，教化之不如刑罰，人主胡不引殷、周、秦事以觀之也！"
  },
  {
    "id": "s0378",
    "blockIndex": 28,
    "zh": "人主之尊譬如堂，群臣如陛，眾庶如地。"
  },
  {
    "id": "s0379",
    "blockIndex": 28,
    "zh": "故陛九級上，廉遠地，則堂高；"
  },
  {
    "id": "s0380",
    "blockIndex": 28,
    "zh": "陛無級，廉近地，則堂卑。"
  },
  {
    "id": "s0381",
    "blockIndex": 28,
    "zh": "高者難攀，卑者易陵，理勢然也。"
  },
  {
    "id": "s0382",
    "blockIndex": 28,
    "zh": "故古者聖王制為等列，內有公、卿、大夫、士，外有公、侯、伯、子、男，然後有官師、小吏，延及庶人，等級分明而天子加焉，故其尊不可及也。"
  },
  {
    "id": "s0383",
    "blockIndex": 29,
    "zh": ":里諺曰：『欲投鼠而忌器。"
  },
  {
    "id": "s0384",
    "blockIndex": 29,
    "zh": "』此善諭也。"
  },
  {
    "id": "s0385",
    "blockIndex": 29,
    "zh": "鼠近於器，尚憚不投，恐傷其器，況於貴臣之近主乎！"
  },
  {
    "id": "s0386",
    "blockIndex": 29,
    "zh": "廉恥節禮以治君子，故有賜死而亡戮辱。"
  },
  {
    "id": "s0387",
    "blockIndex": 29,
    "zh": "是以黥、劓之罪不及大夫，以其離主上不遠也。"
  },
  {
    "id": "s0388",
    "blockIndex": 29,
    "zh": "禮：不敢齒君之路馬，蹴其芻者有罰，所以為主上豫遠不敬也。"
  },
  {
    "id": "s0389",
    "blockIndex": 29,
    "zh": "今自王、侯、三公之貴，皆天子之所改容而禮之也，古天子之所謂伯父、伯舅也；"
  },
  {
    "id": "s0390",
    "blockIndex": 29,
    "zh": "而令與眾庶同黥、劓、髡、刖、笞、傌、棄市之法，然則堂不無陛虖！"
  },
  {
    "id": "s0391",
    "blockIndex": 29,
    "zh": "被戮辱者不泰迫虖！"
  },
  {
    "id": "s0392",
    "blockIndex": 29,
    "zh": "廉恥不行，大臣無乃握重權、大官而有徒隸無恥之心虖！"
  },
  {
    "id": "s0393",
    "blockIndex": 29,
    "zh": "夫望夷之事，二世見當以重法者，投鼠而不忌器之習也。"
  },
  {
    "id": "s0394",
    "blockIndex": 29,
    "zh": "臣聞之：履雖鮮不加於枕，冠雖敝不以苴履。"
  },
  {
    "id": "s0395",
    "blockIndex": 29,
    "zh": "夫嘗已在貴寵之位，天子改容而禮貌之矣，吏民嘗俯伏以敬畏之矣；"
  },
  {
    "id": "s0396",
    "blockIndex": 29,
    "zh": "今而有過，帝令廢之可也，退之可也，賜之死可也，滅之可也；"
  },
  {
    "id": "s0397",
    "blockIndex": 29,
    "zh": "若夫束縛之，系媟之，輸之司寇，編之徒官，司寇小吏詈罵而榜笞之，殆非所以令眾庶見也。"
  },
  {
    "id": "s0398",
    "blockIndex": 29,
    "zh": "夫卑賤者習知尊貴者之一旦吾亦乃可以加此也，非所以尊尊、貴貴之化也。"
  },
  {
    "id": "s0399",
    "blockIndex": 29,
    "zh": "古者大臣有坐不廉而廢者，不謂不廉，曰簠簋不飾』；"
  },
  {
    "id": "s0400",
    "blockIndex": 29,
    "zh": "坐污穢淫亂、男女無別者，不曰污穢，曰『帷薄不修』；"
  },
  {
    "id": "s0401",
    "blockIndex": 29,
    "zh": "坐罷軟不勝任者，不謂罷軟，曰『下官不職』。"
  },
  {
    "id": "s0402",
    "blockIndex": 29,
    "zh": "故貴大臣定有其罪矣，猶未斥然正以呼之也，尚遷就而為之諱也。"
  },
  {
    "id": "s0403",
    "blockIndex": 29,
    "zh": "故其在大譴、大何之域者，聞譴、何則白冠氂纓，盤水加劍，造請室而請罪耳，上不執縛系引而行也；"
  },
  {
    "id": "s0404",
    "blockIndex": 29,
    "zh": "其有中罪者，聞命而自弛，上不使人頸盭而加也；"
  },
  {
    "id": "s0405",
    "blockIndex": 29,
    "zh": "其有大罪者，聞命則北面再拜，跪而自裁，上不使人捽抑而刑之也。"
  },
  {
    "id": "s0406",
    "blockIndex": 29,
    "zh": "曰：『子大夫自有過耳，吾遇子有禮矣。"
  },
  {
    "id": "s0407",
    "blockIndex": 29,
    "zh": "』遇之有禮，故群臣自熹；"
  },
  {
    "id": "s0408",
    "blockIndex": 29,
    "zh": "嬰以廉恥，故人矜節行。"
  },
  {
    "id": "s0409",
    "blockIndex": 29,
    "zh": "上設廉恥、禮義以遇其臣不以節行報其上者，則非人類也。"
  },
  {
    "id": "s0410",
    "blockIndex": 29,
    "zh": "故化成俗定，則為人臣者皆顧行而忘利，守節而伏義，故可以托不御之權，可以寄六尺之孤，此厲廉恥、行禮誼之所致也，主上何喪焉！"
  },
  {
    "id": "s0411",
    "blockIndex": 29,
    "zh": "此之不為而顧彼之久行，故曰可為長太息者此也。"
  },
  {
    "id": "s0413",
    "blockIndex": 30,
    "zh": "誼以絳侯前逮繫獄，卒無事，故以此譏上。"
  },
  {
    "id": "s0414",
    "blockIndex": 30,
    "zh": "上深納其言，養臣下有節，是後大臣有罪，皆自殺，不受刑。"
  },
  {
    "id": "s0415",
    "blockIndex": 30,
    "zh": "----1冬，十月，令列侯太夫人、夫人、諸侯王子及吏二千石無得擅征捕。"
  },
  {
    "id": "s0416",
    "blockIndex": 30,
    "zh": "----2夏，四月，赦天下。"
  },
  {
    "id": "s0417",
    "blockIndex": 30,
    "zh": "----3六月，癸酉，未央宮東闕罘罳災。"
  },
  {
    "id": "s0418",
    "blockIndex": 30,
    "zh": "----4民有歌淮南王者曰：「一尺布，尚可縫；"
  },
  {
    "id": "s0419",
    "blockIndex": 30,
    "zh": "一斗粟，尚可舂；"
  },
  {
    "id": "s0420",
    "blockIndex": 30,
    "zh": "兄弟二人不相容！"
  },
  {
    "id": "s0421",
    "blockIndex": 30,
    "zh": "」帝聞而病之。"
  },
  {
    "id": "s0422",
    "blockIndex": 30,
    "zh": "----1夏，封淮南厲王子安等四人為列侯。"
  },
  {
    "id": "s0423",
    "blockIndex": 30,
    "zh": "賈誼知上必將復王之也，上疏諫曰：「淮南王之悖逆無道，天下孰不知其罪！"
  },
  {
    "id": "s0424",
    "blockIndex": 30,
    "zh": "陛下幸而赦遷之，自疾而死，天下孰以王死之不噹！"
  },
  {
    "id": "s0425",
    "blockIndex": 30,
    "zh": "今奉尊罪人之子，適足以負謗於天下耳。"
  },
  {
    "id": "s0426",
    "blockIndex": 30,
    "zh": "此人少壯，豈能忘其父哉！"
  },
  {
    "id": "s0427",
    "blockIndex": 30,
    "zh": "白公勝所為父報仇者，大父與叔父也。"
  },
  {
    "id": "s0428",
    "blockIndex": 30,
    "zh": "白公為亂，非欲取國代主，發忿快志，剡手以沖仇人之匈，固為俱靡而已。"
  },
  {
    "id": "s0429",
    "blockIndex": 30,
    "zh": "淮南雖小，黥布嘗用之矣，漢存，特幸耳。"
  },
  {
    "id": "s0430",
    "blockIndex": 30,
    "zh": "夫擅仇人足以危漢之資，於策不便。"
  },
  {
    "id": "s0431",
    "blockIndex": 30,
    "zh": "予之眾，積之財，此非有子胥、白公報於廣都之中，即疑有專諸、荊軻起於兩柱之間，所謂假賊兵，為虎翼者也。"
  },
  {
    "id": "s0432",
    "blockIndex": 30,
    "zh": "願陛下少留計！"
  },
  {
    "id": "s0433",
    "blockIndex": 30,
    "zh": "」上弗聽。"
  },
  {
    "id": "s0434",
    "blockIndex": 30,
    "zh": "----2有長星出於東方。"
  },
  {
    "id": "s0435",
    "blockIndex": 30,
    "zh": "----1春，大旱。"
  },
  {
    "id": "s0436",
    "blockIndex": 30,
    "zh": "----1冬，上行幸甘泉。"
  },
  {
    "id": "s0437",
    "blockIndex": 30,
    "zh": "----2將軍薄昭殺漢使者。"
  },
  {
    "id": "s0438",
    "blockIndex": 30,
    "zh": "帝不忍加誅，使公卿從之飲酒。"
  },
  {
    "id": "s0439",
    "blockIndex": 30,
    "zh": "欲令自引分，昭不肯；"
  },
  {
    "id": "s0440",
    "blockIndex": 30,
    "zh": "使群臣喪服往哭之，乃自殺。"
  },
  {
    "id": "s0441",
    "blockIndex": 31,
    "zh": "::臣光曰：李德裕以為：「漢文帝誅薄昭，斷則明矣，於義則未安也。"
  },
  {
    "id": "s0442",
    "blockIndex": 31,
    "zh": "秦康送晉文，興如存之感；"
  },
  {
    "id": "s0443",
    "blockIndex": 31,
    "zh": "況太后尚存，唯一弟薄昭，斷之不疑，非所以慰母氏之心也。"
  },
  {
    "id": "s0444",
    "blockIndex": 31,
    "zh": "」臣愚以為法者天下之公器，惟善持法者，親疏如一，無所不行，則人莫敢有所恃而犯之也。"
  },
  {
    "id": "s0445",
    "blockIndex": 31,
    "zh": "夫薄昭雖素稱長者，文帝不為置賢師傅而用之典兵；"
  },
  {
    "id": "s0446",
    "blockIndex": 31,
    "zh": "驕而犯上，至於殺漢使者，非有恃而然乎！"
  },
  {
    "id": "s0447",
    "blockIndex": 31,
    "zh": "若又從而赦之，則與成、哀之世何異哉！"
  },
  {
    "id": "s0448",
    "blockIndex": 31,
    "zh": "魏文帝嘗稱漢文帝之美，而不取其殺薄昭，曰：「-{舅后}-之家，但當養育以恩而不當假藉以權，既觸罪法，又不得不害。"
  },
  {
    "id": "s0449",
    "blockIndex": 31,
    "zh": "」譏文帝之始不防閒昭也，斯言得之矣。"
  },
  {
    "id": "s0450",
    "blockIndex": 31,
    "zh": "然則欲慰母心者，將慎之於始乎！"
  },
  {
    "id": "s0451",
    "blockIndex": 32,
    "zh": "category:資治通鑑"
  }
]
