[
  {
    "id": "s0001",
    "blockIndex": 0,
    "zh": "起上章執徐，盡著雍困敦，凡九年。"
  },
  {
    "id": "s0002",
    "blockIndex": 1,
    "zh": "1春，二月，馮奉世還京師，更為左將軍，賜爵關內侯。"
  },
  {
    "id": "s0003",
    "blockIndex": 1,
    "zh": "----2三月，立皇子康為濟陽王。"
  },
  {
    "id": "s0004",
    "blockIndex": 1,
    "zh": "----3夏，四月，癸未，平昌考侯王接薨。"
  },
  {
    "id": "s0005",
    "blockIndex": 1,
    "zh": "秋，七月，壬戌，以平恩侯許嘉為大司馬、車騎將軍。"
  },
  {
    "id": "s0006",
    "blockIndex": 1,
    "zh": "----4冬，十一月，己丑，地震，雨水。"
  },
  {
    "id": "s0007",
    "blockIndex": 1,
    "zh": "----5復鹽鐵官；"
  },
  {
    "id": "s0008",
    "blockIndex": 1,
    "zh": "置博士弟子員千人。"
  },
  {
    "id": "s0009",
    "blockIndex": 1,
    "zh": "以用度不足，民多復除，無以給中外繇役故也。"
  },
  {
    "id": "s0011",
    "blockIndex": 2,
    "zh": "1春，二月，赦天下。"
  },
  {
    "id": "s0012",
    "blockIndex": 2,
    "zh": "----2三月，上行幸雍，祠五畤。"
  },
  {
    "id": "s0013",
    "blockIndex": 2,
    "zh": "----3夏，六月，甲戌，孝宣園東闕災。"
  },
  {
    "id": "s0014",
    "blockIndex": 2,
    "zh": "----4戊寅晦，日有食之。"
  },
  {
    "id": "s0015",
    "blockIndex": 2,
    "zh": "上於是召諸前言日變在周堪、張猛者責問，皆稽首謝；"
  },
  {
    "id": "s0016",
    "blockIndex": 2,
    "zh": "因下詔稱堪之美，徵詣行在所，拜為光祿大夫，秩中二千石，領尚書事；"
  },
  {
    "id": "s0017",
    "blockIndex": 2,
    "zh": "猛復為太中大夫、給事中。"
  },
  {
    "id": "s0018",
    "blockIndex": 2,
    "zh": "中書令石顯管尚書，尚書五人皆其黨也；"
  },
  {
    "id": "s0019",
    "blockIndex": 2,
    "zh": "堪希得見，常因顯白事，事決顯口。"
  },
  {
    "id": "s0020",
    "blockIndex": 2,
    "zh": "會堪疾喑，不能言而卒。"
  },
  {
    "id": "s0021",
    "blockIndex": 2,
    "zh": "顯誣譖猛，令自殺於公車。"
  },
  {
    "id": "s0022",
    "blockIndex": 2,
    "zh": "----5初，貢禹奏言：「孝惠、孝景廟皆親盡宜毀，及郡國廟不應古禮，宜正定。"
  },
  {
    "id": "s0023",
    "blockIndex": 2,
    "zh": "」天子是其議。"
  },
  {
    "id": "s0024",
    "blockIndex": 2,
    "zh": "秋，七月，戊子，罷昭靈-{后}-、武哀王、昭哀-{后}-、衛思-{后}-、戾太子、戾-{后}-園，皆不奉祠，裁置吏卒守焉。"
  },
  {
    "id": "s0025",
    "blockIndex": 2,
    "zh": "冬，十月，乙丑，罷祖宗廟在郡國者。"
  },
  {
    "id": "s0026",
    "blockIndex": 2,
    "zh": "----6諸陵分屬三輔。"
  },
  {
    "id": "s0027",
    "blockIndex": 2,
    "zh": "以渭城壽陵亭部原上為初陵。"
  },
  {
    "id": "s0028",
    "blockIndex": 2,
    "zh": "詔勿置縣邑及徙郡國民。"
  },
  {
    "id": "s0030",
    "blockIndex": 3,
    "zh": "1春，正月，上行幸甘泉，郊泰畤。"
  },
  {
    "id": "s0031",
    "blockIndex": 3,
    "zh": "三月，幸河東，祠-{后土}-。"
  },
  {
    "id": "s0032",
    "blockIndex": 3,
    "zh": "----2秋，穎川水流殺人民。"
  },
  {
    "id": "s0033",
    "blockIndex": 3,
    "zh": "----3冬，上幸長楊射熊館，大獵。"
  },
  {
    "id": "s0034",
    "blockIndex": 3,
    "zh": "----4十二月，乙酉，毀太上皇、孝惠皇帝寢廟園，用韋玄成等之議也。"
  },
  {
    "id": "s0035",
    "blockIndex": 3,
    "zh": "----5上好儒術、文辭，頗改宣帝之政。"
  },
  {
    "id": "s0036",
    "blockIndex": 3,
    "zh": "言事者多進見，人人以為得上意。"
  },
  {
    "id": "s0037",
    "blockIndex": 3,
    "zh": "又傅昭儀及子濟陽王康愛幸，逾於皇后、太子。"
  },
  {
    "id": "s0038",
    "blockIndex": 3,
    "zh": "太子少傅匡衡上疏曰：「臣聞治亂安危之機，在乎審所用心。"
  },
  {
    "id": "s0039",
    "blockIndex": 3,
    "zh": "蓋受命之王，務在創業垂統，傳之無窮；"
  },
  {
    "id": "s0040",
    "blockIndex": 3,
    "zh": "繼體之君，心存於承宣先王之德而褒大其功。"
  },
  {
    "id": "s0041",
    "blockIndex": 3,
    "zh": "昔者成王之嗣位，思述文、武之道以養其心，休烈盛美皆歸之二-{后}-，而不敢專其名，是以上天歆享，鬼神祐焉。"
  },
  {
    "id": "s0042",
    "blockIndex": 3,
    "zh": "陛下聖德天覆，子愛海內，然而陰陽未和，奸邪未禁者，殆議者未丕揚先帝之盛功，爭言制度不可用也，務變更之，所更或不可行而復復之，是以群下更相是非，吏民無所信。"
  },
  {
    "id": "s0043",
    "blockIndex": 3,
    "zh": "臣竊恨國家釋樂成之業，而虛為此紛紛也！"
  },
  {
    "id": "s0044",
    "blockIndex": 3,
    "zh": "願陛下詳覽統業之事，留神於遵制揚功，以定群下之心。"
  },
  {
    "id": "s0045",
    "blockIndex": 3,
    "zh": "《詩》《大雅》曰：『無念爾祖，聿脩厥德。"
  },
  {
    "id": "s0046",
    "blockIndex": 3,
    "zh": "』蓋至德之本也。"
  },
  {
    "id": "s0047",
    "blockIndex": 3,
    "zh": "《傳》曰：『審好惡，理情性，而王道畢矣。"
  },
  {
    "id": "s0048",
    "blockIndex": 3,
    "zh": "』治性之道，必審己之所有餘而強其所不足，蓋聰明疏通者戒於太察，寡聞少見者戒於壅蔽，勇猛剛強者戒於太暴，仁愛溫良者戒於無斷，湛靜安舒者戒於後時，廣心浩大者戒於遺忘。"
  },
  {
    "id": "s0049",
    "blockIndex": 3,
    "zh": "必審己之所當戒而齊之以義，然後中和之化應，而巧偽之徒不敢比周而望進。"
  },
  {
    "id": "s0050",
    "blockIndex": 3,
    "zh": "唯陛下戒之，所以崇聖德也！"
  },
  {
    "id": "s0051",
    "blockIndex": 4,
    "zh": "「臣又聞室家之道修，則天下之理得，故《詩》始《國風》，《禮》本冠、婚。"
  },
  {
    "id": "s0052",
    "blockIndex": 4,
    "zh": "始乎《國風》，原情性以明人倫也；"
  },
  {
    "id": "s0053",
    "blockIndex": 4,
    "zh": "本乎冠、婚，正基兆以防未然也。"
  },
  {
    "id": "s0054",
    "blockIndex": 4,
    "zh": "故聖王必慎妃-{后}-之際，別適長之位，禮之於內也。"
  },
  {
    "id": "s0055",
    "blockIndex": 4,
    "zh": "卑不逾尊，新不先故，所以統人情而理陰氣也；"
  },
  {
    "id": "s0056",
    "blockIndex": 4,
    "zh": "其尊適而卑庶也，適子冠乎阼，禮之用醴，眾子不得與列，所以貴正體而明嫌疑也。"
  },
  {
    "id": "s0057",
    "blockIndex": 4,
    "zh": "非虛加其禮文而已，乃中心與之殊異，故禮探其情而見之外也。"
  },
  {
    "id": "s0058",
    "blockIndex": 4,
    "zh": "聖人動靜游燕所親，物得其序，則海內自修，百姓從化。"
  },
  {
    "id": "s0059",
    "blockIndex": 4,
    "zh": "如當親者疏，當尊者卑，則佞巧之奸因時而動，以亂國家。"
  },
  {
    "id": "s0060",
    "blockIndex": 4,
    "zh": "故聖人慎防其端，禁於未然，不以私恩害公義。"
  },
  {
    "id": "s0061",
    "blockIndex": 4,
    "zh": "《傳》曰：『正家而天下定矣！"
  },
  {
    "id": "s0062",
    "blockIndex": 4,
    "zh": "』」----6初，武帝既塞宣房，後河復北決於館陶，分為屯氏河，東北入海，廣深與大河等，故因其自然，不堤塞也。"
  },
  {
    "id": "s0063",
    "blockIndex": 4,
    "zh": "是歲，河決於清河靈鳴犢口，而屯氏河絕。"
  },
  {
    "id": "s0065",
    "blockIndex": 5,
    "zh": "1春，正月，戊辰，隕石於梁。"
  },
  {
    "id": "s0066",
    "blockIndex": 5,
    "zh": "----2三月，上行幸雍，祠五畤。"
  },
  {
    "id": "s0067",
    "blockIndex": 5,
    "zh": "----3冬，河間王元坐賊殺不辜廢，遷房陵。"
  },
  {
    "id": "s0068",
    "blockIndex": 5,
    "zh": "----4罷孝文太后寢祠園。"
  },
  {
    "id": "s0069",
    "blockIndex": 5,
    "zh": "----5上幸虎圈鬥獸，後宮皆坐。"
  },
  {
    "id": "s0070",
    "blockIndex": 5,
    "zh": "熊逸出圈，攀檻欲上殿，左右、貴人、傅婕妤等皆驚走。"
  },
  {
    "id": "s0071",
    "blockIndex": 5,
    "zh": "馮婕妤直前，當熊而立。"
  },
  {
    "id": "s0072",
    "blockIndex": 5,
    "zh": "左右格殺熊。"
  },
  {
    "id": "s0073",
    "blockIndex": 5,
    "zh": "上問：「人情驚懼，何故前當熊？"
  },
  {
    "id": "s0074",
    "blockIndex": 5,
    "zh": "」婕妤對曰：「猛獸得人而止，妾恐熊至御坐，故以身當之。"
  },
  {
    "id": "s0075",
    "blockIndex": 5,
    "zh": "」帝嗟歎，倍敬重焉。"
  },
  {
    "id": "s0076",
    "blockIndex": 5,
    "zh": "傅婕妤慚，由是與馮婕妤有隙。"
  },
  {
    "id": "s0077",
    "blockIndex": 5,
    "zh": "馮婕妤，左將軍奉世之女也。"
  },
  {
    "id": "s0079",
    "blockIndex": 6,
    "zh": "1春，正月，上行幸甘泉，郊泰畤。"
  },
  {
    "id": "s0080",
    "blockIndex": 6,
    "zh": "三月，行幸河東，祠后土。"
  },
  {
    "id": "s0081",
    "blockIndex": 6,
    "zh": "----2夏，四月，赦天下。"
  },
  {
    "id": "s0082",
    "blockIndex": 6,
    "zh": "----3六月，立皇子興為信都王。"
  },
  {
    "id": "s0083",
    "blockIndex": 6,
    "zh": "----4東郡京房學《易》於梁人焦延壽。"
  },
  {
    "id": "s0084",
    "blockIndex": 6,
    "zh": "延壽常曰：「得我道以亡身者，京生也。"
  },
  {
    "id": "s0085",
    "blockIndex": 6,
    "zh": "」其說長於災變，分六十卦，更直日用事，以風雨寒溫為候，各有占驗。"
  },
  {
    "id": "s0086",
    "blockIndex": 6,
    "zh": "房用之尤精，以孝廉為郎，上疏屢言災異，有驗。"
  },
  {
    "id": "s0087",
    "blockIndex": 6,
    "zh": "天子說之，數召見問。"
  },
  {
    "id": "s0088",
    "blockIndex": 6,
    "zh": "房對曰：「古帝王以功舉賢，則萬化成，瑞應著；"
  },
  {
    "id": "s0089",
    "blockIndex": 6,
    "zh": "末世以毀譽取人，故功業廢而致災異。"
  },
  {
    "id": "s0090",
    "blockIndex": 6,
    "zh": "宜令百官各試其功，災異可息。"
  },
  {
    "id": "s0091",
    "blockIndex": 6,
    "zh": "」詔使房作其事，房奏考功課吏法。"
  },
  {
    "id": "s0092",
    "blockIndex": 6,
    "zh": "上令公卿朝臣與房會議溫室，皆以房言煩碎，令上下相司，不可許；"
  },
  {
    "id": "s0093",
    "blockIndex": 6,
    "zh": "上意鄉之。"
  },
  {
    "id": "s0094",
    "blockIndex": 6,
    "zh": "時部刺史奏事京師，上召見諸刺史，令房曉以課事；"
  },
  {
    "id": "s0095",
    "blockIndex": 6,
    "zh": "剌史復以為不可行。"
  },
  {
    "id": "s0096",
    "blockIndex": 6,
    "zh": "唯御史大夫鄭弘、光祿大夫周堪初言不可。"
  },
  {
    "id": "s0097",
    "blockIndex": 6,
    "zh": "後善之。"
  },
  {
    "id": "s0098",
    "blockIndex": 7,
    "zh": "是時，中書令石顯顓權，顯友人五鹿充宗為尚書令，二人用事。"
  },
  {
    "id": "s0099",
    "blockIndex": 7,
    "zh": "房嘗宴見，問上曰：「幽、厲之君何以危？"
  },
  {
    "id": "s0100",
    "blockIndex": 7,
    "zh": "所任者何人也？"
  },
  {
    "id": "s0101",
    "blockIndex": 7,
    "zh": "」上曰：「君不明而所任者巧佞。"
  },
  {
    "id": "s0102",
    "blockIndex": 7,
    "zh": "」房曰：「知其巧佞而用之邪，將以為賢也？"
  },
  {
    "id": "s0103",
    "blockIndex": 7,
    "zh": "」上曰：「賢之。"
  },
  {
    "id": "s0104",
    "blockIndex": 7,
    "zh": "」房曰：「然則今何以知其不賢也？"
  },
  {
    "id": "s0105",
    "blockIndex": 7,
    "zh": "」上曰：「以其時亂而君危知之。"
  },
  {
    "id": "s0106",
    "blockIndex": 7,
    "zh": "」房曰：「若是，任賢必治，任不肖必亂，必然之道也。"
  },
  {
    "id": "s0107",
    "blockIndex": 7,
    "zh": "幽、厲何不覺寤而更求賢，曷為卒任不肖以至於是？"
  },
  {
    "id": "s0108",
    "blockIndex": 7,
    "zh": "」上曰：「臨亂之君，各賢其臣；"
  },
  {
    "id": "s0109",
    "blockIndex": 7,
    "zh": "令皆覺寤，天下安得危亡之君！"
  },
  {
    "id": "s0110",
    "blockIndex": 7,
    "zh": "」房曰：「齊桓公、秦二世亦嘗聞此君而非笑之；"
  },
  {
    "id": "s0111",
    "blockIndex": 7,
    "zh": "然則任豎刁、趙高，政治日亂，盜賊滿山，何不以幽、厲卜之而覺寤乎？"
  },
  {
    "id": "s0112",
    "blockIndex": 7,
    "zh": "」上曰：「唯有道者能以往知來耳。"
  },
  {
    "id": "s0113",
    "blockIndex": 7,
    "zh": "」房因免冠頓首曰：「《春秋》紀二百四十二年災異，以示萬世之君。"
  },
  {
    "id": "s0114",
    "blockIndex": 7,
    "zh": "今陛下即位已來，日月失明，星辰逆行，山崩，泉湧，地震，石隕，夏霜，冬雷，春凋，秋榮，隕霜不殺，水，旱，螟蟲，民人饑、疫，盜賊不禁，刑人滿市，《春秋》所記災異盡備。"
  },
  {
    "id": "s0115",
    "blockIndex": 7,
    "zh": "陛下視今為治邪，亂邪？"
  },
  {
    "id": "s0116",
    "blockIndex": 7,
    "zh": "」上曰：「亦極亂耳，尚何道！"
  },
  {
    "id": "s0117",
    "blockIndex": 7,
    "zh": "」房曰：「今所任用者誰與？"
  },
  {
    "id": "s0118",
    "blockIndex": 7,
    "zh": "」上曰：「然，幸其愈於彼，又以為不在此人也。"
  },
  {
    "id": "s0119",
    "blockIndex": 7,
    "zh": "」房曰：「夫前世之君，亦皆然矣。"
  },
  {
    "id": "s0120",
    "blockIndex": 7,
    "zh": "臣恐後之視今，猶今之視前也！"
  },
  {
    "id": "s0121",
    "blockIndex": 7,
    "zh": "」上良久，乃曰：「今為亂者誰哉？"
  },
  {
    "id": "s0122",
    "blockIndex": 7,
    "zh": "」房曰：「明主宜自知之。"
  },
  {
    "id": "s0123",
    "blockIndex": 7,
    "zh": "」上曰：「不知也。"
  },
  {
    "id": "s0124",
    "blockIndex": 7,
    "zh": "如知，何故用之！"
  },
  {
    "id": "s0125",
    "blockIndex": 7,
    "zh": "」房曰：「上最所信任，與圖事帷幄之中，進退天下之士者是矣。"
  },
  {
    "id": "s0126",
    "blockIndex": 7,
    "zh": "」房指謂石顯，上亦知之，謂房曰：「已諭。"
  },
  {
    "id": "s0127",
    "blockIndex": 7,
    "zh": "」房罷出，後上亦不能退顯也。"
  },
  {
    "id": "s0128",
    "blockIndex": 8,
    "zh": ":臣光曰：人君之德不明，則臣下雖欲竭忠，何自而入乎！"
  },
  {
    "id": "s0129",
    "blockIndex": 8,
    "zh": "觀京房之所以曉孝元，可謂明白切至矣，而終不能寤，悲夫！"
  },
  {
    "id": "s0130",
    "blockIndex": 8,
    "zh": "《詩》曰：「匪面命之，言提其耳。"
  },
  {
    "id": "s0131",
    "blockIndex": 8,
    "zh": "匪手攜之，言示之事。"
  },
  {
    "id": "s0132",
    "blockIndex": 8,
    "zh": "」又曰：「誨爾諄諄，聽我藐藐。"
  },
  {
    "id": "s0133",
    "blockIndex": 8,
    "zh": "」孝元之謂矣！"
  },
  {
    "id": "s0134",
    "blockIndex": 8,
    "zh": "----5上令房上弟子曉知考功、課吏事者，欲試用之。"
  },
  {
    "id": "s0135",
    "blockIndex": 8,
    "zh": "房上「中郎任良、姚平，願以為刺史，試考功法；"
  },
  {
    "id": "s0136",
    "blockIndex": 8,
    "zh": "臣得通籍殿中，為奏事，以防壅塞。"
  },
  {
    "id": "s0137",
    "blockIndex": 8,
    "zh": "」石顯、五鹿充宗皆疾房，欲遠之，建言，宜試以房為郡守。"
  },
  {
    "id": "s0138",
    "blockIndex": 8,
    "zh": "帝於是以房為魏郡太守，得以考功法治郡。"
  },
  {
    "id": "s0139",
    "blockIndex": 9,
    "zh": "房自請：「歲竟，乘傳奏事。"
  },
  {
    "id": "s0140",
    "blockIndex": 9,
    "zh": "」天子許焉。"
  },
  {
    "id": "s0141",
    "blockIndex": 9,
    "zh": "房自知數以論議為大臣所非，與石顯等有隙，不欲遠離左右，乃上封事曰：「臣出之後，恐為用事所蔽，身死而功不成，故願歲盡乘傳奏事，蒙哀見許。"
  },
  {
    "id": "s0142",
    "blockIndex": 9,
    "zh": "乃辛已，蒙氣復乘卦，太陽侵色，此上大夫覆陽而上意疑也。"
  },
  {
    "id": "s0143",
    "blockIndex": 9,
    "zh": "己卯、庚辰之間，必有欲隔絕臣，令不得乘傳奏事者。"
  },
  {
    "id": "s0145",
    "blockIndex": 10,
    "zh": "房未發，上令陽平侯王鳳承製詔房止無乘傳奏事。"
  },
  {
    "id": "s0146",
    "blockIndex": 10,
    "zh": "房意愈恐。"
  },
  {
    "id": "s0147",
    "blockIndex": 11,
    "zh": "秋，房去至新豐，因郵上封事曰：「臣前以六月中言《遁卦》不效，法曰：『道人始去，寒湧水為災。"
  },
  {
    "id": "s0148",
    "blockIndex": 11,
    "zh": "』至其七月，湧水出。"
  },
  {
    "id": "s0149",
    "blockIndex": 11,
    "zh": "臣弟子姚平謂臣曰：『房可謂知道，未可謂信道也。"
  },
  {
    "id": "s0150",
    "blockIndex": 11,
    "zh": "房言災異，未嘗不中。"
  },
  {
    "id": "s0151",
    "blockIndex": 11,
    "zh": "湧水已出，道人當逐死，尚復何言！"
  },
  {
    "id": "s0152",
    "blockIndex": 11,
    "zh": "』臣曰：『陛下至仁，於臣尤厚，雖言而死，臣猶言也。"
  },
  {
    "id": "s0153",
    "blockIndex": 11,
    "zh": "』平又曰：『房可謂小忠，未可謂大忠也。"
  },
  {
    "id": "s0154",
    "blockIndex": 11,
    "zh": "昔秦時趙高用事，有正先者，非刺高而死，高威自此成，故秦之亂，正先趣之。"
  },
  {
    "id": "s0155",
    "blockIndex": 11,
    "zh": "』今臣得出守郡，自詭效功，恐未效而死，惟陛下毋使臣塞湧水之異，當正先之死，為姚平所笑。"
  },
  {
    "id": "s0157",
    "blockIndex": 12,
    "zh": "房至陝，復上封事曰：「臣前白願出任良試考功，臣得居內。"
  },
  {
    "id": "s0158",
    "blockIndex": 12,
    "zh": "議者知如此於身不利，臣不可蔽，故云『使弟子不若試師。"
  },
  {
    "id": "s0159",
    "blockIndex": 12,
    "zh": "』臣為刺史，又當奏事，故復云『為刺史，恐太守不與同心，不若以為太守。"
  },
  {
    "id": "s0160",
    "blockIndex": 12,
    "zh": "』此其所以隔絕臣也。"
  },
  {
    "id": "s0161",
    "blockIndex": 12,
    "zh": "陛下不違其言而遂聽之，此乃蒙氣所以不解、太陽無色者也。"
  },
  {
    "id": "s0162",
    "blockIndex": 12,
    "zh": "臣去稍遠，太陽侵色益甚，唯陛下毋難還臣而易逆天意。"
  },
  {
    "id": "s0163",
    "blockIndex": 12,
    "zh": "邪說雖安於人，天氣必變，故人可欺，天不可欺也，願陛下察焉。"
  },
  {
    "id": "s0165",
    "blockIndex": 13,
    "zh": "房去月餘，竟徵下獄。"
  },
  {
    "id": "s0166",
    "blockIndex": 13,
    "zh": "初，淮陽憲王舅張博，傾巧無行，多從王求金錢，欲為王求入朝。"
  },
  {
    "id": "s0167",
    "blockIndex": 13,
    "zh": "博從京房學，以女妻房。"
  },
  {
    "id": "s0168",
    "blockIndex": 13,
    "zh": "房每朝見，退輒為博道其語。"
  },
  {
    "id": "s0169",
    "blockIndex": 13,
    "zh": "博因記房所說密語，令房為王作求朝奏草，皆持柬與王，以為信驗。"
  },
  {
    "id": "s0170",
    "blockIndex": 13,
    "zh": "石顯知之，告『房與張博通謀，非謗政治，歸惡天子，詿誤諸侯王。"
  },
  {
    "id": "s0171",
    "blockIndex": 13,
    "zh": "』皆下獄，棄市，妻子徙邊。"
  },
  {
    "id": "s0172",
    "blockIndex": 13,
    "zh": "鄭弘坐與房善，免為庶人。"
  },
  {
    "id": "s0173",
    "blockIndex": 13,
    "zh": "----6御史中丞陳鹹數毀石顯，久之，坐與槐裡令朱雲善，漏洩省中語，石顯微伺知之，與雲皆下獄，髡為城旦。"
  },
  {
    "id": "s0174",
    "blockIndex": 14,
    "zh": "石顯威權日盛，公卿以下畏顯，重足一跡。"
  },
  {
    "id": "s0175",
    "blockIndex": 14,
    "zh": "顯與中書僕射牢梁、少府五鹿充宗結為黨友，諸附倚者皆得寵位，民歌之曰：「牢邪！"
  },
  {
    "id": "s0176",
    "blockIndex": 14,
    "zh": "石邪！"
  },
  {
    "id": "s0177",
    "blockIndex": 14,
    "zh": "五鹿客邪！"
  },
  {
    "id": "s0178",
    "blockIndex": 14,
    "zh": "印何纍纍，綬若若邪！"
  },
  {
    "id": "s0180",
    "blockIndex": 15,
    "zh": "顯內自知擅權，專柄在掌握，恐天子一旦納用左右耳目以間己，乃時歸誠，取一信以為驗。"
  },
  {
    "id": "s0181",
    "blockIndex": 15,
    "zh": "顯嘗使至諸官，有所徵發，顯先自白：「恐後漏盡宮門閉，請使詔吏開門。"
  },
  {
    "id": "s0182",
    "blockIndex": 15,
    "zh": "」上許之。"
  },
  {
    "id": "s0183",
    "blockIndex": 15,
    "zh": "顯故投夜還，稱詔開門入。"
  },
  {
    "id": "s0184",
    "blockIndex": 15,
    "zh": "後果有上書告「顯顓命，矯詔開宮門」，天子聞之，笑以其書示顯。"
  },
  {
    "id": "s0185",
    "blockIndex": 15,
    "zh": "顯因泣曰：「陛下過私小臣，屬任以事，群下無不嫉妒，欲陷害臣者，事類如此非一，唯獨明主知之。"
  },
  {
    "id": "s0186",
    "blockIndex": 15,
    "zh": "愚臣微賤，誠不能以一軀稱快萬眾，任天下之怨。"
  },
  {
    "id": "s0187",
    "blockIndex": 15,
    "zh": "臣願歸樞機職，受後宮掃除之役，死無所恨。"
  },
  {
    "id": "s0188",
    "blockIndex": 15,
    "zh": "唯陛下哀憐財幸，以此全活小臣。"
  },
  {
    "id": "s0189",
    "blockIndex": 15,
    "zh": "」天子以為然而憐之，數勞勉顯，加厚賞賜，賞賜及賂遺訾一萬萬。"
  },
  {
    "id": "s0190",
    "blockIndex": 15,
    "zh": "初，顯聞眾人匈匈，言己殺前將軍蕭望之，恐天下學士訕己，以諫大夫貢禹明經箸節，乃使人致意，深自結納，因薦禹天子，歷位九卿，禮事之甚備。"
  },
  {
    "id": "s0191",
    "blockIndex": 15,
    "zh": "議者於是或稱顯，以為不妒譖望之矣。"
  },
  {
    "id": "s0192",
    "blockIndex": 15,
    "zh": "顯之設變詐以自解免，取信人主者，皆此類也。"
  },
  {
    "id": "s0193",
    "blockIndex": 16,
    "zh": ":荀悅曰：夫佞臣之惑君主也甚矣，故孔子曰：「遠佞人。"
  },
  {
    "id": "s0194",
    "blockIndex": 16,
    "zh": "」非但不用而已，乃遠而絕之，隔塞其源，戒之極也。"
  },
  {
    "id": "s0195",
    "blockIndex": 16,
    "zh": "孔子曰：「政者，正也。"
  },
  {
    "id": "s0196",
    "blockIndex": 16,
    "zh": "」夫要道之本，正己而已矣。"
  },
  {
    "id": "s0197",
    "blockIndex": 16,
    "zh": "平直真實者，正之主也。"
  },
  {
    "id": "s0198",
    "blockIndex": 16,
    "zh": "故德必核其真，然後授其位；"
  },
  {
    "id": "s0199",
    "blockIndex": 16,
    "zh": "能必核其真，然後授其事；"
  },
  {
    "id": "s0200",
    "blockIndex": 16,
    "zh": "功必核其真，然後授其賞；"
  },
  {
    "id": "s0201",
    "blockIndex": 16,
    "zh": "罪必核其真，然後授其刑；"
  },
  {
    "id": "s0202",
    "blockIndex": 16,
    "zh": "行必核其真，然後貴之；"
  },
  {
    "id": "s0203",
    "blockIndex": 16,
    "zh": "言必核其真，然後信之；"
  },
  {
    "id": "s0204",
    "blockIndex": 16,
    "zh": "物必核其真，然後用之；"
  },
  {
    "id": "s0205",
    "blockIndex": 16,
    "zh": "事必核其真，然後修之。"
  },
  {
    "id": "s0206",
    "blockIndex": 16,
    "zh": "故眾正積於上，萬事實於下，先王之道，如斯而已矣！"
  },
  {
    "id": "s0207",
    "blockIndex": 16,
    "zh": "----7八月，癸亥，以光祿勳匡衡為御史大夫。"
  },
  {
    "id": "s0208",
    "blockIndex": 16,
    "zh": "----8閏月，丁酉，太皇太后上官氏崩。"
  },
  {
    "id": "s0209",
    "blockIndex": 16,
    "zh": "----9冬，十一月，齊、楚地震，大雨雪，樹折，屋壞。"
  },
  {
    "id": "s0211",
    "blockIndex": 17,
    "zh": "1夏，六月，甲辰，扶陽共侯韋玄成薨。"
  },
  {
    "id": "s0212",
    "blockIndex": 17,
    "zh": "----2秋，七月，匡衡為丞相。"
  },
  {
    "id": "s0213",
    "blockIndex": 17,
    "zh": "戊辰，衛尉李延壽為御史大夫。"
  },
  {
    "id": "s0214",
    "blockIndex": 17,
    "zh": "----3冬，使西域都護、騎都尉北地甘延壽、副校尉山陽陳湯共誅斬匈奴郅支單于於康居。"
  },
  {
    "id": "s0215",
    "blockIndex": 18,
    "zh": "始，郅支單于自以大國，威名尊重，又乘勝驕，不為康居王禮，怒殺康居王女及貴人、人民數百，或支解投都賴水中。"
  },
  {
    "id": "s0216",
    "blockIndex": 18,
    "zh": "發民作城，日作五百人，二歲乃已。"
  },
  {
    "id": "s0217",
    "blockIndex": 18,
    "zh": "又遣使責闔蘇、大宛諸國歲遺，不敢不予。"
  },
  {
    "id": "s0218",
    "blockIndex": 18,
    "zh": "漢遣使三輩至康居，求谷吉等死，郅支困辱使者，不肯奉詔；"
  },
  {
    "id": "s0219",
    "blockIndex": 18,
    "zh": "而因都護上書，言「居困厄，願歸計強漢，遣子入侍。"
  },
  {
    "id": "s0220",
    "blockIndex": 18,
    "zh": "」其驕嫚如此。"
  },
  {
    "id": "s0221",
    "blockIndex": 19,
    "zh": "湯為人沉勇，有大慮，多策略，喜奇功，與延壽謀曰：「夷狄畏服大種，其天性也。"
  },
  {
    "id": "s0222",
    "blockIndex": 19,
    "zh": "西域本屬匈奴，今郅支單于威名遠聞，侵陵烏孫、大宛，常為康居畫計，欲降服之。"
  },
  {
    "id": "s0223",
    "blockIndex": 19,
    "zh": "如得此二國，數年之間，城郭諸國危矣。"
  },
  {
    "id": "s0224",
    "blockIndex": 19,
    "zh": "且其人剽悍，好戰伐，數取勝，久畜之，必為西域患。"
  },
  {
    "id": "s0225",
    "blockIndex": 19,
    "zh": "雖所在絕遠，蠻夷無金城、強弩之守。"
  },
  {
    "id": "s0226",
    "blockIndex": 19,
    "zh": "如發屯田吏士，驅從烏孫眾兵，直指其城下，彼亡則無所之，守則不足自保，千載之功可一朝而成也！"
  },
  {
    "id": "s0227",
    "blockIndex": 19,
    "zh": "」延壽亦以為然，欲奏請之。"
  },
  {
    "id": "s0228",
    "blockIndex": 19,
    "zh": "湯曰：「國家與公卿議，大策非凡所見，事必不從。"
  },
  {
    "id": "s0229",
    "blockIndex": 19,
    "zh": "」延壽猶與不聽。"
  },
  {
    "id": "s0230",
    "blockIndex": 19,
    "zh": "會其久病，湯獨矯制發城郭諸國兵、車師戊已校尉屯田吏士。"
  },
  {
    "id": "s0231",
    "blockIndex": 19,
    "zh": "延壽聞之，驚起，欲止焉。"
  },
  {
    "id": "s0232",
    "blockIndex": 19,
    "zh": "湯怒，按劍叱延壽曰：「大眾已集會，豎子欲沮眾邪！"
  },
  {
    "id": "s0233",
    "blockIndex": 19,
    "zh": "」延壽遂從之。"
  },
  {
    "id": "s0234",
    "blockIndex": 19,
    "zh": "部勒行陳，漢兵、胡兵合四萬餘人。"
  },
  {
    "id": "s0235",
    "blockIndex": 19,
    "zh": "延壽、湯上疏自劾奏矯制，陳言兵狀，即日引軍分行，別為六校：其三校從南道逾蔥嶺，逕大宛；"
  },
  {
    "id": "s0236",
    "blockIndex": 19,
    "zh": "其三校都護自將，發溫宿國，從北道入赤谷，過烏孫，涉康居界，至闐池西。"
  },
  {
    "id": "s0237",
    "blockIndex": 19,
    "zh": "而康居副王抱闐將數千騎寇赤谷城東，殺略大昆彌千餘人，驅畜產甚多，從後與漢軍相及，頗寇盜後重。"
  },
  {
    "id": "s0238",
    "blockIndex": 19,
    "zh": "湯縱胡兵擊之，殺四百六十人，得其所略民四百七十人，還付大昆彌，其馬、牛、羊以給軍食。"
  },
  {
    "id": "s0239",
    "blockIndex": 19,
    "zh": "又捕得抱闐貴人伊奴毒。"
  },
  {
    "id": "s0240",
    "blockIndex": 19,
    "zh": "入康居東界，令軍不得為寇。"
  },
  {
    "id": "s0241",
    "blockIndex": 19,
    "zh": "間呼其貴人屠墨見之，諭以威信，與飲、盟，遣去。"
  },
  {
    "id": "s0242",
    "blockIndex": 19,
    "zh": "徑引行，未至單于城可六十里，止營。"
  },
  {
    "id": "s0243",
    "blockIndex": 19,
    "zh": "復捕得康居貴人具色子男開牟以為導。"
  },
  {
    "id": "s0244",
    "blockIndex": 19,
    "zh": "具色子，即屠墨母之弟，皆怨單于，由是具知郅支情。"
  },
  {
    "id": "s0245",
    "blockIndex": 19,
    "zh": "明日，引行，未至城三十里，止營。"
  },
  {
    "id": "s0246",
    "blockIndex": 20,
    "zh": "單于遣使曰：「漢兵何以來？"
  },
  {
    "id": "s0247",
    "blockIndex": 20,
    "zh": "」應曰：「單于上書言：『居困厄，願歸計強漢，身入朝見，』天子哀閔單于棄大國，屈意康居，故使都護將軍來迎單于妻子。"
  },
  {
    "id": "s0248",
    "blockIndex": 20,
    "zh": "恐左右驚動，故未敢至城下。"
  },
  {
    "id": "s0249",
    "blockIndex": 20,
    "zh": "」使數往來相答報，延壽、湯因讓之：「我為單于遠來，而至今無名王、大人見將軍受事者，何單于忽大計，失客主之禮也！"
  },
  {
    "id": "s0250",
    "blockIndex": 20,
    "zh": "兵來道遠，人畜罷極，食度且盡，恐無以自還，願單于與大臣審計策。"
  },
  {
    "id": "s0252",
    "blockIndex": 21,
    "zh": "明日，前至郅支城都賴水上，離城三里，止營傅陳。"
  },
  {
    "id": "s0253",
    "blockIndex": 21,
    "zh": "望見單于城上立五采幡幟，數百人被甲乘城；"
  },
  {
    "id": "s0254",
    "blockIndex": 21,
    "zh": "又出百餘騎往來馳城下，步兵百餘人夾門魚鱗陳，講習用兵。"
  },
  {
    "id": "s0255",
    "blockIndex": 21,
    "zh": "城上人更招漢軍曰：「鬥來！"
  },
  {
    "id": "s0256",
    "blockIndex": 21,
    "zh": "」百餘騎馳赴營，營皆張弩持滿指之，騎引卻。"
  },
  {
    "id": "s0257",
    "blockIndex": 21,
    "zh": "頗遣吏士射城門騎、步兵，騎、步兵皆入。"
  },
  {
    "id": "s0258",
    "blockIndex": 21,
    "zh": "延壽、湯令軍：「聞鼓音，皆薄城下，四面圍城，各有所守，穿塹，塞門戶，鹵楯為前，戟弩為後，仰射城樓上人。"
  },
  {
    "id": "s0259",
    "blockIndex": 21,
    "zh": "」樓上人下走。"
  },
  {
    "id": "s0260",
    "blockIndex": 21,
    "zh": "土城外有重木城，從木城中射，頗殺傷外人。"
  },
  {
    "id": "s0261",
    "blockIndex": 21,
    "zh": "外人發薪燒木城，夜，數百騎欲出，外迎射，殺之。"
  },
  {
    "id": "s0262",
    "blockIndex": 22,
    "zh": "初，單于聞漢兵至，欲去，疑康居怨己，為漢內應，又聞烏孫諸國兵皆發，自以無所之。"
  },
  {
    "id": "s0263",
    "blockIndex": 22,
    "zh": "郅支已出，復還，曰：「不如堅守。"
  },
  {
    "id": "s0264",
    "blockIndex": 22,
    "zh": "漢兵遠來，不能久攻。"
  },
  {
    "id": "s0265",
    "blockIndex": 22,
    "zh": "」單于乃被甲在樓上，諸閼氏、夫人數十皆以弓射外人。"
  },
  {
    "id": "s0266",
    "blockIndex": 22,
    "zh": "外人射中單于鼻，諸夫人頗死；"
  },
  {
    "id": "s0267",
    "blockIndex": 22,
    "zh": "單于乃下。"
  },
  {
    "id": "s0268",
    "blockIndex": 22,
    "zh": "夜過半，木城穿，中人卻入土城，乘城呼。"
  },
  {
    "id": "s0269",
    "blockIndex": 22,
    "zh": "時康居兵萬餘騎，分為十餘處，四面環城，亦與相應和。"
  },
  {
    "id": "s0270",
    "blockIndex": 22,
    "zh": "夜，數奔營，不利，輒卻。"
  },
  {
    "id": "s0271",
    "blockIndex": 22,
    "zh": "平明，四面火起，吏士喜，大呼乘之，鉦、鼓聲動地。"
  },
  {
    "id": "s0272",
    "blockIndex": 22,
    "zh": "康居兵引卻；"
  },
  {
    "id": "s0273",
    "blockIndex": 22,
    "zh": "漢兵四面推鹵楯，並入土城中。"
  },
  {
    "id": "s0274",
    "blockIndex": 22,
    "zh": "單于男女百餘人走入大內。"
  },
  {
    "id": "s0275",
    "blockIndex": 22,
    "zh": "漢兵縱火，吏士爭入，單于被創死。"
  },
  {
    "id": "s0276",
    "blockIndex": 22,
    "zh": "軍候假丞杜勳斬單于首。"
  },
  {
    "id": "s0277",
    "blockIndex": 22,
    "zh": "得漢使節二及谷吉等所賫帛書。"
  },
  {
    "id": "s0278",
    "blockIndex": 22,
    "zh": "諸鹵獲以畀得者。"
  },
  {
    "id": "s0279",
    "blockIndex": 22,
    "zh": "凡斬閼氏、太子、名王以下千五百一十八級；"
  },
  {
    "id": "s0280",
    "blockIndex": 22,
    "zh": "生虜百四十五人，降虜千餘人，賦予城郭諸國所發十五王。"
  },
  {
    "id": "s0282",
    "blockIndex": 23,
    "zh": "1春，正月，郅支首至京師。"
  },
  {
    "id": "s0283",
    "blockIndex": 23,
    "zh": "延壽、湯上疏曰：「臣聞天下之大義當混為一，昔有唐、虞，今有強漢。"
  },
  {
    "id": "s0284",
    "blockIndex": 23,
    "zh": "匈奴呼韓邪單于已稱北籓，唯郅支單于叛逆，未伏其辜，大夏之西，以為強漢不能臣也。"
  },
  {
    "id": "s0285",
    "blockIndex": 23,
    "zh": "郅支單于慘毒行於民，大惡通於天。"
  },
  {
    "id": "s0286",
    "blockIndex": 23,
    "zh": "臣延壽，臣湯，將義兵，行天誅，賴陛下神靈，陰陽並應，天氣精明，陷陳克敵，斬郅支首及名王以下，宜縣頭槁街蠻夷邸間，以示萬里，明犯強漢者，雖遠必誅！"
  },
  {
    "id": "s0287",
    "blockIndex": 23,
    "zh": "」丞相匡衡等以為：「方春，掩骼、埋胔之時，宜勿縣。"
  },
  {
    "id": "s0288",
    "blockIndex": 23,
    "zh": "」詔縣十日，乃埋之。"
  },
  {
    "id": "s0289",
    "blockIndex": 23,
    "zh": "仍告祠郊廟，赦天下。"
  },
  {
    "id": "s0290",
    "blockIndex": 23,
    "zh": "群臣上壽，置酒。"
  },
  {
    "id": "s0291",
    "blockIndex": 23,
    "zh": "----2六月，甲申，中山哀王竟薨。"
  },
  {
    "id": "s0292",
    "blockIndex": 23,
    "zh": "哀王者，帝之少弟，與太子遊學相長大。"
  },
  {
    "id": "s0293",
    "blockIndex": 23,
    "zh": "及薨，太子前吊。"
  },
  {
    "id": "s0294",
    "blockIndex": 23,
    "zh": "上望見太子，感念哀王，悲不能自止。"
  },
  {
    "id": "s0295",
    "blockIndex": 23,
    "zh": "太子既至前，不哀，上大恨曰：「安有人不慈仁，而可以奉宗廟，為民父母者乎！"
  },
  {
    "id": "s0296",
    "blockIndex": 23,
    "zh": "」是時駙馬都尉、侍中史丹護太子家，上以責謂丹，丹免冠謝曰：「臣誠見陛下哀痛中山王，至以感損。"
  },
  {
    "id": "s0297",
    "blockIndex": 23,
    "zh": "向者太子當進見，臣竊戒屬，毋涕泣，感傷陛下；"
  },
  {
    "id": "s0298",
    "blockIndex": 23,
    "zh": "罪乃在臣，當死！"
  },
  {
    "id": "s0299",
    "blockIndex": 23,
    "zh": "」上以為然，意乃解。"
  },
  {
    "id": "s0300",
    "blockIndex": 23,
    "zh": "----3藍田地震，山崩，壅霸水；"
  },
  {
    "id": "s0301",
    "blockIndex": 23,
    "zh": "安陵岸崩，壅涇水，涇水逆流。"
  },
  {
    "id": "s0303",
    "blockIndex": 24,
    "zh": "1春，三月，赦天下。"
  },
  {
    "id": "s0304",
    "blockIndex": 24,
    "zh": "----2夏，六月，庚申，復戾園。"
  },
  {
    "id": "s0305",
    "blockIndex": 24,
    "zh": "----3壬申晦，日有食之。"
  },
  {
    "id": "s0306",
    "blockIndex": 24,
    "zh": "----4秋，七月，庚子，復太上皇寢廟園、原廟、-{昭靈后}-、武哀王、-{昭哀后}-、-{衛思后}-園。"
  },
  {
    "id": "s0307",
    "blockIndex": 24,
    "zh": "時上寢疾，久不平。"
  },
  {
    "id": "s0308",
    "blockIndex": 24,
    "zh": "以為祖宗譴怒，故盡復之；"
  },
  {
    "id": "s0309",
    "blockIndex": 24,
    "zh": "唯郡國廟遂廢-{云}-。"
  },
  {
    "id": "s0310",
    "blockIndex": 24,
    "zh": "----5是歲，徙濟陽王康為山陽王。"
  },
  {
    "id": "s0311",
    "blockIndex": 24,
    "zh": "----6匈奴呼韓邪單于聞郅支既誅，且喜且懼；"
  },
  {
    "id": "s0312",
    "blockIndex": 24,
    "zh": "上書，願入朝見。"
  },
  {
    "id": "s0314",
    "blockIndex": 25,
    "zh": "1春，正月，匈奴呼韓邪單于來朝，自言願婿漢氏以自親。"
  },
  {
    "id": "s0315",
    "blockIndex": 25,
    "zh": "帝以後宮良家子王嬙字昭君賜單于。"
  },
  {
    "id": "s0316",
    "blockIndex": 25,
    "zh": "單于歡喜，上書「願保塞上谷以西至敦煌，傳之無窮。"
  },
  {
    "id": "s0317",
    "blockIndex": 25,
    "zh": "請罷邊備塞吏卒，以休天子人民。"
  },
  {
    "id": "s0318",
    "blockIndex": 25,
    "zh": "」天子下有司議，議者皆以為便。"
  },
  {
    "id": "s0319",
    "blockIndex": 25,
    "zh": "郎中侯應習邊事，以為不可許。"
  },
  {
    "id": "s0320",
    "blockIndex": 25,
    "zh": "上問狀，應曰：「周、秦以來，匈奴暴桀，寇侵邊境；"
  },
  {
    "id": "s0321",
    "blockIndex": 25,
    "zh": "漢興，尤被其害。"
  },
  {
    "id": "s0322",
    "blockIndex": 25,
    "zh": "臣聞北邊塞至遼東，外有陰山，東西千餘里，草木茂盛，多禽獸，本冒頓單于依阻其中，治作弓矢，來出為寇，是其苑囿也。"
  },
  {
    "id": "s0323",
    "blockIndex": 25,
    "zh": "至孝武世，出師征伐，斥奪此地，攘之於幕北，建塞徼，起亭隧，築外城，設屯戍以守之，然後邊境得用少安。"
  },
  {
    "id": "s0324",
    "blockIndex": 25,
    "zh": "幕北地平，少草木，多大沙，匈奴來寇，少所蔽隱；"
  },
  {
    "id": "s0325",
    "blockIndex": 25,
    "zh": "從塞以南，逕深山谷，往來差難。"
  },
  {
    "id": "s0326",
    "blockIndex": 25,
    "zh": "邊長老言：『匈奴失陰山之後，過之未嘗不哭也。"
  },
  {
    "id": "s0327",
    "blockIndex": 25,
    "zh": "』如罷備塞戍卒，示夷狄之大利，不可一也。"
  },
  {
    "id": "s0328",
    "blockIndex": 25,
    "zh": "今聖德廣被，天覆匈奴，匈奴得蒙全活之恩，稽首來臣。"
  },
  {
    "id": "s0329",
    "blockIndex": 25,
    "zh": "夫夷狄之情，困則卑順，強則驕逆，天性然也。"
  },
  {
    "id": "s0330",
    "blockIndex": 25,
    "zh": "前已罷外城，省亭隧，裁足以候望，通烽火而已。"
  },
  {
    "id": "s0331",
    "blockIndex": 25,
    "zh": "古者安不忘危，不可復罷，二也。"
  },
  {
    "id": "s0332",
    "blockIndex": 25,
    "zh": "中國有禮義之教，刑罰之誅，愚民猶尚犯禁；"
  },
  {
    "id": "s0333",
    "blockIndex": 25,
    "zh": "又況單于，能必其眾不犯約哉！"
  },
  {
    "id": "s0334",
    "blockIndex": 25,
    "zh": "三也。"
  },
  {
    "id": "s0335",
    "blockIndex": 25,
    "zh": "自中國尚建關梁以制諸侯，所以絕臣下之覬欲也。"
  },
  {
    "id": "s0336",
    "blockIndex": 25,
    "zh": "設塞徼，置屯戍，非獨為匈奴而已，亦為諸屬國降民本故匈奴之人，恐其思舊逃亡，四也。"
  },
  {
    "id": "s0337",
    "blockIndex": 25,
    "zh": "近西羌保塞，與漢人交通，吏民貪利，侵盜其畜產、妻子，以此怨恨，起而背畔。"
  },
  {
    "id": "s0338",
    "blockIndex": 25,
    "zh": "今罷乘塞，則生嫚易分爭之漸，五也。"
  },
  {
    "id": "s0339",
    "blockIndex": 25,
    "zh": "往者從軍多沒不還者，子孫貧困，一旦亡出，從其親戚，六也。"
  },
  {
    "id": "s0340",
    "blockIndex": 25,
    "zh": "又邊人奴婢愁苦，欲亡者多，曰：『聞匈奴中樂，無奈候望急何！"
  },
  {
    "id": "s0341",
    "blockIndex": 25,
    "zh": "』然時有亡出塞者，七也。"
  },
  {
    "id": "s0342",
    "blockIndex": 25,
    "zh": "盜賊桀黠，群輩犯法，如其窘急，亡走北出，則不可制，八也。"
  },
  {
    "id": "s0343",
    "blockIndex": 25,
    "zh": "起塞以來百有餘年，非皆以土垣也，或因山巖、石、木、溪谷、水門，稍稍平之，卒徒築治，功費久遠，不可勝計。"
  },
  {
    "id": "s0344",
    "blockIndex": 25,
    "zh": "臣恐議者不深慮其終始，欲以壹切省繇戍，十年之外，百歲之內，卒有它變，障塞破壞，亭隧滅絕，當更發屯繕治，累世之功不可卒復，九也。"
  },
  {
    "id": "s0345",
    "blockIndex": 25,
    "zh": "如罷戍卒，省候望，單于自以保塞守禦，必深德漢，請求無已；"
  },
  {
    "id": "s0346",
    "blockIndex": 25,
    "zh": "小失其意，則不可測。"
  },
  {
    "id": "s0347",
    "blockIndex": 25,
    "zh": "開夷狄之隙，虧中國之固，十也。"
  },
  {
    "id": "s0348",
    "blockIndex": 25,
    "zh": "非所以永持至安，威制百蠻之長策也！"
  },
  {
    "id": "s0349",
    "blockIndex": 25,
    "zh": "」對奏，天子有詔：「勿議罷邊塞事。"
  },
  {
    "id": "s0350",
    "blockIndex": 25,
    "zh": "」使車騎將軍嘉口諭單于曰：「單于上書願罷北塞吏士屯戍，子孫世世保塞。"
  },
  {
    "id": "s0351",
    "blockIndex": 25,
    "zh": "單于鄉慕禮義，所以為民計者甚厚。"
  },
  {
    "id": "s0352",
    "blockIndex": 25,
    "zh": "此長久之策也，朕甚嘉之。"
  },
  {
    "id": "s0353",
    "blockIndex": 25,
    "zh": "中國四方皆有關梁障塞，非獨以備塞外也，亦以防中國奸邪放縱，出為寇害，故明法度以專眾心也。"
  },
  {
    "id": "s0354",
    "blockIndex": 25,
    "zh": "敬諭單于之意，朕無疑焉。"
  },
  {
    "id": "s0355",
    "blockIndex": 25,
    "zh": "為單于怪其不罷，故使嘉曉單于。"
  },
  {
    "id": "s0356",
    "blockIndex": 25,
    "zh": "」單于謝曰：「愚不知大計，天子幸使大臣告語，甚厚！"
  },
  {
    "id": "s0358",
    "blockIndex": 26,
    "zh": "初，左伊秩訾為呼韓邪畫計歸漢，竟以安定。"
  },
  {
    "id": "s0359",
    "blockIndex": 26,
    "zh": "其後或讒伊秩訾自伐其功，常鞅鞅，呼韓邪疑之；"
  },
  {
    "id": "s0360",
    "blockIndex": 26,
    "zh": "伊秩訾懼誅，將其眾千餘人降漢，漢以為關內侯，食邑三百戶，令佩其王印綬。"
  },
  {
    "id": "s0361",
    "blockIndex": 26,
    "zh": "及呼韓邪來朝，與伊秩訾相見，謝曰：「王為我計甚厚，令匈奴至今安寧，王之力也，德豈可忘！"
  },
  {
    "id": "s0362",
    "blockIndex": 26,
    "zh": "我失王意，使王去，不復顧留，皆我過也。"
  },
  {
    "id": "s0363",
    "blockIndex": 26,
    "zh": "今欲白天子，請王歸庭。"
  },
  {
    "id": "s0364",
    "blockIndex": 26,
    "zh": "」伊秩訾曰：「單于賴天命，自歸於漢，得以安寧，單于神靈，天子之祐也，我安得力！"
  },
  {
    "id": "s0365",
    "blockIndex": 26,
    "zh": "既已降漢，又復歸匈奴，是兩心也。"
  },
  {
    "id": "s0366",
    "blockIndex": 26,
    "zh": "願為單于侍使於漢，不敢聽命！"
  },
  {
    "id": "s0367",
    "blockIndex": 26,
    "zh": "」單于固請，不能得而歸。"
  },
  {
    "id": "s0368",
    "blockIndex": 27,
    "zh": "單于號王昭君為寧胡閼氏；"
  },
  {
    "id": "s0369",
    "blockIndex": 27,
    "zh": "生一男伊屠智牙師，為右日逐王。"
  },
  {
    "id": "s0370",
    "blockIndex": 27,
    "zh": "----2皇太子冠。"
  },
  {
    "id": "s0371",
    "blockIndex": 27,
    "zh": "----3二月，御史大夫李延壽卒。"
  },
  {
    "id": "s0372",
    "blockIndex": 27,
    "zh": "----4初，石顯見馮奉世父子為公卿著名，女又為昭儀在內，顯心欲附之，薦言：「昭儀兄謁者逡修敕，宜侍幄帷。"
  },
  {
    "id": "s0373",
    "blockIndex": 27,
    "zh": "」天子召見，欲以為侍中。"
  },
  {
    "id": "s0374",
    "blockIndex": 27,
    "zh": "逡請間言事。"
  },
  {
    "id": "s0375",
    "blockIndex": 27,
    "zh": "上聞逡言顯專權，大怒，罷逡歸郎官。"
  },
  {
    "id": "s0376",
    "blockIndex": 27,
    "zh": "及御史大夫缺，在位多舉逡兄大鴻臚野王；"
  },
  {
    "id": "s0377",
    "blockIndex": 27,
    "zh": "上使尚書選第中二千石，而野王行能第一。"
  },
  {
    "id": "s0378",
    "blockIndex": 27,
    "zh": "上以問顯，顯曰：「九卿無出野王者。"
  },
  {
    "id": "s0379",
    "blockIndex": 27,
    "zh": "然野王，親昭儀兄，臣恐後世必以陛下度越眾賢，私後宮親以為三公。"
  },
  {
    "id": "s0380",
    "blockIndex": 27,
    "zh": "」上曰：「善，吾不見是！"
  },
  {
    "id": "s0381",
    "blockIndex": 27,
    "zh": "」因謂群臣曰：「吾用野王為三公，後世必謂我私後宮親屬，以野王為比。"
  },
  {
    "id": "s0382",
    "blockIndex": 27,
    "zh": "」三月，丙寅，詔曰：「剛強堅固，確然亡欲，大鴻臚野王是也。"
  },
  {
    "id": "s0383",
    "blockIndex": 27,
    "zh": "心辨善辭，可使四方，少府五鹿充宗是也。"
  },
  {
    "id": "s0384",
    "blockIndex": 27,
    "zh": "廉潔節儉，太子少傅張譚是也。"
  },
  {
    "id": "s0385",
    "blockIndex": 27,
    "zh": "其以少傅為御史大夫。"
  },
  {
    "id": "s0386",
    "blockIndex": 27,
    "zh": "」----5河南太守九江召信臣為少府。"
  },
  {
    "id": "s0387",
    "blockIndex": 27,
    "zh": "信臣先為南陽太守，後遷河南，治行常第一。"
  },
  {
    "id": "s0388",
    "blockIndex": 27,
    "zh": "視民如子，好為民興利，躬勸耕稼，開通溝瀆，戶口增倍。"
  },
  {
    "id": "s0389",
    "blockIndex": 27,
    "zh": "吏民親愛，號曰「召父」。"
  },
  {
    "id": "s0390",
    "blockIndex": 27,
    "zh": "----6癸未，復孝惠皇帝寢廟園、孝文太后、孝昭太后寢園。"
  },
  {
    "id": "s0391",
    "blockIndex": 27,
    "zh": "----7初，中書令石顯嘗欲以姊妻甘延壽，延壽不取。"
  },
  {
    "id": "s0392",
    "blockIndex": 27,
    "zh": "及破郅支還，丞相、御史亦惡其矯制，皆不與延壽等。"
  },
  {
    "id": "s0393",
    "blockIndex": 27,
    "zh": "陳湯素貪，所鹵獲財物入塞，多不法。"
  },
  {
    "id": "s0394",
    "blockIndex": 27,
    "zh": "司隸校尉移書道上，系吏士，按驗之。"
  },
  {
    "id": "s0395",
    "blockIndex": 27,
    "zh": "湯上疏言：「臣與吏士共誅郅支單于，幸得禽滅，萬里振旅，宜有使者迎勞道路。"
  },
  {
    "id": "s0396",
    "blockIndex": 27,
    "zh": "今司隸反逆收系按驗，是為郅支報讎也！"
  },
  {
    "id": "s0397",
    "blockIndex": 27,
    "zh": "」上立出吏士，令縣、道出酒食以過軍。"
  },
  {
    "id": "s0398",
    "blockIndex": 27,
    "zh": "既至，論功，石顯、匡衡以為：「延壽、湯擅興師矯制，幸得不誅，如復加爵土，則後奉使者爭欲乘危徼幸，生事於蠻夷，為國招難。"
  },
  {
    "id": "s0399",
    "blockIndex": 27,
    "zh": "」帝內嘉延壽、湯功而重違衡、顯之議，久之不決。"
  },
  {
    "id": "s0400",
    "blockIndex": 28,
    "zh": "故宗正劉向上疏曰：「郅支單于囚殺使者、吏士以百數，事暴揚外國，傷威毀重，群臣皆閔焉。"
  },
  {
    "id": "s0401",
    "blockIndex": 28,
    "zh": "陛下赫然欲誅之，意未嘗有忘。"
  },
  {
    "id": "s0402",
    "blockIndex": 28,
    "zh": "西域都護延壽，副校尉湯，承聖指，倚神靈，總百蠻之君，攬城郭之兵，出百死，入絕域，遂蹈康居，屠三重城，搴歙侯之旗，斬郅支之首，縣旌萬里之外，揚威昆山之西，掃谷吉之恥，立昭明之功，萬夷懾伏，莫不懼震。"
  },
  {
    "id": "s0403",
    "blockIndex": 28,
    "zh": "呼韓邪單于見郅支已誅，且喜且懼，鄉風馳義，稽首來賓，願守北籓，累世稱臣。"
  },
  {
    "id": "s0404",
    "blockIndex": 28,
    "zh": "立千載之功，建萬世之安，群臣之勳莫大焉。"
  },
  {
    "id": "s0405",
    "blockIndex": 28,
    "zh": "昔周大夫方叔、吉甫為宣王誅獫狁而百蠻從，其詩曰：『嘽嘽焞焞，如霆如雷。"
  },
  {
    "id": "s0406",
    "blockIndex": 28,
    "zh": "顯允方叔，征伐獫狁，蠻荊來威。"
  },
  {
    "id": "s0407",
    "blockIndex": 28,
    "zh": "』《易》曰：『有嘉折首，獲匪其醜。"
  },
  {
    "id": "s0408",
    "blockIndex": 28,
    "zh": "』言美誅首惡之人，而諸不順者皆來從也。"
  },
  {
    "id": "s0409",
    "blockIndex": 28,
    "zh": "今延壽、湯所誅震，雖《易》之折首，《詩》之雷霆，不能及也。"
  },
  {
    "id": "s0410",
    "blockIndex": 28,
    "zh": "論大功者不錄小過，舉大美者不疵細瑕。"
  },
  {
    "id": "s0411",
    "blockIndex": 28,
    "zh": "《司馬法》曰：『軍賞不逾月，』欲民速得為善之利也。"
  },
  {
    "id": "s0412",
    "blockIndex": 28,
    "zh": "蓋急武功，重用人也。"
  },
  {
    "id": "s0413",
    "blockIndex": 28,
    "zh": "吉甫之歸，周厚賜之，其詩曰：『吉甫燕喜，既多受祉。"
  },
  {
    "id": "s0414",
    "blockIndex": 28,
    "zh": "來歸自鎬，我行永久。"
  },
  {
    "id": "s0415",
    "blockIndex": 28,
    "zh": "』千里之鎬猶以為遠，況萬里之外，其勤至矣。"
  },
  {
    "id": "s0416",
    "blockIndex": 28,
    "zh": "延壽、湯既未獲受祉之報，反屈捐命之功，久挫於刀筆之前，非所以勸有功，厲戎士也。"
  },
  {
    "id": "s0417",
    "blockIndex": 28,
    "zh": "昔齊桓前有尊周之功，後有滅項之罪，君子以功覆過而為之諱。"
  },
  {
    "id": "s0418",
    "blockIndex": 28,
    "zh": "貳師將軍李廣利，捐五萬之師，靡億萬之費，經四年之勞，而僅獲駿馬三十匹，雖斬宛王母寡之首，猶不足以復費，其私罪惡甚多；"
  },
  {
    "id": "s0419",
    "blockIndex": 28,
    "zh": "孝武以為萬里征伐，不錄其過，遂封拜兩侯、三卿、二千石百有餘人。"
  },
  {
    "id": "s0420",
    "blockIndex": 28,
    "zh": "今康居之國，強於大宛，郅支之號，重於宛王，殺使者罪，甚於留馬，而延壽、湯不煩漢士，不費斗糧，比於貳師，功德百之。"
  },
  {
    "id": "s0421",
    "blockIndex": 28,
    "zh": "且常惠隨欲擊之烏孫，鄭吉迎自來之日逐，猶皆裂土受爵。"
  },
  {
    "id": "s0422",
    "blockIndex": 28,
    "zh": "故言威武勤勞，則大於方叔、吉甫；"
  },
  {
    "id": "s0423",
    "blockIndex": 28,
    "zh": "列功覆過，則優於齊桓、貳師；"
  },
  {
    "id": "s0424",
    "blockIndex": 28,
    "zh": "近事之功，則高於安遠、長羅。"
  },
  {
    "id": "s0425",
    "blockIndex": 28,
    "zh": "而大功未著，小惡數布，臣竊痛之！"
  },
  {
    "id": "s0426",
    "blockIndex": 28,
    "zh": "宜以時解縣，通籍，除過勿治，尊寵爵位，以勸有功。"
  },
  {
    "id": "s0428",
    "blockIndex": 29,
    "zh": "於是天子下詔赦延壽、湯罪勿治，令公卿議封焉。"
  },
  {
    "id": "s0429",
    "blockIndex": 29,
    "zh": "議者以為宜如軍法捕斬單于令。"
  },
  {
    "id": "s0430",
    "blockIndex": 29,
    "zh": "匡衡、石顯以為「郅支本亡逃失國，竊號絕域，非真單于。"
  },
  {
    "id": "s0431",
    "blockIndex": 29,
    "zh": "」帝取安遠侯鄭吉故事，封千戶；"
  },
  {
    "id": "s0432",
    "blockIndex": 29,
    "zh": "衡、顯復爭。"
  },
  {
    "id": "s0433",
    "blockIndex": 29,
    "zh": "夏，四月，戊辰，封延壽為義成侯，賜湯爵關內侯，食邑各三百戶，加賜黃金百斤。"
  },
  {
    "id": "s0434",
    "blockIndex": 29,
    "zh": "拜延壽為長水校尉，湯為射聲校尉。"
  },
  {
    "id": "s0435",
    "blockIndex": 30,
    "zh": "於是杜欽上疏追訟馮奉世前破莎車功。"
  },
  {
    "id": "s0436",
    "blockIndex": 30,
    "zh": "上以先帝時事，不復錄。"
  },
  {
    "id": "s0437",
    "blockIndex": 30,
    "zh": "欽，故御史大夫延年子也。"
  },
  {
    "id": "s0438",
    "blockIndex": 31,
    "zh": ":荀悅論曰：成其功義足封，追錄前事可也。"
  },
  {
    "id": "s0439",
    "blockIndex": 31,
    "zh": "《春秋》之義，毀泉台則惡之，捨中軍則善之，各由其宜也。"
  },
  {
    "id": "s0440",
    "blockIndex": 31,
    "zh": "夫矯制之事，先王之所慎也，不得已而行之。"
  },
  {
    "id": "s0441",
    "blockIndex": 31,
    "zh": "若矯大而功小者，罪之可也；"
  },
  {
    "id": "s0442",
    "blockIndex": 31,
    "zh": "矯小而功大者，賞之可也；"
  },
  {
    "id": "s0443",
    "blockIndex": 31,
    "zh": "功過相敵，如斯而已可也。"
  },
  {
    "id": "s0444",
    "blockIndex": 31,
    "zh": "權其輕重而為之制宜焉。"
  },
  {
    "id": "s0445",
    "blockIndex": 31,
    "zh": "----8初，太子少好經書，寬博謹慎；"
  },
  {
    "id": "s0446",
    "blockIndex": 31,
    "zh": "其後幸酒，樂燕樂，上不以為能。"
  },
  {
    "id": "s0447",
    "blockIndex": 31,
    "zh": "而山陽王康有材藝，母傅昭儀又愛幸，上以故常有意欲以山陽王為嗣。"
  },
  {
    "id": "s0448",
    "blockIndex": 31,
    "zh": "上晚年多疾，不親政事，留好音樂；"
  },
  {
    "id": "s0449",
    "blockIndex": 31,
    "zh": "或置鼙鼓殿下，天子自臨軒檻上，隤銅丸以擿鼓，聲中嚴鼓之節。"
  },
  {
    "id": "s0450",
    "blockIndex": 31,
    "zh": "後宮及左右習知音者莫能為，而山陽王亦能之，上數稱其材。"
  },
  {
    "id": "s0451",
    "blockIndex": 31,
    "zh": "史丹進曰：「凡所謂材者，敏而好學，溫故知新，皇太子是也。"
  },
  {
    "id": "s0452",
    "blockIndex": 31,
    "zh": "若乃器人於絲竹鼓鼙之間，則是陳惠、李微高於匡衡，可相國也！"
  },
  {
    "id": "s0453",
    "blockIndex": 31,
    "zh": "」於是上嘿然而笑。"
  },
  {
    "id": "s0454",
    "blockIndex": 32,
    "zh": "及上寢疾，傅昭儀、山陽王康常在左右，而皇后、太子希得進見。"
  },
  {
    "id": "s0455",
    "blockIndex": 32,
    "zh": "上疾稍侵，意忽忽不平，數問尚書以景帝時立膠東王故事。"
  },
  {
    "id": "s0456",
    "blockIndex": 32,
    "zh": "是時太子長舅陽平侯王鳳為衛尉、侍中，與皇后、太子皆憂，不知所出。"
  },
  {
    "id": "s0457",
    "blockIndex": 32,
    "zh": "史丹以親密臣得侍視疾，候上間獨寢時，丹直入臥內，頓首伏青蒲上，涕泣而言曰：「皇太子以適長立，積十餘年，名號繫於百姓，天下莫不歸心臣子。"
  },
  {
    "id": "s0458",
    "blockIndex": 32,
    "zh": "見山陽王雅素愛幸，今者道路流言，為國生意，以為太子有動搖之議。"
  },
  {
    "id": "s0459",
    "blockIndex": 32,
    "zh": "審若此，公卿以下必以死爭，不奉詔。"
  },
  {
    "id": "s0460",
    "blockIndex": 32,
    "zh": "臣願先賜死以示群臣！"
  },
  {
    "id": "s0461",
    "blockIndex": 32,
    "zh": "」天子素仁，不忍見丹涕泣，言又切至，意大感寤，喟然太息曰：「吾日困劣，而太子、兩王幼少，意中戀戀，亦何不念乎！"
  },
  {
    "id": "s0462",
    "blockIndex": 32,
    "zh": "然無有此議。"
  },
  {
    "id": "s0463",
    "blockIndex": 32,
    "zh": "且皇后謹慎，先帝又愛太子，吾豈可違指！"
  },
  {
    "id": "s0464",
    "blockIndex": 32,
    "zh": "駙馬都尉安所受此語？"
  },
  {
    "id": "s0465",
    "blockIndex": 32,
    "zh": "」丹即卻，頓首曰：「愚臣妄聞，罪當死！"
  },
  {
    "id": "s0466",
    "blockIndex": 32,
    "zh": "」上因納，謂丹曰：「吾病寖加，恐不能自還，善輔道太子，毋違我意。"
  },
  {
    "id": "s0467",
    "blockIndex": 32,
    "zh": "」丹噓唏而起，太子由是遂定為嗣。"
  },
  {
    "id": "s0468",
    "blockIndex": 32,
    "zh": "而右將軍、光祿大夫王商，中書令石顯亦擁佑太子，頗有力焉。"
  },
  {
    "id": "s0469",
    "blockIndex": 32,
    "zh": "夏，五月，壬辰，帝崩於未央宮。"
  },
  {
    "id": "s0470",
    "blockIndex": 33,
    "zh": ":班彪贊曰：臣外祖兄弟為元帝侍中，語臣曰：「元帝多材藝，善史書，鼓琴瑟，吹洞簫，自度曲，被歌聲，分刌節度，窮極幼眇。"
  },
  {
    "id": "s0471",
    "blockIndex": 33,
    "zh": "少而好儒，及即位，徵用儒生，委之以政，貢、薛、韋、匡迭為宰相。"
  },
  {
    "id": "s0472",
    "blockIndex": 33,
    "zh": "而上牽制文義，優遊不斷，孝宣之業衰焉。"
  },
  {
    "id": "s0473",
    "blockIndex": 33,
    "zh": "然寬弘盡下，出於恭儉，號令溫雅，有古之風烈。"
  },
  {
    "id": "s0474",
    "blockIndex": 33,
    "zh": "」----9匡衡奏言：「前以上體不平，故復諸所罷祠，卒不蒙福。"
  },
  {
    "id": "s0475",
    "blockIndex": 33,
    "zh": "案-{衛思后}-、戾太子、戾-{后}-園，親未盡。"
  },
  {
    "id": "s0476",
    "blockIndex": 33,
    "zh": "孝惠、孝景廟，親盡，宜毀。"
  },
  {
    "id": "s0477",
    "blockIndex": 33,
    "zh": "及太上皇、孝文、孝昭太后、昭靈-{后}-、昭哀-{后}-、武哀王祠，請悉罷勿奉。"
  },
  {
    "id": "s0478",
    "blockIndex": 33,
    "zh": "」奏可。"
  },
  {
    "id": "s0479",
    "blockIndex": 33,
    "zh": "----10六月，己未，太子即皇帝位，謁高廟。"
  },
  {
    "id": "s0480",
    "blockIndex": 33,
    "zh": "尊皇太后曰太皇太后，皇后曰皇太后。"
  },
  {
    "id": "s0481",
    "blockIndex": 33,
    "zh": "以元舅侍中、衛尉、陽平侯王鳳為大司馬、大將軍、領尚書事。"
  },
  {
    "id": "s0482",
    "blockIndex": 33,
    "zh": "----11秋，七月，丙戌，葬孝元皇帝於渭陵。"
  },
  {
    "id": "s0483",
    "blockIndex": 33,
    "zh": "----12大赦天下。"
  },
  {
    "id": "s0484",
    "blockIndex": 33,
    "zh": "----13丞相衡上疏曰：「陛下秉至孝，哀傷思慕，不絕於心，未有游虞弋射之宴，誠隆於慎終追遠，無窮已也。"
  },
  {
    "id": "s0485",
    "blockIndex": 33,
    "zh": "竊願陛下雖聖性得之，猶復加聖心焉！"
  },
  {
    "id": "s0486",
    "blockIndex": 33,
    "zh": "《詩》云：『煢煢在疚，』言成王喪畢思慕，意氣未能平也。"
  },
  {
    "id": "s0487",
    "blockIndex": 33,
    "zh": "蓋所以就文、武之業，崇大化之本也。"
  },
  {
    "id": "s0488",
    "blockIndex": 33,
    "zh": "臣又聞之師曰：『妃匹之際，生民之始，萬福之原。"
  },
  {
    "id": "s0489",
    "blockIndex": 33,
    "zh": "婚姻之禮正，然後品物遂而天命全。"
  },
  {
    "id": "s0490",
    "blockIndex": 33,
    "zh": "』孔子論《詩》，以《關雎》為始，此綱紀之首，王教之端也。"
  },
  {
    "id": "s0491",
    "blockIndex": 33,
    "zh": "自上世已來，三代興廢，未有不由此者也。"
  },
  {
    "id": "s0492",
    "blockIndex": 33,
    "zh": "願陛下詳覽得失盛衰之效，以定大基，采有德，戒聲色，近嚴敬，遠技能。"
  },
  {
    "id": "s0493",
    "blockIndex": 33,
    "zh": "臣聞《六經》者，聖人所以統天地之心，著善惡之歸，明吉凶之分，通人道之正，使不悖於其本性者也。"
  },
  {
    "id": "s0494",
    "blockIndex": 33,
    "zh": "及《論語》、《孝經》，聖人言行之要，宜究其意。"
  },
  {
    "id": "s0495",
    "blockIndex": 33,
    "zh": "臣又聞聖王之自為，動靜周旋，奉天承親，臨朝享臣，物有節文，以章人倫。"
  },
  {
    "id": "s0496",
    "blockIndex": 33,
    "zh": "蓋欽翼祗栗，事天之容也；"
  },
  {
    "id": "s0497",
    "blockIndex": 33,
    "zh": "溫恭敬遜，承親之禮也；"
  },
  {
    "id": "s0498",
    "blockIndex": 33,
    "zh": "正躬嚴恪，臨眾之儀也；"
  },
  {
    "id": "s0499",
    "blockIndex": 33,
    "zh": "嘉惠和說，饗下之顏也。"
  },
  {
    "id": "s0500",
    "blockIndex": 33,
    "zh": "舉錯動作，物遵其儀，故形為仁義，動為法則。"
  },
  {
    "id": "s0501",
    "blockIndex": 33,
    "zh": "今正月初，幸路寢，臨朝賀，置酒以饗萬方。"
  },
  {
    "id": "s0502",
    "blockIndex": 33,
    "zh": "《傳》曰：『君子慎始。"
  },
  {
    "id": "s0503",
    "blockIndex": 33,
    "zh": "』願陛下留神動靜之節，使群下得望盛德休光，以立基楨，天下幸甚！"
  },
  {
    "id": "s0504",
    "blockIndex": 33,
    "zh": "」上敬納其言。"
  },
