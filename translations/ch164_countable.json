[
  {
    "id": "s0001",
    "blockIndex": 0,
    "zh": "資治通鑑 第164卷卷第一百六十四"
  },
  {
    "id": "s0002",
    "blockIndex": 1,
    "zh": "【梁紀二十】　起重光協洽，盡玄黓涒灘，凡二年。"
  },
  {
    "id": "s0003",
    "blockIndex": 2,
    "zh": "太宗簡文皇帝下大寶二年（"
  },
  {
    "id": "s0003",
    "blockIndex": 2,
    "zh": "辛未，公元五五一年）"
  },
  {
    "id": "s0005",
    "blockIndex": 3,
    "zh": "春，正月，新吳余孝頃舉兵拒侯景，景遣于慶攻之，不克。"
  },
  {
    "id": "s0006",
    "blockIndex": 4,
    "zh": "庚戌，湘東王繹遣護軍將軍尹悅、安東將軍杜幼安、巴州刺史王珣將兵二萬自江夏趣武昌，受徐文盛節度。"
  },
  {
    "id": "s0007",
    "blockIndex": 5,
    "zh": "楊乾運攻拔劍閣，楊法琛退保石門，乾運據南陰平。"
  },
  {
    "id": "s0008",
    "blockIndex": 6,
    "zh": "辛亥，齊主祀圜丘。"
  },
  {
    "id": "s0009",
    "blockIndex": 7,
    "zh": "張彪遣其將趙稜圍錢塘，孫鳳圍富春，侯景遣儀同三司田遷、趙伯超救之，稜、鳳敗走。"
  },
  {
    "id": "s0009",
    "blockIndex": 7,
    "zh": "稜，伯超之兄子也。"
  },
  {
    "id": "s0011",
    "blockIndex": 8,
    "zh": "癸亥，齊主耕籍田。"
  },
  {
    "id": "s0011",
    "blockIndex": 8,
    "zh": "乙丑，享太廟。"
  },
  {
    "id": "s0013",
    "blockIndex": 9,
    "zh": "魏楊忠圍汝南，李素戰死。"
  },
  {
    "id": "s0013",
    "blockIndex": 9,
    "zh": "二月，乙亥，城陷，執邵陵攜王綸，殺之，投屍江岸；"
  },
  {
    "id": "s0013",
    "blockIndex": 9,
    "zh": "岳陽王察取而葬之。"
  },
  {
    "id": "s0016",
    "blockIndex": 10,
    "zh": "或告齊太尉彭樂謀反；"
  },
  {
    "id": "s0016",
    "blockIndex": 10,
    "zh": "壬辰，樂坐誅。"
  },
  {
    "id": "s0016",
    "blockIndex": 10,
    "zh": "齊遣散騎常侍曹文皎使於江陵，湘東王繹使兼散騎常侍王子敏報之。"
  },
  {
    "id": "s0019",
    "blockIndex": 11,
    "zh": "侯景以王克為太師，宋子仙為太保，元羅為太傅，郭元建為太尉，支化仁為司徒，任約為司空，王偉為尚書左僕射，索超世為右僕射。"
  },
  {
    "id": "s0019",
    "blockIndex": 11,
    "zh": "景置三公官，動以十數，儀同尤多。"
  },
  {
    "id": "s0019",
    "blockIndex": 11,
    "zh": "以子仙、元建、化仁為佐命元功，偉、超世為謀主，於子悅、彭雋主擊斷，陳慶、呂季略、盧暉略、丁和等為爪牙。"
  },
  {
    "id": "s0019",
    "blockIndex": 11,
    "zh": "梁人為景用者，則故將軍趙伯超，前制局監周石珍，內監嚴但，邵陵王記室伏知命。"
  },
  {
    "id": "s0019",
    "blockIndex": 11,
    "zh": "自餘王克、元羅及侍中殷不害、太常周弘正等，景從人望，加以尊位，非腹心之任也。"
  },
  {
    "id": "s0024",
    "blockIndex": 12,
    "zh": "北兗州刺史蕭邕謀降魏，侯景殺之。"
  },
  {
    "id": "s0025",
    "blockIndex": 13,
    "zh": "楊乾運進據平興，平興者，楊法琛所治也。"
  },
  {
    "id": "s0025",
    "blockIndex": 13,
    "zh": "法琛退保魚石洞，乾運焚平興而歸。"
  },
  {
    "id": "s0027",
    "blockIndex": 14,
    "zh": "李遷仕收眾還擊南康，陳霸先遣其將杜僧明等拒之，生擒遷仕，斬之。"
  },
  {
    "id": "s0027",
    "blockIndex": 14,
    "zh": "湘東王繹使霸先進兵取江州，以為江州刺史。"
  },
  {
    "id": "s0029",
    "blockIndex": 15,
    "zh": "三月，丙午，齊襄城王淯卒。"
  },
  {
    "id": "s0030",
    "blockIndex": 16,
    "zh": "庚戌，魏文帝殂，太子欽立。"
  },
  {
    "id": "s0031",
    "blockIndex": 17,
    "zh": "乙卯，徐文盛等克武昌，進軍蘆洲。"
  },
  {
    "id": "s0032",
    "blockIndex": 18,
    "zh": "己未，齊以湘東王繹為梁相國，建梁台，總百揆，承製。"
  },
  {
    "id": "s0033",
    "blockIndex": 19,
    "zh": "齊司空司馬子如自求封王，齊主怒，庚申，免子如官。"
  },
  {
    "id": "s0034",
    "blockIndex": 20,
    "zh": "任約告急，侯景自帥眾西上，攜太子大器從軍以為質，留王偉居守。"
  },
  {
    "id": "s0034",
    "blockIndex": 20,
    "zh": "閏月，景發建康，自石頭至新林，舳艫相接。"
  },
  {
    "id": "s0034",
    "blockIndex": 20,
    "zh": "約分兵襲破定州刺史田龍祖於齊安。"
  },
  {
    "id": "s0034",
    "blockIndex": 20,
    "zh": "壬寅，景軍至西陽，與徐文盛夾江築壘。"
  },
  {
    "id": "s0034",
    "blockIndex": 20,
    "zh": "癸卯，文盛擊破之，射其右丞庫狄式和墜水死，景遁走還營。"
  },
  {
    "id": "s0039",
    "blockIndex": 21,
    "zh": "夏，四月，甲辰，魏葬文帝於永陵。"
  },
  {
    "id": "s0040",
    "blockIndex": 22,
    "zh": "郢州刺史蕭方諸，年十五，以行事鮑泉和弱，常侮易之，或使伏床，騎背為馬；"
  },
  {
    "id": "s0040",
    "blockIndex": 22,
    "zh": "恃徐文盛軍在近，不復設備，日以蒲酒為樂。"
  },
  {
    "id": "s0040",
    "blockIndex": 22,
    "zh": "侯景聞江夏空虛，乙巳，使宋子仙、任約帥精騎四百，由淮內襲郢州。"
  },
  {
    "id": "s0040",
    "blockIndex": 22,
    "zh": "丙午，大風疾雨，天色晦冥，有登陴望見賊者，告泉曰：「虜騎至矣！"
  },
  {
    "id": "s0040",
    "blockIndex": 22,
    "zh": "」泉曰：「徐文盛大軍在下，賊何因得至！"
  },
  {
    "id": "s0040",
    "blockIndex": 22,
    "zh": "當是王珣軍人還耳。"
  },
  {
    "id": "s0040",
    "blockIndex": 22,
    "zh": "」既而走告者稍眾，始命閉門，子仙等已入城。"
  },
  {
    "id": "s0040",
    "blockIndex": 22,
    "zh": "方諸方踞泉腹，以五色彩辮其髯；"
  },
  {
    "id": "s0040",
    "blockIndex": 22,
    "zh": "見子仙至，方諸迎拜，泉匿於床下；"
  },
  {
    "id": "s0040",
    "blockIndex": 22,
    "zh": "子仙俯窺見泉素髯間彩，驚愕，遂擒之，及司馬虞豫，送於景所。"
  },
  {
    "id": "s0040",
    "blockIndex": 22,
    "zh": "景因便風，中江舉帆，遂越文盛等軍。"
  },
  {
    "id": "s0040",
    "blockIndex": 22,
    "zh": "丁未，入江夏。"
  },
  {
    "id": "s0040",
    "blockIndex": 22,
    "zh": "文盛眾懼而潰，與長沙王韶等逃歸江陵。"
  },
  {
    "id": "s0040",
    "blockIndex": 22,
    "zh": "珣、杜幼安以家在江夏，遂降於景。"
  },
  {
    "id": "s0054",
    "blockIndex": 23,
    "zh": "湘東王繹以王僧辯為大都督，帥巴州刺史丹楊淳於量、定州刺史杜龕、宜州刺史王琳、郴州刺史裴之橫東擊景，徐文盛以下並受節度。"
  },
  {
    "id": "s0054",
    "blockIndex": 23,
    "zh": "戊申，僧辯等軍至巴陵，聞郢州已陷，因留戍之。"
  },
  {
    "id": "s0054",
    "blockIndex": 23,
    "zh": "繹遺僧辯書曰：「賊既乘勝，必將西下，不勞遠擊；"
  },
  {
    "id": "s0054",
    "blockIndex": 23,
    "zh": "但守巴丘，以逸待勞，無慮不克。"
  },
  {
    "id": "s0054",
    "blockIndex": 23,
    "zh": "」又謂僚佐曰：「景若水步兩道，直指江陵，此上策也；"
  },
  {
    "id": "s0054",
    "blockIndex": 23,
    "zh": "據夏首，積兵糧，中策也；"
  },
  {
    "id": "s0054",
    "blockIndex": 23,
    "zh": "悉力攻巴陵，下策也。"
  },
  {
    "id": "s0054",
    "blockIndex": 23,
    "zh": "巴陵城小而固，僧辯足可委任。"
  },
  {
    "id": "s0054",
    "blockIndex": 23,
    "zh": "景攻城不拔，野無所掠，暑疫時起，食盡兵疲，破之必矣。"
  },
  {
    "id": "s0054",
    "blockIndex": 23,
    "zh": "」乃命羅州刺史徐嗣徽自岳陽、武州刺史杜崱自武陵引兵會僧辯。"
  },
  {
    "id": "s0064",
    "blockIndex": 24,
    "zh": "景使丁和將兵五千守夏首，宋子仙將兵一萬為前驅，趣巴陵，分遣任約直指江陵，景帥大兵水步繼進。"
  },
  {
    "id": "s0064",
    "blockIndex": 24,
    "zh": "於是緣江戍邏，望風請服，景拓邏至於隱磯。"
  },
  {
    "id": "s0064",
    "blockIndex": 24,
    "zh": "僧辯乘城固守，偃旗臥鼓，安若無人。"
  },
  {
    "id": "s0064",
    "blockIndex": 24,
    "zh": "壬戌，景眾濟江，遣輕騎至城下，問：「城內為誰？"
  },
  {
    "id": "s0064",
    "blockIndex": 24,
    "zh": "」答曰：「王領軍。"
  },
  {
    "id": "s0064",
    "blockIndex": 24,
    "zh": "」騎曰：「何不早降？"
  },
  {
    "id": "s0064",
    "blockIndex": 24,
    "zh": "」僧辯曰：「大軍但向荊州，此城自當非礙。"
  },
  {
    "id": "s0064",
    "blockIndex": 24,
    "zh": "」騎去，頃之，執王珣等至城下，使說其弟琳。"
  },
  {
    "id": "s0064",
    "blockIndex": 24,
    "zh": "琳曰：「兄受命討賊，不能死難，曾不內慚，翻欲賜誘！"
  },
  {
    "id": "s0064",
    "blockIndex": 24,
    "zh": "」取弓射之，珣慚而退。"
  },
  {
    "id": "s0064",
    "blockIndex": 24,
    "zh": "景肉薄百道攻城，城中鼓噪，矢石雨下。"
  },
  {
    "id": "s0064",
    "blockIndex": 24,
    "zh": "景士卒死者甚眾，乃退。"
  },
  {
    "id": "s0064",
    "blockIndex": 24,
    "zh": "僧辯遣輕兵出戰，凡十餘返，皆捷。"
  },
  {
    "id": "s0064",
    "blockIndex": 24,
    "zh": "景被甲在城下督戰，僧辯著綬、乘輿、奏鼓吹巡城，景望之，服其膽勇。"
  },
  {
    "id": "s0078",
    "blockIndex": 25,
    "zh": "岳陽王察聞侯景克郢州，遣蔡大寶將兵一萬進據武寧，遣使至江陵，詐稱赴援。"
  },
  {
    "id": "s0078",
    "blockIndex": 25,
    "zh": "眾議欲答以侯景已破，令其退軍。"
  },
  {
    "id": "s0078",
    "blockIndex": 25,
    "zh": "湘東王繹曰：「今語以退軍，是趣之令進也。"
  },
  {
    "id": "s0078",
    "blockIndex": 25,
    "zh": "」乃使謂大寶曰：「岳陽累啟連和，不相侵犯，卿那忽據武寧？"
  },
  {
    "id": "s0078",
    "blockIndex": 25,
    "zh": "今當遣天門太守胡僧祐精甲二萬、鐵馬五千頓湕水，待時進軍。"
  },
  {
    "id": "s0078",
    "blockIndex": 25,
    "zh": "」察聞之，召其軍還。"
  },
  {
    "id": "s0078",
    "blockIndex": 25,
    "zh": "僧祐，南陽人也。"
  },
  {
    "id": "s0085",
    "blockIndex": 26,
    "zh": "五月，魏隴西襄公李虎卒。"
  },
  {
    "id": "s0086",
    "blockIndex": 27,
    "zh": "侯景晝夜攻巴陵，不克，軍中食盡，疾疫死傷太半。"
  },
  {
    "id": "s0086",
    "blockIndex": 27,
    "zh": "湘東王繹遣晉州刺史蕭惠正將兵援巴陵，惠正辭不堪，舉胡僧祐自代。"
  },
  {
    "id": "s0086",
    "blockIndex": 27,
    "zh": "僧祐時坐謀議忤旨繫獄，繹即出之，拜武猛將軍，令赴援，戒之曰：「賊若水戰，但以大艦臨之，必克。"
  },
  {
    "id": "s0086",
    "blockIndex": 27,
    "zh": "若欲步戰，自可鼓棹直就巴丘，不須交鋒也。"
  },
  {
    "id": "s0086",
    "blockIndex": 27,
    "zh": "」僧祐至湘浦，景遣任約帥銳卒五千據白□脊以待之。"
  },
  {
    "id": "s0086",
    "blockIndex": 27,
    "zh": "僧祐由它路西上，約謂其畏己，急追之，及於芊口，呼僧祐曰：「吳兒，何不早降！"
  },
  {
    "id": "s0086",
    "blockIndex": 27,
    "zh": "走何所之！"
  },
  {
    "id": "s0086",
    "blockIndex": 27,
    "zh": "」僧祐不應，潛引兵至赤沙亭；"
  },
  {
    "id": "s0086",
    "blockIndex": 27,
    "zh": "會信州刺史陸法和至，與之合軍。"
  },
  {
    "id": "s0086",
    "blockIndex": 27,
    "zh": "法和有異術，先隱於江陵百里洲，衣食居處，一如苦行沙門，或豫言吉凶，多中，人莫能測。"
  },
  {
    "id": "s0086",
    "blockIndex": 27,
    "zh": "侯景之圍台城也，或問之曰：「事將何如？"
  },
  {
    "id": "s0086",
    "blockIndex": 27,
    "zh": "」法和曰：「凡人取果，宜待熟時，不撩自落。"
  },
  {
    "id": "s0086",
    "blockIndex": 27,
    "zh": "」固問之，法和曰：「亦克亦不克。"
  },
  {
    "id": "s0086",
    "blockIndex": 27,
    "zh": "」及任約向江陵，法和自請擊之，繹許之。"
  },
  {
    "id": "s0100",
    "blockIndex": 28,
    "zh": "壬寅，約至赤亭。"
  },
  {
    "id": "s0100",
    "blockIndex": 28,
    "zh": "六月，甲辰，僧祐、法和縱兵擊之，約兵大潰，殺溺死者甚眾，擒約送江陵。"
  },
  {
    "id": "s0100",
    "blockIndex": 28,
    "zh": "景聞之，乙巳，焚營宵遁。"
  },
  {
    "id": "s0100",
    "blockIndex": 28,
    "zh": "以丁和為郢州刺史，留宋子仙等，眾號二萬，戍郢城；"
  },
  {
    "id": "s0100",
    "blockIndex": 28,
    "zh": "別將支化仁鎮魯山，范希榮行江州事，儀同三司任延和、晉州刺史夏侯威生守晉州。"
  },
  {
    "id": "s0100",
    "blockIndex": 28,
    "zh": "景與麾下兵數千，順流而下。"
  },
  {
    "id": "s0100",
    "blockIndex": 28,
    "zh": "丁和以大石磕殺鮑泉及虞預，沈於黃鶴磯。"
  },
  {
    "id": "s0100",
    "blockIndex": 28,
    "zh": "任約至江陵，繹赦之。"
  },
  {
    "id": "s0100",
    "blockIndex": 28,
    "zh": "徐文盛坐怨望，下獄死。"
  },
  {
    "id": "s0100",
    "blockIndex": 28,
    "zh": "巴州刺史余孝頃遣兄子僧重將兵救鄱陽，于慶退走。"
  },
  {
    "id": "s0110",
    "blockIndex": 29,
    "zh": "繹以王僧辯為征東將軍、尚書令，胡僧祐等皆進位號，使引兵東下。"
  },
  {
    "id": "s0110",
    "blockIndex": 29,
    "zh": "陸法和請還，既至，謂繹曰：「侯景自然平矣，蜀賊將至，請守險以待之。"
  },
  {
    "id": "s0110",
    "blockIndex": 29,
    "zh": "」乃引兵屯峽口。"
  },
  {
    "id": "s0110",
    "blockIndex": 29,
    "zh": "庚申，王僧辯至漢口，先攻魯山，擒支化仁送江陵。"
  },
  {
    "id": "s0110",
    "blockIndex": 29,
    "zh": "辛酉，攻郢州，克其羅城，斬首千級。"
  },
  {
    "id": "s0110",
    "blockIndex": 29,
    "zh": "宋子仙退據金城，僧辯四面起土山攻之。"
  },
  {
    "id": "s0116",
    "blockIndex": 30,
    "zh": "豫州刺史荀朗自巢湖出濡須邀景，破其後軍，景奔歸，船前後相失。"
  },
  {
    "id": "s0116",
    "blockIndex": 30,
    "zh": "太子船入樅陽浦，船中腹心皆勸太子因此入北，太子曰：「自國家喪敗，志不圖生，主上蒙塵，寧忍違離左右！"
  },
  {
    "id": "s0116",
    "blockIndex": 30,
    "zh": "吾今若去，乃是叛父，非避賊也。"
  },
  {
    "id": "s0116",
    "blockIndex": 30,
    "zh": "」因涕泗嗚咽，即命前進。"
  },
  {
    "id": "s0120",
    "blockIndex": 31,
    "zh": "甲子，宋子仙等困蹙，乞輸郢城，身還就景；"
  },
  {
    "id": "s0120",
    "blockIndex": 31,
    "zh": "王僧辯偽許之，命給船百艘以安其意。"
  },
  {
    "id": "s0120",
    "blockIndex": 31,
    "zh": "子仙謂為信然，浮舟將發，僧辯命杜龕帥精勇千人攀堞而上，鼓噪奄進，水軍主宋遙帥樓船，暗江雲合。"
  },
  {
    "id": "s0120",
    "blockIndex": 31,
    "zh": "子仙且戰且走，至白楊浦，大破之。"
  },
  {
    "id": "s0120",
    "blockIndex": 31,
    "zh": "周鐵虎生擒子仙及丁和，送江陵，殺之。"
  },
  {
    "id": "s0125",
    "blockIndex": 32,
    "zh": "庚午，齊主以司馬子如高祖之舊，復以為太尉。"
  },
  {
    "id": "s0126",
    "blockIndex": 33,
    "zh": "江安侯圓正為西陽太守，寬和好施，歸附者眾，有兵一萬。"
  },
  {
    "id": "s0126",
    "blockIndex": 33,
    "zh": "湘東王繹欲圖之，署為平南將軍。"
  },
  {
    "id": "s0126",
    "blockIndex": 33,
    "zh": "及至，弗見，使南平王恪與之飲，醉，因囚之內省，分其部曲，使人告其罪。"
  },
  {
    "id": "s0126",
    "blockIndex": 33,
    "zh": "荊、益之釁自此起矣。"
  },
  {
    "id": "s0130",
    "blockIndex": 34,
    "zh": "陳霸先引兵發南康，灨石舊有二十四灘，會水暴漲數丈，三百里間，巨石皆沒，霸先進頓西昌。"
  },
  {
    "id": "s0131",
    "blockIndex": 35,
    "zh": "鐵勒將伐柔然，突厥酋長土門邀擊，破之，盡降其眾五萬餘落。"
  },
  {
    "id": "s0131",
    "blockIndex": 35,
    "zh": "土門恃其強盛，求婚於柔然，柔然頭兵可汗大怒，使人詈辱之曰：「爾，我之鍛奴也，何敢發是言！"
  },
  {
    "id": "s0131",
    "blockIndex": 35,
    "zh": "」土門亦怒，殺其使者，遂與之絕，而求婚於魏；"
  },
  {
    "id": "s0131",
    "blockIndex": 35,
    "zh": "魏丞相泰以長樂公主妻之。"
  },
  {
    "id": "s0135",
    "blockIndex": 36,
    "zh": "秋，七月，乙亥，湘東王繹以長沙王韶監郢州事。"
  },
  {
    "id": "s0135",
    "blockIndex": 36,
    "zh": "丁亥，侯景還至建康。"
  },
  {
    "id": "s0135",
    "blockIndex": 36,
    "zh": "于慶自鄱陽還豫章，侯瑱門拒之，慶走江州，據郭默城。"
  },
  {
    "id": "s0135",
    "blockIndex": 36,
    "zh": "繹以瑱兗州刺史。"
  },
  {
    "id": "s0135",
    "blockIndex": 36,
    "zh": "景悉殺瑱弟。"
  },
  {
    "id": "s0140",
    "blockIndex": 37,
    "zh": "辛丑，王僧辯乘勝下湓城，陳霸先帥所部三萬人將會之，屯於巴丘。"
  },
  {
    "id": "s0140",
    "blockIndex": 37,
    "zh": "西軍乏食，霸先有糧五十萬石，分三十萬石以資之。"
  },
  {
    "id": "s0140",
    "blockIndex": 37,
    "zh": "八月，壬寅朔，王僧辯前軍襲于慶，慶棄郭默城走，范希榮亦棄尋陽城走。"
  },
  {
    "id": "s0140",
    "blockIndex": 37,
    "zh": "晉熙王僧振等起兵圍郡城，僧辯遣沙州刺史丁道貴助之，任延和等棄城走。"
  },
  {
    "id": "s0140",
    "blockIndex": 37,
    "zh": "湘東王繹命僧辯且頓尋陽以待諸軍之集。"
  },
  {
    "id": "s0145",
    "blockIndex": 38,
    "zh": "初，景既克建康，常言吳兒怯弱，易以掩取。"
  },
  {
    "id": "s0145",
    "blockIndex": 38,
    "zh": "當須拓定中原，然後為帝。"
  },
  {
    "id": "s0145",
    "blockIndex": 38,
    "zh": "景尚帝女溧陽公主，嬖之，妨於政事。"
  },
  {
    "id": "s0145",
    "blockIndex": 38,
    "zh": "王偉屢諫，景以告主，主有惡言。"
  },
  {
    "id": "s0145",
    "blockIndex": 38,
    "zh": "偉恐為所讒，因說景除帝。"
  },
  {
    "id": "s0145",
    "blockIndex": 38,
    "zh": "及景自巴陵敗歸，猛將多死，自恐不能久存，欲早登大位。"
  },
  {
    "id": "s0145",
    "blockIndex": 38,
    "zh": "王偉曰：「自古移鼎，必須廢立，既示我威權，且絕彼民望。"
  },
  {
    "id": "s0145",
    "blockIndex": 38,
    "zh": "」景從之。"
  },
  {
    "id": "s0145",
    "blockIndex": 38,
    "zh": "使前壽光殿學士謝昊為詔書，以為「弟侄爭立，星辰失次，皆由朕非正緒，召亂致災，宜禪位於豫章王棟。"
  },
  {
    "id": "s0145",
    "blockIndex": 38,
    "zh": "」使呂季略繼入，逼帝書之。"
  },
  {
    "id": "s0145",
    "blockIndex": 38,
    "zh": "棟，歡之子也。"
  },
  {
    "id": "s0156",
    "blockIndex": 39,
    "zh": "戊午，景遣衛尉卿彭雋等帥兵入殿，廢帝為晉安王，幽於永福省，悉撤內外侍衛，使突騎左右守之，牆垣悉布枳棘。"
  },
  {
    "id": "s0156",
    "blockIndex": 39,
    "zh": "庚申，下詔迎豫章王棟。"
  },
  {
    "id": "s0156",
    "blockIndex": 39,
    "zh": "棟時幽拘，廩餼甚薄，仰蔬茹為食。"
  },
  {
    "id": "s0156",
    "blockIndex": 39,
    "zh": "方與妃張氏鉏葵，法駕奄至，棟驚，不知所為，泣而升輦。"
  },
  {
    "id": "s0160",
    "blockIndex": 40,
    "zh": "景殺哀太子大器、尋陽王大心、西陽王大鈞、建平王大球、義安王大昕及王侯在建康者二十餘人。"
  },
  {
    "id": "s0160",
    "blockIndex": 40,
    "zh": "太子神明端嶷，於景黨未嘗屈意，所親竊問之，太子曰：「賊若於事義，未須見殺，吾雖陵慢呵叱，終不敢言。"
  },
  {
    "id": "s0160",
    "blockIndex": 40,
    "zh": "若見殺時至，雖一日百拜，亦無所益。"
  },
  {
    "id": "s0160",
    "blockIndex": 40,
    "zh": "」又曰：「殿下今居困□厄，而神貌怡然，不貶平日，何也？"
  },
  {
    "id": "s0160",
    "blockIndex": 40,
    "zh": "」太子曰：「吾自度死日必在賊前，若諸叔能滅賊，賊必先見殺，然後就死。"
  },
  {
    "id": "s0160",
    "blockIndex": 40,
    "zh": "若其不然，賊亦殺我以取富貴，安能以必死之命為無益之愁乎！"
  },
  {
    "id": "s0160",
    "blockIndex": 40,
    "zh": "」及難，太子顏色不變，徐曰：「久知此事，嗟其晚耳！"
  },
  {
    "id": "s0160",
    "blockIndex": 40,
    "zh": "」刑者將以衣帶絞之，太子曰：「此不能見殺。"
  },
  {
    "id": "s0160",
    "blockIndex": 40,
    "zh": "」命取帳繩絞之而絕。"
  },
  {
    "id": "s0169",
    "blockIndex": 41,
    "zh": "壬戌，棟即帝位。"
  },
  {
    "id": "s0169",
    "blockIndex": 41,
    "zh": "大赦，改元天正。"
  },
  {
    "id": "s0169",
    "blockIndex": 41,
    "zh": "太尉郭元建聞之，自秦郡馳還，謂景曰：「主上先帝太子，既無愆失，何得廢之！"
  },
  {
    "id": "s0169",
    "blockIndex": 41,
    "zh": "」景曰：「王偉勸吾，云『早除民望』。"
  },
  {
    "id": "s0169",
    "blockIndex": 41,
    "zh": "吾故從之以安天下。"
  },
  {
    "id": "s0169",
    "blockIndex": 41,
    "zh": "」元建曰：「吾挾天子令諸侯，猶懼不濟；"
  },
  {
    "id": "s0169",
    "blockIndex": 41,
    "zh": "無故廢之，乃所以自危，何安之有！"
  },
  {
    "id": "s0169",
    "blockIndex": 41,
    "zh": "」景欲迎帝復位，以棟為太孫。"
  },
  {
    "id": "s0169",
    "blockIndex": 41,
    "zh": "王偉曰：「廢立大事，豈可數改邪！"
  },
  {
    "id": "s0169",
    "blockIndex": 41,
    "zh": "」乃止。"
  },
  {
    "id": "s0179",
    "blockIndex": 42,
    "zh": "乙丑，景又使使殺南海王大臨於吳郡，南郡王大連於姑孰，安陸王大春於會稽，高唐王大壯於京口。"
  },
  {
    "id": "s0179",
    "blockIndex": 42,
    "zh": "以太子妃賜郭元建，元建曰：「豈有皇太子妃乃為人妾乎！"
  },
  {
    "id": "s0179",
    "blockIndex": 42,
    "zh": "」竟不與相見，聽使入道。"
  },
  {
    "id": "s0182",
    "blockIndex": 43,
    "zh": "丙寅，追尊昭明太子為昭明皇帝，豫章安王為安皇帝，金華敬妃為敬太皇太后，豫章太妃王氏為皇太后，妃張氏為皇后。"
  },
  {
    "id": "s0182",
    "blockIndex": 43,
    "zh": "以劉神茂為司空。"
  },
  {
    "id": "s0184",
    "blockIndex": 44,
    "zh": "九月，癸巳，齊主如趙、定二州，遂如晉陽。"
  },
  {
    "id": "s0185",
    "blockIndex": 45,
    "zh": "己亥，湘東王繹以尚書令王僧辯為江州刺史，江州刺史陳霸先為東揚州刺史。"
  },
  {
    "id": "s0186",
    "blockIndex": 46,
    "zh": "王偉說侯景弒太宗以絕眾心，景從之。"
  },
  {
    "id": "s0186",
    "blockIndex": 46,
    "zh": "冬，十月，壬寅夜，偉與左衛將軍彭雋、王修纂進酒於太宗曰：「丞相以陛下幽憂既久，使臣等來上壽。"
  },
  {
    "id": "s0186",
    "blockIndex": 46,
    "zh": "」太宗笑曰：「已禪帝位，何得言陛下！"
  },
  {
    "id": "s0186",
    "blockIndex": 46,
    "zh": "此壽酒，將不盡此乎！"
  },
  {
    "id": "s0186",
    "blockIndex": 46,
    "zh": "」於是雋等繼曲項琵琶，與太宗極飲。"
  },
  {
    "id": "s0186",
    "blockIndex": 46,
    "zh": "太宗知將見殺，因盡醉，曰：「不圖為樂之至於斯也！"
  },
  {
    "id": "s0186",
    "blockIndex": 46,
    "zh": "」既醉而寢。"
  },
  {
    "id": "s0186",
    "blockIndex": 46,
    "zh": "偉乃出，雋進土囊，修纂坐其上而殂。"
  },
  {
    "id": "s0186",
    "blockIndex": 46,
    "zh": "偉撤戶扉為棺，遷殯於城北酒庫中。"
  },
  {
    "id": "s0186",
    "blockIndex": 46,
    "zh": "太宗自幽縶之後，無復侍者及紙，乃書壁及板障，為詩及文數百篇，辭甚淒愴。"
  },
  {
    "id": "s0186",
    "blockIndex": 46,
    "zh": "景謚曰明皇帝，廟號高宗。"
  },
  {
    "id": "s0197",
    "blockIndex": 47,
    "zh": "侯景之逼江陵也，湘東王繹求援於魏，命梁、秦二州刺史宜豐侯循以南鄭與魏，召循還江陵。"
  },
  {
    "id": "s0197",
    "blockIndex": 47,
    "zh": "循以無故輸城，非忠臣之節，報曰：「請待改命。"
  },
  {
    "id": "s0197",
    "blockIndex": 47,
    "zh": "」魏太師泰遣大將軍達奚武將兵三萬取漢中，又遣大將軍王雄出子午谷，攻上津。"
  },
  {
    "id": "s0197",
    "blockIndex": 47,
    "zh": "循遣記室參軍沛人劉璠求援於武陵王紀，紀遣潼州刺史楊乾運救之。"
  },
  {
    "id": "s0197",
    "blockIndex": 47,
    "zh": "循，恢之子也。"
  },
  {
    "id": "s0202",
    "blockIndex": 48,
    "zh": "王僧辯等聞太宗殂，丙辰，啟湘東王繹，請上尊號；"
  },
  {
    "id": "s0202",
    "blockIndex": 48,
    "zh": "繹弗許。"
  },
  {
    "id": "s0204",
    "blockIndex": 49,
    "zh": "司空、東道行台劉神茂聞侯景自巴丘敗還，陰謀叛景，吳中士大夫咸勸之；"
  },
  {
    "id": "s0204",
    "blockIndex": 49,
    "zh": "乃與儀同三司尹思合、劉歸義、王曄、雲麾將軍元頵等據東陽以應江陵，遣頵及別將李佔下據建德江口。"
  },
  {
    "id": "s0204",
    "blockIndex": 49,
    "zh": "張彪攻永嘉，克之。"
  },
  {
    "id": "s0204",
    "blockIndex": 49,
    "zh": "新安民程靈洗起兵據郡以應神茂。"
  },
  {
    "id": "s0204",
    "blockIndex": 49,
    "zh": "於是浙江以東皆附江陵。"
  },
  {
    "id": "s0204",
    "blockIndex": 49,
    "zh": "湘東王繹以靈洗為譙州刺史，領新安太守。"
  },
  {
    "id": "s0210",
    "blockIndex": 50,
    "zh": "十一月，乙亥，王僧辯等復上表勸進，湘東王繹不許。"
  },
  {
    "id": "s0210",
    "blockIndex": 50,
    "zh": "戊寅，繹以湘州刺史安南侯方矩為中衛將軍以自副。"
  },
  {
    "id": "s0210",
    "blockIndex": 50,
    "zh": "方矩，方諸之弟也。"
  },
  {
    "id": "s0210",
    "blockIndex": 50,
    "zh": "以南平王恪為湘州刺史。"
  },
  {
    "id": "s0214",
    "blockIndex": 51,
    "zh": "侯景以趙伯超為東道行台，據錢塘；"
  },
  {
    "id": "s0214",
    "blockIndex": 51,
    "zh": "以田遷為軍司，據富春；"
  },
  {
    "id": "s0214",
    "blockIndex": 51,
    "zh": "以李慶緒為中軍都督，謝答仁為右廂都督，李遵為左廂都督，以討劉神茂。"
  },
  {
    "id": "s0217",
    "blockIndex": 52,
    "zh": "己卯，加侯景九錫，漢國置丞相以下官。"
  },
  {
    "id": "s0217",
    "blockIndex": 52,
    "zh": "己丑，豫章王棟禪位於景，景即皇帝位於南郊。"
  },
  {
    "id": "s0217",
    "blockIndex": 52,
    "zh": "還，登太極殿，其黨數萬，皆吹脣呼噪而上。"
  },
  {
    "id": "s0217",
    "blockIndex": 52,
    "zh": "大赦，改元太始。"
  },
  {
    "id": "s0217",
    "blockIndex": 52,
    "zh": "封棟為淮陰王，並其二弟橋、樛同鎖於密室。"
  },
  {
    "id": "s0222",
    "blockIndex": 53,
    "zh": "王偉請立七廟，景曰：「何謂七廟？"
  },
  {
    "id": "s0222",
    "blockIndex": 53,
    "zh": "」偉曰：「天子祭七世祖考。"
  },
  {
    "id": "s0222",
    "blockIndex": 53,
    "zh": "」並請七世諱，景曰：「前世吾不復記，唯記我父名標；"
  },
  {
    "id": "s0222",
    "blockIndex": 53,
    "zh": "且彼在朔州，那得來啖此！"
  },
  {
    "id": "s0222",
    "blockIndex": 53,
    "zh": "」眾咸笑之。"
  },
  {
    "id": "s0222",
    "blockIndex": 53,
    "zh": "景黨有知景祖名乙羽周者；"
  },
  {
    "id": "s0222",
    "blockIndex": 53,
    "zh": "自外皆王偉制其名位，追尊父標為元皇帝。"
  },
  {
    "id": "s0229",
    "blockIndex": 54,
    "zh": "景之作相也，以西州為府，文武無尊卑皆引接，及居禁中，非故舊不得見，由是諸將多怨望。"
  },
  {
    "id": "s0229",
    "blockIndex": 54,
    "zh": "景好獨乘小馬，彈射飛鳥，王偉每禁止之，不許輕出。"
  },
  {
    "id": "s0229",
    "blockIndex": 54,
    "zh": "景鬱鬱不樂，更成失志，曰：「吾無事為帝，與受擯不殊。"
  },
  {
    "id": "s0233",
    "blockIndex": 55,
    "zh": "壬辰，湘東王以長沙王韶為郢州刺史。"
  },
  {
    "id": "s0234",
    "blockIndex": 56,
    "zh": "益州長史劉孝勝等勸武陵王紀稱帝，紀雖未許，而大造乘輿車服。"
  },
  {
    "id": "s0235",
    "blockIndex": 57,
    "zh": "十二月，丁未，謝答仁、李慶緒攻建德，擒元頵、李占送建康，景截其手足以徇，經日乃死。"
  },
  {
    "id": "s0236",
    "blockIndex": 58,
    "zh": "齊主每出入，常以中山王自隨，王妃太原公主恆為之嘗飲食，護視之。"
  },
  {
    "id": "s0236",
    "blockIndex": 58,
    "zh": "是月，齊主飲公主酒，使人鴆中山王，殺之，並其三子，謚王曰魏孝靜皇帝，葬於鄴西漳北。"
  },
  {
    "id": "s0236",
    "blockIndex": 58,
    "zh": "其後齊主忽掘其陵，投梓宮於漳水。"
  },
  {
    "id": "s0236",
    "blockIndex": 58,
    "zh": "齊主初受禪，魏神主悉寄於七帝寺，至是，亦取焚之。"
  },
  {
    "id": "s0240",
    "blockIndex": 59,
    "zh": "彭城公元韶以高氏婿，寵遇異於諸元。"
  },
  {
    "id": "s0240",
    "blockIndex": 59,
    "zh": "開府儀同三司美陽公元暉業以位望隆重，又志氣不倫，尤為齊主所忌，從齊主在晉陽。"
  },
  {
    "id": "s0240",
    "blockIndex": 59,
    "zh": "暉業於宮門外罵韶曰：「爾不及一老嫗，負璽與人。"
  },
  {
    "id": "s0240",
    "blockIndex": 59,
    "zh": "何不擊碎之！"
  },
  {
    "id": "s0240",
    "blockIndex": 59,
    "zh": "我出此言，知即死，爾亦詎得幾時！"
  },
  {
    "id": "s0240",
    "blockIndex": 59,
    "zh": "」齊主聞而殺之，及臨淮公元孝友，皆鑿汾水冰，沉其屍。"
  },
  {
    "id": "s0240",
    "blockIndex": 59,
    "zh": "孝友，彧之弟也。"
  },
  {
    "id": "s0240",
    "blockIndex": 59,
    "zh": "齊主嘗剃元韶鬢鬚，加之粉黛以自隨，曰：「吾以彭城為嬪御。"
  },
  {
    "id": "s0240",
    "blockIndex": 59,
    "zh": "」言其懦弱如婦人也。"
  },
  {
    "id": "s0249",
    "blockIndex": 60,
    "zh": "世祖孝元皇帝上承聖元年（"
  },
  {
    "id": "s0249",
    "blockIndex": 60,
    "zh": "壬申，公元五五二年）"
  },
  {
    "id": "s0251",
    "blockIndex": 61,
    "zh": "春，正月，湘東王以南平內史王褒為吏部尚書。"
  },
  {
    "id": "s0251",
    "blockIndex": 61,
    "zh": "褒，騫之孫也。"
  },
  {
    "id": "s0253",
    "blockIndex": 62,
    "zh": "齊人屢侵侯景邊地，甲戌，景遣郭元建帥步軍趣小峴，侯子鑒帥舟師向濡須，己卯，至合肥；"
  },
  {
    "id": "s0253",
    "blockIndex": 62,
    "zh": "齊人閉城不出，乃引還。"
  },
  {
    "id": "s0255",
    "blockIndex": 63,
    "zh": "丙申，齊主伐庫莫奚，大破之，俘獲四千人，雜畜十餘萬。"
  },
  {
    "id": "s0256",
    "blockIndex": 64,
    "zh": "齊主連年出塞，給事中兼中書舍人唐邕練習軍書，自督將以降勞效本末及四方軍士強弱多少，番代往還，器械精粗，糧儲虛實，靡不諳悉。"
  },
  {
    "id": "s0256",
    "blockIndex": 64,
    "zh": "或於帝前簡閱，雖數千人，不執文簿，唱其姓名，未嘗謬誤。"
  },
  {
    "id": "s0256",
    "blockIndex": 64,
    "zh": "帝常曰：「唐邕強幹，一人當千。"
  },
  {
    "id": "s0256",
    "blockIndex": 64,
    "zh": "」又曰：「邕每有軍事，手作文書，口且處分，耳又聽受，實異人也！"
  },
  {
    "id": "s0256",
    "blockIndex": 64,
    "zh": "」寵待賞賜，群臣莫及。"
  },
  {
    "id": "s0261",
    "blockIndex": 65,
    "zh": "魏將王雄取上津、魏興，東梁州刺史安康李遷哲軍敗。"
  },
  {
    "id": "s0261",
    "blockIndex": 65,
    "zh": "降之。"
  },
  {
    "id": "s0263",
    "blockIndex": 66,
    "zh": "突闕土門襲擊柔然，大破之。"
  },
  {
    "id": "s0263",
    "blockIndex": 66,
    "zh": "柔然頭兵可汗自殺，其太子庵羅辰及阿那瑰從弟登注俟利、登注子庫提並帥眾奔齊，餘眾復立登注次子鐵伐為主。"
  },
  {
    "id": "s0263",
    "blockIndex": 66,
    "zh": "土門自號伊利可汗，號其妻為可賀敦，子弟謂之特勒，別將兵者皆謂之設。"
  },
  {
    "id": "s0266",
    "blockIndex": 67,
    "zh": "湘東王命王僧辯等東擊侯景。"
  },
  {
    "id": "s0266",
    "blockIndex": 67,
    "zh": "二月，庚子，諸軍發尋陽，舳艫數百里。"
  },
  {
    "id": "s0266",
    "blockIndex": 67,
    "zh": "陳霸先帥甲士三萬，舟艦二千，自南江出湓口，會僧辯於白茅灣，築壇歃血，共讀盟文，流涕慷慨。"
  },
  {
    "id": "s0266",
    "blockIndex": 67,
    "zh": "癸卯，僧辯使侯瑱南陵、鵲頭二戍，克之。"
  },
  {
    "id": "s0266",
    "blockIndex": 67,
    "zh": "戊申，僧辯等軍於大雷；"
  },
  {
    "id": "s0266",
    "blockIndex": 67,
    "zh": "丙辰，發鵲頭。"
  },
  {
    "id": "s0266",
    "blockIndex": 67,
    "zh": "戊午，侯子鑒還至戰鳥，西軍奄至，子鑒驚懼，奔還淮南。"
  },
  {
    "id": "s0273",
    "blockIndex": 68,
    "zh": "侯景儀同三司謝答仁攻劉神茂於東陽，程靈洗、張彪皆勒兵將救之，神茂欲專其功，不許，營於下淮。"
  },
  {
    "id": "s0273",
    "blockIndex": 68,
    "zh": "或謂神茂曰：「賊長於野戰，下淮地平，四面受敵，不如據七里瀨，賊必不能進。"
  },
  {
    "id": "s0273",
    "blockIndex": 68,
    "zh": "」不從。"
  },
  {
    "id": "s0273",
    "blockIndex": 68,
    "zh": "神茂偏裨多北人，不與神茂同心，別將王曄、酈通並據外營，降於答仁，劉歸義、尹思合等棄城走。"
  },
  {
    "id": "s0273",
    "blockIndex": 68,
    "zh": "神茂孤危，辛未，亦降於答仁，答仁送之建康。"
  },
  {
    "id": "s0278",
    "blockIndex": 69,
    "zh": "癸酉，王僧辯等至蕪湖，侯景守將張黑棄城走。"
  },
  {
    "id": "s0278",
    "blockIndex": 69,
    "zh": "景聞之，甚懼，下詔赦湘東王繹、王僧辯之罪，眾鹹笑之。"
  },
  {
    "id": "s0278",
    "blockIndex": 69,
    "zh": "侯子鑒據姑孰南洲以拒西師，景遣其黨史安和等將兵二千助之。"
  },
  {
    "id": "s0278",
    "blockIndex": 69,
    "zh": "三月，己巳朔，景下詔欲自至姑孰，又遣人戒子鑒曰：「西人善水戰，勿與爭鋒；"
  },
  {
    "id": "s0278",
    "blockIndex": 69,
    "zh": "往年任約之敗，良為此也。"
  },
  {
    "id": "s0278",
    "blockIndex": 69,
    "zh": "若得步騎一交，必當可破，汝但結營岸上，引船入浦以待之。"
  },
  {
    "id": "s0278",
    "blockIndex": 69,
    "zh": "」子鑒乃捨舟登岸，閉營不出。"
  },
  {
    "id": "s0278",
    "blockIndex": 69,
    "zh": "僧辯等停軍蕪湖十餘日，景黨大喜，告景曰：「西師畏吾之強，勢將遁矣，不擊，且失之。"
  },
  {
    "id": "s0278",
    "blockIndex": 69,
    "zh": "」景乃覆命子鑒為水戰之備。"
  },
  {
    "id": "s0287",
    "blockIndex": 70,
    "zh": "丁丑，僧辯至姑孰，子鑒帥步騎萬餘人度洲，於岸挑戰，又以□鳥□了千艘載戰士。"
  },
  {
    "id": "s0287",
    "blockIndex": 70,
    "zh": "僧辯麾細船皆令退縮，留大艦夾泊兩岸。"
  },
  {
    "id": "s0287",
    "blockIndex": 70,
    "zh": "子鑒之眾謂水軍欲退，爭出趨之；"
  },
  {
    "id": "s0287",
    "blockIndex": 70,
    "zh": "大艦斷其歸路，鼓噪大呼，合戰中江，子鑒大敗，士卒赴水死者數千人。"
  },
  {
    "id": "s0287",
    "blockIndex": 70,
    "zh": "子鑒僅以身免，收散卒走還建康，據東府。"
  },
  {
    "id": "s0287",
    "blockIndex": 70,
    "zh": "僧辯留虎臣將軍莊丘慧達鎮姑孰，引軍而前，歷陽戍迎降。"
  },
  {
    "id": "s0287",
    "blockIndex": 70,
    "zh": "景聞子鑒敗，大懼，涕下覆面，引衾而臥，良久方起，歎曰：「誤殺乃公！"
  },
  {
    "id": "s0295",
    "blockIndex": 71,
    "zh": "庚辰，僧辯督諸軍至張公洲，辛巳，乘潮入淮，進至禪靈寺前。"
  },
  {
    "id": "s0295",
    "blockIndex": 71,
    "zh": "景召石頭津主張賓，使引淮中□叉□步及海艟，以石縋之，塞淮口；"
  },
  {
    "id": "s0295",
    "blockIndex": 71,
    "zh": "緣淮作城，自石頭至於朱雀街，十餘里中，樓堞相接。"
  },
  {
    "id": "s0295",
    "blockIndex": 71,
    "zh": "僧辯問計於陳霸先，霸先曰：「前柳仲禮數十萬兵隔水而坐，韋粲在青溪，竟不度岸，賊登高望之，表裡俱盡，故能覆我師徒。"
  },
  {
    "id": "s0295",
    "blockIndex": 71,
    "zh": "今圍石頭，須度北岸。"
  },
  {
    "id": "s0295",
    "blockIndex": 71,
    "zh": "諸將若不能當鋒，霸先請先往立柵。"
  },
  {
    "id": "s0295",
    "blockIndex": 71,
    "zh": "」壬午，霸先於石頭西落星山築柵，眾軍次連八城，直出石頭西北。"
  },
  {
    "id": "s0295",
    "blockIndex": 71,
    "zh": "景恐西州路絕，自帥侯子鑒等亦於石頭東北築五城以遏大路。"
  },
  {
    "id": "s0295",
    "blockIndex": 71,
    "zh": "景使王偉等守台城。"
  },
  {
    "id": "s0295",
    "blockIndex": 71,
    "zh": "乙酉，景殺湘東王世子方諸、前平東將軍杜幼安。"
  },
  {
    "id": "s0305",
    "blockIndex": 72,
    "zh": "劉神茂至建康，丙戌，景命為大坐刀碓，先進其足，寸寸斬之，以至於頭。"
  },
  {
    "id": "s0305",
    "blockIndex": 72,
    "zh": "留異外同神茂而潛通於景，故得免禍。"
  },
  {
    "id": "s0307",
    "blockIndex": 73,
    "zh": "丁亥，王僧辯進軍招提寺北，侯景帥眾萬餘人、鐵騎八百餘匹陳於西州之西。"
  },
  {
    "id": "s0307",
    "blockIndex": 73,
    "zh": "陳霸先曰：「我眾賊寡，應分其兵勢，以強制弱；"
  },
  {
    "id": "s0307",
    "blockIndex": 73,
    "zh": "何故聚其鋒銳，令致死於我！"
  },
  {
    "id": "s0307",
    "blockIndex": 73,
    "zh": "」乃命諸將分處置兵。"
  },
  {
    "id": "s0307",
    "blockIndex": 73,
    "zh": "景衝將軍王僧志陳，僧志小縮，霸先遣將軍安陸徐度將弩手二千橫截其後，景兵乃卻。"
  },
  {
    "id": "s0307",
    "blockIndex": 73,
    "zh": "霸先與王琳、杜龕等以鐵騎乘之，僧辯以大軍繼進，景兵敗退，據其柵。"
  },
  {
    "id": "s0307",
    "blockIndex": 73,
    "zh": "龕，岸之兄子也。"
  },
  {
    "id": "s0307",
    "blockIndex": 73,
    "zh": "景儀同三司盧暉略守石頭城，開北門降，僧辯入據之。"
  },
  {
    "id": "s0307",
    "blockIndex": 73,
    "zh": "景與霸先殊死戰，景帥百餘騎，棄槊執刀，左右衝陳。"
  },
  {
    "id": "s0307",
    "blockIndex": 73,
    "zh": "陳不動，眾遂大潰，諸軍逐北至西明門。"
  },
  {
    "id": "s0317",
    "blockIndex": 74,
    "zh": "景至闕下，不敢入台，召王偉責之曰：「爾令我為帝，今日誤我！"
  },
  {
    "id": "s0317",
    "blockIndex": 74,
    "zh": "」偉不能對，繞闕而藏。"
  },
  {
    "id": "s0317",
    "blockIndex": 74,
    "zh": "景欲走，偉執鞚諫曰：「自古豈有叛天子邪！"
  },
  {
    "id": "s0317",
    "blockIndex": 74,
    "zh": "宮中衛士，猶足一戰，棄此，將欲安之？"
  },
  {
    "id": "s0317",
    "blockIndex": 74,
    "zh": "」景曰：「我昔敗賀拔勝，破葛榮，揚名河、朔，度江平台城，降柳仲禮如反掌；"
  },
  {
    "id": "s0317",
    "blockIndex": 74,
    "zh": "今日天亡我也！"
  },
  {
    "id": "s0317",
    "blockIndex": 74,
    "zh": "」因仰觀石闕，歎息久之。"
  },
  {
    "id": "s0317",
    "blockIndex": 74,
    "zh": "以皮囊盛其江東所生二子，掛之鞍後，與房世貴等百餘騎東走，欲就謝答仁於吳。"
  },
  {
    "id": "s0317",
    "blockIndex": 74,
    "zh": "侯子鑒、王偉、陳慶奔朱方。"
  },
  {
    "id": "s0317",
    "blockIndex": 74,
    "zh": "僧辯命裴之橫、杜龕屯杜姥宅，杜崱入據台城。"
  },
  {
    "id": "s0317",
    "blockIndex": 74,
    "zh": "僧辯不戢軍士，剽掠居民。"
  },
  {
    "id": "s0317",
    "blockIndex": 74,
    "zh": "男女裸露，自石頭至於東城，號泣滿道。"
  },
  {
    "id": "s0317",
    "blockIndex": 74,
    "zh": "是夜，軍士遺火。"
  },
  {
    "id": "s0317",
    "blockIndex": 74,
    "zh": "焚太極殿及東西堂，寶器、羽儀、輦輅無遺。"
  },
  {
    "id": "s0331",
    "blockIndex": 75,
    "zh": "戊子，僧辯命侯瑱等帥精甲五千追景。"
  },
  {
    "id": "s0331",
    "blockIndex": 75,
    "zh": "王克、元羅等帥台內舊臣迎僧辯於道，僧辯勞克曰：「甚苦，事夷狄之君。"
  },
  {
    "id": "s0331",
    "blockIndex": 75,
    "zh": "」克不能對。"
  },
  {
    "id": "s0331",
    "blockIndex": 75,
    "zh": "又問：「璽紱何在？"
  },
  {
    "id": "s0331",
    "blockIndex": 75,
    "zh": "」克良久曰：「趙平原持去。"
  },
  {
    "id": "s0331",
    "blockIndex": 75,
    "zh": "」僧辯曰：「王氏百世卿族，一朝而墜。"
  },
  {
    "id": "s0331",
    "blockIndex": 75,
    "zh": "」僧辯迎太宗梓宮升朝堂，帥百官哭踴如禮。"
  },
  {
    "id": "s0338",
    "blockIndex": 76,
    "zh": "己丑，僧辯等上表勸進，且迎都建業。"
  },
  {
    "id": "s0338",
    "blockIndex": 76,
    "zh": "湘東王答曰：「淮海長鯨，雖雲授首；"
  },
  {
    "id": "s0338",
    "blockIndex": 76,
    "zh": "襄陽短狐，未全革面。"
  },
  {
    "id": "s0338",
    "blockIndex": 76,
    "zh": "太平玉燭，爾乃議之。"
  },
  {
    "id": "s0343",
    "blockIndex": 77,
    "zh": "庚寅，南兗州刺史郭元建、秦郡戍主郭正買、陽平戍主魯伯和、行南徐州事郭子仲，並據城降。"
  },
  {
    "id": "s0344",
    "blockIndex": 78,
    "zh": "僧辯之發江陵也，啟湘東王曰：「平賊之後，嗣君萬福，未審何以為禮？"
  },
  {
    "id": "s0344",
    "blockIndex": 78,
    "zh": "」王曰：「六門之內，自極兵威。"
  },
  {
    "id": "s0344",
    "blockIndex": 78,
    "zh": "」僧辯曰：「討賊之謀，臣為己任，成濟之事，請別舉人。"
  },
  {
    "id": "s0344",
    "blockIndex": 78,
    "zh": "」王乃密諭宣猛將軍朱買臣，使為之所。"
  },
  {
    "id": "s0344",
    "blockIndex": 78,
    "zh": "及景敗，太宗已殂，豫章王棟及二弟橋、樛相扶出於密室，逢杜崱則於道，為去其鎖。"
  },
  {
    "id": "s0344",
    "blockIndex": 78,
    "zh": "二弟曰：「今日始免橫死矣！"
  },
  {
    "id": "s0344",
    "blockIndex": 78,
    "zh": "」棟曰：「倚伏難知，吾猶有懼！"
  },
  {
    "id": "s0344",
    "blockIndex": 78,
    "zh": "」辛卯，遇朱買臣，呼之就船共飲，未竟，並沉於水。"
  },
  {
    "id": "s0352",
    "blockIndex": 79,
    "zh": "僧辯遣陳霸先將兵向廣陵受郭元建等降，又遣使者往安慰之。"
  },
  {
    "id": "s0352",
    "blockIndex": 79,
    "zh": "諸將多私使別索馬仗，會侯子鑒度江至廣陵，謂元建等曰：「我曹，梁之深仇，何顏復見其主！"
  },
  {
    "id": "s0352",
    "blockIndex": 79,
    "zh": "不若投北，可得還鄉。"
  },
  {
    "id": "s0352",
    "blockIndex": 79,
    "zh": "」遂皆降齊。"
  },
  {
    "id": "s0352",
    "blockIndex": 79,
    "zh": "霸先至歐陽，齊行台辛術已據廣陵。"
  },
  {
    "id": "s0357",
    "blockIndex": 80,
    "zh": "王偉與侯子鑒相失，直瀆戍主黃公喜獲之，送建康。"
  },
  {
    "id": "s0357",
    "blockIndex": 80,
    "zh": "王僧辯問曰：「卿為賊相，不能死節，而求活草間邪？"
  },
  {
    "id": "s0357",
    "blockIndex": 80,
    "zh": "」偉曰：「廢興，命也。"
  },
  {
    "id": "s0357",
    "blockIndex": 80,
    "zh": "使漢帝早從偉言，明公豈有今日！"
  },
  {
    "id": "s0357",
    "blockIndex": 80,
    "zh": "」尚書左丞虞騭嘗為偉所辱，乃唾其面。"
  },
  {
    "id": "s0357",
    "blockIndex": 80,
    "zh": "偉曰：「君不讀書，不足與語！"
  },
  {
    "id": "s0357",
    "blockIndex": 80,
    "zh": "」騭慚而退。"
  },
  {
    "id": "s0357",
    "blockIndex": 80,
    "zh": "僧辯命羅州刺史徐嗣徽鎮朱方。"
  },
  {
    "id": "s0365",
    "blockIndex": 81,
    "zh": "壬辰，侯景至晉陵，得田遷餘兵，因驅掠居民，東趨吳郡。"
  },
  {
    "id": "s0366",
    "blockIndex": 82,
    "zh": "夏，四月，齊主使大都督潘樂與郭元建將兵五萬攻陽平。"
  },
  {
    "id": "s0366",
    "blockIndex": 82,
    "zh": "拔之。"
  },
  {
    "id": "s0368",
    "blockIndex": 83,
    "zh": "王僧辯啟陳霸先鎮京口。"
  },
  {
    "id": "s0369",
    "blockIndex": 84,
    "zh": "益州刺史、太尉武陵王紀，頗有武略，在蜀十七年，南開寧州、越巂，西通資陵、吐谷渾，內修耕桑鹽鐵之政，外通商賈遠方之利，故能殖其財用，器甲殷積，有馬八千匹。"
  },
  {
    "id": "s0369",
    "blockIndex": 84,
    "zh": "聞侯景陷台城，湘東王將討之，謂僚佐曰：「七官文士，豈能匡濟！"
  },
  {
    "id": "s0369",
    "blockIndex": 84,
    "zh": "」內寢柏殿柱繞節生花，紀以為己瑞。"
  },
  {
    "id": "s0369",
    "blockIndex": 84,
    "zh": "乙巳，即皇帝位，改元天正，立子圓照為皇太子，圓正為西陽王，圓滿為竟陵王，圓普為譙王，圓肅為宜都王。"
  },
  {
    "id": "s0369",
    "blockIndex": 84,
    "zh": "以巴西、梓潼二郡太守永豐侯手為為征西大將軍、益州刺史，封秦郡王。"
  },
  {
    "id": "s0369",
    "blockIndex": 84,
    "zh": "司馬王僧略、直兵參軍徐怦固諫，不從。"
  },
  {
    "id": "s0369",
    "blockIndex": 84,
    "zh": "僧略，僧辯之弟；"
  },
  {
    "id": "s0369",
    "blockIndex": 84,
    "zh": "怦，勉之從子也。"
  },
  {
    "id": "s0377",
    "blockIndex": 85,
    "zh": "初，台城之圍，怦勸紀速入援，紀意不欲行，內銜之。"
  },
  {
    "id": "s0377",
    "blockIndex": 85,
    "zh": "會蜀人費合告怦反，怦有與將帥書云：「事事往人口具。"
  },
  {
    "id": "s0377",
    "blockIndex": 85,
    "zh": "」紀即以為反征，謂怦曰：「以卿舊情，當使諸子無恙。"
  },
  {
    "id": "s0377",
    "blockIndex": 85,
    "zh": "」對曰：「生兒悉如殿下，留之何益！"
  },
  {
    "id": "s0377",
    "blockIndex": 85,
    "zh": "」紀乃盡誅之，梟首於市，亦殺王僧略。"
  },
  {
    "id": "s0377",
    "blockIndex": 85,
    "zh": "永豐侯手為歎曰：「王事不成矣！"
  },
  {
    "id": "s0377",
    "blockIndex": 85,
    "zh": "善人，國之基也，今先殺之，不亡何待！"
  },
  {
    "id": "s0385",
    "blockIndex": 86,
    "zh": "紀征宜豐侯咨議參軍劉璠為中書侍郎，使者八反，乃至。"
  },
  {
    "id": "s0385",
    "blockIndex": 86,
    "zh": "紀令劉孝勝深布腹心，璠苦求還。"
  },
  {
    "id": "s0385",
    "blockIndex": 86,
    "zh": "中記室韋登私謂璠曰：「殿下忍而畜憾，足下不留，將致大禍，孰若共構大夏，使身名俱美哉！"
  },
  {
    "id": "s0385",
    "blockIndex": 86,
    "zh": "」璠正色曰：「卿欲緩頰於我邪？"
  },
  {
    "id": "s0385",
    "blockIndex": 86,
    "zh": "我與府侯分義已定，豈以夷險易其心乎！"
  },
  {
    "id": "s0385",
    "blockIndex": 86,
    "zh": "殿下方布大義於天下，終不逞志於一夫。"
  },
  {
    "id": "s0385",
    "blockIndex": 86,
    "zh": "」紀知必不為己用，乃厚禮遣之。"
  },
  {
    "id": "s0385",
    "blockIndex": 86,
    "zh": "以宜豐侯循為益州刺史，封隨郡王，以璠為循府長史、蜀郡太守。"
  },
  {
    "id": "s0393",
    "blockIndex": 87,
    "zh": "謝答仁討劉神茂還，至富陽，聞侯景敗走，帥萬人欲北出候之，趙伯超據錢塘拒之。"
  },
  {
    "id": "s0393",
    "blockIndex": 87,
    "zh": "侯景進至嘉興，聞伯超叛之，乃退據吳。"
  },
  {
    "id": "s0393",
    "blockIndex": 87,
    "zh": "己酉，侯瑱追及景於松江，景猶有船二百艘，眾數千人，瑱進擊，敗之，擒彭雋、田遷、房世貴、蔡壽樂、王伯丑。"
  },
  {
    "id": "s0393",
    "blockIndex": 87,
    "zh": "瑱生剖雋腹，抽其腸。"
  },
  {
    "id": "s0393",
    "blockIndex": 87,
    "zh": "雋猶不死，手自收之，乃斬之。"
  },
  {
    "id": "s0398",
    "blockIndex": 88,
    "zh": "景與腹心數十人單舸走，推墮二子於水，將入海，瑱遣副將焦僧度追之。"
  },
  {
    "id": "s0398",
    "blockIndex": 88,
    "zh": "景納羊侃之女為小妻，以其兄昆為庫直都督，待之甚厚。"
  },
  {
    "id": "s0398",
    "blockIndex": 88,
    "zh": "昆隨景東走，與景所親王元禮、謝葳蕤密圖之。"
  },
  {
    "id": "s0398",
    "blockIndex": 88,
    "zh": "葳蕤，答仁之弟也。"
  },
  {
    "id": "s0398",
    "blockIndex": 88,
    "zh": "景下海，欲向蒙山，己卯，景晝寢；"
  },
  {
    "id": "s0398",
    "blockIndex": 88,
    "zh": "昆語海師：「此中何處有蒙山，汝但聽我處分。"
  },
  {
    "id": "s0398",
    "blockIndex": 88,
    "zh": "」遂直向京口。"
  },
  {
    "id": "s0398",
    "blockIndex": 88,
    "zh": "至胡豆洲，景覺，大驚；"
  },
  {
    "id": "s0398",
    "blockIndex": 88,
    "zh": "問岸上人，云「郭元建猶在廣陵」，景大喜，將依之。"
  },
  {
    "id": "s0398",
    "blockIndex": 88,
    "zh": "昆拔刀，叱海師向京口，因謂景曰：「吾等為王效力多矣，今至於此，終無所成，欲就乞頭以取富貴。"
  },
  {
    "id": "s0398",
    "blockIndex": 88,
    "zh": "」景未及答，白刃交下。"
  },
  {
    "id": "s0398",
    "blockIndex": 88,
    "zh": "景欲投水，昆以刀斫之。"
  },
  {
    "id": "s0398",
    "blockIndex": 88,
    "zh": "景走入船中，以佩刀抉船底，昆以槊刺殺之。"
  },
  {
    "id": "s0398",
    "blockIndex": 88,
    "zh": "尚書右僕射索超世在別船，葳蕤以景命召而執之。"
  },
  {
    "id": "s0398",
    "blockIndex": 88,
    "zh": "南徐州刺史徐嗣徽斬超世，以鹽內景腹中，送其屍於建康。"
  },
  {
    "id": "s0398",
    "blockIndex": 88,
    "zh": "僧辯傳首江陵，截其手，使謝葳蕤送於齊；"
  },
  {
    "id": "s0398",
    "blockIndex": 88,
    "zh": "暴景屍於市，士民爭取食之，並骨皆盡；"
  },
  {
    "id": "s0398",
    "blockIndex": 88,
    "zh": "溧陽公主亦預食焉。"
  },
  {
    "id": "s0398",
    "blockIndex": 88,
    "zh": "初，景之五子在北齊，世宗剝其長子面而烹之，幼者皆下蠶室。"
  },
  {
    "id": "s0398",
    "blockIndex": 88,
    "zh": "齊顯祖即位，夢獼猴坐其御床，乃盡烹之。"
  },
  {
    "id": "s0398",
    "blockIndex": 88,
    "zh": "趙伯超、謝答仁皆降於侯瑱，瑱並田遷等送建康。"
  },
  {
    "id": "s0398",
    "blockIndex": 88,
    "zh": "王僧辯斬房世貴於市，送王偉、呂季略、周石珍、嚴但、趙伯超、伏知命於江陵。"
  },
  {
    "id": "s0420",
    "blockIndex": 89,
    "zh": "丁巳，湘東王下令解嚴。"
  },
  {
    "id": "s0421",
    "blockIndex": 90,
    "zh": "乙丑，葬簡文帝於莊陵，廟號太宗。"
  },
  {
    "id": "s0421",
    "blockIndex": 90,
    "zh": "侯景之敗也，以傳國璽自隨，使其侍中兼平原太守趙思賢掌之，曰：「若我死，宜沉於江，勿令吳兒復得之。"
  },
  {
    "id": "s0421",
    "blockIndex": 90,
    "zh": "」思賢自京口濟江，遇盜，從者棄之草間，至廣陵，以告郭元建。"
  },
  {
    "id": "s0421",
    "blockIndex": 90,
    "zh": "元建取之，以與辛術，壬申，術送之至鄴。"
  },
  {
    "id": "s0425",
    "blockIndex": 91,
    "zh": "甲申，齊以吏部尚書楊愔為右僕射，以太原公主妻之。"
  },
  {
    "id": "s0425",
    "blockIndex": 91,
    "zh": "公主即魏孝靜帝之後也。"
  },
  {
    "id": "s0427",
    "blockIndex": 92,
    "zh": "楊乾運至劍北，魏達奚武逆擊之，大破乾運於白馬，陳其俘馘於南鄭城下，且遣人辱宜豐侯循。"
  },
  {
    "id": "s0427",
    "blockIndex": 92,
    "zh": "循怒，出兵與戰，都督楊紹伏兵擊之，殺傷殆盡。"
  },
  {
    "id": "s0427",
    "blockIndex": 92,
    "zh": "劉愔還至白馬西，為武所獲，送長安。"
  },
  {
    "id": "s0427",
    "blockIndex": 92,
    "zh": "太師泰素聞其名，待之如舊交。"
  },
  {
    "id": "s0427",
    "blockIndex": 92,
    "zh": "時南鄭久不下，武請屠之，泰將許之。"
  },
  {
    "id": "s0427",
    "blockIndex": 92,
    "zh": "璠請之於朝，泰怒，不許；"
  },
  {
    "id": "s0427",
    "blockIndex": 92,
    "zh": "璠泣請不已，泰曰：「事人當如是。"
  },
  {
    "id": "s0427",
    "blockIndex": 92,
    "zh": "」乃從其請。"
  },
  {
    "id": "s0435",
    "blockIndex": 93,
    "zh": "五月，庚午，司空南平王恪等復勸進，湘東王猶不受，遣侍中豐城侯泰等謁山陵，修復廟社。"
  },
  {
    "id": "s0436",
    "blockIndex": 94,
    "zh": "戊寅，侯景首至江陵，梟之於市三日，煮而漆之，以付武庫。"
  },
  {
    "id": "s0436",
    "blockIndex": 94,
    "zh": "庚辰，以南平王恪為揚州刺史。"
  },
  {
    "id": "s0436",
    "blockIndex": 94,
    "zh": "甲申，以王僧辯為司徒、鎮衛將軍，封長寧公。"
  },
  {
    "id": "s0436",
    "blockIndex": 94,
    "zh": "陳霸先為征虜將軍、開府儀同三司，封長城縣侯。"
  },
  {
    "id": "s0440",
    "blockIndex": 95,
    "zh": "乙酉，誅侯景所署尚書僕射王偉、左民尚書呂季略、少府周石珍、舍人嚴但於市。"
  },
  {
    "id": "s0440",
    "blockIndex": 95,
    "zh": "趙伯超、伏知命餓死於獄。"
  },
  {
    "id": "s0440",
    "blockIndex": 95,
    "zh": "以謝答仁不失禮於太宗，特宥之。"
  },
  {
    "id": "s0440",
    "blockIndex": 95,
    "zh": "王偉於獄中上五百言詩，湘東王愛其才，欲宥之。"
  },
  {
    "id": "s0440",
    "blockIndex": 95,
    "zh": "有嫉之者，言於王曰：「前日偉作檄文甚佳。"
  },
  {
    "id": "s0440",
    "blockIndex": 95,
    "zh": "」王求而視之，檄曰：「項羽重瞳，尚有烏江之敗；"
  },
  {
    "id": "s0440",
    "blockIndex": 95,
    "zh": "湘東一目，寧為赤縣所歸！"
  },
  {
    "id": "s0440",
    "blockIndex": 95,
    "zh": "」王大怒，釘其舌於柱，剜腹、臠肉而殺之。"
  },
  {
    "id": "s0448",
    "blockIndex": 96,
    "zh": "丙戌，齊合州刺史斛斯昭攻歷陽，拔之。"
  },
  {
    "id": "s0449",
    "blockIndex": 97,
    "zh": "丁亥，下令，以「王偉等既死，自餘衣冠舊貴，被逼偷生，猛士勳豪，和光苟免者，皆不問。"
  },
  {
    "id": "s0451",
    "blockIndex": 98,
    "zh": "扶風民魯悉達，糾合鄉人以保新蔡，力田蓄谷。"
  },
  {
    "id": "s0451",
    "blockIndex": 98,
    "zh": "時江東饑亂，餓死者什八九，遺民攜老幼歸之。"
  },
  {
    "id": "s0451",
    "blockIndex": 98,
    "zh": "悉達分給糧廩，全濟甚眾，招集晉熙等五郡，盡有其地。"
  },
  {
    "id": "s0451",
    "blockIndex": 98,
    "zh": "使其弟廣達將兵從王僧辯討侯景，景平，以悉達為北江州刺史。"
  },
  {
    "id": "s0455",
    "blockIndex": 99,
    "zh": "齊主使其散騎常侍曹文皎等來聘，湘東王使散騎常侍柳暉等報之，且告平侯景；"
  },
  {
    "id": "s0455",
    "blockIndex": 99,
    "zh": "亦遣舍人魏彥告於魏。"
  },
  {
    "id": "s0457",
    "blockIndex": 100,
    "zh": "齊主使潘樂、郭元建將兵圍秦郡，行台尚書辛術諫曰：「朝廷與湘東王信使不絕。"
  },
  {
    "id": "s0457",
    "blockIndex": 100,
    "zh": "陽平，侯景之土，取之可也；"
  },
  {
    "id": "s0457",
    "blockIndex": 100,
    "zh": "今王僧辯已遣嚴超達守秦郡，於義何得復爭之！"
  },
  {
    "id": "s0457",
    "blockIndex": 100,
    "zh": "且水潦方降，不如班師。"
  },
  {
    "id": "s0457",
    "blockIndex": 100,
    "zh": "」弗從。"
  },
  {
    "id": "s0457",
    "blockIndex": 100,
    "zh": "陳霸先命別將徐度引兵助秦郡固守。"
  },
  {
    "id": "s0457",
    "blockIndex": 100,
    "zh": "齊眾七萬，攻之甚急。"
  },
  {
    "id": "s0457",
    "blockIndex": 100,
    "zh": "王僧辯使左衛將軍杜崱救之，霸先亦自歐陽來會；"
  },
  {
    "id": "s0457",
    "blockIndex": 100,
    "zh": "與元建大戰於土林，大破之，斬首萬餘級，生擒千餘人，元建收餘眾北遁；"
  },
  {
    "id": "s0457",
    "blockIndex": 100,
    "zh": "猶以通好，不窮追也。"
  },
  {
    "id": "s0467",
    "blockIndex": 101,
    "zh": "辛術遷吏部尚書。"
  },
  {
    "id": "s0467",
    "blockIndex": 101,
    "zh": "自魏遷鄴以來，大選之職，知名者數人，互有得失：齊世宗少年高朗，所弊者疏；"
  },
  {
    "id": "s0467",
    "blockIndex": 101,
    "zh": "袁叔德沈密謹厚，所傷者細；"
  },
  {
    "id": "s0467",
    "blockIndex": 101,
    "zh": "楊愔風流辯給，取士失於浮華。"
  },
  {
    "id": "s0467",
    "blockIndex": 101,
    "zh": "唯術性尚貞明，取士必以才器，循名責實，新舊參舉，管庫必擢，門閥不遺，考之前後，最為折衷。"
  },
  {
    "id": "s0472",
    "blockIndex": 102,
    "zh": "魏達奚武遣尚書左丞柳帶韋入南鄭，說宜豐侯循曰：「足下所固者險，所恃者援，所保者民。"
  },
  {
    "id": "s0472",
    "blockIndex": 102,
    "zh": "今王旅深入，所憑之險不足固也；"
  },
  {
    "id": "s0472",
    "blockIndex": 102,
    "zh": "白馬破走，酋豪不進，所望之援不可恃也；"
  },
  {
    "id": "s0472",
    "blockIndex": 102,
    "zh": "長圍四合，所部之民不可保也。"
  },
  {
    "id": "s0472",
    "blockIndex": 102,
    "zh": "且足下本朝喪亂，社稷無主，欲誰為為忠乎！"
  },
  {
    "id": "s0472",
    "blockIndex": 102,
    "zh": "豈若轉禍為福，使慶流子孫邪！"
  },
  {
    "id": "s0472",
    "blockIndex": 102,
    "zh": "」循乃請降。"
  },
  {
    "id": "s0472",
    "blockIndex": 102,
    "zh": "帶韋，慶之子也。"
  },
  {
    "id": "s0472",
    "blockIndex": 102,
    "zh": "開府儀同三司賀蘭德願聞城中食盡，請攻之，大都督赫連達曰：「不戰而獲城，策之上者，豈可利其子女，貪其貨財，而不愛民命乎！"
  },
  {
    "id": "s0472",
    "blockIndex": 102,
    "zh": "且觀其士馬猶強，城池尚固，攻之縱克，必彼此俱傷；"
  },
  {
    "id": "s0472",
    "blockIndex": 102,
    "zh": "如困獸猶鬥，則成敗未可知也。"
  },
  {
    "id": "s0472",
    "blockIndex": 102,
    "zh": "」武曰：「公言是也。"
  },
  {
    "id": "s0472",
    "blockIndex": 102,
    "zh": "」乃受循降，獲男女二萬口而還，於是劍北皆入於魏。"
  },
  {
    "id": "s0485",
    "blockIndex": 103,
    "zh": "六月，丁未，齊主還鄴；"
  },
  {
    "id": "s0485",
    "blockIndex": 103,
    "zh": "乙卯，復如晉陽。"
  },
  {
    "id": "s0487",
    "blockIndex": 104,
    "zh": "庚寅，立安南侯方矩為王太子。"
  },
  {
    "id": "s0488",
    "blockIndex": 105,
    "zh": "齊遣散騎常侍謝季卿來賀平侯景。"
  },
  {
    "id": "s0489",
    "blockIndex": 106,
    "zh": "衡州刺史王懷明作亂，廣州刺史蕭勃討平之。"
  },
  {
    "id": "s0490",
    "blockIndex": 107,
    "zh": "齊政煩賦重，江北之民不樂屬齊，其豪傑數請兵於王僧辯，僧辯以與齊通好，皆不許。"
  },
  {
    "id": "s0490",
    "blockIndex": 107,
    "zh": "秋，七月，廣陵僑人朱盛等潛聚黨數千人，謀襲殺齊刺史溫仲邕，遣使求援於陳霸先，雲已克其外城。"
  },
  {
    "id": "s0490",
    "blockIndex": 107,
    "zh": "霸先使告僧辯，僧辯曰：「人之情偽，未易可測，若審克外城，亟須應援，如其不爾，無煩進軍。"
  },
  {
    "id": "s0490",
    "blockIndex": 107,
    "zh": "」使未報，霸先已濟江，僧辯乃命武州刺史杜崱等助之。"
  },
  {
    "id": "s0490",
    "blockIndex": 107,
    "zh": "會盛等謀洩，霸先因進軍圍廣陵。"
  },
  {
    "id": "s0495",
    "blockIndex": 108,
    "zh": "八月，魏安康人黃眾寶反，攻魏興，執太守柳檜，進圍東梁州。"
  },
  {
    "id": "s0495",
    "blockIndex": 108,
    "zh": "令檜誘說城中，檜不從而死。"
  },
  {
    "id": "s0495",
    "blockIndex": 108,
    "zh": "檜，虯之弟也。"
  },
  {
    "id": "s0495",
    "blockIndex": 108,
    "zh": "太師泰遣王雄與驃騎大將軍武川宇文虯討之。"
  },
  {
    "id": "s0499",
    "blockIndex": 109,
    "zh": "武陵王紀舉兵由外水東下，以永豐侯手為為益州刺史，守成都，使其子宜都王圓肅副之。"
  },
  {
    "id": "s0500",
    "blockIndex": 110,
    "zh": "九月，甲戌，司空南平王恪卒。"
  },
  {
    "id": "s0500",
    "blockIndex": 110,
    "zh": "甲申，以王僧辯為揚州刺史。"
  },
  {
    "id": "s0502",
    "blockIndex": 111,
    "zh": "齊主使告王僧辯、陳霸先曰：「請釋廣陵之圍，必歸廣陵、歷陽兩城。"
  },
  {
    "id": "s0502",
    "blockIndex": 111,
    "zh": "」霸先引兵還京口，江北之民從霸先濟江者萬餘口。"
  },
  {
    "id": "s0502",
    "blockIndex": 111,
    "zh": "湘東王以霸先為征北大將軍、開府儀同三司、南徐州刺史，征霸先世子昌及兄子頊詣江陵，以昌為員外散騎常侍，頊為領直。"
  },
  {
    "id": "s0502",
    "blockIndex": 111,
    "zh": "宜豐侯循之降魏也，丞相泰許其南還，久而未遣，從容問劉璠曰：「我於古誰比？"
  },
  {
    "id": "s0502",
    "blockIndex": 111,
    "zh": "」對曰：「璠常以公為湯、武，今日所見，曾桓、文之不如！"
  },
  {
    "id": "s0502",
    "blockIndex": 111,
    "zh": "」泰曰：「我安敢比湯、武，庶幾望伊、周，何至不如桓、文！"
  },
  {
    "id": "s0502",
    "blockIndex": 111,
    "zh": "」對曰：「齊桓存三亡國，晉文不失信於伐原。"
  },
  {
    "id": "s0502",
    "blockIndex": 111,
    "zh": "」語未竟，泰撫掌曰：「我解爾意，欲激我耳。"
  },
  {
    "id": "s0502",
    "blockIndex": 111,
    "zh": "」乃謂循曰：「王欲之荊，為之益？"
  },
  {
    "id": "s0502",
    "blockIndex": 111,
    "zh": "」循請還江陵，泰厚禮遣之。"
  },
  {
    "id": "s0502",
    "blockIndex": 111,
    "zh": "循以文武千家自隨，湘東王疑之，遣使覘察，相望於道；"
  },
  {
    "id": "s0502",
    "blockIndex": 111,
    "zh": "始至之夕，命劫竊其財，及旦，循啟輸馬仗，王乃安之，引入，對泣，以循為侍中、驃騎將軍、開府儀同三司。"
  },
  {
    "id": "s0514",
    "blockIndex": 112,
    "zh": "冬，十月，齊主自晉陽如離石，自黃櫨嶺起長城，北至社平戍，四百餘里，置三十六戍。"
  },
  {
    "id": "s0515",
    "blockIndex": 113,
    "zh": "戊申，湘東王執湘州刺史王琳於殿中，殺其副將殷晏。"
  },
  {
    "id": "s0516",
    "blockIndex": 114,
    "zh": "琳本會稽兵家，其姊妹皆入王宮，故琳少在王左右。"
  },
  {
    "id": "s0516",
    "blockIndex": 114,
    "zh": "琳好勇，王以為將帥。"
  },
  {
    "id": "s0516",
    "blockIndex": 114,
    "zh": "琳傾身下士，所得賞賜，不以入家。"
  },
  {
    "id": "s0516",
    "blockIndex": 114,
    "zh": "麾下萬人，多江、淮群盜，從王僧辯平侯景，與杜龕功居第一。"
  },
  {
    "id": "s0516",
    "blockIndex": 114,
    "zh": "在建康，恃寵縱暴，僧辯不能禁。"
  },
  {
    "id": "s0516",
    "blockIndex": 114,
    "zh": "僧辯以宮殿之燒，恐得罪，欲以琳塞責，乃密啟王，請誅琳。"
  },
  {
    "id": "s0516",
    "blockIndex": 114,
    "zh": "王以琳為湘州，琳自疑及禍，使長史陸納帥部曲赴湘州，身詣江陵陳謝，謂納等曰：「吾若不返，子將安之？"
  },
  {
    "id": "s0516",
    "blockIndex": 114,
    "zh": "」鹹曰：「請死之。"
  },
  {
    "id": "s0516",
    "blockIndex": 114,
    "zh": "」相泣而別。"
  },
  {
    "id": "s0516",
    "blockIndex": 114,
    "zh": "至江陵，王下琳吏。"
  },
  {
    "id": "s0526",
    "blockIndex": 115,
    "zh": "辛酉，以王子方略為湘州刺史，又以廷尉黃羅漢為長史，使與太舟卿張載至巴陵，先據琳軍。"
  },
  {
    "id": "s0526",
    "blockIndex": 115,
    "zh": "載有寵於王，而御下峻刻，荊州人疾之如仇。"
  },
  {
    "id": "s0526",
    "blockIndex": 115,
    "zh": "羅漢等至琳軍，陸納及士卒並哭，不肯受命，執羅漢及載。"
  },
  {
    "id": "s0526",
    "blockIndex": 115,
    "zh": "王遣宦者陳旻往諭之，納對旻刳載腹，抽腸以繫馬足，使繞而走，腸盡氣絕。"
  },
  {
    "id": "s0526",
    "blockIndex": 115,
    "zh": "又臠割，出其心，向之抃舞，焚其餘骨。"
  },
  {
    "id": "s0526",
    "blockIndex": 115,
    "zh": "以黃羅漢清謹而免之。"
  },
  {
    "id": "s0526",
    "blockIndex": 115,
    "zh": "納與諸將引兵襲湘州，時州中無主，納遂據之。"
  },
  {
    "id": "s0533",
    "blockIndex": 116,
    "zh": "公卿籓鎮數勸進於湘東王，十一月，丙子，世祖即皇帝位於江陵，改元，大赦。"
  },
  {
    "id": "s0533",
    "blockIndex": 116,
    "zh": "是日，帝不升正殿，公卿陪列而已。"
  },
  {
    "id": "s0535",
    "blockIndex": 117,
    "zh": "丁丑，以宜豐侯循為湘州刺史。"
  },
  {
    "id": "s0536",
    "blockIndex": 118,
    "zh": "己卯，立王太子方矩為皇太子，更名元良。"
  },
  {
    "id": "s0536",
    "blockIndex": 118,
    "zh": "皇子方智為晉安王，方略為始安王，方等之子莊為永嘉王。"
  },
  {
    "id": "s0536",
    "blockIndex": 118,
    "zh": "追尊母阮修容為文宣皇后。"
  },
  {
    "id": "s0539",
    "blockIndex": 119,
    "zh": "侯景之亂，州郡太半入魏，自巴陵以下至建康，以長江為限，荊州界北盡武寧，西拒硤口，嶺南復為蕭勃所據，詔令所行，千里而近，民戶著籍者，不盈三萬而已。"
  },
  {
    "id": "s0540",
    "blockIndex": 120,
    "zh": "陸納襲擊衡州刺史丁道貴於淥口，破之。"
  },
  {
    "id": "s0540",
    "blockIndex": 120,
    "zh": "道貴奔零陵，其眾悉降於納。"
  },
  {
    "id": "s0540",
    "blockIndex": 120,
    "zh": "上聞之，遣使征司徒王僧辯、右衛將軍杜崱、平北將軍裴之橫與宜豐侯循共討納，循軍巴陵以待之。"
  },
  {
    "id": "s0540",
    "blockIndex": 120,
    "zh": "侯景之亂，零陵人李洪雅據其郡，上即以為營州刺史。"
  },
  {
    "id": "s0540",
    "blockIndex": 120,
    "zh": "洪雅請討陸納，上許之。"
  },
  {
    "id": "s0540",
    "blockIndex": 120,
    "zh": "丁道貴收餘眾與之俱。"
  },
  {
    "id": "s0540",
    "blockIndex": 120,
    "zh": "納遣其將吳藏襲擊，破之，洪雅等退保空雲城，藏引兵圍之。"
  },
  {
    "id": "s0540",
    "blockIndex": 120,
    "zh": "頃之，納請降，求送妻子，上遣陳旻至納所，納眾皆泣，曰：「王郎被囚，故我曹旻逃罪於湘州，非有它志也。"
  },
  {
    "id": "s0540",
    "blockIndex": 120,
    "zh": "」乃出妻子付旻。"
  },
  {
    "id": "s0540",
    "blockIndex": 120,
    "zh": "旻至巴陵，循曰：「此詐也，必將襲我。"
  },
  {
    "id": "s0540",
    "blockIndex": 120,
    "zh": "」乃密為之備。"
  },
  {
    "id": "s0540",
    "blockIndex": 120,
    "zh": "納果夜以輕兵繼旻後，約至城下鼓噪。"
  },
  {
    "id": "s0540",
    "blockIndex": 120,
    "zh": "十二月，壬午晨，去巴陵十里，眾謂已至，即鼓噪，軍中皆驚。"
  },
  {
    "id": "s0540",
    "blockIndex": 120,
    "zh": "循坐胡床，於壘門望之，納乘水來攻，矢下如雨，循方食甘蔗，略無懼色。"
  },
  {
    "id": "s0540",
    "blockIndex": 120,
    "zh": "徐部分將士擊之，獲其一艦。"
  },
  {
    "id": "s0540",
    "blockIndex": 120,
    "zh": "納退保長沙。"
  },
  {
    "id": "s0556",
    "blockIndex": 121,
    "zh": "壬午，齊主還鄴；"
  },
  {
    "id": "s0556",
    "blockIndex": 121,
    "zh": "戊午，復如晉陽。"
  },
  {
    "id": "s0558",
    "blockIndex": 122,
    "zh": "category:資治通鑑"
  }
]
