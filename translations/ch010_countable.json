[
  {
    "id": "s0001",
    "blockIndex": 0,
    "zh": "__FORCETOC__"
  },
  {
    "id": "s0002",
    "blockIndex": 1,
    "zh": "起強圉作噩，盡著雍閹茂，凡二年。"
  },
  {
    "id": "s0003",
    "blockIndex": 2,
    "zh": "1冬，十月，韓信、張耳以兵數萬東擊趙。"
  },
  {
    "id": "s0004",
    "blockIndex": 2,
    "zh": "趙王及成安君陳餘聞之，聚兵井陘口，號二十萬。"
  },
  {
    "id": "s0005",
    "blockIndex": 3,
    "zh": "廣武君李左車說成安君曰：「韓信、張耳乘勝而去國遠鬥，其鋒不可當。"
  },
  {
    "id": "s0006",
    "blockIndex": 3,
    "zh": "臣聞『千里饋糧，士有饑色；"
  },
  {
    "id": "s0007",
    "blockIndex": 3,
    "zh": "樵蘇後爨，師不宿飽。"
  },
  {
    "id": "s0008",
    "blockIndex": 3,
    "zh": "』今井陘之道，車不得方軌，騎不得成列；"
  },
  {
    "id": "s0009",
    "blockIndex": 3,
    "zh": "行數百里，其勢糧食必在其後。"
  },
  {
    "id": "s0010",
    "blockIndex": 3,
    "zh": "願足下假臣奇兵三萬人，從間路絕其輜重；"
  },
  {
    "id": "s0011",
    "blockIndex": 3,
    "zh": "足下深溝高壘勿與戰。"
  },
  {
    "id": "s0012",
    "blockIndex": 3,
    "zh": "彼前不得鬥，退不得還，野無所掠，不至十日，而兩將之頭可致於麾下；"
  },
  {
    "id": "s0013",
    "blockIndex": 3,
    "zh": "否則必為二子所擒矣。"
  },
  {
    "id": "s0014",
    "blockIndex": 3,
    "zh": "」成安君嘗自稱義兵，不用詐謀奇計，曰：「韓信兵少而疲，如此避而不擊，則諸侯謂吾怯而輕來伐我矣。"
  },
  {
    "id": "s0016",
    "blockIndex": 4,
    "zh": "韓信使人間視，知其不用廣武君策，則大喜，乃敢引兵遂下。"
  },
  {
    "id": "s0017",
    "blockIndex": 4,
    "zh": "未至井陘口三十里，止舍。"
  },
  {
    "id": "s0018",
    "blockIndex": 4,
    "zh": "夜半，傳發，選輕騎二千人，人持一赤幟，從間道萆山而望趙軍。"
  },
  {
    "id": "s0019",
    "blockIndex": 4,
    "zh": "誡曰：「趙見我走，必空壁逐我；"
  },
  {
    "id": "s0020",
    "blockIndex": 4,
    "zh": "若疾入趙壁，拔趙幟，立漢赤幟。"
  },
  {
    "id": "s0021",
    "blockIndex": 4,
    "zh": "」令其裨將傳餐，曰：「今日破趙會食。"
  },
  {
    "id": "s0022",
    "blockIndex": 4,
    "zh": "」諸將皆莫信，佯應曰：「諾。"
  },
  {
    "id": "s0023",
    "blockIndex": 4,
    "zh": "」信曰：「趙已先據便地為壁；"
  },
  {
    "id": "s0024",
    "blockIndex": 4,
    "zh": "且彼未見吾大將旗鼓，未肯擊前行，恐吾至阻險而還也。"
  },
  {
    "id": "s0025",
    "blockIndex": 4,
    "zh": "」乃使萬人先行，出，背水陳。"
  },
  {
    "id": "s0026",
    "blockIndex": 4,
    "zh": "趙軍望見而大笑。"
  },
  {
    "id": "s0027",
    "blockIndex": 4,
    "zh": "平旦，信建大將旗鼓，鼓行出井陘口；"
  },
  {
    "id": "s0028",
    "blockIndex": 4,
    "zh": "趙開壁擊之，大戰良久。"
  },
  {
    "id": "s0029",
    "blockIndex": 4,
    "zh": "於是信與張耳佯棄鼓旗，走水上軍；"
  },
  {
    "id": "s0030",
    "blockIndex": 4,
    "zh": "水上軍開入之，復疾戰。"
  },
  {
    "id": "s0031",
    "blockIndex": 4,
    "zh": "趙果空壁爭漢旗、鼓，逐信、耳。"
  },
  {
    "id": "s0032",
    "blockIndex": 4,
    "zh": "信、耳已入水上軍，軍皆殊死戰，不可敗。"
  },
  {
    "id": "s0033",
    "blockIndex": 4,
    "zh": "信所出奇兵二千騎共候趙空壁逐利，則馳入趙壁，皆拔趙旗，立漢赤幟二千。"
  },
  {
    "id": "s0034",
    "blockIndex": 4,
    "zh": "趙軍已不能得信等，欲還歸壁；"
  },
  {
    "id": "s0035",
    "blockIndex": 4,
    "zh": "壁皆漢赤幟，見而大驚，以為漢皆已得趙王將矣，兵遂亂，遁走，趙將雖斬之，不能禁也。"
  },
  {
    "id": "s0036",
    "blockIndex": 4,
    "zh": "於是漢兵夾擊，大破趙軍，斬成安君泜水上，禽趙王歇。"
  },
  {
    "id": "s0037",
    "blockIndex": 4,
    "zh": "諸將效首虜，畢賀，因問信曰：「兵法：『右倍山陵，前左水澤。"
  },
  {
    "id": "s0038",
    "blockIndex": 4,
    "zh": "』今者將軍令臣等反背水陳，曰『破趙會食』，臣等不服，然竟以勝，此何術也？"
  },
  {
    "id": "s0039",
    "blockIndex": 4,
    "zh": "」信曰：「此在兵法，顧諸君不察耳。"
  },
  {
    "id": "s0040",
    "blockIndex": 4,
    "zh": "兵法不曰『陷之死地而後生，置之亡地而後存』？"
  },
  {
    "id": "s0041",
    "blockIndex": 4,
    "zh": "且信非得素拊循士大夫也，此所謂『驅市人而戰之』，其勢非置之死地，使人人自為戰。"
  },
  {
    "id": "s0042",
    "blockIndex": 4,
    "zh": "今予之生地，皆走，寧尚可得而用之乎？"
  },
  {
    "id": "s0044",
    "blockIndex": 4,
    "zh": "」諸將皆服，曰：「善！"
  },
  {
    "id": "s0045",
    "blockIndex": 4,
    "zh": "非臣所及也。"
  },
  {
    "id": "s0047",
    "blockIndex": 5,
    "zh": "信募生得廣武君者予千金。"
  },
  {
    "id": "s0048",
    "blockIndex": 5,
    "zh": "有縛致麾下者，信解其縛，東鄉坐，師事之。"
  },
  {
    "id": "s0049",
    "blockIndex": 5,
    "zh": "問曰：「僕欲北攻燕，東代齊，何若而有功？"
  },
  {
    "id": "s0050",
    "blockIndex": 5,
    "zh": "」廣武君辭謝曰：「臣敗亡之虜，何足以權大事乎？"
  },
  {
    "id": "s0051",
    "blockIndex": 5,
    "zh": "」信曰：「僕聞之，百里奚居虞而虞亡，在秦而秦霸；"
  },
  {
    "id": "s0052",
    "blockIndex": 5,
    "zh": "非愚於虞而智於秦也，用與不用，聽與不聽也。"
  },
  {
    "id": "s0053",
    "blockIndex": 5,
    "zh": "誠令成安君聽足下計，若信者亦已為禽矣。"
  },
  {
    "id": "s0054",
    "blockIndex": 5,
    "zh": "以不用足下，故信得侍耳。"
  },
  {
    "id": "s0055",
    "blockIndex": 5,
    "zh": "今僕委心歸計，願足下勿辭。"
  },
  {
    "id": "s0056",
    "blockIndex": 5,
    "zh": "」廣武君曰：「今將軍涉西河，虜魏王，禽夏說；"
  },
  {
    "id": "s0057",
    "blockIndex": 5,
    "zh": "東下井陘，不終朝而破趙二十萬眾，誅成安君；"
  },
  {
    "id": "s0058",
    "blockIndex": 5,
    "zh": "名聞海內，威震天下，農夫莫不輟耕釋耒，衣俞衣甘食，傾耳以待命者，此將軍之所長也。"
  },
  {
    "id": "s0059",
    "blockIndex": 5,
    "zh": "然而眾勞卒罷，其實難用。"
  },
  {
    "id": "s0060",
    "blockIndex": 5,
    "zh": "今將軍欲舉倦敝之兵，頓之燕堅城之下，欲戰不得，攻之不拔，情見勢屈；"
  },
  {
    "id": "s0061",
    "blockIndex": 5,
    "zh": "曠日持久，糧食單竭。"
  },
  {
    "id": "s0062",
    "blockIndex": 5,
    "zh": "燕既不服，齊必距境以自強。"
  },
  {
    "id": "s0063",
    "blockIndex": 5,
    "zh": "燕、齊相持而不下，則劉、項之權未有所分也，此將軍所短也。"
  },
  {
    "id": "s0064",
    "blockIndex": 5,
    "zh": "善用兵者，不以短擊長而以長擊短。"
  },
  {
    "id": "s0065",
    "blockIndex": 5,
    "zh": "」韓信曰：「然則何由？"
  },
  {
    "id": "s0066",
    "blockIndex": 5,
    "zh": "」廣武君對曰：「方今為將軍計，莫如按甲休兵，鎮撫趙民，百里之內，牛酒日至，以饗士大夫；"
  },
  {
    "id": "s0067",
    "blockIndex": 5,
    "zh": "北首燕路，而後遣辨士奉咫尺之書，暴其所長於燕，燕必不敢不聽從。"
  },
  {
    "id": "s0068",
    "blockIndex": 5,
    "zh": "燕已從而東臨齊，雖有智者，亦不知為齊計矣。"
  },
  {
    "id": "s0069",
    "blockIndex": 5,
    "zh": "如是，則天下事皆可圖也。"
  },
  {
    "id": "s0070",
    "blockIndex": 5,
    "zh": "兵固有先聲而後實者，此之謂也。"
  },
  {
    "id": "s0071",
    "blockIndex": 5,
    "zh": "」韓信曰：「善！"
  },
  {
    "id": "s0072",
    "blockIndex": 5,
    "zh": "」從其策，發使使燕，燕從風而靡；"
  },
  {
    "id": "s0073",
    "blockIndex": 5,
    "zh": "遣使報漢，且請以張耳王趙，漢王許之。"
  },
  {
    "id": "s0074",
    "blockIndex": 5,
    "zh": "楚數使奇兵渡河擊趙，張耳、韓信往來救趙，因行定趙城邑，發兵詣漢。"
  },
  {
    "id": "s0076",
    "blockIndex": 6,
    "zh": "2甲戌晦，日有食之。"
  },
  {
    "id": "s0078",
    "blockIndex": 7,
    "zh": "3十一月，癸卯晦，日有食之。"
  },
  {
    "id": "s0080",
    "blockIndex": 8,
    "zh": "4隨何至九江，九江太宰主之，三日不得見。"
  },
  {
    "id": "s0081",
    "blockIndex": 8,
    "zh": "隨何說太宰曰：「王之不見何，必以楚為強，以漢為弱也。"
  },
  {
    "id": "s0082",
    "blockIndex": 8,
    "zh": "此臣之所以為使。"
  },
  {
    "id": "s0083",
    "blockIndex": 8,
    "zh": "使何得見，言之而是，大王所欲聞也；"
  },
  {
    "id": "s0084",
    "blockIndex": 8,
    "zh": "言之而非，使何等二十人伏斧質九江市，足以明王倍漢而與楚也。"
  },
  {
    "id": "s0085",
    "blockIndex": 8,
    "zh": "」太宰乃言之王。"
  },
  {
    "id": "s0086",
    "blockIndex": 8,
    "zh": "王見之。"
  },
  {
    "id": "s0087",
    "blockIndex": 8,
    "zh": "隨何曰：「漢王使臣敬進書大王御者，竊怪大王與楚何親也。"
  },
  {
    "id": "s0088",
    "blockIndex": 8,
    "zh": "」九江王曰：「寡人北鄉而臣事之。"
  },
  {
    "id": "s0089",
    "blockIndex": 8,
    "zh": "」隨何曰：「大王與項王俱列為諸侯，北鄉而臣事之者，必以楚為強，可以托國也。"
  },
  {
    "id": "s0090",
    "blockIndex": 8,
    "zh": "項王伐齊，身負版築，為士卒先。"
  },
  {
    "id": "s0091",
    "blockIndex": 8,
    "zh": "大王宜悉九江之眾，身自將之，為楚前鋒；"
  },
  {
    "id": "s0092",
    "blockIndex": 8,
    "zh": "今乃發四千人以助楚。"
  },
  {
    "id": "s0093",
    "blockIndex": 8,
    "zh": "夫北面而臣事人者，固若是乎？"
  },
  {
    "id": "s0094",
    "blockIndex": 8,
    "zh": "漢王入彭城，項王未出齊也。"
  },
  {
    "id": "s0095",
    "blockIndex": 8,
    "zh": "大王宜悉九江之兵渡淮，日夜會戰彭城下；"
  },
  {
    "id": "s0096",
    "blockIndex": 8,
    "zh": "大王乃撫萬人之眾，無一人渡淮者，垂拱而觀其孰勝。"
  },
  {
    "id": "s0097",
    "blockIndex": 8,
    "zh": "夫托國於人者，固若是乎？"
  },
  {
    "id": "s0098",
    "blockIndex": 8,
    "zh": "大王提空名以鄉楚而欲厚自托，臣竊為大王不取也！"
  },
  {
    "id": "s0099",
    "blockIndex": 8,
    "zh": "然而大王不背楚者，以漢為弱也。"
  },
  {
    "id": "s0100",
    "blockIndex": 8,
    "zh": "夫楚兵雖強，天下負之以不義之名，以其背盟約而殺義帝也。"
  },
  {
    "id": "s0101",
    "blockIndex": 8,
    "zh": "漢王收諸侯，還守成皋、滎陽，下蜀、漢之粟，深溝壁壘，分卒守徼乘塞。"
  },
  {
    "id": "s0102",
    "blockIndex": 8,
    "zh": "楚人深入敵國八九百里，老弱轉糧千里之外。"
  },
  {
    "id": "s0103",
    "blockIndex": 8,
    "zh": "漢堅守而不動，楚進則不得攻，退則不能解，故曰楚兵不足恃也。"
  },
  {
    "id": "s0104",
    "blockIndex": 8,
    "zh": "使楚勝漢，則諸侯自危懼而相救。"
  },
  {
    "id": "s0105",
    "blockIndex": 8,
    "zh": "夫楚之強，適足以致天下之兵耳。"
  },
  {
    "id": "s0106",
    "blockIndex": 8,
    "zh": "故楚不如漢，其勢易見也。"
  },
  {
    "id": "s0107",
    "blockIndex": 8,
    "zh": "今大王不與萬全之漢而自托於危亡之楚，臣竊為大王惑之！"
  },
  {
    "id": "s0108",
    "blockIndex": 8,
    "zh": "臣非以九江之兵足以亡楚也；"
  },
  {
    "id": "s0109",
    "blockIndex": 8,
    "zh": "大王發兵而倍楚，項王必留；"
  },
  {
    "id": "s0110",
    "blockIndex": 8,
    "zh": "留數月，漢之取天下可以萬全。"
  },
  {
    "id": "s0111",
    "blockIndex": 8,
    "zh": "臣請與大王提劍而歸漢，漢王必裂地而封大王；"
  },
  {
    "id": "s0112",
    "blockIndex": 8,
    "zh": "又況九江必大王有也。"
  },
  {
    "id": "s0113",
    "blockIndex": 8,
    "zh": "」九江王曰：「請奉命。"
  },
  {
    "id": "s0114",
    "blockIndex": 8,
    "zh": "」陰許畔楚與漢，未敢洩也。"
  },
  {
    "id": "s0115",
    "blockIndex": 9,
    "zh": "楚使者在九江，舍傳舍，方急責布發兵。"
  },
  {
    "id": "s0116",
    "blockIndex": 9,
    "zh": "隨何直入，坐楚使者上，曰：「九江王已歸漢，楚何以得發兵？"
  },
  {
    "id": "s0117",
    "blockIndex": 9,
    "zh": "」布愕然。"
  },
  {
    "id": "s0118",
    "blockIndex": 9,
    "zh": "楚使者起。"
  },
  {
    "id": "s0119",
    "blockIndex": 9,
    "zh": "何因說布曰：「事已構，可遂殺楚使者，無使歸，而疾走漢並力。"
  },
  {
    "id": "s0120",
    "blockIndex": 9,
    "zh": "」布曰：「如使者教。"
  },
  {
    "id": "s0121",
    "blockIndex": 9,
    "zh": "」於是殺楚使者，因起兵而攻楚。"
  },
  {
    "id": "s0122",
    "blockIndex": 10,
    "zh": "楚使項聲、龍且攻九江，數月，龍且破九江軍。"
  },
  {
    "id": "s0123",
    "blockIndex": 10,
    "zh": "布欲引兵走漢，恐楚兵殺之，乃間行與何俱歸漢。"
  },
  {
    "id": "s0124",
    "blockIndex": 10,
    "zh": "十二月，九江王至漢。"
  },
  {
    "id": "s0125",
    "blockIndex": 10,
    "zh": "漢王方踞床洗足，召布入見。"
  },
  {
    "id": "s0126",
    "blockIndex": 10,
    "zh": "布大怒，悔來，欲自殺；"
  },
  {
    "id": "s0127",
    "blockIndex": 10,
    "zh": "及出就舍，帳御、飲食、從官皆如漢王居，布又大喜過望。"
  },
  {
    "id": "s0128",
    "blockIndex": 10,
    "zh": "於是乃使人入九江；"
  },
  {
    "id": "s0129",
    "blockIndex": 10,
    "zh": "楚已使項伯收九江兵，盡殺布妻子，布使者頗得故人、幸臣，將眾數千人歸漢。"
  },
  {
    "id": "s0130",
    "blockIndex": 10,
    "zh": "漢益九江王兵，與俱屯成皋。"
  },
  {
    "id": "s0131",
    "blockIndex": 11,
    "zh": "楚數侵奪漢甬道，漢軍乏食。"
  },
  {
    "id": "s0132",
    "blockIndex": 11,
    "zh": "漢王與酈食其謀橈楚權。"
  },
  {
    "id": "s0133",
    "blockIndex": 11,
    "zh": "食其曰：「昔湯伐桀，封其後於杞；"
  },
  {
    "id": "s0134",
    "blockIndex": 11,
    "zh": "武王伐紂，封其後於宋。"
  },
  {
    "id": "s0135",
    "blockIndex": 11,
    "zh": "今秦失德棄義，侵伐諸侯，滅其社稷，使無立錐之地，陛下誠能復立六國之後，此其君臣、百姓必皆戴陛下之德，莫不鄉風慕義，願為臣妾。"
  },
  {
    "id": "s0136",
    "blockIndex": 11,
    "zh": "德義已行，陛下南鄉稱霸，楚必斂衽而朝。"
  },
  {
    "id": "s0137",
    "blockIndex": 11,
    "zh": "」漢王曰：「善！"
  },
  {
    "id": "s0138",
    "blockIndex": 11,
    "zh": "趣刻印，先生因行佩之矣。"
  },
  {
    "id": "s0139",
    "blockIndex": 11,
    "zh": "」食其未行，張良從外來謁。"
  },
  {
    "id": "s0140",
    "blockIndex": 11,
    "zh": "漢王方食，曰：「子房前！"
  },
  {
    "id": "s0141",
    "blockIndex": 11,
    "zh": "客有為我計橈楚權者。"
  },
  {
    "id": "s0142",
    "blockIndex": 11,
    "zh": "」具以酈生語告良，曰：「何如？"
  },
  {
    "id": "s0143",
    "blockIndex": 11,
    "zh": "」良曰：「誰為陛下畫此計者？"
  },
  {
    "id": "s0144",
    "blockIndex": 11,
    "zh": "陛下事去矣！"
  },
  {
    "id": "s0145",
    "blockIndex": 11,
    "zh": "」漢王曰：「何哉？"
  },
  {
    "id": "s0146",
    "blockIndex": 11,
    "zh": "」對曰：「臣請借前箸，為大王籌之。"
  },
  {
    "id": "s0147",
    "blockIndex": 11,
    "zh": "昔湯、武封桀、紂之後者，度能制其死生之命也；"
  },
  {
    "id": "s0148",
    "blockIndex": 11,
    "zh": "今陛下能制項籍之死命乎？"
  },
  {
    "id": "s0149",
    "blockIndex": 11,
    "zh": "其不可一也。"
  },
  {
    "id": "s0150",
    "blockIndex": 11,
    "zh": "武王入殷，表商容之閭，釋箕子之囚，封比干之墓，今陛下能乎？"
  },
  {
    "id": "s0151",
    "blockIndex": 11,
    "zh": "其不可二也。"
  },
  {
    "id": "s0152",
    "blockIndex": 11,
    "zh": "發巨橋之粟，散鹿台之錢，以賜貧窮，今陛下能乎？"
  },
  {
    "id": "s0153",
    "blockIndex": 11,
    "zh": "其不可三也。"
  },
  {
    "id": "s0154",
    "blockIndex": 11,
    "zh": "殷事已畢，偃革為軒，倒載干戈，示天下不復用兵，今陛下能乎？"
  },
  {
    "id": "s0155",
    "blockIndex": 11,
    "zh": "其不可四也。"
  },
  {
    "id": "s0156",
    "blockIndex": 11,
    "zh": "休馬華山之陽，示以無為，今陛下能乎？"
  },
  {
    "id": "s0157",
    "blockIndex": 11,
    "zh": "其不可五也。"
  },
  {
    "id": "s0158",
    "blockIndex": 11,
    "zh": "放牛桃林之陰，以示不復輸積，今陛下能乎？"
  },
  {
    "id": "s0159",
    "blockIndex": 11,
    "zh": "其不可六也。"
  },
  {
    "id": "s0160",
    "blockIndex": 11,
    "zh": "天下游士，離其親戚，棄墳墓，去故舊，從陛下游者，徒欲日夜望咫尺之地；"
  },
  {
    "id": "s0161",
    "blockIndex": 11,
    "zh": "今復立六國之後，天下游士各歸事其主，從其親戚，反其故舊、墳墓，陛下與誰取天下乎？"
  },
  {
    "id": "s0162",
    "blockIndex": 11,
    "zh": "其不可七也。"
  },
  {
    "id": "s0163",
    "blockIndex": 11,
    "zh": "且夫楚唯無強，六國立者復橈而從之，陛下焉得而臣之？"
  },
  {
    "id": "s0164",
    "blockIndex": 11,
    "zh": "其不可八也。"
  },
  {
    "id": "s0165",
    "blockIndex": 11,
    "zh": "誠用客之謀，陛下事去矣！"
  },
  {
    "id": "s0166",
    "blockIndex": 11,
    "zh": "」漢王輟食，吐哺，罵曰：「豎儒幾敗而公事！"
  },
  {
    "id": "s0167",
    "blockIndex": 11,
    "zh": "」令趣銷印。"
  },
  {
    "id": "s0168",
    "blockIndex": 12,
    "zh": "::荀悅論曰：夫立策決勝之術，其要有三：一曰形，二曰勢，三曰情。"
  },
  {
    "id": "s0169",
    "blockIndex": 12,
    "zh": "形者，言其大體得失之數也；"
  },
  {
    "id": "s0170",
    "blockIndex": 12,
    "zh": "勢者，言其臨時之宜、進退之機也；"
  },
  {
    "id": "s0171",
    "blockIndex": 12,
    "zh": "情者，言其心志可否之實也。"
  },
  {
    "id": "s0172",
    "blockIndex": 12,
    "zh": "故策同、事等而功殊者，三術不同也。"
  },
  {
    "id": "s0173",
    "blockIndex": 13,
    "zh": "::初，張耳、陳餘說陳涉以復六國，自為樹黨；"
  },
  {
    "id": "s0174",
    "blockIndex": 13,
    "zh": "酈生亦說漢王。"
  },
  {
    "id": "s0175",
    "blockIndex": 13,
    "zh": "所以說者同而得失異者，陳涉之起，天下皆欲亡秦；"
  },
  {
    "id": "s0176",
    "blockIndex": 13,
    "zh": "而楚、漢之分未有所定，今天下未必欲亡項也。"
  },
  {
    "id": "s0177",
    "blockIndex": 13,
    "zh": "故立六國，於陳涉，所謂多己之黨而益秦之敵也；"
  },
  {
    "id": "s0178",
    "blockIndex": 13,
    "zh": "且陳涉未能專天下之地也，所謂取非其有以與於人，行虛惠而獲實福也。"
  },
  {
    "id": "s0179",
    "blockIndex": 13,
    "zh": "立六國，於漢王，所謂割己之有而以資敵，設虛名而受實禍也。"
  },
  {
    "id": "s0180",
    "blockIndex": 13,
    "zh": "此同事而異形者也。"
  },
  {
    "id": "s0181",
    "blockIndex": 14,
    "zh": "::及宋義待秦、趙之斃，與昔卞莊刺虎同說者也。"
  },
  {
    "id": "s0182",
    "blockIndex": 14,
    "zh": "施之戰國之時，鄰國相攻，無臨時之急，則可也。"
  },
  {
    "id": "s0183",
    "blockIndex": 14,
    "zh": "戰國之立，其日久矣，一戰勝敗，未必以存亡也；"
  },
  {
    "id": "s0184",
    "blockIndex": 14,
    "zh": "其勢非能急於亡敵國也；"
  },
  {
    "id": "s0185",
    "blockIndex": 14,
    "zh": "進乘利，退自保，故累力待時，承敵之斃，其勢然也。"
  },
  {
    "id": "s0186",
    "blockIndex": 14,
    "zh": "今楚、趙所起，其與秦勢不並立，安危之機，呼吸成變，進則定功，退則受禍。"
  },
  {
    "id": "s0187",
    "blockIndex": 14,
    "zh": "此同事而異勢者也。"
  },
  {
    "id": "s0188",
    "blockIndex": 15,
    "zh": "::伐趙之役，韓信軍於泜水之上而趙不能敗。"
  },
  {
    "id": "s0189",
    "blockIndex": 15,
    "zh": "彭城之難，漢王戰於睢水之上，士卒皆赴入睢水而楚兵大勝。"
  },
  {
    "id": "s0190",
    "blockIndex": 15,
    "zh": "何則？"
  },
  {
    "id": "s0191",
    "blockIndex": 15,
    "zh": "趙兵出國迎戰，見可而進，知難而退，懷內顧之心，無出死之計；"
  },
  {
    "id": "s0192",
    "blockIndex": 15,
    "zh": "韓信軍孤在水上，士卒必死，無有二心，此信之所以勝也。"
  },
  {
    "id": "s0193",
    "blockIndex": 15,
    "zh": "漢王深入敵國，置酒高會，士卒逸豫，戰心不固；"
  },
  {
    "id": "s0194",
    "blockIndex": 15,
    "zh": "楚以強大之威而喪其國都，士卒皆有憤激之氣，救敗赴亡之急，以決一旦之命，此漢之所以敗也。"
  },
  {
    "id": "s0195",
    "blockIndex": 15,
    "zh": "且韓信選精兵以守，而趙以內顧之士攻之；"
  },
  {
    "id": "s0196",
    "blockIndex": 15,
    "zh": "項羽選精兵以攻，而漢以怠惰之卒應之，此同事而異情者也。"
  },
  {
    "id": "s0197",
    "blockIndex": 16,
    "zh": "::故曰：權不可豫設，變不可先圖。"
  },
  {
    "id": "s0198",
    "blockIndex": 16,
    "zh": "與時遷移，應物變化，設策之機也。"
  },
  {
    "id": "s0200",
    "blockIndex": 17,
    "zh": "5漢王謂陳平曰：「天下紛紛，何時定乎？"
  },
  {
    "id": "s0201",
    "blockIndex": 17,
    "zh": "」陳平曰：「項王骨鯁之臣亞父、鍾離昧、龍且、周殷之屬，不過數人耳。"
  },
  {
    "id": "s0202",
    "blockIndex": 17,
    "zh": "大王誠能捐數萬斤金，行反間，間其君臣，以疑其心。"
  },
  {
    "id": "s0203",
    "blockIndex": 17,
    "zh": "項王為人，意忌信讒，必內相誅，漢因舉兵而攻之，破楚必矣。"
  },
  {
    "id": "s0204",
    "blockIndex": 17,
    "zh": "」漢王曰：「善！"
  },
  {
    "id": "s0205",
    "blockIndex": 17,
    "zh": "」乃出黃金四萬斤與平，恣所為，不問其出入。"
  },
  {
    "id": "s0206",
    "blockIndex": 17,
    "zh": "平多以金縱反間於楚軍，宣言：「諸將鍾離昧等為項王將，功多矣，然而終不得裂地而王，欲與漢為一，以滅項氏而分王其地。"
  },
  {
    "id": "s0207",
    "blockIndex": 17,
    "zh": "」項王果意不信鍾離昧等。"
  },
  {
    "id": "s0208",
    "blockIndex": 18,
    "zh": "夏，四月，楚圍漢王於滎陽，急；"
  },
  {
    "id": "s0209",
    "blockIndex": 18,
    "zh": "漢王請和，割滎陽以西者為漢。"
  },
  {
    "id": "s0210",
    "blockIndex": 18,
    "zh": "亞父勸羽急攻滎陽；"
  },
  {
    "id": "s0211",
    "blockIndex": 18,
    "zh": "漢王患之。"
  },
  {
    "id": "s0212",
    "blockIndex": 18,
    "zh": "項羽使使至漢，陳平使為太牢具。"
  },
  {
    "id": "s0213",
    "blockIndex": 18,
    "zh": "舉進，見楚使，即佯驚曰：「吾以為亞父使，乃項王使。"
  },
  {
    "id": "s0214",
    "blockIndex": 18,
    "zh": "」復持去，更以惡草具進楚使。"
  },
  {
    "id": "s0215",
    "blockIndex": 18,
    "zh": "楚使歸，具以報項王，項王果大疑亞父。"
  },
  {
    "id": "s0216",
    "blockIndex": 18,
    "zh": "亞父欲急攻下滎陽城，項王不信，不肯聽。"
  },
  {
    "id": "s0217",
    "blockIndex": 18,
    "zh": "亞父聞項王疑之，乃怒曰：「天下事大定矣，君王自為之，願請骸骨！"
  },
  {
    "id": "s0218",
    "blockIndex": 18,
    "zh": "」歸，未至彭城，疽發背而死。"
  },
  {
    "id": "s0219",
    "blockIndex": 19,
    "zh": "五月，將軍紀信言於漢王曰：「事急矣！"
  },
  {
    "id": "s0220",
    "blockIndex": 19,
    "zh": "臣請誑楚，王可以間出。"
  },
  {
    "id": "s0221",
    "blockIndex": 19,
    "zh": "」於是陳平夜出女子東門二千餘人，楚因而四面擊之。"
  },
  {
    "id": "s0222",
    "blockIndex": 19,
    "zh": "紀信乃乘王車，黃屋左纛，曰：「食盡，漢王降楚。"
  },
  {
    "id": "s0223",
    "blockIndex": 19,
    "zh": "」楚皆呼萬歲，之城東觀。"
  },
  {
    "id": "s0224",
    "blockIndex": 19,
    "zh": "以故漢王得與數十騎出西門遁去，令韓王信與周苛、魏豹、樅公守滎陽。"
  },
  {
    "id": "s0225",
    "blockIndex": 19,
    "zh": "羽見紀信，問：「漢王安在？"
  },
  {
    "id": "s0226",
    "blockIndex": 19,
    "zh": "」曰：「已出去矣。"
  },
  {
    "id": "s0227",
    "blockIndex": 19,
    "zh": "」羽燒殺信。"
  },
  {
    "id": "s0228",
    "blockIndex": 19,
    "zh": "周苛、樅公相謂曰：「反國之王，難與守城。"
  },
  {
    "id": "s0229",
    "blockIndex": 19,
    "zh": "」因殺魏豹。"
  },
  {
    "id": "s0230",
    "blockIndex": 20,
    "zh": "漢王出滎陽，至成皋，入關，收兵欲復東。"
  },
  {
    "id": "s0231",
    "blockIndex": 20,
    "zh": "轅生說漢王曰：「漢與楚相距滎陽數歲，漢常困。"
  },
  {
    "id": "s0232",
    "blockIndex": 20,
    "zh": "願君王出武關，項王必引兵南走。"
  },
  {
    "id": "s0233",
    "blockIndex": 20,
    "zh": "王深壁勿戰，令滎陽、成皋間且得休息，使韓信等得安輯河北趙地，連燕、齊，君王乃復走滎陽。"
  },
  {
    "id": "s0234",
    "blockIndex": 20,
    "zh": "如此，則楚所備者多，力分；"
  },
  {
    "id": "s0235",
    "blockIndex": 20,
    "zh": "漢得休息，復與之戰，破之必矣！"
  },
  {
    "id": "s0236",
    "blockIndex": 20,
    "zh": "」漢王從其計，出軍宛、葉間。"
  },
  {
    "id": "s0237",
    "blockIndex": 20,
    "zh": "與黥布行收兵。"
  },
  {
    "id": "s0238",
    "blockIndex": 20,
    "zh": "羽聞漢王在宛，果引兵南；"
  },
  {
    "id": "s0239",
    "blockIndex": 20,
    "zh": "漢王堅壁不與戰。"
  },
  {
    "id": "s0240",
    "blockIndex": 21,
    "zh": "漢王之敗彭城，解而西也，彭越皆亡其所下城，獨將其兵北居河上，常往來為漢遊兵擊楚，絕其後糧。"
  },
  {
    "id": "s0241",
    "blockIndex": 21,
    "zh": "是月，彭越渡睢，與項聲、薛公戰下邳，破，殺薛公。"
  },
  {
    "id": "s0242",
    "blockIndex": 21,
    "zh": "羽乃使終公守成皋，而自東擊彭越。"
  },
  {
    "id": "s0243",
    "blockIndex": 21,
    "zh": "漢王引兵北，擊破終公，復軍成皋。"
  },
  {
    "id": "s0244",
    "blockIndex": 22,
    "zh": "六月，羽已破走彭越，聞漢復軍成皋，乃引兵西拔滎陽城，生得周苛。"
  },
  {
    "id": "s0245",
    "blockIndex": 22,
    "zh": "羽謂苛：「為我將，以公為上將軍，封三萬戶。"
  },
  {
    "id": "s0246",
    "blockIndex": 22,
    "zh": "」周苛罵曰：「若不趨降漢，今為虜矣；"
  },
  {
    "id": "s0247",
    "blockIndex": 22,
    "zh": "若非漢王敵也！"
  },
  {
    "id": "s0248",
    "blockIndex": 22,
    "zh": "」羽烹周苛，並殺樅公而虜韓王信，遂圍成皋。"
  },
  {
    "id": "s0249",
    "blockIndex": 22,
    "zh": "漢王逃，獨與滕公共車出成皋玉門，北渡河，宿小脩武傳舍。"
  },
  {
    "id": "s0250",
    "blockIndex": 22,
    "zh": "晨，自稱漢使，馳入趙壁。"
  },
  {
    "id": "s0251",
    "blockIndex": 22,
    "zh": "張耳、韓信未起，即其臥內，奪其印符以麾召諸將，易置之。"
  },
  {
    "id": "s0252",
    "blockIndex": 22,
    "zh": "信、耳起，乃知漢王來，大驚。"
  },
  {
    "id": "s0253",
    "blockIndex": 22,
    "zh": "漢王既奪兩人軍，即令張耳徇行，備守趙地。"
  },
  {
    "id": "s0254",
    "blockIndex": 22,
    "zh": "拜韓信為相國，收趙兵未發者擊齊。"
  },
  {
    "id": "s0255",
    "blockIndex": 22,
    "zh": "諸將稍稍得出成皋從漢王。"
  },
  {
    "id": "s0256",
    "blockIndex": 22,
    "zh": "楚拔成皋，欲西；"
  },
  {
    "id": "s0257",
    "blockIndex": 22,
    "zh": "漢使兵距之鞏，令其不得西。"
  },
  {
    "id": "s0259",
    "blockIndex": 23,
    "zh": "6秋，七月，有星孛於大角。"
  },
  {
    "id": "s0261",
    "blockIndex": 24,
    "zh": "7臨江王敖薨，子尉嗣。"
  },
  {
    "id": "s0263",
    "blockIndex": 25,
    "zh": "8漢王得韓信軍，復大振。"
  },
  {
    "id": "s0264",
    "blockIndex": 25,
    "zh": "八月，引兵臨河，南鄉，軍小脩武，欲復與楚戰。"
  },
  {
    "id": "s0265",
    "blockIndex": 25,
    "zh": "郎中鄭忠說止漢王，使高壘深塹勿與戰。"
  },
  {
    "id": "s0266",
    "blockIndex": 25,
    "zh": "漢王聽其計，使將軍劉賈、盧綰將卒二萬人，騎數百，度白馬津，入楚地，佐彭越，燒楚積聚，以破其業，無以給項王軍食而已。"
  },
  {
    "id": "s0267",
    "blockIndex": 25,
    "zh": "楚兵擊劉賈，賈輒堅壁不肯與戰，而與彭越相保。"
  },
  {
    "id": "s0269",
    "blockIndex": 26,
    "zh": "9彭越攻徇梁地，下睢陽、外黃等十七城。"
  },
  {
    "id": "s0270",
    "blockIndex": 26,
    "zh": "九月，項王謂大司馬曹咎曰：「謹守成皋。"
  },
  {
    "id": "s0271",
    "blockIndex": 26,
    "zh": "即漢王欲挑戰，慎勿與戰，勿令得東而已。"
  },
  {
    "id": "s0272",
    "blockIndex": 26,
    "zh": "我十五日必定梁地，復從將軍。"
  },
  {
    "id": "s0273",
    "blockIndex": 26,
    "zh": "」羽引兵東行，擊陳留、外黃、睢陽等城，皆下之。"
  },
  {
    "id": "s0274",
    "blockIndex": 27,
    "zh": "漢王欲捐成皋以東，屯鞏、洛以距楚。"
  },
  {
    "id": "s0275",
    "blockIndex": 27,
    "zh": "酈生曰：「臣聞『知天之天者，王事可成』，王者以民為天，而民以食為天。"
  },
  {
    "id": "s0276",
    "blockIndex": 27,
    "zh": "夫敖倉，天下轉輸久矣，臣聞其下乃有藏粟甚多。"
  },
  {
    "id": "s0277",
    "blockIndex": 27,
    "zh": "楚人拔滎陽，不堅守敖倉，乃引而東，令適卒分守成皋，此乃天所以資漢也。"
  },
  {
    "id": "s0278",
    "blockIndex": 27,
    "zh": "方今楚易取而漢反卻，自奪其便，臣竊以為過矣。"
  },
  {
    "id": "s0279",
    "blockIndex": 27,
    "zh": "且兩雄不俱立，楚、漢久相持不決，海內搖蕩，農夫釋耒，紅女下機，天下之心未有所定也。"
  },
  {
    "id": "s0280",
    "blockIndex": 27,
    "zh": "願足下急復進兵，收取滎陽，據敖倉之粟，塞成皋之險，杜太行之道，距蜚狐之口，守白馬之津，以示諸侯形制之勢，則天下知所歸矣。"
  },
  {
    "id": "s0281",
    "blockIndex": 27,
    "zh": "」王從之，乃復謀取敖倉。"
  },
  {
    "id": "s0282",
    "blockIndex": 27,
    "zh": "食其又說王曰：「方今燕、趙已定，唯齊未下，諸田宗強，負海、岱，阻河、濟，南近於楚，人多變詐；"
  },
  {
    "id": "s0283",
    "blockIndex": 27,
    "zh": "足下雖遣數萬師，未可以歲月破也。"
  },
  {
    "id": "s0284",
    "blockIndex": 27,
    "zh": "臣請得奉明詔說齊王，使為漢而稱東籓。"
  },
  {
    "id": "s0285",
    "blockIndex": 27,
    "zh": "」上曰：「善！"
  },
  {
    "id": "s0286",
    "blockIndex": 27,
    "zh": "」乃使酈生說齊王曰：「王知天下之所歸乎？"
  },
  {
    "id": "s0287",
    "blockIndex": 27,
    "zh": "」王曰：「不知也。"
  },
  {
    "id": "s0288",
    "blockIndex": 27,
    "zh": "天下何所歸？"
  },
  {
    "id": "s0289",
    "blockIndex": 27,
    "zh": "」酈生曰：「歸漢。"
  },
  {
    "id": "s0290",
    "blockIndex": 27,
    "zh": "」曰：「先生何以言之？"
  },
  {
    "id": "s0291",
    "blockIndex": 27,
    "zh": "」曰：「漢王先入咸陽，項王負約，王之漢中。"
  },
  {
    "id": "s0292",
    "blockIndex": 27,
    "zh": "項王遷殺義帝，漢王聞之，起蜀、漢之兵擊三秦，出關而責義帝之處。"
  },
  {
    "id": "s0293",
    "blockIndex": 27,
    "zh": "收天下之兵，立諸侯之後；"
  },
  {
    "id": "s0294",
    "blockIndex": 27,
    "zh": "降城即以侯其將，得賂即以分其士；"
  },
  {
    "id": "s0295",
    "blockIndex": 27,
    "zh": "與天下同其利，豪英賢才皆樂為之用。"
  },
  {
    "id": "s0296",
    "blockIndex": 27,
    "zh": "項王有倍約之名，殺義帝之實；"
  },
  {
    "id": "s0297",
    "blockIndex": 27,
    "zh": "於人之功無所記，於人之罪無所忘；"
  },
  {
    "id": "s0298",
    "blockIndex": 27,
    "zh": "戰勝而不得其賞，拔城而不得其封，非項氏莫得用事；"
  },
  {
    "id": "s0299",
    "blockIndex": 27,
    "zh": "天下畔之，賢才怨之，而莫為之用。"
  },
  {
    "id": "s0300",
    "blockIndex": 27,
    "zh": "故天下之事歸於漢王，可坐而策也！"
  },
  {
    "id": "s0301",
    "blockIndex": 27,
    "zh": "夫漢王發蜀、漢，定三秦；"
  },
  {
    "id": "s0302",
    "blockIndex": 27,
    "zh": "涉西河，破北魏；"
  },
  {
    "id": "s0303",
    "blockIndex": 27,
    "zh": "出井陘，誅成安君；"
  },
  {
    "id": "s0304",
    "blockIndex": 27,
    "zh": "此非人之力也，天之福也！"
  },
  {
    "id": "s0305",
    "blockIndex": 27,
    "zh": "今已據敖倉之粟，塞成皋之險，守白馬之津，杜太行之阪，距蜚狐之口；"
  },
  {
    "id": "s0306",
    "blockIndex": 27,
    "zh": "天下後服者先亡矣。"
  },
  {
    "id": "s0307",
    "blockIndex": 27,
    "zh": "王疾先下漢王，齊國可得而保也；"
  },
  {
    "id": "s0308",
    "blockIndex": 27,
    "zh": "不然，危亡可立而待也！"
  },
  {
    "id": "s0309",
    "blockIndex": 27,
    "zh": "」先是，齊聞韓信且東兵，使華無傷、田解將重兵屯歷下以距漢。"
  },
  {
    "id": "s0310",
    "blockIndex": 27,
    "zh": "及納酈生之言，遣使與漢平，乃罷歷下守戰備，與酈生日縱酒為樂。"
  },
  {
    "id": "s0311",
    "blockIndex": 27,
    "zh": "韓信引兵東，未度平原，聞酈食其已說下齊，欲止。"
  },
  {
    "id": "s0312",
    "blockIndex": 27,
    "zh": "辨士蒯徹說信曰：「將軍受詔擊齊，而漢獨發間使下齊，寧有詔止將軍乎？"
  },
  {
    "id": "s0313",
    "blockIndex": 27,
    "zh": "何以得毋行也？"
  },
  {
    "id": "s0314",
    "blockIndex": 27,
    "zh": "且酈生，一士，伏軾掉三寸之舌，下齊七十餘城，將軍以數萬眾，歲餘乃下趙五十餘城。"
  },
  {
    "id": "s0315",
    "blockIndex": 27,
    "zh": "為將數歲，反不如一豎儒之功乎？"
  },
  {
    "id": "s0316",
    "blockIndex": 27,
    "zh": "」於是信然之，遂渡河。"
  },
  {
    "id": "s0317",
    "blockIndex": 28,
    "zh": "1冬，十月，信襲破齊歷下軍，遂至臨淄。"
  },
  {
    "id": "s0318",
    "blockIndex": 28,
    "zh": "齊王以酈生為賣己，乃烹之；"
  },
  {
    "id": "s0319",
    "blockIndex": 28,
    "zh": "引兵東走高密，使使之楚請救。"
  },
  {
    "id": "s0320",
    "blockIndex": 28,
    "zh": "田橫走博陽，守相田光走城陽，將軍田既軍於膠東。"
  },
  {
    "id": "s0322",
    "blockIndex": 29,
    "zh": "2楚大司馬咎守成皋，漢數挑戰，楚軍不出。"
  },
  {
    "id": "s0323",
    "blockIndex": 29,
    "zh": "使人辱之，數日，咎怒，渡兵汜水。"
  },
  {
    "id": "s0324",
    "blockIndex": 29,
    "zh": "士卒半渡，漢擊之，大破楚軍，盡得楚國金玉、貨賂，咎及司馬欣皆自剄汜水上。"
  },
  {
    "id": "s0325",
    "blockIndex": 29,
    "zh": "漢王引兵渡河，復取成皋，軍廣武，就敖倉食。"
  },
  {
    "id": "s0326",
    "blockIndex": 30,
    "zh": "項羽下梁地十餘城，聞成皋破，乃引兵還。"
  },
  {
    "id": "s0327",
    "blockIndex": 30,
    "zh": "漢軍方圍鍾離昧於滎陽東，聞羽至，盡走險阻。"
  },
  {
    "id": "s0328",
    "blockIndex": 30,
    "zh": "羽亦軍廣武，與漢相守。"
  },
  {
    "id": "s0329",
    "blockIndex": 30,
    "zh": "數月，楚軍食少。"
  },
  {
    "id": "s0330",
    "blockIndex": 30,
    "zh": "項王患之，乃為高祖，置太公其上，告漢王曰：「今不急下，吾烹太公！"
  },
  {
    "id": "s0331",
    "blockIndex": 30,
    "zh": "」漢王曰：「吾與羽俱北面受命懷王，約為兄弟，吾翁即若翁；"
  },
  {
    "id": "s0332",
    "blockIndex": 30,
    "zh": "必欲烹而翁，幸分我一杯羹！"
  },
  {
    "id": "s0333",
    "blockIndex": 30,
    "zh": "」項王怒，欲殺之。"
  },
  {
    "id": "s0334",
    "blockIndex": 30,
    "zh": "項伯曰：「天下事未可知。"
  },
  {
    "id": "s0335",
    "blockIndex": 30,
    "zh": "且為天下者不顧家，雖殺之，無益，只益禍耳！"
  },
  {
    "id": "s0336",
    "blockIndex": 30,
    "zh": "」項王從之。"
  },
  {
    "id": "s0337",
    "blockIndex": 31,
    "zh": "項王謂漢王曰：「天下匈匈數歲者，徒以吾兩人耳。"
  },
  {
    "id": "s0338",
    "blockIndex": 31,
    "zh": "願與漢王挑戰，決雌雄，毋徒苦天下之民父子為也！"
  },
  {
    "id": "s0339",
    "blockIndex": 31,
    "zh": "」漢王笑謝曰；"
  },
  {
    "id": "s0340",
    "blockIndex": 31,
    "zh": "「吾寧鬥智，不能鬥力！"
  },
  {
    "id": "s0341",
    "blockIndex": 31,
    "zh": "」項王三令壯士出挑戰，漢有善騎射者樓煩輒射殺之。"
  },
  {
    "id": "s0342",
    "blockIndex": 31,
    "zh": "項王大怒，乃自被甲持戟挑戰。"
  },
  {
    "id": "s0343",
    "blockIndex": 31,
    "zh": "樓煩欲射之，項王瞋目叱之，樓煩目不敢視，手不敢發，遂走還入壁，不敢復出。"
  },
  {
    "id": "s0344",
    "blockIndex": 31,
    "zh": "漢王使人間問之，乃項王也，漢王大驚。"
  },
  {
    "id": "s0345",
    "blockIndex": 32,
    "zh": "於是項王乃即漢王，相與臨廣武間而語。"
  },
  {
    "id": "s0346",
    "blockIndex": 32,
    "zh": "羽欲與漢王獨身挑戰。"
  },
  {
    "id": "s0347",
    "blockIndex": 32,
    "zh": "漢王數羽曰：「羽負約，王我於蜀、漢，罪一；"
  },
  {
    "id": "s0348",
    "blockIndex": 32,
    "zh": "矯殺卿子冠軍，罪二；"
  },
  {
    "id": "s0349",
    "blockIndex": 32,
    "zh": "救趙不還報，而擅劫諸侯兵入關，罪三；"
  },
  {
    "id": "s0350",
    "blockIndex": 32,
    "zh": "燒秦宮室，掘始皇帝塚，收私其財，罪四；"
  },
  {
    "id": "s0351",
    "blockIndex": 32,
    "zh": "殺秦降王子嬰，罪五；"
  },
  {
    "id": "s0352",
    "blockIndex": 32,
    "zh": "詐坑秦子弟新安二十萬，罪六；"
  },
  {
    "id": "s0353",
    "blockIndex": 32,
    "zh": "王諸將善地而徙逐故主，罪七；"
  },
  {
    "id": "s0354",
    "blockIndex": 32,
    "zh": "出逐義帝彭城，自都之，奪韓王地，並王梁、楚，多自與，罪八；"
  },
  {
    "id": "s0355",
    "blockIndex": 32,
    "zh": "使人陰殺義帝江南，罪九；"
  },
  {
    "id": "s0356",
    "blockIndex": 32,
    "zh": "為政不平，王約不信，天下所不容，大逆無道，罪十也。"
  },
  {
    "id": "s0357",
    "blockIndex": 32,
    "zh": "吾以義兵從諸侯誅殘賊，使刑餘罪人擊公，何苦乃與公挑戰！"
  },
  {
    "id": "s0358",
    "blockIndex": 32,
    "zh": "」羽大怒，伏弩射中漢王。"
  },
  {
    "id": "s0359",
    "blockIndex": 32,
    "zh": "漢王傷胸，乃捫足曰：「虜中吾指。"
  },
  {
    "id": "s0360",
    "blockIndex": 32,
    "zh": "」漢王病創臥，張良強請漢王起行勞軍，以安士卒，毋令楚乘勝。"
  },
  {
    "id": "s0361",
    "blockIndex": 32,
    "zh": "漢王出行軍，疾甚，因馳入成皋。"
  },
  {
    "id": "s0363",
    "blockIndex": 33,
    "zh": "3韓信已定臨淄，遂東追齊王。"
  },
  {
    "id": "s0364",
    "blockIndex": 33,
    "zh": "項王使龍且將兵，號二十萬，以救齊，與齊王合軍高密。"
  },
  {
    "id": "s0365",
    "blockIndex": 34,
    "zh": "客或說龍且曰：「漢兵遠鬥窮戰，其鋒不可當。"
  },
  {
    "id": "s0366",
    "blockIndex": 34,
    "zh": "齊、楚自居其地，兵易敗散。"
  },
  {
    "id": "s0367",
    "blockIndex": 34,
    "zh": "不如深壁，令齊王使其信臣招所亡城；"
  },
  {
    "id": "s0368",
    "blockIndex": 34,
    "zh": "亡城聞王在，楚來救，必反漢。"
  },
  {
    "id": "s0369",
    "blockIndex": 34,
    "zh": "漢兵二千里客居齊地，齊城皆反之，其勢無所得食，可無戰而降也。"
  },
  {
    "id": "s0370",
    "blockIndex": 34,
    "zh": "」龍且曰：「吾平生知韓信為人，易與耳！"
  },
  {
    "id": "s0371",
    "blockIndex": 34,
    "zh": "寄食於漂母，無資身之策；"
  },
  {
    "id": "s0372",
    "blockIndex": 34,
    "zh": "受辱於胯下，無兼人之勇，不足畏也。"
  },
  {
    "id": "s0373",
    "blockIndex": 34,
    "zh": "且夫救齊，不戰而降之，吾何功！"
  },
  {
    "id": "s0374",
    "blockIndex": 34,
    "zh": "今戰而勝之，齊之半可得也。"
  },
  {
    "id": "s0376",
    "blockIndex": 35,
    "zh": "十一月，齊、楚與漢夾濰水而陳。"
  },
  {
    "id": "s0377",
    "blockIndex": 35,
    "zh": "韓信儲夜令人為萬餘囊，滿盛沙，壅水上流；"
  },
  {
    "id": "s0378",
    "blockIndex": 35,
    "zh": "引軍半渡擊龍且，佯不勝，還走。"
  },
  {
    "id": "s0379",
    "blockIndex": 35,
    "zh": "龍且果喜曰：「固知信怯也！"
  },
  {
    "id": "s0380",
    "blockIndex": 35,
    "zh": "」遂追信。"
  },
  {
    "id": "s0381",
    "blockIndex": 35,
    "zh": "信使人決壅囊，水大至，龍且軍太半不得渡。"
  },
  {
    "id": "s0382",
    "blockIndex": 35,
    "zh": "即急擊殺龍且，水東軍散走，齊王廣亡去。"
  },
  {
    "id": "s0383",
    "blockIndex": 35,
    "zh": "信遂追北至成陽，虜齊王廣。"
  },
  {
    "id": "s0384",
    "blockIndex": 35,
    "zh": "漢將灌嬰追得齊守相田光，進至博陽。"
  },
  {
    "id": "s0385",
    "blockIndex": 35,
    "zh": "田橫聞齊王死，自立為齊王，還擊嬰，嬰敗橫軍於嬴下。"
  },
  {
    "id": "s0386",
    "blockIndex": 35,
    "zh": "田橫亡走梁，歸彭越。"
  },
  {
    "id": "s0387",
    "blockIndex": 35,
    "zh": "嬰進擊齊將田吸於千乘，曹參擊田既於膠東，皆殺之，盡定齊地。"
  },
  {
    "id": "s0389",
    "blockIndex": 36,
    "zh": "4立張耳為趙王。"
  },
  {
    "id": "s0391",
    "blockIndex": 37,
    "zh": "5漢王疾愈，西入關。"
  },
  {
    "id": "s0392",
    "blockIndex": 37,
    "zh": "至櫟陽，梟故塞王欣頭櫟陽市。"
  },
  {
    "id": "s0393",
    "blockIndex": 37,
    "zh": "留四日，復如軍，軍廣武。"
  },
  {
    "id": "s0395",
    "blockIndex": 38,
    "zh": "6韓信使人言漢王曰：「齊偽詐多變，反覆之國也；"
  },
  {
    "id": "s0396",
    "blockIndex": 38,
    "zh": "南邊楚。"
  },
  {
    "id": "s0397",
    "blockIndex": 38,
    "zh": "請為假王以鎮之。"
  },
  {
    "id": "s0398",
    "blockIndex": 38,
    "zh": "」漢王發書，大怒，罵曰：「吾困於此，旦暮望若來佐我，乃欲自立為王！"
  },
  {
    "id": "s0399",
    "blockIndex": 38,
    "zh": "」張良、陳平躡漢王足，因附耳語曰：「漢方不利，寧能禁信之自王乎！"
  },
  {
    "id": "s0400",
    "blockIndex": 38,
    "zh": "不如因而立之，善遇，使自為守。"
  },
  {
    "id": "s0401",
    "blockIndex": 38,
    "zh": "不然，變生。"
  },
  {
    "id": "s0402",
    "blockIndex": 38,
    "zh": "」漢王亦悟，因復罵曰：「大丈夫定諸侯，即為真王耳，何以假為！"
  },
  {
    "id": "s0403",
    "blockIndex": 38,
    "zh": "」春，二月，遣張良操印立韓信為齊王，征其兵擊楚。"
  },
  {
    "id": "s0404",
    "blockIndex": 38,
    "zh": "----7項王聞龍且死，大懼，使盱台人涉往說齊王信曰：「天下共苦秦久矣，相與戮力擊秦。"
  },
  {
    "id": "s0405",
    "blockIndex": 38,
    "zh": "秦已破，計功割地，分土而王之，以休士卒。"
  },
  {
    "id": "s0406",
    "blockIndex": 38,
    "zh": "今漢王復興兵而東，侵人之分，奪人之地；"
  },
  {
    "id": "s0407",
    "blockIndex": 38,
    "zh": "已破三秦，引兵出關，收諸侯之兵以東擊楚，其意非盡吞天下者不休，其不知厭足如是甚也！"
  },
  {
    "id": "s0408",
    "blockIndex": 38,
    "zh": "且漢王不可必，身居項王掌握中數矣，項王憐而活之；"
  },
  {
    "id": "s0409",
    "blockIndex": 38,
    "zh": "然得脫，輒倍約，復擊項王，其不可親信如此。"
  },
  {
    "id": "s0410",
    "blockIndex": 38,
    "zh": "今足下雖自以與漢王為厚交，為之盡力用兵，必終為所禽矣。"
  },
  {
    "id": "s0411",
    "blockIndex": 38,
    "zh": "足下所以得須臾至今者，以項王尚存也。"
  },
  {
    "id": "s0412",
    "blockIndex": 38,
    "zh": "當今二王之事，權在足下，足下右投則漢王勝，左投則項王勝。"
  },
  {
    "id": "s0413",
    "blockIndex": 38,
    "zh": "項王今日亡，則次取足下。"
  },
  {
    "id": "s0414",
    "blockIndex": 38,
    "zh": "足下與項王有故，何不反漢與楚連和，參分天下王之！"
  },
  {
    "id": "s0415",
    "blockIndex": 38,
    "zh": "今釋此時而自必於漢以擊楚，且為智者固若此乎？"
  },
  {
    "id": "s0417",
    "blockIndex": 38,
    "zh": "」韓信謝曰：「臣事項王，官不過郎中，位不過執戟；"
  },
  {
    "id": "s0418",
    "blockIndex": 38,
    "zh": "言不聽，畫不用，故倍楚而歸漢。"
  },
  {
    "id": "s0419",
    "blockIndex": 38,
    "zh": "漢王授我上將軍印，予我數萬眾，解衣衣我，推食食我，言聽計用，故吾得以至於此。"
  },
  {
    "id": "s0420",
    "blockIndex": 38,
    "zh": "夫人深親我，我倍之不祥；"
  },
  {
    "id": "s0421",
    "blockIndex": 38,
    "zh": "雖死不易！"
  },
  {
    "id": "s0422",
    "blockIndex": 38,
    "zh": "幸為信謝項王！"
  },
  {
    "id": "s0424",
    "blockIndex": 39,
    "zh": "武涉已去，蒯徹知天下權在信，乃以相人之術說信曰：「僕相君之面，不過封侯，又危不安；"
  },
  {
    "id": "s0425",
    "blockIndex": 39,
    "zh": "相君之背，貴乃不可言。"
  },
  {
    "id": "s0426",
    "blockIndex": 39,
    "zh": "」韓信曰：「何謂也？"
  },
  {
    "id": "s0427",
    "blockIndex": 39,
    "zh": "」蒯徹曰：「天下初發難也，憂在亡秦而已。"
  },
  {
    "id": "s0428",
    "blockIndex": 39,
    "zh": "今楚、漢分爭，使天下之人肝膽塗地，父子暴骸骨於中野，不可勝數。"
  },
  {
    "id": "s0429",
    "blockIndex": 39,
    "zh": "楚人起彭城，轉鬥逐北，乘利席捲，威震天下；"
  },
  {
    "id": "s0430",
    "blockIndex": 39,
    "zh": "然兵困於京、索之間，迫西山而不能進者，三年於此矣。"
  },
  {
    "id": "s0431",
    "blockIndex": 39,
    "zh": "漢王將數十萬之眾，距鞏、雒，阻山河之險，一日數戰，無尺寸之功，折北不救。"
  },
  {
    "id": "s0432",
    "blockIndex": 39,
    "zh": "此所謂智勇俱困者也。"
  },
  {
    "id": "s0433",
    "blockIndex": 39,
    "zh": "百姓罷極怨望，無所歸倚。"
  },
  {
    "id": "s0434",
    "blockIndex": 39,
    "zh": "以臣料之，其勢非天下之賢聖固不能息天下之禍。"
  },
  {
    "id": "s0435",
    "blockIndex": 39,
    "zh": "當今兩主之命，縣於足下，足下為漢則漢勝，與楚則楚勝。"
  },
  {
    "id": "s0436",
    "blockIndex": 39,
    "zh": "誠能聽臣之計，莫若兩利而俱存之，參分天下，鼎足而居，其勢莫敢先動。"
  },
  {
    "id": "s0437",
    "blockIndex": 39,
    "zh": "夫以足下之賢聖，有甲兵之聚，據強齊，從趙、燕，出空虛之地而制其後，因民之欲，西鄉為百姓請命，則天下風走而響應矣，孰敢不聽！"
  },
  {
    "id": "s0438",
    "blockIndex": 39,
    "zh": "割大弱強以立諸侯，諸侯已立，天下服聽，而歸德於齊。"
  },
  {
    "id": "s0439",
    "blockIndex": 39,
    "zh": "案齊之故，有膠、泗之地，深拱揖讓，則天下之君王相率而朝於齊矣。"
  },
  {
    "id": "s0440",
    "blockIndex": 39,
    "zh": "蓋聞『天與弗取，反受其咎；"
  },
  {
    "id": "s0441",
    "blockIndex": 39,
    "zh": "時至不行，反受其殃』。"
  },
  {
    "id": "s0442",
    "blockIndex": 39,
    "zh": "願足下熟慮之！"
  },
  {
    "id": "s0443",
    "blockIndex": 39,
    "zh": "」韓信曰：「漢王遇我甚厚，吾豈可鄉利而倍義乎！"
  },
  {
    "id": "s0444",
    "blockIndex": 39,
    "zh": "」蒯生曰：「始常山王、成安君為布衣時，相與為刎頸之交；"
  },
  {
    "id": "s0445",
    "blockIndex": 39,
    "zh": "後爭張黶、陳澤之事，常山王殺成安君泜水之南，頭足異處。"
  },
  {
    "id": "s0446",
    "blockIndex": 39,
    "zh": "此二人相與，天下至歡也，然而卒相禽者，何也？"
  },
  {
    "id": "s0447",
    "blockIndex": 39,
    "zh": "患生於多欲而人心難測也。"
  },
  {
    "id": "s0448",
    "blockIndex": 39,
    "zh": "今足下欲行忠信以交於漢王，必不能固於二君之相與也，而事多大於張黶、陳澤者；"
  },
  {
    "id": "s0449",
    "blockIndex": 39,
    "zh": "故臣以為足下必漢王之不危己，亦誤矣！"
  },
  {
    "id": "s0450",
    "blockIndex": 39,
    "zh": "大夫種存亡越，霸句踐，立功成名而身死亡，野獸盡而獵狗烹。"
  },
  {
    "id": "s0451",
    "blockIndex": 39,
    "zh": "夫以交友言之，則不如張耳之與成安君者也；"
  },
  {
    "id": "s0452",
    "blockIndex": 39,
    "zh": "以忠信言之，則不過大夫種之於句踐也，此二者足以觀矣！"
  },
  {
    "id": "s0453",
    "blockIndex": 39,
    "zh": "願足下深慮之。"
  },
  {
    "id": "s0454",
    "blockIndex": 39,
    "zh": "且臣聞『勇略震主者身危，功蓋天下者不賞』。"
  },
  {
    "id": "s0455",
    "blockIndex": 39,
    "zh": "今足下戴震主之威，挾不賞之功，歸楚，楚人不信；"
  },
  {
    "id": "s0456",
    "blockIndex": 39,
    "zh": "歸漢，漢人震恐。"
  },
  {
    "id": "s0457",
    "blockIndex": 39,
    "zh": "足下欲持是安歸乎？"
  },
  {
    "id": "s0458",
    "blockIndex": 39,
    "zh": "」韓信謝曰：「先生且休矣，吾將念。"
  },
  {
    "id": "s0459",
    "blockIndex": 39,
    "zh": "」後數日，蒯徹復說曰：「夫聽者，事之候也；"
  },
  {
    "id": "s0460",
    "blockIndex": 39,
    "zh": "計者，事之機也；"
  },
  {
    "id": "s0461",
    "blockIndex": 39,
    "zh": "聽過計失而能久安者鮮矣！"
  },
  {
    "id": "s0462",
    "blockIndex": 39,
    "zh": "故知者，決之斷也；"
  },
  {
    "id": "s0463",
    "blockIndex": 39,
    "zh": "疑者，事之害也。"
  },
  {
    "id": "s0464",
    "blockIndex": 39,
    "zh": "審豪厘之小計，遺天下之大數，智誠知之，決弗敢行者，百事之禍也。"
  },
  {
    "id": "s0465",
    "blockIndex": 39,
    "zh": "夫功者，難成而易敗；"
  },
  {
    "id": "s0466",
    "blockIndex": 39,
    "zh": "時者，難得而易失也；"
  },
  {
    "id": "s0467",
    "blockIndex": 39,
    "zh": "時乎時，不再來！"
  },
  {
    "id": "s0468",
    "blockIndex": 39,
    "zh": "」韓信猶豫，不忍倍漢；"
  },
  {
    "id": "s0469",
    "blockIndex": 39,
    "zh": "又自以功多，漢終不奪我齊，遂謝。"
  },
  {
    "id": "s0470",
    "blockIndex": 39,
    "zh": "蒯徹因去，佯狂為巫。"
  },
  {
    "id": "s0472",
    "blockIndex": 40,
    "zh": "8秋，七月，立黥布為淮南王。"
  },
  {
    "id": "s0474",
    "blockIndex": 41,
    "zh": "9八月，北貉燕人來致梟騎助漢。"
  },
  {
    "id": "s0476",
    "blockIndex": 42,
    "zh": "10漢王下令：軍士不幸死者，吏為衣衾棺斂，轉送其家。"
  },
  {
    "id": "s0477",
    "blockIndex": 42,
    "zh": "四方歸心焉。"
  },
  {
    "id": "s0479",
    "blockIndex": 43,
    "zh": "11是歲，以中尉周昌為御史大夫。"
  },
  {
    "id": "s0480",
    "blockIndex": 43,
    "zh": "昌，苛從弟也。"
  },
  {
    "id": "s0482",
    "blockIndex": 44,
    "zh": "12項羽自知少助；"
  },
  {
    "id": "s0483",
    "blockIndex": 44,
    "zh": "食盡，韓信又進兵擊楚，羽患之。"
  },
  {
    "id": "s0484",
    "blockIndex": 44,
    "zh": "漢遣侯公說羽請太公。"
  },
  {
    "id": "s0485",
    "blockIndex": 44,
    "zh": "羽乃與漢約，中分天下，割洪溝以西為漢，以東為楚。"
  },
  {
    "id": "s0486",
    "blockIndex": 44,
    "zh": "九月，楚歸太公、呂-{后}-，引兵解而東歸。"
  },
  {
    "id": "s0487",
    "blockIndex": 44,
    "zh": "漢王欲西歸，張良、陳平說曰：「漢有天下太半，而諸侯皆附；"
  },
  {
    "id": "s0488",
    "blockIndex": 44,
    "zh": "楚兵疲食盡，此天亡之時也。"
  },
  {
    "id": "s0489",
    "blockIndex": 44,
    "zh": "今釋弗擊，此所謂養虎自遺患也。"
  },
  {
    "id": "s0490",
    "blockIndex": 44,
    "zh": "」漢王從之。"
  },
  {
    "id": "s0491",
    "blockIndex": 45,
    "zh": "category:資治通鑑"
  }
]
