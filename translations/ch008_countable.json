[
  {
    "id": "s0001",
    "blockIndex": 0,
    "zh": "__FORCETOC__"
  },
  {
    "id": "s0002",
    "blockIndex": 1,
    "zh": "起昭陽大荒落，盡閼逢敦牂，凡二年。"
  },
  {
    "id": "s0003",
    "blockIndex": 2,
    "zh": "1冬，十月，泗川監平將兵圍沛公於豐，沛公出與戰，破之，令雍齒守豐。"
  },
  {
    "id": "s0004",
    "blockIndex": 2,
    "zh": "十一月，沛公引兵之薛。"
  },
  {
    "id": "s0005",
    "blockIndex": 2,
    "zh": "泗川守壯兵敗於薛，走至戚，沛公左司馬得殺之。"
  },
  {
    "id": "s0007",
    "blockIndex": 3,
    "zh": "2周章出關，止屯曹陽，二月餘，章邯追敗之。"
  },
  {
    "id": "s0008",
    "blockIndex": 3,
    "zh": "復走澠池，十餘日，章邯擊，大破之。"
  },
  {
    "id": "s0009",
    "blockIndex": 3,
    "zh": "周文自刎，軍遂不戰。"
  },
  {
    "id": "s0010",
    "blockIndex": 4,
    "zh": "吳叔圍滎陽，李由為三川守，守滎陽，叔弗能下。"
  },
  {
    "id": "s0011",
    "blockIndex": 4,
    "zh": "楚將軍田臧等相與謀曰：「周章軍已破矣，秦兵旦暮至。"
  },
  {
    "id": "s0012",
    "blockIndex": 4,
    "zh": "我圍滎陽城弗能下，秦兵至，必大敗，不如少遺兵守滎陽，悉精兵迎秦軍。"
  },
  {
    "id": "s0013",
    "blockIndex": 4,
    "zh": "今假王驕，不知兵權，不足與計事，恐敗。"
  },
  {
    "id": "s0014",
    "blockIndex": 4,
    "zh": "」因相與矯王令以誅吳叔，獻其首於陳王。"
  },
  {
    "id": "s0015",
    "blockIndex": 4,
    "zh": "陳王使使賜田臧楚令尹印，使為上將。"
  },
  {
    "id": "s0016",
    "blockIndex": 5,
    "zh": "田臧乃使諸將李歸等守滎陽，自以精兵西迎秦軍於敖倉，與戰。"
  },
  {
    "id": "s0017",
    "blockIndex": 5,
    "zh": "田臧死，軍破。"
  },
  {
    "id": "s0018",
    "blockIndex": 5,
    "zh": "章邯進兵擊李歸等滎陽下，破之，李歸等死。"
  },
  {
    "id": "s0019",
    "blockIndex": 5,
    "zh": "陽城人鄧說將兵居郯，章邯別將擊破之。"
  },
  {
    "id": "s0020",
    "blockIndex": 5,
    "zh": "銍人伍逢將兵居許，章邯擊破之。"
  },
  {
    "id": "s0021",
    "blockIndex": 5,
    "zh": "兩軍皆散，走陳，陳王誅鄧說。"
  },
  {
    "id": "s0023",
    "blockIndex": 6,
    "zh": "3二世數誚讓李斯：「居三公位，如何令盜如此！"
  },
  {
    "id": "s0024",
    "blockIndex": 6,
    "zh": "」李斯恐懼，重爵祿，不知所出，乃阿二世意，以書對曰：「夫賢主者，必能行督責之術者也。"
  },
  {
    "id": "s0025",
    "blockIndex": 6,
    "zh": "故申子曰『有天下而不恣睢，命之曰以天下為桎梏』者，無他焉，不能督責，而顧以其身勞於天下之民，若堯、禹然，故謂之桎梏也。"
  },
  {
    "id": "s0026",
    "blockIndex": 6,
    "zh": "夫不能修申、韓之明術，行督責之道，專以天下自適也；"
  },
  {
    "id": "s0027",
    "blockIndex": 6,
    "zh": "而徒務苦形勞神，以身徇百姓，則是黔首之役，非畜天下者也，何足貴哉！"
  },
  {
    "id": "s0028",
    "blockIndex": 6,
    "zh": "故明主能行督責之術以獨斷於上，則權不在臣下，然後能滅仁義之塗，絕諫說之辯，犖然行恣睢之心，而莫之敢逆。"
  },
  {
    "id": "s0029",
    "blockIndex": 6,
    "zh": "如此，群臣、百姓救過不給，何變之敢圖！"
  },
  {
    "id": "s0030",
    "blockIndex": 6,
    "zh": "」二世說，於是行督責益嚴，稅民深者為明吏，殺人眾者為忠臣，刑者相半於道，而死人日成積於市，秦民益駭懼思亂。"
  },
  {
    "id": "s0032",
    "blockIndex": 7,
    "zh": "4趙李良已定常山，還報趙王。"
  },
  {
    "id": "s0033",
    "blockIndex": 7,
    "zh": "趙王復使良略太原。"
  },
  {
    "id": "s0034",
    "blockIndex": 7,
    "zh": "至石邑，秦兵塞井陘，未能前。"
  },
  {
    "id": "s0035",
    "blockIndex": 7,
    "zh": "秦將詐為二世書以招良。"
  },
  {
    "id": "s0036",
    "blockIndex": 7,
    "zh": "良得書未信，還之邯鄲，益請兵。"
  },
  {
    "id": "s0037",
    "blockIndex": 7,
    "zh": "未至，道逢趙王姊出飲，從百餘騎，良望見，以為王，伏謁道旁。"
  },
  {
    "id": "s0038",
    "blockIndex": 7,
    "zh": "王姊醉，不知其將，使騎謝李良。"
  },
  {
    "id": "s0039",
    "blockIndex": 7,
    "zh": "李良素貴，起，慚其從官。"
  },
  {
    "id": "s0040",
    "blockIndex": 7,
    "zh": "從官有一人曰：「天下畔秦，能者先立。"
  },
  {
    "id": "s0041",
    "blockIndex": 7,
    "zh": "且趙王素出將軍下，今女兒乃不為將軍下車，請追殺之！"
  },
  {
    "id": "s0042",
    "blockIndex": 7,
    "zh": "」李良已得秦書，固欲反趙，未決，因此怒，遣人追殺王姊，因將其兵襲邯鄲。"
  },
  {
    "id": "s0043",
    "blockIndex": 7,
    "zh": "邯鄲不知，竟殺趙王、邵騷。"
  },
  {
    "id": "s0044",
    "blockIndex": 7,
    "zh": "趙人多為張耳、陳餘耳目者，以故二人獨得脫。"
  },
  {
    "id": "s0046",
    "blockIndex": 8,
    "zh": "5陳人秦嘉、符離人朱雞石等起兵，圍東海守於郯。"
  },
  {
    "id": "s0047",
    "blockIndex": 8,
    "zh": "陳王聞之，使武平君畔為將軍，監郯下軍。"
  },
  {
    "id": "s0048",
    "blockIndex": 8,
    "zh": "秦嘉不受命，自立為大司馬，惡屬武平君，告軍吏曰：「武平君年少，不知兵事，勿聽！"
  },
  {
    "id": "s0049",
    "blockIndex": 8,
    "zh": "」因矯以王命殺武平君畔。"
  },
  {
    "id": "s0051",
    "blockIndex": 9,
    "zh": "6二世益遣長史司馬欣、董翳佐章邯擊盜。"
  },
  {
    "id": "s0052",
    "blockIndex": 9,
    "zh": "章邯已破伍逢，擊陳柱國房君，殺之。"
  },
  {
    "id": "s0053",
    "blockIndex": 9,
    "zh": "又進擊陳西張賀軍。"
  },
  {
    "id": "s0054",
    "blockIndex": 9,
    "zh": "陳王出監戰。"
  },
  {
    "id": "s0055",
    "blockIndex": 9,
    "zh": "張賀死。"
  },
  {
    "id": "s0057",
    "blockIndex": 10,
    "zh": "7臘月，陳王之汝陰，還，至下城父，其御莊賈殺陳王以降。"
  },
  {
    "id": "s0058",
    "blockIndex": 10,
    "zh": "初，陳涉既為王，其故人皆往依之。"
  },
  {
    "id": "s0059",
    "blockIndex": 10,
    "zh": "妻之父亦往焉，陳王以眾賓待之，長揖不拜。"
  },
  {
    "id": "s0060",
    "blockIndex": 10,
    "zh": "妻之父怒曰：「怙亂僭號，而傲長者，不能久矣！"
  },
  {
    "id": "s0061",
    "blockIndex": 10,
    "zh": "」不辭而去。"
  },
  {
    "id": "s0062",
    "blockIndex": 10,
    "zh": "陳王跪謝，遂不為顧。"
  },
  {
    "id": "s0063",
    "blockIndex": 10,
    "zh": "客出入愈益發舒，言陳王故情。"
  },
  {
    "id": "s0064",
    "blockIndex": 10,
    "zh": "或說陳王曰：「客愚無知，顓妄言，輕威。"
  },
  {
    "id": "s0065",
    "blockIndex": 10,
    "zh": "」陳王斬之。"
  },
  {
    "id": "s0066",
    "blockIndex": 10,
    "zh": "諸故人皆自引去，由是無親陳王者。"
  },
  {
    "id": "s0067",
    "blockIndex": 10,
    "zh": "陳王以朱防為中正，胡武為司過，主司群臣。"
  },
  {
    "id": "s0068",
    "blockIndex": 10,
    "zh": "諸將徇地至，令之不是，輒系而罪之。"
  },
  {
    "id": "s0069",
    "blockIndex": 10,
    "zh": "以苛察為忠，其所不善者，弗下吏，輒自治之。"
  },
  {
    "id": "s0070",
    "blockIndex": 10,
    "zh": "諸將以其故不親附，此其所以敗也。"
  },
  {
    "id": "s0071",
    "blockIndex": 11,
    "zh": "陳王故涓人將軍呂臣為蒼頭軍，起新陽，攻陳，下之，殺莊賈，復以陳為楚。"
  },
  {
    "id": "s0072",
    "blockIndex": 11,
    "zh": "葬陳王於碭，謚曰隱王。"
  },
  {
    "id": "s0073",
    "blockIndex": 12,
    "zh": "初，陳王令銍人宋留將兵定南陽，入武關。"
  },
  {
    "id": "s0074",
    "blockIndex": 12,
    "zh": "留已徇南陽，聞陳王死，南陽復為秦，宋留以軍降，二世車裂留以徇。"
  },
  {
    "id": "s0076",
    "blockIndex": 13,
    "zh": "8魏周市將兵略地豐、沛，使人招雍齒。"
  },
  {
    "id": "s0077",
    "blockIndex": 13,
    "zh": "雍齒雅不欲屬沛公，即以豐降魏。"
  },
  {
    "id": "s0078",
    "blockIndex": 13,
    "zh": "沛公攻之，不克。"
  },
  {
    "id": "s0080",
    "blockIndex": 14,
    "zh": "9趙張耳、陳餘收其散兵，得數萬人，擊李良。"
  },
  {
    "id": "s0081",
    "blockIndex": 14,
    "zh": "良敗，走歸章邯。"
  },
  {
    "id": "s0082",
    "blockIndex": 15,
    "zh": "客有說耳、餘曰：「兩君羈旅，而欲附趙，難可獨立。"
  },
  {
    "id": "s0083",
    "blockIndex": 15,
    "zh": "立趙後，輔以誼，可就功。"
  },
  {
    "id": "s0084",
    "blockIndex": 15,
    "zh": "」乃求得趙歇。"
  },
  {
    "id": "s0085",
    "blockIndex": 15,
    "zh": "春，正月，耳、餘立歇為趙王，居信都。"
  },
  {
    "id": "s0087",
    "blockIndex": 16,
    "zh": "10東陽寧君、秦嘉聞陳王軍敗，乃立景駒為楚王，引兵之方與，欲擊秦軍定陶下；"
  },
  {
    "id": "s0088",
    "blockIndex": 16,
    "zh": "使公孫慶使齊，欲與之並力俱進。"
  },
  {
    "id": "s0089",
    "blockIndex": 16,
    "zh": "齊王曰：「陳王戰敗，不知其死生，楚安得不請而立王！"
  },
  {
    "id": "s0090",
    "blockIndex": 16,
    "zh": "」公孫慶曰：「齊不請楚而立王，楚何故請齊而立王！"
  },
  {
    "id": "s0091",
    "blockIndex": 16,
    "zh": "且楚首事，當令於天下。"
  },
  {
    "id": "s0092",
    "blockIndex": 16,
    "zh": "」田儋殺公孫慶。"
  },
  {
    "id": "s0094",
    "blockIndex": 17,
    "zh": "11秦左、右校復攻陳，下之。"
  },
  {
    "id": "s0095",
    "blockIndex": 17,
    "zh": "呂將軍走，徼兵復聚，與番盜黥布相遇，攻擊秦左、右校，破之青波，復以陳為楚。"
  },
  {
    "id": "s0096",
    "blockIndex": 18,
    "zh": "黥布者，六人也，姓英氏，坐法黥，以刑徒論輸驪山。"
  },
  {
    "id": "s0097",
    "blockIndex": 18,
    "zh": "驪山之徒數十萬人，布皆與其徒長豪傑交通，乃率其曹耦，亡之江中為群盜。"
  },
  {
    "id": "s0098",
    "blockIndex": 18,
    "zh": "番陽令吳芮，甚得江湖間心，號曰番君。"
  },
  {
    "id": "s0099",
    "blockIndex": 18,
    "zh": "布往見之，其眾已數千人。"
  },
  {
    "id": "s0100",
    "blockIndex": 18,
    "zh": "番君乃以女妻之，使將其兵擊秦。"
  },
  {
    "id": "s0102",
    "blockIndex": 19,
    "zh": "12楚王景駒在留，沛公往從之。"
  },
  {
    "id": "s0103",
    "blockIndex": 19,
    "zh": "張良亦聚少年百餘人，欲往從景駒，道遇沛公，遂屬焉。"
  },
  {
    "id": "s0104",
    "blockIndex": 19,
    "zh": "沛公拜良為廄將。"
  },
  {
    "id": "s0105",
    "blockIndex": 19,
    "zh": "良數以太公兵法說沛公，沛公善之，常用其策。"
  },
  {
    "id": "s0106",
    "blockIndex": 19,
    "zh": "良為他人言，皆不省。"
  },
  {
    "id": "s0107",
    "blockIndex": 19,
    "zh": "良曰：「沛公殆天授！"
  },
  {
    "id": "s0108",
    "blockIndex": 19,
    "zh": "」故遂從不去。"
  },
  {
    "id": "s0109",
    "blockIndex": 19,
    "zh": "沛公與良俱見景駒，欲請兵以攻豐。"
  },
  {
    "id": "s0110",
    "blockIndex": 19,
    "zh": "時章邯司馬屍二將兵北定楚地，屠相，至碭。"
  },
  {
    "id": "s0111",
    "blockIndex": 19,
    "zh": "東陽寧君、沛公引兵西，戰蕭西，不利，還，收兵聚留。"
  },
  {
    "id": "s0112",
    "blockIndex": 19,
    "zh": "二月，攻碭，三日，拔之。"
  },
  {
    "id": "s0113",
    "blockIndex": 19,
    "zh": "收碭兵得六千人，與故合九千人。"
  },
  {
    "id": "s0114",
    "blockIndex": 19,
    "zh": "三月，攻下邑，拔之。"
  },
  {
    "id": "s0115",
    "blockIndex": 19,
    "zh": "還擊豐，不下。"
  },
  {
    "id": "s0117",
    "blockIndex": 20,
    "zh": "13廣陵人召平為陳王徇廣陵，未下。"
  },
  {
    "id": "s0118",
    "blockIndex": 20,
    "zh": "聞陳王敗走，章邯且至，乃渡江，矯陳王令，拜項梁為楚上柱國，曰：「江東已定，急引兵西擊秦！"
  },
  {
    "id": "s0119",
    "blockIndex": 20,
    "zh": "」梁乃以八千人渡江而西。"
  },
  {
    "id": "s0120",
    "blockIndex": 20,
    "zh": "聞陳嬰已下東陽，使使欲與連和俱西。"
  },
  {
    "id": "s0121",
    "blockIndex": 20,
    "zh": "陳嬰者，故東陽令史，居縣中，素信謹，稱為長者。"
  },
  {
    "id": "s0122",
    "blockIndex": 20,
    "zh": "東陽少年殺其令，相聚得二萬人，欲立嬰為王。"
  },
  {
    "id": "s0123",
    "blockIndex": 20,
    "zh": "嬰母謂嬰曰：「自我為汝家婦，未嘗聞汝先世之有貴者。"
  },
  {
    "id": "s0124",
    "blockIndex": 20,
    "zh": "今暴得大名，不祥；"
  },
  {
    "id": "s0125",
    "blockIndex": 20,
    "zh": "不如有所屬。"
  },
  {
    "id": "s0126",
    "blockIndex": 20,
    "zh": "事成，猶得封侯；"
  },
  {
    "id": "s0127",
    "blockIndex": 20,
    "zh": "事敗，易以亡，非世所指名也。"
  },
  {
    "id": "s0128",
    "blockIndex": 20,
    "zh": "」嬰乃不敢為王，謂其軍吏曰：「項氏世世將家，有名於楚，今欲舉大事，將非其人不可。"
  },
  {
    "id": "s0129",
    "blockIndex": 20,
    "zh": "我倚名族，亡秦必矣！"
  },
  {
    "id": "s0130",
    "blockIndex": 20,
    "zh": "」其眾從之，乃以兵屬梁。"
  },
  {
    "id": "s0132",
    "blockIndex": 21,
    "zh": "14英布既破秦軍，引兵而東；"
  },
  {
    "id": "s0133",
    "blockIndex": 21,
    "zh": "聞項梁西渡淮，布與蒲將軍皆以其兵屬焉。"
  },
  {
    "id": "s0134",
    "blockIndex": 21,
    "zh": "項梁眾凡六七萬人，軍下邳。"
  },
  {
    "id": "s0135",
    "blockIndex": 21,
    "zh": "景駒、秦嘉軍彭城東，欲以距梁。"
  },
  {
    "id": "s0136",
    "blockIndex": 21,
    "zh": "梁謂軍吏曰：「陳王先首事，戰不利，未聞所在。"
  },
  {
    "id": "s0137",
    "blockIndex": 21,
    "zh": "今秦嘉倍陳王而立景駒，逆無道！"
  },
  {
    "id": "s0138",
    "blockIndex": 21,
    "zh": "」乃進兵擊秦嘉，秦嘉軍敗走。"
  },
  {
    "id": "s0139",
    "blockIndex": 21,
    "zh": "追之，至胡陵，嘉還戰。"
  },
  {
    "id": "s0140",
    "blockIndex": 21,
    "zh": "一日，嘉死，軍降；"
  },
  {
    "id": "s0141",
    "blockIndex": 21,
    "zh": "景駒走死梁地。"
  },
  {
    "id": "s0142",
    "blockIndex": 22,
    "zh": "梁已並秦嘉軍，軍胡陵，將引軍而西。"
  },
  {
    "id": "s0143",
    "blockIndex": 22,
    "zh": "章邯軍至栗，項梁使別將朱雞石、餘樊君與戰。"
  },
  {
    "id": "s0144",
    "blockIndex": 22,
    "zh": "餘樊君死，朱雞石軍敗，亡走胡陵。"
  },
  {
    "id": "s0145",
    "blockIndex": 22,
    "zh": "梁乃引兵入薛，誅朱雞石。"
  },
  {
    "id": "s0146",
    "blockIndex": 23,
    "zh": "沛公從騎百餘往見梁，梁與沛公卒五千人，五大夫將十人。"
  },
  {
    "id": "s0147",
    "blockIndex": 23,
    "zh": "沛公還，引兵攻豐，拔之。"
  },
  {
    "id": "s0148",
    "blockIndex": 23,
    "zh": "雍齒奔魏。"
  },
  {
    "id": "s0149",
    "blockIndex": 24,
    "zh": "項梁使項羽別攻襄城，襄城堅守不下；"
  },
  {
    "id": "s0150",
    "blockIndex": 24,
    "zh": "已拔，皆坑之，還報。"
  },
  {
    "id": "s0151",
    "blockIndex": 25,
    "zh": "梁聞陳王定死，召諸別將會薛計事，沛公亦往焉。"
  },
  {
    "id": "s0152",
    "blockIndex": 25,
    "zh": "居鄛人范增，年七十，素居家，好奇計，往說項梁曰：「陳勝敗，固當。"
  },
  {
    "id": "s0153",
    "blockIndex": 25,
    "zh": "夫秦滅六國，楚最無罪。"
  },
  {
    "id": "s0154",
    "blockIndex": 25,
    "zh": "自懷王入秦不反，楚人憐之至今。"
  },
  {
    "id": "s0155",
    "blockIndex": 25,
    "zh": "故楚南公曰：『楚雖三戶，亡秦必楚。"
  },
  {
    "id": "s0156",
    "blockIndex": 25,
    "zh": "』今陳勝首事，不立楚後而自立，其勢不長。"
  },
  {
    "id": "s0157",
    "blockIndex": 25,
    "zh": "今君起江東，楚蜂起之將皆爭附君者，以君世世楚將，為能復立楚之後也。"
  },
  {
    "id": "s0158",
    "blockIndex": 25,
    "zh": "」於是項梁然其言，乃求得楚懷王孫心於民間，為人牧羊。"
  },
  {
    "id": "s0159",
    "blockIndex": 25,
    "zh": "夏，六月，立以為楚懷王，從民望也。"
  },
  {
    "id": "s0160",
    "blockIndex": 25,
    "zh": "陳嬰為上柱國，封五縣，與懷王都盱眙。"
  },
  {
    "id": "s0161",
    "blockIndex": 25,
    "zh": "項梁自號為武信君。"
  },
  {
    "id": "s0162",
    "blockIndex": 26,
    "zh": "張良說項梁曰：「君已立楚後，而韓諸公子橫陽君成最賢，可立為王，益樹黨。"
  },
  {
    "id": "s0163",
    "blockIndex": 26,
    "zh": "」項梁使良求韓成，立以為韓王，以良為司徒，與韓王將千餘人西略韓地，得數城，秦輒復取之；"
  },
  {
    "id": "s0164",
    "blockIndex": 26,
    "zh": "往來為遊兵穎川。"
  },
  {
    "id": "s0166",
    "blockIndex": 27,
    "zh": "15章邯已破陳王，乃進兵擊魏王於臨濟。"
  },
  {
    "id": "s0167",
    "blockIndex": 27,
    "zh": "魏王使周市出，請救於齊、楚。"
  },
  {
    "id": "s0168",
    "blockIndex": 27,
    "zh": "齊王儋及楚將項它皆將兵隨市救魏。"
  },
  {
    "id": "s0169",
    "blockIndex": 27,
    "zh": "章邯夜銜枚擊，大破齊、楚軍於臨濟下，殺齊王及周市。"
  },
  {
    "id": "s0170",
    "blockIndex": 27,
    "zh": "魏王咎為其民約降，約定，自燒殺。"
  },
  {
    "id": "s0171",
    "blockIndex": 27,
    "zh": "其弟豹亡走楚，楚懷王予魏豹數千人，復徇魏地。"
  },
  {
    "id": "s0172",
    "blockIndex": 27,
    "zh": "齊田榮收其兄儋餘兵，東走東阿，章邯追圍之。"
  },
  {
    "id": "s0173",
    "blockIndex": 27,
    "zh": "齊人聞齊王儋死，乃立故齊王建之弟假為王，田角為相，角弟間為將，以距諸侯。"
  },
  {
    "id": "s0174",
    "blockIndex": 28,
    "zh": "秋，七月，大霖雨。"
  },
  {
    "id": "s0175",
    "blockIndex": 28,
    "zh": "武信君引兵攻亢父，聞田榮之急，乃引兵擊破章邯軍東阿下，章邯走而西。"
  },
  {
    "id": "s0176",
    "blockIndex": 28,
    "zh": "田榮引兵東歸齊。"
  },
  {
    "id": "s0177",
    "blockIndex": 28,
    "zh": "武信君獨追北，使項羽、沛公別攻城陽，屠之。"
  },
  {
    "id": "s0178",
    "blockIndex": 28,
    "zh": "楚軍軍濮陽東，復與章邯戰，又破之。"
  },
  {
    "id": "s0179",
    "blockIndex": 28,
    "zh": "章邯復振，守濮陽，環水。"
  },
  {
    "id": "s0180",
    "blockIndex": 28,
    "zh": "沛公、項羽去，攻定陶。"
  },
  {
    "id": "s0181",
    "blockIndex": 29,
    "zh": "八月，田榮擊逐齊王假，假亡走楚，田角亡走趙。"
  },
  {
    "id": "s0182",
    "blockIndex": 29,
    "zh": "田間前救趙，因留不敢歸。"
  },
  {
    "id": "s0183",
    "blockIndex": 29,
    "zh": "田榮乃立儋子市為齊王，榮相之，田橫為將，平齊地。"
  },
  {
    "id": "s0184",
    "blockIndex": 29,
    "zh": "章邯兵益盛，項梁數使使告齊、趙發兵共擊章邯。"
  },
  {
    "id": "s0185",
    "blockIndex": 29,
    "zh": "田榮曰：「楚殺田假，趙殺角、間，乃出兵。"
  },
  {
    "id": "s0186",
    "blockIndex": 29,
    "zh": "」楚、趙不許。"
  },
  {
    "id": "s0187",
    "blockIndex": 29,
    "zh": "田榮怒，終不肯出兵。"
  },
  {
    "id": "s0189",
    "blockIndex": 30,
    "zh": "16郎中令趙高恃恩專恣，以私怨誅殺人眾多，恐大臣入朝奏事言之，乃說二世曰：「天子之所以貴者，但以聞聲，群臣莫得見其面故也。"
  },
  {
    "id": "s0190",
    "blockIndex": 30,
    "zh": "且陛下富於春秋，未必盡通諸事。"
  },
  {
    "id": "s0191",
    "blockIndex": 30,
    "zh": "今坐朝廷，譴舉有不當者，則見短於大臣，非所以示神明於天下也。"
  },
  {
    "id": "s0192",
    "blockIndex": 30,
    "zh": "陛下不如深拱禁中，與臣及侍中習法者待事，事來有以揆之。"
  },
  {
    "id": "s0193",
    "blockIndex": 30,
    "zh": "如此，則大臣不敢奏疑事，天下稱聖主矣。"
  },
  {
    "id": "s0194",
    "blockIndex": 30,
    "zh": "」二世用其計，乃不坐朝廷見大臣，常居禁中。"
  },
  {
    "id": "s0195",
    "blockIndex": 30,
    "zh": "趙高侍中用事，事皆決於趙高。"
  },
  {
    "id": "s0196",
    "blockIndex": 31,
    "zh": "高聞李斯以為言，乃見丞相曰：「關東群盜多，今上急，益發繇，治阿房宮，聚狗馬無用之物。"
  },
  {
    "id": "s0197",
    "blockIndex": 31,
    "zh": "臣欲諫，為位賤，此真君侯之事。"
  },
  {
    "id": "s0198",
    "blockIndex": 31,
    "zh": "君何不諫？"
  },
  {
    "id": "s0199",
    "blockIndex": 31,
    "zh": "」李斯曰：「固也，吾欲言之久矣。"
  },
  {
    "id": "s0200",
    "blockIndex": 31,
    "zh": "今時上不坐朝廷，常居深宮。"
  },
  {
    "id": "s0201",
    "blockIndex": 31,
    "zh": "吾所言者，不可傳也。"
  },
  {
    "id": "s0202",
    "blockIndex": 31,
    "zh": "欲見，無閒。"
  },
  {
    "id": "s0203",
    "blockIndex": 31,
    "zh": "」趙高曰：「君誠能諫，請為君侯上閒，語君。"
  },
  {
    "id": "s0204",
    "blockIndex": 31,
    "zh": "」於是趙高待二世方燕樂，婦女居前，使人告丞相：「上方閒，可奏事。"
  },
  {
    "id": "s0205",
    "blockIndex": 31,
    "zh": "」丞相至宮門上謁。"
  },
  {
    "id": "s0206",
    "blockIndex": 31,
    "zh": "如此者三。"
  },
  {
    "id": "s0207",
    "blockIndex": 31,
    "zh": "二世怒曰：「吾常多閒日，丞相不來；"
  },
  {
    "id": "s0208",
    "blockIndex": 31,
    "zh": "吾方燕私，丞相輒來請事！"
  },
  {
    "id": "s0209",
    "blockIndex": 31,
    "zh": "丞相豈少我哉，且固我哉？"
  },
  {
    "id": "s0210",
    "blockIndex": 31,
    "zh": "」趙高因曰：「夫沙丘之謀，丞相與焉。"
  },
  {
    "id": "s0211",
    "blockIndex": 31,
    "zh": "今陛下已立為帝，而丞貴不益，此其意亦望裂地而王矣。"
  },
  {
    "id": "s0212",
    "blockIndex": 31,
    "zh": "且陛下不問臣，臣不敢言。"
  },
  {
    "id": "s0213",
    "blockIndex": 31,
    "zh": "丞相長男李由為三川守，楚盜陳勝等皆丞相傍縣之子，以故楚盜公行，過三川城，守不肯擊。"
  },
  {
    "id": "s0214",
    "blockIndex": 31,
    "zh": "高聞其文書相往來，未得其審，故未敢以聞。"
  },
  {
    "id": "s0215",
    "blockIndex": 31,
    "zh": "且丞相居外，權重於陛下。"
  },
  {
    "id": "s0216",
    "blockIndex": 31,
    "zh": "」二世以為然，欲案丞相，恐其不審，乃先使人按驗三川守與盜通狀。"
  },
  {
    "id": "s0217",
    "blockIndex": 32,
    "zh": "李斯聞之，因上書言趙高之短曰：「高擅利擅害，與陛下無異。"
  },
  {
    "id": "s0218",
    "blockIndex": 32,
    "zh": "昔田常相齊簡公，竊其恩威，下得百姓，上得群臣，卒弒齊簡公而取齊國，此天下所明知也。"
  },
  {
    "id": "s0219",
    "blockIndex": 32,
    "zh": "今高有邪佚之志，危反之行，私家之富，若田氏之於齊矣，而又貪慾無厭，求利不止，列勢次主，其欲無窮，劫陛下之威信，其志若韓□為韓安相也。"
  },
  {
    "id": "s0220",
    "blockIndex": 32,
    "zh": "陛下不圖，臣恐其必為變也。"
  },
  {
    "id": "s0221",
    "blockIndex": 32,
    "zh": "」二世曰：「何哉！"
  },
  {
    "id": "s0222",
    "blockIndex": 32,
    "zh": "夫高，故宦人也，然不為安肆志，不以危易心，潔行修善，自使至此，以忠得進，以信守位，朕實賢之。"
  },
  {
    "id": "s0223",
    "blockIndex": 32,
    "zh": "而君疑之，何也？"
  },
  {
    "id": "s0224",
    "blockIndex": 32,
    "zh": "且朕非屬趙君，當誰任哉！"
  },
  {
    "id": "s0225",
    "blockIndex": 32,
    "zh": "且趙君為人，精廉強力，下知人情，上能適朕，君其勿疑！"
  },
  {
    "id": "s0226",
    "blockIndex": 32,
    "zh": "」二世雅愛信高，恐李斯殺之，乃私告趙高。"
  },
  {
    "id": "s0227",
    "blockIndex": 32,
    "zh": "高曰：「丞相所患者獨高，高已死，丞相即欲為田常所為。"
  },
  {
    "id": "s0229",
    "blockIndex": 33,
    "zh": "是時，盜賊益多，而關中捽髮東擊盜者無已。"
  },
  {
    "id": "s0230",
    "blockIndex": 33,
    "zh": "右丞相馮去疾、左丞相李斯、將軍馮劫進諫曰：「關東群盜並起，秦發兵追擊，所殺亡甚眾，然猶不止。"
  },
  {
    "id": "s0231",
    "blockIndex": 33,
    "zh": "盜多，皆以戍、漕、轉、作事苦，稅賦大也。"
  },
  {
    "id": "s0232",
    "blockIndex": 33,
    "zh": "請且止阿房宮作者，減省四邊戍、轉。"
  },
  {
    "id": "s0233",
    "blockIndex": 33,
    "zh": "」二世曰：「凡所為貴有天下者，得肆意極欲，主重明法，下不敢為非，以制御海內矣。"
  },
  {
    "id": "s0234",
    "blockIndex": 33,
    "zh": "夫虞、夏之主，貴為天子，親處窮苦之實以徇百姓，尚何於法！"
  },
  {
    "id": "s0235",
    "blockIndex": 33,
    "zh": "且先帝起諸侯，兼天下，天下已定，外攘四夷以安邊境，作宮室以章得意，而君觀先帝功業有緒。"
  },
  {
    "id": "s0236",
    "blockIndex": 33,
    "zh": "今朕即位，二年之間，群盜並起，君不能禁，又欲罷先帝之所為，是上無以報先帝，次不為朕盡忠力，何以在位！"
  },
  {
    "id": "s0237",
    "blockIndex": 33,
    "zh": "」下去疾、斯、劫吏，案責他罪。"
  },
  {
    "id": "s0238",
    "blockIndex": 33,
    "zh": "去疾、劫自殺，獨李斯就獄。"
  },
  {
    "id": "s0239",
    "blockIndex": 33,
    "zh": "二世以屬趙高治之，責斯與子由謀反狀，皆收捕宗族、賓客。"
  },
  {
    "id": "s0240",
    "blockIndex": 33,
    "zh": "趙高治斯，榜掠千餘，不勝痛，自誣服。"
  },
  {
    "id": "s0241",
    "blockIndex": 34,
    "zh": "斯所以不死者，自負其辯，有功，實無反心，欲上書自陳，幸二世寤而赦之。"
  },
  {
    "id": "s0242",
    "blockIndex": 34,
    "zh": "乃從獄中上書曰：「臣為丞相治民，三十餘年矣。"
  },
  {
    "id": "s0243",
    "blockIndex": 34,
    "zh": "逮秦地之狹隘，不過千里，兵數十萬。"
  },
  {
    "id": "s0244",
    "blockIndex": 34,
    "zh": "臣盡薄材，陰行謀臣，資之金玉，使遊說諸侯；"
  },
  {
    "id": "s0245",
    "blockIndex": 34,
    "zh": "陰修甲兵，飭政教，官鬥士，尊功臣；"
  },
  {
    "id": "s0246",
    "blockIndex": 34,
    "zh": "故終以脅韓，弱魏，破燕、趙，夷齊、楚，卒兼六國，虜其王，立秦為天子。"
  },
  {
    "id": "s0247",
    "blockIndex": 34,
    "zh": "又北逐胡、貉，南定北越，以見秦之強。"
  },
  {
    "id": "s0248",
    "blockIndex": 34,
    "zh": "更克畫，平斗斛、度量，文章布之天下，以樹秦之名。"
  },
  {
    "id": "s0249",
    "blockIndex": 34,
    "zh": "此皆臣之罪也，臣當死久矣！"
  },
  {
    "id": "s0250",
    "blockIndex": 34,
    "zh": "上幸盡其能力，乃得至今。"
  },
  {
    "id": "s0251",
    "blockIndex": 34,
    "zh": "願陛下察之！"
  },
  {
    "id": "s0252",
    "blockIndex": 34,
    "zh": "」書上，趙高使吏棄去不奏，曰：「囚安得上書！"
  },
  {
    "id": "s0254",
    "blockIndex": 35,
    "zh": "趙高使其客十餘輩詐為御史、謁者、侍中，更往覆訊斯，斯更以其實對，輒使人復榜之。"
  },
  {
    "id": "s0255",
    "blockIndex": 35,
    "zh": "後二世使人驗斯，斯以為如前，終不更言。"
  },
  {
    "id": "s0256",
    "blockIndex": 35,
    "zh": "辭服，奏當上。"
  },
  {
    "id": "s0257",
    "blockIndex": 35,
    "zh": "二世喜曰：「微趙君，幾為丞相所賣！"
  },
  {
    "id": "s0258",
    "blockIndex": 35,
    "zh": "」及二世所使案三川守由者至，則楚兵已擊殺之。"
  },
  {
    "id": "s0259",
    "blockIndex": 35,
    "zh": "使者來，會職責相下吏，高皆妄為反辭以相傅會，遂具斯五刑，論腰斬咸陽市。"
  },
  {
    "id": "s0260",
    "blockIndex": 35,
    "zh": "斯出獄，與其中子俱執。"
  },
  {
    "id": "s0261",
    "blockIndex": 35,
    "zh": "顧謂其中子曰：「吾欲與若復牽黃犬，俱出上蔡東門逐狡兔，豈可得乎！"
  },
  {
    "id": "s0262",
    "blockIndex": 35,
    "zh": "」遂父子相哭，而夷三族。"
  },
  {
    "id": "s0263",
    "blockIndex": 35,
    "zh": "二世乃以趙高為丞相，事無大小皆決焉。"
  },
  {
    "id": "s0265",
    "blockIndex": 36,
    "zh": "17項梁已破章邯於東阿，引兵西，北至定陶，再破秦軍。"
  },
  {
    "id": "s0266",
    "blockIndex": 36,
    "zh": "項羽、沛公又與秦軍戰於雍丘，大破之，斬李由。"
  },
  {
    "id": "s0267",
    "blockIndex": 36,
    "zh": "項梁益輕秦，有驕色。"
  },
  {
    "id": "s0268",
    "blockIndex": 36,
    "zh": "宋義諫曰：「戰勝而將驕卒惰者，敗。"
  },
  {
    "id": "s0269",
    "blockIndex": 36,
    "zh": "今卒少惰矣，秦兵日益，臣為君畏之。"
  },
  {
    "id": "s0270",
    "blockIndex": 36,
    "zh": "」項梁弗聽。"
  },
  {
    "id": "s0271",
    "blockIndex": 36,
    "zh": "餘乃使宋義使於齊，道遇齊使者高陵君顯，曰：「公將見武信君乎？"
  },
  {
    "id": "s0272",
    "blockIndex": 36,
    "zh": "」曰：「然。"
  },
  {
    "id": "s0273",
    "blockIndex": 36,
    "zh": "」曰：「臣論武信君軍必敗。"
  },
  {
    "id": "s0274",
    "blockIndex": 36,
    "zh": "公徐行即免死，疾行則及禍。"
  },
  {
    "id": "s0275",
    "blockIndex": 36,
    "zh": "」二世悉起兵益章邯擊楚軍，大破之定陶，項梁死。"
  },
  {
    "id": "s0276",
    "blockIndex": 37,
    "zh": "時連雨，自七月至九月。"
  },
  {
    "id": "s0277",
    "blockIndex": 37,
    "zh": "項羽、沛公攻外黃未下，去，攻陳留。"
  },
  {
    "id": "s0278",
    "blockIndex": 37,
    "zh": "聞武信君死，士卒恐，乃與將軍呂臣引兵而東，徙懷王自盱眙都彭城。"
  },
  {
    "id": "s0279",
    "blockIndex": 37,
    "zh": "呂臣軍彭城東，項羽軍彭城西，沛公軍碭。"
  },
  {
    "id": "s0280",
    "blockIndex": 38,
    "zh": "魏豹下魏二十餘城，楚懷王立豹為魏王。"
  },
  {
    "id": "s0281",
    "blockIndex": 39,
    "zh": "後九月，楚懷王並呂臣、項羽軍，自將之；"
  },
  {
    "id": "s0282",
    "blockIndex": 39,
    "zh": "以沛公為碭郡長，封武安侯，將碭郡兵；"
  },
  {
    "id": "s0283",
    "blockIndex": 39,
    "zh": "封項羽為長安侯，號為魯公；"
  },
  {
    "id": "s0284",
    "blockIndex": 39,
    "zh": "呂臣為司徒，其父呂青為令尹。"
  },
  {
    "id": "s0286",
    "blockIndex": 40,
    "zh": "18章邯已破項梁，以為楚地兵不足憂，乃渡河，北擊趙，大破之。"
  },
  {
    "id": "s0287",
    "blockIndex": 40,
    "zh": "引兵至邯鄲，皆徙其民河內，夷其城郭。"
  },
  {
    "id": "s0288",
    "blockIndex": 40,
    "zh": "張耳與趙王歇走入巨鹿城，王離圍之。"
  },
  {
    "id": "s0289",
    "blockIndex": 40,
    "zh": "陳餘北收常山兵，得數萬人，軍巨鹿北。"
  },
  {
    "id": "s0290",
    "blockIndex": 40,
    "zh": "章邯軍巨鹿南棘原。"
  },
  {
    "id": "s0291",
    "blockIndex": 40,
    "zh": "趙數請救於楚。"
  },
  {
    "id": "s0292",
    "blockIndex": 41,
    "zh": "高陵君顯在楚，見楚王曰：「宋義論武信君之軍必敗，居數日，軍果敗。"
  },
  {
    "id": "s0293",
    "blockIndex": 41,
    "zh": "兵未戰而先見敗征，此可謂知兵矣。"
  },
  {
    "id": "s0294",
    "blockIndex": 41,
    "zh": "」王召宋義與計事而大說之，因置以為上將軍。"
  },
  {
    "id": "s0295",
    "blockIndex": 41,
    "zh": "項羽為次將，范增為末將，以救趙。"
  },
  {
    "id": "s0296",
    "blockIndex": 41,
    "zh": "諸別將皆屬宋義，號為「卿子冠軍」。"
  },
  {
    "id": "s0297",
    "blockIndex": 42,
    "zh": "初，楚懷王與諸將約：「先入定關中者王之。"
  },
  {
    "id": "s0298",
    "blockIndex": 42,
    "zh": "」當是時，秦兵強，常乘勝逐北，諸將莫利先入關。"
  },
  {
    "id": "s0299",
    "blockIndex": 42,
    "zh": "獨項羽怨秦之殺項梁，奮勢願與沛公西入關。"
  },
  {
    "id": "s0300",
    "blockIndex": 42,
    "zh": "懷王諸老將皆曰：「項羽為人，慓悍猾賊，嘗攻襄城，襄城無遺類，皆坑之，諸所過無不殘滅。"
  },
  {
    "id": "s0301",
    "blockIndex": 42,
    "zh": "且楚數進取，前陳王、項梁皆敗，不如更遣長者，扶義而西，告諭秦父兄。"
  },
  {
    "id": "s0302",
    "blockIndex": 42,
    "zh": "秦父兄苦其主久矣，今誠得長者往，無侵暴，宜可下。"
  },
  {
    "id": "s0303",
    "blockIndex": 42,
    "zh": "項羽不可遣，獨沛公素寬大長者，可遣。"
  },
  {
    "id": "s0304",
    "blockIndex": 42,
    "zh": "」懷王乃不許項羽，而遣沛公西略地，收陳王、項梁散卒以伐秦。"
  },
  {
    "id": "s0305",
    "blockIndex": 43,
    "zh": "沛公道碭，至陽城與槓里，攻秦壁，破其二軍。"
  },
  {
    "id": "s0306",
    "blockIndex": 44,
    "zh": "1冬，十月，齊將田都畔田榮，助楚救趙。"
  },
  {
    "id": "s0308",
    "blockIndex": 45,
    "zh": "2沛公攻破東郡尉於成武。"
  },
  {
    "id": "s0310",
    "blockIndex": 46,
    "zh": "3宋義行至安陽，留四十六日不進。"
  },
  {
    "id": "s0311",
    "blockIndex": 46,
    "zh": "項羽曰：「秦圍趙急，宜疾引兵渡河；"
  },
  {
    "id": "s0312",
    "blockIndex": 46,
    "zh": "楚擊其外，趙應其內，破秦軍必矣。"
  },
  {
    "id": "s0313",
    "blockIndex": 46,
    "zh": "」宋義曰：「不然。"
  },
  {
    "id": "s0314",
    "blockIndex": 46,
    "zh": "夫搏牛之虻，不可以破蟣虱。"
  },
  {
    "id": "s0315",
    "blockIndex": 46,
    "zh": "今秦攻趙，戰勝則兵疲，我承其敝；"
  },
  {
    "id": "s0316",
    "blockIndex": 46,
    "zh": "不勝，則我引兵鼓行而西，必舉秦矣。"
  },
  {
    "id": "s0317",
    "blockIndex": 46,
    "zh": "故不如先斗秦、趙。"
  },
  {
    "id": "s0318",
    "blockIndex": 46,
    "zh": "夫被堅執銳，義不如公；"
  },
  {
    "id": "s0319",
    "blockIndex": 46,
    "zh": "坐運籌策，公不如義。"
  },
  {
    "id": "s0320",
    "blockIndex": 46,
    "zh": "」因下令軍中曰：「有猛如虎，狠如羊，貪如狼，強不可使者，皆斬之！"
  },
  {
    "id": "s0321",
    "blockIndex": 46,
    "zh": "」乃遣其子宋襄相齊，身送之至無鹽，飲酒高會。"
  },
  {
    "id": "s0322",
    "blockIndex": 46,
    "zh": "天寒，大雨，士卒凍饑。"
  },
  {
    "id": "s0323",
    "blockIndex": 46,
    "zh": "項羽曰：「將戮力而攻秦，久留不行。"
  },
  {
    "id": "s0324",
    "blockIndex": 46,
    "zh": "今歲饑民貧，士卒食半菽，軍無見糧，乃飲酒高會；"
  },
  {
    "id": "s0325",
    "blockIndex": 46,
    "zh": "不引兵渡河，因趙食，與趙並力攻秦，乃曰『承其敝』。"
  },
  {
    "id": "s0326",
    "blockIndex": 46,
    "zh": "夫以秦之強，攻新造之趙，其勢必舉。"
  },
  {
    "id": "s0327",
    "blockIndex": 46,
    "zh": "趙舉秦強，何敝之承！"
  },
  {
    "id": "s0328",
    "blockIndex": 46,
    "zh": "且國兵新破，王坐不安席，掃境內而專屬於將軍，國家安危，在此一舉。"
  },
  {
    "id": "s0329",
    "blockIndex": 46,
    "zh": "今不恤士卒而徇其私，非社稷之臣也！"
  },
  {
    "id": "s0331",
    "blockIndex": 47,
    "zh": "十一月，項羽晨朝將軍宋義，即其帳中斬宋義頭。"
  },
  {
    "id": "s0332",
    "blockIndex": 47,
    "zh": "出令軍中曰：「宋義與齊謀反楚，楚王陰令籍誅之！"
  },
  {
    "id": "s0333",
    "blockIndex": 47,
    "zh": "」當是時，諸將皆懾服，莫敢枝梧，皆曰：「首立楚者，將軍家也，今將軍誅亂。"
  },
  {
    "id": "s0334",
    "blockIndex": 47,
    "zh": "」乃相與共立羽為假上將軍。"
  },
  {
    "id": "s0335",
    "blockIndex": 47,
    "zh": "使人追宋義子，及之齊，殺之。"
  },
  {
    "id": "s0336",
    "blockIndex": 47,
    "zh": "使桓楚報命於懷王。"
  },
  {
    "id": "s0337",
    "blockIndex": 47,
    "zh": "懷王因使羽為上將軍。"
  },
  {
    "id": "s0339",
    "blockIndex": 48,
    "zh": "4十二月，沛公引兵至栗，遇剛武侯，奪其軍四千餘人，並之；"
  },
  {
    "id": "s0340",
    "blockIndex": 48,
    "zh": "與魏將皇欣、武滿軍合攻秦軍，破之。"
  },
  {
    "id": "s0342",
    "blockIndex": 49,
    "zh": "5故齊王建孫安下濟北，從項羽救趙。"
  },
  {
    "id": "s0343",
    "blockIndex": 50,
    "zh": "章邯築甬道屬河，餉王離。"
  },
  {
    "id": "s0344",
    "blockIndex": 50,
    "zh": "王離兵食多，急攻巨鹿。"
  },
  {
    "id": "s0345",
    "blockIndex": 50,
    "zh": "巨鹿城中食盡、兵少，張耳數使人召前陳餘。"
  },
  {
    "id": "s0346",
    "blockIndex": 50,
    "zh": "陳餘度兵少，不敵秦，不敢前。"
  },
  {
    "id": "s0347",
    "blockIndex": 50,
    "zh": "數月，張耳大怒，怨陳餘，使張黶、陳澤往讓陳餘曰：「始吾與公為刎頸交，今王與耳旦暮且死，而公擁兵數萬，不肯相救，安在其相為死！"
  },
  {
    "id": "s0348",
    "blockIndex": 50,
    "zh": "苟必信，胡不赴秦軍俱死，且有十一二相全。"
  },
  {
    "id": "s0349",
    "blockIndex": 50,
    "zh": "」陳餘曰：「吾度前終不能救趙，徒盡亡軍。"
  },
  {
    "id": "s0350",
    "blockIndex": 50,
    "zh": "且餘所以不俱死，欲為趙王、張君報秦。"
  },
  {
    "id": "s0351",
    "blockIndex": 50,
    "zh": "今必俱死，如以肉委餓虎，何益！"
  },
  {
    "id": "s0352",
    "blockIndex": 50,
    "zh": "」張黶、陳澤要以俱死，乃使黶、澤將五千人先嘗秦軍，至，皆沒。"
  },
  {
    "id": "s0353",
    "blockIndex": 50,
    "zh": "當是時，齊師、燕師皆來救趙，張敖亦北收代兵，得萬餘人，來，皆壁餘旁，未敢擊秦。"
  },
  {
    "id": "s0354",
    "blockIndex": 51,
    "zh": "項羽已殺卿子冠軍，威震楚國，乃遣當陽君、薄將軍將卒二萬渡河救巨鹿。"
  },
  {
    "id": "s0355",
    "blockIndex": 51,
    "zh": "戰少利，絕章邯甬道，王離軍乏食。"
  },
  {
    "id": "s0356",
    "blockIndex": 51,
    "zh": "陳餘復請兵。"
  },
  {
    "id": "s0357",
    "blockIndex": 51,
    "zh": "項羽乃悉引兵渡河，皆沈船，破釜、甑，燒廬舍，持三日糧，以示士卒必死，無一還心。"
  },
  {
    "id": "s0358",
    "blockIndex": 51,
    "zh": "於是至則圍王離，與秦軍遇，九戰，大破之，章邯引兵卻。"
  },
  {
    "id": "s0359",
    "blockIndex": 51,
    "zh": "諸侯兵乃敢進擊秦軍，遂殺蘇角，虜王離；"
  },
  {
    "id": "s0360",
    "blockIndex": 51,
    "zh": "涉間不降，自燒殺。"
  },
  {
    "id": "s0361",
    "blockIndex": 51,
    "zh": "當是時，楚兵冠諸侯軍。"
  },
  {
    "id": "s0362",
    "blockIndex": 51,
    "zh": "救巨鹿者十餘壁，莫敢縱兵。"
  },
  {
    "id": "s0363",
    "blockIndex": 51,
    "zh": "及楚擊秦，諸侯將皆從壁上觀。"
  },
  {
    "id": "s0364",
    "blockIndex": 51,
    "zh": "楚戰士無不一當十，呼聲動天地，諸侯軍無不人人惴恐。"
  },
  {
    "id": "s0365",
    "blockIndex": 51,
    "zh": "於是已破秦軍，項羽召見諸侯將。"
  },
  {
    "id": "s0366",
    "blockIndex": 51,
    "zh": "諸侯將入轅門，無不膝行而前，莫敢仰視。"
  },
  {
    "id": "s0367",
    "blockIndex": 51,
    "zh": "項羽由是始為諸侯上將軍。"
  },
  {
    "id": "s0368",
    "blockIndex": 51,
    "zh": "諸侯皆屬焉。"
  },
  {
    "id": "s0369",
    "blockIndex": 52,
    "zh": "於是趙王歇及張耳乃得出巨鹿城謝諸侯。"
  },
  {
    "id": "s0370",
    "blockIndex": 52,
    "zh": "張耳與陳餘相見，責讓陳餘以不肯救趙；"
  },
  {
    "id": "s0371",
    "blockIndex": 52,
    "zh": "及問張黶、陳澤所在，疑陳餘殺之，數以問餘。"
  },
  {
    "id": "s0372",
    "blockIndex": 52,
    "zh": "餘怒曰：「不意君之望臣深也！"
  },
  {
    "id": "s0373",
    "blockIndex": 52,
    "zh": "豈以臣為重去將印哉？"
  },
  {
    "id": "s0374",
    "blockIndex": 52,
    "zh": "」乃脫解印綬，推予張耳，張耳亦愕不受。"
  },
  {
    "id": "s0375",
    "blockIndex": 52,
    "zh": "陳餘起如廁。"
  },
  {
    "id": "s0376",
    "blockIndex": 52,
    "zh": "客有說張耳曰：「臣聞『天與不取，反受其咎。"
  },
  {
    "id": "s0377",
    "blockIndex": 52,
    "zh": "』今陳將軍與君印，君不受，反天不祥，急取之！"
  },
  {
    "id": "s0378",
    "blockIndex": 52,
    "zh": "」張耳乃佩其印，收其麾下。"
  },
  {
    "id": "s0379",
    "blockIndex": 52,
    "zh": "而陳餘還，亦望張耳不讓，遂趨出，獨與麾下所善數百人之河上澤中漁獵。"
  },
  {
    "id": "s0380",
    "blockIndex": 52,
    "zh": "趙王歇還信都。"
  },
  {
    "id": "s0382",
    "blockIndex": 53,
    "zh": "6春，二月，沛公北擊昌邑，遇彭越，彭越以其兵從沛公。"
  },
  {
    "id": "s0383",
    "blockIndex": 53,
    "zh": "越，昌邑人，常漁巨野澤中，為群盜。"
  },
  {
    "id": "s0384",
    "blockIndex": 53,
    "zh": "陳勝、項梁之起，澤間少年相聚百餘人，往從彭越曰：「請仲為長。"
  },
  {
    "id": "s0385",
    "blockIndex": 53,
    "zh": "」越謝曰：「臣不願也。"
  },
  {
    "id": "s0386",
    "blockIndex": 53,
    "zh": "」少年強請，乃許，與期旦日日出會，後期者斬。"
  },
  {
    "id": "s0387",
    "blockIndex": 53,
    "zh": "旦日日出，十餘人後，後者至日中。"
  },
  {
    "id": "s0388",
    "blockIndex": 53,
    "zh": "於是越謝曰：「臣老，諸君強以為長。"
  },
  {
    "id": "s0389",
    "blockIndex": 53,
    "zh": "今期而多後，不可盡誅，誅最後者一人。"
  },
  {
    "id": "s0390",
    "blockIndex": 53,
    "zh": "」令校長斬之。"
  },
  {
    "id": "s0391",
    "blockIndex": 53,
    "zh": "皆笑曰：「何至於是！"
  },
  {
    "id": "s0392",
    "blockIndex": 53,
    "zh": "請後不敢。"
  },
  {
    "id": "s0393",
    "blockIndex": 53,
    "zh": "」於是越引一人斬之，設壇祭，令徒屬，徒屬皆大驚，莫敢仰視。"
  },
  {
    "id": "s0394",
    "blockIndex": 53,
    "zh": "乃略地，收諸侯散卒，得千餘人，遂助沛公攻昌邑。"
  },
  {
    "id": "s0395",
    "blockIndex": 54,
    "zh": "昌邑未下，沛公引兵西過高陽。"
  },
  {
    "id": "s0396",
    "blockIndex": 54,
    "zh": "高陽人酈食其，家貧落魄，為里監門，沛公麾下騎士適食其里中人，食其見，謂曰：「諸侯將過高陽者數十人，吾問其將皆握齪，好苛禮，自用，不能聽大度之言。"
  },
  {
    "id": "s0397",
    "blockIndex": 54,
    "zh": "吾聞沛公慢而易人，多大略，此真吾所願從游，莫為我先。"
  },
  {
    "id": "s0398",
    "blockIndex": 54,
    "zh": "若見沛公，謂曰：『臣里中有酈生，六十餘，長八尺，人皆謂之狂生。"
  },
  {
    "id": "s0399",
    "blockIndex": 54,
    "zh": "生自謂「我非狂生」。"
  },
  {
    "id": "s0400",
    "blockIndex": 54,
    "zh": "』」騎士曰：「沛公不好儒，諸客冠儒冠來者，沛公輒解其冠，溲溺其中，與人言，常大罵，未可以儒生說也。"
  },
  {
    "id": "s0401",
    "blockIndex": 54,
    "zh": "」酈生曰：「第言之。"
  },
  {
    "id": "s0402",
    "blockIndex": 54,
    "zh": "」騎士從容言，如酈生所誡者。"
  },
  {
    "id": "s0403",
    "blockIndex": 55,
    "zh": "沛公至高陽傳舍，使人召酈生。"
  },
  {
    "id": "s0404",
    "blockIndex": 55,
    "zh": "酈生至，入謁。"
  },
  {
    "id": "s0405",
    "blockIndex": 55,
    "zh": "沛公方倨床使兩女子洗足，而見酈生。"
  },
  {
    "id": "s0406",
    "blockIndex": 55,
    "zh": "酈生入，則長揖不拜，曰：「足下欲助秦攻諸侯乎？"
  },
  {
    "id": "s0407",
    "blockIndex": 55,
    "zh": "且欲率諸侯破秦也？"
  },
  {
    "id": "s0408",
    "blockIndex": 55,
    "zh": "」沛公罵曰：「豎儒！"
  },
  {
    "id": "s0409",
    "blockIndex": 55,
    "zh": "天下同苦秦久矣，故諸侯相率而攻秦，何謂助秦攻諸侯乎！"
  },
  {
    "id": "s0410",
    "blockIndex": 55,
    "zh": "」酈生曰：「必聚徒合義兵誅無道秦，不宜倨見長者！"
  },
  {
    "id": "s0411",
    "blockIndex": 55,
    "zh": "」於是沛公輟洗，起，攝衣，延酈生上坐，謝之。"
  },
  {
    "id": "s0412",
    "blockIndex": 55,
    "zh": "酈生因言六國從橫時。"
  },
  {
    "id": "s0413",
    "blockIndex": 55,
    "zh": "沛公喜，賜酈生食，問曰：「計將安出？"
  },
  {
    "id": "s0414",
    "blockIndex": 55,
    "zh": "」酈生曰：「足下起糾合之眾，收散亂之兵，不滿萬人；"
  },
  {
    "id": "s0415",
    "blockIndex": 55,
    "zh": "欲以徑入強秦，此所謂探虎口者也。"
  },
  {
    "id": "s0416",
    "blockIndex": 55,
    "zh": "夫陳留，天下之沖，四通五達之郊也，今其城中又多積粟。"
  },
  {
    "id": "s0417",
    "blockIndex": 55,
    "zh": "臣善其令，請得使之令下足下。"
  },
  {
    "id": "s0418",
    "blockIndex": 55,
    "zh": "即不聽，足下引兵攻之，臣為內應。"
  },
  {
    "id": "s0419",
    "blockIndex": 55,
    "zh": "」於是遣酈生行，沛公引兵隨之，遂下陳留。"
  },
  {
    "id": "s0420",
    "blockIndex": 55,
    "zh": "號酈食其為廣野君。"
  },
  {
    "id": "s0421",
    "blockIndex": 55,
    "zh": "酈生言其弟商。"
  },
  {
    "id": "s0422",
    "blockIndex": 55,
    "zh": "時商聚少年得四千人，來屬沛公，沛公以為將，將陳留兵以從，酈生常為說客，使諸侯。"
  },
  {
    "id": "s0423",
    "blockIndex": 56,
    "zh": "三月，沛公攻開封，未拔。"
  },
  {
    "id": "s0424",
    "blockIndex": 56,
    "zh": "西與秦將楊熊會戰白馬，又戰曲遇東，大破之。"
  },
  {
    "id": "s0425",
    "blockIndex": 56,
    "zh": "楊熊走之滎陽，二世使使者斬之以徇。"
  },
  {
    "id": "s0426",
    "blockIndex": 57,
    "zh": "夏，四月，沛公南攻穎川，屠之。"
  },
  {
    "id": "s0427",
    "blockIndex": 57,
    "zh": "因張良，遂略韓地。"
  },
  {
    "id": "s0428",
    "blockIndex": 57,
    "zh": "時趙別將司馬卬方欲渡河入關。"
  },
  {
    "id": "s0429",
    "blockIndex": 57,
    "zh": "沛公乃北攻平陰，絕河津南，戰洛陽東。"
  },
  {
    "id": "s0430",
    "blockIndex": 57,
    "zh": "軍不利，南出轘轅。"
  },
  {
    "id": "s0431",
    "blockIndex": 57,
    "zh": "張良引兵從沛公。"
  },
  {
    "id": "s0432",
    "blockIndex": 57,
    "zh": "沛公令韓王成留守陽翟，與良俱南。"
  },
  {
    "id": "s0433",
    "blockIndex": 58,
    "zh": "六月，與南陽守齮戰犨東，破之，略南陽郡；"
  },
  {
    "id": "s0434",
    "blockIndex": 58,
    "zh": "南陽守走保城，守宛。"
  },
  {
    "id": "s0435",
    "blockIndex": 58,
    "zh": "沛公引兵過宛，西。"
  },
  {
    "id": "s0436",
    "blockIndex": 58,
    "zh": "張良諫曰：「沛公雖欲急入關，秦兵尚眾，距險。"
  },
  {
    "id": "s0437",
    "blockIndex": 58,
    "zh": "今不下宛，宛從後擊，強秦在前，此危道也。"
  },
  {
    "id": "s0438",
    "blockIndex": 58,
    "zh": "」於是沛公乃夜引軍從他道還，偃旗幟，遲明，圍宛城三匝。"
  },
  {
    "id": "s0439",
    "blockIndex": 58,
    "zh": "南陽守欲自剄，共舍人陳恢曰：「死未晚也。"
  },
  {
    "id": "s0440",
    "blockIndex": 58,
    "zh": "」乃逾城見沛公曰：「臣聞足下約先入咸陽者王之。"
  },
  {
    "id": "s0441",
    "blockIndex": 58,
    "zh": "今足下留守宛，宛郡縣連城數十，其吏民自以為降必死，故皆堅守乘城。"
  },
  {
    "id": "s0442",
    "blockIndex": 58,
    "zh": "今足下盡日上攻，士死傷者必多。"
  },
  {
    "id": "s0443",
    "blockIndex": 58,
    "zh": "引兵去宛，宛必隨足下後。"
  },
  {
    "id": "s0444",
    "blockIndex": 58,
    "zh": "足下前則失咸陽之約，後有強宛之患。"
  },
  {
    "id": "s0445",
    "blockIndex": 58,
    "zh": "為足下計，莫若約降，封其守；"
  },
  {
    "id": "s0446",
    "blockIndex": 58,
    "zh": "因使止守，引其甲卒與之西。"
  },
  {
    "id": "s0447",
    "blockIndex": 58,
    "zh": "諸城未下者，聞聲爭開門而待足下，足下通行無所累。"
  },
  {
    "id": "s0448",
    "blockIndex": 58,
    "zh": "」沛公曰：「善！"
  },
  {
    "id": "s0449",
    "blockIndex": 58,
    "zh": "」秋，七月，南陽守齮降，封為殷侯，封陳恢千戶。"
  },
  {
    "id": "s0450",
    "blockIndex": 58,
    "zh": "引兵西，無不下者。"
  },
  {
    "id": "s0451",
    "blockIndex": 58,
    "zh": "至丹水，高武侯鰓、襄侯王陵降。"
  },
  {
    "id": "s0452",
    "blockIndex": 58,
    "zh": "還攻胡陽，遇番君別將梅鋗，與偕攻析、酈，皆降。"
  },
  {
    "id": "s0453",
    "blockIndex": 58,
    "zh": "所過亡得鹵掠，秦民皆喜。"
  },
  {
    "id": "s0455",
    "blockIndex": 59,
    "zh": "7王離軍既沒，章邯軍棘原，項羽軍漳南，相持未戰。"
  },
  {
    "id": "s0456",
    "blockIndex": 59,
    "zh": "秦軍數卻，二世使人讓章邯。"
  },
  {
    "id": "s0457",
    "blockIndex": 59,
    "zh": "章邯恐，使長史欣請事。"
  },
  {
    "id": "s0458",
    "blockIndex": 59,
    "zh": "至咸陽，留司馬門三日，趙高不見，有不信之心。"
  },
  {
    "id": "s0459",
    "blockIndex": 59,
    "zh": "長史欣恐，還走其軍，不敢出故道。"
  },
  {
    "id": "s0460",
    "blockIndex": 59,
    "zh": "趙高果使人追之，不及。"
  },
  {
    "id": "s0461",
    "blockIndex": 59,
    "zh": "欣至軍，報曰：「趙高用事於中，下無可為者。"
  },
  {
    "id": "s0462",
    "blockIndex": 59,
    "zh": "今戰能勝，高必疾妒吾功，不能勝，不免於死。"
  },
  {
    "id": "s0463",
    "blockIndex": 59,
    "zh": "願將軍孰計之！"
  },
  {
    "id": "s0464",
    "blockIndex": 59,
    "zh": "」陳餘亦遺章邯書曰：「白起為秦將，南征鄢郢，北坑馬服，攻城略地，不可勝計，而竟賜死。"
  },
  {
    "id": "s0465",
    "blockIndex": 59,
    "zh": "蒙恬為秦將，北逐戎人，開榆中地數千里，竟斬陽周。"
  },
  {
    "id": "s0466",
    "blockIndex": 59,
    "zh": "何者？"
  },
  {
    "id": "s0467",
    "blockIndex": 59,
    "zh": "功多，秦不能盡封，因以法誅之。"
  },
  {
    "id": "s0468",
    "blockIndex": 59,
    "zh": "今將軍為秦將三歲矣，所亡失以十萬數，而諸侯並起滋益多。"
  },
  {
    "id": "s0469",
    "blockIndex": 59,
    "zh": "彼趙高素諛日久，今事急，亦恐二世誅之，故欲以法誅將軍以塞責，使人更代將軍以脫其禍。"
  },
  {
    "id": "s0470",
    "blockIndex": 59,
    "zh": "夫將軍居外久，多內郤，有功亦誅，無功亦誅。"
  },
  {
    "id": "s0471",
    "blockIndex": 59,
    "zh": "且天之亡秦，無愚智皆知之。"
  },
  {
    "id": "s0472",
    "blockIndex": 59,
    "zh": "今將軍內不能直諫，外為亡國將，孤特獨立而欲常存，豈不哀哉！"
  },
  {
    "id": "s0473",
    "blockIndex": 59,
    "zh": "將軍何不還兵與諸侯為從，約共攻秦，分王其地，南面稱孤！"
  },
  {
    "id": "s0474",
    "blockIndex": 59,
    "zh": "此孰與身伏鈇質、妻子為戮乎？"
  },
  {
    "id": "s0476",
    "blockIndex": 60,
    "zh": "章邯狐疑，陰使候始成使項羽，欲約。"
  },
  {
    "id": "s0477",
    "blockIndex": 60,
    "zh": "約未成，項羽使蒲將日夜引兵度三戶，軍漳南，與秦軍戰，再破之。"
  },
  {
    "id": "s0478",
    "blockIndex": 60,
    "zh": "項羽悉引兵擊秦軍汙水上，大破之。"
  },
  {
    "id": "s0479",
    "blockIndex": 60,
    "zh": "章邯使人見項羽，欲約。"
  },
  {
    "id": "s0480",
    "blockIndex": 60,
    "zh": "項羽召軍吏謀曰：「糧少，欲聽其約。"
  },
  {
    "id": "s0481",
    "blockIndex": 60,
    "zh": "」軍吏皆曰：「善。"
  },
  {
    "id": "s0482",
    "blockIndex": 60,
    "zh": "」項羽乃與期洹水殷虛上。"
  },
  {
    "id": "s0483",
    "blockIndex": 60,
    "zh": "已盟，章邯見項羽而流涕，為言趙高。"
  },
  {
    "id": "s0484",
    "blockIndex": 60,
    "zh": "項羽乃立章邯為雍王，置楚軍中，使長史欣為上將軍，將秦軍為前行。"
  },
  {
    "id": "s0485",
    "blockIndex": 61,
    "zh": "瑕丘申陽下河南，引兵從項羽。"
  },
  {
    "id": "s0487",
    "blockIndex": 62,
    "zh": "8初，中丞相趙高欲專秦權，恐群臣不聽，乃先設驗，持鹿獻於二世曰：「馬也。"
  },
  {
    "id": "s0488",
    "blockIndex": 62,
    "zh": "」二世笑曰：「丞相誤邪，謂鹿為馬！"
  },
  {
    "id": "s0489",
    "blockIndex": 62,
    "zh": "」問左右，左右或默，或言馬以阿順趙高，或言鹿者。"
  },
  {
    "id": "s0490",
    "blockIndex": 62,
    "zh": "高因陰中諸言鹿者以法。"
  },
  {
    "id": "s0491",
    "blockIndex": 62,
    "zh": "後群臣皆畏高，莫敢言其過。"
  },
  {
    "id": "s0492",
    "blockIndex": 62,
    "zh": "高前數言「關東盜無能為也」，及項羽虜王離等，而章邯等軍數敗，上書請益助。"
  },
  {
    "id": "s0493",
    "blockIndex": 62,
    "zh": "自關以東，大抵盡畔秦吏，應諸侯，諸侯鹹率其眾西鄉。"
  },
  {
    "id": "s0494",
    "blockIndex": 62,
    "zh": "八月，沛公將數萬人攻武關，屠之。"
  },
  {
    "id": "s0495",
    "blockIndex": 62,
    "zh": "高恐二世怒，誅及其身，乃謝病，不朝見。"
  },
  {
    "id": "s0496",
    "blockIndex": 63,
    "zh": "二世夢白虎嚙其左驂馬，殺之，心不樂，怪問占夢。"
  },
  {
    "id": "s0497",
    "blockIndex": 63,
    "zh": "卜曰：「涇水為祟。"
  },
  {
    "id": "s0498",
    "blockIndex": 63,
    "zh": "」二世乃齋於望夷宮，欲祠涇水，沈四白馬。"
  },
  {
    "id": "s0499",
    "blockIndex": 63,
    "zh": "使使責讓高以盜賊事。"
  },
  {
    "id": "s0500",
    "blockIndex": 63,
    "zh": "高懼，乃陰與其婿咸陽令閻樂及弟趙成謀曰：「上不聽諫。"
  },
  {
    "id": "s0501",
    "blockIndex": 63,
    "zh": "今事急，欲歸禍於吾。"
  },
  {
    "id": "s0502",
    "blockIndex": 63,
    "zh": "吾欲易置上，更立子嬰。"
  },
  {
    "id": "s0503",
    "blockIndex": 63,
    "zh": "子嬰仁儉，百姓皆載其言。"
  },
  {
    "id": "s0504",
    "blockIndex": 63,
    "zh": "」乃使郎中令為內應，詐為有大賊，令樂召吏發兵追，劫樂母置高舍。"
  },
  {
    "id": "s0505",
    "blockIndex": 63,
    "zh": "遣樂將吏卒千餘人至望夷宮殿門，縛衛令僕射，曰：「賊入此，何不止？"
  },
  {
    "id": "s0506",
    "blockIndex": 63,
    "zh": "」衛令曰：「周廬設卒甚謹，安得賊敢入宮！"
  },
  {
    "id": "s0507",
    "blockIndex": 63,
    "zh": "」樂遂斬衛令，直將吏入，行射郎、宦者。"
  },
  {
    "id": "s0508",
    "blockIndex": 63,
    "zh": "郎、宦者大驚，或走，或格。"
  },
  {
    "id": "s0509",
    "blockIndex": 63,
    "zh": "格者輒死，死者數十人。"
  },
  {
    "id": "s0510",
    "blockIndex": 63,
    "zh": "郎中令與樂俱入，射上幄坐幃。"
  },
  {
    "id": "s0511",
    "blockIndex": 63,
    "zh": "二世怒，召左右，左右皆惶擾不鬥。"
  },
  {
    "id": "s0512",
    "blockIndex": 63,
    "zh": "旁有宦者一人侍，不敢去。"
  },
  {
    "id": "s0513",
    "blockIndex": 63,
    "zh": "二世入內，謂曰：「公何不早告我，乃至於此！"
  },
  {
    "id": "s0514",
    "blockIndex": 63,
    "zh": "」宦者曰：「臣不敢言，故得全。"
  },
  {
    "id": "s0515",
    "blockIndex": 63,
    "zh": "使臣早言，皆已誅，安得至今！"
  },
  {
    "id": "s0516",
    "blockIndex": 63,
    "zh": "」閻樂前即二世，數曰：「足下驕恣，誅殺無道，天下共畔足下。"
  },
  {
    "id": "s0517",
    "blockIndex": 63,
    "zh": "足下其自為計！"
  },
  {
    "id": "s0518",
    "blockIndex": 63,
    "zh": "」二世曰：「丞相可得見否？"
  },
  {
    "id": "s0519",
    "blockIndex": 63,
    "zh": "」樂曰：「不可！"
  },
  {
    "id": "s0520",
    "blockIndex": 63,
    "zh": "」二世曰：「吾願得一郡為王。"
  },
  {
    "id": "s0521",
    "blockIndex": 63,
    "zh": "」弗許。"
  },
  {
    "id": "s0522",
    "blockIndex": 63,
    "zh": "又曰：「願為萬戶侯。"
  },
  {
    "id": "s0523",
    "blockIndex": 63,
    "zh": "」弗許。"
  },
  {
    "id": "s0524",
    "blockIndex": 63,
    "zh": "曰：「願與妻子為黔首，比諸公子。"
  },
  {
    "id": "s0525",
    "blockIndex": 63,
    "zh": "」閻樂曰：「臣受命於丞相，為天下誅足下。"
  },
  {
    "id": "s0526",
    "blockIndex": 63,
    "zh": "足下雖多言，臣不敢報！"
  },
  {
    "id": "s0527",
    "blockIndex": 63,
    "zh": "」麾其兵進。"
  },
  {
    "id": "s0528",
    "blockIndex": 63,
    "zh": "二世自殺。"
  },
  {
    "id": "s0529",
    "blockIndex": 63,
    "zh": "閻樂歸報趙高。"
  },
  {
    "id": "s0530",
    "blockIndex": 63,
    "zh": "趙高乃悉召諸大臣、公子，告以誅二世之狀，曰：「秦故王國，始皇君天下，故稱帝。"
  },
  {
    "id": "s0531",
    "blockIndex": 63,
    "zh": "今六國復自立，秦地益小，乃以空名為帝，不可。"
  },
  {
    "id": "s0532",
    "blockIndex": 63,
    "zh": "宜為王如故，便。"
  },
  {
    "id": "s0533",
    "blockIndex": 63,
    "zh": "」乃立子嬰為秦王。"
  },
  {
    "id": "s0534",
    "blockIndex": 63,
    "zh": "以黔首葬二世社南宜春苑中。"
  },
  {
    "id": "s0535",
    "blockIndex": 64,
    "zh": "九月，趙高令子嬰齋戒，當廟見，受玉璽。"
  },
  {
    "id": "s0536",
    "blockIndex": 64,
    "zh": "齋五日。"
  },
  {
    "id": "s0537",
    "blockIndex": 64,
    "zh": "子嬰與其子二人謀曰：「丞相高殺二世望夷宮，恐群臣誅之，乃佯以義立我。"
  },
  {
    "id": "s0538",
    "blockIndex": 64,
    "zh": "我聞趙高乃與楚約，滅秦宗室而分王關中。"
  },
  {
    "id": "s0539",
    "blockIndex": 64,
    "zh": "今使我齋、見廟，此欲因廟中殺我。"
  },
  {
    "id": "s0540",
    "blockIndex": 64,
    "zh": "我稱病不行，丞相必自來，來則殺之。"
  },
  {
    "id": "s0541",
    "blockIndex": 64,
    "zh": "」高使人請子嬰數輩，子嬰不行。"
  },
  {
    "id": "s0542",
    "blockIndex": 64,
    "zh": "高果自往，曰：「宗廟重事，王奈何不行？"
  },
  {
    "id": "s0543",
    "blockIndex": 64,
    "zh": "」子嬰遂刺殺高於齋宮，三族高家以徇。"
  },
  {
    "id": "s0544",
    "blockIndex": 65,
    "zh": "遣將兵距嶢關，沛公欲擊之。"
  },
  {
    "id": "s0545",
    "blockIndex": 65,
    "zh": "張良曰：「秦兵尚強，未可輕。"
  },
  {
    "id": "s0546",
    "blockIndex": 65,
    "zh": "願先遣人益張旗幟於山上為疑兵，使酈食其、陸賈往說秦將，啖以利。"
  },
  {
    "id": "s0547",
    "blockIndex": 65,
    "zh": "」秦將果欲連和，沛公欲許之。"
  },
  {
    "id": "s0548",
    "blockIndex": 65,
    "zh": "張良曰：「此獨其將欲叛，恐其士卒不從；"
  },
  {
    "id": "s0549",
    "blockIndex": 65,
    "zh": "不如因其懈怠擊之。"
  },
  {
    "id": "s0550",
    "blockIndex": 65,
    "zh": "」沛公引兵繞嶢關，逾蕢山，擊秦軍，大破之藍田南。"
  },
  {
    "id": "s0551",
    "blockIndex": 65,
    "zh": "遂至藍田，又戰其北，秦兵大敗。"
  }
]
