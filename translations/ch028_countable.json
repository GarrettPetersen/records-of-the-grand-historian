[
  {
    "id": "s0001",
    "blockIndex": 0,
    "zh": "起昭陽作噩，盡屠維單閼，凡七年。"
  },
  {
    "id": "s0002",
    "blockIndex": 1,
    "zh": "1春，正月，辛丑，葬孝宣皇帝於杜陵；"
  },
  {
    "id": "s0003",
    "blockIndex": 1,
    "zh": "赦天下。"
  },
  {
    "id": "s0004",
    "blockIndex": 1,
    "zh": "----2三月，丙午，立皇后王氏，封-{后父}-禁為陽平候。"
  },
  {
    "id": "s0005",
    "blockIndex": 1,
    "zh": "----3以三輔、太常、郡國公田及苑可省者振業貧民；"
  },
  {
    "id": "s0006",
    "blockIndex": 1,
    "zh": "貲不滿千錢者，賦貸種、食。"
  },
  {
    "id": "s0007",
    "blockIndex": 1,
    "zh": "----4封外祖父平恩戴侯同產弟子中常侍許嘉為平恩侯。"
  },
  {
    "id": "s0008",
    "blockIndex": 1,
    "zh": "----5夏，六月，以民疾疫，令太官損膳，減樂府員，省苑馬，以振困乏。"
  },
  {
    "id": "s0009",
    "blockIndex": 1,
    "zh": "----6秋，九月，關東郡、國十一大水，饑，或人相食；"
  },
  {
    "id": "s0010",
    "blockIndex": 1,
    "zh": "轉旁郡錢穀以相救。"
  },
  {
    "id": "s0011",
    "blockIndex": 1,
    "zh": "----7上素聞琅邪王吉、貢禹皆明經潔行，遣使者徵之。"
  },
  {
    "id": "s0012",
    "blockIndex": 1,
    "zh": "吉道病卒。"
  },
  {
    "id": "s0013",
    "blockIndex": 1,
    "zh": "禹至，拜為諫大夫。"
  },
  {
    "id": "s0014",
    "blockIndex": 1,
    "zh": "上數虛已問以政事，禹奏言：「古者人君節儉，什一而稅，無它賦役，故家給人足。"
  },
  {
    "id": "s0015",
    "blockIndex": 1,
    "zh": "高祖、孝文、孝景皇帝，宮女不過十餘人，廄馬百餘匹。"
  },
  {
    "id": "s0016",
    "blockIndex": 1,
    "zh": "後世爭為奢侈，轉轉益甚；"
  },
  {
    "id": "s0017",
    "blockIndex": 1,
    "zh": "臣下亦相放效。"
  },
  {
    "id": "s0018",
    "blockIndex": 1,
    "zh": "臣愚以為如太古難，宜少放古以自節焉。"
  },
  {
    "id": "s0019",
    "blockIndex": 1,
    "zh": "方今宮室已定，無可奈何矣；"
  },
  {
    "id": "s0020",
    "blockIndex": 1,
    "zh": "其餘盡可減損。"
  },
  {
    "id": "s0021",
    "blockIndex": 1,
    "zh": "故時齊三服官，輸物不過十笥；"
  },
  {
    "id": "s0022",
    "blockIndex": 1,
    "zh": "方今齊三服官，作工各數千人，一歲費數巨萬，廄馬食粟將萬匹。"
  },
  {
    "id": "s0023",
    "blockIndex": 1,
    "zh": "武帝時，又多取好女至數千人，以填後宮。"
  },
  {
    "id": "s0024",
    "blockIndex": 1,
    "zh": "及棄天下，多藏金錢、財物，鳥獸、魚鱉凡百九十物；"
  },
  {
    "id": "s0025",
    "blockIndex": 1,
    "zh": "又皆以後宮女置於園陵。"
  },
  {
    "id": "s0026",
    "blockIndex": 1,
    "zh": "至孝宣皇帝時，陛下惡有所言，群臣亦隨故事，甚可痛也！"
  },
  {
    "id": "s0027",
    "blockIndex": 1,
    "zh": "故使天下承化，取女皆大過度，諸侯妻妾或至數百人，豪富吏民畜歌者至數十人，是以內多怨女，外多曠夫。"
  },
  {
    "id": "s0028",
    "blockIndex": 1,
    "zh": "及眾庶葬埋，皆虛地上以實地下。"
  },
  {
    "id": "s0029",
    "blockIndex": 1,
    "zh": "其過自上生，皆在大臣循故事之罪也。"
  },
  {
    "id": "s0030",
    "blockIndex": 1,
    "zh": "唯陛下深察古道，從其儉者。"
  },
  {
    "id": "s0031",
    "blockIndex": 1,
    "zh": "大減損乘輿服御器物，三分去二；"
  },
  {
    "id": "s0032",
    "blockIndex": 1,
    "zh": "擇後宮賢者，留二十人，餘悉歸之，及諸陵園女無子者，宜悉遣；"
  },
  {
    "id": "s0033",
    "blockIndex": 1,
    "zh": "廄馬可無過數十匹，獨捨長安城南苑地，以為田獵之囿。"
  },
  {
    "id": "s0034",
    "blockIndex": 1,
    "zh": "方今天下饑饉，可無大自損減以救之稱天意乎！"
  },
  {
    "id": "s0035",
    "blockIndex": 1,
    "zh": "天生聖人，蓋為萬民，非獨使自娛樂而已也。"
  },
  {
    "id": "s0036",
    "blockIndex": 1,
    "zh": "」天子納善其言，下詔，令諸宮館希御幸者勿繕治；"
  },
  {
    "id": "s0037",
    "blockIndex": 1,
    "zh": "太僕減穀食馬；"
  },
  {
    "id": "s0038",
    "blockIndex": 1,
    "zh": "水衡省肉食獸。"
  },
  {
    "id": "s0039",
    "blockIndex": 2,
    "zh": ":臣光曰：忠臣之事君也，責其所難，則其易者不勞而正；"
  },
  {
    "id": "s0040",
    "blockIndex": 2,
    "zh": "補其所短，則其長者不勸而遂。"
  },
  {
    "id": "s0041",
    "blockIndex": 2,
    "zh": "孝元踐位之初，虛心以問禹，禹宜先其所急，後其所緩。"
  },
  {
    "id": "s0042",
    "blockIndex": 2,
    "zh": "然則優遊不斷，讒佞用權，當時之大患也，而禹不以為言；"
  },
  {
    "id": "s0043",
    "blockIndex": 2,
    "zh": "恭謹節儉，孝元之素志也，而禹孜孜而言之，何哉！"
  },
  {
    "id": "s0044",
    "blockIndex": 2,
    "zh": "使禹之智足不以知，烏得為賢！"
  },
  {
    "id": "s0045",
    "blockIndex": 2,
    "zh": "知而不言，為罪愈大矣！"
  },
  {
    "id": "s0046",
    "blockIndex": 2,
    "zh": "----8匈奴呼韓邪單于復上書，言民眾困乏。"
  },
  {
    "id": "s0047",
    "blockIndex": 2,
    "zh": "詔雲中、五原郡轉穀二萬斛以給之。"
  },
  {
    "id": "s0048",
    "blockIndex": 2,
    "zh": "----9是歲，初置戊己校尉，使屯田車師故地。"
  },
  {
    "id": "s0050",
    "blockIndex": 3,
    "zh": "1春，正月，上行幸甘泉，郊泰畤。"
  },
  {
    "id": "s0051",
    "blockIndex": 3,
    "zh": "樂陵侯史高以外屬領尚書事，前將軍蕭望之、光祿大夫周堪為之副。"
  },
  {
    "id": "s0052",
    "blockIndex": 3,
    "zh": "望之名儒，與堪皆以師傅舊恩，天子任之，數宴見，言治亂，陳王事。"
  },
  {
    "id": "s0053",
    "blockIndex": 3,
    "zh": "望之選白宗室明經有行散騎、諫大夫劉更生給事中，與侍中金敞並拾遺左右。"
  },
  {
    "id": "s0054",
    "blockIndex": 3,
    "zh": "四人同心謀議，勸導上以古制，多所欲匡正；"
  },
  {
    "id": "s0055",
    "blockIndex": 3,
    "zh": "上甚鄉納之。"
  },
  {
    "id": "s0056",
    "blockIndex": 3,
    "zh": "史高充位而已，由此與望之有隙。"
  },
  {
    "id": "s0057",
    "blockIndex": 4,
    "zh": "中書令弘恭、僕射石顯，自宣帝時久典樞機，明習文法；"
  },
  {
    "id": "s0058",
    "blockIndex": 4,
    "zh": "帝即位多疾，以顯久典事，中人無外黨，精專可信任，遂委以政，事無小大，因顯白決，貴幸傾朝，百僚皆敬事顯。"
  },
  {
    "id": "s0059",
    "blockIndex": 4,
    "zh": "顯為人巧慧習事，能深得人主微指，內深賊，持詭辯，以中傷人，忤恨睚眥，輒被以危法；"
  },
  {
    "id": "s0060",
    "blockIndex": 4,
    "zh": "亦與車騎將軍高為表裡，議論常獨持故事，不從望之等。"
  },
  {
    "id": "s0061",
    "blockIndex": 5,
    "zh": "望之等患苦許、史放縱，又疾恭、顯擅權，建白以為：「中書政本，國家樞機，宜以通明公正處之。"
  },
  {
    "id": "s0062",
    "blockIndex": 5,
    "zh": "武帝游宴後庭，故用宦者，非古制也。"
  },
  {
    "id": "s0063",
    "blockIndex": 5,
    "zh": "宜罷中書宦官，應古不近刑人之義。"
  },
  {
    "id": "s0064",
    "blockIndex": 5,
    "zh": "」由是大與高、恭、顯忤。"
  },
  {
    "id": "s0065",
    "blockIndex": 5,
    "zh": "上初即位，謙讓，重改作，議久不定，出劉更生為宗正。"
  },
  {
    "id": "s0066",
    "blockIndex": 6,
    "zh": "望之、堪數薦名儒、茂材以備諫官，會稽鄭朋陰欲附望之，上書言車騎將軍高遣客為奸利郡國，及言許、史弟子罪過。"
  },
  {
    "id": "s0067",
    "blockIndex": 6,
    "zh": "章視周堪，堪白：「令朋待詔金馬門。"
  },
  {
    "id": "s0068",
    "blockIndex": 6,
    "zh": "」朋奏記望之曰：「今將軍規模，-{云}-若管、晏而休，遂行日昃，至周、召乃留乎？"
  },
  {
    "id": "s0069",
    "blockIndex": 6,
    "zh": "若管、晏而休，則下走將歸延陵之皋，沒齒而已矣。"
  },
  {
    "id": "s0070",
    "blockIndex": 6,
    "zh": "如將軍興周、召之遺業，親日昃之兼聽，則下走其庶幾願竭區區奉萬分之一！"
  },
  {
    "id": "s0071",
    "blockIndex": 6,
    "zh": "」望之始見朋，接待以意；"
  },
  {
    "id": "s0072",
    "blockIndex": 6,
    "zh": "後知其傾邪，絕不與通。"
  },
  {
    "id": "s0073",
    "blockIndex": 6,
    "zh": "朋，楚士，怨恨，更求入許、史，推所言許、史事，曰：「皆周堪、劉更生教我；"
  },
  {
    "id": "s0074",
    "blockIndex": 6,
    "zh": "我關東人，何以知此！"
  },
  {
    "id": "s0075",
    "blockIndex": 6,
    "zh": "」於是侍中許章白見朋。"
  },
  {
    "id": "s0076",
    "blockIndex": 6,
    "zh": "朋出，揚言曰：「我見言前將軍小過五，大罪一。"
  },
  {
    "id": "s0077",
    "blockIndex": 6,
    "zh": "」待詔華龍行污穢，欲入堪等，堪等不納，亦與朋相結。"
  },
  {
    "id": "s0078",
    "blockIndex": 7,
    "zh": "恭、顯令二人告望之等謀欲罷車騎將軍，疏退許、史狀，候望之出休日，令朋、龍上之。"
  },
  {
    "id": "s0079",
    "blockIndex": 7,
    "zh": "事下弘恭問狀，望之對曰：「外戚在位多奢淫，欲以匡正國家，非為邪也。"
  },
  {
    "id": "s0080",
    "blockIndex": 7,
    "zh": "」恭、顯奏：「望之、堪、更生朋黨相稱舉，數譖訴大臣，毀離親戚，欲以專擅權勢。"
  },
  {
    "id": "s0081",
    "blockIndex": 7,
    "zh": "為臣不忠，誣上不道，請謁者召致廷尉。"
  },
  {
    "id": "s0082",
    "blockIndex": 7,
    "zh": "」時上初即位，不省召致廷尉為下獄也，可其奏。"
  },
  {
    "id": "s0083",
    "blockIndex": 7,
    "zh": "後上召堪、更生，曰：「繫獄。"
  },
  {
    "id": "s0084",
    "blockIndex": 7,
    "zh": "」上大驚曰：「非但廷尉問邪！"
  },
  {
    "id": "s0085",
    "blockIndex": 7,
    "zh": "」以責恭、顯，皆叩頭謝。"
  },
  {
    "id": "s0086",
    "blockIndex": 7,
    "zh": "上曰：「令出視事。"
  },
  {
    "id": "s0087",
    "blockIndex": 7,
    "zh": "」恭、顯因使史高言：「上新即位，未以德化聞於天下，而先驗師傅。"
  },
  {
    "id": "s0088",
    "blockIndex": 7,
    "zh": "既下九卿、大夫獄，宜因決免。"
  },
  {
    "id": "s0089",
    "blockIndex": 7,
    "zh": "」於是制詔丞相、御史：「前將軍望之，傅朕八年，無它罪過。"
  },
  {
    "id": "s0090",
    "blockIndex": 7,
    "zh": "今事久遠，識忘難明，其赦望之罪，收前將軍、光祿勳印綬；"
  },
  {
    "id": "s0091",
    "blockIndex": 7,
    "zh": "及堪、更生皆免為庶人。"
  },
  {
    "id": "s0092",
    "blockIndex": 7,
    "zh": "」----2二月，丁巳，立弟竟為清河王。"
  },
  {
    "id": "s0093",
    "blockIndex": 7,
    "zh": "----3戊午，隴西地震，敗城郭、屋室，壓殺人眾。"
  },
  {
    "id": "s0094",
    "blockIndex": 7,
    "zh": "----4三月，立廣陵厲王子霸為王。"
  },
  {
    "id": "s0095",
    "blockIndex": 7,
    "zh": "----5詔罷黃門乘輿狗馬，水衡禁囿、宜春下苑、少府佽飛外池、嚴籞池田假與貧民。"
  },
  {
    "id": "s0096",
    "blockIndex": 7,
    "zh": "又詔赦天下，舉茂材異等、直言極諫之士。"
  },
  {
    "id": "s0097",
    "blockIndex": 7,
    "zh": "----6夏，四月，丁巳，立子驁為皇太子。"
  },
  {
    "id": "s0098",
    "blockIndex": 7,
    "zh": "待詔鄭朋薦太原太守張敞，先帝名臣，宜傅輔皇太子。"
  },
  {
    "id": "s0099",
    "blockIndex": 7,
    "zh": "上以問蕭望之，望之以為敞能吏，任治煩亂，材輕，非師傅之器。"
  },
  {
    "id": "s0100",
    "blockIndex": 7,
    "zh": "天子使使者徵敞，欲以為左馮翊，會病卒。"
  },
  {
    "id": "s0101",
    "blockIndex": 7,
    "zh": "----7詔賜蕭望之爵關內侯，給事中，朝朔望。"
  },
  {
    "id": "s0102",
    "blockIndex": 7,
    "zh": "----8關東饑，齊地人相食。"
  },
  {
    "id": "s0103",
    "blockIndex": 7,
    "zh": "----9秋，七月，己酉，地復震。"
  },
  {
    "id": "s0104",
    "blockIndex": 7,
    "zh": "----10上復征周堪、劉更生，欲以為諫大夫；"
  },
  {
    "id": "s0105",
    "blockIndex": 7,
    "zh": "弘恭、石顯白，皆以為中郎。"
  },
  {
    "id": "s0106",
    "blockIndex": 8,
    "zh": "上器重蕭望之不已，欲倚以為相；"
  },
  {
    "id": "s0107",
    "blockIndex": 8,
    "zh": "恭、顯及許、史子弟、侍中、諸曹皆側目於望之等。"
  },
  {
    "id": "s0108",
    "blockIndex": 8,
    "zh": "更生乃使其外親上變事，言「地震殆為恭等，不為三獨夫動。"
  },
  {
    "id": "s0109",
    "blockIndex": 8,
    "zh": "臣愚以為宜退恭、顯以章蔽善之罰，進望之等以通賢者之路。"
  },
  {
    "id": "s0110",
    "blockIndex": 8,
    "zh": "如此，則太平之門開，災異之原塞矣。"
  },
  {
    "id": "s0111",
    "blockIndex": 8,
    "zh": "」書奏，恭、顯疑其更生所為，白請考奸詐，辭果服；"
  },
  {
    "id": "s0112",
    "blockIndex": 8,
    "zh": "遂逮更生繫獄，免為庶人。"
  },
  {
    "id": "s0113",
    "blockIndex": 9,
    "zh": "會望之子散騎、中郎人及亦上書訟望之前事，事下有司，復奏：「望之前所坐明白，無譖訴者，而教子上書，稱引亡辜之詩，失大臣體，不敬，請逮捕。"
  },
  {
    "id": "s0114",
    "blockIndex": 9,
    "zh": "」弘恭、石顯等知望之素高節，不詘辱，建白：「望之前幸得不坐，復賜爵邑，不悔過服罪，深懷怨望，教子上書，歸非於上，自以托師傅，終必不坐，非頗屈望之於牢獄，塞其怏怏心，則聖朝無以施恩厚。"
  },
  {
    "id": "s0115",
    "blockIndex": 9,
    "zh": "」上曰：「蕭太傅素剛，安肯就吏！"
  },
  {
    "id": "s0116",
    "blockIndex": 9,
    "zh": "」顯等曰：「人命至重，望之所坐，語言薄罪，必無所憂。"
  },
  {
    "id": "s0117",
    "blockIndex": 9,
    "zh": "」上乃可其奏。"
  },
  {
    "id": "s0118",
    "blockIndex": 9,
    "zh": "冬，十二月，顯等封詔以付謁者，敕令召望之手付。"
  },
  {
    "id": "s0119",
    "blockIndex": 9,
    "zh": "因令太常急發執金吾車騎馳圍其第。"
  },
  {
    "id": "s0120",
    "blockIndex": 9,
    "zh": "使者至，召望之。"
  },
  {
    "id": "s0121",
    "blockIndex": 9,
    "zh": "望之以問門下生魯國朱雲，雲者，好節士，勸望之自裁。"
  },
  {
    "id": "s0122",
    "blockIndex": 9,
    "zh": "於是望之仰天歎曰：「吾嘗備位將相，年逾六十矣，老入牢獄，苟求生活，不亦鄙乎！"
  },
  {
    "id": "s0123",
    "blockIndex": 9,
    "zh": "」字謂雲曰：「游，趣和藥來，無久留我死！"
  },
  {
    "id": "s0124",
    "blockIndex": 9,
    "zh": "」竟飲鳩自殺。"
  },
  {
    "id": "s0125",
    "blockIndex": 9,
    "zh": "天子聞之驚，拊手曰：「曩固疑其不就牢獄，果然殺吾賢傅！"
  },
  {
    "id": "s0126",
    "blockIndex": 9,
    "zh": "」是時，太官方上晝食，上乃卻食，為之涕泣，哀動左右。"
  },
  {
    "id": "s0127",
    "blockIndex": 9,
    "zh": "於是召顯等責問；"
  },
  {
    "id": "s0128",
    "blockIndex": 9,
    "zh": "以議不詳，皆免冠謝，良久然後已。"
  },
  {
    "id": "s0129",
    "blockIndex": 9,
    "zh": "上追念望之不忘，每歲時遣使者祠祭望之塚，終帝之世。"
  },
  {
    "id": "s0130",
    "blockIndex": 10,
    "zh": ":臣光曰：甚矣孝元之為君，易欺而難寤也！"
  },
  {
    "id": "s0131",
    "blockIndex": 10,
    "zh": "夫恭、顯之譖訴望之，其邪說詭計，誠有所不能辨也。"
  },
  {
    "id": "s0132",
    "blockIndex": 10,
    "zh": "至於始疑望之不肯就獄，恭、顯以為必無憂。"
  },
  {
    "id": "s0133",
    "blockIndex": 10,
    "zh": "已而果自殺，則恭、顯之欺亦明矣。"
  },
  {
    "id": "s0134",
    "blockIndex": 10,
    "zh": "在中智之君，孰不感動奮發以厎邪臣之罰！"
  },
  {
    "id": "s0135",
    "blockIndex": 10,
    "zh": "孝元則不然。"
  },
  {
    "id": "s0136",
    "blockIndex": 10,
    "zh": "雖涕泣不食以傷望之，而終不能誅恭、顯，才得其免冠謝而已。"
  },
  {
    "id": "s0137",
    "blockIndex": 10,
    "zh": "如此，則奸臣安所懲乎！"
  },
  {
    "id": "s0138",
    "blockIndex": 10,
    "zh": "是使恭、顯得肆其邪心而無復忌憚者也。"
  },
  {
    "id": "s0139",
    "blockIndex": 10,
    "zh": "----11是歲，弘恭病死，石顯為中書令。"
  },
  {
    "id": "s0140",
    "blockIndex": 10,
    "zh": "----12初，武帝滅南越，開置珠崖、儋耳郡，在海中洲上，吏卒皆中國人，多侵陵之。"
  },
  {
    "id": "s0141",
    "blockIndex": 10,
    "zh": "其民亦暴惡，自以阻絕，數犯吏禁，率數年壹反，殺吏；"
  },
  {
    "id": "s0142",
    "blockIndex": 10,
    "zh": "漢輒發兵擊定之。"
  },
  {
    "id": "s0143",
    "blockIndex": 10,
    "zh": "二十餘年間，凡六反。"
  },
  {
    "id": "s0144",
    "blockIndex": 10,
    "zh": "至宣帝時，又再反。"
  },
  {
    "id": "s0145",
    "blockIndex": 10,
    "zh": "上即位之明年，珠崖山南縣反，發兵擊之。"
  },
  {
    "id": "s0146",
    "blockIndex": 10,
    "zh": "諸縣更叛，連年不定。"
  },
  {
    "id": "s0147",
    "blockIndex": 10,
    "zh": "上博謀於群臣，欲大發軍。"
  },
  {
    "id": "s0148",
    "blockIndex": 10,
    "zh": "待詔賈捐之曰：「臣聞堯、舜、禹之聖德，地方不過數千里，西被流沙，東漸於海，朔南暨聲教，言欲與聲教則治之，不欲與者不強治也。"
  },
  {
    "id": "s0149",
    "blockIndex": 10,
    "zh": "故君臣歌德，含氣之物各得其宜。"
  },
  {
    "id": "s0150",
    "blockIndex": 10,
    "zh": "武丁、成王，殷、周之大仁也，然地東不過江、黃，西不過氐、羌，南不過蠻荊，北不過朔方，是以頌聲並作，視聽之類鹹樂其生，越裳氏重九譯而獻，此非兵革之所能致也。"
  },
  {
    "id": "s0151",
    "blockIndex": 10,
    "zh": "以至於秦，興兵遠攻，貪外虛內而天下潰畔。"
  },
  {
    "id": "s0152",
    "blockIndex": 10,
    "zh": "孝文皇帝偃武行文，當此之時，斷獄數百，賦役輕簡。"
  },
  {
    "id": "s0153",
    "blockIndex": 10,
    "zh": "孝武皇帝厲兵馬以攘四夷，天下斷獄萬數，賦煩役重，寇賊並起，軍旅數發，父戰死於前，子鬥傷於後，女子乘亭障，孤兒號於道，老母、寡婦飲泣巷哭，是皆廓地泰大，征伐不休之故也。"
  },
  {
    "id": "s0154",
    "blockIndex": 10,
    "zh": "今關東民眾久困，流離道路。"
  },
  {
    "id": "s0155",
    "blockIndex": 10,
    "zh": "人情莫親父母，莫樂夫婦；"
  },
  {
    "id": "s0156",
    "blockIndex": 10,
    "zh": "至嫁妻賣子，法不能禁，義不能止，此社稷之憂也。"
  },
  {
    "id": "s0157",
    "blockIndex": 10,
    "zh": "今陛下不忍悁悁之忿，欲驅士眾擠之大海之中，快心幽冥之地，非所以救助饑饉，保全元元也。"
  },
  {
    "id": "s0158",
    "blockIndex": 10,
    "zh": "詩云：『蠢爾蠻荊，大邦為讎。"
  },
  {
    "id": "s0159",
    "blockIndex": 10,
    "zh": "』言聖人起則後服，中國衰則先畔，自古而患之，何況乃復其南方萬里之蠻乎！"
  },
  {
    "id": "s0160",
    "blockIndex": 10,
    "zh": "駱越之人，父子同川而浴，相習以鼻飲，與禽獸無異，本不足郡縣置也。"
  },
  {
    "id": "s0161",
    "blockIndex": 10,
    "zh": "顓顓獨居一海之中，霧露氣濕，多毒草、蟲蛇、水土之害；"
  },
  {
    "id": "s0162",
    "blockIndex": 10,
    "zh": "人未見虜，戰士自死。"
  },
  {
    "id": "s0163",
    "blockIndex": 10,
    "zh": "又非獨珠崖有珠、犀、玳瑁也。"
  },
  {
    "id": "s0164",
    "blockIndex": 10,
    "zh": "棄之不足惜，不擊不損威。"
  },
  {
    "id": "s0165",
    "blockIndex": 10,
    "zh": "其民譬猶魚鱉，何足貪也！"
  },
  {
    "id": "s0166",
    "blockIndex": 10,
    "zh": "臣竊以往者羌軍言之，暴師曾未一年，兵出不逾千里，費四十餘萬萬；"
  },
  {
    "id": "s0167",
    "blockIndex": 10,
    "zh": "大司農錢盡，乃以少府禁錢續之。"
  },
  {
    "id": "s0168",
    "blockIndex": 10,
    "zh": "夫一隅為不善，費尚如此，況於勞師遠攻，亡士毋功乎！"
  },
  {
    "id": "s0169",
    "blockIndex": 10,
    "zh": "求之往古則不合，施之當今又不便，臣愚以為非冠帶之國，《禹貢》所及，《春秋》所治，皆可且無以為。"
  },
  {
    "id": "s0170",
    "blockIndex": 10,
    "zh": "願遂棄珠崖，專用恤關東為憂！"
  },
  {
    "id": "s0171",
    "blockIndex": 10,
    "zh": "」上以問丞相、御史。"
  },
  {
    "id": "s0172",
    "blockIndex": 10,
    "zh": "御史大夫陳萬年以為當擊，丞相-{于定國}-以為：「前日興兵擊之連年，護軍都尉、校尉及丞凡十一人，還者二人，卒士及轉輸死者萬人以上，費用三萬萬餘，尚未能盡降。"
  },
  {
    "id": "s0173",
    "blockIndex": 10,
    "zh": "今關東困乏，民難搖動，捐之議是，」上從之。"
  },
  {
    "id": "s0174",
    "blockIndex": 10,
    "zh": "捐之，賈誼曾孫也。"
  },
  {
    "id": "s0176",
    "blockIndex": 11,
    "zh": "1春，詔曰：「珠崖虜殺吏民，背畔為逆。"
  },
  {
    "id": "s0177",
    "blockIndex": 11,
    "zh": "今廷議者或言可擊，或言可守，或欲棄之，其指各殊。"
  },
  {
    "id": "s0178",
    "blockIndex": 11,
    "zh": "朕日夜惟思議者之言，羞威不行，則欲誅之；"
  },
  {
    "id": "s0179",
    "blockIndex": 11,
    "zh": "狐疑辟難，則守屯田；"
  },
  {
    "id": "s0180",
    "blockIndex": 11,
    "zh": "通乎時變，則憂萬民。"
  },
  {
    "id": "s0181",
    "blockIndex": 11,
    "zh": "夫萬民之飢餓與遠蠻之不討，危孰大焉？"
  },
  {
    "id": "s0182",
    "blockIndex": 11,
    "zh": "且宗廟之祭，凶年不備，況乎辟不嫌之辱哉！"
  },
  {
    "id": "s0183",
    "blockIndex": 11,
    "zh": "今關東大困，倉庫空虛，無以相贍，又以動兵，非特勞民，凶年隨之。"
  },
  {
    "id": "s0184",
    "blockIndex": 11,
    "zh": "其罷珠崖郡，民有慕義欲內屬，便處之；"
  },
  {
    "id": "s0185",
    "blockIndex": 11,
    "zh": "不欲，勿強。"
  },
  {
    "id": "s0186",
    "blockIndex": 11,
    "zh": "」----2夏，四月，乙未晦，茂陵白鶴館災；"
  },
  {
    "id": "s0187",
    "blockIndex": 11,
    "zh": "赦天下。"
  },
  {
    "id": "s0188",
    "blockIndex": 11,
    "zh": "----3夏，旱。"
  },
  {
    "id": "s0189",
    "blockIndex": 11,
    "zh": "----4立長沙煬王弟宗為王。"
  },
  {
    "id": "s0190",
    "blockIndex": 11,
    "zh": "----5長信少府貢禹上言：「諸離宮及長樂宮衛，可減其太半以寬徭役。"
  },
  {
    "id": "s0191",
    "blockIndex": 11,
    "zh": "」六月，詔曰：「朕惟烝庶之饑寒，遠離父母妻子，勞於非業之作，衛於不居之宮，恐非所以佐陰陽之道也。"
  },
  {
    "id": "s0192",
    "blockIndex": 11,
    "zh": "其罷甘泉、建章宮衛，令就農。"
  },
  {
    "id": "s0193",
    "blockIndex": 11,
    "zh": "百宮各省費。"
  },
  {
    "id": "s0194",
    "blockIndex": 11,
    "zh": "條奏，毋有所諱。"
  },
  {
    "id": "s0195",
    "blockIndex": 11,
    "zh": "」----6是歲，上復擢周堪為光祿勳，堪弟子張猛為光祿大夫、給事中，大見信任。"
  },
  {
    "id": "s0197",
    "blockIndex": 12,
    "zh": "1春，正月，上行幸甘泉，郊泰畤。"
  },
  {
    "id": "s0198",
    "blockIndex": 12,
    "zh": "三月，行幸河東，祠后土；"
  },
  {
    "id": "s0199",
    "blockIndex": 12,
    "zh": "赦汾陰徒。"
  },
  {
    "id": "s0201",
    "blockIndex": 13,
    "zh": "1春，正月，以周子南君為周承休侯。"
  },
  {
    "id": "s0202",
    "blockIndex": 13,
    "zh": "----2三月，上行幸雍，祠五畤。"
  },
  {
    "id": "s0203",
    "blockIndex": 13,
    "zh": "----3夏，四月，有星孛於參。"
  },
  {
    "id": "s0204",
    "blockIndex": 13,
    "zh": "----4上用諸儒貢禹等之言，詔太官毋日殺，所具各減半；"
  },
  {
    "id": "s0205",
    "blockIndex": 13,
    "zh": "乘輿秣馬，無乏正事而已。"
  },
  {
    "id": "s0206",
    "blockIndex": 13,
    "zh": "罷角抵、上林宮館希御幸者、齊三服官、北假田官、鹽鐵官、常平倉。"
  },
  {
    "id": "s0207",
    "blockIndex": 13,
    "zh": "博士弟子毋置員，以廣學者。"
  },
  {
    "id": "s0208",
    "blockIndex": 13,
    "zh": "令民有能通一經者，皆復。"
  },
  {
    "id": "s0209",
    "blockIndex": 13,
    "zh": "省刑罰七十餘事。"
  },
  {
    "id": "s0210",
    "blockIndex": 13,
    "zh": "----5陳萬年卒。"
  },
  {
    "id": "s0211",
    "blockIndex": 13,
    "zh": "六月，辛酉，長信少府貢禹為御史大夫。"
  },
  {
    "id": "s0212",
    "blockIndex": 13,
    "zh": "禹前後言得失書數十上，上嘉其質直，多採用之。"
  },
  {
    "id": "s0213",
    "blockIndex": 13,
    "zh": "----6匈奴郅支單于自以道遠，又怨漢擁護呼韓邪而不助己，困辱漢使者江乃始等；"
  },
  {
    "id": "s0214",
    "blockIndex": 13,
    "zh": "遣使奉獻，因求侍子。"
  },
  {
    "id": "s0215",
    "blockIndex": 13,
    "zh": "漢議遣衛司馬谷吉送之，御史大夫貢禹、博士東海匡衡以為：「郅支單于鄉化末醇，所在絕遠，宜令使者送其子，至塞而還。"
  },
  {
    "id": "s0216",
    "blockIndex": 13,
    "zh": "」吉上書言：「中國與夷狄有羈縻不絕之義，今既養全其子十年，德澤甚厚，空絕而不送，近從塞還，示棄捐不畜，使無鄉從之心，棄前恩，立後怨，不便。"
  },
  {
    "id": "s0217",
    "blockIndex": 13,
    "zh": "議者見前江乃無應敵之數，智勇俱困，以致恥辱，即豫為臣憂。"
  },
  {
    "id": "s0218",
    "blockIndex": 13,
    "zh": "臣幸得建強漢之節，承明聖之詔，宣諭厚恩，不宜敢桀。"
  },
  {
    "id": "s0219",
    "blockIndex": 13,
    "zh": "若懷禽獸心，加無道於臣，則單于長嬰大罪，必遁逃遠捨，不敢近邊。"
  },
  {
    "id": "s0220",
    "blockIndex": 13,
    "zh": "沒一使以安百姓，國之計，臣之願也。"
  },
  {
    "id": "s0221",
    "blockIndex": 13,
    "zh": "願送至庭。"
  },
  {
    "id": "s0222",
    "blockIndex": 13,
    "zh": "」上許焉。"
  },
  {
    "id": "s0223",
    "blockIndex": 13,
    "zh": "既到，郅支單于怒，竟殺吉等；"
  },
  {
    "id": "s0224",
    "blockIndex": 13,
    "zh": "自知負漢，又聞呼韓邪益強，恐見襲擊，欲遠去。"
  },
  {
    "id": "s0225",
    "blockIndex": 13,
    "zh": "會康居王數為烏孫所困，與諸翕侯計，以為：「匈奴大國，烏孫素服屬之。"
  },
  {
    "id": "s0226",
    "blockIndex": 13,
    "zh": "今郅支單于困厄在外，可迎置東邊，使合兵取烏孫而立之，長無匈奴憂矣。"
  },
  {
    "id": "s0227",
    "blockIndex": 13,
    "zh": "」即使使到堅昆，通語郅支。"
  },
  {
    "id": "s0228",
    "blockIndex": 13,
    "zh": "郅支素恐，又怨烏孫，聞康居計，大說，遂與相結，引兵而西。"
  },
  {
    "id": "s0229",
    "blockIndex": 13,
    "zh": "郅支人眾中寒道死，餘財三千人。"
  },
  {
    "id": "s0230",
    "blockIndex": 13,
    "zh": "到康居，康居王以女妻郅支，郅支亦以女予康居王，康居甚尊敬郅支，欲倚其威以脅諸國。"
  },
  {
    "id": "s0231",
    "blockIndex": 13,
    "zh": "郅支數借兵擊烏孫，深入至谷城，殺略民人，驅畜產去。"
  },
  {
    "id": "s0232",
    "blockIndex": 13,
    "zh": "烏孫不敢追。"
  },
  {
    "id": "s0233",
    "blockIndex": 13,
    "zh": "西邊空虛不居者五千里。"
  },
  {
    "id": "s0234",
    "blockIndex": 13,
    "zh": "----7冬，十二月，丁末，貢禹卒。"
  },
  {
    "id": "s0235",
    "blockIndex": 13,
    "zh": "丁已，長信少府薛廣德為御史大夫。"
  },
  {
    "id": "s0237",
    "blockIndex": 14,
    "zh": "1春，正月，上行幸甘泉，郊泰畤。"
  },
  {
    "id": "s0238",
    "blockIndex": 14,
    "zh": "視畢，因留射獵。"
  },
  {
    "id": "s0239",
    "blockIndex": 14,
    "zh": "薛廣德上書曰：「竊見關東困極，人民流離。"
  },
  {
    "id": "s0240",
    "blockIndex": 14,
    "zh": "陛下日撞亡秦之鐘，聽鄭、衛之樂，臣誠悼之。"
  },
  {
    "id": "s0241",
    "blockIndex": 14,
    "zh": "今士卒暴露，從官勞倦，願陛下亟反宮，思與百姓同憂樂，天下幸甚！"
  },
  {
    "id": "s0242",
    "blockIndex": 14,
    "zh": "」上即日還。"
  },
  {
    "id": "s0243",
    "blockIndex": 14,
    "zh": "----2二月，詔：「丞相、御史舉質樸、敦厚、遜讓、有行者，光祿歲以此科第郎、從官。"
  },
  {
    "id": "s0244",
    "blockIndex": 14,
    "zh": "」----3三月，赦天下。"
  },
  {
    "id": "s0245",
    "blockIndex": 14,
    "zh": "----4雨雪、隕霜，殺桑。"
  },
  {
    "id": "s0246",
    "blockIndex": 14,
    "zh": "----5秋，上酎祭宗廟，出便門，欲御樓船。"
  },
  {
    "id": "s0247",
    "blockIndex": 14,
    "zh": "薛廣德當乘輿車，免冠頓首曰：「宜從橋。"
  },
  {
    "id": "s0248",
    "blockIndex": 14,
    "zh": "」詔曰：「大夫冠。"
  },
  {
    "id": "s0249",
    "blockIndex": 14,
    "zh": "」廣德曰：「陛下不聽臣，臣自刎，以血污車輪，陛下不得入廟矣！"
  },
  {
    "id": "s0250",
    "blockIndex": 14,
    "zh": "」上不說。"
  },
  {
    "id": "s0251",
    "blockIndex": 14,
    "zh": "先驅光祿大夫張猛進曰：「臣聞主聖臣直。"
  },
  {
    "id": "s0252",
    "blockIndex": 14,
    "zh": "乘船危，就橋安，聖主不乘危。"
  },
  {
    "id": "s0253",
    "blockIndex": 14,
    "zh": "御史大夫言可聽。"
  },
  {
    "id": "s0254",
    "blockIndex": 14,
    "zh": "」上曰：「曉人不當如是邪！"
  },
  {
    "id": "s0255",
    "blockIndex": 14,
    "zh": "」乃從橋。"
  },
  {
    "id": "s0256",
    "blockIndex": 14,
    "zh": "----6九月，隕霜殺稼，天下大饑。"
  },
  {
    "id": "s0257",
    "blockIndex": 14,
    "zh": "丞相-{于定國}-，大司馬、車騎將軍史高，御史大夫薛廣德，俱以災異乞骸骨。"
  },
  {
    "id": "s0258",
    "blockIndex": 14,
    "zh": "賜安車、駟馬、黃金六十斤，罷。"
  },
  {
    "id": "s0259",
    "blockIndex": 14,
    "zh": "太子太傅韋玄成為御史大夫。"
  },
  {
    "id": "s0260",
    "blockIndex": 14,
    "zh": "廣德歸，縣其安車，以傳示子孫為榮。"
  },
  {
    "id": "s0261",
    "blockIndex": 14,
    "zh": "----7帝之為太子也，從太中大夫孔霸受《尚書》。"
  },
  {
    "id": "s0262",
    "blockIndex": 14,
    "zh": "及即位，賜霸爵關內侯，號褒成君，給事中。"
  },
  {
    "id": "s0263",
    "blockIndex": 14,
    "zh": "上欲致霸相位，霸為人謙退，不好權勢，常稱「爵位泰過，何德以堪之！"
  },
  {
    "id": "s0264",
    "blockIndex": 14,
    "zh": "」御史大夫屢缺，上輒欲用霸；"
  },
  {
    "id": "s0265",
    "blockIndex": 14,
    "zh": "霸讓位，自陳至於再三。"
  },
  {
    "id": "s0266",
    "blockIndex": 14,
    "zh": "上深知其至誠，乃弗用。"
  },
  {
    "id": "s0267",
    "blockIndex": 14,
    "zh": "以是敬之，賞賜甚厚。"
  },
  {
    "id": "s0268",
    "blockIndex": 14,
    "zh": "----8戊子，侍中，衛尉王接為大司馬、車騎將軍。"
  },
  {
    "id": "s0269",
    "blockIndex": 14,
    "zh": "----9石顯憚周堪、張猛等，數譖毀之。"
  },
  {
    "id": "s0270",
    "blockIndex": 14,
    "zh": "劉更生懼其傾危，上書曰：「臣聞舜命九官，濟濟相讓，和之至也。"
  },
  {
    "id": "s0271",
    "blockIndex": 14,
    "zh": "眾臣和於朝則萬物和於野，故簫《韶》九成，鳳皇來儀。"
  },
  {
    "id": "s0272",
    "blockIndex": 14,
    "zh": "至周幽，厲之際，朝廷不和，轉相非怨，則日月薄食，水泉沸騰，山谷易處，霜降失節。"
  },
  {
    "id": "s0273",
    "blockIndex": 14,
    "zh": "由此觀之，和氣致祥，乖氣致異，祥多者其國安，異眾者其國危。"
  },
  {
    "id": "s0274",
    "blockIndex": 14,
    "zh": "天地之常經，古今之通義也。"
  },
  {
    "id": "s0275",
    "blockIndex": 14,
    "zh": "今陛下開三代之業，招文學之士，優遊寬容，使得並進。"
  },
  {
    "id": "s0276",
    "blockIndex": 14,
    "zh": "今賢不肖渾殽，白黑不分，邪正雜糅，忠讒並進；"
  },
  {
    "id": "s0277",
    "blockIndex": 14,
    "zh": "章交公車，人滿北軍，朝臣舛午，膠戾乖剌，更相讒訴，轉相是非；"
  },
  {
    "id": "s0278",
    "blockIndex": 14,
    "zh": "所以營惑耳目，感移心意，不可勝載，分曹為黨，往往群朋將同心以陷正臣。"
  },
  {
    "id": "s0279",
    "blockIndex": 14,
    "zh": "正臣進者，治之表也；"
  },
  {
    "id": "s0280",
    "blockIndex": 14,
    "zh": "正臣陷者，亂之機也；"
  },
  {
    "id": "s0281",
    "blockIndex": 14,
    "zh": "乘治亂之機，未知孰任，而災異數見，此臣所以寒心者也。"
  },
  {
    "id": "s0282",
    "blockIndex": 14,
    "zh": "初元以來六年矣，按春秋六年之中，災異未有稠如今者也。"
  },
  {
    "id": "s0283",
    "blockIndex": 14,
    "zh": "原其所以然者，由讒邪並進也；"
  },
  {
    "id": "s0284",
    "blockIndex": 14,
    "zh": "讒邪之所以並進者，由上多疑心，既已用賢人而行善政，如或譖之，則賢人退而善政還矣。"
  },
  {
    "id": "s0285",
    "blockIndex": 14,
    "zh": "夫執狐疑之心者，來讒賊之口；"
  },
  {
    "id": "s0286",
    "blockIndex": 14,
    "zh": "持不斷之意者，開群枉之門；"
  },
  {
    "id": "s0287",
    "blockIndex": 14,
    "zh": "讒邪進則眾賢退，群枉盛則正士消。"
  },
  {
    "id": "s0288",
    "blockIndex": 14,
    "zh": "故《易》有《否》、《泰》，小人道長，君子道消，則政日亂；"
  },
  {
    "id": "s0289",
    "blockIndex": 14,
    "zh": "君子道長，小人道消，則政日治。"
  },
  {
    "id": "s0290",
    "blockIndex": 14,
    "zh": "昔者鯀、共工、驩兜與舜、禹雜處堯朝，周公與管、蔡並居周位，當是時，迭進相毀，流言相謗，豈可勝道哉！"
  },
  {
    "id": "s0291",
    "blockIndex": 14,
    "zh": "帝堯、成王能賢舜、禹、周公而消共工、管、蔡，故以大治，榮華至今。"
  },
  {
    "id": "s0292",
    "blockIndex": 14,
    "zh": "孔子與季、孟偕仕於魯，李斯與叔孫俱宦於秦，定公、始皇賢季、孟、李斯而消孔子、叔孫，故以大亂，污辱至今。"
  },
  {
    "id": "s0293",
    "blockIndex": 14,
    "zh": "故治亂榮辱之端，在所信任；"
  },
  {
    "id": "s0294",
    "blockIndex": 14,
    "zh": "信任既賢，在於堅固而不移。"
  },
  {
    "id": "s0295",
    "blockIndex": 14,
    "zh": "《詩》云：『我心匪石，不可轉也，言守善篤也。"
  },
  {
    "id": "s0296",
    "blockIndex": 14,
    "zh": "《易》曰：『渙汗其大號』，言號令如汗，汗出而不反者也。"
  },
  {
    "id": "s0297",
    "blockIndex": 14,
    "zh": "今出善令未能逾時而反，是反汗也；"
  },
  {
    "id": "s0298",
    "blockIndex": 14,
    "zh": "用賢未能三旬而退，是轉石也。"
  },
  {
    "id": "s0299",
    "blockIndex": 14,
    "zh": "《論語》曰：『見不善如探湯。"
  },
  {
    "id": "s0300",
    "blockIndex": 14,
    "zh": "』今二府奏佞謅不當在位，歷年而不去。"
  },
  {
    "id": "s0301",
    "blockIndex": 14,
    "zh": "故出令則如反汗，用賢則如轉石，去佞則如撥山，如此，望陰陽之調，不亦難乎！"
  },
  {
    "id": "s0302",
    "blockIndex": 14,
    "zh": "是以群小窺見間隙，緣飾文字，巧言醜詆，流言、飛文嘩於民間。"
  },
  {
    "id": "s0303",
    "blockIndex": 14,
    "zh": "故《詩》云：『憂心悄悄，慍於群小，』小人成群，誠足慍也。"
  },
  {
    "id": "s0304",
    "blockIndex": 14,
    "zh": "昔孔子與顏淵、子貢更相稱譽，不為朋黨；"
  },
  {
    "id": "s0305",
    "blockIndex": 14,
    "zh": "禹、稷與皋陶傳相汲引，不為比周，何則？"
  },
  {
    "id": "s0306",
    "blockIndex": 14,
    "zh": "忠於為國，無邪心也。"
  },
  {
    "id": "s0307",
    "blockIndex": 14,
    "zh": "今佞邪與賢臣並交戟之內，合黨共謀，違善依惡，歙歙訿訿，數設危險之言，欲以傾移主上，如忽然用之，此天地之所以先戒，災異之所以重至者也。"
  },
  {
    "id": "s0308",
    "blockIndex": 14,
    "zh": "自古明聖未有無誅而治者也，故舜有四放之罰，孔子有兩觀之誅，然後聖化可得而行也。"
  },
  {
    "id": "s0309",
    "blockIndex": 14,
    "zh": "今以陛下明知，誠深思天地之心，覽《否》、《泰》之卦，歷周、唐之所進以為法，原秦、魯之所消以為戒，考祥應之福、災異之禍，以揆當世之變，放遠佞邪之黨，壞散險詖之聚，杜閉群枉之門，廣開眾正之路，決斷狐疑，分別猶豫，便是非炳然可知，則百異消滅而眾祥並至，太平之基，萬世之利也。"
  },
  {
    "id": "s0310",
    "blockIndex": 14,
    "zh": "」顯見其書，愈與許、史比而怨更生等。"
  },
  {
    "id": "s0311",
    "blockIndex": 15,
    "zh": "是歲，夏寒，日青無光，顯及許、史皆言堪、猛用事之咎。"
  },
  {
    "id": "s0312",
    "blockIndex": 15,
    "zh": "上內重堪，又患眾口之浸潤，無所取信。"
  },
  {
    "id": "s0313",
    "blockIndex": 15,
    "zh": "時長安令楊興以材能幸，常稱譽堪，上欲以為助，乃見問興：「朝臣斷斷不可光祿勳，何邪？"
  },
  {
    "id": "s0314",
    "blockIndex": 15,
    "zh": "」興者，傾巧士，謂上疑堪，因順指曰：「堪非獨不可於朝廷，自-{州里}-亦不可也！"
  },
  {
    "id": "s0315",
    "blockIndex": 15,
    "zh": "臣見眾人聞堪與劉更生等謀毀骨肉，以為當誅；"
  },
  {
    "id": "s0316",
    "blockIndex": 15,
    "zh": "故臣前書言堪不可誅傷，為國養恩也。"
  },
  {
    "id": "s0317",
    "blockIndex": 15,
    "zh": "」上曰：「然此何罪而誅？"
  },
  {
    "id": "s0318",
    "blockIndex": 15,
    "zh": "今宜奈何？"
  },
  {
    "id": "s0319",
    "blockIndex": 15,
    "zh": "」興曰：「臣愚以為可賜爵關內侯，食邑三百戶，勿令典事。"
  },
  {
    "id": "s0320",
    "blockIndex": 15,
    "zh": "明主不失師傅之恩，此最策之得者也。"
  },
  {
    "id": "s0321",
    "blockIndex": 15,
    "zh": "」上於是疑之。"
  },
  {
    "id": "s0322",
    "blockIndex": 16,
    "zh": "司隸校尉琅邪諸葛豐始以特立剛直著名於朝，數侵犯貴戚，在位多言其短。"
  },
  {
    "id": "s0323",
    "blockIndex": 16,
    "zh": "後坐春夏系治人，徙城門校尉。"
  },
  {
    "id": "s0324",
    "blockIndex": 16,
    "zh": "豐於是上書告堪、猛罪，上不直豐，乃制詔御史：「城門校尉豐，前與光祿勳、光祿大夫猛在朝之時，數稱言堪、猛之美。"
  },
  {
    "id": "s0325",
    "blockIndex": 16,
    "zh": "豐前為司隸校尉，不順四時，修法度，專作苛暴以獲虛威；"
  },
  {
    "id": "s0326",
    "blockIndex": 16,
    "zh": "朕不忍下吏，以為城門校尉。"
  },
  {
    "id": "s0327",
    "blockIndex": 16,
    "zh": "不內省諸己，而反怨堪、猛以求報舉，告按無證之辭，暴揚難驗之罪，毀譽恣意，不顧前言，不信之大也。"
  },
  {
    "id": "s0328",
    "blockIndex": 16,
    "zh": "朕憐豐之耆老，不忍加刑，其免為庶人！"
  },
  {
    "id": "s0329",
    "blockIndex": 16,
    "zh": "」又曰：「豐言堪、猛貞信不立，朕閔而不治，又惜其材能未有所效，其左遷堪為河東太守，猛槐里令。"
  },
  {
    "id": "s0331",
    "blockIndex": 17,
    "zh": ":臣光曰：諸葛豐之於堪、猛，前譽而後毀，其志非為朝廷進善而去奸也，欲比周求進而已矣。"
  },
  {
    "id": "s0332",
    "blockIndex": 17,
    "zh": "斯亦鄭朋、楊興之流，烏在其為剛直哉！"
  },
  {
    "id": "s0333",
    "blockIndex": 17,
    "zh": "人君者，察美惡，辨是非，賞以勸善，罰以懲奸，所以為治也。"
  },
  {
    "id": "s0334",
    "blockIndex": 17,
    "zh": "使豐言得實，則豐不當絀；"
  },
  {
    "id": "s0335",
    "blockIndex": 17,
    "zh": "若其誣罔，則堪、猛何辜焉！"
  },
  {
    "id": "s0336",
    "blockIndex": 17,
    "zh": "今兩責而俱棄之，則美惡、是非果安在哉！"
  },
  {
    "id": "s0337",
    "blockIndex": 17,
    "zh": "----10賈捐之與楊興善。"
  },
  {
    "id": "s0338",
    "blockIndex": 17,
    "zh": "捐之數短石顯，以故不得官，稀復進見；"
  },
  {
    "id": "s0339",
    "blockIndex": 17,
    "zh": "興新以材能得幸。"
  },
  {
    "id": "s0340",
    "blockIndex": 17,
    "zh": "捐之謂興曰：「京兆尹缺，使我得見，言君蘭，京兆尹可立得。"
  },
  {
    "id": "s0341",
    "blockIndex": 17,
    "zh": "」興曰：「君房下筆，言語妙天下；"
  },
  {
    "id": "s0342",
    "blockIndex": 17,
    "zh": "使君房為尚書令，勝五鹿充宗遠甚。"
  },
  {
    "id": "s0343",
    "blockIndex": 17,
    "zh": "」捐之曰：「令我得代充宗，君蘭為京兆，京兆，郡國首，尚書，百官本，天下真大治，士則不隔矣！"
  },
  {
    "id": "s0344",
    "blockIndex": 17,
    "zh": "」捐之復短石顯，興曰：「顯方貴，上信用之；"
  },
  {
    "id": "s0345",
    "blockIndex": 17,
    "zh": "今欲進，第從我計，且與合意，即得入矣！"
  },
  {
    "id": "s0346",
    "blockIndex": 17,
    "zh": "」捐之即與興共為薦顯奏，稱譽其美，以為宜賜爵關內侯，引其兄弟以為諸曹；"
  },
  {
    "id": "s0347",
    "blockIndex": 17,
    "zh": "又共為薦興奏，以為可試守京兆尹。"
  },
  {
    "id": "s0348",
    "blockIndex": 17,
    "zh": "石顯聞知，白之上，乃下興、捐之獄，令顯治之，奏「興，捐之懷詐偽，更相薦譽，欲得大位，罔上不道！"
  },
  {
    "id": "s0349",
    "blockIndex": 17,
    "zh": "」捐之竟坐棄市，興髡鉗為城旦。"
  },
  {
    "id": "s0350",
    "blockIndex": 18,
    "zh": ":臣光曰：君子以正攻邪，猶懼不克。"
  },
  {
    "id": "s0351",
    "blockIndex": 18,
    "zh": "況捐之以邪攻邪，其能免乎！"
  },
  {
    "id": "s0352",
    "blockIndex": 18,
    "zh": "----11徙清河王竟為中山王。"
  },
  {
    "id": "s0353",
    "blockIndex": 18,
    "zh": "----12匈奴呼韓邪單于民眾益盛，塞下禽獸盡，單于足以自衛，不畏郅支，其大臣多勸單于北歸者。"
  },
  {
    "id": "s0354",
    "blockIndex": 18,
    "zh": "久之，單于竟北歸庭，民眾稍稍歸之，其國遂定。"
  },
  {
    "id": "s0356",
    "blockIndex": 19,
    "zh": "1春，二月，赦天下。"
  },
  {
    "id": "s0357",
    "blockIndex": 19,
    "zh": "----2丁酉，御史大夫韋玄成為丞相；"
  },
  {
    "id": "s0358",
    "blockIndex": 19,
    "zh": "右扶風鄭弘為御史大夫。"
  },
  {
    "id": "s0359",
    "blockIndex": 19,
    "zh": "----3三月，壬戌朔，日有食之。"
  },
  {
    "id": "s0360",
    "blockIndex": 19,
    "zh": "----4夏，六月，赦天下。"
  },
  {
    "id": "s0361",
    "blockIndex": 19,
    "zh": "----5上問給事中匡衡以地震日食之變，衡上疏曰：「陛下躬聖德，開太平之路，閔愚吏民觸法抵禁，比年大赦，使百姓得改行自新，天下幸甚！"
  },
  {
    "id": "s0362",
    "blockIndex": 19,
    "zh": "臣竊見大赦之後，奸邪不為衰止，今日大赦，明日犯法，相隨入獄，此殆導之未得其務也。"
  },
  {
    "id": "s0363",
    "blockIndex": 19,
    "zh": "今天下俗，貪財賤義，好聲色，上侈靡，親戚之恩薄，婚姻之黨隆，苟合徼幸，以身設利；"
  },
  {
    "id": "s0364",
    "blockIndex": 19,
    "zh": "不改其原，雖歲赦之，刑猶難使錯而不用也，臣愚以為宜壹曠然大變其俗。"
  },
  {
    "id": "s0365",
    "blockIndex": 19,
    "zh": "夫朝廷者，天下之楨幹也。"
  },
  {
    "id": "s0366",
    "blockIndex": 19,
    "zh": "朝有變色之言，則下有爭鬥之患；"
  },
  {
    "id": "s0367",
    "blockIndex": 19,
    "zh": "上有自專之士，則下有不讓之人；"
  },
  {
    "id": "s0368",
    "blockIndex": 19,
    "zh": "上有克勝之佐，則下有傷害之心；"
  },
  {
    "id": "s0369",
    "blockIndex": 19,
    "zh": "上有好利之臣，則下有盜竊之民；"
  },
  {
    "id": "s0370",
    "blockIndex": 19,
    "zh": "此其本也。"
  },
  {
    "id": "s0371",
    "blockIndex": 19,
    "zh": "治天下者，審所上而已。"
  },
  {
    "id": "s0372",
    "blockIndex": 19,
    "zh": "教化之流，非家至而人說之也；"
  },
  {
    "id": "s0373",
    "blockIndex": 19,
    "zh": "賢者在位，能者布職，朝廷崇禮，百僚敬讓，道德之行，由內及外，自近者始，然後民知所法，遷善日進而不自知也。"
  },
  {
    "id": "s0374",
    "blockIndex": 19,
    "zh": "《詩》曰：『商邑翼翼，四方之極。"
  },
  {
    "id": "s0375",
    "blockIndex": 19,
    "zh": "』今長安，天子之都，親承聖化，然其習俗無以異於遠方，郡國來者無所法則，或見侈靡而放效之；"
  },
  {
    "id": "s0376",
    "blockIndex": 19,
    "zh": "此教化之原本，風俗之樞機，宜先正者也。"
  },
  {
    "id": "s0377",
    "blockIndex": 19,
    "zh": "臣聞天人之際，精祲有以相蕩，善惡有以相推，事作乎下者象動乎上，陰變則靜者動，陽蔽則明者晻，水旱之災隨類而至。"
  },
  {
    "id": "s0378",
    "blockIndex": 19,
    "zh": "陛下祗畏天戒，哀閔元元，宜省靡麗，考制度，近忠正，遠巧佞，以崇至仁，匡失俗，道德弘於京師，淑問揚乎疆外，然後大化可成，禮讓可興也。"
  },
  {
    "id": "s0379",
    "blockIndex": 19,
    "zh": "」上說其言，遷衡為光祿大夫。"
  },
  {
    "id": "s0380",
    "blockIndex": 20,
    "zh": ":荀悅論曰：夫赦者，權時之宜，非常典也。"
  },
  {
    "id": "s0381",
    "blockIndex": 20,
    "zh": "漢興，承秦兵革之後，大愚之世，比屋可刑，故設三章之法，大赦之令，蕩滌穢流，與民更始，時勢然也。"
  },
  {
    "id": "s0382",
    "blockIndex": 20,
    "zh": "後世承業，襲而不革，失時宜矣。"
  },
  {
    "id": "s0383",
    "blockIndex": 20,
    "zh": "若惠、文之世，無所赦之。"
  },
  {
    "id": "s0384",
    "blockIndex": 20,
    "zh": "若孝景之時，七國皆亂，異心並起，奸詐非一；"
  },
  {
    "id": "s0385",
    "blockIndex": 20,
    "zh": "及武帝末年，賦役繁興，群盜並起，加以太子之事，巫蠱之禍，天下紛然，百姓無聊，人不自安；"
  },
  {
    "id": "s0386",
    "blockIndex": 20,
    "zh": "及光武之際，撥亂之後：如此之比，宜為赦矣。"
  },
  {
    "id": "s0387",
    "blockIndex": 20,
    "zh": "----6秋，七月，隴西羌彡姐旁種反，詔召丞相韋玄成等入議。"
  },
  {
    "id": "s0388",
    "blockIndex": 20,
    "zh": "是時，歲比不登，朝廷方以為憂，而遭羌變，玄成等漠然，莫有對者。"
  },
  {
    "id": "s0389",
    "blockIndex": 20,
    "zh": "右將軍馮奉世曰：「羌虜近在竟內背畔，不以時誅，無以威制遠蠻，臣願帥師討之！"
  },
  {
    "id": "s0390",
    "blockIndex": 20,
    "zh": "」上問用兵之數，對曰：「臣聞善用兵者，役不再興，糧不三載，故師不久暴而天誅亟決。"
  },
  {
    "id": "s0391",
    "blockIndex": 20,
    "zh": "往者數不料敵，而師至於折傷，再三發調，則曠日煩費，威武虧矣。"
  },
  {
    "id": "s0392",
    "blockIndex": 20,
    "zh": "今反虜無慮三萬人，法當倍，用六萬人。"
  },
  {
    "id": "s0393",
    "blockIndex": 20,
    "zh": "然羌戎，弓矛之兵耳，器不犀利，可用四萬人。"
  },
  {
    "id": "s0394",
    "blockIndex": 20,
    "zh": "一月足以決。"
  },
  {
    "id": "s0395",
    "blockIndex": 20,
    "zh": "」丞相、御史、兩將軍皆以為：「民方收斂時未可多發，發萬人屯守之，且足。"
  },
  {
    "id": "s0396",
    "blockIndex": 20,
    "zh": "」奉世曰：「不可。"
  },
  {
    "id": "s0397",
    "blockIndex": 20,
    "zh": "天下被饑饉，士馬羸耗，守戰之備久廢不簡，夷狄有輕邊吏之心，而羌首難。"
  },
  {
    "id": "s0398",
    "blockIndex": 20,
    "zh": "今以萬人分屯數處，虜見兵少，必不畏懼。"
  },
  {
    "id": "s0399",
    "blockIndex": 20,
    "zh": "戰則挫兵病師，守則百姓不救，如此，怯弱之形見。"
  },
  {
    "id": "s0400",
    "blockIndex": 20,
    "zh": "羌人乘利，諸種並和，相扇而起，臣恐中國之役不得止於四萬，非財幣所能解也。"
  },
  {
    "id": "s0401",
    "blockIndex": 20,
    "zh": "故少發師而曠日，與一舉而疾決，利害相萬也。"
  },
  {
    "id": "s0402",
    "blockIndex": 20,
    "zh": "」固爭之，不能得。"
  },
  {
    "id": "s0403",
    "blockIndex": 20,
    "zh": "有詔，益二千人。"
  },
  {
    "id": "s0404",
    "blockIndex": 20,
    "zh": "於是遣奉世將萬二千人騎，以將屯為名，典屬國任立、護軍都尉韓昌為偏裨，到隴西，分屯三處。"
  },
  {
    "id": "s0405",
    "blockIndex": 20,
    "zh": "昌先遣兩校尉與羌戰，羌虜盛多，皆為所破，殺兩校尉。"
  },
  {
    "id": "s0406",
    "blockIndex": 20,
    "zh": "奉世具上地形部眾多少之計，願益三萬六千人，乃足以決事。"
  },
  {
    "id": "s0407",
    "blockIndex": 20,
    "zh": "書奏，天子大為發兵六萬餘人。"
  },
  {
    "id": "s0408",
    "blockIndex": 20,
    "zh": "八月，拜太常弋陽侯任千秋為奮武將軍以助之。"
  },
  {
    "id": "s0409",
    "blockIndex": 20,
    "zh": "冬，十月，兵畢至隴西，十一月，並進，羌虜大破，斬首數千級，餘皆走出塞。"
  },
  {
    "id": "s0410",
    "blockIndex": 20,
    "zh": "兵未決間，漢復發募士萬人，拜定襄太守韓安國為建威將軍，未進，聞羌破而還。"
  },
  {
    "id": "s0411",
    "blockIndex": 20,
    "zh": "詔罷吏士，頗留屯田，備要害處。"
  },
  {
    "id": "s0412",
    "blockIndex": 21,
    "zh": "category:資治通鑑"
  }
]
