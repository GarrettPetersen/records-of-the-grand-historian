[
  {
    "id": "s0001",
    "blockIndex": 0,
    "zh": "春，二月，大赦天下。"
  },
  {
    "id": "s0002",
    "blockIndex": 1,
    "zh": "民訛言黃龍墮死黃山宮中，百姓奔走往觀者有萬數。"
  },
  {
    "id": "s0003",
    "blockIndex": 1,
    "zh": "莽惡之，捕繫，問語所從起，不能得。"
  },
  {
    "id": "s0004",
    "blockIndex": 2,
    "zh": "單于咸既和親，求其子登屍。"
  },
  {
    "id": "s0005",
    "blockIndex": 2,
    "zh": "莽欲遣使送致，恐咸怨恨，害使者，乃收前言當誅侍子者故將軍陳欽，以他罪殺之。"
  },
  {
    "id": "s0006",
    "blockIndex": 2,
    "zh": "莽選辯士濟南王咸為大使。"
  },
  {
    "id": "s0007",
    "blockIndex": 2,
    "zh": "夏，五月，莽復遣和親侯歙與咸等送右廚唯姑夕王，因奉歸前所斬侍子登及諸貴人從者喪。"
  },
  {
    "id": "s0008",
    "blockIndex": 2,
    "zh": "單于遣雲、當子男大且渠奢等至塞迎之。"
  },
  {
    "id": "s0009",
    "blockIndex": 2,
    "zh": "咸到單于庭，陳莽威德，莽亦多遺單于金珍，因諭說改其號，號匈奴曰「恭奴」，單于曰「善於」，賜印綬，封骨都侯當為後安公，當子男奢為後安侯。"
  },
  {
    "id": "s0010",
    "blockIndex": 2,
    "zh": "單于貪莽金幣，故曲聽之，然寇盜如故。"
  },
  {
    "id": "s0011",
    "blockIndex": 3,
    "zh": "莽意以為制定則天下自平，故銳思於地理，制禮，作樂，講合《六經》之說。"
  },
  {
    "id": "s0012",
    "blockIndex": 3,
    "zh": "公卿旦入暮出，論議連年不決，不暇省獄訟冤結，民之急務。"
  },
  {
    "id": "s0013",
    "blockIndex": 3,
    "zh": "縣宰缺者數年守兼，一切貪殘日甚。"
  },
  {
    "id": "s0014",
    "blockIndex": 3,
    "zh": "中郎將、繡衣執法在郡國者，並乘權勢，傳相舉奏。"
  },
  {
    "id": "s0015",
    "blockIndex": 3,
    "zh": "又十一公士分佈勸農桑，班時令，按諸章，冠蓋相望，交錯道路，召會吏民，逮捕證左，郡縣賦斂，遞相賕賂，白黑紛然，守闕告訴者多。"
  },
  {
    "id": "s0016",
    "blockIndex": 3,
    "zh": "莽自見前顓權以得漢政，故務自攬眾事，有司受成苟免。"
  },
  {
    "id": "s0017",
    "blockIndex": 3,
    "zh": "諸寶物名、帑藏、錢穀官皆宦者領之；"
  },
  {
    "id": "s0018",
    "blockIndex": 3,
    "zh": "吏民上封事，宦官、左右開發，尚書不得知。"
  },
  {
    "id": "s0019",
    "blockIndex": 3,
    "zh": "其畏備臣下如此。"
  },
  {
    "id": "s0020",
    "blockIndex": 3,
    "zh": "又好變改制度，政令煩多，當奉行者，輒質問乃以從事，前後相乘，憒眊不渫。"
  },
  {
    "id": "s0021",
    "blockIndex": 3,
    "zh": "莽常御燈火至明，猶不能勝。"
  },
  {
    "id": "s0022",
    "blockIndex": 3,
    "zh": "尚書因是為奸，寢事，上書待報者連年不得去，拘繫郡縣者逢赦而後出，衛卒不交代者至三歲。"
  },
  {
    "id": "s0023",
    "blockIndex": 3,
    "zh": "穀糴常貴，邊兵二十餘萬人，仰衣食縣官。"
  },
  {
    "id": "s0024",
    "blockIndex": 3,
    "zh": "五原、代郡尤被其毒，起為盜賊，數千人為輩，轉入旁郡。"
  },
  {
    "id": "s0025",
    "blockIndex": 3,
    "zh": "莽遣捕盜將軍孔仁將兵與郡縣合擊，歲餘乃定。"
  },
  {
    "id": "s0026",
    "blockIndex": 4,
    "zh": "邯鄲以北大雨，水出，深者數丈，流殺數千人。"
  },
  {
    "id": "s0027",
    "blockIndex": 5,
    "zh": "春，二月，乙酉，地震，大雨雪；"
  },
  {
    "id": "s0028",
    "blockIndex": 5,
    "zh": "關東尤甚，深者一丈，竹柏或枯。"
  },
  {
    "id": "s0029",
    "blockIndex": 5,
    "zh": "大司空王邑上書，以地震乞骸骨。"
  },
  {
    "id": "s0030",
    "blockIndex": 5,
    "zh": "莽不許，曰：「夫地有動有震，震者有害，動者不害。"
  },
  {
    "id": "s0031",
    "blockIndex": 5,
    "zh": "《春秋》記地震，《易‧系》坤動。"
  },
  {
    "id": "s0032",
    "blockIndex": 5,
    "zh": "動靜辟翕，萬物生焉。"
  },
  {
    "id": "s0033",
    "blockIndex": 5,
    "zh": "」其好自誣飾，皆此類也。"
  },
  {
    "id": "s0034",
    "blockIndex": 6,
    "zh": "先是，莽以製作未定，上自公侯，下至小吏，皆不得俸祿。"
  },
  {
    "id": "s0035",
    "blockIndex": 6,
    "zh": "夏，五月，莽下書曰：「予遭陽九之厄，百六之會，國用不足，民人騷動，自公卿以下，一月之祿十稯布二匹，或帛一匹。"
  },
  {
    "id": "s0036",
    "blockIndex": 6,
    "zh": "予每念之，未嘗不戚焉。"
  },
  {
    "id": "s0037",
    "blockIndex": 6,
    "zh": "今厄會已度，府帑雖未能充，略頗稍給。"
  },
  {
    "id": "s0038",
    "blockIndex": 6,
    "zh": "其以六月朔庚寅始，賦吏祿皆如制度。"
  },
  {
    "id": "s0039",
    "blockIndex": 6,
    "zh": "」四輔、公卿、大夫、士下至輿、僚，凡十五等。"
  },
  {
    "id": "s0040",
    "blockIndex": 6,
    "zh": "僚祿一歲六十六斛，稍以差增。"
  },
  {
    "id": "s0041",
    "blockIndex": 6,
    "zh": "上至四輔而為萬斛云。"
  },
  {
    "id": "s0042",
    "blockIndex": 6,
    "zh": "莽又曰：「古者歲豐穰則充其禮，有災害則有所損，與百姓同憂喜也。"
  },
  {
    "id": "s0043",
    "blockIndex": 6,
    "zh": "其用上計時通計，天下幸無災害者，太官膳羞備其品矣；"
  },
  {
    "id": "s0044",
    "blockIndex": 6,
    "zh": "即有災害，以什率多少而損膳焉。"
  },
  {
    "id": "s0045",
    "blockIndex": 6,
    "zh": "自十一公、六司、六卿以下，各分州郡、國邑保其災害，亦以十率多少而損其祿。"
  },
  {
    "id": "s0046",
    "blockIndex": 6,
    "zh": "郎、從官、中都官吏食祿都內之委者，以太官膳羞備損而為節。"
  },
  {
    "id": "s0047",
    "blockIndex": 6,
    "zh": "冀上下同心，勸進農業，安元元焉。"
  },
  {
    "id": "s0048",
    "blockIndex": 6,
    "zh": "」莽之制度煩碎如此，課計不可理，吏終不得祿，各因官職為奸，受取賕賂以自共給焉。"
  },
  {
    "id": "s0049",
    "blockIndex": 7,
    "zh": "戊辰，長平館西岸崩，壅涇水不流，毀而北行。"
  },
  {
    "id": "s0050",
    "blockIndex": 7,
    "zh": "群臣上壽，以為《河圖》所謂「以土填水」，匈奴滅亡之祥也。"
  },
  {
    "id": "s0051",
    "blockIndex": 7,
    "zh": "莽乃遣并州牧宋弘、游擊都尉任萌等將兵擊匈奴，至邊上屯。"
  },
  {
    "id": "s0052",
    "blockIndex": 8,
    "zh": "秋，七月，辛酉，霸城門災。"
  },
  {
    "id": "s0053",
    "blockIndex": 9,
    "zh": "戊子晦，日有食之。"
  },
  {
    "id": "s0054",
    "blockIndex": 9,
    "zh": "大赦天下。"
  },
  {
    "id": "s0055",
    "blockIndex": 10,
    "zh": "平蠻將軍馮茂擊句町，士卒疾疫死者什六七，賦斂民財什取五，益州虛耗而不克；"
  },
  {
    "id": "s0056",
    "blockIndex": 10,
    "zh": "徵還，下獄死。"
  },
  {
    "id": "s0057",
    "blockIndex": 10,
    "zh": "冬，更遣寧始將軍廉丹與庸部牧史熊，大發天水、隴西騎士，廣漢、巴、蜀、犍為吏民十萬人、轉輸者合二十萬人擊之。"
  },
  {
    "id": "s0058",
    "blockIndex": 10,
    "zh": "始至，頗斬首數千；"
  },
  {
    "id": "s0059",
    "blockIndex": 10,
    "zh": "其後軍糧前後不相及，士卒饑疫。"
  },
  {
    "id": "s0060",
    "blockIndex": 10,
    "zh": "莽征丹、熊，丹、熊願益調度，必克乃還，復大賦斂。"
  },
  {
    "id": "s0061",
    "blockIndex": 10,
    "zh": "就都大尹馮英不肯給，上言：「自西南夷反叛以來，積且十年，郡縣距擊不已。"
  },
  {
    "id": "s0062",
    "blockIndex": 10,
    "zh": "續用馮茂，苟施一切之政，僰道以南，山險高深，茂多驅眾遠居，費以億計，吏士罹毒氣死者什七。"
  },
  {
    "id": "s0063",
    "blockIndex": 10,
    "zh": "今丹、熊懼於自詭，期會調發諸郡兵穀，復訾民取其什四，空破梁州，功終不遂。"
  },
  {
    "id": "s0064",
    "blockIndex": 10,
    "zh": "宜罷兵屯田，明設購賞。"
  },
  {
    "id": "s0065",
    "blockIndex": 10,
    "zh": "」莽怒，免英官；"
  },
  {
    "id": "s0066",
    "blockIndex": 10,
    "zh": "後頗覺寤，曰：「英亦未可厚非。"
  },
  {
    "id": "s0067",
    "blockIndex": 10,
    "zh": "」復以英為長沙連率。"
  },
  {
    "id": "s0068",
    "blockIndex": 10,
    "zh": "粵巂蠻夷任貴亦殺太守枚根，自立為邛谷王。"
  },
  {
    "id": "s0069",
    "blockIndex": 11,
    "zh": "翟義黨王孫慶捕得，莽使太醫、尚方與巧屠共刳剝之，量度五臧，以竹筵導其脈，知所終始，-{云}-可以治病。"
  },
  {
    "id": "s0070",
    "blockIndex": 12,
    "zh": "是歲，遣大使五威將王駿、西域都護李崇、戊己校尉郭欽出西域。"
  },
  {
    "id": "s0071",
    "blockIndex": 12,
    "zh": "諸國皆郊迎，送兵穀。"
  },
  {
    "id": "s0072",
    "blockIndex": 12,
    "zh": "駿欲襲擊之，焉耆詐降而聚兵自備，駿等將莎車、龜茲兵七千餘人分為數部，命郭欽及佐帥何封別將居後。"
  },
  {
    "id": "s0073",
    "blockIndex": 12,
    "zh": "駿等入焉耆，焉耆伏兵要遮駿，及姑墨、封犁、危須國兵為反間，還共襲駿等，皆殺之。"
  },
  {
    "id": "s0074",
    "blockIndex": 12,
    "zh": "欽、封後至焉耆，焉耆兵未還，欽襲擊，殺其老弱，從車師還入塞。"
  },
  {
    "id": "s0075",
    "blockIndex": 12,
    "zh": "莽拜欽為填外將軍，封劋鬍子；"
  },
  {
    "id": "s0076",
    "blockIndex": 12,
    "zh": "何封為集胡男。"
  },
  {
    "id": "s0077",
    "blockIndex": 12,
    "zh": "李崇收餘士，還保龜茲。"
  },
  {
    "id": "s0078",
    "blockIndex": 12,
    "zh": "及莽敗，崇沒，西域遂絕。"
  },
  {
    "id": "s0079",
    "blockIndex": 13,
    "zh": "夏，六月，莽更授諸侯茅土於明堂，親設文石之平，陳菁茅四色之土，告於岱宗、泰社、后土、先祖、先妣以班授之。"
  },
  {
    "id": "s0080",
    "blockIndex": 13,
    "zh": "莽好空言，慕古法，多封爵人，性實吝嗇，托以地理未定，故且先賦茅土，用慰喜封者。"
  },
  {
    "id": "s0081",
    "blockIndex": 14,
    "zh": "秋，八月，莽親之南郊，鑄作威鬥，以五石銅為之，若北斗，長二尺五寸，欲以厭勝眾兵。"
  },
  {
    "id": "s0082",
    "blockIndex": 14,
    "zh": "既成，令司命負之，莽出在前，入在御旁。"
  },
  {
    "id": "s0083",
    "blockIndex": 15,
    "zh": "莽置羲和命士，以督五均、六筦。"
  },
  {
    "id": "s0084",
    "blockIndex": 15,
    "zh": "郡有數人，皆用富賈為之，乘傳求利，交錯天下。"
  },
  {
    "id": "s0085",
    "blockIndex": 15,
    "zh": "因與郡縣通姦，多張空簿，府藏不實，百姓愈病。"
  },
  {
    "id": "s0086",
    "blockIndex": 15,
    "zh": "是歲，莽復下詔申明六筦，每一筦為設科條防禁，犯者罪至死。"
  },
  {
    "id": "s0087",
    "blockIndex": 15,
    "zh": "奸吏猾民並侵，眾庶各不安生，又一切調上公以下諸有奴婢者，率一口出錢三千六百，天下愈愁。"
  },
  {
    "id": "s0088",
    "blockIndex": 15,
    "zh": "納言馮常以六筦諫，莽大怒，免常官。"
  },
  {
    "id": "s0089",
    "blockIndex": 16,
    "zh": "法令煩苛，民搖手觸禁，不得耕桑，繇役煩劇，而枯旱、蝗蟲相因，獄訟不決。"
  },
  {
    "id": "s0090",
    "blockIndex": 16,
    "zh": "吏用苛暴立威，旁緣莽禁，侵刻小民，富者不自保，貧者無以自存，於是並起為盜賊，依阻山澤，吏不能禽而覆蔽之，浸淫日廣。"
  },
  {
    "id": "s0091",
    "blockIndex": 16,
    "zh": "臨淮瓜田儀等依阻會稽長州；"
  },
  {
    "id": "s0092",
    "blockIndex": 16,
    "zh": "琅邪呂母聚黨數千人，殺海曲宰，入海中為盜，其眾浸多，至萬數。"
  },
  {
    "id": "s0093",
    "blockIndex": 16,
    "zh": "荊州饑饉，民眾入野澤，掘鳧茈而食之，更相侵奪。"
  },
  {
    "id": "s0094",
    "blockIndex": 16,
    "zh": "新市人王匡、王鳳為平理諍訟，遂推為渠帥，眾數百人。"
  },
  {
    "id": "s0095",
    "blockIndex": 16,
    "zh": "於是諸亡命者南陽馬武、穎川王常、成丹等，皆往從之。"
  },
  {
    "id": "s0096",
    "blockIndex": 16,
    "zh": "共攻離鄉聚，臧於綠林山中，數月間至七八千人。"
  },
  {
    "id": "s0097",
    "blockIndex": 16,
    "zh": "又有南郡張霸、江夏羊牧等與王匡俱起，眾皆萬人。"
  },
  {
    "id": "s0098",
    "blockIndex": 16,
    "zh": "莽遣使者即赦盜賊，還言：「盜賊解輒復合，問其故，皆曰：『愁法禁煩苛，不得舉手，力作所得，不足以給貢稅；"
  },
  {
    "id": "s0099",
    "blockIndex": 16,
    "zh": "閉門自守，又坐鄰伍鑄錢挾銅，奸吏因以愁民。"
  },
  {
    "id": "s0100",
    "blockIndex": 16,
    "zh": "』民窮，悉起為盜賊。"
  },
  {
    "id": "s0101",
    "blockIndex": 16,
    "zh": "」莽大怒，免之。"
  },
  {
    "id": "s0102",
    "blockIndex": 16,
    "zh": "其或順指言「民驕黠當誅」及言「時運適然，且滅不久」，莽說，輒遷官。"
  },
  {
    "id": "s0103",
    "blockIndex": 17,
    "zh": "春，正月，朔，北軍南門災。"
  },
  {
    "id": "s0104",
    "blockIndex": 18,
    "zh": "以大司馬司允費興為荊州牧；"
  },
  {
    "id": "s0105",
    "blockIndex": 18,
    "zh": "見，問到部方略，興對曰：「荊、揚之民，率依阻山澤，以漁采為業。"
  },
  {
    "id": "s0106",
    "blockIndex": 18,
    "zh": "間者國張六筦，稅山澤，妨奪民之利，連年久旱，百姓饑窮，故為盜賊。"
  },
  {
    "id": "s0107",
    "blockIndex": 18,
    "zh": "興到部，欲令明曉告盜賊歸田裡，假貸犁牛、種食，闊其租賦，冀可以解釋安集。"
  },
  {
    "id": "s0108",
    "blockIndex": 18,
    "zh": "」莽怒，免興官。"
  },
  {
    "id": "s0109",
    "blockIndex": 19,
    "zh": "天下吏以不得俸祿，並為奸利，郡尹、縣宰家累千金。"
  },
  {
    "id": "s0110",
    "blockIndex": 19,
    "zh": "莽乃考始建國二年胡虜猾夏以來諸軍吏及緣邊吏大夫以上為奸利增產致富者，收其家所有財產五分之四以助邊急。"
  },
  {
    "id": "s0111",
    "blockIndex": 19,
    "zh": "公府士馳傳天下，考覆貪饕，關吏告其將、奴婢告其主，冀以禁奸，而奸愈甚。"
  },
  {
    "id": "s0112",
    "blockIndex": 20,
    "zh": "莽孫功崇公宗坐自畫容貌，被服天子衣冠，刻三印，發覺，自殺。"
  },
  {
    "id": "s0113",
    "blockIndex": 20,
    "zh": "宗姊妨為衛將軍王興夫人，坐祝詛姑，殺婢以絕口，與興皆自殺。"
  },
  {
    "id": "s0114",
    "blockIndex": 21,
    "zh": "是歲，揚雄卒。"
  },
  {
    "id": "s0115",
    "blockIndex": 21,
    "zh": "初，成帝之世，雄為郎，給事黃門，與莽及劉秀並列；"
  },
  {
    "id": "s0116",
    "blockIndex": 21,
    "zh": "哀帝之初，又與董賢同官。"
  },
  {
    "id": "s0117",
    "blockIndex": 21,
    "zh": "莽、賢為三公，權傾人主，所薦莫不拔擢，而雄三世不徙官。"
  },
  {
    "id": "s0118",
    "blockIndex": 21,
    "zh": "及莽篡位，雄以耆老久次，轉為大夫。"
  },
  {
    "id": "s0119",
    "blockIndex": 21,
    "zh": "恬於勢利，好古樂道，欲以文章成名於後世，乃作《大玄》以綜天、地、人之道；"
  },
  {
    "id": "s0120",
    "blockIndex": 21,
    "zh": "又見諸子各以其智舛馳，大抵詆訾聖人，即為怪迂、析辯詭辭以撓世事，雖小辯，終破大道而惑眾，使溺於所聞而不自知其非也，故人時有問雄者，常用法應之，號曰《法言》。"
  },
  {
    "id": "s0121",
    "blockIndex": 21,
    "zh": "用心於內，不求於外，於時人皆忽之；"
  },
  {
    "id": "s0122",
    "blockIndex": 21,
    "zh": "唯劉秀及范逡敬焉，而桓譚以為絕倫，巨鹿侯芭師事焉。"
  },
  {
    "id": "s0123",
    "blockIndex": 21,
    "zh": "大司空王邑、納言嚴尤聞雄死，謂桓譚曰：「子常稱揚雄書，豈能傳於後世乎？"
  },
  {
    "id": "s0124",
    "blockIndex": 21,
    "zh": "」譚曰：「必傳，顧君與譚不及見也。"
  },
  {
    "id": "s0125",
    "blockIndex": 21,
    "zh": "凡人賤近而貴遠，親見揚子雲祿位容貌不能動人，故輕其書。"
  },
  {
    "id": "s0126",
    "blockIndex": 21,
    "zh": "昔老聃著虛無之言兩篇，薄仁義，非禮學，然後好之者尚以為過於《五經》，自漢文、景之君及司馬遷皆有是言。"
  },
  {
    "id": "s0127",
    "blockIndex": 21,
    "zh": "今揚子之書文義至深，而論不詭於聖人，則必度越諸子矣！"
  },
  {
    "id": "s0129",
    "blockIndex": 22,
    "zh": "琅邪樊崇起兵於莒，眾百餘人，轉入太山。"
  },
  {
    "id": "s0130",
    "blockIndex": 22,
    "zh": "群盜以崇勇猛，皆附之，一歲間至萬餘人。"
  },
  {
    "id": "s0131",
    "blockIndex": 22,
    "zh": "崇同郡人逄安、東海人徐宣、謝祿、楊音各起兵，合數萬人，復引從崇。"
  },
  {
    "id": "s0132",
    "blockIndex": 22,
    "zh": "共還攻莒，不能下，轉掠青、徐間。"
  },
  {
    "id": "s0133",
    "blockIndex": 22,
    "zh": "又有東海刁子都，亦起兵鈔擊徐、兗。"
  },
  {
    "id": "s0134",
    "blockIndex": 22,
    "zh": "莽遣使者發郡國兵擊之，不能克。"
  },
  {
    "id": "s0135",
    "blockIndex": 23,
    "zh": "烏累單于死，弟左賢王輿立，為呼都而屍道皋若鞮單于。"
  },
  {
    "id": "s0136",
    "blockIndex": 23,
    "zh": "輿既立，貪利賞賜，遣大且渠奢與伊墨居次雲女弟之子醯櫝王，俱奉獻至長安。"
  },
  {
    "id": "s0137",
    "blockIndex": 23,
    "zh": "莽遣和親侯歙與奢等俱至制虜塞下，與雲及須卜當會；"
  },
  {
    "id": "s0138",
    "blockIndex": 23,
    "zh": "因以兵迫脅雲、當，將至長安。"
  },
  {
    "id": "s0139",
    "blockIndex": 23,
    "zh": "雲、當小男從塞下得脫，歸匈奴。"
  },
  {
    "id": "s0140",
    "blockIndex": 23,
    "zh": "當至長安，莽拜為須卜單于，欲出大兵以輔立之，兵調度亦不合。"
  },
  {
    "id": "s0141",
    "blockIndex": 23,
    "zh": "而匈奴愈怒，並入北邊為寇。"
  },
  {
    "id": "s0142",
    "blockIndex": 24,
    "zh": "春，莽見盜賊多，乃令太史推三萬六千歲曆紀，六歲一改元，布天下。"
  },
  {
    "id": "s0143",
    "blockIndex": 24,
    "zh": "下書自言己當如黃帝仙升天，欲以誑耀百姓，銷解盜賊。"
  },
  {
    "id": "s0144",
    "blockIndex": 24,
    "zh": "眾皆笑之。"
  },
  {
    "id": "s0145",
    "blockIndex": 25,
    "zh": "初獻《新樂》於明堂、太廟。"
  },
  {
    "id": "s0146",
    "blockIndex": 26,
    "zh": "更始將軍廉丹擊益州，不能克。"
  },
  {
    "id": "s0147",
    "blockIndex": 26,
    "zh": "益州夷棟蠶、若豆等起兵殺郡守，越巂夷人大牟亦叛，殺略吏人。"
  },
  {
    "id": "s0148",
    "blockIndex": 26,
    "zh": "莽召丹還，更遣大司馬護軍郭興、庸部牧李曄擊蠻夷若豆等、太傅羲叔士孫喜清潔江湖之盜賊。"
  },
  {
    "id": "s0149",
    "blockIndex": 26,
    "zh": "而匈奴寇邊甚，莽乃大募天下丁男及死罪囚、吏民奴，名曰豬突、豨勇，以為銳卒。"
  },
  {
    "id": "s0150",
    "blockIndex": 26,
    "zh": "一切稅天下吏民，訾三十取一，縑帛皆輸長安。"
  },
  {
    "id": "s0151",
    "blockIndex": 26,
    "zh": "令公卿以下至郡縣黃綬皆保養軍馬，多少各以秩為差，吏盡復以與民。"
  },
  {
    "id": "s0152",
    "blockIndex": 26,
    "zh": "又博募有奇技術可以攻匈奴者，將待以不次之位，言便宜者以萬數。"
  },
  {
    "id": "s0153",
    "blockIndex": 26,
    "zh": "或言能度水不用舟楫，連馬接騎，濟百萬師。"
  },
  {
    "id": "s0154",
    "blockIndex": 26,
    "zh": "或言不持斗糧，服食藥物，三軍不饑。"
  },
  {
    "id": "s0155",
    "blockIndex": 26,
    "zh": "或言能飛，一日千里，可窺匈奴；"
  },
  {
    "id": "s0156",
    "blockIndex": 26,
    "zh": "莽輒試之，取大鳥翮為兩翼，頭與身皆著毛，通引環紐，飛數百步墮。"
  },
  {
    "id": "s0157",
    "blockIndex": 26,
    "zh": "莽知其不可用，苟欲獲其名，皆拜為理軍，賜以車馬，待發。"
  },
  {
    "id": "s0158",
    "blockIndex": 26,
    "zh": "初，莽之欲誘迎須卜當也，大司馬嚴尤諫曰：「當在匈奴右部，兵不侵邊，單于動靜輒語中國，此方面之大助也。"
  },
  {
    "id": "s0159",
    "blockIndex": 26,
    "zh": "於今迎當置長安槁街，一胡人耳，不如在匈奴有益。"
  },
  {
    "id": "s0160",
    "blockIndex": 26,
    "zh": "」莽不聽。"
  },
  {
    "id": "s0161",
    "blockIndex": 26,
    "zh": "既得當，欲遣尤與廉丹擊匈奴，皆賜姓征氏，號二征將軍，令誅單于輿而立當代之。"
  },
  {
    "id": "s0162",
    "blockIndex": 26,
    "zh": "出車城西橫廄，未發。"
  },
  {
    "id": "s0163",
    "blockIndex": 26,
    "zh": "尤素有智略，非莽攻伐四夷，數諫不從，及當出，廷議，尤固言：「匈奴可且以為後，先憂山東盜賊。"
  },
  {
    "id": "s0164",
    "blockIndex": 26,
    "zh": "」莽大怒，策免尤。"
  },
  {
    "id": "s0165",
    "blockIndex": 27,
    "zh": "大司空議曹史代郡范升奏記王邑曰：「升聞子以人不間於其父母為孝，臣以下不非其君上為忠。"
  },
  {
    "id": "s0166",
    "blockIndex": 27,
    "zh": "今眾人咸稱朝聖，皆曰公明。"
  },
  {
    "id": "s0167",
    "blockIndex": 27,
    "zh": "蓋明者無不見，聖者無不聞。"
  },
  {
    "id": "s0168",
    "blockIndex": 27,
    "zh": "今天下之事，昭昭於日月，震震於雷霆，而朝雲不見，公雲不聞，則元元焉所呼天！"
  },
  {
    "id": "s0169",
    "blockIndex": 27,
    "zh": "公以為是而不言，則過小矣；"
  },
  {
    "id": "s0170",
    "blockIndex": 27,
    "zh": "知而從令，則過大矣。"
  },
  {
    "id": "s0171",
    "blockIndex": 27,
    "zh": "二者於公無可以免，宜乎天下歸怨於公矣。"
  },
  {
    "id": "s0172",
    "blockIndex": 27,
    "zh": "朝以遠者不服為至念，升以近者不悅為重憂。"
  },
  {
    "id": "s0173",
    "blockIndex": 27,
    "zh": "今動與時戾，事與道反，馳騖覆車之轍，踵循敗事之後，後出益可怪，晚發愈可懼耳。"
  },
  {
    "id": "s0174",
    "blockIndex": 27,
    "zh": "方春歲首而動發遠役，藜藿不充，田荒不耕，穀價騰躍，斛至數千，吏民陷於湯火之中，非國家之民也。"
  },
  {
    "id": "s0175",
    "blockIndex": 27,
    "zh": "如此，則胡、貊守闕，青、徐之寇在於帷帳矣。"
  },
  {
    "id": "s0176",
    "blockIndex": 27,
    "zh": "升有一言，可以解天下倒縣，免元元之急；"
  },
  {
    "id": "s0177",
    "blockIndex": 27,
    "zh": "不可書傳，願蒙引見，極陳所懷。"
  },
  {
    "id": "s0178",
    "blockIndex": 27,
    "zh": "」邑不聽。"
  },
  {
    "id": "s0179",
    "blockIndex": 28,
    "zh": "翼平連率田況奏郡縣訾民不實，莽復三十取一。"
  },
  {
    "id": "s0180",
    "blockIndex": 28,
    "zh": "以況忠言憂國，進爵為伯，賜錢二百萬，眾庶皆詈之。"
  },
  {
    "id": "s0181",
    "blockIndex": 28,
    "zh": "青、徐民多棄鄉里流亡，老弱死道路，壯者入賊中。"
  },
  {
    "id": "s0182",
    "blockIndex": 29,
    "zh": "夙夜連率韓博上言：「有奇士，長丈，大十圍，來至臣府，曰欲奮擊胡虜，自謂巨毋霸，出於蓬萊東南五城西北昭如海瀕，軺車不能載，三馬不能勝。"
  },
  {
    "id": "s0183",
    "blockIndex": 29,
    "zh": "即日以大車四馬，建虎旗，載霸詣闕。"
  },
  {
    "id": "s0184",
    "blockIndex": 29,
    "zh": "霸臥則枕鼓，以鐵箸食，此皇天所以輔新室也。"
  },
  {
    "id": "s0185",
    "blockIndex": 29,
    "zh": "願陛下作大甲、高車、賁育之衣，遣大將一人與虎賁百人迎之於道。"
  },
  {
    "id": "s0186",
    "blockIndex": 29,
    "zh": "京師門戶不容者，開高大之，以示百蠻，鎮安天下。"
  },
  {
    "id": "s0187",
    "blockIndex": 29,
    "zh": "」博意欲以風莽，莽聞，惡之，留霸在所新豐，更其姓曰巨母氏，謂因文母太后而霸王符也。"
  },
  {
    "id": "s0188",
    "blockIndex": 29,
    "zh": "徵博，下獄，以非所宜言，棄市。"
  },
  {
    "id": "s0189",
    "blockIndex": 30,
    "zh": "關東饑旱連年，刁子都等黨眾浸多，至六七萬。"
  },
  {
    "id": "s0190",
    "blockIndex": 31,
    "zh": "春，正月，乙未，赦天下。"
  },
  {
    "id": "s0191",
    "blockIndex": 31,
    "zh": "改元曰地皇，從三萬六千歲曆號也。"
  },
  {
    "id": "s0192",
    "blockIndex": 32,
    "zh": "莽下書曰；"
  },
  {
    "id": "s0193",
    "blockIndex": 32,
    "zh": "「方出軍行師，敢有趨讙犯法者輒論斬，毋須時！"
  },
  {
    "id": "s0194",
    "blockIndex": 32,
    "zh": "」於是春、夏斬人都市，百姓震懼，道路以目。"
  },
  {
    "id": "s0195",
    "blockIndex": 33,
    "zh": "莽見四方盜賊多，復欲厭之，又下書曰：「予之皇初祖考黃帝定天下，將兵為上將軍，內設大將，外置大司馬五人，大將軍至士吏凡七十三萬八千九百人，士千三百五十萬人。"
  },
  {
    "id": "s0196",
    "blockIndex": 33,
    "zh": "予受符命之文，稽前人，將條備焉。"
  },
  {
    "id": "s0197",
    "blockIndex": 33,
    "zh": "」於是置前、後、左、右、中大司馬之位，賜諸州牧至縣宰皆有大將軍、偏、裨、校尉之號焉。"
  },
  {
    "id": "s0198",
    "blockIndex": 33,
    "zh": "乘傳使者經歷郡國，日且十輩，倉無見穀以給；"
  },
  {
    "id": "s0199",
    "blockIndex": 33,
    "zh": "傳車馬不能足，賦取道中車馬，取辦於民。"
  },
  {
    "id": "s0200",
    "blockIndex": 34,
    "zh": "秋，七月，大風毀王路堂。"
  },
  {
    "id": "s0201",
    "blockIndex": 34,
    "zh": "莽下書曰：「乃壬午食甫時，有烈風雷雨發屋折木之變，予甚恐焉；"
  },
  {
    "id": "s0202",
    "blockIndex": 34,
    "zh": "伏念一旬，迷乃解矣。"
  },
  {
    "id": "s0203",
    "blockIndex": 34,
    "zh": "昔符命文立安為新遷王，臨國洛陽，為統義陽王，議者皆曰：『臨國洛陽為統，謂據土中為新室統也，宜為皇太子。"
  },
  {
    "id": "s0204",
    "blockIndex": 34,
    "zh": "』自此後，臨久病，雖瘳不平。"
  },
  {
    "id": "s0205",
    "blockIndex": 34,
    "zh": "臨有兄而稱太子，名不正。"
  },
  {
    "id": "s0206",
    "blockIndex": 34,
    "zh": "惟即位以來，陰陽未和，穀稼鮮耗，蠻夷猾夏，寇賊奸宄，人民徵營，無所錯手足。"
  },
  {
    "id": "s0207",
    "blockIndex": 34,
    "zh": "深惟厥咎，在名不正焉。"
  },
  {
    "id": "s0208",
    "blockIndex": 34,
    "zh": "其立安為新遷王，臨為統義陽王。"
  },
  {
    "id": "s0210",
    "blockIndex": 35,
    "zh": "莽又下書曰：「寶黃廝赤。"
  },
  {
    "id": "s0211",
    "blockIndex": 35,
    "zh": "其令郎從官皆衣絳。"
  },
  {
    "id": "s0213",
    "blockIndex": 36,
    "zh": "望氣為數者多言有土功象；"
  },
  {
    "id": "s0214",
    "blockIndex": 36,
    "zh": "九月，甲申，莽起九廟於長安城南，黃帝廟方四十丈，高十七丈，餘廟半之，制度甚盛。"
  },
  {
    "id": "s0215",
    "blockIndex": 36,
    "zh": "博徵天下工匠及吏民以義入錢穀助作者，駱驛道路；"
  },
  {
    "id": "s0216",
    "blockIndex": 36,
    "zh": "窮極百工之巧；"
  },
  {
    "id": "s0217",
    "blockIndex": 36,
    "zh": "功費數百餘萬，卒徒死者萬數。"
  },
  {
    "id": "s0218",
    "blockIndex": 37,
    "zh": "是月，大雨，六十餘日。"
  },
  {
    "id": "s0219",
    "blockIndex": 38,
    "zh": "巨鹿男子馬適求等謀舉燕、趙兵以誅莽。"
  },
  {
    "id": "s0220",
    "blockIndex": 38,
    "zh": "大司空士王丹發覺，以聞。"
  },
  {
    "id": "s0221",
    "blockIndex": 38,
    "zh": "莽遣三公大夫逮治黨與，連及郡國豪傑數千人，皆誅死。"
  },
  {
    "id": "s0222",
    "blockIndex": 38,
    "zh": "封丹為輔國侯。"
  },
  {
    "id": "s0223",
    "blockIndex": 39,
    "zh": "莽以私鑄錢死及非沮寶貨投四裔，犯法者多，不可勝行；"
  },
  {
    "id": "s0224",
    "blockIndex": 39,
    "zh": "乃更輕其法，私鑄作泉布者與妻子沒入為官奴婢，吏及比伍知而不舉告，與同罪；"
  },
  {
    "id": "s0225",
    "blockIndex": 39,
    "zh": "非沮寶貨，民罰作一歲，吏免官。"
  },
  {
    "id": "s0226",
    "blockIndex": 40,
    "zh": "太傅平晏死，以予虞唐尊為太傅。"
  },
  {
    "id": "s0227",
    "blockIndex": 40,
    "zh": "尊曰：「國虛民貧，咎在奢泰。"
  },
  {
    "id": "s0228",
    "blockIndex": 40,
    "zh": "」乃身短衣小褒，乘牝馬、柴車、藉稿，以瓦器飲食，又以歷遺公卿。"
  },
  {
    "id": "s0229",
    "blockIndex": 40,
    "zh": "出，見男女不異路者，尊自下車，以象刑赭幡污染其衣。"
  },
  {
    "id": "s0230",
    "blockIndex": 40,
    "zh": "莽聞而說之，下詔申敕公卿：「思與厥齊。"
  },
  {
    "id": "s0231",
    "blockIndex": 40,
    "zh": "」封尊為平化侯。"
  },
  {
    "id": "s0232",
    "blockIndex": 41,
    "zh": "汝南郅惲明天文歷數，以為漢必再受命，上書說莽曰：「上天垂戒，欲悟陛下，令就臣位。"
  },
  {
    "id": "s0233",
    "blockIndex": 41,
    "zh": "取之以天，還之以天，可謂知命矣！"
  },
  {
    "id": "s0234",
    "blockIndex": 41,
    "zh": "」莽大怒，繫惲詔獄，逾冬，會赦得出。"
  },
  {
    "id": "s0235",
    "blockIndex": 42,
    "zh": "春，正月，莽妻死，謚曰孝睦皇后。"
  },
  {
    "id": "s0236",
    "blockIndex": 42,
    "zh": "初，莽妻以莽數殺其子，涕泣失明；"
  },
  {
    "id": "s0237",
    "blockIndex": 42,
    "zh": "莽令太子臨居中養焉。"
  },
  {
    "id": "s0238",
    "blockIndex": 42,
    "zh": "莽妻旁侍者原碧，莽幸之，臨亦通焉，恐事洩，謀共殺莽。"
  },
  {
    "id": "s0239",
    "blockIndex": 42,
    "zh": "臨妻愔，國師公女，能為星，語臨宮中且有白衣會。"
  },
  {
    "id": "s0240",
    "blockIndex": 42,
    "zh": "臨喜，以為所謀且成；"
  },
  {
    "id": "s0241",
    "blockIndex": 42,
    "zh": "後貶為統義陽王，出在外第，愈憂恐。"
  },
  {
    "id": "s0242",
    "blockIndex": 42,
    "zh": "會莽妻病困，臨予書曰：「上於子孫至嚴，前長孫、中孫年俱三十而死。"
  },
  {
    "id": "s0243",
    "blockIndex": 42,
    "zh": "今臣臨復適三十，誠恐一旦不保中室，則不知死命所在！"
  },
  {
    "id": "s0244",
    "blockIndex": 42,
    "zh": "」莽候妻疾，見其書，大怒，疑臨有惡意，不令得會喪。"
  },
  {
    "id": "s0245",
    "blockIndex": 42,
    "zh": "既葬，收原碧等考問，具服奸、謀殺狀。"
  },
  {
    "id": "s0246",
    "blockIndex": 42,
    "zh": "莽欲秘之，使殺案事使者司命從事，埋獄中，家不知所在。"
  },
  {
    "id": "s0247",
    "blockIndex": 42,
    "zh": "賜臨藥，臨不肯飲，自刺死。"
  },
  {
    "id": "s0248",
    "blockIndex": 42,
    "zh": "又詔國師公：「臨本不知星，事從愔起。"
  },
  {
    "id": "s0249",
    "blockIndex": 42,
    "zh": "」愔亦自殺。"
  },
  {
    "id": "s0250",
    "blockIndex": 43,
    "zh": "是月，新遷王安病死。"
  },
  {
    "id": "s0251",
    "blockIndex": 43,
    "zh": "初，莽為侯就國時，幸侍者增秩、懷能，生子興、匡，皆留新都國，以其不明故也。"
  },
  {
    "id": "s0252",
    "blockIndex": 43,
    "zh": "及安死，莽乃以王車遣使者迎興、匡，封興為功修公，匡為功建公。"
  },
  {
    "id": "s0253",
    "blockIndex": 44,
    "zh": "卜者王況謂魏成大尹李焉曰：「漢家當復興，李氏為輔。"
  },
  {
    "id": "s0254",
    "blockIndex": 44,
    "zh": "」因為焉作讖書，合十餘萬言。"
  },
  {
    "id": "s0255",
    "blockIndex": 44,
    "zh": "事發，莽皆殺之。"
  },
  {
    "id": "s0256",
    "blockIndex": 45,
    "zh": "莽遣太師羲仲景尚、更始將軍護軍王黨將兵擊青、徐賊，國師和仲曹放助郭興擊句町，皆不能克。"
  },
  {
    "id": "s0257",
    "blockIndex": 45,
    "zh": "軍師放縱，百姓重困。"
  },
  {
    "id": "s0258",
    "blockIndex": 46,
    "zh": "莽又轉天下穀帛詣西河、五原、朔方、漁陽，每一郡以百萬數，欲以擊匈奴。"
  },
  {
    "id": "s0259",
    "blockIndex": 46,
    "zh": "須卜當病死，莽以庶女妻其子後安公奢，所以尊寵之甚厚，終為欲出兵立之者。"
  },
  {
    "id": "s0260",
    "blockIndex": 46,
    "zh": "會莽敗，雲、奢亦死。"
  },
  {
    "id": "s0261",
    "blockIndex": 47,
    "zh": "秋，隕霜殺菽，關東大饑，蝗。"
  },
  {
    "id": "s0262",
    "blockIndex": 48,
    "zh": "莽既輕私鑄錢之法，犯者愈眾，及伍人相坐，沒入為官奴婢。"
  },
  {
    "id": "s0263",
    "blockIndex": 48,
    "zh": "其男子檻車，女子步，以鐵瑣琅當其頸，傳詣長安鐘官以十萬數。"
  },
  {
    "id": "s0264",
    "blockIndex": 48,
    "zh": "到者易其夫婦。"
  },
  {
    "id": "s0265",
    "blockIndex": 48,
    "zh": "愁苦死者什六七。"
  },
  {
    "id": "s0266",
    "blockIndex": 49,
    "zh": "上谷儲夏自請說瓜田儀降之。"
  },
  {
    "id": "s0267",
    "blockIndex": 49,
    "zh": "儀未出而死，莽求其屍葬之，為起塚、祠室，謚曰瓜寧殤男。"
  },
  {
    "id": "s0268",
    "blockIndex": 50,
    "zh": "閏月，丙辰，大赦。"
  },
  {
    "id": "s0269",
    "blockIndex": 51,
    "zh": "郎陽成修獻符命，言繼立民母；"
  },
  {
    "id": "s0270",
    "blockIndex": 51,
    "zh": "又曰：「黃帝以百二十女致神仙。"
  },
  {
    "id": "s0271",
    "blockIndex": 51,
    "zh": "」莽於是遣中散大夫、謁者各四十五人，分行天下，博采鄉里所高有淑女者上名。"
  },
  {
    "id": "s0272",
    "blockIndex": 52,
    "zh": "莽惡漢高廟神靈，遣虎賁武士入高廟，拔劍四面提擊，斧壞戶牖，桃湯、赭鞭鞭灑屋壁，令輕車校尉居其中。"
  },
  {
    "id": "s0273",
    "blockIndex": 53,
    "zh": "是歲，南郡秦豐聚眾且萬人；"
  },
  {
    "id": "s0274",
    "blockIndex": 53,
    "zh": "平原女子遲昭平亦聚數千人在河阻中。"
  },
  {
    "id": "s0275",
    "blockIndex": 53,
    "zh": "莽召問群臣禽賊方略，皆曰：「此天囚行屍，命在漏刻。"
  },
  {
    "id": "s0276",
    "blockIndex": 53,
    "zh": "」故左將軍公孫祿徵來與議，祿曰：「太史令宗宣，典星曆，候氣變，以凶為吉，亂天文，誤朝廷；"
  },
  {
    "id": "s0277",
    "blockIndex": 53,
    "zh": "太傅平化侯尊，飾虛偽以偷名位，賊夫人之子；"
  },
  {
    "id": "s0278",
    "blockIndex": 53,
    "zh": "國師嘉信公秀，顛倒《五經》，毀師法，令學士疑惑；"
  },
  {
    "id": "s0279",
    "blockIndex": 53,
    "zh": "明學男張邯、地理侯孫陽，造井田，使民棄土業；"
  },
  {
    "id": "s0280",
    "blockIndex": 53,
    "zh": "羲和魯匡，設六筦以窮工商；"
  },
  {
    "id": "s0281",
    "blockIndex": 53,
    "zh": "說符侯崔發，阿諛取容，令下情不上通。"
  },
  {
    "id": "s0282",
    "blockIndex": 53,
    "zh": "宜誅此數子以慰天下！"
  },
  {
    "id": "s0283",
    "blockIndex": 53,
    "zh": "」又言：「匈奴不可攻，當與和親。"
  },
  {
    "id": "s0284",
    "blockIndex": 53,
    "zh": "臣恐新室憂不在匈奴，而在封域之中也。"
  },
  {
    "id": "s0285",
    "blockIndex": 53,
    "zh": "」莽怒，使虎賁扶祿出，然頗采其言，左遷魯匡為五原卒正，以百姓怨誹故也。"
  },
  {
    "id": "s0286",
    "blockIndex": 53,
    "zh": "六筦非匡所獨造，莽厭眾意而出之。"
  },
  {
    "id": "s0287",
    "blockIndex": 54,
    "zh": "初，四方皆以饑寒窮愁起為盜賊，稍稍群聚，常思歲熟得歸鄉里，眾雖萬數，不敢略有城邑，轉掠求食，日闋而已。"
  },
  {
    "id": "s0288",
    "blockIndex": 54,
    "zh": "諸長吏牧守皆自亂鬥中兵而死，賊非敢欲殺之也，而莽終不諭其故。"
  },
  {
    "id": "s0289",
    "blockIndex": 55,
    "zh": "是歲，荊州牧發奔命二萬人討綠林賊。"
  },
  {
    "id": "s0290",
    "blockIndex": 55,
    "zh": "賊帥王匡等相率迎擊於雲杜，大破牧軍，殺數千人，盡獲輜重。"
  },
  {
    "id": "s0291",
    "blockIndex": 55,
    "zh": "牧欲北歸，賊馬武等復遮擊之，鉤牧車屏泥，刺殺其驂乘，然終不敢殺牧。"
  },
  {
    "id": "s0292",
    "blockIndex": 55,
    "zh": "賊遂攻拔竟陵，轉擊雲杜、安陸，多略婦女，還入綠林中，至有五萬餘口，州郡不能制。"
  },
  {
    "id": "s0293",
    "blockIndex": 56,
    "zh": "又，大司馬士按章豫州，為賊所獲，賊送付縣。"
  },
  {
    "id": "s0294",
    "blockIndex": 56,
    "zh": "士還，上書具言狀。"
  },
  {
    "id": "s0295",
    "blockIndex": 56,
    "zh": "莽大怒，下獄，以為誣罔，因下書責七公曰：「夫吏者，理也。"
  },
  {
    "id": "s0296",
    "blockIndex": 56,
    "zh": "宣德明恩，以牧養民，仁之道也。"
  },
  {
    "id": "s0297",
    "blockIndex": 56,
    "zh": "抑強督奸，捕誅盜賊，義之節也。"
  },
  {
    "id": "s0298",
    "blockIndex": 56,
    "zh": "今則不然。"
  },
  {
    "id": "s0299",
    "blockIndex": 56,
    "zh": "盜發不輒得，至成群黨遮略乘傳宰士。"
  },
  {
    "id": "s0300",
    "blockIndex": 56,
    "zh": "士得脫者又妄自言：『我責數賊：「何故為是？"
  },
  {
    "id": "s0301",
    "blockIndex": 56,
    "zh": "」賊曰：「以貧窮故耳。"
  },
  {
    "id": "s0302",
    "blockIndex": 56,
    "zh": "」賊護出我。"
  },
  {
    "id": "s0303",
    "blockIndex": 56,
    "zh": "』今俗人議者率多若此。"
  },
  {
    "id": "s0304",
    "blockIndex": 56,
    "zh": "惟貧困饑寒犯法為非，大者群盜，小者偷穴，不過二科；"
  },
  {
    "id": "s0305",
    "blockIndex": 56,
    "zh": "今乃結謀連黨以千百數，是逆亂之大者，豈饑寒之謂邪！"
  },
  {
    "id": "s0306",
    "blockIndex": 56,
    "zh": "七公其嚴敕卿大夫、卒正、連率、庶尹，謹牧養善民，急捕殄盜賊！"
  },
  {
    "id": "s0307",
    "blockIndex": 56,
    "zh": "有不同心並力疾惡黠賊，而妄曰饑寒所為，輒捕繫，請其罪！"
  },
  {
    "id": "s0308",
    "blockIndex": 56,
    "zh": "」於是群下愈恐，莫敢言賊情者，州郡又不得擅發兵，賊由是遂不制。"
  },
  {
    "id": "s0309",
    "blockIndex": 57,
    "zh": "唯翼平連率田況素果敢，發民年十八以上四萬餘人，授以庫兵，與刻石為約。"
  },
  {
    "id": "s0310",
    "blockIndex": 57,
    "zh": "樊崇等聞之，不敢入界。"
  },
  {
    "id": "s0311",
    "blockIndex": 57,
    "zh": "況自劾奏，莽讓況：「未賜虎符而擅發兵，此弄兵也，厥罪乏興。"
  },
  {
    "id": "s0312",
    "blockIndex": 57,
    "zh": "以況自詭必禽滅賊，故且勿治。"
  },
  {
    "id": "s0313",
    "blockIndex": 57,
    "zh": "」後況自請出界擊賊，所向皆破。"
  },
  {
    "id": "s0314",
    "blockIndex": 57,
    "zh": "莽以璽書令況領青、徐二州牧事，況上言：「盜賊始發，其原甚微，部吏、伍人所能禽也。"
  },
  {
    "id": "s0315",
    "blockIndex": 57,
    "zh": "咎在長吏不為意，縣欺其郡，郡欺朝廷，實百言十，實千言百。"
  },
  {
    "id": "s0316",
    "blockIndex": 57,
    "zh": "朝廷忽略，不輒督責，遂至延蔓連州，乃遣將帥，多使者，傳相監趣。"
  },
  {
    "id": "s0317",
    "blockIndex": 57,
    "zh": "郡縣力事上官，應塞詰對，共酒食，具資用，以救斷斬，不暇復憂盜賊、治官事。"
  },
  {
    "id": "s0318",
    "blockIndex": 57,
    "zh": "將帥又不能躬率吏士，戰則為賊所破，吏氣浸傷，徒費百姓。"
  },
  {
    "id": "s0319",
    "blockIndex": 57,
    "zh": "前幸蒙赦令，賊欲解散，或反遮擊，恐入山谷，轉相告語。"
  },
  {
    "id": "s0320",
    "blockIndex": 57,
    "zh": "故郡縣降賊皆更驚駭，恐見詐滅，因饑饉易動，旬日之間更十餘萬人，此盜賊所以多之故也。"
  },
  {
    "id": "s0321",
    "blockIndex": 57,
    "zh": "今洛陽以東，米石二千，竊見詔書欲遣太師、更始將軍。"
  },
  {
    "id": "s0322",
    "blockIndex": 57,
    "zh": "二人爪牙重臣，多從人眾，道上空竭，少則無以威示遠方。"
  },
  {
    "id": "s0323",
    "blockIndex": 57,
    "zh": "宜急選牧、尹以下，明其賞罰，收合離鄉；"
  },
  {
    "id": "s0324",
    "blockIndex": 57,
    "zh": "小國無城郭者，徙其老弱置大城中，積臧穀食，並力固守。"
  },
  {
    "id": "s0325",
    "blockIndex": 57,
    "zh": "賊來攻城，則不能下；"
  },
  {
    "id": "s0326",
    "blockIndex": 57,
    "zh": "所過無食，勢不得群聚。"
  },
  {
    "id": "s0327",
    "blockIndex": 57,
    "zh": "如此，招之必降，擊之則滅。"
  },
  {
    "id": "s0328",
    "blockIndex": 57,
    "zh": "今空復多出將帥，郡縣苦之，反甚於賊。"
  },
  {
    "id": "s0329",
    "blockIndex": 57,
    "zh": "宜盡徵還乘傳諸使者以休息郡縣。"
  },
  {
    "id": "s0330",
    "blockIndex": 57,
    "zh": "委任臣況以二州盜賊，必平定之。"
  },
  {
    "id": "s0331",
    "blockIndex": 57,
    "zh": "」莽畏惡況，陰為發代，遣使者賜況璽書。"
  },
  {
    "id": "s0332",
    "blockIndex": 57,
    "zh": "使者至，見況，因令代監其兵，遣況西詣長安，拜為師尉大夫。"
  },
  {
    "id": "s0333",
    "blockIndex": 57,
    "zh": "況去，齊地遂敗。"
  },
  {
    "id": "s0334",
    "blockIndex": 58,
    "zh": "春，正月，九廟成，納神主。"
  },
  {
    "id": "s0335",
    "blockIndex": 58,
    "zh": "莽謁見，大駕乘六馬，以五采毛為龍文衣，著角，長三尺。"
  },
  {
    "id": "s0336",
    "blockIndex": 58,
    "zh": "又造華蓋九重，高八丈一尺，載以四輪車。"
  },
  {
    "id": "s0337",
    "blockIndex": 58,
    "zh": "挽者皆呼「登仙」，莽出，令在前。"
  },
  {
    "id": "s0338",
    "blockIndex": 58,
    "zh": "百官竊言：「此似輀車，非仙物也。"
  },
  {
    "id": "s0340",
    "blockIndex": 59,
    "zh": "二月，樊崇等殺景尚。"
  },
  {
    "id": "s0341",
    "blockIndex": 60,
    "zh": "關東人相食。"
  },
  {
    "id": "s0342",
    "blockIndex": 61,
    "zh": "夏，四月，遣太師王匡、更始將軍廉丹東討眾賊。"
  },
  {
    "id": "s0343",
    "blockIndex": 61,
    "zh": "初，樊崇等眾既浸盛，乃相與為約：「殺人者死，傷人者償創。"
  },
  {
    "id": "s0344",
    "blockIndex": 61,
    "zh": "」其中最尊號三老，次從事，次卒史。"
  },
  {
    "id": "s0345",
    "blockIndex": 61,
    "zh": "及聞太師、更始將討之，恐其眾與莽兵亂，乃皆朱其眉以相識別，由是號曰赤眉。"
  },
  {
    "id": "s0346",
    "blockIndex": 61,
    "zh": "匡、丹合將銳士十餘萬人，所過放縱。"
  },
  {
    "id": "s0347",
    "blockIndex": 61,
    "zh": "東方為之語曰：「寧逢赤眉，不逢太師！"
  },
  {
    "id": "s0348",
    "blockIndex": 61,
    "zh": "太師尚可，更始殺我！"
  },
  {
    "id": "s0349",
    "blockIndex": 61,
    "zh": "」卒如田況之言。"
  },
  {
    "id": "s0350",
    "blockIndex": 61,
    "zh": "莽又多遣大夫、謁者分教民煮草木為酪，酪不可食，重為煩費。"
  },
  {
    "id": "s0351",
    "blockIndex": 62,
    "zh": "綠林賊遇疾疫，死者且半，乃各分散引去。"
  },
  {
    "id": "s0352",
    "blockIndex": 62,
    "zh": "王常、成丹西入南郡，號「下江兵」；"
  },
  {
    "id": "s0353",
    "blockIndex": 62,
    "zh": "王匡、王鳳、馬武及其支黨朱鮪、張卬等北入南陽，號「新市兵」。"
  },
  {
    "id": "s0354",
    "blockIndex": 62,
    "zh": "皆自稱將軍。"
  },
  {
    "id": "s0355",
    "blockIndex": 62,
    "zh": "莽遣司命大將軍孫仁部豫州，納言大將軍嚴尤、秩宗大將軍陳茂擊荊州，各從吏士百餘人，乘傳到部募士。"
  },
  {
    "id": "s0356",
    "blockIndex": 62,
    "zh": "尤謂茂曰：「遣將不與兵符，必先請而後動，是猶紲韓盧而責之獲也。"
  },
  {
    "id": "s0358",
    "blockIndex": 63,
    "zh": "蝗從東方來，飛蔽天。"
  },
  {
    "id": "s0359",
    "blockIndex": 64,
    "zh": "流民入關者數十萬人，乃置養贍官稟食之，使者監領，與小吏共盜其稟，饑死者什七八。"
  },
  {
    "id": "s0360",
    "blockIndex": 64,
    "zh": "先是，莽使中黃門王業領長安市買，賤取於民，民甚患之。"
  },
  {
    "id": "s0361",
    "blockIndex": 64,
    "zh": "業以省費為功，賜爵附城。"
  },
  {
    "id": "s0362",
    "blockIndex": 64,
    "zh": "莽聞城中饑饉，以問業。"
  },
  {
    "id": "s0363",
    "blockIndex": 64,
    "zh": "業曰：「皆流民也。"
  },
  {
    "id": "s0364",
    "blockIndex": 64,
    "zh": "」乃市所賣粱飯、肉羹，持入示莽曰：「居民食咸如此。"
  },
  {
    "id": "s0365",
    "blockIndex": 64,
    "zh": "」莽信之。"
  },
  {
    "id": "s0366",
    "blockIndex": 65,
    "zh": "秋，七月，新市賊王匡等進攻隨；"
  },
  {
    "id": "s0367",
    "blockIndex": 65,
    "zh": "平林人陳牧、廖湛復聚眾千餘人，號「平林兵」，以應之。"
  },
  {
    "id": "s0368",
    "blockIndex": 66,
    "zh": "莽詔書讓廉丹曰：「倉廩盡矣，府庫空矣，可以怒矣，可以戰矣！"
  },
  {
    "id": "s0369",
    "blockIndex": 66,
    "zh": "將軍受國重任，不捐身於中野，無以報恩塞責！"
  },
  {
    "id": "s0370",
    "blockIndex": 66,
    "zh": "」丹惶恐，夜，召其掾馮衍，以書示之。"
  },
  {
    "id": "s0371",
    "blockIndex": 66,
    "zh": "衍因說丹曰：「張良以五世相韓，椎秦始皇博浪之中。"
  },
  {
    "id": "s0372",
    "blockIndex": 66,
    "zh": "將軍之先，為漢信臣；"
  },
  {
    "id": "s0373",
    "blockIndex": 66,
    "zh": "新室之興，英俊不附。"
  },
  {
    "id": "s0374",
    "blockIndex": 66,
    "zh": "今海內潰亂，人懷漢德，甚於詩人思召公也；"
  },
  {
    "id": "s0375",
    "blockIndex": 66,
    "zh": "人所歌舞，天必從之。"
  },
  {
    "id": "s0376",
    "blockIndex": 66,
    "zh": "方今為將軍計，莫若屯據大郡，鎮撫吏士，砥厲其節，納雄桀之士，詢忠智之謀，興社稷之利，除萬人之害，則福祿流於無窮，功烈著於不滅。"
  },
  {
    "id": "s0377",
    "blockIndex": 66,
    "zh": "何與軍覆於中原，身膏於草野，功敗名喪，恥及先祖哉！"
  },
  {
    "id": "s0378",
    "blockIndex": 66,
    "zh": "」丹不聽。"
  },
  {
    "id": "s0379",
    "blockIndex": 66,
    "zh": "衍，左將軍奉世曾孫也。"
  },
  {
    "id": "s0380",
    "blockIndex": 67,
    "zh": "冬，無鹽索盧恢等舉兵反城附賊，廉丹、王匡攻拔之，斬首萬餘級。"
  },
  {
    "id": "s0381",
    "blockIndex": 67,
    "zh": "莽遣中郎將奉璽書勞丹、匡，進爵為公；"
  },
  {
    "id": "s0382",
    "blockIndex": 67,
    "zh": "封吏士有功者十餘人。"
  },
  {
    "id": "s0383",
    "blockIndex": 67,
    "zh": "赤眉別校董憲等眾數萬人在梁郡，王匡欲進擊之。"
  },
  {
    "id": "s0384",
    "blockIndex": 67,
    "zh": "廉丹以為新拔城罷勞，當且休士養威。"
  },
  {
    "id": "s0385",
    "blockIndex": 67,
    "zh": "匡不聽，引兵獨進，丹隨之。"
  },
  {
    "id": "s0386",
    "blockIndex": 67,
    "zh": "合戰成昌，兵敗，匡走。"
  },
  {
    "id": "s0387",
    "blockIndex": 67,
    "zh": "丹使吏持其印、□、節付匡曰：「小兒可走，吾不可！"
  },
  {
    "id": "s0388",
    "blockIndex": 67,
    "zh": "」遂止，戰死。"
  },
  {
    "id": "s0389",
    "blockIndex": 67,
    "zh": "校尉汝雲、王隆等二十餘人別鬥，聞之，皆曰：「廉公已死，吾誰為生！"
  },
  {
    "id": "s0390",
    "blockIndex": 67,
    "zh": "」馳奔賊，皆戰死。"
  },
  {
    "id": "s0391",
    "blockIndex": 67,
    "zh": "國將哀章自請願平山東，莽遣章馳東與太師匡並力。"
  },
  {
    "id": "s0392",
    "blockIndex": 67,
    "zh": "又遣大將軍陽浚守敖倉；"
  },
  {
    "id": "s0393",
    "blockIndex": 67,
    "zh": "司徒王尋將十餘萬屯洛陽，鎮南宮；"
  },
  {
    "id": "s0394",
    "blockIndex": 67,
    "zh": "大司馬董忠養士習射中軍北壘。"
  },
  {
    "id": "s0395",
    "blockIndex": 67,
    "zh": "大司空王邑兼三公之職。"
  },
  {
    "id": "s0396",
    "blockIndex": 68,
    "zh": "初，長沙定王發生舂陵節侯買，買生戴侯熊渠，熊渠生考侯仁。"
  },
  {
    "id": "s0397",
    "blockIndex": 68,
    "zh": "仁以南方卑濕，徙封南陽之白水鄉，與宗族往家焉。"
  },
  {
    "id": "s0398",
    "blockIndex": 68,
    "zh": "仁卒，子敞嗣；"
  },
  {
    "id": "s0399",
    "blockIndex": 68,
    "zh": "值莽篡位，國除。"
  },
  {
    "id": "s0400",
    "blockIndex": 68,
    "zh": "節侯少子外為鬱林太守，外生巨鹿都尉回，回生南頓令欽。"
  },
  {
    "id": "s0401",
    "blockIndex": 68,
    "zh": "欽娶湖陽樊重女，生三男：縯，仲，秀，兄弟早孤，養於叔父良。"
  },
  {
    "id": "s0402",
    "blockIndex": 68,
    "zh": "縯性剛毅，慷慨有大節，自莽篡漢，常憤憤，懷復社稷之慮，不事家人居業，傾身破產，交結天下雄俊。"
  },
  {
    "id": "s0403",
    "blockIndex": 68,
    "zh": "秀隆准日角，性勤稼穡。"
  },
  {
    "id": "s0404",
    "blockIndex": 68,
    "zh": "縯常非笑之，比於高祖兄仲。"
  },
  {
    "id": "s0405",
    "blockIndex": 68,
    "zh": "秀姊元為新野鄧晨妻，秀嘗與晨俱過穰人蔡少公，少公頗學圖讖，言「劉秀當為天子」。"
  },
  {
    "id": "s0406",
    "blockIndex": 68,
    "zh": "或曰：「是國師公劉秀乎？"
  },
  {
    "id": "s0407",
    "blockIndex": 68,
    "zh": "」秀戲曰：「何用知非僕邪？"
  },
  {
    "id": "s0408",
    "blockIndex": 68,
    "zh": "」坐者皆大笑，晨心獨喜。"
  },
  {
    "id": "s0409",
    "blockIndex": 69,
    "zh": "宛人李守，好星曆、讖記，為莽宗卿師。"
  },
  {
    "id": "s0410",
    "blockIndex": 69,
    "zh": "嘗謂其子通曰：「劉氏當興，李氏為輔。"
  },
  {
    "id": "s0411",
    "blockIndex": 69,
    "zh": "」及新市、平林兵起，南陽騷動，通從弟軼謂通曰：「今四方擾亂，漢當復興。"
  },
  {
    "id": "s0412",
    "blockIndex": 69,
    "zh": "南陽宗室，獨劉伯升兄弟泛愛容眾，可與謀大事。"
  },
  {
    "id": "s0413",
    "blockIndex": 69,
    "zh": "」通笑曰：「吾意也！"
  },
  {
    "id": "s0414",
    "blockIndex": 69,
    "zh": "」會秀賣穀於宛，通遣軼往迎秀，與相見，因具言讖文事，與相約結，定謀議。"
  },
  {
    "id": "s0415",
    "blockIndex": 69,
    "zh": "通欲以立秋材官都試騎士日，劫前隊大夫甄阜及屬正梁丘賜，因以號令大眾，傳軼與秀歸舂陵舉兵以相應。"
  },
  {
    "id": "s0416",
    "blockIndex": 70,
    "zh": "於是縯召諸豪桀計議曰：「王莽暴虐，百姓分崩。"
  },
  {
    "id": "s0417",
    "blockIndex": 70,
    "zh": "今枯旱連年，兵革並起，此亦天亡之時，復高祖之業，定萬世之秋也！"
  },
  {
    "id": "s0418",
    "blockIndex": 70,
    "zh": "」眾皆然之。"
  },
  {
    "id": "s0419",
    "blockIndex": 70,
    "zh": "於是分遣親客於諸縣起兵，縯自發舂陵子弟。"
  },
  {
    "id": "s0420",
    "blockIndex": 70,
    "zh": "諸家子弟恐懼，皆亡匿，曰；"
  },
  {
    "id": "s0421",
    "blockIndex": 70,
    "zh": "「伯升殺我！"
  },
  {
    "id": "s0422",
    "blockIndex": 70,
    "zh": "」及見秀絳衣大冠，皆驚曰：「謹厚者亦復為之！"
  },
  {
    "id": "s0423",
    "blockIndex": 70,
    "zh": "」乃稍自安。"
  },
  {
    "id": "s0424",
    "blockIndex": 70,
    "zh": "凡得子弟七八千人，部署賓客，自稱「柱天都部」。"
  },
  {
    "id": "s0425",
    "blockIndex": 70,
    "zh": "秀時年二十八。"
  },
  {
    "id": "s0426",
    "blockIndex": 70,
    "zh": "李通未發，事覺，亡走；"
  },
  {
    "id": "s0427",
    "blockIndex": 70,
    "zh": "父守及家屬坐死者六十四人。"
  },
  {
    "id": "s0428",
    "blockIndex": 70,
    "zh": "縯使族人嘉招說新市、平林兵，與其帥王鳳、陳牧西擊長聚；"
  },
  {
    "id": "s0429",
    "blockIndex": 70,
    "zh": "進屠唐子鄉，又殺湖陽尉。"
  },
  {
    "id": "s0430",
    "blockIndex": 70,
    "zh": "軍中分財物不均，眾恚恨，欲反攻諸劉。"
  },
  {
    "id": "s0431",
    "blockIndex": 70,
    "zh": "秀斂宗人所得物，悉以與之，眾乃悅。"
  },
  {
    "id": "s0432",
    "blockIndex": 70,
    "zh": "進拔棘陽，李軼、鄧晨皆將賓客來會。"
  },
  {
    "id": "s0433",
    "blockIndex": 71,
    "zh": "嚴尤、陳茂破下江兵。"
  },
  {
    "id": "s0434",
    "blockIndex": 71,
    "zh": "成丹、王常、張卬等收散卒入蔞谿，略鐘、龍間，眾復振。"
  },
  {
    "id": "s0435",
    "blockIndex": 71,
    "zh": "引軍與荊州牧戰於上唐，大破之。"
  },
  {
    "id": "s0436",
    "blockIndex": 72,
    "zh": "十一月，有星孛於張。"
  },
  {
    "id": "s0437",
    "blockIndex": 73,
    "zh": "劉縯欲進攻宛，至小長安聚，與甄阜、梁丘賜戰。"
  },
  {
    "id": "s0438",
    "blockIndex": 73,
    "zh": "時天密霧，漢軍大敗。"
  },
  {
    "id": "s0439",
    "blockIndex": 73,
    "zh": "秀單馬走，遇女弟伯姬，與共騎而奔。"
  },
  {
    "id": "s0440",
    "blockIndex": 73,
    "zh": "前行，復見姊元，趣令上馬，元以手揮曰：「行矣，不能相救，無為兩沒也！"
  },
  {
    "id": "s0441",
    "blockIndex": 73,
    "zh": "」會追兵至，元及三女皆死，縯弟仲及宗從死者數十人。"
  },
  {
    "id": "s0442",
    "blockIndex": 73,
    "zh": "縯復收會兵眾，還保棘陽。"
  },
  {
    "id": "s0443",
    "blockIndex": 73,
    "zh": "阜、賜乘勝留輜重於藍鄉，引精兵十萬南度潢淳，臨沘水，阻兩川間為營，絕後橋，示無還心。"
  },
  {
    "id": "s0444",
    "blockIndex": 73,
    "zh": "新市、平林見漢兵數敗，阜、賜軍大至，各欲解去，縯甚患之。"
  },
  {
    "id": "s0445",
    "blockIndex": 73,
    "zh": "會下江兵五千餘人至宜秋，褲縯即與秀及李通俱造其壁曰：「願見下江一賢將，議大事。"
  },
  {
    "id": "s0446",
    "blockIndex": 73,
    "zh": "」眾推王常。"
  },
  {
    "id": "s0447",
    "blockIndex": 73,
    "zh": "縯見常，說以合從之利，常大悟曰：「王莽殘虐，百姓思漢。"
  },
  {
    "id": "s0448",
    "blockIndex": 73,
    "zh": "今劉氏復興，即真主也；"
  },
  {
    "id": "s0449",
    "blockIndex": 73,
    "zh": "誠思出身為用，輔成大功。"
  },
  {
    "id": "s0450",
    "blockIndex": 73,
    "zh": "」縯曰：「如事成，豈敢獨饗之哉！"
  },
  {
    "id": "s0451",
    "blockIndex": 73,
    "zh": "」遂與常深相結而去。"
  },
  {
    "id": "s0452",
    "blockIndex": 73,
    "zh": "常還，具為餘將成丹、張卬言之。"
  },
  {
    "id": "s0453",
    "blockIndex": 73,
    "zh": "丹、卬負其眾曰：「大丈夫既起，當各自為主，何故受人制乎！"
  },
  {
    "id": "s0454",
    "blockIndex": 73,
    "zh": "」常乃徐曉說其將帥曰：「王莽苛酷，積失百姓之心，民之謳吟思漢，非一日也，故使吾屬因此得起。"
  },
  {
    "id": "s0455",
    "blockIndex": 73,
    "zh": "夫民所怨者，天所去也；"
  },
  {
    "id": "s0456",
    "blockIndex": 73,
    "zh": "民所思者，天所與也。"
  },
  {
    "id": "s0457",
    "blockIndex": 73,
    "zh": "舉大事，必當下順民心，上合天意，功乃可成。"
  },
  {
    "id": "s0458",
    "blockIndex": 73,
    "zh": "若負強恃勇，觸情恣欲，雖得天下，必復失之。"
  },
  {
    "id": "s0459",
    "blockIndex": 73,
    "zh": "以秦、項之勢，尚至夷覆，況今布衣相聚草澤，以此行之，滅亡之道也。"
  },
  {
    "id": "s0460",
    "blockIndex": 73,
    "zh": "今南陽諸劉舉宗起兵，觀其來議者，皆有深計大慮，王公之才，與之併合，必成大功，此天所以祐吾屬也！"
  },
  {
    "id": "s0461",
    "blockIndex": 73,
    "zh": "」下江諸將雖屈強少識，然素敬常，乃皆謝曰：「無王將軍，吾屬幾陷於不義！"
  },
  {
    "id": "s0462",
    "blockIndex": 73,
    "zh": "」即引兵與漢軍及新市、平林合。"
  },
  {
    "id": "s0463",
    "blockIndex": 73,
    "zh": "於是諸部齊心同力，銳氣益壯。"
  },
  {
    "id": "s0464",
    "blockIndex": 73,
    "zh": "縯大饗軍士，設盟約，休卒三日，分為六部。"
  },
  {
    "id": "s0465",
    "blockIndex": 73,
    "zh": "十二月，晦，潛師夜起，襲取藍鄉，盡獲其輜重。"
  },
