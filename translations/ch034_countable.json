[
  {
    "id": "s0001",
    "blockIndex": 0,
    "zh": "資治通鑑第034卷"
  },
  {
    "id": "s0002",
    "blockIndex": 1,
    "zh": "【漢紀二十六】起柔兆執徐，盡著雍敦牂，凡三年。"
  },
  {
    "id": "s0003",
    "blockIndex": 2,
    "zh": "春，正月，有星孛於牽牛。"
  },
  {
    "id": "s0004",
    "blockIndex": 3,
    "zh": "丁、傅宗族驕奢，皆嫉傅喜之恭儉。"
  },
  {
    "id": "s0005",
    "blockIndex": 3,
    "zh": "又，傅太后欲求稱尊號，與成帝母齊尊；"
  },
  {
    "id": "s0006",
    "blockIndex": 3,
    "zh": "喜與孔光、師丹共執以為不可。"
  },
  {
    "id": "s0007",
    "blockIndex": 3,
    "zh": "上重違大臣正議，又內迫傅太后，依違者連歲。"
  },
  {
    "id": "s0008",
    "blockIndex": 3,
    "zh": "傅太后大怒，上不得已，先免師丹以感動喜。"
  },
  {
    "id": "s0009",
    "blockIndex": 3,
    "zh": "喜終不順。"
  },
  {
    "id": "s0010",
    "blockIndex": 3,
    "zh": "朱博與孔鄉侯傅晏連結，共謀成尊號事，數燕見，奏封事，毀短喜及孔光。"
  },
  {
    "id": "s0011",
    "blockIndex": 3,
    "zh": "丁丑，上遂策免喜，以侯就第。"
  },
  {
    "id": "s0012",
    "blockIndex": 4,
    "zh": "御史大夫官既罷，議者多以為古今異制，漢自天子之號下至佐史，皆不同於古，而獨改三公，職事難分明，無益於治亂。"
  },
  {
    "id": "s0013",
    "blockIndex": 4,
    "zh": "於是朱博奏言：「故事：選郡國守相高第為中二千石，選中二千石為御史大夫，任職者為丞相；"
  },
  {
    "id": "s0014",
    "blockIndex": 4,
    "zh": "位次有序，所以尊聖德，重國相也。"
  },
  {
    "id": "s0015",
    "blockIndex": 4,
    "zh": "今中二千石未更御史大夫而為丞相，權輕，非所以重國政也。"
  },
  {
    "id": "s0016",
    "blockIndex": 4,
    "zh": "臣愚以為大司空官可罷，復置御史大夫，遵奉舊制。"
  },
  {
    "id": "s0017",
    "blockIndex": 4,
    "zh": "臣願盡力以御史大夫為百僚率！"
  },
  {
    "id": "s0018",
    "blockIndex": 4,
    "zh": "」上從之。"
  },
  {
    "id": "s0019",
    "blockIndex": 4,
    "zh": "夏，四月，戊午，更拜博為御史大夫。"
  },
  {
    "id": "s0020",
    "blockIndex": 4,
    "zh": "又以丁太后兄陽安侯明為大司馬、衛將軍，置官屬；"
  },
  {
    "id": "s0021",
    "blockIndex": 4,
    "zh": "大司馬冠號如故事。"
  },
  {
    "id": "s0022",
    "blockIndex": 5,
    "zh": "傅太后又自詔丞相、御史大夫曰：「高武侯喜附下罔上，與故大司空丹同心背畔，放命圮族，不宜奉朝請，其遣就國。"
  },
  {
    "id": "s0024",
    "blockIndex": 6,
    "zh": "丞相孔光，自先帝時議繼嗣，有持異之隙，又重忤傅太后指。"
  },
  {
    "id": "s0025",
    "blockIndex": 6,
    "zh": "由是傅氏在位者與朱博為表裡，共毀譖光。"
  },
  {
    "id": "s0026",
    "blockIndex": 6,
    "zh": "乙亥，策免光為庶人。"
  },
  {
    "id": "s0027",
    "blockIndex": 6,
    "zh": "以御史大夫朱博為丞相，封陽鄉侯；"
  },
  {
    "id": "s0028",
    "blockIndex": 6,
    "zh": "少府趙玄為御史大夫。"
  },
  {
    "id": "s0029",
    "blockIndex": 6,
    "zh": "臨延登受策，有大聲如鐘鳴，殿中郎吏陛者皆聞焉。"
  },
  {
    "id": "s0030",
    "blockIndex": 6,
    "zh": "上以問黃門侍郎蜀郡揚雄及李尋。"
  },
  {
    "id": "s0031",
    "blockIndex": 6,
    "zh": "尋對曰：「此《洪範》所謂鼓妖者也。"
  },
  {
    "id": "s0032",
    "blockIndex": 6,
    "zh": "師法，以為人君不聰，為眾所惑，空名得進，則有聲無形，不知所從生。"
  },
  {
    "id": "s0033",
    "blockIndex": 6,
    "zh": "其《傳》曰：『歲、月、日之中，則正卿受之。"
  },
  {
    "id": "s0034",
    "blockIndex": 6,
    "zh": "』今以四月日加辰、巳有異，是為中焉。"
  },
  {
    "id": "s0035",
    "blockIndex": 6,
    "zh": "正卿，謂執政大臣也。"
  },
  {
    "id": "s0036",
    "blockIndex": 6,
    "zh": "宜退丞相、御史，以應天變。"
  },
  {
    "id": "s0037",
    "blockIndex": 6,
    "zh": "然雖不退，不出期年，其人自蒙其咎。"
  },
  {
    "id": "s0038",
    "blockIndex": 6,
    "zh": "」揚雄亦以為：「鼓妖，聽失之象也。"
  },
  {
    "id": "s0039",
    "blockIndex": 6,
    "zh": "朱博為人強毅，多權謀，宜將不宜相，恐有凶惡亟疾之怒。"
  },
  {
    "id": "s0040",
    "blockIndex": 6,
    "zh": "」上不聽。"
  },
  {
    "id": "s0041",
    "blockIndex": 7,
    "zh": "朱博既為丞相，上遂用其議，下詔曰：「定陶共皇之號，不宜復稱定陶。"
  },
  {
    "id": "s0042",
    "blockIndex": 7,
    "zh": "尊共皇太后曰帝太太后，稱永信宮；"
  },
  {
    "id": "s0043",
    "blockIndex": 7,
    "zh": "共皇后曰帝太后，稱中安宮；"
  },
  {
    "id": "s0044",
    "blockIndex": 7,
    "zh": "為共皇立寢廟於京師，比宣帝父悼皇考制度。"
  },
  {
    "id": "s0045",
    "blockIndex": 7,
    "zh": "」於是四太后各置少府、太僕，秩皆中二千石。"
  },
  {
    "id": "s0046",
    "blockIndex": 7,
    "zh": "傅太后既尊後。"
  },
  {
    "id": "s0047",
    "blockIndex": 7,
    "zh": "尤驕，與太皇太后語，至謂之「嫗」。"
  },
  {
    "id": "s0048",
    "blockIndex": 7,
    "zh": "時丁、傅以一二年間暴興尤盛，為公卿列侯者甚眾。"
  },
  {
    "id": "s0049",
    "blockIndex": 7,
    "zh": "然帝不甚假以權勢，不如王氏在成帝世也。"
  },
  {
    "id": "s0050",
    "blockIndex": 8,
    "zh": "丞相博、御史大夫玄奏言：「前高昌侯宏，首建尊號之議，而為關內侯師丹所劾奏，免為庶人。"
  },
  {
    "id": "s0051",
    "blockIndex": 8,
    "zh": "時天下衰粗，委政於丹，丹不深惟褒廣尊號之義，而妄稱說，抑貶尊號，虧損孝道，不忠莫大焉！"
  },
  {
    "id": "s0052",
    "blockIndex": 8,
    "zh": "陛下仁聖，昭然定尊號，宏以忠孝復封高昌侯；"
  },
  {
    "id": "s0053",
    "blockIndex": 8,
    "zh": "丹惡逆暴著，雖蒙赦令，不宜有爵邑，請免為庶人。"
  },
  {
    "id": "s0054",
    "blockIndex": 8,
    "zh": "」奏可。"
  },
  {
    "id": "s0055",
    "blockIndex": 8,
    "zh": "又奏：「新都侯王莽前為大司馬，不廣尊尊之義，抑貶尊號，虧損孝道，當伏顯戮。"
  },
  {
    "id": "s0056",
    "blockIndex": 8,
    "zh": "幸蒙赦令，不宜有爵土，請免為庶人。"
  },
  {
    "id": "s0057",
    "blockIndex": 8,
    "zh": "」上曰：「以莽與太皇太后有屬，勿免，遣就國。"
  },
  {
    "id": "s0058",
    "blockIndex": 8,
    "zh": "」及平阿侯仁臧匿趙昭儀親屬，皆遣就國。"
  },
  {
    "id": "s0059",
    "blockIndex": 9,
    "zh": "天下多冤王氏者。"
  },
  {
    "id": "s0060",
    "blockIndex": 9,
    "zh": "諫大夫楊宣上封事言：「孝成皇帝深惟宗廟之重，稱述陛下至德以承天序，聖策深遠，恩德至厚。"
  },
  {
    "id": "s0061",
    "blockIndex": 9,
    "zh": "惟念先帝之意，豈不欲以陛下自代，奉承東宮哉！"
  },
  {
    "id": "s0062",
    "blockIndex": 9,
    "zh": "太皇太后春秋七十，數更憂傷，敕令親屬引領以避丁、傅，行道之人為之隕涕，況於陛下！"
  },
  {
    "id": "s0063",
    "blockIndex": 9,
    "zh": "時登高遠望，獨不慚於延陵乎！"
  },
  {
    "id": "s0064",
    "blockIndex": 9,
    "zh": "」帝深感其言，復封成都侯商中子邑為成都侯。"
  },
  {
    "id": "s0065",
    "blockIndex": 10,
    "zh": "朱博又奏言：「漢家故事，置部刺史，秩卑而賞厚，鹹勸功樂進。"
  },
  {
    "id": "s0066",
    "blockIndex": 10,
    "zh": "前罷刺史，更置州牧，秩真二千石，位次九卿；"
  },
  {
    "id": "s0067",
    "blockIndex": 10,
    "zh": "九卿缺，以高第補；"
  },
  {
    "id": "s0068",
    "blockIndex": 10,
    "zh": "其中材則苟自守而已。"
  },
  {
    "id": "s0069",
    "blockIndex": 10,
    "zh": "恐功效陵夷，奸軌不禁。"
  },
  {
    "id": "s0070",
    "blockIndex": 10,
    "zh": "臣請罷州牧，置刺史如故。"
  },
  {
    "id": "s0071",
    "blockIndex": 10,
    "zh": "」上從之。"
  },
  {
    "id": "s0072",
    "blockIndex": 10,
    "zh": "六月，庚申，帝太后丁氏崩，詔歸葬定陶共皇之園，發陳留、濟陰近郡國五萬人穿復土。"
  },
  {
    "id": "s0073",
    "blockIndex": 11,
    "zh": "初，成帝時，齊人甘忠可詐造《天官歷》、《包元太平經》十二卷，言漢家逢天地之大終，當更受命於天，以教渤海夏賀良等。"
  },
  {
    "id": "s0074",
    "blockIndex": 11,
    "zh": "中壘校尉劉向奏忠可假鬼神，罔上惑眾；"
  },
  {
    "id": "s0075",
    "blockIndex": 11,
    "zh": "下獄，治服；"
  },
  {
    "id": "s0076",
    "blockIndex": 11,
    "zh": "未斷，病死。"
  },
  {
    "id": "s0077",
    "blockIndex": 11,
    "zh": "賀良等復私以相教。"
  },
  {
    "id": "s0078",
    "blockIndex": 11,
    "zh": "上即位，司隸校尉解光、騎都尉李尋白賀良等，皆待詔黃門。"
  },
  {
    "id": "s0079",
    "blockIndex": 11,
    "zh": "數召見，陳說「漢歷中衰，當更受命。"
  },
  {
    "id": "s0080",
    "blockIndex": 11,
    "zh": "成帝不應天命，故絕嗣。"
  },
  {
    "id": "s0081",
    "blockIndex": 11,
    "zh": "今陛下久疾，變異屢數，天所以譴告人也。"
  },
  {
    "id": "s0082",
    "blockIndex": 11,
    "zh": "宜急改元易號，乃得延年益壽，皇子生，災異息矣。"
  },
  {
    "id": "s0083",
    "blockIndex": 11,
    "zh": "得道不得行，咎殃且無不有，洪水將出，災火且起，滌蕩民人。"
  },
  {
    "id": "s0084",
    "blockIndex": 11,
    "zh": "」上久寢疾，冀其有益，遂從賀良等議，詔大赦天下，以建平二年為太初元年，號曰「陳聖劉太平皇帝」，漏刻以百二十為度。"
  },
  {
    "id": "s0085",
    "blockIndex": 12,
    "zh": "秋，七月，以渭城西北原上永陵亭部為初陵，勿徙郡國民。"
  },
  {
    "id": "s0086",
    "blockIndex": 13,
    "zh": "上既改號月餘，寢疾自若。"
  },
  {
    "id": "s0087",
    "blockIndex": 13,
    "zh": "夏賀良等復欲妄變政事，大臣爭以為不可許。"
  },
  {
    "id": "s0088",
    "blockIndex": 13,
    "zh": "賀良等奏言：「大臣皆不知天命，宜退丞相、御史，以解光、李尋輔政。"
  },
  {
    "id": "s0089",
    "blockIndex": 13,
    "zh": "」上以其言無驗，八月，詔曰：「待詔賀良等建言改元易號，增益漏刻，可以永安國家。"
  },
  {
    "id": "s0090",
    "blockIndex": 13,
    "zh": "朕信道不篤，過聽其言，冀為百姓獲福，卒無嘉應。"
  },
  {
    "id": "s0091",
    "blockIndex": 13,
    "zh": "夫過而不改，是謂過矣！"
  },
  {
    "id": "s0092",
    "blockIndex": 13,
    "zh": "六月甲子詔書，非赦令，皆蠲除之。"
  },
  {
    "id": "s0093",
    "blockIndex": 13,
    "zh": "賀良等反道惑眾，奸態當窮竟。"
  },
  {
    "id": "s0094",
    "blockIndex": 13,
    "zh": "」皆下獄，伏誅。"
  },
  {
    "id": "s0095",
    "blockIndex": 13,
    "zh": "尋及解光減死一等，徙敦煌郡。"
  },
  {
    "id": "s0096",
    "blockIndex": 14,
    "zh": "上以寢疾，盡復前世所嘗興諸神祠凡七百餘所，一歲三萬七千祠雲。"
  },
  {
    "id": "s0097",
    "blockIndex": 15,
    "zh": "傅太后怨傅喜不已，使孔鄉侯晏風丞相朱博令奏免喜侯。"
  },
  {
    "id": "s0098",
    "blockIndex": 15,
    "zh": "博與御史大夫趙玄議之，玄言：「事已前決，得無不宜？"
  },
  {
    "id": "s0099",
    "blockIndex": 15,
    "zh": "」博曰：「已許孔鄉侯矣。"
  },
  {
    "id": "s0100",
    "blockIndex": 15,
    "zh": "匹夫相要，尚相得死，何況至尊！"
  },
  {
    "id": "s0101",
    "blockIndex": 15,
    "zh": "博唯有死耳！"
  },
  {
    "id": "s0102",
    "blockIndex": 15,
    "zh": "」玄即許可。"
  },
  {
    "id": "s0103",
    "blockIndex": 15,
    "zh": "博惡獨斥奏喜，以故大司空汜鄉侯何武前亦坐過免就國，事與喜相似，即並奏：「喜、武前在位，皆無益於治，雖已退免，爵土之封，非所當也。"
  },
  {
    "id": "s0104",
    "blockIndex": 15,
    "zh": "皆請免為庶人。"
  },
  {
    "id": "s0105",
    "blockIndex": 15,
    "zh": "」上知傅太后素嘗怨喜，疑博、玄承指，即召玄詣尚書問狀，玄辭服。"
  },
  {
    "id": "s0106",
    "blockIndex": 15,
    "zh": "有詔：「左將軍彭宣與中朝者雜問」，宣等奏劾「博、玄、晏皆不道，不敬，請召詣廷尉詔獄」。"
  },
  {
    "id": "s0107",
    "blockIndex": 15,
    "zh": "上減玄死罪三等；"
  },
  {
    "id": "s0108",
    "blockIndex": 15,
    "zh": "削晏戶四分之一；"
  },
  {
    "id": "s0109",
    "blockIndex": 15,
    "zh": "假謁者節召丞相詣廷尉，博自殺，國除。"
  },
  {
    "id": "s0110",
    "blockIndex": 16,
    "zh": "九月，以光祿勳平當為御史大夫；"
  },
  {
    "id": "s0111",
    "blockIndex": 16,
    "zh": "冬，十月，甲寅，遷為丞相；"
  },
  {
    "id": "s0112",
    "blockIndex": 16,
    "zh": "以冬月故，且賜爵關內侯。"
  },
  {
    "id": "s0113",
    "blockIndex": 16,
    "zh": "以京兆尹平陵王喜為御史大夫。"
  },
  {
    "id": "s0114",
    "blockIndex": 17,
    "zh": "上欲令丁、傅處爪牙官，是歲，策免左將軍淮陽彭宣，以關內侯歸家，而以光祿勳丁望代為左將軍。"
  },
  {
    "id": "s0115",
    "blockIndex": 18,
    "zh": "烏孫卑爰疐侵盜匈奴西界，單于遣兵擊之，殺數百人，略千餘人，驅牛畜去。"
  },
  {
    "id": "s0116",
    "blockIndex": 18,
    "zh": "卑爰疐恐，遣子趨逯為質匈奴，單于受，以狀聞。"
  },
  {
    "id": "s0117",
    "blockIndex": 18,
    "zh": "漢遣使者責讓單于，告令還歸卑爰疐質子。"
  },
  {
    "id": "s0118",
    "blockIndex": 18,
    "zh": "單于受詔遣歸。"
  },
  {
    "id": "s0119",
    "blockIndex": 19,
    "zh": "春，正月，立廣德夷王弟廣漢為廣平王。"
  },
  {
    "id": "s0120",
    "blockIndex": 20,
    "zh": "癸卯，帝太太后所居桂宮正殿火。"
  },
  {
    "id": "s0121",
    "blockIndex": 21,
    "zh": "上使使者召丞相平當，欲封之。"
  },
  {
    "id": "s0122",
    "blockIndex": 21,
    "zh": "當病篤，不應召。"
  },
  {
    "id": "s0123",
    "blockIndex": 21,
    "zh": "室家或謂當：「不可強起受侯印為子孫邪？"
  },
  {
    "id": "s0124",
    "blockIndex": 21,
    "zh": "」當日：「吾居大位，已負素餐責矣。"
  },
  {
    "id": "s0125",
    "blockIndex": 21,
    "zh": "起受侯印，還臥而死，死有餘罪。"
  },
  {
    "id": "s0126",
    "blockIndex": 21,
    "zh": "今不起者，所以為子孫也！"
  },
  {
    "id": "s0127",
    "blockIndex": 21,
    "zh": "」遂上書乞骸骨，上不許。"
  },
  {
    "id": "s0128",
    "blockIndex": 21,
    "zh": "三月，己酉，當薨。"
  },
  {
    "id": "s0129",
    "blockIndex": 22,
    "zh": "有星孛於河鼓。"
  },
  {
    "id": "s0130",
    "blockIndex": 23,
    "zh": "夏，四月，丁酉，王嘉為丞相，河南太守王崇為御史大夫。"
  },
  {
    "id": "s0131",
    "blockIndex": 23,
    "zh": "崇，京兆尹駿之子也。"
  },
  {
    "id": "s0132",
    "blockIndex": 23,
    "zh": "嘉以時政苛急，郡國守相數有變動，乃上疏曰：「臣聞聖王之功在於得人。"
  },
  {
    "id": "s0133",
    "blockIndex": 23,
    "zh": "孔子曰：『材難，不其然與！"
  },
  {
    "id": "s0134",
    "blockIndex": 23,
    "zh": "』故繼世立諸侯，像賢也。"
  },
  {
    "id": "s0135",
    "blockIndex": 23,
    "zh": "雖不能盡賢，天子為擇臣、立命卿以輔之。"
  },
  {
    "id": "s0136",
    "blockIndex": 23,
    "zh": "居是國也，累世尊重，然後士民之眾附焉。"
  },
  {
    "id": "s0137",
    "blockIndex": 23,
    "zh": "是以教化行而治功立。"
  },
  {
    "id": "s0138",
    "blockIndex": 23,
    "zh": "今之郡守重於古諸侯，往者致選賢材，賢材難得，拔擢可用者，或起於囚徒。"
  },
  {
    "id": "s0139",
    "blockIndex": 23,
    "zh": "昔魏尚坐事系，文帝感馮唐之言，遺使持節赦其罪，拜為雲中太守，匈奴忌之。"
  },
  {
    "id": "s0140",
    "blockIndex": 23,
    "zh": "武帝擢韓安國於徒中，拜為梁內史，骨肉以安。"
  },
  {
    "id": "s0141",
    "blockIndex": 23,
    "zh": "張敞為京兆尹，有罪當免，黠吏知而犯敞，敞收殺之，其家自冤，使者覆獄，劾敞賊殺人，上逮捕不下，會免；"
  },
  {
    "id": "s0142",
    "blockIndex": 23,
    "zh": "亡命十數日，宣帝征敞拜為冀州刺史，卒獲其用。"
  },
  {
    "id": "s0143",
    "blockIndex": 23,
    "zh": "前世非私此三人，貪其材器有益於公家也。"
  },
  {
    "id": "s0144",
    "blockIndex": 23,
    "zh": "孝文時，吏居官者或長子孫，以官為氏，倉氏、庫氏則倉庫吏之後也；"
  },
  {
    "id": "s0145",
    "blockIndex": 23,
    "zh": "其二千石長吏亦安官樂職，然後上下相望，莫有苟且之意。"
  },
  {
    "id": "s0146",
    "blockIndex": 23,
    "zh": "其後稍稍變易，公卿以下傳相促急，又數改更政事，司隸、部刺史舉劾苛細，發揚陰私，吏或居官數月而退，送故迎新，交錯道路。"
  },
  {
    "id": "s0147",
    "blockIndex": 23,
    "zh": "中材苟容求全，下材懷危內顧，壹切營私者多。"
  },
  {
    "id": "s0148",
    "blockIndex": 23,
    "zh": "二千石益輕賤，吏民慢易之，或持其微過，增加成罪，言於刺史、司隸，或上書告之。"
  },
  {
    "id": "s0149",
    "blockIndex": 23,
    "zh": "眾庶知其易危，小失意則有離畔之心。"
  },
  {
    "id": "s0150",
    "blockIndex": 23,
    "zh": "前山陽亡徒蘇令等縱橫，吏士臨難，莫肯伏節死義，以守、相威權素奪也。"
  },
  {
    "id": "s0151",
    "blockIndex": 23,
    "zh": "孝成皇帝悔之，下詔書，二千石不為故縱，遣使者賜金，尉厚其意，誠以為國家有急，取辦於二千石；"
  },
  {
    "id": "s0152",
    "blockIndex": 23,
    "zh": "二千石尊重難危，乃能使下。"
  },
  {
    "id": "s0153",
    "blockIndex": 23,
    "zh": "孝宣皇帝愛其善治民之吏，有章劾事留中，會赦壹解。"
  },
  {
    "id": "s0154",
    "blockIndex": 23,
    "zh": "故事：尚書希下章，為煩擾百姓，證驗系治，或死獄中，章文必有『敢告之』字乃下。"
  },
  {
    "id": "s0155",
    "blockIndex": 23,
    "zh": "唯陛下留神於擇賢，記善忘過，容忍臣子，勿責以備。"
  },
  {
    "id": "s0156",
    "blockIndex": 23,
    "zh": "二千石、部刺史、三輔縣令有材任職者，人情不能不有過差，宜可闊略，令盡力者有所勸。"
  },
  {
    "id": "s0157",
    "blockIndex": 23,
    "zh": "此方今急務，國家之利也。"
  },
  {
    "id": "s0158",
    "blockIndex": 23,
    "zh": "前蘇令發，欲遣大夫使逐問狀，時見大夫無可使者，召盩厔令尹逢，拜為諫大夫遣之。"
  },
  {
    "id": "s0159",
    "blockIndex": 23,
    "zh": "今諸大夫有材能者甚少，宜豫畜養可成就者，則士赴難不愛其死。"
  },
  {
    "id": "s0160",
    "blockIndex": 23,
    "zh": "臨事倉卒乃求，非所以明朝廷也。"
  },
  {
    "id": "s0161",
    "blockIndex": 23,
    "zh": "」嘉因薦儒者公孫光、滿昌及能吏蕭鹹、薛修等，皆故二千石有名稱者，天子納而用之。"
  },
  {
    "id": "s0162",
    "blockIndex": 24,
    "zh": "六月，立魯頃王子部鄉侯閔為王。"
  },
  {
    "id": "s0163",
    "blockIndex": 25,
    "zh": "上以寢疾未定，冬，十一月，壬子，令太皇太后下詔復甘泉泰畤、汾陰后土祠，罷南、北郊。"
  },
  {
    "id": "s0164",
    "blockIndex": 25,
    "zh": "上亦不能親至甘泉、河東，遣有司行事而禮祠焉。"
  },
  {
    "id": "s0165",
    "blockIndex": 26,
    "zh": "無鹽危山土自起覆草，如馳道狀；"
  },
  {
    "id": "s0166",
    "blockIndex": 26,
    "zh": "又，瓠山石轉立。"
  },
  {
    "id": "s0167",
    "blockIndex": 26,
    "zh": "東平王雲及後謁自之石所祭，治石像瓠山立石，束倍草，並祠之。"
  },
  {
    "id": "s0168",
    "blockIndex": 26,
    "zh": "河內息夫躬、長安孫寵相與謀共告之，曰：「此取封侯之計也。"
  },
  {
    "id": "s0169",
    "blockIndex": 26,
    "zh": "」乃與中郎谷師譚共因中常侍宋弘上變事，告焉。"
  },
  {
    "id": "s0170",
    "blockIndex": 26,
    "zh": "是時上被疾，多所惡，事下有司，逮王后謁下獄驗治；"
  },
  {
    "id": "s0171",
    "blockIndex": 26,
    "zh": "服「祠祭詛祝上，為雲求為天子，以為石立，宣帝起之表也。"
  },
  {
    "id": "s0172",
    "blockIndex": 26,
    "zh": "」有司請誅王，有詔，廢徙房陵。"
  },
  {
    "id": "s0173",
    "blockIndex": 26,
    "zh": "雲自殺，謁並舅伍宏及成帝舅安成共侯夫人放，皆棄市。"
  },
  {
    "id": "s0174",
    "blockIndex": 26,
    "zh": "事連御史大夫王崇，左遷大司農。"
  },
  {
    "id": "s0175",
    "blockIndex": 26,
    "zh": "擢寵為南陽太守，譚穎川都尉，弘、躬皆光祿大夫、左曹、給事中。"
  },
  {
    "id": "s0176",
    "blockIndex": 27,
    "zh": "春，正月，大旱。"
  },
  {
    "id": "s0177",
    "blockIndex": 28,
    "zh": "關東民無故驚走，持藳或掫一枚，轉相付與，曰行西王母籌，道中相過逢，多至千數，或被發徒跣，或夜折關，或逾牆入，或乘車騎奔馳，以置驛傳行，經歷郡國二十六至京師，不可禁止。"
  },
  {
    "id": "s0178",
    "blockIndex": 28,
    "zh": "民又聚會里巷阡陌，設張博具，歌舞祠西王母，至秋乃止。"
  },
  {
    "id": "s0179",
    "blockIndex": 29,
    "zh": "上欲封傅太后從父弟侍中、光祿大夫商，尚書僕射平陵鄭崇諫曰：「孝成皇帝封親舅五侯，天為赤黃，晝昏，日中有黑氣。"
  },
  {
    "id": "s0180",
    "blockIndex": 29,
    "zh": "孔鄉侯，皇后父，高武侯以三公封，尚有因緣。"
  },
  {
    "id": "s0181",
    "blockIndex": 29,
    "zh": "今無故欲復封商，壞亂制度，逆天人之心，非傅氏之福也！"
  },
  {
    "id": "s0182",
    "blockIndex": 29,
    "zh": "臣願以身命當國咎！"
  },
  {
    "id": "s0183",
    "blockIndex": 29,
    "zh": "」崇因持詔書案起。"
  },
  {
    "id": "s0184",
    "blockIndex": 29,
    "zh": "傅太后大怒曰：「何有為天子乃反為一臣所顓制邪！"
  },
  {
    "id": "s0186",
    "blockIndex": 30,
    "zh": "二月，癸卯，上遂下詔封商為汝昌侯。"
  },
  {
    "id": "s0187",
    "blockIndex": 31,
    "zh": "駙馬都尉、侍中雲陽董賢得幸於上，出則參乘，入御左右，賞賜累巨萬，貴震朝廷。"
  },
  {
    "id": "s0188",
    "blockIndex": 31,
    "zh": "常與上臥起。"
  },
  {
    "id": "s0189",
    "blockIndex": 31,
    "zh": "嘗晝寢，偏藉上袖，上欲起，賢未覺，不欲動賢，乃斷袖而起。"
  },
  {
    "id": "s0190",
    "blockIndex": 31,
    "zh": "又詔賢妻得通引籍殿中，止賢廬。"
  },
  {
    "id": "s0191",
    "blockIndex": 31,
    "zh": "又召賢女弟以為昭儀，位次皇后。"
  },
  {
    "id": "s0192",
    "blockIndex": 31,
    "zh": "昭儀及賢與妻旦夕上下，並侍左右。"
  },
  {
    "id": "s0193",
    "blockIndex": 31,
    "zh": "以賢父恭為少府，賜爵關內侯。"
  },
  {
    "id": "s0194",
    "blockIndex": 31,
    "zh": "詔將作大匠為賢起大第北闕下，重殿，洞門，土木之功，窮極技巧。"
  },
  {
    "id": "s0195",
    "blockIndex": 31,
    "zh": "賜武庫禁兵，上方珍寶。"
  },
  {
    "id": "s0196",
    "blockIndex": 31,
    "zh": "其選物上弟盡在董氏，而乘輿所服乃其副也。"
  },
  {
    "id": "s0197",
    "blockIndex": 31,
    "zh": "及至東園秘器、珠襦、玉柙，豫以賜賢，無不備具。"
  },
  {
    "id": "s0198",
    "blockIndex": 31,
    "zh": "又令將作為賢起塚塋義陵旁，內為便房，剛柏題湊，外為徼道，周垣數里，門闕罘罳甚盛。"
  },
  {
    "id": "s0199",
    "blockIndex": 32,
    "zh": "鄭崇以賢貴寵過度諫上，由是重得罪，數以職事見責；"
  },
  {
    "id": "s0200",
    "blockIndex": 32,
    "zh": "發疾頸癰，欲乞骸骨，不敢。"
  },
  {
    "id": "s0201",
    "blockIndex": 32,
    "zh": "尚書令趙昌佞諂，素害崇；"
  },
  {
    "id": "s0202",
    "blockIndex": 32,
    "zh": "知見疏，因奏「崇與宗族通，疑有奸，請治。"
  },
  {
    "id": "s0203",
    "blockIndex": 32,
    "zh": "」上責崇曰：「君門如市人，何以欲禁切主上？"
  },
  {
    "id": "s0204",
    "blockIndex": 32,
    "zh": "」崇對曰：「臣門如市，臣心如水。"
  },
  {
    "id": "s0205",
    "blockIndex": 32,
    "zh": "願得考覆！"
  },
  {
    "id": "s0206",
    "blockIndex": 32,
    "zh": "」上怒，下崇獄。"
  },
  {
    "id": "s0207",
    "blockIndex": 32,
    "zh": "司隸孫寶上書曰：「按尚書令昌奏僕射崇獄，覆治，榜掠將死，卒無一辭，道路稱冤。"
  },
  {
    "id": "s0208",
    "blockIndex": 32,
    "zh": "疑昌與崇內有纖介，浸潤相陷。"
  },
  {
    "id": "s0209",
    "blockIndex": 32,
    "zh": "自禁門樞機近臣，蒙受冤譖，虧損國家，為謗不小。"
  },
  {
    "id": "s0210",
    "blockIndex": 32,
    "zh": "臣請治昌以解眾心。"
  },
  {
    "id": "s0211",
    "blockIndex": 32,
    "zh": "」書奏，上下詔曰：「司隸寶附下罔上，以春月作詆欺，遂其奸心，蓋國之賊也。"
  },
  {
    "id": "s0212",
    "blockIndex": 32,
    "zh": "免寶為庶人。"
  },
  {
    "id": "s0213",
    "blockIndex": 32,
    "zh": "」崇竟死獄中。"
  },
  {
    "id": "s0214",
    "blockIndex": 33,
    "zh": "二月，丁卯，諸吏、散騎、光祿勳賈延為御史大夫。"
  },
  {
    "id": "s0215",
    "blockIndex": 34,
    "zh": "上欲侯董賢而未有緣，侍中傅嘉勸上定息夫躬、孫寵告東平本章，掇去宋弘，更言因董賢以聞，欲以其功侯之，皆先賜爵關內侯。"
  },
  {
    "id": "s0216",
    "blockIndex": 34,
    "zh": "頃之，上欲封賢等而心憚王嘉，乃先使孔鄉侯晏持詔書示丞相、御史。"
  },
  {
    "id": "s0217",
    "blockIndex": 34,
    "zh": "於是嘉與御史大夫賈延上封事言：「竊見董賢等三人始賜爵，眾庶匈匈，鹹曰賢貴，其餘並蒙恩，至今流言未解。"
  },
  {
    "id": "s0218",
    "blockIndex": 34,
    "zh": "陛下仁恩於賢等不已，宜暴賢等本奏語言，延問公卿、大夫、博士、議郎，考合古今，明正其義，然後乃加爵土；"
  },
  {
    "id": "s0219",
    "blockIndex": 34,
    "zh": "不然，恐大失眾心，海內引領而議。"
  },
  {
    "id": "s0220",
    "blockIndex": 34,
    "zh": "暴評其事，必有言當封者，在陛下所從；"
  },
  {
    "id": "s0221",
    "blockIndex": 34,
    "zh": "天下雖不說，咎有所分，不獨在陛下。"
  },
  {
    "id": "s0222",
    "blockIndex": 34,
    "zh": "前定陵侯淳于長初封，其事亦議，大司農谷永以長當封；"
  },
  {
    "id": "s0223",
    "blockIndex": 34,
    "zh": "眾人歸咎於永，先帝不獨蒙其譏。"
  },
  {
    "id": "s0224",
    "blockIndex": 34,
    "zh": "臣嘉，臣延，材駑不稱，死有餘責，知順指不迕，可得容身須臾。"
  },
  {
    "id": "s0225",
    "blockIndex": 34,
    "zh": "所以不敢者，思報厚恩也。"
  },
  {
    "id": "s0226",
    "blockIndex": 34,
    "zh": "」上不得已，且為之止。"
  },
  {
    "id": "s0227",
    "blockIndex": 35,
    "zh": "夏，六月，尊帝太太后為皇太太后。"
  },
  {
    "id": "s0228",
    "blockIndex": 36,
    "zh": "秋，八月，辛卯，上下詔切責公卿曰：「昔楚有子玉得臣，晉文為之側席而坐；"
  },
  {
    "id": "s0229",
    "blockIndex": 36,
    "zh": "近事，汲黯折淮南之謀。"
  },
  {
    "id": "s0230",
    "blockIndex": 36,
    "zh": "今東平王雲等至有圖弒天子逆亂之謀者，是公卿股肱莫能悉心、務聰明以銷厭未萌故也。"
  },
  {
    "id": "s0231",
    "blockIndex": 36,
    "zh": "賴宗廟之靈，侍中、駙馬都尉賢等發覺以聞，鹹伏厥辜。"
  },
  {
    "id": "s0232",
    "blockIndex": 36,
    "zh": "《書》不雲乎：『用德章厥善。"
  },
  {
    "id": "s0233",
    "blockIndex": 36,
    "zh": "』其封賢為高安侯，南陽太守寵為方陽侯，左曹、光祿大夫躬為宜陵侯，賜右師譚爵關內侯。"
  },
  {
    "id": "s0234",
    "blockIndex": 36,
    "zh": "」又封傅太后同母弟鄭惲子業為陽信侯。"
  },
  {
    "id": "s0235",
    "blockIndex": 36,
    "zh": "息夫躬既親近，數進見言事，議論無所避，上疏歷詆公卿大臣。"
  },
  {
    "id": "s0236",
    "blockIndex": 36,
    "zh": "眾畏其口，見之仄目。"
  },
  {
    "id": "s0237",
    "blockIndex": 37,
    "zh": "上使中黃門發武庫兵，前後十輩，送董賢及上乳母王阿捨。"
  },
  {
    "id": "s0238",
    "blockIndex": 37,
    "zh": "執金吾毋將隆奏言：「武庫兵器，天下公用。"
  },
  {
    "id": "s0239",
    "blockIndex": 37,
    "zh": "國家武備，繕治造作，皆度大司農錢。"
  },
  {
    "id": "s0240",
    "blockIndex": 37,
    "zh": "大司農錢，自乘輿不以給共養；"
  },
  {
    "id": "s0241",
    "blockIndex": 37,
    "zh": "共養勞賜，一出少府。"
  },
  {
    "id": "s0242",
    "blockIndex": 37,
    "zh": "蓋不以本臧給末用，不以民力共浮費，別公私，示正路也。"
  },
  {
    "id": "s0243",
    "blockIndex": 37,
    "zh": "古者諸侯、方伯得顓征伐，乃賜斧鉞，漢家邊吏職任距寇，亦賜武庫兵，皆任事然後蒙之。"
  },
  {
    "id": "s0244",
    "blockIndex": 37,
    "zh": "《春秋》之誼，家不臧甲，所以抑臣威，損私力也。"
  },
  {
    "id": "s0245",
    "blockIndex": 37,
    "zh": "今賢等便僻弄臣，私恩微妾，而以天下公用給其私門，契國威器，共其家備，民力分於弄臣，武兵設於微妾，建立非宜，以廣驕僭，非所以示四方也。"
  },
  {
    "id": "s0246",
    "blockIndex": 37,
    "zh": "孔子曰：『奚取於三家之堂！"
  },
  {
    "id": "s0247",
    "blockIndex": 37,
    "zh": "』臣請收還武庫。"
  },
  {
    "id": "s0248",
    "blockIndex": 37,
    "zh": "」上不說。"
  },
  {
    "id": "s0249",
    "blockIndex": 37,
    "zh": "頃之，傅太后使謁者賤買執金吾官婢八人，隆奏言：「買賤，請更平直。"
  },
  {
    "id": "s0250",
    "blockIndex": 37,
    "zh": "」上於是制詔丞相、御史：「隆位九卿，既無以匡朝廷之不逮，而反奏請與永信宮爭貴賤之賈，傷化失俗。"
  },
  {
    "id": "s0251",
    "blockIndex": 37,
    "zh": "以隆前有安國之言，左遷為沛郡都尉。"
  },
  {
    "id": "s0252",
    "blockIndex": 37,
    "zh": "」初，成帝末，隆為諫大夫，嘗奏封事言：「古者選諸侯入為公卿，以褒功德，宜征定陶王使在國邸，以填萬方。"
  },
  {
    "id": "s0253",
    "blockIndex": 37,
    "zh": "」故上思其言而宥之。"
  },
  {
    "id": "s0254",
    "blockIndex": 38,
    "zh": "諫大夫渤海鮑宣上書曰：「竊見孝成皇帝時，外親持權，人人牽引所私以充塞朝廷，妨賢人路，濁亂天下，奢泰亡度，窮困百姓，是以日食且十，彗星四起。"
  },
  {
    "id": "s0255",
    "blockIndex": 38,
    "zh": "危亡之征，陛下所親見也；"
  },
  {
    "id": "s0256",
    "blockIndex": 38,
    "zh": "今奈何反覆劇於前乎！"
  },
  {
    "id": "s0257",
    "blockIndex": 39,
    "zh": "「今民有七亡：陰陽不和，水旱為災，一亡也；"
  },
  {
    "id": "s0258",
    "blockIndex": 39,
    "zh": "縣官重責，更賦租稅，二亡也；"
  },
  {
    "id": "s0259",
    "blockIndex": 39,
    "zh": "貪吏並公，受取不已，三亡也；"
  },
  {
    "id": "s0260",
    "blockIndex": 39,
    "zh": "豪強大姓，蠶食亡厭，四亡也；"
  },
  {
    "id": "s0261",
    "blockIndex": 39,
    "zh": "苛吏繇役，失農桑時，五亡也；"
  },
  {
    "id": "s0262",
    "blockIndex": 39,
    "zh": "部落鼓鳴，男女遮列，六亡也；"
  },
  {
    "id": "s0263",
    "blockIndex": 39,
    "zh": "盜賊劫略，取民財物，七亡也。"
  },
  {
    "id": "s0264",
    "blockIndex": 39,
    "zh": "七亡尚可，又有七死：酷吏毆殺，一死也；"
  },
  {
    "id": "s0265",
    "blockIndex": 39,
    "zh": "治獄深刻，二死也；"
  },
  {
    "id": "s0266",
    "blockIndex": 39,
    "zh": "冤陷亡辜，三死也；"
  },
  {
    "id": "s0267",
    "blockIndex": 39,
    "zh": "盜賊橫發，四死也；"
  },
  {
    "id": "s0268",
    "blockIndex": 39,
    "zh": "怨讎相殘，五死也；"
  },
  {
    "id": "s0269",
    "blockIndex": 39,
    "zh": "歲惡飢餓，六死也；"
  },
  {
    "id": "s0270",
    "blockIndex": 39,
    "zh": "時氣疾疫，七死也。"
  },
  {
    "id": "s0271",
    "blockIndex": 39,
    "zh": "民有七亡而無一得，慾望國安，誠難；"
  },
  {
    "id": "s0272",
    "blockIndex": 39,
    "zh": "民有七死而無一生，慾望刑措，誠難。"
  },
  {
    "id": "s0273",
    "blockIndex": 39,
    "zh": "此非公卿、守相貪殘成化之所致邪？"
  },
  {
    "id": "s0274",
    "blockIndex": 39,
    "zh": "群臣幸得居尊官，食重祿，豈有肯加惻隱於細民，助陛下流教化者邪？"
  },
  {
    "id": "s0275",
    "blockIndex": 39,
    "zh": "志但在營私家，稱賓客，為奸利而已。"
  },
  {
    "id": "s0276",
    "blockIndex": 39,
    "zh": "以苟容曲從為賢，以拱默尸祿為智，謂如臣宣等為愚。"
  },
  {
    "id": "s0277",
    "blockIndex": 39,
    "zh": "陛下擢臣巖穴，誠翼有益豪毛，豈徒欲使臣美食大官、重高門之地哉！"
  },
  {
    "id": "s0278",
    "blockIndex": 40,
    "zh": "「天下，乃皇天之天下也。"
  },
  {
    "id": "s0279",
    "blockIndex": 40,
    "zh": "陛下上為皇天子，下為黎庶父母，為天牧養元元，視之當如一，合《尸鳩》之詩。"
  },
  {
    "id": "s0280",
    "blockIndex": 40,
    "zh": "今貧民菜食不厭，衣又穿空，父子、夫婦不能相保，誠可為酸鼻。"
  },
  {
    "id": "s0281",
    "blockIndex": 40,
    "zh": "陛下不救，將安所歸命乎！"
  },
  {
    "id": "s0282",
    "blockIndex": 40,
    "zh": "奈何獨私養外親與幸臣董賢，多賞賜，以大萬數，使奴從、賓客，漿酒藿肉，蒼頭廬兒，皆用致富，非天意也。"
  },
  {
    "id": "s0283",
    "blockIndex": 41,
    "zh": "「及汝昌侯傅商，亡功而封。"
  },
  {
    "id": "s0284",
    "blockIndex": 41,
    "zh": "夫官爵非陛下之官爵，乃天下之官爵也。"
  },
  {
    "id": "s0285",
    "blockIndex": 41,
    "zh": "陛下取非其官，官非其人，而望天說民服，豈不難哉！"
  },
  {
    "id": "s0286",
    "blockIndex": 41,
    "zh": "方陽侯孫寵，宜陵侯息夫躬，辯足以移眾，強可用獨立，奸人之雄，惑世尤劇者也，宜以時罷退。"
  },
  {
    "id": "s0287",
    "blockIndex": 41,
    "zh": "及外親幼童未通經術者，皆宜令休，就師傅。"
  },
  {
    "id": "s0288",
    "blockIndex": 41,
    "zh": "急征故大司馬傅喜，使領外親。"
  },
  {
    "id": "s0289",
    "blockIndex": 41,
    "zh": "故大司空何武、師丹，故丞相孔光，故左將軍彭宣，經皆更博士，位皆歷三公；"
  },
  {
    "id": "s0290",
    "blockIndex": 41,
    "zh": "龔勝為司直，郡國皆慎選舉；"
  },
  {
    "id": "s0291",
    "blockIndex": 41,
    "zh": "可大委任也。"
  },
  {
    "id": "s0292",
    "blockIndex": 41,
    "zh": "陛下前以小不忍退武等，海內失望。"
  },
  {
    "id": "s0293",
    "blockIndex": 41,
    "zh": "陛下尚能容亡功德者甚眾，曾不能忍武等邪？"
  },
  {
    "id": "s0294",
    "blockIndex": 41,
    "zh": "治天下者，當用天下之心為心，不得自專快意而已也。"
  },
  {
    "id": "s0295",
    "blockIndex": 41,
    "zh": "」宣語雖刻切，上以宣名儒，優容之。"
  },
  {
    "id": "s0296",
    "blockIndex": 42,
    "zh": "匈奴單于上書願朝五年。"
  },
  {
    "id": "s0297",
    "blockIndex": 42,
    "zh": "時帝被疾，或言：「匈奴從上游來厭人；"
  },
  {
    "id": "s0298",
    "blockIndex": 42,
    "zh": "自黃龍、竟寧時，單于朝中國，輒有大故。"
  },
  {
    "id": "s0299",
    "blockIndex": 42,
    "zh": "」上由是難之，以問公卿，亦以為虛費府帑，可且勿許。"
  },
  {
    "id": "s0300",
    "blockIndex": 42,
    "zh": "單于使辭去，未發，黃門郎揚雄上書諫曰：「臣聞《六經》之治，貴於未亂；"
  },
  {
    "id": "s0301",
    "blockIndex": 42,
    "zh": "兵家之勝，貴於未戰；"
  },
  {
    "id": "s0302",
    "blockIndex": 42,
    "zh": "二者皆微，然而大事之本，不可不察也。"
  },
  {
    "id": "s0303",
    "blockIndex": 42,
    "zh": "今單于上書求朝，國家不許而辭之，臣愚以為漢與匈奴從此隙矣。"
  },
  {
    "id": "s0304",
    "blockIndex": 42,
    "zh": "匈奴本五帝所不能臣，三王所不能制，其不可使隙明甚。"
  },
  {
    "id": "s0305",
    "blockIndex": 42,
    "zh": "臣不敢遠稱，請引秦以來明之：以秦始皇之強，蒙恬之威，然不敢窺西河，乃築長城以界之。"
  },
  {
    "id": "s0306",
    "blockIndex": 42,
    "zh": "會漢初興，以高祖之威靈，三十萬眾困於平城，時奇譎之士、石畫之臣甚眾，卒其所以脫者，世莫得而言也。"
  },
  {
    "id": "s0307",
    "blockIndex": 42,
    "zh": "又高皇后時，匈奴悖慢，大臣權書遺之，然後得解。"
  },
  {
    "id": "s0308",
    "blockIndex": 42,
    "zh": "及孝文時，匈奴侵暴北邊，候騎至雍甘泉，京師大駭，發三將軍屯細柳、棘門、霸上以備之，數月乃罷。"
  },
  {
    "id": "s0309",
    "blockIndex": 42,
    "zh": "孝武即位，設馬邑之權，欲誘匈奴，徒費財勞師，一虜不可得見，況單于之面乎！"
  },
  {
    "id": "s0310",
    "blockIndex": 42,
    "zh": "其後深惟社稷之計，規恢萬載之策，乃大興師數十萬，使衛青、霍去病操兵，前後十餘年，於是浮西河，絕大幕，破寘顏，襲王庭，窮極其地，追奔逐北，封狼居胥山，禪於姑衍，以臨翰海，虜名王、貴人以百數。"
  },
  {
    "id": "s0311",
    "blockIndex": 42,
    "zh": "自是之後，匈奴震怖，益求和親，然而未肯稱臣也。"
  },
  {
    "id": "s0312",
    "blockIndex": 42,
    "zh": "且夫前世豈樂傾無量之費，役無罪之人，快心狼望之北哉？"
  },
  {
    "id": "s0313",
    "blockIndex": 42,
    "zh": "以為不壹勞者不久佚，不暫費者不永寧，是以忍百萬之師以摧餓虎之喙，運府庫之財填盧山之壑而不悔也。"
  },
  {
    "id": "s0314",
    "blockIndex": 42,
    "zh": "至本始之初，匈奴有桀心，欲掠烏孫，侵公主，乃發五將之師十五萬騎以擊之，時鮮有所獲，徒奮揚威武，明漢兵若雷風耳！"
  },
  {
    "id": "s0315",
    "blockIndex": 42,
    "zh": "雖空行空反，尚誅兩將軍，故北狄不服，中國未得高枕安寢也。"
  },
  {
    "id": "s0316",
    "blockIndex": 42,
    "zh": "逮至元康、神爵之間，大化神明，鴻恩溥洽，而匈奴內亂，五單于爭立，日逐、呼韓邪攜國歸死，扶伏稱臣，然尚羈縻之，計不顓制。"
  },
  {
    "id": "s0317",
    "blockIndex": 42,
    "zh": "自此之後，欲朝者不距，不欲者不強。"
  },
  {
    "id": "s0318",
    "blockIndex": 42,
    "zh": "何者？"
  },
  {
    "id": "s0319",
    "blockIndex": 42,
    "zh": "外國天性忿鷙，形容魁健，負力怙氣，難化以善，易肄以惡，其強難詘，其和難得。"
  },
  {
    "id": "s0320",
    "blockIndex": 42,
    "zh": "故未服之時，勞師遠攻，傾國殫貨，伏屍流血，破堅拔敵，如彼之難也；"
  },
  {
    "id": "s0321",
    "blockIndex": 42,
    "zh": "既服之後，慰薦撫循，交接賂遺，威儀俯仰，如此之備也。"
  },
  {
    "id": "s0322",
    "blockIndex": 42,
    "zh": "往時嘗屠大宛之城，蹈烏桓之壘，探姑繒之壁，藉蕩姐之場，艾朝鮮之旃，拔兩越之旗，近不過旬月之役，遠不離二時之勞，固已犁其庭，掃其閭，郡縣而置之，雲徹席捲，後無餘災。"
  },
  {
    "id": "s0323",
    "blockIndex": 42,
    "zh": "唯北狄為不然，真中國之堅敵也，三垂比之縣矣；"
  },
  {
    "id": "s0324",
    "blockIndex": 42,
    "zh": "前世重之茲甚，未易可輕也。"
  },
  {
    "id": "s0325",
    "blockIndex": 43,
    "zh": "「今單于歸義，懷款誠之心，欲離其庭，陳見於前，此乃上世之遺策，神靈之所想望，國家雖費，不得已者也。"
  },
  {
    "id": "s0326",
    "blockIndex": 43,
    "zh": "奈何距以來厭之辭，疏以無日之期，消往昔之恩，開將來之隙？"
  },
  {
    "id": "s0327",
    "blockIndex": 43,
    "zh": "夫疑而隙之，使有恨心，負前言，緣往辭，歸怨於漢，因以自絕，終無北面之心，威之不可，諭之不能，焉得不為大憂乎！"
  },
  {
    "id": "s0328",
    "blockIndex": 43,
    "zh": "夫明者視於無形，聰者聽於無聲，誠先於未然，即兵革不用而憂患不生。"
  },
  {
    "id": "s0329",
    "blockIndex": 43,
    "zh": "不然，壹有隙之後，雖智者勞心於內，辯者轂擊於外，猶不若未然之時也。"
  },
  {
    "id": "s0330",
    "blockIndex": 43,
    "zh": "且往者圖西域，制車師，置城郭都護三十六國，費歲以大萬計者，豈為康居、烏孫能逾白龍堆而寇西邊哉？"
  },
  {
    "id": "s0331",
    "blockIndex": 43,
    "zh": "乃以制匈奴也。"
  },
  {
    "id": "s0332",
    "blockIndex": 43,
    "zh": "夫百年勞之，一日失之，費十而愛一，臣竊為國不安也。"
  },
  {
    "id": "s0333",
    "blockIndex": 43,
    "zh": "唯陛下少留意於未亂、未戰，以遏邊萌之禍！"
  },
  {
    "id": "s0335",
    "blockIndex": 44,
    "zh": "書奏，天子寤焉，召還匈奴使者，更報單于書而許之。"
  },
  {
    "id": "s0336",
    "blockIndex": 44,
    "zh": "賜雄帛五十匹，黃金十斤。"
  },
  {
    "id": "s0337",
    "blockIndex": 44,
    "zh": "單于未發，會病，復遣使願朝明年；"
  },
  {
    "id": "s0338",
    "blockIndex": 44,
    "zh": "上許之。"
  },
  {
    "id": "s0339",
    "blockIndex": 45,
    "zh": "董賢貴幸日盛，丁、傅害其寵，孔鄉侯晏與息夫躬謀欲求居位輔政。"
  },
  {
    "id": "s0340",
    "blockIndex": 45,
    "zh": "會單于以病未朝，躬因是而上奏，以為：「單于當以十一月入塞，後以病為解，疑有他變。"
  },
  {
    "id": "s0341",
    "blockIndex": 45,
    "zh": "烏孫兩昆彌弱，卑爰疐強盛，東結單于，遣子往侍，恐其合勢以並烏孫；"
  },
  {
    "id": "s0342",
    "blockIndex": 45,
    "zh": "烏孫並，則匈奴盛而西域危矣。"
  },
  {
    "id": "s0343",
    "blockIndex": 45,
    "zh": "可令降胡詐為卑爰疐使者來上書，欲因天子威告單于歸臣侍子，因下其章，令匈奴客聞焉；"
  },
  {
    "id": "s0344",
    "blockIndex": 45,
    "zh": "則是所謂『上兵伐謀，其次伐交』者也。"
  },
  {
    "id": "s0345",
    "blockIndex": 45,
    "zh": "」書奏，上引見躬，召公卿、將軍大議。"
  },
  {
    "id": "s0346",
    "blockIndex": 45,
    "zh": "左將軍公孫祿以為：「中國常以威信懷伏夷狄，躬欲逆詐，進不信之謀，不可許。"
  },
  {
    "id": "s0347",
    "blockIndex": 45,
    "zh": "且匈奴賴先帝之德，保塞稱蕃。"
  },
  {
    "id": "s0348",
    "blockIndex": 45,
    "zh": "今單于以疾病不任奉朝賀，遣使自陳，不失臣子之禮。"
  },
  {
    "id": "s0349",
    "blockIndex": 45,
    "zh": "臣祿自保沒身不見匈奴為邊竟憂也！"
  },
  {
    "id": "s0350",
    "blockIndex": 45,
    "zh": "」躬掎祿曰：「臣為國家計，冀先謀將然，豫圖未形，為萬世慮。"
  },
  {
    "id": "s0351",
    "blockIndex": 45,
    "zh": "而祿欲以其犬馬齒保目所見。"
  },
  {
    "id": "s0352",
    "blockIndex": 45,
    "zh": "臣與祿異議，未可同日語也！"
  },
  {
    "id": "s0353",
    "blockIndex": 45,
    "zh": "」上曰：「善！"
  },
  {
    "id": "s0354",
    "blockIndex": 45,
    "zh": "」乃罷群臣，獨與躬議。"
  },
  {
    "id": "s0355",
    "blockIndex": 45,
    "zh": "躬因建言：「災異屢見，恐必有非常之變，可遣大將軍行邊兵，敕武備，斬一郡守以立威，震四夷，因以厭應變異。"
  },
  {
    "id": "s0356",
    "blockIndex": 45,
    "zh": "」上然之，以問丞相嘉，對曰：「臣聞動民以行不以言，應天以實不以文。"
  },
  {
    "id": "s0357",
    "blockIndex": 45,
    "zh": "下民微細，猶不可詐，況於上天神明而可欺哉！"
  },
  {
    "id": "s0358",
    "blockIndex": 45,
    "zh": "天之見異，所以敕戒人君，欲令覺悟反正，推誠行善，民心說而天意得矣！"
  },
  {
    "id": "s0359",
    "blockIndex": 45,
    "zh": "辯士見一端，或妄以意傅著星歷，虛造匈奴、烏孫、西羌之難，謀動干戈，設為權變，非應天之道也。"
  },
  {
    "id": "s0360",
    "blockIndex": 45,
    "zh": "守相有罪，車馳詣闕，交臂就死，恐懼如此，而談說者欲動安之危，辯口快耳，其實未可從。"
  },
  {
    "id": "s0361",
    "blockIndex": 45,
    "zh": "夫議政者，苦其諂諛、傾險、辯惠、深刻也。"
  },
  {
    "id": "s0362",
    "blockIndex": 45,
    "zh": "昔秦繆公不從百里奚、蹇叔之言，以敗其師，其悔過自責，疾詿誤之臣，思黃發之言，名垂於後世。"
  },
  {
    "id": "s0363",
    "blockIndex": 45,
    "zh": "唯陛下觀覽古戒，反覆參考，無以先入之語為主！"
  },
  {
    "id": "s0364",
    "blockIndex": 45,
    "zh": "」上不聽。"
  },
  {
    "id": "s0365",
    "blockIndex": 46,
    "zh": "category:資治通鑑"
  }
]
