[
  {
    "id": "s0001",
    "blockIndex": 0,
    "zh": "起昭陽大淵獻，盡重光協洽，凡九年。"
  },
  {
    "id": "s0002",
    "blockIndex": 1,
    "zh": "1春，三月，甲午，丞相李蔡坐盜孝景園，堧地，葬其中，當下吏，自殺。"
  },
  {
    "id": "s0003",
    "blockIndex": 1,
    "zh": "----2罷三銖錢，更鑄五銖錢。"
  },
  {
    "id": "s0004",
    "blockIndex": 1,
    "zh": "於是民多盜鑄錢，楚地尤甚。"
  },
  {
    "id": "s0005",
    "blockIndex": 2,
    "zh": "上以為淮陽，楚地之郊，乃召拜汲黯為淮陽太守。"
  },
  {
    "id": "s0006",
    "blockIndex": 2,
    "zh": "黯伏謝不受印，詔數強予，然後奉詔。"
  },
  {
    "id": "s0007",
    "blockIndex": 2,
    "zh": "黯為上泣曰：「臣自以為填溝壑，不復見陛下，不意陛下復收用之。"
  },
  {
    "id": "s0008",
    "blockIndex": 2,
    "zh": "臣常有狗馬病，力不能任郡事。"
  },
  {
    "id": "s0009",
    "blockIndex": 2,
    "zh": "臣願為中郎。"
  },
  {
    "id": "s0010",
    "blockIndex": 2,
    "zh": "出入禁闥，補過拾遺，臣之願也。"
  },
  {
    "id": "s0011",
    "blockIndex": 2,
    "zh": "」上曰：「君薄淮陽邪？"
  },
  {
    "id": "s0012",
    "blockIndex": 2,
    "zh": "吾今召君矣，顧淮陽吏民不相得，吾徒得君之重，臥而治之。"
  },
  {
    "id": "s0014",
    "blockIndex": 3,
    "zh": "黯既辭行，過大行李息，曰：「黯棄逐居郡，不得與朝廷議矣。"
  },
  {
    "id": "s0015",
    "blockIndex": 3,
    "zh": "御史大夫湯，智足以拒諫，詐足以飾非，務巧佞之語，辯數之辭，非肯正為天下言，專阿主意。"
  },
  {
    "id": "s0016",
    "blockIndex": 3,
    "zh": "主意所不欲，因而毀之；"
  },
  {
    "id": "s0017",
    "blockIndex": 3,
    "zh": "主意所欲，因而譽之。"
  },
  {
    "id": "s0018",
    "blockIndex": 3,
    "zh": "好興事，舞文法，內懷詐以御主心，外挾賊吏以為威重。"
  },
  {
    "id": "s0019",
    "blockIndex": 3,
    "zh": "公列九卿，不早言之，公與之俱受其戮矣。"
  },
  {
    "id": "s0020",
    "blockIndex": 3,
    "zh": "」息畏湯，終不敢言；"
  },
  {
    "id": "s0021",
    "blockIndex": 3,
    "zh": "及湯敗，上抵息罪。"
  },
  {
    "id": "s0022",
    "blockIndex": 4,
    "zh": "使黯以諸侯相秩居淮陽，十歲而卒。"
  },
  {
    "id": "s0023",
    "blockIndex": 4,
    "zh": "----3詔徙奸猾吏民於邊。"
  },
  {
    "id": "s0024",
    "blockIndex": 4,
    "zh": "----4夏，四月，乙卯，以太子少傅武強侯莊青翟為丞相。"
  },
  {
    "id": "s0025",
    "blockIndex": 4,
    "zh": "----5天子病鼎湖甚。"
  },
  {
    "id": "s0026",
    "blockIndex": 4,
    "zh": "巫醫無所不致，不愈。"
  },
  {
    "id": "s0027",
    "blockIndex": 4,
    "zh": "游水發根言上郡有巫，病而鬼神下之。"
  },
  {
    "id": "s0028",
    "blockIndex": 4,
    "zh": "上召置，祠之甘泉，及病，使人問神君，神君言曰：「天子無憂病；"
  },
  {
    "id": "s0029",
    "blockIndex": 4,
    "zh": "病少愈，強與我會甘泉。"
  },
  {
    "id": "s0030",
    "blockIndex": 4,
    "zh": "」於是病癒，遂起幸甘泉，病良已，置酒壽宮。"
  },
  {
    "id": "s0031",
    "blockIndex": 4,
    "zh": "神君非可得見，聞其言，言與人音等，時去時來，來則風肅然，居室帷中。"
  },
  {
    "id": "s0032",
    "blockIndex": 4,
    "zh": "神君所言，上使人受，書其言，命之曰「畫法」。"
  },
  {
    "id": "s0033",
    "blockIndex": 4,
    "zh": "其所語，世俗之所知也，無絕殊者，而天子心獨喜；"
  },
  {
    "id": "s0034",
    "blockIndex": 4,
    "zh": "其事秘，世莫知也。"
  },
  {
    "id": "s0035",
    "blockIndex": 5,
    "zh": "時上卒起，幸甘泉，過右內史界中，道多不治，上怒曰：「義縱以我為不復行此道乎！"
  },
  {
    "id": "s0036",
    "blockIndex": 5,
    "zh": "」銜之。"
  },
  {
    "id": "s0038",
    "blockIndex": 6,
    "zh": "1冬，十月，雨水，無冰。"
  },
  {
    "id": "s0039",
    "blockIndex": 6,
    "zh": "----2上既下緡錢令而尊卜式，百姓終莫分財佐縣官，於是楊可告緡錢縱矣。"
  },
  {
    "id": "s0040",
    "blockIndex": 6,
    "zh": "義縱以為此亂民，部吏捕其為可使者。"
  },
  {
    "id": "s0041",
    "blockIndex": 6,
    "zh": "天子以縱為廢格沮事，棄縱市。"
  },
  {
    "id": "s0042",
    "blockIndex": 6,
    "zh": "----3郎中令李敢，怨大將軍之恨其父，乃擊傷大將軍，大將軍匿諱之。"
  },
  {
    "id": "s0043",
    "blockIndex": 6,
    "zh": "居無何，敢從上雍，至甘泉宮獵，驃騎將軍去病射殺敢。"
  },
  {
    "id": "s0044",
    "blockIndex": 6,
    "zh": "去病時方貴幸，上為諱，雲鹿觸殺之。"
  },
  {
    "id": "s0045",
    "blockIndex": 6,
    "zh": "----4夏，四月，乙巳，廟立皇子閎為齊王，旦為燕王，胥為廣陵王，初作誥策。"
  },
  {
    "id": "s0046",
    "blockIndex": 6,
    "zh": "----5自造白金、五銖錢後，吏民之坐盜鑄金錢死者數十萬人，其不發覺者不可勝計，天下大抵無慮皆鑄金錢矣。"
  },
  {
    "id": "s0047",
    "blockIndex": 6,
    "zh": "犯者眾，吏不能盡誅。"
  },
  {
    "id": "s0048",
    "blockIndex": 6,
    "zh": "----6六月，詔遣博士褚大、徐偃等六人分循郡國，舉兼併之徒及守、相、為吏有罪者。"
  },
  {
    "id": "s0049",
    "blockIndex": 6,
    "zh": "----7秋，九月，冠軍景桓侯霍去病薨。"
  },
  {
    "id": "s0050",
    "blockIndex": 6,
    "zh": "天子甚悼之，為塚，像祁連山。"
  },
  {
    "id": "s0051",
    "blockIndex": 7,
    "zh": "初，霍仲孺吏畢歸家，娶婦，生子光。"
  },
  {
    "id": "s0052",
    "blockIndex": 7,
    "zh": "去病既壯大，乃自知父為霍仲孺。"
  },
  {
    "id": "s0053",
    "blockIndex": 7,
    "zh": "會為驃騎將軍，擊匈奴，道出河東，遣吏迎仲孺而見之，大為買田宅奴婢而去；"
  },
  {
    "id": "s0054",
    "blockIndex": 7,
    "zh": "及還，因將光西至長安，任以為郎，稍遷至奉車都尉、光祿大夫。"
  },
  {
    "id": "s0055",
    "blockIndex": 7,
    "zh": "----8是歲，大農令顏異誅。"
  },
  {
    "id": "s0056",
    "blockIndex": 8,
    "zh": "初，異以廉直，稍遷至九卿。"
  },
  {
    "id": "s0057",
    "blockIndex": 8,
    "zh": "上與張湯既造白鹿皮幣，問異，異曰：「今王侯朝賀以蒼璧，直數千，而以皮薦反四十萬，本末不相稱。"
  },
  {
    "id": "s0058",
    "blockIndex": 8,
    "zh": "」天子不說。"
  },
  {
    "id": "s0059",
    "blockIndex": 8,
    "zh": "張湯又與異有郤，及人有告異以它事，下張湯治異。"
  },
  {
    "id": "s0060",
    "blockIndex": 8,
    "zh": "異與客語初令下有不便者，異不應，微反脣。"
  },
  {
    "id": "s0061",
    "blockIndex": 8,
    "zh": "湯奏當：「異九卿，見令不便，不入言而腹誹，論死。"
  },
  {
    "id": "s0062",
    "blockIndex": 8,
    "zh": "」自是之後，有腹誹之法比，而公卿大夫多諂諛取容矣。"
  },
  {
    "id": "s0064",
    "blockIndex": 9,
    "zh": "1夏，五月，赦天下。"
  },
  {
    "id": "s0065",
    "blockIndex": 9,
    "zh": "----2濟東王彭離驕悍，昏暮，與其奴、亡命少年數十人行剽殺人，取財物以為好，所殺發覺者百餘人，坐廢，徙上庸。"
  },
  {
    "id": "s0067",
    "blockIndex": 10,
    "zh": "1冬，十一月，張湯有罪自殺。"
  },
  {
    "id": "s0068",
    "blockIndex": 11,
    "zh": "初，御史中丞李文，與湯有郤。"
  },
  {
    "id": "s0069",
    "blockIndex": 11,
    "zh": "湯所厚吏魯謁居陰使人上變告文奸事，事下湯治，論殺之。"
  },
  {
    "id": "s0070",
    "blockIndex": 11,
    "zh": "湯心知謁居為之，上問：「變事蹤跡安起？"
  },
  {
    "id": "s0071",
    "blockIndex": 11,
    "zh": "」湯佯驚曰：「此殆文故人怨之。"
  },
  {
    "id": "s0072",
    "blockIndex": 11,
    "zh": "」謁居病，湯親為之摩足。"
  },
  {
    "id": "s0073",
    "blockIndex": 11,
    "zh": "趙王素怨湯，上書告：「湯大臣，乃與吏摩足，疑與為大奸。"
  },
  {
    "id": "s0074",
    "blockIndex": 11,
    "zh": "」事下廷尉。"
  },
  {
    "id": "s0075",
    "blockIndex": 11,
    "zh": "謁居病死，事連其弟。"
  },
  {
    "id": "s0076",
    "blockIndex": 11,
    "zh": "弟系導官，湯亦治他囚導官，見謁居弟，欲陰為之，而佯不省。"
  },
  {
    "id": "s0077",
    "blockIndex": 11,
    "zh": "謁居弟弗知，怨湯，使人上書，告湯與謁居謀共變告李文。"
  },
  {
    "id": "s0078",
    "blockIndex": 11,
    "zh": "事下減宣，宣嘗與湯有郤，及得此事，窮竟其事，未奏也。"
  },
  {
    "id": "s0079",
    "blockIndex": 11,
    "zh": "會人有盜發孝文園瘞錢，丞相青翟朝，與湯約俱謝，至前，湯獨不謝。"
  },
  {
    "id": "s0080",
    "blockIndex": 11,
    "zh": "上使御史案丞相，湯欲致其文「丞相見知」，丞相患之。"
  },
  {
    "id": "s0081",
    "blockIndex": 11,
    "zh": "丞相長史朱買臣、王朝、邊通，皆故九卿、二千石，仕宦絕在湯前。"
  },
  {
    "id": "s0082",
    "blockIndex": 11,
    "zh": "湯數行丞相事，知三長史素貴，故陵折，丞史遇之，三長史皆怨恨，欲死之。"
  },
  {
    "id": "s0083",
    "blockIndex": 11,
    "zh": "乃與丞相謀，使吏捕案賈人田信等，曰：「湯且欲奏請，信輒先知之，居物致富，與湯分之。"
  },
  {
    "id": "s0084",
    "blockIndex": 11,
    "zh": "」事辭頗聞，上問湯曰：「吾所為，賈人輒先知之，益居其物，是類有以吾謀告之者。"
  },
  {
    "id": "s0085",
    "blockIndex": 11,
    "zh": "」湯不謝，又佯驚曰：「固宜有。"
  },
  {
    "id": "s0086",
    "blockIndex": 11,
    "zh": "」減宣亦奏謁居等事。"
  },
  {
    "id": "s0087",
    "blockIndex": 11,
    "zh": "天子以湯懷詐面欺，使趙禹切責湯，湯乃為書謝，因曰：「陷臣者，三長史也。"
  },
  {
    "id": "s0088",
    "blockIndex": 11,
    "zh": "」遂自殺。"
  },
  {
    "id": "s0089",
    "blockIndex": 11,
    "zh": "湯既死，家產直不過五百金。"
  },
  {
    "id": "s0090",
    "blockIndex": 11,
    "zh": "昆弟諸子欲厚葬湯，湯母曰：「湯為天子大臣，被污惡言而死，何厚葬乎！"
  },
  {
    "id": "s0091",
    "blockIndex": 11,
    "zh": "」載以牛車，有棺無槨。"
  },
  {
    "id": "s0092",
    "blockIndex": 11,
    "zh": "天子聞之，乃盡按誅三長史。"
  },
  {
    "id": "s0093",
    "blockIndex": 11,
    "zh": "十二月，壬辰，丞相青翟下獄，自殺。"
  },
  {
    "id": "s0094",
    "blockIndex": 11,
    "zh": "----2春，起柏梁台。"
  },
  {
    "id": "s0095",
    "blockIndex": 11,
    "zh": "作承露盤，高二十丈，大七圍，以銅為之。"
  },
  {
    "id": "s0096",
    "blockIndex": 11,
    "zh": "上有仙人掌，以承露，和玉屑飲之，雲可以長生。"
  },
  {
    "id": "s0097",
    "blockIndex": 11,
    "zh": "宮室之修，自此日盛。"
  },
  {
    "id": "s0098",
    "blockIndex": 11,
    "zh": "----3二月，以太子太傅趙周為丞相。"
  },
  {
    "id": "s0099",
    "blockIndex": 11,
    "zh": "----4三月，辛亥，以太子太傅石慶為御史大夫。"
  },
  {
    "id": "s0100",
    "blockIndex": 11,
    "zh": "----5大雨雪。"
  },
  {
    "id": "s0101",
    "blockIndex": 11,
    "zh": "----6夏，大水，關東餓死者以千數。"
  },
  {
    "id": "s0102",
    "blockIndex": 11,
    "zh": "----7是歲，孔僅為大農令，而桑弘羊為大農中丞，稍置均輸，以通貨物。"
  },
  {
    "id": "s0103",
    "blockIndex": 11,
    "zh": "----8白金稍賤，民不寶用，竟廢之。"
  },
  {
    "id": "s0104",
    "blockIndex": 11,
    "zh": "於是悉禁郡、國無鑄錢，專令上林三官鑄錢，令天下非三官錢不得行。"
  },
  {
    "id": "s0105",
    "blockIndex": 11,
    "zh": "而民之鑄錢益少，計其費不能相當。"
  },
  {
    "id": "s0106",
    "blockIndex": 11,
    "zh": "惟真工、大奸乃盜為之。"
  },
  {
    "id": "s0107",
    "blockIndex": 11,
    "zh": "----9渾邪王既降漢，漢兵擊逐匈奴於幕北，自鹽澤以東空無匈奴，西域道可通。"
  },
  {
    "id": "s0108",
    "blockIndex": 11,
    "zh": "於是張騫建言：「烏孫王昆莫本為匈奴臣，後兵稍強，不肯復朝事匈奴，匈奴攻不勝而遠之。"
  },
  {
    "id": "s0109",
    "blockIndex": 11,
    "zh": "今單于新困於漢，而故渾邪地空無人，蠻夷俗戀故地，又貪漢財物，今誠以此時厚幣賂烏孫，招以益東，居故渾邪之地，與漢結昆弟，其勢宜聽，聽則是斷匈奴右臂也。"
  },
  {
    "id": "s0110",
    "blockIndex": 11,
    "zh": "既連烏孫，自其西大夏之屬皆可招來而為外臣。"
  },
  {
    "id": "s0111",
    "blockIndex": 11,
    "zh": "」天子以為然，拜騫為中郎將，將三百人，馬各二匹，牛羊以萬數，繼金幣帛直數千巨萬；"
  },
  {
    "id": "s0112",
    "blockIndex": 11,
    "zh": "多持節副使，道可便，遣之他旁國。"
  },
  {
    "id": "s0113",
    "blockIndex": 12,
    "zh": "騫既至烏孫，昆莫見騫，禮節甚倨。"
  },
  {
    "id": "s0114",
    "blockIndex": 12,
    "zh": "騫諭指曰：「烏孫能東居故地，則漢遣公主為夫人，結為兄弟，共距匈奴，匈奴不足破也。"
  },
  {
    "id": "s0115",
    "blockIndex": 12,
    "zh": "」烏孫自以遠漢，未知其大小；"
  },
  {
    "id": "s0116",
    "blockIndex": 12,
    "zh": "素服屬匈奴日久，且又近之，其大臣皆畏匈奴，不欲移徙。"
  },
  {
    "id": "s0117",
    "blockIndex": 12,
    "zh": "騫留久之，不能得其要領，因分遣副使使大宛、康居、大月氏、大夏、安息、身毒、于闐及諸旁國，烏孫發譯道送騫還，使數十人，馬數十匹，隨騫報謝，因令窺漢大小。"
  },
  {
    "id": "s0118",
    "blockIndex": 12,
    "zh": "是歲，騫還，到，拜為大行。"
  },
  {
    "id": "s0119",
    "blockIndex": 12,
    "zh": "後歲餘，騫所遣使通大夏之屬者，皆頗與其人俱來，於是西域始通於漢矣。"
  },
  {
    "id": "s0120",
    "blockIndex": 13,
    "zh": "西域凡三十六國，南北有大山，中央有河，東西六千餘里，南北千餘里，東則接漢玉門、陽關，西則限以蔥嶺。"
  },
  {
    "id": "s0121",
    "blockIndex": 13,
    "zh": "河有兩源，一出蔥嶺，一出于闐，合流東注鹽澤。"
  },
  {
    "id": "s0122",
    "blockIndex": 13,
    "zh": "鹽澤去玉門、陽關三百餘里。"
  },
  {
    "id": "s0123",
    "blockIndex": 13,
    "zh": "自玉門、陽關出西域有兩道：從鄯善傍南山北，循河西行至莎車，為南道；"
  },
  {
    "id": "s0124",
    "blockIndex": 13,
    "zh": "南道西逾蔥嶺，則出大月氏、安息。"
  },
  {
    "id": "s0125",
    "blockIndex": 13,
    "zh": "自車師前王廷隨北山循河西行至疏勒，為北道；"
  },
  {
    "id": "s0126",
    "blockIndex": 13,
    "zh": "北道西逾蔥嶺，則出大宛、康居、奄蔡焉。"
  },
  {
    "id": "s0127",
    "blockIndex": 13,
    "zh": "故皆役屬匈奴，匈奴西邊日逐王，置僮僕都尉，使領西域，常居焉耆、危須、尉黎間，賦稅諸國，取富給焉。"
  },
  {
    "id": "s0128",
    "blockIndex": 14,
    "zh": "烏孫王既不肯東還，漢乃於渾邪王故地置酒泉郡，稍發徙民以充實之；"
  },
  {
    "id": "s0129",
    "blockIndex": 14,
    "zh": "後又分置武威郡，以絕匈奴與羌通之道。"
  },
  {
    "id": "s0130",
    "blockIndex": 15,
    "zh": "天子得宛汗血馬，愛之，名曰「天馬」。"
  },
  {
    "id": "s0131",
    "blockIndex": 15,
    "zh": "使者相望於道以求之。"
  },
  {
    "id": "s0132",
    "blockIndex": 15,
    "zh": "諸使外國，一輩大者數百，少者百餘人，人所賫操大放博望侯時，其後益習而衰少焉。"
  },
  {
    "id": "s0133",
    "blockIndex": 15,
    "zh": "漢率一歲中使多者十餘，少者五六輩；"
  },
  {
    "id": "s0134",
    "blockIndex": 15,
    "zh": "遠者八九歲，近者數歲而反。"
  },
  {
    "id": "s0136",
    "blockIndex": 16,
    "zh": "1冬，徙函谷關於新安。"
  },
  {
    "id": "s0137",
    "blockIndex": 16,
    "zh": "----2春，正月，戊子，陽陵園火。"
  },
  {
    "id": "s0138",
    "blockIndex": 16,
    "zh": "----3夏，四月，雨雹。"
  },
  {
    "id": "s0139",
    "blockIndex": 16,
    "zh": "----4關東郡、國十餘饑，人相食。"
  },
  {
    "id": "s0140",
    "blockIndex": 16,
    "zh": "----5常山憲王舜薨，子勃嗣，坐憲王病不侍疾，及居喪無禮廢，徙房陵。"
  },
  {
    "id": "s0141",
    "blockIndex": 16,
    "zh": "後月餘，天子更封憲王子平為真定王，以常山為郡，於是五嶽皆在天子之邦矣。"
  },
  {
    "id": "s0142",
    "blockIndex": 16,
    "zh": "----6徙代王義為清河王。"
  },
  {
    "id": "s0143",
    "blockIndex": 16,
    "zh": "----7是歲，匈奴伊稚斜單于死，子烏維單于立。"
  },
  {
    "id": "s0145",
    "blockIndex": 17,
    "zh": "1冬，十月，上行幸雍，祠五畤。"
  },
  {
    "id": "s0146",
    "blockIndex": 17,
    "zh": "詔曰：「今上帝，朕親郊，而-{后土}-無祀，則禮不答也，其令有司議。"
  },
  {
    "id": "s0147",
    "blockIndex": 17,
    "zh": "」立-{后土}-祠於澤中圜丘。"
  },
  {
    "id": "s0148",
    "blockIndex": 17,
    "zh": "上遂自夏陽東幸汾陰。"
  },
  {
    "id": "s0149",
    "blockIndex": 17,
    "zh": "是時，天子始巡郡、國。"
  },
  {
    "id": "s0150",
    "blockIndex": 17,
    "zh": "河東守不意行至，不辦，自殺。"
  },
  {
    "id": "s0151",
    "blockIndex": 17,
    "zh": "十一月，甲子，立-{后土}-祠於汾陰脽上，上親望拜，如上帝禮，禮畢，行幸滎陽，還，至洛陽，封周後姬嘉為周子南君。"
  },
  {
    "id": "s0152",
    "blockIndex": 17,
    "zh": "----2春，二月，中山靖王勝薨。"
  },
  {
    "id": "s0153",
    "blockIndex": 17,
    "zh": "----3樂成侯丁義薦方士欒大，云與文成將軍同師。"
  },
  {
    "id": "s0154",
    "blockIndex": 17,
    "zh": "上方悔誅文成，得欒大，大說。"
  },
  {
    "id": "s0155",
    "blockIndex": 17,
    "zh": "大先事膠東康王，為人長美言，多方略，而敢為大言，處之不疑。"
  },
  {
    "id": "s0156",
    "blockIndex": 17,
    "zh": "大言曰：「臣常往來海中，見安期、羨門之屬，顧以臣為賤，不信臣；"
  },
  {
    "id": "s0157",
    "blockIndex": 17,
    "zh": "又以為康王諸侯耳，不足與方。"
  },
  {
    "id": "s0158",
    "blockIndex": 17,
    "zh": "臣之師曰：『黃金可成而河決可塞，不死之藥可得，仙人可致也。"
  },
  {
    "id": "s0159",
    "blockIndex": 17,
    "zh": "』然臣恐效文成，則方士皆掩口，惡敢言方哉！"
  },
  {
    "id": "s0160",
    "blockIndex": 17,
    "zh": "」上曰：「文成食馬肝死耳。"
  },
  {
    "id": "s0161",
    "blockIndex": 17,
    "zh": "子誠能修其方，我何愛乎！"
  },
  {
    "id": "s0162",
    "blockIndex": 17,
    "zh": "」大曰：「臣師非有求人，人者求之。"
  },
  {
    "id": "s0163",
    "blockIndex": 17,
    "zh": "陛下必欲致之，則貴其使者，令為親屬，以客禮待之，乃可使通言於神人。"
  },
  {
    "id": "s0164",
    "blockIndex": 17,
    "zh": "」於是上使驗小方，斗旗，旗自相觸擊。"
  },
  {
    "id": "s0165",
    "blockIndex": 17,
    "zh": "是時，上方憂河決而黃金不就，乃拜大為五利將軍，又拜為天士將軍，地士將軍，大通將軍。"
  },
  {
    "id": "s0166",
    "blockIndex": 17,
    "zh": "夏，四月，乙巳，封大為樂通侯，食邑二千戶，賜甲第，僮千人，乘輿斥車馬、帷帳、器物以充其家，又以衛長公主妻之，賫金十萬斤，天子親如五利之第，使者存問共給，相屬於道。"
  },
  {
    "id": "s0167",
    "blockIndex": 17,
    "zh": "自太主、將、相以下，皆置酒其家，獻遺之。"
  },
  {
    "id": "s0168",
    "blockIndex": 17,
    "zh": "天子又刻玉印曰「天道將軍」，使使衣羽衣，夜立白茅上；"
  },
  {
    "id": "s0169",
    "blockIndex": 17,
    "zh": "五利將軍亦衣羽衣，立白茅上，受印，以示不臣。"
  },
  {
    "id": "s0170",
    "blockIndex": 17,
    "zh": "大見數月，佩六印，貴震天下。"
  },
  {
    "id": "s0171",
    "blockIndex": 17,
    "zh": "於是海上燕、齊之間，莫不扼腕自言有禁方、能神仙矣。"
  },
  {
    "id": "s0172",
    "blockIndex": 17,
    "zh": "----4六月，汾陰巫錦得大鼎於魏脽后土營旁，河東太守以聞。"
  },
  {
    "id": "s0173",
    "blockIndex": 17,
    "zh": "天子使驗問，巫得鼎無奸詐，乃以禮祠，迎鼎至甘泉，從上行，薦之宗廟及上帝，藏於甘泉宮，群臣皆上壽賀。"
  },
  {
    "id": "s0174",
    "blockIndex": 17,
    "zh": "----5秋，立常山憲王子商為泗水王。"
  },
  {
    "id": "s0175",
    "blockIndex": 17,
    "zh": "----6初，條侯周亞夫為丞相，趙禹為丞相史，府中皆稱其廉平，然亞夫弗任，曰：「極知禹無害，然文深，不可以居大府。"
  },
  {
    "id": "s0176",
    "blockIndex": 17,
    "zh": "」及禹為少府，比九卿為酷急；"
  },
  {
    "id": "s0177",
    "blockIndex": 17,
    "zh": "至晚節，吏務為嚴峻，而禹更名寬平。"
  },
  {
    "id": "s0178",
    "blockIndex": 18,
    "zh": "中尉尹齊素以敢斬伐著名，及為中尉，吏民益凋敝。"
  },
  {
    "id": "s0179",
    "blockIndex": 18,
    "zh": "是歲，齊坐不勝任抵罪。"
  },
  {
    "id": "s0180",
    "blockIndex": 18,
    "zh": "上乃復以王溫舒為中尉，趙禹為廷尉。"
  },
  {
    "id": "s0181",
    "blockIndex": 18,
    "zh": "後四年，禹以老，貶為燕相。"
  },
  {
    "id": "s0182",
    "blockIndex": 19,
    "zh": "是時吏治以慘刻相尚，獨左內史兒寬，勸農業，緩刑罰，理獄訟，務在得人心；"
  },
  {
    "id": "s0183",
    "blockIndex": 19,
    "zh": "擇用仁厚士，推情與下，不求名聲，吏民大信愛之；"
  },
  {
    "id": "s0184",
    "blockIndex": 19,
    "zh": "收租稅時，裁闊狹，與民相假貸，以故租多不入。"
  },
  {
    "id": "s0185",
    "blockIndex": 19,
    "zh": "後有軍發，左內史以負租課殿，當免；"
  },
  {
    "id": "s0186",
    "blockIndex": 19,
    "zh": "民聞當免，皆恐失之，大家牛車、小家擔負輸租，繈屬不絕，課更以最。"
  },
  {
    "id": "s0187",
    "blockIndex": 19,
    "zh": "上由此愈奇寬。"
  },
  {
    "id": "s0188",
    "blockIndex": 19,
    "zh": "----7初，南越文王遣其子嬰齊入宿衛，在長安取邯鄲樛氏女，生子興。"
  },
  {
    "id": "s0189",
    "blockIndex": 19,
    "zh": "文王薨，嬰齊立，乃藏其先武帝璽，上書請立樛氏女為后，興為嗣。"
  },
  {
    "id": "s0190",
    "blockIndex": 19,
    "zh": "漢數使使者風諭嬰齊入朝。"
  },
  {
    "id": "s0191",
    "blockIndex": 19,
    "zh": "嬰齊尚樂擅殺生自恣，懼入見要，用漢法比內諸侯，固稱病，遂不入見。"
  },
  {
    "id": "s0192",
    "blockIndex": 19,
    "zh": "嬰齊薨，謚曰明王。"
  },
  {
    "id": "s0193",
    "blockIndex": 19,
    "zh": "太子興代立，其母為太后。"
  },
  {
    "id": "s0194",
    "blockIndex": 20,
    "zh": "太后自未為嬰齊姬時，嘗與霸陵人安國少季通。"
  },
  {
    "id": "s0195",
    "blockIndex": 20,
    "zh": "是歲，上使安國少季往諭王、王太后以入朝，比內諸侯，令辯士諫大夫終軍等宣其辭，勇士魏臣等輔其決，衛尉路博德將兵屯桂陽待使者。"
  },
  {
    "id": "s0196",
    "blockIndex": 20,
    "zh": "南越王年少，太后中國人；"
  },
  {
    "id": "s0197",
    "blockIndex": 20,
    "zh": "安國少季往，復與私通，國人頗知之，多不附太后。"
  },
  {
    "id": "s0198",
    "blockIndex": 20,
    "zh": "太后恐亂起，亦欲倚漢威，數勸王及群臣求內屬；"
  },
  {
    "id": "s0199",
    "blockIndex": 20,
    "zh": "即因使者上書，請比內諸侯，三歲一朝，除邊關。"
  },
  {
    "id": "s0200",
    "blockIndex": 20,
    "zh": "於是天子許之，賜其丞相呂嘉銀印及內史、中尉、太傅印，餘得自置；"
  },
  {
    "id": "s0201",
    "blockIndex": 20,
    "zh": "除其故黥、劓刑，用漢法，比內諸侯。"
  },
  {
    "id": "s0202",
    "blockIndex": 20,
    "zh": "使者皆留，填撫之。"
  },
  {
    "id": "s0203",
    "blockIndex": 20,
    "zh": "----8上行幸雍，且郊，或曰：「五帝，泰一之佐也。"
  },
  {
    "id": "s0204",
    "blockIndex": 20,
    "zh": "宜立泰一，而上親郊。"
  },
  {
    "id": "s0205",
    "blockIndex": 20,
    "zh": "」上疑未定。"
  },
  {
    "id": "s0206",
    "blockIndex": 20,
    "zh": "齊人公孫卿曰：「今年得寶鼎，其冬辛巳朔旦冬至，與黃帝時等。"
  },
  {
    "id": "s0207",
    "blockIndex": 20,
    "zh": "」卿有札書曰：「黃帝得寶鼎，是歲己酉朔旦冬至，凡三百八十年，黃帝仙登於天。"
  },
  {
    "id": "s0208",
    "blockIndex": 20,
    "zh": "」因嬖人奏之。"
  },
  {
    "id": "s0209",
    "blockIndex": 20,
    "zh": "上大悅，召問，卿對曰：「受此書申公，申公曰：『漢興復當黃帝之時，漢之聖者在高祖之孫且曾孫也。"
  },
  {
    "id": "s0210",
    "blockIndex": 20,
    "zh": "寶鼎出而與神通，黃帝接萬靈明庭，明庭者甘泉也。"
  },
  {
    "id": "s0211",
    "blockIndex": 20,
    "zh": "黃帝采首山銅，鑄鼎於荊山下，鼎既成，有龍垂鬍髯下迎黃帝，黃帝上騎龍，與群臣後宮七十餘人俱登天。"
  },
  {
    "id": "s0212",
    "blockIndex": 20,
    "zh": "』」於是天子曰：「嗟乎！"
  },
  {
    "id": "s0213",
    "blockIndex": 20,
    "zh": "誠得如黃帝，吾視去妻子如脫屣耳！"
  },
  {
    "id": "s0214",
    "blockIndex": 20,
    "zh": "」拜卿為郎，使東候神於太室。"
  },
  {
    "id": "s0216",
    "blockIndex": 21,
    "zh": "1冬，十月，上祠五畤於雍，遂逾隴，西登崆峒。"
  },
  {
    "id": "s0217",
    "blockIndex": 21,
    "zh": "隴西守以行往卒，天子從官不得食，惶恐，自殺。"
  },
  {
    "id": "s0218",
    "blockIndex": 21,
    "zh": "於是上北出蕭關，從數萬騎獵新秦中，以勒邊兵而歸。"
  },
  {
    "id": "s0219",
    "blockIndex": 21,
    "zh": "新秦中或千里無亭徼，於是誅北地太守以下。"
  },
  {
    "id": "s0220",
    "blockIndex": 21,
    "zh": "上又幸甘泉，立泰一祠壇，所用祠具如雍一畤而有加焉。"
  },
  {
    "id": "s0221",
    "blockIndex": 21,
    "zh": "五帝壇環居其下四方地，為醊食群神從者及北斗-{云}-。"
  },
  {
    "id": "s0222",
    "blockIndex": 21,
    "zh": "十一月，辛巳朔，冬至，昧爽，天子始郊拜泰一，朝朝日，夕夕月則揖。"
  },
  {
    "id": "s0223",
    "blockIndex": 21,
    "zh": "其祠，列火滿壇，壇旁亨炊具。"
  },
  {
    "id": "s0224",
    "blockIndex": 21,
    "zh": "有司云：「祠上有光。"
  },
  {
    "id": "s0225",
    "blockIndex": 21,
    "zh": "」又云：「晝有黃氣上屬天。"
  },
  {
    "id": "s0226",
    "blockIndex": 21,
    "zh": "」太史令談、祠官寬舒等請三歲天子一郊見，詔從之。"
  },
  {
    "id": "s0227",
    "blockIndex": 21,
    "zh": "----2南越王、王太后飭治行裝，重賫為入朝具。"
  },
  {
    "id": "s0228",
    "blockIndex": 21,
    "zh": "其相呂嘉，年長矣，相三王，宗旅仕宦為長吏者七十餘人，男盡尚王女，女盡嫁王子弟、宗室，及蒼梧秦王有連，其居國中甚重，得眾心愈於王。"
  },
  {
    "id": "s0229",
    "blockIndex": 21,
    "zh": "王之上書，數諫止王，王弗聽；"
  },
  {
    "id": "s0230",
    "blockIndex": 21,
    "zh": "有畔心，數稱病，不見漢使者。"
  },
  {
    "id": "s0231",
    "blockIndex": 21,
    "zh": "使者皆注意嘉，勢未能誅。"
  },
  {
    "id": "s0232",
    "blockIndex": 21,
    "zh": "王、王太后亦恐嘉等先事發，欲介漢使者權，謀誅嘉等，乃置酒請使者，大臣皆侍坐飲。"
  },
  {
    "id": "s0233",
    "blockIndex": 21,
    "zh": "嘉弟為將，將卒居宮外。"
  },
  {
    "id": "s0234",
    "blockIndex": 21,
    "zh": "酒行，太后謂嘉曰：「南越內屬，國之利也；"
  },
  {
    "id": "s0235",
    "blockIndex": 21,
    "zh": "而相君苦不便者，何也？"
  },
  {
    "id": "s0236",
    "blockIndex": 21,
    "zh": "」以激怒使者，使者狐疑相杖，遂莫敢發。"
  },
  {
    "id": "s0237",
    "blockIndex": 21,
    "zh": "嘉見耳目非是，即起而出。"
  },
  {
    "id": "s0238",
    "blockIndex": 21,
    "zh": "太后怒，欲鏦嘉以矛，王止太后。"
  },
  {
    "id": "s0239",
    "blockIndex": 21,
    "zh": "嘉遂出，介其弟兵就舍，稱病，不肯見王及使者，陰與大臣謀作亂。"
  },
  {
    "id": "s0240",
    "blockIndex": 21,
    "zh": "王素無意誅嘉，嘉知之，以故數月不發。"
  },
  {
    "id": "s0241",
    "blockIndex": 22,
    "zh": "天子聞嘉不聽命，王、王太后孤弱不能制，使者怯無決；"
  },
  {
    "id": "s0242",
    "blockIndex": 22,
    "zh": "又以為王、王太后已附漢，獨呂嘉為亂，不足以興兵，欲使莊參以二千人往使。"
  },
  {
    "id": "s0243",
    "blockIndex": 22,
    "zh": "參曰：「以好往，數人足矣；"
  },
  {
    "id": "s0244",
    "blockIndex": 22,
    "zh": "以武往，二千人無足以為也。"
  },
  {
    "id": "s0245",
    "blockIndex": 22,
    "zh": "」辭不可，天子罷參。"
  },
  {
    "id": "s0246",
    "blockIndex": 22,
    "zh": "郟壯士故濟北相韓千秋奮曰：「以區區之越，又有王、王太后應，獨相呂嘉為害，願得勇士三百人，必斬嘉以報。"
  },
  {
    "id": "s0247",
    "blockIndex": 22,
    "zh": "」於是天子遣千秋與王太后弟樛樂將二千人往，入越境。"
  },
  {
    "id": "s0248",
    "blockIndex": 22,
    "zh": "呂嘉等乃遂反，下令國中曰：「王年少。"
  },
  {
    "id": "s0249",
    "blockIndex": 22,
    "zh": "太后，中國人也，又與使者亂，專欲內屬，盡持先王寶器入獻天子以自媚；"
  },
  {
    "id": "s0250",
    "blockIndex": 22,
    "zh": "多從人行，至長安，虜賣以為僮僕；"
  },
  {
    "id": "s0251",
    "blockIndex": 22,
    "zh": "取自脫一時之利，無顧趙氏社稷、為萬世慮計之意。"
  },
  {
    "id": "s0252",
    "blockIndex": 22,
    "zh": "」乃與其弟將卒攻殺王、王太后及漢使者，遣人告蒼梧秦王及其諸郡縣，立明王長男越妻子術陽侯建德為王。"
  },
  {
    "id": "s0253",
    "blockIndex": 22,
    "zh": "而韓千秋兵入，破數小邑。"
  },
  {
    "id": "s0254",
    "blockIndex": 22,
    "zh": "其後越開直道給食，未至番禺四十里，越以兵擊千秋等，遂滅之；"
  },
  {
    "id": "s0255",
    "blockIndex": 22,
    "zh": "使人函封漢使者節置塞上，好為謾辭謝罪，發兵守要害處。"
  },
  {
    "id": "s0256",
    "blockIndex": 23,
    "zh": "春，三月，壬午，天子聞南越反，曰：「韓千秋雖無功，亦軍鋒之冠，封其子延年為成安侯；"
  },
  {
    "id": "s0257",
    "blockIndex": 23,
    "zh": "樛樂姊為王太后，首願屬漢，封其子廣德為龍亢侯。"
  },
  {
    "id": "s0258",
    "blockIndex": 23,
    "zh": "」----3夏，四月，赦天下。"
  },
  {
    "id": "s0259",
    "blockIndex": 23,
    "zh": "----4丁丑晦，日有食之。"
  },
  {
    "id": "s0260",
    "blockIndex": 23,
    "zh": "----5秋，遣伏波將軍路博德出桂陽，下湟水；"
  },
  {
    "id": "s0261",
    "blockIndex": 23,
    "zh": "樓船將軍楊僕出豫章，下湞水；"
  },
  {
    "id": "s0262",
    "blockIndex": 23,
    "zh": "歸義越侯嚴為戈船將軍，出零陵，下離水；"
  },
  {
    "id": "s0263",
    "blockIndex": 23,
    "zh": "甲為下瀨將軍，下蒼梧；"
  },
  {
    "id": "s0264",
    "blockIndex": 23,
    "zh": "皆將罪人，江、淮以南樓船十萬人。"
  },
  {
    "id": "s0265",
    "blockIndex": 23,
    "zh": "越馳義侯遺別將巴、蜀罪人，發夜郎兵，下牂柯江，咸會番禺。"
  },
  {
    "id": "s0266",
    "blockIndex": 24,
    "zh": "齊相卜式上書，請父子與齊習船者往死南越。"
  },
  {
    "id": "s0267",
    "blockIndex": 24,
    "zh": "天子下詔褒美式，賜爵關內侯，金六十斤，田十頃，佈告天下；"
  },
  {
    "id": "s0268",
    "blockIndex": 24,
    "zh": "天下莫應。"
  },
  {
    "id": "s0269",
    "blockIndex": 24,
    "zh": "是時列侯以百數，皆莫求從軍擊越。"
  },
  {
    "id": "s0270",
    "blockIndex": 24,
    "zh": "會九月嘗酎，祭宗廟，列侯以令獻金助祭。"
  },
  {
    "id": "s0271",
    "blockIndex": 24,
    "zh": "少府省金，金有輕及色惡者，上皆令劾以不敬，奪爵者百六人。"
  },
  {
    "id": "s0272",
    "blockIndex": 24,
    "zh": "辛巳，丞相趙周坐知列侯酎金輕，下獄，自殺。"
  },
  {
    "id": "s0273",
    "blockIndex": 24,
    "zh": "----6丙申，以御史大夫石慶為丞相，封牧丘侯。"
  },
  {
    "id": "s0274",
    "blockIndex": 24,
    "zh": "時國家多事，桑弘羊等致利，王溫舒之屬峻法，而兒寬等推文學，皆為九卿，更進用事。"
  },
  {
    "id": "s0275",
    "blockIndex": 24,
    "zh": "事不關決於丞相，丞相慶醇謹而已。"
  },
  {
    "id": "s0276",
    "blockIndex": 24,
    "zh": "----7五利將軍裝治行，東入海求其師。"
  },
  {
    "id": "s0277",
    "blockIndex": 24,
    "zh": "既而不敢入海，之太山祠。"
  },
  {
    "id": "s0278",
    "blockIndex": 24,
    "zh": "上使人隨驗，實無所見。"
  },
  {
    "id": "s0279",
    "blockIndex": 24,
    "zh": "五利妄言見其師，其方盡多不售，坐誣罔，腰斬；"
  },
  {
    "id": "s0280",
    "blockIndex": 24,
    "zh": "樂成侯亦棄市。"
  },
  {
    "id": "s0281",
    "blockIndex": 24,
    "zh": "----8西羌眾十萬人反，與匈奴通使，攻故安，圍抱罕。"
  },
  {
    "id": "s0282",
    "blockIndex": 24,
    "zh": "匈奴入五原，殺太守。"
  },
  {
    "id": "s0284",
    "blockIndex": 25,
    "zh": "1冬，發卒十萬人，遣將軍李息、郎中令徐自為征西羌，平之。"
  },
  {
    "id": "s0285",
    "blockIndex": 25,
    "zh": "----2樓船將軍楊僕入越地，先陷尋峽，破石門，挫越鋒，以數萬人待伏波將軍路博德至俱進，樓船居前，至番禺。"
  },
  {
    "id": "s0286",
    "blockIndex": 25,
    "zh": "南越王建德、相呂嘉城守。"
  },
  {
    "id": "s0287",
    "blockIndex": 25,
    "zh": "樓船居東南面，伏波居西北面。"
  },
  {
    "id": "s0288",
    "blockIndex": 25,
    "zh": "會暮，樓船攻敗越人，縱火燒城。"
  },
  {
    "id": "s0289",
    "blockIndex": 25,
    "zh": "伏波為營，遣使者招降者，賜印綬，復縱令相招。"
  },
  {
    "id": "s0290",
    "blockIndex": 25,
    "zh": "樓船力攻燒敵，驅而入伏波營中。"
  },
  {
    "id": "s0291",
    "blockIndex": 25,
    "zh": "黎旦，城中皆降。"
  },
  {
    "id": "s0292",
    "blockIndex": 25,
    "zh": "建德、嘉已夜亡入海，伏波遣人追之。"
  },
  {
    "id": "s0293",
    "blockIndex": 25,
    "zh": "校尉司馬蘇弘得建德，越郎都稽得嘉。"
  },
  {
    "id": "s0294",
    "blockIndex": 25,
    "zh": "戈船、下瀨將軍兵及馳義侯所發夜郎兵未下，南越已平矣。"
  },
  {
    "id": "s0295",
    "blockIndex": 25,
    "zh": "遂以其地為南海、蒼梧、鬱林、合浦、交趾、九真、日南、珠崖、儋耳九郡。"
  },
  {
    "id": "s0296",
    "blockIndex": 25,
    "zh": "師還，上益封伏波；"
  },
  {
    "id": "s0297",
    "blockIndex": 25,
    "zh": "封樓船為將梁侯，蘇弘為海常侯，都稽為臨蔡侯，及越降將蒼梧王趙光等四人皆為侯。"
  },
  {
    "id": "s0298",
    "blockIndex": 25,
    "zh": "----3公孫卿候神河南，言見仙人跡緱氏城上。"
  },
  {
    "id": "s0299",
    "blockIndex": 25,
    "zh": "春，天子親幸緱氏城視跡，問卿：「得毋效文成、五利乎？"
  },
  {
    "id": "s0300",
    "blockIndex": 25,
    "zh": "」卿曰：「仙者非有求人主，人主者求之。"
  },
  {
    "id": "s0301",
    "blockIndex": 25,
    "zh": "其道非寬假，神不來。"
  },
  {
    "id": "s0302",
    "blockIndex": 25,
    "zh": "言神事如迂誕，積以歲月，乃可致也。"
  },
  {
    "id": "s0303",
    "blockIndex": 25,
    "zh": "」上信之。"
  },
  {
    "id": "s0304",
    "blockIndex": 25,
    "zh": "於是郡、國各除道，繕治宮觀、名山、神祠以望幸焉。"
  },
  {
    "id": "s0305",
    "blockIndex": 25,
    "zh": "----4賽南越，祠泰一、-{后土}-，始用樂舞。"
  },
  {
    "id": "s0306",
    "blockIndex": 25,
    "zh": "----5馳義侯發南夷兵，欲以擊南越。"
  },
  {
    "id": "s0307",
    "blockIndex": 25,
    "zh": "且蘭君恐遠行旁國，虜其老弱，乃與其眾反，殺使者及犍為太守。"
  },
  {
    "id": "s0308",
    "blockIndex": 25,
    "zh": "漢乃發巴、蜀罪人當擊南越者八校尉，遣中郎將郭昌、衛廣將而擊之，誅且蘭及邛君、莋侯，遂平南夷為牂柯郡。"
  },
  {
    "id": "s0309",
    "blockIndex": 25,
    "zh": "夜郎侯始倚南越，南越已滅，夜郎遂入朝，上以為夜郎王。"
  },
  {
    "id": "s0310",
    "blockIndex": 25,
    "zh": "冉駹皆振恐，清臣置吏，乃以邛都為越巂郡，莋都為沈黎郡，冉駹為汶山郡，廣漢西白馬為武都郡。"
  },
  {
    "id": "s0311",
    "blockIndex": 25,
    "zh": "----6初，東越王餘善上書，請以卒八千人從樓船擊呂嘉；"
  },
  {
    "id": "s0312",
    "blockIndex": 25,
    "zh": "兵至揭揚，以海風波為解，不行，持兩端，陰使南越。"
  },
  {
    "id": "s0313",
    "blockIndex": 25,
    "zh": "及漢破番禺，不至。"
  },
  {
    "id": "s0314",
    "blockIndex": 25,
    "zh": "楊僕上書願便引兵擊東越；"
  },
  {
    "id": "s0315",
    "blockIndex": 25,
    "zh": "上以士卒勞倦，不許，令諸校屯豫章、梅嶺以待命。"
  },
  {
    "id": "s0316",
    "blockIndex": 25,
    "zh": "餘善聞樓船請誅之，漢兵臨境，乃遂反，發兵距漢道，號將軍騶力等為吞漢將軍，入白沙、武林、梅嶺，殺漢三校尉。"
  },
  {
    "id": "s0317",
    "blockIndex": 25,
    "zh": "是時，漢使大農張成、故山州侯齒將屯，弗敢擊，卻就便處，皆坐畏懦誅。"
  },
  {
    "id": "s0318",
    "blockIndex": 25,
    "zh": "餘善自稱武帝。"
  },
  {
    "id": "s0319",
    "blockIndex": 26,
    "zh": "上欲復使楊僕將，為其伐前勞，以書敕責之曰：「將軍之功獨有先破石門、尋陿，非有斬將搴旗之實也，烏足以驕人哉！"
  },
  {
    "id": "s0320",
    "blockIndex": 26,
    "zh": "前破番禺，捕降者以為虜，掘死人以為獲，是一過也；"
  },
  {
    "id": "s0321",
    "blockIndex": 26,
    "zh": "使建德、呂嘉得以東越為援，是二過也；"
  },
  {
    "id": "s0322",
    "blockIndex": 26,
    "zh": "士卒暴露連歲，將軍不念其勤勞，而請乘傳行塞，因用歸家，懷銀、黃，垂三組，誇鄉里，是三過也；"
  },
  {
    "id": "s0323",
    "blockIndex": 26,
    "zh": "失期內顧，以道惡為解，是四過也；"
  },
  {
    "id": "s0324",
    "blockIndex": 26,
    "zh": "問君蜀刀價而陽不知，挾偽干君，是五過也。"
  },
  {
    "id": "s0325",
    "blockIndex": 26,
    "zh": "受詔不至蘭池，明日又不對。"
  },
  {
    "id": "s0326",
    "blockIndex": 26,
    "zh": "假令將軍之吏，問之不對，令之不從，其罪何如？"
  },
  {
    "id": "s0327",
    "blockIndex": 26,
    "zh": "推此心在外，江海之間可得信乎？"
  },
  {
    "id": "s0328",
    "blockIndex": 26,
    "zh": "今東越深入，將軍能率眾以掩過不？"
  },
  {
    "id": "s0329",
    "blockIndex": 26,
    "zh": "」僕惶恐對曰：「願盡死贖罪！"
  },
  {
    "id": "s0330",
    "blockIndex": 26,
    "zh": "」上乃遣橫海將軍韓說出句章，浮海從東方往；"
  },
  {
    "id": "s0331",
    "blockIndex": 26,
    "zh": "樓船將軍楊僕出武林，中尉王溫舒出梅嶺，以越侯為戈船、下瀨將軍，出若邪、白沙，以擊東越。"
  },
  {
    "id": "s0332",
    "blockIndex": 26,
    "zh": "----7博望侯既以通西域尊貴，其吏士爭上書言外國奇怪利害求使。"
  },
  {
    "id": "s0333",
    "blockIndex": 26,
    "zh": "天子為其絕遠，非人所樂往，聽其言，予節，募吏民，毋問所從來，為具備人眾遣之，以廣其道。"
  },
  {
    "id": "s0334",
    "blockIndex": 26,
    "zh": "來還，不能毋侵盜幣物及使失指，天子為其習之，輒覆按致重罪，以激怒令贖，復求使，使端無窮，而輕犯法。"
  },
  {
    "id": "s0335",
    "blockIndex": 26,
    "zh": "其吏卒亦輒復盛推外國所有，言大者予節，言小者為副，故妄言無行之徒皆爭效之。"
  },
  {
    "id": "s0336",
    "blockIndex": 26,
    "zh": "其使皆貧人子，私縣官賫物，欲賤市以私其利。"
  },
  {
    "id": "s0337",
    "blockIndex": 26,
    "zh": "外國亦厭漢使，人人有言輕重，度漢兵遠不能至，而禁其食物以苦漢使。"
  },
  {
    "id": "s0338",
    "blockIndex": 26,
    "zh": "漢使乏絕，積怨至相攻擊。"
  },
  {
    "id": "s0339",
    "blockIndex": 26,
    "zh": "而樓蘭、車師，小國當空道，攻漢使王恢等尤甚，而匈奴奇兵又時遮擊之。"
  },
  {
    "id": "s0340",
    "blockIndex": 26,
    "zh": "使者爭言西域皆有城邑，兵弱易擊。"
  },
  {
    "id": "s0341",
    "blockIndex": 26,
    "zh": "於是天子遣浮沮將軍公孫賀將萬五千騎，出九原二千餘里，至浮沮井而還；"
  },
  {
    "id": "s0342",
    "blockIndex": 26,
    "zh": "匈河將軍趙破奴將萬餘騎出令居數千里，至匈河水而還；"
  },
  {
    "id": "s0343",
    "blockIndex": 26,
    "zh": "以斥逐匈奴，不使遮漢使，皆不見匈奴一人。"
  },
  {
    "id": "s0344",
    "blockIndex": 26,
    "zh": "乃分武威、酒泉地置張掖、敦煌郡，徙民以實之。"
  },
  {
    "id": "s0345",
    "blockIndex": 26,
    "zh": "----8是歲，齊相卜式為御史大夫。"
  },
  {
    "id": "s0346",
    "blockIndex": 26,
    "zh": "式既在位，乃言：「郡、國多不便縣官作鹽鐵器，苦惡價貴，或強令民買之；"
  },
  {
    "id": "s0347",
    "blockIndex": 26,
    "zh": "而船有算，商者少，物貴。"
  },
  {
    "id": "s0348",
    "blockIndex": 26,
    "zh": "」上由是不悅卜式。"
  },
  {
    "id": "s0349",
    "blockIndex": 26,
    "zh": "----9初，司馬相如病且死，有遺書，頌功德，言符瑞，勸上封泰山。"
  },
  {
    "id": "s0350",
    "blockIndex": 26,
    "zh": "上感其言，會得寶鼎，上乃與公卿諸生議封禪。"
  },
  {
    "id": "s0351",
    "blockIndex": 26,
    "zh": "封禪用希曠絕，莫知其儀，而諸方士又言：「封禪者合不死之名也，黃帝以上，封禪皆致怪物，與神通，秦皇帝不得上封。"
  },
  {
    "id": "s0352",
    "blockIndex": 26,
    "zh": "陛下必欲上，稍上即無風雨，遂上封矣。"
  },
  {
    "id": "s0353",
    "blockIndex": 26,
    "zh": "」上於是乃令諸儒采《尚書》、《周官》、《王制》之文，草封禪儀，數年不成。"
  },
  {
    "id": "s0354",
    "blockIndex": 26,
    "zh": "上以問左內史兒寬，寬曰：「封泰山，禪梁父，昭姓考瑞，帝王之盛節也；"
  },
  {
    "id": "s0355",
    "blockIndex": 26,
    "zh": "然享薦之義，不著於《經》。"
  },
  {
    "id": "s0356",
    "blockIndex": 26,
    "zh": "臣以為封禪告成，合祛於天地神衹，唯聖主所由，制定其當，非群臣之所能列。"
  },
  {
    "id": "s0357",
    "blockIndex": 26,
    "zh": "今將舉大事，優遊數年，使群臣得人人自盡，終莫能成。"
  },
  {
    "id": "s0358",
    "blockIndex": 26,
    "zh": "唯天子建中和之極，兼總條貫，金聲而玉振之，以順成天慶，垂萬世之基。"
  },
  {
    "id": "s0359",
    "blockIndex": 26,
    "zh": "」上乃自製儀，頗采儒術以文之。"
  },
  {
    "id": "s0360",
    "blockIndex": 26,
    "zh": "上為封禪祠器，以示群儒，或曰「不與古同」，於是盡罷諸儒不用。"
  },
  {
    "id": "s0361",
    "blockIndex": 26,
    "zh": "上又以古者先振兵釋旅，然後封禪。"
  },
  {
    "id": "s0363",
    "blockIndex": 27,
    "zh": "1冬，十月，下詔曰：「南越、東甌，鹹伏其辜；"
  },
  {
    "id": "s0364",
    "blockIndex": 27,
    "zh": "西蠻、北夷，頗未輯睦；"
  },
  {
    "id": "s0365",
    "blockIndex": 27,
    "zh": "朕將巡邊垂，躬秉武節，置十二部將軍，親帥師焉。"
  },
  {
    "id": "s0366",
    "blockIndex": 27,
    "zh": "」乃行，自雲陽北歷上郡、西河、五原，出長城，北登單于台，至朔方，臨北河，遣使者郭吉告單于曰：「南越王頭已縣於漢北闕。"
  },
  {
    "id": "s0367",
    "blockIndex": 27,
    "zh": "今單于能戰，天子自將待邊；"
  },
  {
    "id": "s0368",
    "blockIndex": 27,
    "zh": "不能，即南面而臣於漢，何徒遠走亡匿於幕北寒苦無水草之地！"
  },
  {
    "id": "s0369",
    "blockIndex": 27,
    "zh": "毋為也。"
  },
  {
    "id": "s0371",
    "blockIndex": 28,
    "zh": "語卒而單于大怒，立斬主客見者，而留郭吉，遷之北海上。"
  },
  {
    "id": "s0372",
    "blockIndex": 28,
    "zh": "然匈奴亦讋，終不敢出。"
  },
  {
    "id": "s0373",
    "blockIndex": 28,
    "zh": "上乃還，祭黃帝塚橋山，釋兵須如。"
  },
  {
    "id": "s0374",
    "blockIndex": 28,
    "zh": "上曰：「吾聞黃帝不死，今有塚，何也？"
  },
  {
    "id": "s0375",
    "blockIndex": 28,
    "zh": "」公孫卿曰：「黃帝已仙上天，群臣思慕，葬其衣冠。"
  },
  {
    "id": "s0376",
    "blockIndex": 28,
    "zh": "」上歎曰：「吾後升天，群臣亦當葬吾衣冠於東陵乎？"
  },
  {
    "id": "s0377",
    "blockIndex": 28,
    "zh": "」乃還甘泉，類祠太一。"
  },
  {
    "id": "s0378",
    "blockIndex": 28,
    "zh": "----2上以卜式不習文章，貶秩為太子太傅，以兒寬代為御史大夫。"
  },
  {
    "id": "s0379",
    "blockIndex": 28,
    "zh": "----3漢兵入東越境，東越素發兵距險，使徇北將軍守武林。"
  },
  {
    "id": "s0380",
    "blockIndex": 28,
    "zh": "樓船將軍卒錢塘轅終古斬徇北將軍。"
  },
  {
    "id": "s0381",
    "blockIndex": 28,
    "zh": "故越衍侯吳陽以其邑七百人反攻越軍於漢陽。"
  },
  {
    "id": "s0382",
    "blockIndex": 28,
    "zh": "越建成侯敖與繇王居股殺餘善，以其眾降。"
  },
  {
    "id": "s0383",
    "blockIndex": 28,
    "zh": "上封終古為御兒侯，陽為卯石侯，居股為東成侯，敖為開陵侯；"
  },
  {
    "id": "s0384",
    "blockIndex": 28,
    "zh": "又封橫海將軍說為按道侯，橫海校尉福為繚嫈侯，東越降將多軍為無錫侯。"
  },
  {
    "id": "s0385",
    "blockIndex": 28,
    "zh": "上以閩地險阻，數反覆，終為後世患，乃詔諸將悉徙其民於江、淮之間，遂虛其地。"
  },
  {
    "id": "s0386",
    "blockIndex": 28,
    "zh": "----4春，正月，上行幸緱氏，禮祭中岳太室，從官在山下聞若有言「萬歲」者三。"
  },
  {
    "id": "s0387",
    "blockIndex": 28,
    "zh": "詔祠官加增太室祠，禁無伐其草木，以山下戶三百為之奉邑。"
  },
  {
    "id": "s0388",
    "blockIndex": 29,
    "zh": "上遂東巡海上，行禮祠八神。"
  },
  {
    "id": "s0389",
    "blockIndex": 29,
    "zh": "齊人之上疏言神怪、奇方者以萬數，乃益發船，令言海中神山者數千人求蓬萊神人。"
  },
  {
    "id": "s0390",
    "blockIndex": 29,
    "zh": "公孫卿持節常先行，候名山，至東萊，言：「夜見大人，長數丈，就之則不見，其跡甚大，類禽獸雲。"
  },
  {
    "id": "s0391",
    "blockIndex": 29,
    "zh": "」群臣有言：「見一老父牽狗，言『吾欲見巨公』，已忽不見。"
  },
  {
    "id": "s0392",
    "blockIndex": 29,
    "zh": "」上既見大跡，未信，及群臣又言老父，則大以為仙人也，宿留海上；"
  },
  {
    "id": "s0393",
    "blockIndex": 29,
    "zh": "與方士傳車及間使求神仙，人以千數。"
  },
  {
    "id": "s0394",
    "blockIndex": 30,
    "zh": "夏，四月，還，至奉高，禮祠地主於梁父。"
  },
  {
    "id": "s0395",
    "blockIndex": 30,
    "zh": "乙卯，令侍中儒者皮弁、搢紳，射牛行事，封泰山下東方，如郊祠泰一之禮。"
  },
  {
    "id": "s0396",
    "blockIndex": 30,
    "zh": "封廣丈二尺，高九尺，其下則有玉牒書，書秘。"
  },
  {
    "id": "s0397",
    "blockIndex": 30,
    "zh": "禮畢，天子獨與侍中、奉車都尉霍子侯上泰山，亦有封，其事皆禁。"
  },
  {
    "id": "s0398",
    "blockIndex": 30,
    "zh": "明日，下陰道。"
  },
  {
    "id": "s0399",
    "blockIndex": 30,
    "zh": "丙辰，禪泰山下阯東北肅然山，如祭-{后土}-禮，天子皆親拜見，衣上黃，而盡用樂焉。"
  },
  {
    "id": "s0400",
    "blockIndex": 30,
    "zh": "江、淮間茅三脊為神藉，五色土益雜封。"
  },
  {
    "id": "s0401",
    "blockIndex": 30,
    "zh": "其封禪祠，夜若有光，晝有白雲出封中。"
  },
  {
    "id": "s0402",
    "blockIndex": 30,
    "zh": "天子從禪還，坐明堂，群臣更上壽頌功德。"
  },
  {
    "id": "s0403",
    "blockIndex": 30,
    "zh": "詔曰：「朕以眇身承至尊，兢兢焉惟德菲薄，不明於禮樂，故用事八神，遭天地況施，著見景象，屑然如有聞，震於怪物，欲止不敢，遂登封泰山，至於梁父，然後升壇肅然自新，嘉與士大夫更始，其以十月為元封元年。"
  },
  {
    "id": "s0404",
    "blockIndex": 30,
    "zh": "行所巡至，博、奉高、蛇丘、歷城、梁父，民田租逋賦，皆貸除之，無出今年算。"
  },
  {
    "id": "s0405",
    "blockIndex": 30,
    "zh": "賜天下民爵一級。"
  },
  {
    "id": "s0406",
    "blockIndex": 30,
    "zh": "」又以五載一巡狩，用事泰山，令諸侯各治邸泰山下。"
  },
  {
    "id": "s0407",
    "blockIndex": 31,
    "zh": "天子既已封泰山，無風雨，而方士更言蓬萊諸神若將可得，於是上欣然庶幾遇之，復東至海上望焉。"
  },
  {
    "id": "s0408",
    "blockIndex": 31,
    "zh": "上欲自浮海求蓬萊，群臣諫，莫能止。"
  },
  {
    "id": "s0409",
    "blockIndex": 31,
    "zh": "東方朔曰：「夫仙者，得之自然，不必躁求。"
  },
  {
    "id": "s0410",
    "blockIndex": 31,
    "zh": "若其有道，不憂不得；"
  },
  {
    "id": "s0411",
    "blockIndex": 31,
    "zh": "若其無道，雖至蓬萊見仙人，亦無益也。"
  },
  {
    "id": "s0412",
    "blockIndex": 31,
    "zh": "臣願陛下第還宮靜處以須之，仙人將自至。"
  },
  {
    "id": "s0413",
    "blockIndex": 31,
    "zh": "」上乃止。"
  },
  {
    "id": "s0414",
    "blockIndex": 31,
    "zh": "會奉車霍子侯暴病，一日死。"
  },
  {
    "id": "s0415",
    "blockIndex": 31,
    "zh": "子侯，去病子也，上甚悼之；"
  },
  {
    "id": "s0416",
    "blockIndex": 31,
    "zh": "乃遂去，並海上，北至碣石，巡自遼西，歷北邊，至九原。"
  },
  {
    "id": "s0417",
    "blockIndex": 31,
    "zh": "五月，乃至甘泉。"
  },
  {
    "id": "s0418",
    "blockIndex": 31,
    "zh": "凡周行萬八千里-{云}-。"
  },
  {
    "id": "s0419",
    "blockIndex": 32,
    "zh": "先是，桑弘羊為治粟都尉，領大農，盡管天下鹽鐵。"
  },
  {
    "id": "s0420",
    "blockIndex": 32,
    "zh": "弘羊作平准之法，令遠方各以其物如異時商賈所轉販者為賦而相灌輸。"
  },
  {
    "id": "s0421",
    "blockIndex": 32,
    "zh": "置平准於京師，都受天下委輸。"
  },
  {
    "id": "s0422",
    "blockIndex": 32,
    "zh": "大農諸官，盡籠天下之貨物，貴即賣之，賤則買之，欲使富商大賈無所牟大利，而萬物不得騰踴。"
  },
  {
    "id": "s0423",
    "blockIndex": 32,
    "zh": "至是，天子巡狩郡縣，所過賞賜，用帛百餘萬匹，錢金以巨萬計，皆取足大農。"
  },
  {
    "id": "s0424",
    "blockIndex": 32,
    "zh": "弘羊又請令吏得入粟補官及罪人贖罪。"
  },
  {
    "id": "s0425",
    "blockIndex": 32,
    "zh": "山東漕粟益歲六百萬石，一歲之中，太倉、甘泉倉滿，邊餘谷，諸物均輸，帛五百萬匹，民不益賦而天下用饒。"
  },
  {
    "id": "s0426",
    "blockIndex": 32,
    "zh": "於是弘羊賜爵左庶長，黃金再百斤焉。"
  },
  {
    "id": "s0427",
    "blockIndex": 33,
    "zh": "是時小旱，上令官求雨。"
  },
  {
    "id": "s0428",
    "blockIndex": 33,
    "zh": "卜式言曰：「縣官當食租衣稅而已，今弘羊令吏坐市列肆，販物求利。"
  },
  {
    "id": "s0429",
    "blockIndex": 33,
    "zh": "烹弘羊，天乃雨。"
  },
  {
    "id": "s0430",
    "blockIndex": 33,
    "zh": "」----5秋，有星孛於東井，後十餘日，有星孛於三台。"
  },
  {
    "id": "s0431",
    "blockIndex": 33,
    "zh": "望氣王朔言：「候獨見填星出如瓜，食頃，復入。"
  },
  {
    "id": "s0432",
    "blockIndex": 33,
    "zh": "」有司皆曰：「陛下建漢家封禪，天其報德星-{云}-。"
  },
  {
    "id": "s0433",
    "blockIndex": 33,
    "zh": "」----6齊懷王閎薨，無子，國除。"
  },
  {
    "id": "s0435",
    "blockIndex": 34,
    "zh": "category:資治通鑑"
  }
]
