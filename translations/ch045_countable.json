[
  {
    "id": "s0001",
    "blockIndex": 0,
    "zh": "資治通鑑第045卷"
  },
  {
    "id": "s0002",
    "blockIndex": 1,
    "zh": "【漢紀三十七】起重光作噩，盡旃蒙大淵獻，凡十五年。"
  },
  {
    "id": "s0003",
    "blockIndex": 2,
    "zh": "春，帝近出觀覽城第，欲遂校獵河內；"
  },
  {
    "id": "s0004",
    "blockIndex": 2,
    "zh": "東平王蒼上書諫；"
  },
  {
    "id": "s0005",
    "blockIndex": 2,
    "zh": "帝覽奏，即還宮。"
  },
  {
    "id": "s0006",
    "blockIndex": 3,
    "zh": "秋，九月，戊寅，千乘哀王建薨，無子，國除。"
  },
  {
    "id": "s0007",
    "blockIndex": 4,
    "zh": "冬，十月，乙卯，司徒郭丹、司空馮魴免，以河南尹沛國范遷為司徒，太仆伏恭為司空。"
  },
  {
    "id": "s0008",
    "blockIndex": 4,
    "zh": "恭，湛之兄子也。"
  },
  {
    "id": "s0009",
    "blockIndex": 5,
    "zh": "陵鄉侯梁松坐怨望、縣飛書誹謗，下獄死。"
  },
  {
    "id": "s0010",
    "blockIndex": 5,
    "zh": "初，上為太子，太中大夫鄭興子眾以通經知名，太子及山陽王荊因梁松以縑帛請之，眾曰：「太子儲君，無外交之義。"
  },
  {
    "id": "s0011",
    "blockIndex": 5,
    "zh": "漢有舊防，蕃王不宜私通賓客。"
  },
  {
    "id": "s0012",
    "blockIndex": 5,
    "zh": "」松曰：「長者意，不可逆。"
  },
  {
    "id": "s0013",
    "blockIndex": 5,
    "zh": "」眾曰：「犯禁觸罪，不如守正而死。"
  },
  {
    "id": "s0014",
    "blockIndex": 5,
    "zh": "」遂不往。"
  },
  {
    "id": "s0015",
    "blockIndex": 5,
    "zh": "及松敗，賓客多坐之，唯眾不染於辭。"
  },
  {
    "id": "s0016",
    "blockIndex": 6,
    "zh": "於窴王廣德將諸國兵三萬人攻莎車，誘莎車王賢，殺之，並其國。"
  },
  {
    "id": "s0017",
    "blockIndex": 6,
    "zh": "匈奴發諸國兵圍於窴，廣德請降。"
  },
  {
    "id": "s0018",
    "blockIndex": 6,
    "zh": "匈奴立賢質子不居征為莎車王，廣德又攻殺之，更立其弟齊黎為莎車王。"
  },
  {
    "id": "s0019",
    "blockIndex": 6,
    "zh": "東平王蒼自以至親輔政，聲望日重，意不自安，前後累上疏稱：「自漢興以來，宗室子弟無得在公卿位者，乞上驃騎將軍印綬，退就蕃國。"
  },
  {
    "id": "s0020",
    "blockIndex": 6,
    "zh": "」辭甚懇切，帝乃許蒼還國，而不聽上將軍印綬。"
  },
  {
    "id": "s0021",
    "blockIndex": 7,
    "zh": "春，二月，庚戌，蒼罷歸籓。"
  },
  {
    "id": "s0022",
    "blockIndex": 7,
    "zh": "帝以驃騎長史為東平太傅，掾為中大夫，令史為王家郎，加賜錢五千萬，布十萬匹。"
  },
  {
    "id": "s0023",
    "blockIndex": 8,
    "zh": "冬，十月，上行幸鄴；"
  },
  {
    "id": "s0024",
    "blockIndex": 8,
    "zh": "是月還宮。"
  },
  {
    "id": "s0025",
    "blockIndex": 9,
    "zh": "十一月，北匈奴寇五原；"
  },
  {
    "id": "s0026",
    "blockIndex": 9,
    "zh": "十二月，寇雲中。"
  },
  {
    "id": "s0027",
    "blockIndex": 9,
    "zh": "南單于擊卻之。"
  },
  {
    "id": "s0028",
    "blockIndex": 10,
    "zh": "是歲，發遣邊民在內郡者，賜裝錢，人二萬。"
  },
  {
    "id": "s0029",
    "blockIndex": 11,
    "zh": "安豐戴侯竇融年老，子孫縱誕，多不法。"
  },
  {
    "id": "s0030",
    "blockIndex": 11,
    "zh": "長子穆尚內黃公主。"
  },
  {
    "id": "s0031",
    "blockIndex": 11,
    "zh": "矯稱陰太后詔，令六安侯劉盱去婦，以女妻之。"
  },
  {
    "id": "s0032",
    "blockIndex": 11,
    "zh": "盱婦家上書言狀，帝大怒。"
  },
  {
    "id": "s0033",
    "blockIndex": 11,
    "zh": "盡免穆等官，諸竇為郎吏者，皆將家屬歸故郡，獨留融京師；"
  },
  {
    "id": "s0034",
    "blockIndex": 11,
    "zh": "融尋薨。"
  },
  {
    "id": "s0035",
    "blockIndex": 11,
    "zh": "後數歲，穆等復坐事與子勳、宣皆下獄死。"
  },
  {
    "id": "s0036",
    "blockIndex": 11,
    "zh": "久之，詔還融夫人與小孫一人居雒陽。"
  },
  {
    "id": "s0037",
    "blockIndex": 12,
    "zh": "春，二月，王雒山出寶鼎，獻之。"
  },
  {
    "id": "s0038",
    "blockIndex": 12,
    "zh": "夏，四月，甲子，詔曰：「祥瑞之降，以應有德；"
  },
  {
    "id": "s0039",
    "blockIndex": 12,
    "zh": "方今政化多僻，何以致茲！"
  },
  {
    "id": "s0040",
    "blockIndex": 12,
    "zh": "《易》曰：『鼎像三公，』豈公卿奉職得其理邪！"
  },
  {
    "id": "s0041",
    "blockIndex": 12,
    "zh": "其賜三公帛五十匹，九卿、二千石半之。"
  },
  {
    "id": "s0042",
    "blockIndex": 12,
    "zh": "先帝詔書，禁人上事言聖，而間者章奏頗多浮詞；"
  },
  {
    "id": "s0043",
    "blockIndex": 12,
    "zh": "自今若有過稱虛譽，尚書皆宜抑而不省，示不為諂子蚩也。"
  },
  {
    "id": "s0045",
    "blockIndex": 13,
    "zh": "冬，十月，上行幸魯；"
  },
  {
    "id": "s0046",
    "blockIndex": 13,
    "zh": "十二月，還幸陽城；"
  },
  {
    "id": "s0047",
    "blockIndex": 13,
    "zh": "壬午，還宮。"
  },
  {
    "id": "s0048",
    "blockIndex": 14,
    "zh": "是歲，南單于適死，單于莫之子蘇立，為丘除車林鞮單于；"
  },
  {
    "id": "s0049",
    "blockIndex": 14,
    "zh": "數月，復死，單于適之弟長立，為湖邪屍逐侯鞮單于。"
  },
  {
    "id": "s0050",
    "blockIndex": 15,
    "zh": "春，正月，癸卯，皇太后陰氏崩。"
  },
  {
    "id": "s0051",
    "blockIndex": 15,
    "zh": "二月，庚申，葬光烈皇后。"
  },
  {
    "id": "s0052",
    "blockIndex": 16,
    "zh": "北匈奴猶盛，數寇邊，遣使求合市；"
  },
  {
    "id": "s0053",
    "blockIndex": 16,
    "zh": "上冀其交通，不復為寇，許之。"
  },
  {
    "id": "s0054",
    "blockIndex": 17,
    "zh": "以東海相宋均為尚書令。"
  },
  {
    "id": "s0055",
    "blockIndex": 17,
    "zh": "初，均為九江太守，五日一聽事，悉省掾、史，閉督郵府內，屬縣無事，百姓安業。"
  },
  {
    "id": "s0056",
    "blockIndex": 17,
    "zh": "九江舊多虎暴，常募設檻阱，而猶多傷害。"
  },
  {
    "id": "s0057",
    "blockIndex": 17,
    "zh": "均下記屬縣曰：「夫江、淮之有猛獸，猶北土之有雞豚也，今為民害，咎在殘吏，而勞勤張捕，非憂恤之本也。"
  },
  {
    "id": "s0058",
    "blockIndex": 17,
    "zh": "其務退奸貪，思進忠善，可一去檻阱，除削課制。"
  },
  {
    "id": "s0059",
    "blockIndex": 17,
    "zh": "」其後無復虎患。"
  },
  {
    "id": "s0060",
    "blockIndex": 17,
    "zh": "帝聞均名，故任以樞機。"
  },
  {
    "id": "s0061",
    "blockIndex": 17,
    "zh": "均謂人曰：「國家喜文法、廉吏，以為足止奸也；"
  },
  {
    "id": "s0062",
    "blockIndex": 17,
    "zh": "然文吏習為欺謾，而廉吏清在一己，無益百姓流亡、盜賊為害也。"
  },
  {
    "id": "s0063",
    "blockIndex": 17,
    "zh": "均欲叩頭爭之，時未可改也，久將自苦之，乃可言耳！"
  },
  {
    "id": "s0064",
    "blockIndex": 17,
    "zh": "」未及言，會遷司隸校尉。"
  },
  {
    "id": "s0065",
    "blockIndex": 17,
    "zh": "後上聞其言，追善之。"
  },
  {
    "id": "s0066",
    "blockIndex": 18,
    "zh": "春，正月，己卯，司徒范遷薨。"
  },
  {
    "id": "s0067",
    "blockIndex": 19,
    "zh": "三月，辛卯，以太尉虞延為司徒，衛尉趙熹行太尉事。"
  },
  {
    "id": "s0068",
    "blockIndex": 20,
    "zh": "越騎司馬鄭眾使北匈奴，單于欲令眾拜，眾不為屈。"
  },
  {
    "id": "s0069",
    "blockIndex": 20,
    "zh": "單于圍守，閉之不與水火；"
  },
  {
    "id": "s0070",
    "blockIndex": 20,
    "zh": "眾拔刀自誓，單于恐而止，乃更發使，隨眾還京師。"
  },
  {
    "id": "s0071",
    "blockIndex": 20,
    "zh": "初，大司農耿國上言：「宜置度遼將軍屯五原，以防南匈奴逃亡。"
  },
  {
    "id": "s0072",
    "blockIndex": 20,
    "zh": "」朝廷不從，南匈奴須卜骨都侯等知漢與北虜交使，內懷嫌怨，欲畔，密使人詣北虜，令遣兵迎之。"
  },
  {
    "id": "s0073",
    "blockIndex": 20,
    "zh": "鄭眾出塞，疑有異；"
  },
  {
    "id": "s0074",
    "blockIndex": 20,
    "zh": "伺候，果得須卜使人。"
  },
  {
    "id": "s0075",
    "blockIndex": 20,
    "zh": "乃上言：「宜更置大將，以防二虜交通。"
  },
  {
    "id": "s0076",
    "blockIndex": 20,
    "zh": "」由是始置度遼營，以中郎將吳棠行度遼將軍事，將黎陽虎牙營士屯五原曼柏。"
  },
  {
    "id": "s0077",
    "blockIndex": 21,
    "zh": "秋，郡國十四大水。"
  },
  {
    "id": "s0078",
    "blockIndex": 22,
    "zh": "冬，十月，北宮成。"
  },
  {
    "id": "s0079",
    "blockIndex": 23,
    "zh": "丙子，募死罪系囚詣度遼營；"
  },
  {
    "id": "s0080",
    "blockIndex": 23,
    "zh": "有罪亡命者，令贖罪各有差。"
  },
  {
    "id": "s0081",
    "blockIndex": 23,
    "zh": "楚王英奉黃縑、白紈詣國相曰：「托在籓輔，過惡累積，歡喜大恩，奉送縑帛，以贖愆罪。"
  },
  {
    "id": "s0082",
    "blockIndex": 23,
    "zh": "」國相以聞。"
  },
  {
    "id": "s0083",
    "blockIndex": 23,
    "zh": "詔報曰：「楚王誦黃、老之微言，尚浮屠之仁祠，潔齊三月，與神為誓，何嫌何疑，當有悔吝！"
  },
  {
    "id": "s0084",
    "blockIndex": 23,
    "zh": "其還贖，以助伊蒲塞、桑門之盛饌。"
  },
  {
    "id": "s0085",
    "blockIndex": 23,
    "zh": "」初，帝聞西域有神，其名曰佛，因遣使之天竺求其道，得其書及沙門以來。"
  },
  {
    "id": "s0086",
    "blockIndex": 23,
    "zh": "其書大抵以虛無為宗，貴慈悲不殺；"
  },
  {
    "id": "s0087",
    "blockIndex": 23,
    "zh": "以為人死，精神不滅，隨復受形；"
  },
  {
    "id": "s0088",
    "blockIndex": 23,
    "zh": "生時所行善惡，皆有報應，故所貴修練精神，以至為佛；"
  },
  {
    "id": "s0089",
    "blockIndex": 23,
    "zh": "善為宏闊勝大之言以勸誘愚俗。"
  },
  {
    "id": "s0090",
    "blockIndex": 23,
    "zh": "精於其道者，號曰沙門。"
  },
  {
    "id": "s0091",
    "blockIndex": 23,
    "zh": "於是中國始傳其術，圖其形像，而王公貴人，獨楚王英最先好之。"
  },
  {
    "id": "s0092",
    "blockIndex": 24,
    "zh": "壬寅晦，日有食之，既。"
  },
  {
    "id": "s0093",
    "blockIndex": 24,
    "zh": "詔群司勉修職事，極言無諱。"
  },
  {
    "id": "s0094",
    "blockIndex": 24,
    "zh": "於是在位者皆上封事，各言得失；"
  },
  {
    "id": "s0095",
    "blockIndex": 24,
    "zh": "帝覽章，深自引咎，以所上班示百官。"
  },
  {
    "id": "s0096",
    "blockIndex": 24,
    "zh": "詔曰：「群僚所言，皆朕之過。"
  },
  {
    "id": "s0097",
    "blockIndex": 24,
    "zh": "民冤不能理，吏黠不能禁；"
  },
  {
    "id": "s0098",
    "blockIndex": 24,
    "zh": "而輕用民力，繕修宮宇，出入無節，喜怒過差。"
  },
  {
    "id": "s0099",
    "blockIndex": 24,
    "zh": "永覽前戒，辣然兢懼；"
  },
  {
    "id": "s0100",
    "blockIndex": 24,
    "zh": "徒恐薄德，久而致怠耳！"
  },
  {
    "id": "s0102",
    "blockIndex": 25,
    "zh": "北匈奴雖遣使入貢，而寇鈔不息，邊城晝閉。"
  },
  {
    "id": "s0103",
    "blockIndex": 25,
    "zh": "帝議遣使報其使者，鄭眾上疏諫曰：「臣聞北單于所以要致漢使者，欲以離南單于之眾，堅三十六國之心也；"
  },
  {
    "id": "s0104",
    "blockIndex": 25,
    "zh": "又當揚漢和親，誇示鄰敵，令西域欲歸化者局足狐疑，懷土之人絕望中國耳。"
  },
  {
    "id": "s0105",
    "blockIndex": 25,
    "zh": "漢使既到，便偃蹇自信；"
  },
  {
    "id": "s0106",
    "blockIndex": 25,
    "zh": "若復遣之，虜必自謂得謀，其群臣駁議者不敢復言。"
  },
  {
    "id": "s0107",
    "blockIndex": 25,
    "zh": "如是，南庭動搖，烏桓有離心矣。"
  },
  {
    "id": "s0108",
    "blockIndex": 25,
    "zh": "南單于久居漢地，具知形勢，萬分離析，旋為邊害。"
  },
  {
    "id": "s0109",
    "blockIndex": 25,
    "zh": "今幸有度遼之眾揚威北垂，雖勿報答，不敢為患。"
  },
  {
    "id": "s0110",
    "blockIndex": 25,
    "zh": "」帝不從，復遣眾往。"
  },
  {
    "id": "s0111",
    "blockIndex": 25,
    "zh": "眾因上言：「臣前奉使，不為匈奴拜，單于恚恨。"
  },
  {
    "id": "s0112",
    "blockIndex": 25,
    "zh": "遣兵圍臣；"
  },
  {
    "id": "s0113",
    "blockIndex": 25,
    "zh": "今復銜命，必見陵折，臣誠不忍持大漢節對氈裘獨拜，如令匈奴遂能服臣，將有損大漢之強。"
  },
  {
    "id": "s0114",
    "blockIndex": 25,
    "zh": "」帝不聽。"
  },
  {
    "id": "s0115",
    "blockIndex": 25,
    "zh": "眾不得已，既行，在路連上書固爭之；"
  },
  {
    "id": "s0116",
    "blockIndex": 25,
    "zh": "詔切責眾，追還，系廷尉，會赦，歸家。"
  },
  {
    "id": "s0117",
    "blockIndex": 25,
    "zh": "其後帝見匈奴來者，聞眾與單于爭禮之狀，乃復召眾為軍司馬。"
  },
  {
    "id": "s0118",
    "blockIndex": 26,
    "zh": "夏，四月，甲辰，詔司隸校尉、部刺史歲上墨綬長吏視事三歲已上、治狀尤異者各一人與計偕上，及尤不治者亦以聞。"
  },
  {
    "id": "s0119",
    "blockIndex": 27,
    "zh": "是歲，大有年。"
  },
  {
    "id": "s0120",
    "blockIndex": 28,
    "zh": "賜皇子恭號曰靈壽王，黨號曰重熹王，未有國邑。"
  },
  {
    "id": "s0121",
    "blockIndex": 29,
    "zh": "帝崇尚儒學，自皇太子、諸王侯及大臣子弟、功臣子孫，莫不受經。"
  },
  {
    "id": "s0122",
    "blockIndex": 29,
    "zh": "又為外戚樊氏、郭氏、陰氏、馬氏諸子立學於南宮，號「四姓小侯」。"
  },
  {
    "id": "s0123",
    "blockIndex": 29,
    "zh": "置《五經》師，搜選高能以授其業。"
  },
  {
    "id": "s0124",
    "blockIndex": 29,
    "zh": "自期門、羽林之士，悉令通《孝經》章句。"
  },
  {
    "id": "s0125",
    "blockIndex": 29,
    "zh": "匈奴亦遣子入學。"
  },
  {
    "id": "s0126",
    "blockIndex": 30,
    "zh": "廣陵王荊復呼相工謂曰：「我貌類先帝，先帝三十得天下，我今亦三十，可起兵未？"
  },
  {
    "id": "s0127",
    "blockIndex": 30,
    "zh": "」相者詣吏告之，荊惶恐，自繫獄，帝加恩，不考極其事，詔不得臣屬吏民，唯食租如故，使相、中尉謹宿衛之。"
  },
  {
    "id": "s0128",
    "blockIndex": 30,
    "zh": "荊又使巫祭祀、祝詛。"
  },
  {
    "id": "s0129",
    "blockIndex": 30,
    "zh": "詔長水校尉樊鯈等雜治其獄，事竟，奏請誅刑。"
  },
  {
    "id": "s0130",
    "blockIndex": 30,
    "zh": "帝怒曰；"
  },
  {
    "id": "s0131",
    "blockIndex": 30,
    "zh": "「諸卿以我弟故，欲誅之。"
  },
  {
    "id": "s0132",
    "blockIndex": 30,
    "zh": "即我子，卿等敢爾邪？"
  },
  {
    "id": "s0133",
    "blockIndex": 30,
    "zh": "」鯈對曰：「天下者高帝天下，非陛下之天下也。"
  },
  {
    "id": "s0134",
    "blockIndex": 30,
    "zh": "《春秋》之義，君親無將，將而必誅。"
  },
  {
    "id": "s0135",
    "blockIndex": 30,
    "zh": "臣等以荊屬托母弟，陛下留聖心，加惻隱，故敢請耳；"
  },
  {
    "id": "s0136",
    "blockIndex": 30,
    "zh": "如令陛下子，臣等專誅而已。"
  },
  {
    "id": "s0137",
    "blockIndex": 30,
    "zh": "」帝歎息善之。"
  },
  {
    "id": "s0138",
    "blockIndex": 30,
    "zh": "鯈，宏之子也。"
  },
  {
    "id": "s0139",
    "blockIndex": 31,
    "zh": "春，二月，廣陵思王荊自殺，國除。"
  },
  {
    "id": "s0140",
    "blockIndex": 32,
    "zh": "夏，四月，戊子，赦天下。"
  },
  {
    "id": "s0141",
    "blockIndex": 33,
    "zh": "閏月，甲午，上幸南陽，召校官弟子作雅樂，奏《鹿鳴》，帝自御塤篪和之，以娛嘉賓。"
  },
  {
    "id": "s0142",
    "blockIndex": 33,
    "zh": "還，幸南頓。"
  },
  {
    "id": "s0143",
    "blockIndex": 34,
    "zh": "冬，十二月，甲午，還宮。"
  },
  {
    "id": "s0144",
    "blockIndex": 35,
    "zh": "初，陵陽侯丁綝卒，子鴻當襲封，上書稱病，讓國於弟盛，不報。"
  },
  {
    "id": "s0145",
    "blockIndex": 35,
    "zh": "既葬，乃掛衰絰於塚廬而逃去。"
  },
  {
    "id": "s0146",
    "blockIndex": 35,
    "zh": "友人九江鮑駿遇鴻於東海，讓之曰；"
  },
  {
    "id": "s0147",
    "blockIndex": 35,
    "zh": "「昔伯夷、吳札，亂世權行，故得申其志耳。"
  },
  {
    "id": "s0148",
    "blockIndex": 35,
    "zh": "《春秋》之義，不以家事廢王事。"
  },
  {
    "id": "s0149",
    "blockIndex": 35,
    "zh": "今子以兄弟私恩而絕父不滅之基，可乎？"
  },
  {
    "id": "s0150",
    "blockIndex": 35,
    "zh": "」鴻感悟垂涕，乃還就國。"
  },
  {
    "id": "s0151",
    "blockIndex": 35,
    "zh": "鮑駿因上書薦鴻經學至行，上征鴻為侍中。"
  },
  {
    "id": "s0152",
    "blockIndex": 36,
    "zh": "春，正月，東平王蒼與諸王俱來朝，月餘，還國。"
  },
  {
    "id": "s0153",
    "blockIndex": 36,
    "zh": "帝臨送歸宮，淒然懷思，乃遣使手詔賜東平國中傅曰：「辭別之後，獨坐不樂，因就車歸，伏軾而吟，瞻望永懷，實勞我心。"
  },
  {
    "id": "s0154",
    "blockIndex": 36,
    "zh": "誦及《采菽》，以增歎息。"
  },
  {
    "id": "s0155",
    "blockIndex": 36,
    "zh": "日者問東平王：『處家何等最樂？"
  },
  {
    "id": "s0156",
    "blockIndex": 36,
    "zh": "』王言：『為善最樂。"
  },
  {
    "id": "s0157",
    "blockIndex": 36,
    "zh": "』其言甚大，副是要腹矣。"
  },
  {
    "id": "s0158",
    "blockIndex": 36,
    "zh": "今送列侯印十九枚，"
  },
  {
    "id": "s0159",
    "blockIndex": 37,
    "zh": "諸王子年五歲已上能趨拜者，皆令帶之。"
  },
  {
    "id": "s0161",
    "blockIndex": 38,
    "zh": "春，哀牢王柳貌率其民五萬餘戶內附，以其地置哀牢、博南二縣。"
  },
  {
    "id": "s0162",
    "blockIndex": 38,
    "zh": "始通博南山，度蘭倉水，行者苦之，"
  },
  {
    "id": "s0163",
    "blockIndex": 39,
    "zh": "歌曰：「漢德廣，開不賓；"
  },
  {
    "id": "s0164",
    "blockIndex": 39,
    "zh": "度蘭倉，為它人。"
  },
  {
    "id": "s0166",
    "blockIndex": 40,
    "zh": "初，平帝時，河、汴決壞，久而不修。"
  },
  {
    "id": "s0167",
    "blockIndex": 40,
    "zh": "建武十年，光武欲修之；"
  },
  {
    "id": "s0168",
    "blockIndex": 40,
    "zh": "浚儀令樂俊上言，民新被兵革，未宜興役，乃止。"
  },
  {
    "id": "s0169",
    "blockIndex": 40,
    "zh": "其後汴渠東侵，日月彌廣，兗、豫百姓怨歎，以為縣官恆興佗役，不先民急，會有薦樂浪王景能治水者，夏，四月，詔發卒數十萬，遣景與將作謁者王吳修汴渠堤，自滎陽東至千乘海口千餘里，十里立一水門，令更相洄注，無復潰漏之患。"
  },
  {
    "id": "s0170",
    "blockIndex": 40,
    "zh": "景雖簡省役費，然猶以百億計焉。"
  },
  {
    "id": "s0171",
    "blockIndex": 41,
    "zh": "秋，七月，乙亥，司空伏恭罷；"
  },
  {
    "id": "s0172",
    "blockIndex": 41,
    "zh": "乙未，以大司農牟融為司空。"
  },
  {
    "id": "s0173",
    "blockIndex": 42,
    "zh": "是時，天下安平，人無徭役，歲比登稔，百姓殷富，粟斛三十，牛羊被野。"
  },
  {
    "id": "s0174",
    "blockIndex": 43,
    "zh": "夏，四月，汴渠成；"
  },
  {
    "id": "s0175",
    "blockIndex": 43,
    "zh": "河、汴分流，復其舊跡。"
  },
  {
    "id": "s0176",
    "blockIndex": 43,
    "zh": "辛乙，帝行幸滎陽，巡行河渠，遂渡河，登太行，幸上黨；"
  },
  {
    "id": "s0177",
    "blockIndex": 43,
    "zh": "壬寅，還宮。"
  },
  {
    "id": "s0178",
    "blockIndex": 44,
    "zh": "冬，十月，壬辰晦，日有食之。"
  },
  {
    "id": "s0179",
    "blockIndex": 45,
    "zh": "楚王英與方士作金龜、玉鶴，刻文字為符瑞。"
  },
  {
    "id": "s0180",
    "blockIndex": 45,
    "zh": "男子燕廣告英與漁陽王平、顏忠等造作圖書，有逆謀；"
  },
  {
    "id": "s0181",
    "blockIndex": 45,
    "zh": "事下案驗。"
  },
  {
    "id": "s0182",
    "blockIndex": 45,
    "zh": "有司奏「英大逆不道，請誅之。"
  },
  {
    "id": "s0183",
    "blockIndex": 45,
    "zh": "」帝以親親不忍。"
  },
  {
    "id": "s0184",
    "blockIndex": 45,
    "zh": "十一月，廢英，徙丹楊涇縣，賜湯沐邑五百戶；"
  },
  {
    "id": "s0185",
    "blockIndex": 45,
    "zh": "男女為侯、主者，食邑如故；"
  },
  {
    "id": "s0186",
    "blockIndex": 45,
    "zh": "許太后勿上璽綬，留住楚宮。"
  },
  {
    "id": "s0187",
    "blockIndex": 45,
    "zh": "先是有私以英謀告司徒虞延者，延以英籓戚至親，不然其言。"
  },
  {
    "id": "s0188",
    "blockIndex": 45,
    "zh": "及英事覺，詔書切讓延。"
  },
  {
    "id": "s0189",
    "blockIndex": 46,
    "zh": "春，三月，甲戌，延自殺。"
  },
  {
    "id": "s0190",
    "blockIndex": 46,
    "zh": "以太常周澤行司徒事；"
  },
  {
    "id": "s0191",
    "blockIndex": 46,
    "zh": "頃之，復為太常。"
  },
  {
    "id": "s0192",
    "blockIndex": 46,
    "zh": "夏，四月，丁巳，以巨鹿太守南陽邢穆為司徒。"
  },
  {
    "id": "s0193",
    "blockIndex": 47,
    "zh": "楚王英至丹楊，自殺。"
  },
  {
    "id": "s0194",
    "blockIndex": 47,
    "zh": "詔以諸侯禮葬於涇。"
  },
  {
    "id": "s0195",
    "blockIndex": 47,
    "zh": "封燕廣為折奸侯。"
  },
  {
    "id": "s0196",
    "blockIndex": 47,
    "zh": "是時，窮治楚獄，遂至累年。"
  },
  {
    "id": "s0197",
    "blockIndex": 47,
    "zh": "其辭語相連，自京師親戚、諸侯、州郡豪桀及考案吏，阿附坐死、徙者以千數，而繫獄者尚數千人。"
  },
  {
    "id": "s0198",
    "blockIndex": 48,
    "zh": "初，樊鯈弟鮪為其子賞求楚王英女，鯈聞而止之曰：「建武中，吾家並受榮寵，一宗五侯。"
  },
  {
    "id": "s0199",
    "blockIndex": 48,
    "zh": "時特進一言，女可以配王，男可以尚主；"
  },
  {
    "id": "s0200",
    "blockIndex": 48,
    "zh": "但以貴寵過盛，即為禍患，故不為也，且爾一子，奈何棄之於楚乎！"
  },
  {
    "id": "s0201",
    "blockIndex": 48,
    "zh": "」鮪不從。"
  },
  {
    "id": "s0202",
    "blockIndex": 48,
    "zh": "及楚事覺，鯈已卒，上追念鯈謹恪，故其諸子皆得不坐。"
  },
  {
    "id": "s0203",
    "blockIndex": 49,
    "zh": "英陰疏天下名士，上得其錄，有吳郡太守尹興名，乃征興及掾史五百餘人詣廷尉就考。"
  },
  {
    "id": "s0204",
    "blockIndex": 49,
    "zh": "諸吏不勝掠治，死者太半；"
  },
  {
    "id": "s0205",
    "blockIndex": 49,
    "zh": "惟門下掾陸續、主簿梁宏、功曹史駟勳，備受五毒，肌肉消爛，終無異辭。"
  },
  {
    "id": "s0206",
    "blockIndex": 49,
    "zh": "續母自吳來雒陽，作食以饋續。"
  },
  {
    "id": "s0207",
    "blockIndex": 49,
    "zh": "續雖見考，辭色未嘗變，而對食悲泣不自勝。"
  },
  {
    "id": "s0208",
    "blockIndex": 49,
    "zh": "治獄使者問其故，續曰：「母來不得見，故悲耳。"
  },
  {
    "id": "s0209",
    "blockIndex": 49,
    "zh": "」問：「何以知之？"
  },
  {
    "id": "s0210",
    "blockIndex": 49,
    "zh": "」續曰：「母截肉未嘗不方，斷蔥以寸為度，故知之。"
  },
  {
    "id": "s0211",
    "blockIndex": 49,
    "zh": "」使者以狀聞，上乃赦興等，禁錮終身。"
  },
  {
    "id": "s0212",
    "blockIndex": 50,
    "zh": "顏忠、王平辭引隧鄉侯耿建、朗陵侯臧信、濩澤侯鄧鯉、曲成侯劉建。"
  },
  {
    "id": "s0213",
    "blockIndex": 50,
    "zh": "建等辭未嘗與忠、平相見。"
  },
  {
    "id": "s0214",
    "blockIndex": 50,
    "zh": "是時，上怒甚，吏皆惶恐，諸所連及，率一切陷入，無敢以情恕者。"
  },
  {
    "id": "s0215",
    "blockIndex": 50,
    "zh": "侍御史寋朗心傷其冤，試以建等物色，獨問忠、平，而二人錯愕不能對。"
  },
  {
    "id": "s0216",
    "blockIndex": 50,
    "zh": "朗知其詐，乃上言：「建等無奸，專為忠、平所誣；"
  },
  {
    "id": "s0217",
    "blockIndex": 50,
    "zh": "疑天下無辜，類多如此。"
  },
  {
    "id": "s0218",
    "blockIndex": 50,
    "zh": "」帝曰：「即如是，忠、平何故引之？"
  },
  {
    "id": "s0219",
    "blockIndex": 50,
    "zh": "」對曰：「忠、平自知所犯不道，故多有虛引，冀以自明。"
  },
  {
    "id": "s0220",
    "blockIndex": 50,
    "zh": "」帝曰：「即如是，何不早奏？"
  },
  {
    "id": "s0221",
    "blockIndex": 50,
    "zh": "」對曰：「臣恐海內別有發其奸者。"
  },
  {
    "id": "s0222",
    "blockIndex": 50,
    "zh": "」帝怒曰：「吏持兩端！"
  },
  {
    "id": "s0223",
    "blockIndex": 50,
    "zh": "」促提下捶之。"
  },
  {
    "id": "s0224",
    "blockIndex": 50,
    "zh": "左右方引去，朗曰：「願一言而死。"
  },
  {
    "id": "s0225",
    "blockIndex": 50,
    "zh": "」帝曰：「誰與共為章？"
  },
  {
    "id": "s0226",
    "blockIndex": 50,
    "zh": "」對曰：「臣獨作之。"
  },
  {
    "id": "s0227",
    "blockIndex": 50,
    "zh": "」上曰：「何以不與三府議？"
  },
  {
    "id": "s0228",
    "blockIndex": 50,
    "zh": "」對曰：「臣自知當必族滅，不敢多污染人。"
  },
  {
    "id": "s0229",
    "blockIndex": 50,
    "zh": "」上曰：「何故族滅？"
  },
  {
    "id": "s0230",
    "blockIndex": 50,
    "zh": "」對曰：「臣考事一年，不能窮盡奸狀，反為罪人訟冤，故知當族滅，然臣所以言者，誠冀陛下一覺悟而已。"
  },
  {
    "id": "s0231",
    "blockIndex": 50,
    "zh": "臣見考囚在事者，鹹共言妖惡大故，臣子所宜同疾，今出之不如入之，可無後責。"
  },
  {
    "id": "s0232",
    "blockIndex": 50,
    "zh": "是以考一連十，考十連百。"
  },
  {
    "id": "s0233",
    "blockIndex": 50,
    "zh": "又公卿朝會，陛下問以得失，皆長跪言：『舊制，大罪禍及九族；"
  },
  {
    "id": "s0234",
    "blockIndex": 50,
    "zh": "陛下大恩，裁止於身，天下幸甚！"
  },
  {
    "id": "s0235",
    "blockIndex": 50,
    "zh": "』及其歸捨，口雖不言而仰屋竊歎，莫不知其多冤，無敢悟陛下言者。"
  },
  {
    "id": "s0236",
    "blockIndex": 50,
    "zh": "臣今所陳，誠死無悔！"
  },
  {
    "id": "s0237",
    "blockIndex": 50,
    "zh": "」帝意解，詔遣朗出。"
  },
  {
    "id": "s0238",
    "blockIndex": 50,
    "zh": "後二日，車駕自幸洛陽獄錄囚徒，理出千餘人。"
  },
  {
    "id": "s0239",
    "blockIndex": 50,
    "zh": "時天旱，即大雨。"
  },
  {
    "id": "s0240",
    "blockIndex": 50,
    "zh": "馬後亦以楚獄多濫，乘間為帝言之，帝惻然感悟，夜起彷徨，由是多所降宥。"
  },
  {
    "id": "s0241",
    "blockIndex": 51,
    "zh": "任城令汝南袁安遷楚郡太守，到郡不入府，先往案楚王英獄事，理其無明驗者，條上出之。"
  },
  {
    "id": "s0242",
    "blockIndex": 51,
    "zh": "府丞、掾史皆叩頭爭，以為「阿附反虜，法與同罪，不可。"
  },
  {
    "id": "s0243",
    "blockIndex": 51,
    "zh": "」安曰：「如有不合，太守自當坐之，不以相及也。"
  },
  {
    "id": "s0245",
    "blockIndex": 52,
    "zh": "遂分別具奏。"
  },
  {
    "id": "s0246",
    "blockIndex": 52,
    "zh": "帝感悟，即報許，得出者四百餘家。"
  },
  {
    "id": "s0247",
    "blockIndex": 53,
    "zh": "夏，五月，封故廣陵王荊子元壽為廣陵侯，食六縣。"
  },
  {
    "id": "s0248",
    "blockIndex": 53,
    "zh": "又封竇融孫嘉為安豐侯。"
  },
  {
    "id": "s0249",
    "blockIndex": 54,
    "zh": "初作壽陵，制：「令流水而已，無得起墳。"
  },
  {
    "id": "s0250",
    "blockIndex": 54,
    "zh": "萬年之後，掃地而祭，杅水脯糒而已。"
  },
  {
    "id": "s0251",
    "blockIndex": 54,
    "zh": "過百日，唯四時設奠。"
  },
  {
    "id": "s0252",
    "blockIndex": 54,
    "zh": "置吏卒數人，供給灑掃。"
  },
  {
    "id": "s0253",
    "blockIndex": 54,
    "zh": "敢有所興作者。"
  },
  {
    "id": "s0254",
    "blockIndex": 54,
    "zh": "以擅議宗廟法從事。"
  },
  {
    "id": "s0256",
    "blockIndex": 55,
    "zh": "春，二月，庚子，上東巡。"
  },
  {
    "id": "s0257",
    "blockIndex": 55,
    "zh": "癸亥，耕於下邳。"
  },
  {
    "id": "s0258",
    "blockIndex": 55,
    "zh": "三月，至魯，幸孔子宅，親御講堂，命皇太子、諸王說《經》；"
  },
  {
    "id": "s0259",
    "blockIndex": 55,
    "zh": "又幸東平、大梁。"
  },
  {
    "id": "s0260",
    "blockIndex": 55,
    "zh": "夏，四月，庚子，還宮。"
  },
  {
    "id": "s0261",
    "blockIndex": 56,
    "zh": "封皇子恭為巨鹿王，黨為樂成王，衍為下邳王，暢為汝南王，昺為常山王，長為濟陰王；"
  },
  {
    "id": "s0262",
    "blockIndex": 56,
    "zh": "帝親定其封域，裁令半楚、淮陽。"
  },
  {
    "id": "s0263",
    "blockIndex": 56,
    "zh": "馬後曰：「諸子數縣，於制不已儉乎？"
  },
  {
    "id": "s0264",
    "blockIndex": 56,
    "zh": "」帝曰：「我子豈宜與先帝子等，歲給二千萬足矣！"
  },
  {
    "id": "s0266",
    "blockIndex": 57,
    "zh": "乙巳，赦天下。"
  },
  {
    "id": "s0267",
    "blockIndex": 58,
    "zh": "謁者僕射耿秉數上言請擊匈奴，上以顯親侯竇固嘗從其世父融在河西，明習邊事，乃使秉、固與太僕祭肜、虎賁中郎將馬廖、下博侯劉張、好畤侯耿忠等共議之。"
  },
  {
    "id": "s0268",
    "blockIndex": 58,
    "zh": "耿秉曰：「昔者匈奴援引弓之類，並左衽之屬，故不可得而制。"
  },
  {
    "id": "s0269",
    "blockIndex": 58,
    "zh": "孝武既得河西四郡及居延、朔方，虜失其肥饒畜兵之地，羌、胡分離；"
  },
  {
    "id": "s0270",
    "blockIndex": 58,
    "zh": "唯有西域，俄復內屬；"
  },
  {
    "id": "s0271",
    "blockIndex": 58,
    "zh": "故呼韓邪單于請事款塞，其勢易乘也。"
  },
  {
    "id": "s0272",
    "blockIndex": 58,
    "zh": "今有南單于，形勢相似；"
  },
  {
    "id": "s0273",
    "blockIndex": 58,
    "zh": "然西域尚未內屬，北虜未有釁作。"
  },
  {
    "id": "s0274",
    "blockIndex": 58,
    "zh": "臣愚以為當先擊白山，得伊吾，破車師，通使烏孫諸國以斷其右臂；"
  },
  {
    "id": "s0275",
    "blockIndex": 58,
    "zh": "伊吾亦有匈奴南呼衍一部。"
  },
  {
    "id": "s0276",
    "blockIndex": 59,
    "zh": "破此，復為折其左角，然後匈奴可擊也。"
  },
  {
    "id": "s0277",
    "blockIndex": 59,
    "zh": "」上善其言。"
  },
  {
    "id": "s0278",
    "blockIndex": 59,
    "zh": "議者或以為「今兵出白山，匈奴必並兵相助，又當分其東以離其眾。"
  },
  {
    "id": "s0279",
    "blockIndex": 59,
    "zh": "」上從之。"
  },
  {
    "id": "s0280",
    "blockIndex": 59,
    "zh": "十二月，以秉為駙馬都尉，固為奉車都尉；"
  },
  {
    "id": "s0281",
    "blockIndex": 59,
    "zh": "以騎都尉秦彭為秉副，耿忠為固副，皆置從事、司馬，出屯涼州。"
  },
  {
    "id": "s0282",
    "blockIndex": 59,
    "zh": "秉，國之子；"
  },
  {
    "id": "s0283",
    "blockIndex": 59,
    "zh": "忠，弇之子；"
  },
  {
    "id": "s0284",
    "blockIndex": 59,
    "zh": "廖，援之子也。"
  },
  {
    "id": "s0285",
    "blockIndex": 60,
    "zh": "春，二月，遣肜與度遼將軍吳棠將河東、西河羌、胡及南單于兵萬一千騎出高闕塞，竇固、耿忠率酒泉、敦煌、張掖甲卒及盧水羌、胡萬二千騎出酒泉塞，耿秉、秦彭率武威、隴西、天水募士及羌、胡萬騎出張掖居延塞，騎都尉來苗、護烏桓校尉文穆將太原、雁門、代郡、上谷、漁陽、右北平、定襄郡兵及烏桓、鮮卑萬一千騎出平城塞，伐北匈奴。"
  },
  {
    "id": "s0286",
    "blockIndex": 60,
    "zh": "竇固、耿忠至天山，擊呼衍王，斬首千餘級；"
  },
  {
    "id": "s0287",
    "blockIndex": 60,
    "zh": "追至蒲類海，取伊吾盧地，置宜禾都尉，留吏士屯田伊吾盧城。"
  },
  {
    "id": "s0288",
    "blockIndex": 60,
    "zh": "耿秉、秦彭擊匈林王，絕幕六百餘里，至三木樓山而還。"
  },
  {
    "id": "s0289",
    "blockIndex": 60,
    "zh": "來苗、文穆至匈河水上，虜皆奔走，無所獲。"
  },
  {
    "id": "s0290",
    "blockIndex": 60,
    "zh": "祭肜與南匈奴左賢王信不相得，出高闕塞九百餘里，得小山，信妄言以為涿邪山，不見虜而還。"
  },
  {
    "id": "s0291",
    "blockIndex": 60,
    "zh": "肜與吳棠坐逗留畏懦，下獄，免。"
  },
  {
    "id": "s0292",
    "blockIndex": 60,
    "zh": "肜自恨無功，出獄數日，歐血死。"
  },
  {
    "id": "s0293",
    "blockIndex": 60,
    "zh": "臨終，謂其子曰：「吾蒙國厚恩，奉使不稱，身死誠慚恨，義不可以無功受賞。"
  },
  {
    "id": "s0294",
    "blockIndex": 60,
    "zh": "死後，若悉簿上所得物，身自詣兵屯，效死前行，以副吾心。"
  },
  {
    "id": "s0295",
    "blockIndex": 60,
    "zh": "」既卒，其子逢上疏，具陳遺言。"
  },
  {
    "id": "s0296",
    "blockIndex": 60,
    "zh": "帝雅重肜，方更任用，聞之，大驚，嗟歎良久。"
  },
  {
    "id": "s0297",
    "blockIndex": 60,
    "zh": "烏桓、鮮卑每朝賀京師，常過肜塚拜謁，仰天號泣。"
  },
  {
    "id": "s0298",
    "blockIndex": 60,
    "zh": "遼東吏民為立祠，四時奉祭焉。"
  },
  {
    "id": "s0299",
    "blockIndex": 61,
    "zh": "竇固獨有功，加位特進。"
  },
  {
    "id": "s0300",
    "blockIndex": 61,
    "zh": "固使假司馬班超與從事郭恂俱使西域。"
  },
  {
    "id": "s0301",
    "blockIndex": 61,
    "zh": "超行到鄯善，鄯善王廣奉超禮敬甚備，後忽更疏懈。"
  },
  {
    "id": "s0302",
    "blockIndex": 61,
    "zh": "超謂其官屬曰：「寧覺廣禮意薄乎？"
  },
  {
    "id": "s0303",
    "blockIndex": 61,
    "zh": "」官屬曰：「胡人不能常久，無它故也。"
  },
  {
    "id": "s0304",
    "blockIndex": 61,
    "zh": "」超曰：「此必有北虜使來，狐疑未知所從故也。"
  },
  {
    "id": "s0305",
    "blockIndex": 61,
    "zh": "明者睹未萌，況已著邪！"
  },
  {
    "id": "s0306",
    "blockIndex": 61,
    "zh": "」乃召侍胡，詐之曰：「匈奴使來數日，今安在乎？"
  },
  {
    "id": "s0307",
    "blockIndex": 61,
    "zh": "」侍胡惶恐曰：「到已三日，去此三十里。"
  },
  {
    "id": "s0308",
    "blockIndex": 61,
    "zh": "」超乃閉侍胡，悉會其吏士三十六人，與共飲，酒酣，因激怒之曰：「卿曹與我俱在絕域，今虜使到才數日，而王廣禮敬即廢。"
  },
  {
    "id": "s0309",
    "blockIndex": 61,
    "zh": "如令善阜善收吾屬送匈奴，骸骨長為豺狼食矣。"
  },
  {
    "id": "s0310",
    "blockIndex": 61,
    "zh": "為之奈何？"
  },
  {
    "id": "s0311",
    "blockIndex": 61,
    "zh": "」官屬皆曰：「今在危亡之地，死生從司馬！"
  },
  {
    "id": "s0312",
    "blockIndex": 61,
    "zh": "」超曰：「不入虎穴，不得虎子。"
  },
  {
    "id": "s0313",
    "blockIndex": 61,
    "zh": "當今之計，獨有因夜以火攻虜，使彼不知我多少，必大震怖，可殄盡也。"
  },
  {
    "id": "s0314",
    "blockIndex": 61,
    "zh": "滅此虜，則善阜善破膽，功成事立矣。"
  },
  {
    "id": "s0315",
    "blockIndex": 61,
    "zh": "」眾曰：「當與從事議之。"
  },
  {
    "id": "s0316",
    "blockIndex": 61,
    "zh": "」超怒曰：「吉凶決於今日！"
  },
  {
    "id": "s0317",
    "blockIndex": 61,
    "zh": "從事文俗吏，聞此必恐而謀洩，死無所名，非壯士也。"
  },
  {
    "id": "s0318",
    "blockIndex": 61,
    "zh": "」眾曰：「善！"
  },
  {
    "id": "s0319",
    "blockIndex": 61,
    "zh": "」初夜，超遂將吏士往奔虜營。"
  },
  {
    "id": "s0320",
    "blockIndex": 61,
    "zh": "會天大風，超令十人持鼓藏虜捨後，約曰：「見火然，皆當鳴鼓大呼。"
  },
  {
    "id": "s0321",
    "blockIndex": 61,
    "zh": "」餘人悉持兵弩，夾門而伏，超乃順風縱火。"
  },
  {
    "id": "s0322",
    "blockIndex": 61,
    "zh": "前後鼓噪，虜眾驚亂。"
  },
  {
    "id": "s0323",
    "blockIndex": 61,
    "zh": "超手格殺三人，吏兵斬其使及從士三十餘級，餘眾百許人悉燒死。"
  },
  {
    "id": "s0324",
    "blockIndex": 61,
    "zh": "明日乃還，告郭恂，恂大驚，既而色動，超知其意，舉手曰：「掾雖不行，班超何心獨擅之乎！"
  },
  {
    "id": "s0325",
    "blockIndex": 61,
    "zh": "」恂乃悅。"
  },
  {
    "id": "s0326",
    "blockIndex": 61,
    "zh": "超於是召善阜善王廣，以虜使首示之，一國震怖。"
  },
  {
    "id": "s0327",
    "blockIndex": 61,
    "zh": "超告以漢威德，「自今以後，勿復與北虜通。"
  },
  {
    "id": "s0328",
    "blockIndex": 61,
    "zh": "」廣叩頭：「願屬漢，無二心。"
  },
  {
    "id": "s0329",
    "blockIndex": 61,
    "zh": "」遂納子為質。"
  },
  {
    "id": "s0330",
    "blockIndex": 61,
    "zh": "還白竇固，固大喜，具上超功效，並求更選使使西域。"
  },
  {
    "id": "s0331",
    "blockIndex": 61,
    "zh": "帝曰：「吏如班超，何故不遣，而更選乎！"
  },
  {
    "id": "s0332",
    "blockIndex": 61,
    "zh": "今以超為軍司馬，令遂前功。"
  },
  {
    "id": "s0334",
    "blockIndex": 62,
    "zh": "固復使超使於窴，欲益其兵，超願但將本所從三十六人，曰：「於窴國大而遠，今將數百人，無益於強；"
  },
  {
    "id": "s0335",
    "blockIndex": 62,
    "zh": "如有不虞，多益為累耳。"
  },
  {
    "id": "s0336",
    "blockIndex": 62,
    "zh": "」是時於窴王廣德雄張南道，而匈奴遣使監護其國。"
  },
  {
    "id": "s0337",
    "blockIndex": 62,
    "zh": "超既至於窴，廣德禮意甚疏。"
  },
  {
    "id": "s0338",
    "blockIndex": 62,
    "zh": "且其俗信巫，巫言：「神怒，何故欲向漢？"
  },
  {
    "id": "s0339",
    "blockIndex": 62,
    "zh": "漢使有□咼馬，急求取以祠我！"
  },
  {
    "id": "s0340",
    "blockIndex": 62,
    "zh": "」廣德乃遣國相私來比就超請馬。"
  },
  {
    "id": "s0341",
    "blockIndex": 62,
    "zh": "超密知其狀，報許之，而令巫自來取馬。"
  },
  {
    "id": "s0342",
    "blockIndex": 62,
    "zh": "有頃，巫至，超即斬其首；"
  },
  {
    "id": "s0343",
    "blockIndex": 62,
    "zh": "收私來比，鞭笞數百。"
  },
  {
    "id": "s0344",
    "blockIndex": 62,
    "zh": "以巫首送廣德；"
  },
  {
    "id": "s0345",
    "blockIndex": 62,
    "zh": "因責讓之。"
  },
  {
    "id": "s0346",
    "blockIndex": 62,
    "zh": "廣德素聞超在善阜善誅滅虜使，大惶恐，即殺匈奴使者而降。"
  },
  {
    "id": "s0347",
    "blockIndex": 62,
    "zh": "超重賜其王以下，因鎮撫焉。"
  },
  {
    "id": "s0348",
    "blockIndex": 62,
    "zh": "於是諸國皆遣子入侍，西域與漢絕六十五載，至是乃復通焉。"
  },
  {
    "id": "s0349",
    "blockIndex": 62,
    "zh": "超，彪之子也。"
  },
  {
    "id": "s0350",
    "blockIndex": 63,
    "zh": "淮陽王延，性驕奢，而遇下嚴烈。"
  },
  {
    "id": "s0351",
    "blockIndex": 63,
    "zh": "有上書告「延與姬兄謝弇及姊婿韓光招奸猾，作圖讖，祠祭祝詛。"
  },
  {
    "id": "s0353",
    "blockIndex": 64,
    "zh": "事下案驗。"
  },
  {
    "id": "s0354",
    "blockIndex": 64,
    "zh": "五月，癸丑，弇、光及司徒邢穆皆坐死，所連及死、徙者甚眾。"
  },
  {
    "id": "s0355",
    "blockIndex": 65,
    "zh": "戊午晦，日有食之。"
  },
  {
    "id": "s0356",
    "blockIndex": 66,
    "zh": "六月，丙寅，以大司農西河王敏為司徒。"
  },
  {
    "id": "s0357",
    "blockIndex": 66,
    "zh": "有司奏請誅淮陽王延，上以延罪薄於楚王英，秋，七月，徙延為阜陵王，食二縣。"
  },
  {
    "id": "s0358",
    "blockIndex": 67,
    "zh": "是歲，北匈奴大入雲中，雲中太守廉范拒之；"
  },
  {
    "id": "s0359",
    "blockIndex": 67,
    "zh": "吏以眾少，欲移書傍郡求救，范不許。"
  },
  {
    "id": "s0360",
    "blockIndex": 67,
    "zh": "會日暮，范令軍士各交縛兩炬，三頭爇火，營中星列。"
  },
  {
    "id": "s0361",
    "blockIndex": 67,
    "zh": "虜謂漢兵救至，大驚，待旦將退。"
  },
  {
    "id": "s0362",
    "blockIndex": 67,
    "zh": "范令軍中蓐食，晨，往赴之，斬"
  },
  {
    "id": "s0363",
    "blockIndex": 68,
    "zh": "首數百級，虜自相轔藉，死者千餘人，由此不敢復向雲中。"
  },
  {
    "id": "s0364",
    "blockIndex": 68,
    "zh": "范，丹之孫也。"
  },
  {
    "id": "s0365",
    "blockIndex": 69,
    "zh": "春，正月，上當謁原陵，夜，夢先帝、太后如平生歡，既寤，悲不能寐；"
  },
  {
    "id": "s0366",
    "blockIndex": 69,
    "zh": "即案歷，明旦日吉，遂率百官上陵。"
  },
  {
    "id": "s0367",
    "blockIndex": 69,
    "zh": "其日，降甘露於陵樹，帝令百官採取以薦。"
  },
  {
    "id": "s0368",
    "blockIndex": 69,
    "zh": "會畢，帝從席前伏御床，視太后鏡奩中物，感動悲涕，令易脂澤裝具；"
  },
  {
    "id": "s0369",
    "blockIndex": 69,
    "zh": "左右皆泣，莫能仰視。"
  },
  {
    "id": "s0370",
    "blockIndex": 70,
    "zh": "北海敬王睦薨。"
  },
  {
    "id": "s0371",
    "blockIndex": 70,
    "zh": "睦少好學，光武及上皆愛之，嘗遣中大夫詣京師朝賀，召而謂之曰：「朝廷設問寡人，大夫將何辭以對？"
  },
  {
    "id": "s0372",
    "blockIndex": 70,
    "zh": "」使者曰：「大王忠孝慈仁，敬賢樂士，臣敢不以實對！"
  },
  {
    "id": "s0373",
    "blockIndex": 70,
    "zh": "」睦曰：「吁，子危我哉！"
  },
  {
    "id": "s0374",
    "blockIndex": 70,
    "zh": "此乃孤幼時進趣之行也。"
  },
  {
    "id": "s0375",
    "blockIndex": 70,
    "zh": "大夫其對以孤襲爵以來，志意衰惰，聲色是娛，犬馬是好，乃為相愛耳。"
  },
  {
    "id": "s0376",
    "blockIndex": 70,
    "zh": "」其智慮畏慎如此。"
  },
  {
    "id": "s0377",
    "blockIndex": 71,
    "zh": "二月，乙巳，司徒王敏薨。"
  },
  {
    "id": "s0378",
    "blockIndex": 72,
    "zh": "三月，癸丑，以汝南太守鮑昱為司徒。"
  },
  {
    "id": "s0379",
    "blockIndex": 72,
    "zh": "昱，永之子也。"
  },
  {
    "id": "s0380",
    "blockIndex": 73,
    "zh": "益州刺史梁國朱輔宣示漢德，威懷遠夷，自汶山以西，前世所不至，正朔所未加，白狼、槃木等百餘國。"
  },
  {
    "id": "s0381",
    "blockIndex": 73,
    "zh": "皆舉種稱臣奉貢。"
  },
  {
    "id": "s0382",
    "blockIndex": 73,
    "zh": "白狼王唐取作詩三章，歌頌漢德，輔使犍為郡掾由恭譯而獻之。"
  },
  {
    "id": "s0383",
    "blockIndex": 74,
    "zh": "初，龜茲王建為匈奴所立，倚恃虜威，據有北道，攻殺疏勒王，立其臣兜題為疏勒王。"
  },
  {
    "id": "s0384",
    "blockIndex": 74,
    "zh": "班超從間道至疏勒，去兜題所居槃橐城九十里，逆遣吏田慮先往降之，敕慮曰：「兜題本非疏勒種，國人必不用命；"
  },
  {
    "id": "s0385",
    "blockIndex": 74,
    "zh": "若不即降，便可執之。"
  },
  {
    "id": "s0386",
    "blockIndex": 74,
    "zh": "」慮既到，兜題見慮輕弱，殊無降意。"
  },
  {
    "id": "s0387",
    "blockIndex": 74,
    "zh": "慮因其無備，遂前劫縛兜題，左右出其不意，皆驚懼奔走。"
  },
  {
    "id": "s0388",
    "blockIndex": 74,
    "zh": "慮馳報超，超即赴之，悉召疏勒將吏，說以龜茲無道之狀，因立其故王兄子忠為王，國人大悅。"
  },
  {
    "id": "s0389",
    "blockIndex": 74,
    "zh": "超問忠及官屬：「當殺兜題邪，生遣之邪？"
  },
  {
    "id": "s0390",
    "blockIndex": 74,
    "zh": "」鹹曰：「當殺之。"
  },
  {
    "id": "s0391",
    "blockIndex": 74,
    "zh": "」超曰；"
  },
  {
    "id": "s0392",
    "blockIndex": 74,
    "zh": "「殺之無益於事，當令龜茲知漢威德。"
  },
  {
    "id": "s0393",
    "blockIndex": 74,
    "zh": "」遂解遣之。"
  },
  {
    "id": "s0394",
    "blockIndex": 75,
    "zh": "夏，五月，戊子，公卿百官以帝威德懷遠，祥物顯應，並集朝堂奉觴上壽。"
  },
  {
    "id": "s0395",
    "blockIndex": 75,
    "zh": "制曰：「天生神物，以應王者；"
  },
  {
    "id": "s0396",
    "blockIndex": 75,
    "zh": "遠人慕化，實由有德；"
  },
  {
    "id": "s0397",
    "blockIndex": 75,
    "zh": "朕以虛薄，何以享斯！"
  },
  {
    "id": "s0398",
    "blockIndex": 75,
    "zh": "唯高祖、光武聖德所被，不敢有辭，其敬舉觴，太常擇吉日策告宗廟。"
  },
  {
    "id": "s0399",
    "blockIndex": 75,
    "zh": "」仍推恩賜民爵及粟有差。"
  },
  {
    "id": "s0400",
    "blockIndex": 76,
    "zh": "冬，十一月，遣奉車都尉竇固、駙馬都尉耿秉、騎都尉劉張出敦煌崑崙塞，擊西域，秉、張皆去符，傳以屬固，合兵萬四千騎，擊破白山虜於蒲類海上，遂進擊車師。"
  },
  {
    "id": "s0401",
    "blockIndex": 76,
    "zh": "車師前王，即後王之子也，其廷相去五百餘里。"
  },
  {
    "id": "s0402",
    "blockIndex": 76,
    "zh": "固以後王道遠，山谷深，士卒寒苦，欲攻前王；"
  },
  {
    "id": "s0403",
    "blockIndex": 76,
    "zh": "秉以為先赴後王，並力根本，則前王自服。"
  },
  {
    "id": "s0404",
    "blockIndex": 76,
    "zh": "固計未決，秉奮身而起曰：「請行前。"
  },
  {
    "id": "s0405",
    "blockIndex": 76,
    "zh": "」乃上馬引兵北入，眾軍不得已，並進，斬首數千級。"
  },
  {
    "id": "s0406",
    "blockIndex": 76,
    "zh": "後王安得震怖，走出門迎秉，脫帽，抱馬足降，秉將以詣固；"
  },
  {
    "id": "s0407",
    "blockIndex": 76,
    "zh": "其前王亦歸命，遂定車師而還。"
  },
  {
    "id": "s0408",
    "blockIndex": 76,
    "zh": "於是固奏復置西域都護及戊、己校尉。"
  },
  {
    "id": "s0409",
    "blockIndex": 76,
    "zh": "以陳睦為都護；"
  },
  {
    "id": "s0410",
    "blockIndex": 76,
    "zh": "司馬耿恭為戊校尉，屯後王部金蒲城；"
  },
  {
    "id": "s0411",
    "blockIndex": 76,
    "zh": "謁者關寵為己校尉，屯前王部柳中城，屯各置數百人。"
  },
  {
    "id": "s0412",
    "blockIndex": 76,
    "zh": "恭，況之孫也。"
  },
  {
    "id": "s0413",
    "blockIndex": 77,
    "zh": "春，二月，詔竇固等罷兵還京師。"
  },
  {
    "id": "s0414",
    "blockIndex": 78,
    "zh": "北單于遣左鹿蠡王率二萬騎擊車師，耿恭遣司馬將兵三百人救之，皆為所沒，匈奴遂破殺車師後王安得而攻金蒲城。"
  },
  {
    "id": "s0415",
    "blockIndex": 78,
    "zh": "恭以毒藥傅矢，語匈奴曰：「漢家箭神，其中瘡者必有異。"
  },
  {
    "id": "s0416",
    "blockIndex": 78,
    "zh": "」虜中矢者，視創皆沸，大驚，會天暴風雨，隨雨擊之，殺傷甚眾；"
  },
  {
    "id": "s0417",
    "blockIndex": 78,
    "zh": "匈奴震怖，相謂曰：「漢兵神，真可畏也！"
  },
  {
    "id": "s0418",
    "blockIndex": 78,
    "zh": "」遂解去。"
  },
  {
    "id": "s0419",
    "blockIndex": 79,
    "zh": "夏，六月，己未，有星孛於太微。"
  },
  {
    "id": "s0420",
    "blockIndex": 80,
    "zh": "耿恭以疏勒城傍有澗水可固，引兵據之。"
  },
  {
    "id": "s0421",
    "blockIndex": 80,
    "zh": "秋，七月，匈奴復來攻，擁絕澗水；"
  },
  {
    "id": "s0422",
    "blockIndex": 80,
    "zh": "恭於城中穿井十五丈，不得水，吏士渴乏，至笮馬糞汁而飲之。"
  },
  {
    "id": "s0423",
    "blockIndex": 80,
    "zh": "恭身自率士挽籠，有頃，水泉奔出，眾皆稱萬歲。"
  },
  {
    "id": "s0424",
    "blockIndex": 80,
    "zh": "乃令吏士揚水以示虜，虜出不意，以為神明，遂引去。"
  },
  {
    "id": "s0425",
    "blockIndex": 81,
    "zh": "八月，壬子，帝崩於東宮前殿，年四十八。"
  },
  {
    "id": "s0426",
    "blockIndex": 81,
    "zh": "遺詔：「無起寢廟，藏主於光烈皇后更衣別室。"
  },
  {
    "id": "s0427",
    "blockIndex": 81,
    "zh": "」帝遵奉建武制度，無所變更，后妃之家不得封侯與政。"
  },
  {
    "id": "s0428",
    "blockIndex": 81,
    "zh": "館陶公主為子求郎，不許，而賜錢千萬，謂群臣曰：「郎官上應列宿，出宰百里，苟非其人，則民受其殃，是以難之。"
  },
  {
    "id": "s0429",
    "blockIndex": 81,
    "zh": "」公車以反支日不受章奏，帝聞而怪曰：「民廢農桑，遠來詣闕，而復拘以禁忌，豈為政之意乎！"
  },
  {
    "id": "s0430",
    "blockIndex": 81,
    "zh": "」於是遂蠲其制。"
  },
  {
    "id": "s0431",
    "blockIndex": 81,
    "zh": "尚書閻章二妹為貴人，章精力曉舊典，久次當遷重職，帝為後宮親屬，竟不用。"
  },
  {
    "id": "s0432",
    "blockIndex": 81,
    "zh": "是以吏得其人，民樂其業，遠近畏服，戶口滋殖焉。"
  },
  {
    "id": "s0433",
    "blockIndex": 82,
    "zh": "太子即位，年十八。"
  },
  {
    "id": "s0434",
    "blockIndex": 82,
    "zh": "尊皇后曰皇太后。"
  },
  {
    "id": "s0435",
    "blockIndex": 83,
    "zh": "明帝初崩，馬氏兄弟爭欲入宮。"
  },
  {
    "id": "s0436",
    "blockIndex": 83,
    "zh": "北宮衛士令楊仁被甲持戟，嚴勒門衛，人莫敢輕進者。"
  },
  {
    "id": "s0437",
    "blockIndex": 83,
    "zh": "諸馬乃共譖仁於章帝，言其峻刻。"
  },
  {
    "id": "s0438",
    "blockIndex": 83,
    "zh": "帝知其忠，愈善之，拜為什邡令。"
  },
  {
    "id": "s0439",
    "blockIndex": 84,
    "zh": "壬戌，葬孝明皇帝於顯節陵。"
  },
  {
    "id": "s0440",
    "blockIndex": 85,
    "zh": "冬，十月，丁未，赦天下。"
  },
  {
    "id": "s0441",
    "blockIndex": 86,
    "zh": "詔以行太尉事節鄉侯熹為太傅，司空融為太尉，並錄尚書事。"
  },
  {
    "id": "s0442",
    "blockIndex": 87,
    "zh": "十一月，戊戌，以蜀郡太守第五倫為司空。"
  },
  {
    "id": "s0443",
    "blockIndex": 87,
    "zh": "倫在郡公清，所舉吏多得其人，故帝自遠郡用之。"
  },
  {
    "id": "s0444",
    "blockIndex": 88,
    "zh": "焉耆、龜茲攻沒都護陳睦，北匈奴圍關寵於柳中城。"
  },
  {
    "id": "s0445",
    "blockIndex": 88,
    "zh": "會中國有大喪，救兵不至，車師復叛，與匈奴共攻耿恭。"
  },
  {
    "id": "s0446",
    "blockIndex": 88,
    "zh": "恭率厲士眾御之，數月，食盡窮困，乃煮鎧弩，食其筋革。"
  },
  {
    "id": "s0447",
    "blockIndex": 88,
    "zh": "恭與士卒推誠同死生。"
  },
  {
    "id": "s0448",
    "blockIndex": 88,
    "zh": "故皆無二心，而稍稍死亡。"
  },
  {
    "id": "s0449",
    "blockIndex": 88,
    "zh": "餘數十人。"
  },
  {
    "id": "s0450",
    "blockIndex": 88,
    "zh": "單于知恭已困，欲必降之，遣使招恭曰：「若降者，當封為白屋王。"
  },
  {
    "id": "s0451",
    "blockIndex": 88,
    "zh": "妻以女子。"
  },
  {
    "id": "s0452",
    "blockIndex": 88,
    "zh": "」恭誘其使上城，手擊殺之，炙諸城上。"
  },
  {
    "id": "s0453",
    "blockIndex": 88,
    "zh": "單于大怒，更益兵圍恭，不能下。"
  },
  {
    "id": "s0454",
    "blockIndex": 89,
    "zh": "關寵上書求救。"
  },
  {
    "id": "s0455",
    "blockIndex": 89,
    "zh": "詔公卿會議，司空倫以為不宜救，司徒鮑昱曰：「今使人於危難之地，急而棄之，外則縱蠻夷之暴，內則傷死難之臣，誠令權時，後無邊事可也。"
  },
  {
    "id": "s0456",
    "blockIndex": 89,
    "zh": "匈奴如復犯塞為寇，陛下將何以使將！"
  },
  {
    "id": "s0457",
    "blockIndex": 89,
    "zh": "又二部兵人裁各數十，匈奴圍之，歷旬不下，是其寡弱力盡之效也。"
  },
  {
    "id": "s0458",
    "blockIndex": 89,
    "zh": "可令敦煌、酒泉太守各將精騎二千，多其幡幟，倍道兼行以赴其急；"
  },
  {
    "id": "s0459",
    "blockIndex": 89,
    "zh": "匈奴疲極之兵，必不敢當，四十日間足還入塞。"
  },
  {
    "id": "s0460",
    "blockIndex": 89,
    "zh": "」帝然之。"
  },
  {
    "id": "s0461",
    "blockIndex": 89,
    "zh": "乃遣征西將軍耿秉屯酒泉，行太守事，遣酒泉太守段彭與謁者王蒙、皇甫援發張掖、酒泉、敦煌三郡及善阜善兵合七千餘人以救之。"
  },
  {
    "id": "s0462",
    "blockIndex": 90,
    "zh": "甲辰晦，日有食之。"
  },
  {
    "id": "s0463",
    "blockIndex": 91,
    "zh": "太后兄弟虎賁中郎廖及黃門郎防、光，終明帝世未嘗改官。"
  },
  {
    "id": "s0464",
    "blockIndex": 91,
    "zh": "帝以廖為衛尉，防為中郎將，光為越騎校尉。"
  },
  {
    "id": "s0465",
    "blockIndex": 91,
    "zh": "廖等傾身交結，冠蓋之士爭赴趣之。"
  },
  {
    "id": "s0466",
    "blockIndex": 91,
    "zh": "第五倫上疏曰：「臣聞《書》曰：『臣無作威作福，其害於而家，凶於而國。"
  },
  {
    "id": "s0467",
    "blockIndex": 91,
    "zh": "』近世光烈皇后雖友愛天至，而抑損陰氏，不假以權勢。"
  },
  {
    "id": "s0468",
    "blockIndex": 91,
    "zh": "其後梁、竇之家，互有非法，明帝即位，竟多誅之。"
  },
  {
    "id": "s0469",
    "blockIndex": 91,
    "zh": "自是雒中無復權戚，書記請托，一皆斷絕。"
  },
  {
    "id": "s0470",
    "blockIndex": 91,
    "zh": "又諭諸外戚曰：『苦身待士，不如為國。"
  },
  {
    "id": "s0471",
    "blockIndex": 91,
    "zh": "戴盆望天，事不兩施。"
  },
  {
    "id": "s0472",
    "blockIndex": 91,
    "zh": "』今之議者，復以馬氏為言。"
  },
  {
    "id": "s0473",
    "blockIndex": 91,
    "zh": "竊聞衛尉廖以布三千匹，城門校尉防以錢三百萬，私贍三輔衣冠，知與不知，莫不畢給。"
  },
  {
    "id": "s0474",
    "blockIndex": 91,
    "zh": "又聯臘日亦遺其在雒中者錢各五千。"
  },
  {
    "id": "s0475",
    "blockIndex": 91,
    "zh": "越騎校尉光，臘用羊三百頭，米四百斛，肉五千斤。"
  },
  {
    "id": "s0476",
    "blockIndex": 91,
    "zh": "臣愚以為不應經義。"
  },
  {
    "id": "s0477",
    "blockIndex": 91,
    "zh": "惶恐，不敢不以聞。"
  },
  {
    "id": "s0478",
    "blockIndex": 91,
    "zh": "陛下情慾厚之，亦宜所以安之。"
  },
  {
    "id": "s0479",
    "blockIndex": 91,
    "zh": "臣今言此，誠欲上忠陛下，下全後家也。"
  },
  {
    "id": "s0481",
    "blockIndex": 92,
    "zh": "是歲，京師及兗、豫、徐州大旱。"
  },
  {
    "id": "s0482",
    "blockIndex": 93,
    "zh": "category:資治通鑑"
  }
]
