[
  {
    "id": "s0001",
    "blockIndex": 0,
    "zh": "__FORCETOC___"
  },
  {
    "id": "s0002",
    "blockIndex": 1,
    "zh": "起旃蒙協洽，盡柔兆涒灘，凡二年。"
  },
  {
    "id": "s0003",
    "blockIndex": 2,
    "zh": "1冬，十月，沛公至霸上。"
  },
  {
    "id": "s0004",
    "blockIndex": 2,
    "zh": "秦王子嬰素車、白馬，系頸以組，封皇帝璽、符、節，降軹道旁。"
  },
  {
    "id": "s0005",
    "blockIndex": 2,
    "zh": "諸將或言誅秦王。"
  },
  {
    "id": "s0006",
    "blockIndex": 2,
    "zh": "沛公曰：「始懷王遣我，固以能寬容。"
  },
  {
    "id": "s0007",
    "blockIndex": 2,
    "zh": "且人已降，殺之不祥。"
  },
  {
    "id": "s0008",
    "blockIndex": 2,
    "zh": "」乃以屬吏。"
  },
  {
    "id": "s0009",
    "blockIndex": 3,
    "zh": "::賈誼論曰：秦以區區之地致萬乘之權，招八州而朝同列，百有餘年，然後以六合為家，殽、函為宮。"
  },
  {
    "id": "s0010",
    "blockIndex": 3,
    "zh": "一夫作難而七廟墮，身死人手，為天下笑者，何也？"
  },
  {
    "id": "s0011",
    "blockIndex": 3,
    "zh": "仁誼不施而攻守之勢異也。"
  },
  {
    "id": "s0012",
    "blockIndex": 4,
    "zh": "沛公西入咸陽，諸將皆爭走金帛財物之府分之。"
  },
  {
    "id": "s0013",
    "blockIndex": 4,
    "zh": "蕭何獨先入收秦丞相府圖籍藏之，以此沛公得具知天下□厄塞、戶口多少、強弱之處。"
  },
  {
    "id": "s0014",
    "blockIndex": 4,
    "zh": "沛公見秦宮室、帷帳、狗馬、重寶、婦女以千數，意欲留居之。"
  },
  {
    "id": "s0015",
    "blockIndex": 4,
    "zh": "樊噲諫曰：「沛公欲有天下耶，將為富家翁耶？"
  },
  {
    "id": "s0016",
    "blockIndex": 4,
    "zh": "凡此奢麗之物，皆秦所以亡也，沛公何用焉！"
  },
  {
    "id": "s0017",
    "blockIndex": 4,
    "zh": "願急還霸上，無留宮中！"
  },
  {
    "id": "s0018",
    "blockIndex": 4,
    "zh": "」沛公不聽。"
  },
  {
    "id": "s0019",
    "blockIndex": 4,
    "zh": "張良曰：「秦為無道，故沛公得至此。"
  },
  {
    "id": "s0020",
    "blockIndex": 4,
    "zh": "夫為天下除殘賊，宜縞素為資。"
  },
  {
    "id": "s0021",
    "blockIndex": 4,
    "zh": "今始入秦，即安其樂，此所謂『助桀為虐』。"
  },
  {
    "id": "s0022",
    "blockIndex": 4,
    "zh": "且忠言逆耳利於行，毒藥苦口利於病，願沛公聽樊噲言！"
  },
  {
    "id": "s0023",
    "blockIndex": 4,
    "zh": "」沛公乃還軍霸上。"
  },
  {
    "id": "s0024",
    "blockIndex": 4,
    "zh": "十一月，沛公悉召諸縣父老、豪桀，謂曰：「父老苦秦苛法久矣！"
  },
  {
    "id": "s0025",
    "blockIndex": 4,
    "zh": "吾與諸侯約，先入關者王之，吾當王關中。"
  },
  {
    "id": "s0026",
    "blockIndex": 4,
    "zh": "與父老約法三章耳：殺人者死，傷人及盜抵罪。"
  },
  {
    "id": "s0027",
    "blockIndex": 4,
    "zh": "餘悉除去秦法，諸吏民皆案堵如故。"
  },
  {
    "id": "s0028",
    "blockIndex": 4,
    "zh": "凡吾所以來，為父老除害，非有所侵暴，無恐。"
  },
  {
    "id": "s0029",
    "blockIndex": 4,
    "zh": "且吾所以還軍霸上，待諸侯至而定約束耳。"
  },
  {
    "id": "s0030",
    "blockIndex": 4,
    "zh": "」乃使人與秦吏行縣、鄉、邑，告諭之。"
  },
  {
    "id": "s0031",
    "blockIndex": 4,
    "zh": "秦民大喜。"
  },
  {
    "id": "s0032",
    "blockIndex": 4,
    "zh": "爭持牛、羊、酒食獻饗軍士。"
  },
  {
    "id": "s0033",
    "blockIndex": 4,
    "zh": "沛公又讓不受，曰：「倉粟多，非乏，不欲費民。"
  },
  {
    "id": "s0034",
    "blockIndex": 4,
    "zh": "」民又益喜，唯恐沛公不為秦王。"
  },
  {
    "id": "s0036",
    "blockIndex": 5,
    "zh": "2項羽既定河北，率諸侯兵欲西入關。"
  },
  {
    "id": "s0037",
    "blockIndex": 5,
    "zh": "先是，諸侯吏卒、繇使、屯戍過秦中者，秦中吏卒遇之多無狀。"
  },
  {
    "id": "s0038",
    "blockIndex": 5,
    "zh": "及章邯以秦軍降諸侯，諸侯吏卒乘勝多奴虜使之，輕折辱秦吏卒。"
  },
  {
    "id": "s0039",
    "blockIndex": 5,
    "zh": "秦吏卒多怨，竊言曰：「章將軍等詐吾屬降諸侯。"
  },
  {
    "id": "s0040",
    "blockIndex": 5,
    "zh": "今能入關破秦，大善；"
  },
  {
    "id": "s0041",
    "blockIndex": 5,
    "zh": "即不能，諸侯虜吾屬而東，秦又盡誅吾父母妻子，奈何？"
  },
  {
    "id": "s0042",
    "blockIndex": 5,
    "zh": "」諸將微聞其計，以告項羽。"
  },
  {
    "id": "s0043",
    "blockIndex": 5,
    "zh": "項羽召黥布、蒲將軍計曰：「秦吏卒尚眾，其心不服，至關不聽，事必危。"
  },
  {
    "id": "s0044",
    "blockIndex": 5,
    "zh": "不如擊殺之，而獨與章邯、長史欣、都尉翳入秦。"
  },
  {
    "id": "s0045",
    "blockIndex": 5,
    "zh": "」於是楚軍夜擊坑秦卒二十餘萬人新安城南。"
  },
  {
    "id": "s0046",
    "blockIndex": 6,
    "zh": "或說沛公曰：「秦富十倍天下，地形強。"
  },
  {
    "id": "s0047",
    "blockIndex": 6,
    "zh": "聞項羽號章邯為雍王，王關中，今則來，沛公恐不得有此。"
  },
  {
    "id": "s0048",
    "blockIndex": 6,
    "zh": "可急使兵守函谷關，無內諸侯軍；"
  },
  {
    "id": "s0049",
    "blockIndex": 6,
    "zh": "稍征關中兵以自益，距之。"
  },
  {
    "id": "s0050",
    "blockIndex": 6,
    "zh": "」沛公然其計，從之。"
  },
  {
    "id": "s0051",
    "blockIndex": 6,
    "zh": "已而項羽至關，關門閉。"
  },
  {
    "id": "s0052",
    "blockIndex": 6,
    "zh": "聞沛公已定關中，大怒，使黥布等攻破函谷關。"
  },
  {
    "id": "s0053",
    "blockIndex": 6,
    "zh": "十二月，項羽進至戲。"
  },
  {
    "id": "s0054",
    "blockIndex": 6,
    "zh": "沛公左司馬曹無傷使人言項羽曰：「沛公欲王關中，令子嬰為相，珍寶盡有之。"
  },
  {
    "id": "s0055",
    "blockIndex": 6,
    "zh": "」欲以求封。"
  },
  {
    "id": "s0056",
    "blockIndex": 6,
    "zh": "項羽大怒，饗士卒，期旦日擊沛公軍。"
  },
  {
    "id": "s0057",
    "blockIndex": 6,
    "zh": "當是時，項羽兵四十萬，號百萬，在新豐鴻門；"
  },
  {
    "id": "s0058",
    "blockIndex": 6,
    "zh": "沛公兵十萬，號二十萬，在霸上。"
  },
  {
    "id": "s0059",
    "blockIndex": 6,
    "zh": "范增說項羽曰：「沛公居山東時，貪財好色。"
  },
  {
    "id": "s0060",
    "blockIndex": 6,
    "zh": "今入關，財物無所取，婦女無所幸，此其志不在小。"
  },
  {
    "id": "s0061",
    "blockIndex": 6,
    "zh": "吾令人望其氣，皆為龍虎，成五采，此天子氣也。"
  },
  {
    "id": "s0062",
    "blockIndex": 6,
    "zh": "急擊勿失！"
  },
  {
    "id": "s0064",
    "blockIndex": 7,
    "zh": "楚左尹項伯者，項羽季父也，素善張良，乃夜馳之沛公軍，私見張良，具告以事，欲呼與俱去，曰：「毋俱死也！"
  },
  {
    "id": "s0065",
    "blockIndex": 7,
    "zh": "」張良曰：「臣為韓王送沛公。"
  },
  {
    "id": "s0066",
    "blockIndex": 7,
    "zh": "沛公今有急，亡去不義，不可不語。"
  },
  {
    "id": "s0067",
    "blockIndex": 7,
    "zh": "」良乃入，具告沛公。"
  },
  {
    "id": "s0068",
    "blockIndex": 7,
    "zh": "沛公大驚。"
  },
  {
    "id": "s0069",
    "blockIndex": 7,
    "zh": "良曰：「料公士卒足以當項羽乎？"
  },
  {
    "id": "s0070",
    "blockIndex": 7,
    "zh": "」沛公默然曰：「固不如也。"
  },
  {
    "id": "s0071",
    "blockIndex": 7,
    "zh": "且為之奈何？"
  },
  {
    "id": "s0072",
    "blockIndex": 7,
    "zh": "」張良曰：「請往謂項伯，言沛公之不敢叛也。"
  },
  {
    "id": "s0073",
    "blockIndex": 7,
    "zh": "」沛公曰：「君安與項伯有故？"
  },
  {
    "id": "s0074",
    "blockIndex": 7,
    "zh": "」張良曰：「秦時與臣游，嘗殺人，臣活之。"
  },
  {
    "id": "s0075",
    "blockIndex": 7,
    "zh": "今事有急，故幸來告良。"
  },
  {
    "id": "s0076",
    "blockIndex": 7,
    "zh": "」沛公曰：「孰與君少長？"
  },
  {
    "id": "s0077",
    "blockIndex": 7,
    "zh": "」良曰：「長於臣。"
  },
  {
    "id": "s0078",
    "blockIndex": 7,
    "zh": "」沛公曰：「君為我呼入，吾得兄事之。"
  },
  {
    "id": "s0079",
    "blockIndex": 7,
    "zh": "」張良出，固要項伯；"
  },
  {
    "id": "s0080",
    "blockIndex": 7,
    "zh": "項伯即入見沛公。"
  },
  {
    "id": "s0081",
    "blockIndex": 7,
    "zh": "沛公奉卮酒為壽，約為婚姻，曰：「吾入關，秋毫不敢有所近，籍吏民，封府庫而待將軍。"
  },
  {
    "id": "s0082",
    "blockIndex": 7,
    "zh": "所以遣將守關者，備他盜之出入與非常也。"
  },
  {
    "id": "s0083",
    "blockIndex": 7,
    "zh": "日夜望將軍至，豈敢反乎！"
  },
  {
    "id": "s0084",
    "blockIndex": 7,
    "zh": "願伯具言臣之不敢倍德也。"
  },
  {
    "id": "s0085",
    "blockIndex": 7,
    "zh": "」項伯許諾，謂沛公曰：「旦日不可不蚤自來謝。"
  },
  {
    "id": "s0086",
    "blockIndex": 7,
    "zh": "」沛公曰：「諾。"
  },
  {
    "id": "s0087",
    "blockIndex": 7,
    "zh": "」於是項伯復夜去，至軍中，具以沛公言報項羽，因言曰：「沛公不先破關中，公豈敢入乎？"
  },
  {
    "id": "s0088",
    "blockIndex": 7,
    "zh": "今人有大功而擊之，不義也。"
  },
  {
    "id": "s0089",
    "blockIndex": 7,
    "zh": "不如因善遇之。"
  },
  {
    "id": "s0090",
    "blockIndex": 7,
    "zh": "」項羽許諾。"
  },
  {
    "id": "s0091",
    "blockIndex": 8,
    "zh": "沛公旦日從百餘騎來見項羽鴻門，謝曰：「臣與將軍戮力而攻秦，將軍戰河北，臣戰河南。"
  },
  {
    "id": "s0092",
    "blockIndex": 8,
    "zh": "不自意能先入關破秦，得復見將軍於此。"
  },
  {
    "id": "s0093",
    "blockIndex": 8,
    "zh": "今者有小人之言，令將軍與臣有隙。"
  },
  {
    "id": "s0094",
    "blockIndex": 8,
    "zh": "」項羽曰：「此沛公左司馬曹無傷言之，不然，籍何以生此！"
  },
  {
    "id": "s0095",
    "blockIndex": 8,
    "zh": "」項羽因留沛公與飲。"
  },
  {
    "id": "s0096",
    "blockIndex": 8,
    "zh": "范增數目項羽，舉所佩玉□夬以示之者三。"
  },
  {
    "id": "s0097",
    "blockIndex": 8,
    "zh": "項羽默然不應。"
  },
  {
    "id": "s0098",
    "blockIndex": 8,
    "zh": "范增起，出，召項莊，謂曰：「君王為人不忍。"
  },
  {
    "id": "s0099",
    "blockIndex": 8,
    "zh": "若入前為壽，壽畢，以劍舞，因擊沛公於坐，殺之。"
  },
  {
    "id": "s0100",
    "blockIndex": 8,
    "zh": "不者，若屬皆且為所虜！"
  },
  {
    "id": "s0101",
    "blockIndex": 8,
    "zh": "」莊則入為壽，壽畢，曰：「軍中無以為樂，請以劍舞。"
  },
  {
    "id": "s0102",
    "blockIndex": 8,
    "zh": "」項羽曰：「諾。"
  },
  {
    "id": "s0103",
    "blockIndex": 8,
    "zh": "」項莊拔劍起舞。"
  },
  {
    "id": "s0104",
    "blockIndex": 8,
    "zh": "項伯亦拔劍起舞，常以身翼蔽沛公，莊不得擊。"
  },
  {
    "id": "s0105",
    "blockIndex": 9,
    "zh": "於是張良至軍門見樊噲。"
  },
  {
    "id": "s0106",
    "blockIndex": 9,
    "zh": "噲曰：「今日之事何如？"
  },
  {
    "id": "s0107",
    "blockIndex": 9,
    "zh": "」良曰：「今項莊拔劍舞，其意常在沛公也。"
  },
  {
    "id": "s0108",
    "blockIndex": 9,
    "zh": "」噲曰：「此迫矣，臣請入，與之同命！"
  },
  {
    "id": "s0109",
    "blockIndex": 9,
    "zh": "」噲即帶劍擁盾入。"
  },
  {
    "id": "s0110",
    "blockIndex": 9,
    "zh": "軍門衛士欲止不內，樊噲側其盾以撞，衛士僕地。"
  },
  {
    "id": "s0111",
    "blockIndex": 9,
    "zh": "遂入，披帷立，瞋目視項羽，頭髮上指，目眥盡裂。"
  },
  {
    "id": "s0112",
    "blockIndex": 9,
    "zh": "項羽按劍而跽曰：「客何為者？"
  },
  {
    "id": "s0113",
    "blockIndex": 9,
    "zh": "」張良曰：「沛公之參乘樊噲也。"
  },
  {
    "id": "s0114",
    "blockIndex": 9,
    "zh": "」項羽曰：「壯士！"
  },
  {
    "id": "s0115",
    "blockIndex": 9,
    "zh": "賜之卮酒！"
  },
  {
    "id": "s0116",
    "blockIndex": 9,
    "zh": "」則與斗卮酒。"
  },
  {
    "id": "s0117",
    "blockIndex": 9,
    "zh": "噲拜謝，起，立而飲之。"
  },
  {
    "id": "s0118",
    "blockIndex": 9,
    "zh": "項羽曰：「賜之彘肩。"
  },
  {
    "id": "s0119",
    "blockIndex": 9,
    "zh": "」則與一生彘肩。"
  },
  {
    "id": "s0120",
    "blockIndex": 9,
    "zh": "樊噲覆其盾於地，加彘肩其上，拔劍切而啖之。"
  },
  {
    "id": "s0121",
    "blockIndex": 9,
    "zh": "項羽曰：「壯士能復飲乎？"
  },
  {
    "id": "s0122",
    "blockIndex": 9,
    "zh": "」樊噲曰：「臣死且不避，卮酒安足辭？"
  },
  {
    "id": "s0123",
    "blockIndex": 9,
    "zh": "夫秦有虎狼之心，殺人如不能舉，刑人如恐不勝；"
  },
  {
    "id": "s0124",
    "blockIndex": 9,
    "zh": "天下皆叛之。"
  },
  {
    "id": "s0125",
    "blockIndex": 9,
    "zh": "懷王與諸將約曰：『先破秦入咸陽者，王之。"
  },
  {
    "id": "s0126",
    "blockIndex": 9,
    "zh": "』今沛公先破秦入咸陽，豪毛不敢有所近，還軍霸上以待將軍。"
  },
  {
    "id": "s0127",
    "blockIndex": 9,
    "zh": "勞苦而功高如此，未有封爵之賞，而聽細人之說，欲誅有功之人，此亡秦之續耳，竊為將軍不取也！"
  },
  {
    "id": "s0128",
    "blockIndex": 9,
    "zh": "」項羽未有以應，曰：「坐！"
  },
  {
    "id": "s0129",
    "blockIndex": 9,
    "zh": "」樊噲從良坐。"
  },
  {
    "id": "s0130",
    "blockIndex": 9,
    "zh": "坐須臾，沛公起如廁，因招樊噲出。"
  },
  {
    "id": "s0131",
    "blockIndex": 9,
    "zh": "公曰：「今者出，未辭也，為之奈何？"
  },
  {
    "id": "s0132",
    "blockIndex": 9,
    "zh": "」樊噲曰：「如今人方為刀俎，我方為魚肉，何辭為？"
  },
  {
    "id": "s0133",
    "blockIndex": 9,
    "zh": "」於是遂去。"
  },
  {
    "id": "s0134",
    "blockIndex": 9,
    "zh": "鴻門去霸上四十里，沛公則置車騎，脫身獨騎；"
  },
  {
    "id": "s0135",
    "blockIndex": 9,
    "zh": "樊噲、夏侯嬰、靳強、紀信等四人持劍、盾步走，從驪山下道芷陽，間行趣霸上。"
  },
  {
    "id": "s0136",
    "blockIndex": 9,
    "zh": "留張良使謝項羽，以白璧獻羽，玉斗與亞父。"
  },
  {
    "id": "s0137",
    "blockIndex": 9,
    "zh": "沛公謂良曰：「從此道至吾軍，不過二十里耳。"
  },
  {
    "id": "s0138",
    "blockIndex": 9,
    "zh": "度我至軍中，公乃入。"
  },
  {
    "id": "s0139",
    "blockIndex": 9,
    "zh": "」沛公已去，間至軍中，張良入謝曰：「沛公不勝杯杓，不能辭，謹使臣良奉白璧一雙，再拜獻將軍足下；"
  },
  {
    "id": "s0140",
    "blockIndex": 9,
    "zh": "玉斗一雙，再拜奉亞父足下。"
  },
  {
    "id": "s0141",
    "blockIndex": 9,
    "zh": "」項羽曰：「沛公安在？"
  },
  {
    "id": "s0142",
    "blockIndex": 9,
    "zh": "」良曰：「聞將軍有意督過之，脫身獨去，已至軍矣。"
  },
  {
    "id": "s0143",
    "blockIndex": 9,
    "zh": "」項羽則受璧，置之坐上。"
  },
  {
    "id": "s0144",
    "blockIndex": 9,
    "zh": "亞父受玉斗，置之地，拔劍撞而破之，曰：「唉！"
  },
  {
    "id": "s0145",
    "blockIndex": 9,
    "zh": "豎子不足與謀！"
  },
  {
    "id": "s0146",
    "blockIndex": 9,
    "zh": "奪將軍天下者，必沛公也。"
  },
  {
    "id": "s0147",
    "blockIndex": 9,
    "zh": "吾屬今為之虜矣！"
  },
  {
    "id": "s0148",
    "blockIndex": 9,
    "zh": "」沛公至軍，立誅殺曹無傷。"
  },
  {
    "id": "s0149",
    "blockIndex": 9,
    "zh": "居數日，項羽引兵西，屠咸陽，殺秦降王子嬰，燒秦宮室，火三月不滅。"
  },
  {
    "id": "s0150",
    "blockIndex": 9,
    "zh": "收其貨寶、婦女而東。"
  },
  {
    "id": "s0151",
    "blockIndex": 9,
    "zh": "秦民大失望。"
  },
  {
    "id": "s0152",
    "blockIndex": 9,
    "zh": "韓生說項羽曰：「關中阻山帶河，四塞之地，地肥饒，可都以霸。"
  },
  {
    "id": "s0153",
    "blockIndex": 9,
    "zh": "」項羽見秦宮室皆已燒殘破，又心思東歸，曰：「富貴不歸故鄉，如衣繡夜行，誰知之者？"
  },
  {
    "id": "s0154",
    "blockIndex": 9,
    "zh": "」韓生退曰：「人言楚人沐猴而冠耳，果然！"
  },
  {
    "id": "s0155",
    "blockIndex": 9,
    "zh": "」項羽聞之，烹韓生。"
  },
  {
    "id": "s0157",
    "blockIndex": 10,
    "zh": "3項羽使人致命懷王，懷王曰：「如約。"
  },
  {
    "id": "s0158",
    "blockIndex": 10,
    "zh": "」項羽怒曰：「懷王者，吾家所立耳，非有功伐，何以得專主約？"
  },
  {
    "id": "s0159",
    "blockIndex": 10,
    "zh": "天下初發難時，假立諸侯後以伐秦。"
  },
  {
    "id": "s0160",
    "blockIndex": 10,
    "zh": "然身被堅執銳首事，暴露於野三年，滅秦定天下者，皆將相諸君與籍之力也。"
  },
  {
    "id": "s0161",
    "blockIndex": 10,
    "zh": "懷王雖無功，固當分其地而王之。"
  },
  {
    "id": "s0162",
    "blockIndex": 10,
    "zh": "」諸將皆曰：「善！"
  },
  {
    "id": "s0163",
    "blockIndex": 10,
    "zh": "」春，正月，羽陽尊懷王為義帝，曰：「古之帝者，地方千里，必居上游。"
  },
  {
    "id": "s0164",
    "blockIndex": 10,
    "zh": "」乃徙義帝於江南，都郴。"
  },
  {
    "id": "s0165",
    "blockIndex": 11,
    "zh": "二月，羽分天下王諸將。"
  },
  {
    "id": "s0166",
    "blockIndex": 11,
    "zh": "羽自立為西楚霸王，王梁、楚地九郡，都彭城。"
  },
  {
    "id": "s0167",
    "blockIndex": 11,
    "zh": "羽與范增疑沛公，而業已講解，又惡負約，乃陰謀曰：「巴、蜀道險，秦之遷人皆居之。"
  },
  {
    "id": "s0168",
    "blockIndex": 11,
    "zh": "」乃曰：「巴、蜀亦關中地也。"
  },
  {
    "id": "s0169",
    "blockIndex": 11,
    "zh": "」故立沛公為漢王，王巴、蜀、漢中，都南鄭。"
  },
  {
    "id": "s0170",
    "blockIndex": 11,
    "zh": "而三分關中，王秦降將，以距塞漢路。"
  },
  {
    "id": "s0171",
    "blockIndex": 11,
    "zh": "章邯為雍王，王咸陽以西，都廢丘。"
  },
  {
    "id": "s0172",
    "blockIndex": 11,
    "zh": "長史欣者，故為櫟陽獄掾，嘗有德於項梁；"
  },
  {
    "id": "s0173",
    "blockIndex": 11,
    "zh": "都尉董翳者，本勸章邯降楚。"
  },
  {
    "id": "s0174",
    "blockIndex": 11,
    "zh": "故立欣為塞王，王咸陽以東，至河，都櫟陽；"
  },
  {
    "id": "s0175",
    "blockIndex": 11,
    "zh": "立翳為翟王，王上郡，都高奴。"
  },
  {
    "id": "s0176",
    "blockIndex": 11,
    "zh": "項羽欲自取梁地，乃徙魏王豹為西魏王，王河東，都平陽。"
  },
  {
    "id": "s0177",
    "blockIndex": 11,
    "zh": "瑕丘申陽者，張耳嬖臣也，先下河南郡，迎楚河上，故立申陽為河南王，都洛陽。"
  },
  {
    "id": "s0178",
    "blockIndex": 11,
    "zh": "韓王成因故都，都陽翟。"
  },
  {
    "id": "s0179",
    "blockIndex": 11,
    "zh": "趙將司馬卬定河內，數有功，故立卬為殷王，王河內，都朝歌。"
  },
  {
    "id": "s0180",
    "blockIndex": 11,
    "zh": "徙趙王歇為代王。"
  },
  {
    "id": "s0181",
    "blockIndex": 11,
    "zh": "趙相張耳素賢，又從入關，故立耳為常山王，王趙地，治襄國。"
  },
  {
    "id": "s0182",
    "blockIndex": 11,
    "zh": "當陽君黥布為楚將，常冠軍，故立布為九江王，都六。"
  },
  {
    "id": "s0183",
    "blockIndex": 11,
    "zh": "番君吳芮率百越佐諸侯，又從入關，故立芮為衡山王，都邾。"
  },
  {
    "id": "s0184",
    "blockIndex": 11,
    "zh": "義帝柱國共敖將軍擊南郡，功多，因立敖為臨江王，都江陵。"
  },
  {
    "id": "s0185",
    "blockIndex": 11,
    "zh": "徙燕王韓廣為遼東王，都無終。"
  },
  {
    "id": "s0186",
    "blockIndex": 11,
    "zh": "燕將臧荼從楚救趙，因從入關，故立荼為燕王，都薊。"
  },
  {
    "id": "s0187",
    "blockIndex": 11,
    "zh": "徙齊王田市為膠東王，都即墨。"
  },
  {
    "id": "s0188",
    "blockIndex": 11,
    "zh": "齊將田都從楚救趙，因從入關，故立都為齊王，都臨菑。"
  },
  {
    "id": "s0189",
    "blockIndex": 11,
    "zh": "項羽方渡河救趙，田安下濟北數城，引其兵降項羽，故立安為濟北王，都博陽。"
  },
  {
    "id": "s0190",
    "blockIndex": 11,
    "zh": "田榮數負項梁，又不肯將兵從楚擊秦，以故不封。"
  },
  {
    "id": "s0191",
    "blockIndex": 11,
    "zh": "成安君陳餘棄將印去，不從入關，亦不封。"
  },
  {
    "id": "s0192",
    "blockIndex": 11,
    "zh": "客多說項羽曰：「張耳、陳餘，一體有功於趙，今耳為王，餘不可以不封。"
  },
  {
    "id": "s0193",
    "blockIndex": 11,
    "zh": "」羽不得已，聞其在南皮，因環封之三縣。"
  },
  {
    "id": "s0194",
    "blockIndex": 11,
    "zh": "番君將梅鋗功多，封十萬戶侯。"
  },
  {
    "id": "s0196",
    "blockIndex": 12,
    "zh": "4漢王怒，欲攻項羽，周勃、灌嬰、樊噲皆勸之。"
  },
  {
    "id": "s0197",
    "blockIndex": 12,
    "zh": "蕭何諫曰：「雖王漢中之惡，不猶愈於死乎？"
  },
  {
    "id": "s0198",
    "blockIndex": 12,
    "zh": "」漢王曰：「何為乃死也？"
  },
  {
    "id": "s0199",
    "blockIndex": 12,
    "zh": "」何曰：「今眾弗如，百戰百敗，不死何為？"
  },
  {
    "id": "s0200",
    "blockIndex": 12,
    "zh": "夫能詘於一人之下而信於萬乘之上者，湯、武是也。"
  },
  {
    "id": "s0201",
    "blockIndex": 12,
    "zh": "臣願大王王漢中，養其民以致賢人，收用巴、蜀，還定三秦，天下可圖也。"
  },
  {
    "id": "s0202",
    "blockIndex": 12,
    "zh": "」漢王曰：「善！"
  },
  {
    "id": "s0203",
    "blockIndex": 12,
    "zh": "」乃遂就國，以何為丞相。"
  },
  {
    "id": "s0204",
    "blockIndex": 12,
    "zh": "漢王賜張良金百鎰，珠二斗；"
  },
  {
    "id": "s0205",
    "blockIndex": 12,
    "zh": "良具以獻項伯。"
  },
  {
    "id": "s0206",
    "blockIndex": 12,
    "zh": "漢王亦因令良厚遺項伯，使盡請漢中地，項王許之。"
  },
  {
    "id": "s0207",
    "blockIndex": 12,
    "zh": "夏，四月，諸侯罷戲下兵，各就國。"
  },
  {
    "id": "s0208",
    "blockIndex": 12,
    "zh": "項王使卒三萬人從漢王之國。"
  },
  {
    "id": "s0209",
    "blockIndex": 12,
    "zh": "楚與諸侯之慕從者數萬人，從杜南入蝕中。"
  },
  {
    "id": "s0210",
    "blockIndex": 12,
    "zh": "張良送至褒中，漢王遣良歸韓；"
  },
  {
    "id": "s0211",
    "blockIndex": 12,
    "zh": "良因說漢王燒絕所過棧道，以備諸侯盜兵，且示項羽無東意。"
  },
  {
    "id": "s0213",
    "blockIndex": 13,
    "zh": "5田榮聞項羽徙齊王市於膠東，而以田都為齊王，大怒。"
  },
  {
    "id": "s0214",
    "blockIndex": 13,
    "zh": "五月，榮發兵距擊田都，都亡走楚。"
  },
  {
    "id": "s0215",
    "blockIndex": 13,
    "zh": "榮留齊王市，不令之膠東。"
  },
  {
    "id": "s0216",
    "blockIndex": 13,
    "zh": "市畏項羽，竊亡之國。"
  },
  {
    "id": "s0217",
    "blockIndex": 13,
    "zh": "榮怒，六月，追擊殺市於即墨，自立為齊王。"
  },
  {
    "id": "s0218",
    "blockIndex": 13,
    "zh": "是時，彭越在巨野，有眾萬餘人，無所屬。"
  },
  {
    "id": "s0219",
    "blockIndex": 13,
    "zh": "榮與越將軍印，使擊濟北。"
  },
  {
    "id": "s0220",
    "blockIndex": 13,
    "zh": "秋，七月，越擊殺濟北王安。"
  },
  {
    "id": "s0221",
    "blockIndex": 13,
    "zh": "榮遂並王三齊之地，又使越擊楚。"
  },
  {
    "id": "s0222",
    "blockIndex": 13,
    "zh": "項王命蕭公角將兵擊越，越大破楚軍。"
  },
  {
    "id": "s0224",
    "blockIndex": 14,
    "zh": "6張耳之國，陳餘益怒曰：「張耳與餘，功等也。"
  },
  {
    "id": "s0225",
    "blockIndex": 14,
    "zh": "今張耳王，餘獨侯，此項羽不平！"
  },
  {
    "id": "s0226",
    "blockIndex": 14,
    "zh": "」乃陰使張同、夏說說齊王榮曰：「項羽為天下宰不平，盡王諸將善地，徙故王於丑地。"
  },
  {
    "id": "s0227",
    "blockIndex": 14,
    "zh": "今趙王乃北居代，餘以為不可。"
  },
  {
    "id": "s0228",
    "blockIndex": 14,
    "zh": "聞大王起兵，不聽不義。"
  },
  {
    "id": "s0229",
    "blockIndex": 14,
    "zh": "願大王資餘兵擊常山，復趙王，請以趙為扞蔽！"
  },
  {
    "id": "s0230",
    "blockIndex": 14,
    "zh": "」齊王許之，遣兵從陳餘。"
  },
  {
    "id": "s0232",
    "blockIndex": 15,
    "zh": "7項王以張良從漢王，韓王成又無功，故不遣之國，與俱至彭城，廢以為穰侯；"
  },
  {
    "id": "s0233",
    "blockIndex": 15,
    "zh": "已，又殺之。"
  },
  {
    "id": "s0235",
    "blockIndex": 16,
    "zh": "8初，淮陰人韓信，家貧，無行，不得推擇為吏，又不能治生商賈，常從人寄食飲，人多厭之。"
  },
  {
    "id": "s0236",
    "blockIndex": 16,
    "zh": "信釣於城下，有漂母見信饑，飯信。"
  },
  {
    "id": "s0237",
    "blockIndex": 16,
    "zh": "信喜，謂漂母曰：「吾必有以重報母。"
  },
  {
    "id": "s0238",
    "blockIndex": 16,
    "zh": "」母怒曰：「大丈夫不能自食，吾哀王孫而進食，豈望報乎？"
  },
  {
    "id": "s0239",
    "blockIndex": 16,
    "zh": "」淮陰屠中少年有侮信者曰：「若雖長大，好帶刀劍，中情怯耳。"
  },
  {
    "id": "s0240",
    "blockIndex": 16,
    "zh": "」因眾辱之曰：「信能死，刺我；"
  },
  {
    "id": "s0241",
    "blockIndex": 16,
    "zh": "不能死，出我胯下！"
  },
  {
    "id": "s0242",
    "blockIndex": 16,
    "zh": "」於是信孰視之，俛出胯下，蒲伏。"
  },
  {
    "id": "s0243",
    "blockIndex": 16,
    "zh": "一市人皆笑信，以為怯。"
  },
  {
    "id": "s0244",
    "blockIndex": 16,
    "zh": "及項梁渡淮，信杖劍從之。"
  },
  {
    "id": "s0245",
    "blockIndex": 16,
    "zh": "居麾下，無所知名。"
  },
  {
    "id": "s0246",
    "blockIndex": 16,
    "zh": "項梁敗，又屬項羽，羽以為郎中。"
  },
  {
    "id": "s0247",
    "blockIndex": 16,
    "zh": "數以策干羽，羽不用。"
  },
  {
    "id": "s0248",
    "blockIndex": 16,
    "zh": "漢王之入蜀，信亡楚歸漢，未知名。"
  },
  {
    "id": "s0249",
    "blockIndex": 16,
    "zh": "為連敖，坐當斬。"
  },
  {
    "id": "s0250",
    "blockIndex": 16,
    "zh": "其輩十三人皆已斬，次至信，信乃仰視，適見滕公，曰：「上不欲就天下乎？"
  },
  {
    "id": "s0251",
    "blockIndex": 16,
    "zh": "何為斬壯士？"
  },
  {
    "id": "s0252",
    "blockIndex": 16,
    "zh": "」滕公奇其言，壯其貌，釋而不斬。"
  },
  {
    "id": "s0253",
    "blockIndex": 16,
    "zh": "與語，大說之，言於王。"
  },
  {
    "id": "s0254",
    "blockIndex": 16,
    "zh": "王拜以為治粟都尉，亦未之奇也。"
  },
  {
    "id": "s0255",
    "blockIndex": 16,
    "zh": "信數與蕭何語，何奇之。"
  },
  {
    "id": "s0256",
    "blockIndex": 16,
    "zh": "漢王至南鄭，諸將及士卒皆歌謳思東歸，多道亡者。"
  },
  {
    "id": "s0257",
    "blockIndex": 16,
    "zh": "信度何等已數言王，王不我用，即亡去。"
  },
  {
    "id": "s0258",
    "blockIndex": 16,
    "zh": "何聞信亡，不及以聞，自追之。"
  },
  {
    "id": "s0259",
    "blockIndex": 16,
    "zh": "人有言王曰：「丞相何亡。"
  },
  {
    "id": "s0260",
    "blockIndex": 16,
    "zh": "」王大怒，如失左右手。"
  },
  {
    "id": "s0261",
    "blockIndex": 16,
    "zh": "居一二日，何來謁王。"
  },
  {
    "id": "s0262",
    "blockIndex": 16,
    "zh": "王且怒且喜，罵何曰：「若亡，何也？"
  },
  {
    "id": "s0263",
    "blockIndex": 16,
    "zh": "」何曰：「臣不敢亡也，臣追亡者耳。"
  },
  {
    "id": "s0264",
    "blockIndex": 16,
    "zh": "」王曰：「若所追者誰？"
  },
  {
    "id": "s0265",
    "blockIndex": 16,
    "zh": "」何曰：「韓信也。"
  },
  {
    "id": "s0266",
    "blockIndex": 16,
    "zh": "」王復罵曰：「諸將亡者以十數，公無所追。"
  },
  {
    "id": "s0267",
    "blockIndex": 16,
    "zh": "追信，詐也。"
  },
  {
    "id": "s0268",
    "blockIndex": 16,
    "zh": "」何曰：「諸將易得耳。"
  },
  {
    "id": "s0269",
    "blockIndex": 16,
    "zh": "至如信者，國士無雙。"
  },
  {
    "id": "s0270",
    "blockIndex": 16,
    "zh": "王必欲長王漢中，無所事信，必欲爭天下，非信無可與計事者。"
  },
  {
    "id": "s0271",
    "blockIndex": 16,
    "zh": "顧王策安所決耳。"
  },
  {
    "id": "s0272",
    "blockIndex": 16,
    "zh": "」王曰：「吾亦欲東耳，安能鬱鬱久居此乎？"
  },
  {
    "id": "s0273",
    "blockIndex": 16,
    "zh": "」何曰：「計必欲東，能用信，信即留；"
  },
  {
    "id": "s0274",
    "blockIndex": 16,
    "zh": "不能用信，終亡耳。"
  },
  {
    "id": "s0275",
    "blockIndex": 16,
    "zh": "」王曰：「吾為公以為將。"
  },
  {
    "id": "s0276",
    "blockIndex": 16,
    "zh": "」何曰：「雖為將，信不留。"
  },
  {
    "id": "s0277",
    "blockIndex": 16,
    "zh": "」王曰：「以為大將。"
  },
  {
    "id": "s0278",
    "blockIndex": 16,
    "zh": "」何曰：「幸甚！"
  },
  {
    "id": "s0279",
    "blockIndex": 16,
    "zh": "」於是王欲召信拜之。"
  },
  {
    "id": "s0280",
    "blockIndex": 16,
    "zh": "何曰：「王素慢無禮。"
  },
  {
    "id": "s0281",
    "blockIndex": 16,
    "zh": "今拜大將，如呼小兒，此乃信所以去也。"
  },
  {
    "id": "s0282",
    "blockIndex": 16,
    "zh": "王必欲拜之，擇良日，齋戒，設壇場，具禮，乃可耳。"
  },
  {
    "id": "s0283",
    "blockIndex": 16,
    "zh": "」王許之。"
  },
  {
    "id": "s0284",
    "blockIndex": 16,
    "zh": "諸將皆喜，人人各自以為得大將。"
  },
  {
    "id": "s0285",
    "blockIndex": 16,
    "zh": "至拜大將，乃韓信也，一軍皆驚。"
  },
  {
    "id": "s0286",
    "blockIndex": 17,
    "zh": "信拜禮畢，上坐。"
  },
  {
    "id": "s0287",
    "blockIndex": 17,
    "zh": "王曰：「丞相數言將軍，將軍何以教寡人計策？"
  },
  {
    "id": "s0288",
    "blockIndex": 17,
    "zh": "」信辭謝，因問王曰：「今東鄉爭權天下，豈非項王耶？"
  },
  {
    "id": "s0289",
    "blockIndex": 17,
    "zh": "」漢王曰：「然。"
  },
  {
    "id": "s0290",
    "blockIndex": 17,
    "zh": "」曰：「大王自料勇悍仁強孰與項王？"
  },
  {
    "id": "s0291",
    "blockIndex": 17,
    "zh": "」漢王默然良久，曰：「不如也。"
  },
  {
    "id": "s0292",
    "blockIndex": 17,
    "zh": "」信再拜賀曰：「惟信亦以為大王不如也。"
  },
  {
    "id": "s0293",
    "blockIndex": 17,
    "zh": "然臣嘗事之，請言項王之為人也。"
  },
  {
    "id": "s0294",
    "blockIndex": 17,
    "zh": "項王暗噁叱吒，千人皆廢，然不能任屬賢將，此特匹夫之勇耳。"
  },
  {
    "id": "s0295",
    "blockIndex": 17,
    "zh": "項王見人，恭敬慈愛，言語嘔嘔，人有疾病，涕泣分食飲；"
  },
  {
    "id": "s0296",
    "blockIndex": 17,
    "zh": "至使人，有功當封爵者，印刓敝，忍不能予，此所謂婦人之仁也。"
  },
  {
    "id": "s0297",
    "blockIndex": 17,
    "zh": "項王雖霸天下而臣諸侯，不居關中而都彭城；"
  },
  {
    "id": "s0298",
    "blockIndex": 17,
    "zh": "背義帝之約，而以親愛王諸侯，不平；"
  },
  {
    "id": "s0299",
    "blockIndex": 17,
    "zh": "逐其故主而王其將相，又遷逐義帝置江南；"
  },
  {
    "id": "s0300",
    "blockIndex": 17,
    "zh": "所過無不殘滅，百姓不親附，特劫於威強耳。"
  },
  {
    "id": "s0301",
    "blockIndex": 17,
    "zh": "名雖為霸，實失天下心，故其強易弱。"
  },
  {
    "id": "s0302",
    "blockIndex": 17,
    "zh": "今大王誠能反其道，任天下武勇，何所不誅以？"
  },
  {
    "id": "s0303",
    "blockIndex": 17,
    "zh": "天下城邑封功臣，何所不服？"
  },
  {
    "id": "s0304",
    "blockIndex": 17,
    "zh": "以義兵從思東歸之士，何所不散？"
  },
  {
    "id": "s0305",
    "blockIndex": 17,
    "zh": "且三秦王為秦將，將秦子弟數歲矣，所殺亡不可勝計；"
  },
  {
    "id": "s0306",
    "blockIndex": 17,
    "zh": "又欺其眾降諸侯，至新安，項王詐坑秦降卒二十餘萬，唯獨邯、欣、翳得脫。"
  },
  {
    "id": "s0307",
    "blockIndex": 17,
    "zh": "秦父兄怨此三人，痛入骨髓。"
  },
  {
    "id": "s0308",
    "blockIndex": 17,
    "zh": "今楚強以威王此三人，秦民莫愛也。"
  },
  {
    "id": "s0309",
    "blockIndex": 17,
    "zh": "大王之入武關，秋毫無所害；"
  },
  {
    "id": "s0310",
    "blockIndex": 17,
    "zh": "除秦苛法，與秦民約法三章；"
  },
  {
    "id": "s0311",
    "blockIndex": 17,
    "zh": "秦民無不欲得大王王秦者。"
  },
  {
    "id": "s0312",
    "blockIndex": 17,
    "zh": "於諸侯之約，大王當王關中，民鹹知之；"
  },
  {
    "id": "s0313",
    "blockIndex": 17,
    "zh": "大王失職入漢中，秦民無不恨者。"
  },
  {
    "id": "s0314",
    "blockIndex": 17,
    "zh": "今大王舉而東，三秦可傳檄而定也。"
  },
  {
    "id": "s0315",
    "blockIndex": 17,
    "zh": "」於是漢王大喜，自以為得信晚，遂聽信計，部署諸將所擊。"
  },
  {
    "id": "s0316",
    "blockIndex": 17,
    "zh": "留蕭何收巴、蜀租，給軍糧食。"
  },
  {
    "id": "s0318",
    "blockIndex": 18,
    "zh": "9八月，漢王引兵從故道出，襲雍；"
  },
  {
    "id": "s0319",
    "blockIndex": 18,
    "zh": "雍王章邯迎擊漢陳倉。"
  },
  {
    "id": "s0320",
    "blockIndex": 18,
    "zh": "雍兵敗，還走；"
  },
  {
    "id": "s0321",
    "blockIndex": 18,
    "zh": "止，戰好畤，又敗，走廢丘。"
  },
  {
    "id": "s0322",
    "blockIndex": 18,
    "zh": "漢王遂定雍地，東至咸陽，引兵圍雍王於廢丘，而遣諸將略地。"
  },
  {
    "id": "s0323",
    "blockIndex": 18,
    "zh": "塞王欣、翟王翳皆降，以其地為渭南、河上、上郡。"
  },
  {
    "id": "s0324",
    "blockIndex": 18,
    "zh": "將軍薛歐、王吸出武關，因王陵兵以迎太公、呂后。"
  },
  {
    "id": "s0325",
    "blockIndex": 18,
    "zh": "項王聞之，發兵距之陽夏，不得前。"
  },
  {
    "id": "s0326",
    "blockIndex": 18,
    "zh": "王陵者，沛人也，先聚黨數千人，居南陽，至是始以兵屬漢。"
  },
  {
    "id": "s0327",
    "blockIndex": 18,
    "zh": "項王取陵母置軍中，陵使至，則東鄉坐陵母，欲以招陵。"
  },
  {
    "id": "s0328",
    "blockIndex": 18,
    "zh": "陵母私送使者，泣曰：「願為老妾語陵：善事漢王，漢王長者，終得天下，毋以老妾故持二心。"
  },
  {
    "id": "s0329",
    "blockIndex": 18,
    "zh": "妾以死送使者！"
  },
  {
    "id": "s0330",
    "blockIndex": 18,
    "zh": "」遂伏劍而死。"
  },
  {
    "id": "s0331",
    "blockIndex": 18,
    "zh": "項王怒。"
  },
  {
    "id": "s0332",
    "blockIndex": 18,
    "zh": "烹陵母。"
  },
  {
    "id": "s0333",
    "blockIndex": 19,
    "zh": "項王以故吳令鄭昌為韓王，以距漢。"
  },
  {
    "id": "s0334",
    "blockIndex": 20,
    "zh": "張良遺項王書曰：「漢王失職，欲得關中，如約即止，不敢東。"
  },
  {
    "id": "s0335",
    "blockIndex": 20,
    "zh": "」又以齊、梁反書遺項王曰：「齊欲與趙並滅楚。"
  },
  {
    "id": "s0336",
    "blockIndex": 20,
    "zh": "」項王以此故無西意，而北擊齊。"
  },
  {
    "id": "s0338",
    "blockIndex": 21,
    "zh": "10燕王廣不肯之遼東，臧荼擊殺之，並其地。"
  },
  {
    "id": "s0340",
    "blockIndex": 22,
    "zh": "11是歲，以內史沛周苛為御史大夫。"
  },
  {
    "id": "s0342",
    "blockIndex": 23,
    "zh": "12項王使趣義帝行，其群臣、左右稍稍叛之。"
  },
  {
    "id": "s0344",
    "blockIndex": 24,
    "zh": "1冬，十月，項王密使九江、衡山、臨江王擊義帝，殺之江中。"
  },
  {
    "id": "s0346",
    "blockIndex": 25,
    "zh": "2陳餘悉三縣兵，與齊兵共襲常山。"
  },
  {
    "id": "s0347",
    "blockIndex": 25,
    "zh": "常山王張耳敗，走漢，謁漢王於廢丘，漢王厚遇之。"
  },
  {
    "id": "s0348",
    "blockIndex": 25,
    "zh": "陳餘迎趙王於代，復為趙王。"
  },
  {
    "id": "s0349",
    "blockIndex": 25,
    "zh": "趙王德陳餘，立以為代王。"
  },
  {
    "id": "s0350",
    "blockIndex": 25,
    "zh": "陳餘為趙王弱，國初定，不之國，留傅趙王；"
  },
  {
    "id": "s0351",
    "blockIndex": 25,
    "zh": "而使夏說以相國守代。"
  },
  {
    "id": "s0353",
    "blockIndex": 26,
    "zh": "3張良自韓間行歸漢，漢王以為成信侯。"
  },
  {
    "id": "s0354",
    "blockIndex": 26,
    "zh": "良多病，未嘗特將，常為畫策臣，時時從漢王。"
  },
  {
    "id": "s0356",
    "blockIndex": 27,
    "zh": "4漢王如陝，鎮撫關外父老。"
  },
  {
    "id": "s0358",
    "blockIndex": 28,
    "zh": "5河南王申陽降，置河南郡。"
  },
  {
    "id": "s0360",
    "blockIndex": 29,
    "zh": "6漢王以韓襄王孫信為韓太尉，將兵略韓地。"
  },
  {
    "id": "s0361",
    "blockIndex": 29,
    "zh": "信急擊韓王昌於陽城，昌降。"
  },
  {
    "id": "s0362",
    "blockIndex": 29,
    "zh": "十一月，立信為韓王，常將韓兵從漢王。"
  },
  {
    "id": "s0364",
    "blockIndex": 30,
    "zh": "7漢王還都櫟陽。"
  },
  {
    "id": "s0366",
    "blockIndex": 31,
    "zh": "8諸將拔隴西。"
  },
  {
    "id": "s0368",
    "blockIndex": 32,
    "zh": "9春，正月，項王北至城陽。"
  },
  {
    "id": "s0369",
    "blockIndex": 32,
    "zh": "齊王榮將兵會戰，敗，走平原，平原民殺之。"
  },
  {
    "id": "s0370",
    "blockIndex": 32,
    "zh": "項王復立田假為齊王。"
  },
  {
    "id": "s0371",
    "blockIndex": 32,
    "zh": "遂北至北海，燒夷城郭、室屋，坑田榮降卒，系虜其老弱、婦女，所過多所殘滅。"
  },
  {
    "id": "s0372",
    "blockIndex": 32,
    "zh": "齊民相聚叛之。"
  },
  {
    "id": "s0374",
    "blockIndex": 33,
    "zh": "10漢將拔北地，虜雍王弟平。"
  },
  {
    "id": "s0376",
    "blockIndex": 34,
    "zh": "11三月，漢王自臨晉渡河。"
  },
  {
    "id": "s0377",
    "blockIndex": 34,
    "zh": "魏王豹降，將兵從；"
  },
  {
    "id": "s0378",
    "blockIndex": 34,
    "zh": "下河內，虜殷王卬，置河內郡。"
  },
  {
    "id": "s0380",
    "blockIndex": 35,
    "zh": "12初，陽武人陳平，家貧，好讀書。"
  },
  {
    "id": "s0381",
    "blockIndex": 35,
    "zh": "里中社，平為宰，分肉食甚均。"
  },
  {
    "id": "s0382",
    "blockIndex": 35,
    "zh": "父老曰：「善，陳孺子之為宰！"
  },
  {
    "id": "s0383",
    "blockIndex": 35,
    "zh": "」平曰：「嗟乎，使平得宰天下，亦如是肉矣！"
  },
  {
    "id": "s0384",
    "blockIndex": 35,
    "zh": "」及諸侯叛秦，平事魏王咎於臨濟，為太僕，說魏王，不聽。"
  },
  {
    "id": "s0385",
    "blockIndex": 35,
    "zh": "人或讒之，平亡去。"
  },
  {
    "id": "s0386",
    "blockIndex": 35,
    "zh": "後事項羽，賜爵為卿。"
  },
  {
    "id": "s0387",
    "blockIndex": 35,
    "zh": "殷王反楚，項羽使平擊降之。"
  },
  {
    "id": "s0388",
    "blockIndex": 35,
    "zh": "還，拜為都尉，賜金二十鎰。"
  },
  {
    "id": "s0389",
    "blockIndex": 35,
    "zh": "居無何，漢王攻下殷。"
  },
  {
    "id": "s0390",
    "blockIndex": 35,
    "zh": "項王怒，將誅定殷將吏。"
  },
  {
    "id": "s0391",
    "blockIndex": 35,
    "zh": "平懼，乃封其金與印，使使歸項王；"
  },
  {
    "id": "s0392",
    "blockIndex": 35,
    "zh": "而挺身間行，杖劍亡，渡河，歸漢王於脩武，因魏無知求見漢王。"
  },
  {
    "id": "s0393",
    "blockIndex": 35,
    "zh": "漢王召入，賜食，遣罷就舍。"
  },
  {
    "id": "s0394",
    "blockIndex": 35,
    "zh": "平曰：「臣為事來，所言不可以過今日。"
  },
  {
    "id": "s0395",
    "blockIndex": 35,
    "zh": "」於是漢王與語而說之。"
  },
  {
    "id": "s0396",
    "blockIndex": 35,
    "zh": "問曰：「子之居楚何官？"
  },
  {
    "id": "s0397",
    "blockIndex": 35,
    "zh": "」曰：「為都尉。"
  },
  {
    "id": "s0398",
    "blockIndex": 35,
    "zh": "」是日，即拜平為都尉，使為參乘，典護軍。"
  },
  {
    "id": "s0399",
    "blockIndex": 35,
    "zh": "諸將盡讙曰：「大王一日得楚之亡卒，未知其高下，而即與同載，反使監護長者！"
  },
  {
    "id": "s0400",
    "blockIndex": 35,
    "zh": "」漢王聞之，愈益幸平。"
  },
  {
    "id": "s0402",
    "blockIndex": 36,
    "zh": "13漢王南渡平陰津，至洛陽新城。"
  },
  {
    "id": "s0403",
    "blockIndex": 36,
    "zh": "三老董公遮說王曰：「臣聞『順德者昌，逆德者亡』；"
  },
  {
    "id": "s0404",
    "blockIndex": 36,
    "zh": "『兵出無名，事故不成』。"
  },
  {
    "id": "s0405",
    "blockIndex": 36,
    "zh": "故曰：『明其為賊，敵乃可服。"
  },
  {
    "id": "s0406",
    "blockIndex": 36,
    "zh": "』項羽為無道，放殺其主，天下之賊也。"
  },
  {
    "id": "s0407",
    "blockIndex": 36,
    "zh": "夫仁不以勇，義不以力，大王宜率三軍之眾為之素服，以告諸侯而伐之，則四海之內莫不仰德，此三王之舉也。"
  },
  {
    "id": "s0408",
    "blockIndex": 36,
    "zh": "」於是漢王為義帝發喪，袒而大哭，哀臨三日，發使告諸侯曰：「天下共立義帝，北面事之。"
  },
  {
    "id": "s0409",
    "blockIndex": 36,
    "zh": "今項羽放殺義帝江南，大逆無道！"
  },
  {
    "id": "s0410",
    "blockIndex": 36,
    "zh": "寡人悉發關中兵，收三河士，南浮江、漢以下，願從諸侯王擊楚之殺義帝者！"
  },
  {
    "id": "s0411",
    "blockIndex": 36,
    "zh": "」使者至趙，陳餘曰：「漢殺張耳，乃從。"
  },
  {
    "id": "s0412",
    "blockIndex": 36,
    "zh": "」於是漢王求人類張耳者斬之，持其頭遺陳餘；"
  },
  {
    "id": "s0413",
    "blockIndex": 36,
    "zh": "餘乃遣兵助漢。"
  },
  {
    "id": "s0415",
    "blockIndex": 37,
    "zh": "14田榮弟橫收散卒，得數萬人，起城陽，夏，四月，立榮子廣為齊王，以拒楚。"
  },
  {
    "id": "s0416",
    "blockIndex": 37,
    "zh": "項王因留，連戰，未能下。"
  },
  {
    "id": "s0417",
    "blockIndex": 37,
    "zh": "雖聞漢東，既擊齊，欲遂破之而後擊漢，漢王以故得率諸侯兵凡五十六萬人伐楚。"
  },
  {
    "id": "s0418",
    "blockIndex": 37,
    "zh": "到外黃，彭越將其兵三萬餘人歸漢。"
  },
  {
    "id": "s0419",
    "blockIndex": 37,
    "zh": "漢王曰：「彭將軍收魏地得十餘城，欲急立魏後。"
  },
  {
    "id": "s0420",
    "blockIndex": 37,
    "zh": "今西魏王豹，真魏後。"
  },
  {
    "id": "s0421",
    "blockIndex": 37,
    "zh": "」乃拜彭越為魏相國，擅將其兵略定梁地。"
  },
  {
    "id": "s0422",
    "blockIndex": 37,
    "zh": "漢王遂入城，收其貨寶、美人，日置酒高會。"
  },
  {
    "id": "s0423",
    "blockIndex": 38,
    "zh": "項王聞之，令諸將擊齊，而自以精兵三萬人南，從魯出胡陵至蕭。"
  },
  {
    "id": "s0424",
    "blockIndex": 38,
    "zh": "晨，擊漢軍而東至彭城，日中，大破漢軍。"
  },
  {
    "id": "s0425",
    "blockIndex": 38,
    "zh": "漢軍皆走，相隨入穀、泗水，死者十餘萬人。"
  },
  {
    "id": "s0426",
    "blockIndex": 38,
    "zh": "漢卒皆南走山，楚又追擊至靈壁東睢水上；"
  },
  {
    "id": "s0427",
    "blockIndex": 38,
    "zh": "漢軍卻，為楚所擠，卒十餘萬人皆入睢水，水為之不流。"
  },
  {
    "id": "s0428",
    "blockIndex": 38,
    "zh": "圍漢王三匝。"
  },
  {
    "id": "s0429",
    "blockIndex": 38,
    "zh": "會大風從西北起，折木，發屋，揚沙石，窈冥晝晦，逢迎楚軍，大亂壞散，而漢王乃得與數十騎遁去。"
  },
  {
    "id": "s0430",
    "blockIndex": 38,
    "zh": "欲過沛收家室，而楚亦使人之沛取漢王家。"
  },
  {
    "id": "s0431",
    "blockIndex": 38,
    "zh": "家皆亡，不與漢王相見。"
  },
  {
    "id": "s0432",
    "blockIndex": 39,
    "zh": "漢王道逢孝惠、魯元公主，載以行。"
  },
  {
    "id": "s0433",
    "blockIndex": 39,
    "zh": "楚騎追之，漢王急，推墮二子車下。"
  },
  {
    "id": "s0434",
    "blockIndex": 39,
    "zh": "滕公為太僕，常下收載之。"
  },
  {
    "id": "s0435",
    "blockIndex": 39,
    "zh": "如是者三，曰：「今雖急，不可以驅，奈何棄之！"
  },
  {
    "id": "s0436",
    "blockIndex": 39,
    "zh": "」故徐行。"
  },
  {
    "id": "s0437",
    "blockIndex": 39,
    "zh": "漢王怒，欲斬之者十餘；"
  },
  {
    "id": "s0438",
    "blockIndex": 39,
    "zh": "滕公卒保護，脫二子。"
  },
  {
    "id": "s0439",
    "blockIndex": 39,
    "zh": "審食其從太公、呂后間行求漢王，不相遇，反遇楚軍。"
  },
  {
    "id": "s0440",
    "blockIndex": 39,
    "zh": "楚軍與歸，項王常置軍中為質。"
  },
  {
    "id": "s0441",
    "blockIndex": 40,
    "zh": "是時，呂后兄周呂侯為漢將兵，居下邑。"
  },
  {
    "id": "s0442",
    "blockIndex": 40,
    "zh": "漢王間往從之，稍稍收其士卒。"
  },
  {
    "id": "s0443",
    "blockIndex": 40,
    "zh": "諸侯皆背漢，復與楚。"
  },
  {
    "id": "s0444",
    "blockIndex": 40,
    "zh": "塞王欣、翟王翳亡降楚。"
  },
  {
    "id": "s0446",
    "blockIndex": 41,
    "zh": "15田橫進攻田假，假走楚，楚殺之。"
  },
  {
    "id": "s0447",
    "blockIndex": 41,
    "zh": "橫遂復定三齊之地。"
  },
  {
    "id": "s0449",
    "blockIndex": 42,
    "zh": "16漢王問群臣曰：「吾欲捐關以東，等棄之，誰可與共功者？"
  },
  {
    "id": "s0450",
    "blockIndex": 42,
    "zh": "」張良曰：「九江王布，楚梟將，與項王有隙；"
  },
  {
    "id": "s0451",
    "blockIndex": 42,
    "zh": "彭越與齊反梁地；"
  },
  {
    "id": "s0452",
    "blockIndex": 42,
    "zh": "此兩人可急使。"
  },
  {
    "id": "s0453",
    "blockIndex": 42,
    "zh": "而漢王之將，獨韓信可屬大事，當一面。"
  },
  {
    "id": "s0454",
    "blockIndex": 42,
    "zh": "即欲捐之，捐之此三人，則楚可破也！"
  },
  {
    "id": "s0456",
    "blockIndex": 43,
    "zh": "初，項王擊齊，徵兵九江，九江王布稱病不在，遣將將軍數千人行。"
  },
  {
    "id": "s0457",
    "blockIndex": 43,
    "zh": "漢之破楚彭城，布又稱病不佐楚。"
  },
  {
    "id": "s0458",
    "blockIndex": 43,
    "zh": "楚王由此怨布，婁使使者誚讓，召布。"
  },
  {
    "id": "s0459",
    "blockIndex": 43,
    "zh": "布愈恐，不敢往。"
  },
  {
    "id": "s0460",
    "blockIndex": 43,
    "zh": "項王方北憂齊、趙，西患漢，所與者獨九江王；"
  },
  {
    "id": "s0461",
    "blockIndex": 43,
    "zh": "又多布材，欲親用之，以故未之擊。"
  },
  {
    "id": "s0462",
    "blockIndex": 43,
    "zh": "漢王自下邑徙軍碭，遂至虞，謂左右曰：「如彼等者，無足與計天下事！"
  },
  {
    "id": "s0463",
    "blockIndex": 43,
    "zh": "」謁者隨何進曰：「不審陛下所謂。"
  },
  {
    "id": "s0464",
    "blockIndex": 43,
    "zh": "」漢王曰：「孰能為我使九江，令之發兵倍楚？"
  },
  {
    "id": "s0465",
    "blockIndex": 43,
    "zh": "留項王數月，我之取天下可以百全。"
  },
  {
    "id": "s0466",
    "blockIndex": 43,
    "zh": "」隨何曰：「臣請使之！"
  },
  {
    "id": "s0467",
    "blockIndex": 43,
    "zh": "」漢王使與二十人俱。"
  },
  {
    "id": "s0469",
    "blockIndex": 44,
    "zh": "17五月，漢王至滎陽，諸敗軍皆會，蕭何亦發關中老弱未傅者悉詣滎陽，漢軍復大振。"
  },
  {
    "id": "s0470",
    "blockIndex": 44,
    "zh": "楚起於彭城，常乘勝逐北，與漢戰滎陽南京、索間。"
  },
  {
    "id": "s0471",
    "blockIndex": 44,
    "zh": "楚騎來眾，漢王擇軍中可為騎將者，皆推故奉騎士重泉人李必、駱甲。"
  },
  {
    "id": "s0472",
    "blockIndex": 44,
    "zh": "漢王欲拜之，必、甲曰：「臣故秦民，恐軍不信；"
  },
  {
    "id": "s0473",
    "blockIndex": 44,
    "zh": "願得大王左右善騎者傅之。"
  },
  {
    "id": "s0474",
    "blockIndex": 44,
    "zh": "」乃拜灌嬰為中大夫令，李必、駱甲為左右校尉，將騎兵擊楚騎於滎陽東，大破之，楚以故不能過滎陽而西。"
  },
  {
    "id": "s0475",
    "blockIndex": 44,
    "zh": "漢王軍滎陽，築甬道屬之河，以取敖倉粟。"
  },
  {
    "id": "s0477",
    "blockIndex": 45,
    "zh": "18周勃、灌嬰等言於漢王曰：「陳平雖美如冠玉，其中未必有也。"
  },
  {
    "id": "s0478",
    "blockIndex": 45,
    "zh": "臣聞平居家時盜其嫂；"
  },
  {
    "id": "s0479",
    "blockIndex": 45,
    "zh": "事魏不容，亡歸楚；"
  },
  {
    "id": "s0480",
    "blockIndex": 45,
    "zh": "不中，又亡歸漢。"
  },
  {
    "id": "s0481",
    "blockIndex": 45,
    "zh": "今日大王尊官之，令護軍。"
  },
  {
    "id": "s0482",
    "blockIndex": 45,
    "zh": "臣聞平受諸將金，金多者得善處，金少者得惡處。"
  },
  {
    "id": "s0483",
    "blockIndex": 45,
    "zh": "平，反覆亂臣也，願王察之！"
  },
  {
    "id": "s0484",
    "blockIndex": 45,
    "zh": "」漢王疑之，召讓魏無知。"
  },
  {
    "id": "s0485",
    "blockIndex": 45,
    "zh": "無知曰：「臣所言者能也，陛下所問者行也。"
  },
  {
    "id": "s0486",
    "blockIndex": 45,
    "zh": "今有尾生、孝己之行，而無益勝負之數，陛下何暇用之乎！"
  },
  {
    "id": "s0487",
    "blockIndex": 45,
    "zh": "楚、漢相距，臣進奇謀之士，顧其計誠足以利國家不耳。"
  },
  {
    "id": "s0488",
    "blockIndex": 45,
    "zh": "盜嫂、受金，又何足疑乎！"
  },
  {
    "id": "s0489",
    "blockIndex": 45,
    "zh": "」漢王召讓平曰：「先生事魏不中，事楚而去，今又從吾游，信者固多心乎！"
  },
  {
    "id": "s0490",
    "blockIndex": 45,
    "zh": "」平曰：「臣事魏王，魏王不能用臣說，故去；"
  },
  {
    "id": "s0491",
    "blockIndex": 45,
    "zh": "事項王，項王不能信人，其所任愛，非諸項，即妻之昆弟，雖有奇士不能用。"
  },
  {
    "id": "s0492",
    "blockIndex": 45,
    "zh": "聞漢王能用人，故歸大王。"
  },
  {
    "id": "s0493",
    "blockIndex": 45,
    "zh": "臣裸身來，不受金無以為資。"
  },
  {
    "id": "s0494",
    "blockIndex": 45,
    "zh": "誠臣計畫有可采乎，願大王用之；"
  },
  {
    "id": "s0495",
    "blockIndex": 45,
    "zh": "使無可用者，金具在，請封輸官，得其骸骨。"
  },
  {
    "id": "s0496",
    "blockIndex": 45,
    "zh": "」漢王乃謝，厚賜，拜為護軍中尉，盡護諸將。"
  },
  {
    "id": "s0497",
    "blockIndex": 45,
    "zh": "諸將乃不敢復言。"
  },
  {
    "id": "s0499",
    "blockIndex": 46,
    "zh": "19魏王豹謁歸視親疾；"
  },
  {
    "id": "s0500",
    "blockIndex": 46,
    "zh": "至則絕河津，反為楚。"
  },
  {
    "id": "s0502",
    "blockIndex": 47,
    "zh": "20六月，漢王還櫟陽。"
  },
  {
    "id": "s0504",
    "blockIndex": 48,
    "zh": "21壬午，立子盈為太子；"
  },
  {
    "id": "s0505",
    "blockIndex": 48,
    "zh": "赦罪人。"
  },
  {
    "id": "s0507",
    "blockIndex": 49,
    "zh": "22漢兵引水灌廢丘，廢丘降，章邯自殺。"
  },
  {
    "id": "s0508",
    "blockIndex": 49,
    "zh": "盡定雍地，以為中地、北地、隴西郡。"
  },
  {
    "id": "s0510",
    "blockIndex": 50,
    "zh": "23關中大饑，米斛萬錢，人相食。"
  },
  {
    "id": "s0511",
    "blockIndex": 50,
    "zh": "令民就食蜀、漢。"
  },
  {
    "id": "s0512",
    "blockIndex": 51,
    "zh": "初，秦之亡也，豪傑爭取金玉，宣曲任氏獨窖倉粟。"
  },
  {
    "id": "s0513",
    "blockIndex": 51,
    "zh": "及楚、漢相距滎陽，民不得耕種，而豪傑金玉盡歸任氏，任以此起，富者數世。"
  },
  {
    "id": "s0515",
    "blockIndex": 52,
    "zh": "24秋，八月，漢王如滎陽，命蕭何守關中，侍太子，為法令約束，立宗廟、社稷、宮室、縣邑；"
  },
  {
    "id": "s0516",
    "blockIndex": 52,
    "zh": "事有不及奏決者，輒以便宜施行，上來，以聞。"
  },
  {
    "id": "s0517",
    "blockIndex": 52,
    "zh": "計關中戶口，轉漕、調兵以給軍，未嘗乏絕。"
  },
  {
    "id": "s0519",
    "blockIndex": 53,
    "zh": "25漢王使酈食其往說魏王豹，且召之。"
  },
  {
    "id": "s0520",
    "blockIndex": 53,
    "zh": "豹不聽，曰：「漢王慢而侮人，罵詈諸侯、群臣如罵奴耳，吾不忍復見也。"
  },
  {
    "id": "s0521",
    "blockIndex": 53,
    "zh": "」於是漢王以韓信為左丞相，與灌嬰、曹參俱擊魏。"
  },
  {
    "id": "s0522",
    "blockIndex": 53,
    "zh": "漢王問食其：「魏大將誰也？"
  },
  {
    "id": "s0523",
    "blockIndex": 53,
    "zh": "」對曰：「柏直。"
  },
  {
    "id": "s0524",
    "blockIndex": 53,
    "zh": "」王曰：「是口尚乳臭，安能當韓信！"
  },
  {
    "id": "s0525",
    "blockIndex": 53,
    "zh": "騎將誰也？"
  },
  {
    "id": "s0526",
    "blockIndex": 53,
    "zh": "」曰：「馮敬。"
  },
  {
    "id": "s0527",
    "blockIndex": 53,
    "zh": "」曰：「是秦將馮無擇子也，雖賢，不能當灌嬰。"
  },
  {
    "id": "s0528",
    "blockIndex": 53,
    "zh": "」「步卒將誰也？"
  },
  {
    "id": "s0529",
    "blockIndex": 53,
    "zh": "」曰：「項佗。"
  },
  {
    "id": "s0530",
    "blockIndex": 53,
    "zh": "」曰：「不能當曹參。"
  },
  {
    "id": "s0531",
    "blockIndex": 53,
    "zh": "吾無患矣！"
  },
  {
    "id": "s0532",
    "blockIndex": 53,
    "zh": "」韓信亦問酈生：「魏得無用周叔為大將乎？"
  },
  {
    "id": "s0533",
    "blockIndex": 53,
    "zh": "」酈生曰：「柏直也。"
  },
  {
    "id": "s0534",
    "blockIndex": 53,
    "zh": "」信曰：「豎子耳。"
  },
  {
    "id": "s0535",
    "blockIndex": 53,
    "zh": "」遂進兵。"
  },
  {
    "id": "s0536",
    "blockIndex": 54,
    "zh": "魏王盛兵蒲板以塞臨晉。"
  },
  {
    "id": "s0537",
    "blockIndex": 54,
    "zh": "信乃益為疑兵，陳船欲渡臨晉，而伏兵從夏陽以木罌流軍，襲安邑。"
  },
  {
    "id": "s0538",
    "blockIndex": 54,
    "zh": "魏王豹驚，引兵迎信。"
  },
  {
    "id": "s0539",
    "blockIndex": 54,
    "zh": "九月，信擊虜豹，傳詣滎陽；"
  },
  {
    "id": "s0540",
    "blockIndex": 54,
    "zh": "悉定魏地，置河東、上黨、太原郡。"
  },
  {
    "id": "s0542",
    "blockIndex": 55,
    "zh": "26漢之敗於彭城而西也，陳餘亦覺張耳不死，即背漢。"
  },
  {
    "id": "s0543",
    "blockIndex": 55,
    "zh": "韓信既定魏，使人請兵三萬人，願以北舉燕、趙，東擊齊，南絕楚糧道。"
  },
  {
    "id": "s0544",
    "blockIndex": 55,
    "zh": "漢王許之，乃遣張耳與俱，引兵東，北擊趙、代。"
  },
  {
    "id": "s0545",
    "blockIndex": 55,
    "zh": "後九月，信破代兵，禽夏說於閼與。"
  },
  {
    "id": "s0546",
    "blockIndex": 55,
    "zh": "信之下魏破代，漢輒使人收其精兵詣滎陽以距楚。"
  }
]
