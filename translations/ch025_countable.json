[
  {
    "id": "s0001",
    "blockIndex": 0,
    "zh": "起閼逢攝提格，盡屠維協洽，凡六年。"
  },
  {
    "id": "s0002",
    "blockIndex": 1,
    "zh": "1春，三月，詔曰：「蓋聞有功不賞，有罪不誅，雖唐、虞不能化天下。"
  },
  {
    "id": "s0003",
    "blockIndex": 1,
    "zh": "今膠東相王成，勞來不怠，流民自佔八萬餘口，治有異等之效。"
  },
  {
    "id": "s0004",
    "blockIndex": 1,
    "zh": "其賜成爵關內侯，秩中二千石。"
  },
  {
    "id": "s0005",
    "blockIndex": 1,
    "zh": "」未及徵用，會病卒官。"
  },
  {
    "id": "s0006",
    "blockIndex": 1,
    "zh": "後詔使丞相、御史問郡、國上計長史、守丞以政令得失。"
  },
  {
    "id": "s0007",
    "blockIndex": 1,
    "zh": "或對言：「前膠東相成偽自增加以蒙顯賞，是後俗吏多為虛名」-{云}-。"
  },
  {
    "id": "s0008",
    "blockIndex": 1,
    "zh": "----2夏，四月，戊申，立子奭為皇太子，以丙吉為太傅，太中大夫疏廣為少傅。"
  },
  {
    "id": "s0009",
    "blockIndex": 1,
    "zh": "封太子外祖父許廣漢為平恩侯。"
  },
  {
    "id": "s0010",
    "blockIndex": 1,
    "zh": "又封霍光兄孫中郎將雲為冠陽侯。"
  },
  {
    "id": "s0011",
    "blockIndex": 2,
    "zh": "霍顯聞立太子，怒恚不食，歐血，曰：「此乃民間時子，安得立！"
  },
  {
    "id": "s0012",
    "blockIndex": 2,
    "zh": "即-{后}-有子，反為王邪！"
  },
  {
    "id": "s0013",
    "blockIndex": 2,
    "zh": "」復教皇后令毒太子。"
  },
  {
    "id": "s0014",
    "blockIndex": 2,
    "zh": "皇后數召太子賜食，保、阿輒先嘗之，-{后}-挾毒不得行。"
  },
  {
    "id": "s0015",
    "blockIndex": 2,
    "zh": "----3五月，甲申，丞相賢以老病乞骸骨；"
  },
  {
    "id": "s0016",
    "blockIndex": 2,
    "zh": "賜黃金百斤、安車、駟馬，罷就第。"
  },
  {
    "id": "s0017",
    "blockIndex": 2,
    "zh": "丞相致仕自賢始。"
  },
  {
    "id": "s0018",
    "blockIndex": 2,
    "zh": "----4六月，壬辰，以魏相為丞相。"
  },
  {
    "id": "s0019",
    "blockIndex": 2,
    "zh": "辛丑，丙吉為御史大夫，疏廣為太子太傅，廣兄子受為少傅。"
  },
  {
    "id": "s0020",
    "blockIndex": 3,
    "zh": "太子外祖父平恩侯許伯，以為太子少，白使其弟中郎將舜監護太子家。"
  },
  {
    "id": "s0021",
    "blockIndex": 3,
    "zh": "上以問廣，廣對曰：「太子，國儲副君，師友必於天下英俊，不宜獨親外家許氏。"
  },
  {
    "id": "s0022",
    "blockIndex": 3,
    "zh": "且太子自有太傅、少傅，官屬已備，今復使舜護太子家，示陋，非所以廣太子德於天下也。"
  },
  {
    "id": "s0023",
    "blockIndex": 3,
    "zh": "」上善其言，以語魏相，相免冠謝曰：「此非臣等所能及。"
  },
  {
    "id": "s0024",
    "blockIndex": 3,
    "zh": "」廣由是見器重。"
  },
  {
    "id": "s0025",
    "blockIndex": 3,
    "zh": "----5京師大雨雹，大行丞東海蕭望之上疏，言大臣任政，一姓專權之所致。"
  },
  {
    "id": "s0026",
    "blockIndex": 3,
    "zh": "上素聞望之名，拜為謁者。"
  },
  {
    "id": "s0027",
    "blockIndex": 3,
    "zh": "時上博延賢俊，民多上書言便宜，輒下望之問狀；"
  },
  {
    "id": "s0028",
    "blockIndex": 3,
    "zh": "高者請丞相、御史，次者中二千石試事，滿歲以狀聞；"
  },
  {
    "id": "s0029",
    "blockIndex": 3,
    "zh": "下者報聞，罷。"
  },
  {
    "id": "s0030",
    "blockIndex": 3,
    "zh": "所白處奏皆可。"
  },
  {
    "id": "s0031",
    "blockIndex": 3,
    "zh": "----6冬，十月，詔曰：「乃者九月壬申地震，朕甚懼焉。"
  },
  {
    "id": "s0032",
    "blockIndex": 3,
    "zh": "有能箴朕過失，及賢良方正直言極諫之士，以匡朕之不逮，毋諱有司。"
  },
  {
    "id": "s0033",
    "blockIndex": 3,
    "zh": "朕既不德，不能附遠，是以邊境屯戍未息。"
  },
  {
    "id": "s0034",
    "blockIndex": 3,
    "zh": "今復飭兵重屯，久勞百姓，非所以綏天下也。"
  },
  {
    "id": "s0035",
    "blockIndex": 3,
    "zh": "其罷車騎將軍、右將軍屯兵。"
  },
  {
    "id": "s0036",
    "blockIndex": 3,
    "zh": "」又詔：「池籞未御幸者，假與貧民。"
  },
  {
    "id": "s0037",
    "blockIndex": 3,
    "zh": "郡國宮館勿復修治。"
  },
  {
    "id": "s0038",
    "blockIndex": 3,
    "zh": "流民還歸者，假公田，貸種食，且勿算事。"
  },
  {
    "id": "s0039",
    "blockIndex": 3,
    "zh": "」----7霍氏驕侈縱橫。"
  },
  {
    "id": "s0040",
    "blockIndex": 3,
    "zh": "太夫人顯，廣治第室，作乘輿輦，加畫，繡絪馮，黃金塗；"
  },
  {
    "id": "s0041",
    "blockIndex": 3,
    "zh": "韋絮薦輪，侍婢以五采絲輓顯遊戲第中；"
  },
  {
    "id": "s0042",
    "blockIndex": 3,
    "zh": "與監奴馮子都亂。"
  },
  {
    "id": "s0043",
    "blockIndex": 3,
    "zh": "而禹、山亦並繕治第宅，走馬馳逐平樂館。"
  },
  {
    "id": "s0044",
    "blockIndex": 3,
    "zh": "雲當朝請，數稱病私出，多從賓客，張圍獵黃山苑中，使倉頭奴上朝謁，莫敢譴者。"
  },
  {
    "id": "s0045",
    "blockIndex": 3,
    "zh": "顯及諸女晝夜出入長信宮殿中，亡期度。"
  },
  {
    "id": "s0046",
    "blockIndex": 4,
    "zh": "帝自在民間，聞知霍氏尊盛日久，內不能善。"
  },
  {
    "id": "s0047",
    "blockIndex": 4,
    "zh": "既躬親朝政，御史大夫魏相給事中。"
  },
  {
    "id": "s0048",
    "blockIndex": 4,
    "zh": "顯謂禹、雲、山：「女曹不務奉大將軍餘業，今大夫給事中，他人壹間女，能復自救邪！"
  },
  {
    "id": "s0049",
    "blockIndex": 4,
    "zh": "」後兩家奴爭道，霍氏奴入御史府，欲躢大夫門；"
  },
  {
    "id": "s0050",
    "blockIndex": 4,
    "zh": "御史為叩頭謝，乃去。"
  },
  {
    "id": "s0051",
    "blockIndex": 4,
    "zh": "人以謂霍氏，顯等始知憂。"
  },
  {
    "id": "s0052",
    "blockIndex": 5,
    "zh": "會魏大夫為丞相，數燕見言事；"
  },
  {
    "id": "s0053",
    "blockIndex": 5,
    "zh": "平恩侯與侍中金安上等徑出入省中。"
  },
  {
    "id": "s0054",
    "blockIndex": 5,
    "zh": "時霍山領尚書，上令吏民得奏封事，不關尚書，群臣進見獨往來，於是霍氏甚惡之。"
  },
  {
    "id": "s0055",
    "blockIndex": 5,
    "zh": "上頗聞霍氏毒殺-{許后}-而未察，乃徙光女婿度遼將軍、未央衛尉、平陵侯范明友為光祿勳，出次婿諸吏、中郎將、羽林監任勝為安定太守。"
  },
  {
    "id": "s0056",
    "blockIndex": 5,
    "zh": "數月，復出光姊婿給事中、光祿大夫張朔為蜀郡太守，群孫婿中郎將王漢為武威太守。"
  },
  {
    "id": "s0057",
    "blockIndex": 5,
    "zh": "頃之，復徙光長女婿長樂衛尉鄧廣漢為少府。"
  },
  {
    "id": "s0058",
    "blockIndex": 5,
    "zh": "戊戌，更以張安世為衛將軍，兩宮衛尉、城門、北軍兵屬焉。"
  },
  {
    "id": "s0059",
    "blockIndex": 5,
    "zh": "以霍禹為大司馬，冠小冠，亡印綬；"
  },
  {
    "id": "s0060",
    "blockIndex": 5,
    "zh": "罷其屯兵官屬，特使禹官名與光俱大司馬者。"
  },
  {
    "id": "s0061",
    "blockIndex": 5,
    "zh": "又收范明友度遼將軍印綬，但為光祿勳；"
  },
  {
    "id": "s0062",
    "blockIndex": 5,
    "zh": "及光中女婿趙平為散騎、騎都尉、光祿大夫，將屯兵，又收平騎都尉印綬。"
  },
  {
    "id": "s0063",
    "blockIndex": 5,
    "zh": "諸領胡、越騎、羽林及兩宮衛將屯兵，悉易以所親信許、史子弟代之。"
  },
  {
    "id": "s0064",
    "blockIndex": 5,
    "zh": "----8初，孝武之世，徵發煩數，百姓貧耗，窮民犯法，奸軌不勝，於是使張湯、趙禹之屬，條定法令，作見知故縱、監臨部主之法，緩深、故之罪，急縱、出之誅。"
  },
  {
    "id": "s0065",
    "blockIndex": 5,
    "zh": "其後奸猾巧法轉相比況，禁罔浸密，律令煩苛，文書盈於-{几}-閣，典者不能遍睹。"
  },
  {
    "id": "s0066",
    "blockIndex": 5,
    "zh": "是以郡國承用者駁，或罪同而論異，奸吏因緣為市，所欲活則傅生議，所欲陷則予死比，議者咸冤傷之。"
  },
  {
    "id": "s0067",
    "blockIndex": 6,
    "zh": "廷尉史鉅鹿路溫舒上書曰：「臣聞齊有無知之禍而桓公以興，晉有驪姬之難而文公用伯。"
  },
  {
    "id": "s0068",
    "blockIndex": 6,
    "zh": "近世趙王不終，諸呂作亂，而孝文為太宗。"
  },
  {
    "id": "s0069",
    "blockIndex": 6,
    "zh": "繇是觀之，禍亂之作，將以開聖人也。"
  },
  {
    "id": "s0070",
    "blockIndex": 6,
    "zh": "夫繼變亂之後，必有異舊之恩，此賢聖所以昭天命也。"
  },
  {
    "id": "s0071",
    "blockIndex": 6,
    "zh": "往者昭帝即世無嗣，昌邑淫亂，乃皇天所以開至聖也。"
  },
  {
    "id": "s0072",
    "blockIndex": 6,
    "zh": "臣聞《春秋》正即位、大一統而慎始也。"
  },
  {
    "id": "s0073",
    "blockIndex": 6,
    "zh": "陛下初登至尊，與天合符，宜改前世之失，正始受命之統，滌煩文，除民疾，以應天意。"
  },
  {
    "id": "s0074",
    "blockIndex": 6,
    "zh": "臣聞秦有十失，其一尚存，治獄之吏是也。"
  },
  {
    "id": "s0075",
    "blockIndex": 6,
    "zh": "夫獄者，天下之大命也，死者不可復生，絕者不可復屬。"
  },
  {
    "id": "s0076",
    "blockIndex": 6,
    "zh": "《書》曰：『與其殺不辜，寧失不經。"
  },
  {
    "id": "s0077",
    "blockIndex": 6,
    "zh": "』今治獄吏則不然，上下相驅，以刻為明，深者獲公名，平者多後患，故治獄之吏皆欲人死，非憎人也，自安之道在人之死。"
  },
  {
    "id": "s0078",
    "blockIndex": 6,
    "zh": "是以死人之血流離於市，被刑之徒，比肩而立，大辟之計，歲以萬數。"
  },
  {
    "id": "s0079",
    "blockIndex": 6,
    "zh": "此仁聖之所以傷也，太平之未洽，凡以此也。"
  },
  {
    "id": "s0080",
    "blockIndex": 6,
    "zh": "夫人情，安則樂生，痛則思死，棰楚之下，何求而不得！"
  },
  {
    "id": "s0081",
    "blockIndex": 6,
    "zh": "故囚人不勝痛，則飾辭以示之；"
  },
  {
    "id": "s0082",
    "blockIndex": 6,
    "zh": "吏治者利其然，則指導以明之；"
  },
  {
    "id": "s0083",
    "blockIndex": 6,
    "zh": "上奏畏卻，則鍛練而周內之。"
  },
  {
    "id": "s0084",
    "blockIndex": 6,
    "zh": "蓋奏當之成，雖皋陶聽之，猶以為死有餘辜。"
  },
  {
    "id": "s0085",
    "blockIndex": 6,
    "zh": "何則？"
  },
  {
    "id": "s0086",
    "blockIndex": 6,
    "zh": "成練者眾，文致之罪明也。"
  },
  {
    "id": "s0087",
    "blockIndex": 6,
    "zh": "故俗語曰：『畫地為獄，議不入；"
  },
  {
    "id": "s0088",
    "blockIndex": 6,
    "zh": "刻木為吏，期不對。"
  },
  {
    "id": "s0089",
    "blockIndex": 6,
    "zh": "』此皆疾吏之風，悲痛之辭也。"
  },
  {
    "id": "s0090",
    "blockIndex": 6,
    "zh": "唯陛下省法制，寬刑罰，則太平之風可興於世。"
  },
  {
    "id": "s0091",
    "blockIndex": 6,
    "zh": "」上善其言。"
  },
  {
    "id": "s0092",
    "blockIndex": 6,
    "zh": "----9十二月，詔曰：「間者吏用法巧文浸深，是朕之不德也。"
  },
  {
    "id": "s0093",
    "blockIndex": 6,
    "zh": "夫決獄不當，使有罪興邪，不辜蒙戮，父子悲恨，朕甚傷之！"
  },
  {
    "id": "s0094",
    "blockIndex": 6,
    "zh": "今遣廷史與郡鞠獄，任輕祿薄，其為置廷尉平，秩六百石，員四人。"
  },
  {
    "id": "s0095",
    "blockIndex": 6,
    "zh": "其務平之，以稱朕意！"
  },
  {
    "id": "s0096",
    "blockIndex": 6,
    "zh": "」於是每季秋後請讞時，上常幸宣室，齋居而決事，獄刑號為平矣。"
  },
  {
    "id": "s0097",
    "blockIndex": 7,
    "zh": "涿郡太守鄭昌上疏言：「今明主躬垂明聽，雖不置廷平，獄將自正；"
  },
  {
    "id": "s0098",
    "blockIndex": 7,
    "zh": "若開後嗣，不若刪定律令。"
  },
  {
    "id": "s0099",
    "blockIndex": 7,
    "zh": "律令一定，愚民知所避，奸吏無所弄矣。"
  },
  {
    "id": "s0100",
    "blockIndex": 7,
    "zh": "今不正其本，而置廷平以理其末，政衰聽怠，則廷平將召權而為亂首矣。"
  },
  {
    "id": "s0101",
    "blockIndex": 7,
    "zh": "」----10昭帝時，匈奴使四千騎田車師。"
  },
  {
    "id": "s0102",
    "blockIndex": 7,
    "zh": "及五將軍擊匈奴，車師田者驚去，車師復通於漢；"
  },
  {
    "id": "s0103",
    "blockIndex": 7,
    "zh": "匈奴怒，召其太子軍宿，欲以為質。"
  },
  {
    "id": "s0104",
    "blockIndex": 7,
    "zh": "軍宿，焉耆外孫，不欲質匈奴，亡走焉耆，車師王更立子烏貴為太子。"
  },
  {
    "id": "s0105",
    "blockIndex": 7,
    "zh": "及烏貴立為王，與匈奴結婚姻，教匈奴遮漢道通烏孫者。"
  },
  {
    "id": "s0106",
    "blockIndex": 8,
    "zh": "是歲，侍郎會稽鄭吉與校尉司馬憙，將免刑罪人田渠犁，積穀，發城郭諸國兵萬餘人與所將田士千五百人共擊車師，破之；"
  },
  {
    "id": "s0107",
    "blockIndex": 8,
    "zh": "車師王請降。"
  },
  {
    "id": "s0108",
    "blockIndex": 8,
    "zh": "匈奴發兵攻車師；"
  },
  {
    "id": "s0109",
    "blockIndex": 8,
    "zh": "吉、憙引兵北逢之，匈奴不敢前。"
  },
  {
    "id": "s0110",
    "blockIndex": 8,
    "zh": "吉、憙即留一候與卒二十人留守王，吉等引兵歸渠犁。"
  },
  {
    "id": "s0111",
    "blockIndex": 8,
    "zh": "車師王恐匈奴兵復至而見殺也，乃輕騎奔烏孫。"
  },
  {
    "id": "s0112",
    "blockIndex": 8,
    "zh": "吉即迎其妻子，傳送長安。"
  },
  {
    "id": "s0113",
    "blockIndex": 8,
    "zh": "匈奴更以車師王昆弟兜莫為車師王，收其餘民東徙，不敢居故地；"
  },
  {
    "id": "s0114",
    "blockIndex": 8,
    "zh": "而鄭吉始使吏卒三百人往田車師地以實之。"
  },
  {
    "id": "s0115",
    "blockIndex": 8,
    "zh": "----11上自初即位，數遣使者求外家；"
  },
  {
    "id": "s0116",
    "blockIndex": 8,
    "zh": "久遠，多似類而非是。"
  },
  {
    "id": "s0117",
    "blockIndex": 8,
    "zh": "是歲，求得外祖母王媼及媼男無故、武。"
  },
  {
    "id": "s0118",
    "blockIndex": 8,
    "zh": "上賜無故、武爵關內侯。"
  },
  {
    "id": "s0119",
    "blockIndex": 8,
    "zh": "旬月間，賞賜以巨萬計。"
  },
  {
    "id": "s0121",
    "blockIndex": 9,
    "zh": "1春，二月，賜外祖母號為博平君；"
  },
  {
    "id": "s0122",
    "blockIndex": 9,
    "zh": "封舅無故為平昌侯，武為樂昌侯。"
  },
  {
    "id": "s0123",
    "blockIndex": 9,
    "zh": "----2夏，五月，山陽、濟陰雹如雞子，深二尺五寸，殺二十餘人，飛鳥皆死。"
  },
  {
    "id": "s0124",
    "blockIndex": 9,
    "zh": "----3詔：「自今子有匿父母、妻匿夫、孫匿大父母，皆勿治。"
  },
  {
    "id": "s0125",
    "blockIndex": 9,
    "zh": "」----4立廣川惠王孫文為廣川王。"
  },
  {
    "id": "s0126",
    "blockIndex": 9,
    "zh": "----5霍顯及禹、山、雲自見日侵削，數相對啼泣自怨。"
  },
  {
    "id": "s0127",
    "blockIndex": 9,
    "zh": "山曰：「今丞相用事，縣官信之，盡變易大將軍時法令，發揚大將軍過失。"
  },
  {
    "id": "s0128",
    "blockIndex": 9,
    "zh": "又，諸儒生多窶人子，遠客饑寒，喜妄說狂言，不避忌諱，大將軍常讎之。"
  },
  {
    "id": "s0129",
    "blockIndex": 9,
    "zh": "今陛下好與諸儒生語，人人自書對事，多言我家者。"
  },
  {
    "id": "s0130",
    "blockIndex": 9,
    "zh": "嘗有上書言我家昆弟驕恣，其言絕痛；"
  },
  {
    "id": "s0131",
    "blockIndex": 9,
    "zh": "山屏不奏。"
  },
  {
    "id": "s0132",
    "blockIndex": 9,
    "zh": "後上書者益黠，盡奏封事，輒使中書令出取之，不關尚書，益不信人。"
  },
  {
    "id": "s0133",
    "blockIndex": 9,
    "zh": "又聞民間讙言『霍氏毒殺許皇后』，寧有是邪？"
  },
  {
    "id": "s0134",
    "blockIndex": 9,
    "zh": "」顯恐急，即具以實告禹、山、雲。"
  },
  {
    "id": "s0135",
    "blockIndex": 9,
    "zh": "禹、山、雲驚曰：「如是，何不早告禹等！"
  },
  {
    "id": "s0136",
    "blockIndex": 9,
    "zh": "縣官離散、斥逐諸婿，用是故也。"
  },
  {
    "id": "s0137",
    "blockIndex": 9,
    "zh": "此大事，誅罰不小，奈何？"
  },
  {
    "id": "s0138",
    "blockIndex": 9,
    "zh": "」於是始有邪謀矣。"
  },
  {
    "id": "s0139",
    "blockIndex": 10,
    "zh": "雲舅李竟民善張赦，見雲家卒卒，謂竟曰：「今丞相與平恩侯用事，可令太夫人言太后，先誅此兩人。"
  },
  {
    "id": "s0140",
    "blockIndex": 10,
    "zh": "移徙陛下，在太后耳。"
  },
  {
    "id": "s0141",
    "blockIndex": 10,
    "zh": "」長安男子張章告之，事下廷尉、執金吾，捕張赦等。"
  },
  {
    "id": "s0142",
    "blockIndex": 10,
    "zh": "後有詔，止勿捕。"
  },
  {
    "id": "s0143",
    "blockIndex": 10,
    "zh": "山等愈恐，相謂曰：「此縣官重太后，故不竟也。"
  },
  {
    "id": "s0144",
    "blockIndex": 10,
    "zh": "然惡端已見，久之猶發，發即族矣，不如先也。"
  },
  {
    "id": "s0145",
    "blockIndex": 10,
    "zh": "」遂令諸女各歸報其夫，皆曰：「安所相避！"
  },
  {
    "id": "s0147",
    "blockIndex": 11,
    "zh": "會李竟坐與諸侯王交通，辭語及霍氏，有詔：「雲、山不宜宿衛，免就第。"
  },
  {
    "id": "s0148",
    "blockIndex": 11,
    "zh": "」山陽太守張敞上封事曰：「臣聞公子季友有功於魯，趙衰有功於晉，田完有功於齊，皆疇其庸，延及子孫。"
  },
  {
    "id": "s0149",
    "blockIndex": 11,
    "zh": "終後田氏篡齊，趙氏分晉，季氏顓魯。"
  },
  {
    "id": "s0150",
    "blockIndex": 11,
    "zh": "故仲尼作《春秋》，跡盛衰，譏世卿最甚。"
  },
  {
    "id": "s0151",
    "blockIndex": 11,
    "zh": "乃者大將軍決大計，安宗廟，定天下，功亦不細矣。"
  },
  {
    "id": "s0152",
    "blockIndex": 11,
    "zh": "夫周公七年耳，而大將軍二十歲，海內之命斷於掌握。"
  },
  {
    "id": "s0153",
    "blockIndex": 11,
    "zh": "方其隆盛時，感動天地，侵迫陰陽。"
  },
  {
    "id": "s0154",
    "blockIndex": 11,
    "zh": "朝臣宜有明言曰：『陛下褒寵故大將軍以報功德足矣。"
  },
  {
    "id": "s0155",
    "blockIndex": 11,
    "zh": "間者輔臣顓政，貴戚太盛，君臣之分不明，請罷霍氏三侯皆就第；"
  },
  {
    "id": "s0156",
    "blockIndex": 11,
    "zh": "及衛將軍張安世，宜賜-{几}-杖歸休，時存問召見，以列侯為天子師。"
  },
  {
    "id": "s0157",
    "blockIndex": 11,
    "zh": "』明詔以恩不聽，群臣以義固爭而後許之，天下必以陛下為不忘功德而朝臣為知禮，霍氏世世無所患苦。"
  },
  {
    "id": "s0158",
    "blockIndex": 11,
    "zh": "今朝廷不聞直聲，而令明詔自親其文，非策之得者也。"
  },
  {
    "id": "s0159",
    "blockIndex": 11,
    "zh": "今兩侯已出，人情不相遠，以臣心度之，大司馬及其枝屬必有畏懼之心。"
  },
  {
    "id": "s0160",
    "blockIndex": 11,
    "zh": "夫近臣自危，非完計也。"
  },
  {
    "id": "s0161",
    "blockIndex": 11,
    "zh": "臣敞願於廣朝白發其端，直守遠郡，其路無由。"
  },
  {
    "id": "s0162",
    "blockIndex": 11,
    "zh": "唯陛下省察。"
  },
  {
    "id": "s0163",
    "blockIndex": 11,
    "zh": "」上甚善其計，然不召也。"
  },
  {
    "id": "s0164",
    "blockIndex": 12,
    "zh": "禹、山等家數有妖怪，舉家憂愁。"
  },
  {
    "id": "s0165",
    "blockIndex": 12,
    "zh": "山曰：「丞相擅減宗廟羔、菟、蛙，可以此罪也。"
  },
  {
    "id": "s0166",
    "blockIndex": 12,
    "zh": "」謀令太后為博平君置酒，召丞相、平恩侯以下，使范明友、鄧廣漢承太后制引斬之，因廢天子而立禹。"
  },
  {
    "id": "s0167",
    "blockIndex": 12,
    "zh": "約定，未發，雲拜為玄菟太守，太中大夫任宣為代郡太守。"
  },
  {
    "id": "s0168",
    "blockIndex": 12,
    "zh": "會事發覺，秋，七月，雲、山、明友自殺，顯、禹、廣漢等捕得；"
  },
  {
    "id": "s0169",
    "blockIndex": 12,
    "zh": "禹要斬，顯及諸女昆弟皆棄市；"
  },
  {
    "id": "s0170",
    "blockIndex": 12,
    "zh": "與霍氏相連坐誅滅者數十家。"
  },
  {
    "id": "s0171",
    "blockIndex": 12,
    "zh": "太僕杜延年以霍氏舊人，亦坐免官。"
  },
  {
    "id": "s0172",
    "blockIndex": 12,
    "zh": "八月，己酉，皇后霍氏廢，處昭台宮，乙丑，詔封告霍氏反謀者男子張章、期門董忠、左曹楊惲、侍中金安上、史高皆為列侯。"
  },
  {
    "id": "s0173",
    "blockIndex": 12,
    "zh": "惲，丞相敞子；"
  },
  {
    "id": "s0174",
    "blockIndex": 12,
    "zh": "安上，車騎將軍日磾弟子；"
  },
  {
    "id": "s0175",
    "blockIndex": 12,
    "zh": "高，史良娣兄子也。"
  },
  {
    "id": "s0176",
    "blockIndex": 13,
    "zh": "初，霍氏奢侈，茂陵徐生曰：「霍氏必亡。"
  },
  {
    "id": "s0177",
    "blockIndex": 13,
    "zh": "夫奢則不遜，不遜則侮上。"
  },
  {
    "id": "s0178",
    "blockIndex": 13,
    "zh": "侮上者，逆道也，在人之右，眾必害之。"
  },
  {
    "id": "s0179",
    "blockIndex": 13,
    "zh": "霍氏秉權日久，害之者多矣。"
  },
  {
    "id": "s0180",
    "blockIndex": 13,
    "zh": "天下害之，而又行以逆道，不亡何待！"
  },
  {
    "id": "s0181",
    "blockIndex": 13,
    "zh": "」乃上疏言：「霍氏泰盛，陛下即愛厚之，宜以時抑制，無使至亡。"
  },
  {
    "id": "s0182",
    "blockIndex": 13,
    "zh": "」書三上，輒報聞。"
  },
  {
    "id": "s0183",
    "blockIndex": 13,
    "zh": "其後霍氏誅滅，而告霍氏者皆封，人為徐生上書曰：「臣聞客有過主人者，見其灶直突，傍有積薪，客謂主人：『更為曲突，遠徙其薪，不者且有火患。"
  },
  {
    "id": "s0184",
    "blockIndex": 13,
    "zh": "』主人嘿然不應。"
  },
  {
    "id": "s0185",
    "blockIndex": 13,
    "zh": "俄而家果失火，鄰里共救之，幸而得息。"
  },
  {
    "id": "s0186",
    "blockIndex": 13,
    "zh": "於是殺牛置酒，謝其鄰人，灼爛者在於上行，餘各以功次坐，而不錄言曲突者。"
  },
  {
    "id": "s0187",
    "blockIndex": 13,
    "zh": "人謂主人曰：『鄉使聽客之言，不費牛酒，終亡火患。"
  },
  {
    "id": "s0188",
    "blockIndex": 13,
    "zh": "今論功而請賓，曲突徙薪無恩澤，焦頭爛額為上客邪？"
  },
  {
    "id": "s0189",
    "blockIndex": 13,
    "zh": "』主人乃寤而請之。"
  },
  {
    "id": "s0190",
    "blockIndex": 13,
    "zh": "今茂陵徐福，數上書言霍氏且有變，宜防絕之。"
  },
  {
    "id": "s0191",
    "blockIndex": 13,
    "zh": "鄉使福說得行，則國無裂土出爵之費，臣無逆亂誅滅之敗。"
  },
  {
    "id": "s0192",
    "blockIndex": 13,
    "zh": "往事既已，而福獨不蒙其功，唯陛下察之，貴徙薪曲突之策，使居焦髮灼爛之右。"
  },
  {
    "id": "s0193",
    "blockIndex": 13,
    "zh": "」上乃賜福帛十匹，後以為郎。"
  },
  {
    "id": "s0194",
    "blockIndex": 14,
    "zh": "帝初立，謁見高廟，大將軍光驂乘，上內嚴憚之，若有芒刺在背。"
  },
  {
    "id": "s0195",
    "blockIndex": 14,
    "zh": "後車騎將軍張安世代光驂乘，天子從容肆體，甚安近焉。"
  },
  {
    "id": "s0196",
    "blockIndex": 14,
    "zh": "及光身死而宗族竟誅，故俗傳霍氏之禍萌於驂乘。"
  },
  {
    "id": "s0197",
    "blockIndex": 14,
    "zh": "後十二歲，霍-{后}-復徙雲林館，乃自殺。"
  },
  {
    "id": "s0198",
    "blockIndex": 15,
    "zh": ":班固贊曰：霍光受襁褓之托，任漢室之寄，匡國家，安社稷，擁昭，立宣，雖周公、阿衡何以加此！"
  },
  {
    "id": "s0199",
    "blockIndex": 15,
    "zh": "然光不學亡術，闇於大理；"
  },
  {
    "id": "s0200",
    "blockIndex": 15,
    "zh": "陰妻邪謀，立女為-{后}-，湛溺盈溢之欲，以增顛覆之禍，死財三年，宗族誅夷，哀哉！"
  },
  {
    "id": "s0201",
    "blockIndex": 16,
    "zh": ":臣光曰：霍光之輔漢室，可謂忠矣；"
  },
  {
    "id": "s0202",
    "blockIndex": 16,
    "zh": "然卒不能庇其宗，何也？"
  },
  {
    "id": "s0203",
    "blockIndex": 16,
    "zh": "夫威福者，人君之器也。"
  },
  {
    "id": "s0204",
    "blockIndex": 16,
    "zh": "人臣執之，久而不歸，鮮不及矣。"
  },
  {
    "id": "s0205",
    "blockIndex": 16,
    "zh": "以孝昭之明，十四而知上官桀之詐，固可以親政矣，況孝宣十九即位，聰明剛毅，知民疾苦，而光久專大柄，不知避去，多置私黨，充塞朝廷，使人主蓄憤於上，吏民積怨於下，切齒側目，待時而發，其得免於身幸矣，況子孫以驕侈趣之哉！"
  },
  {
    "id": "s0206",
    "blockIndex": 16,
    "zh": "雖然，向使孝宣專以祿秩賞賜富其子孫，使之食大縣，奉朝請，亦足以報盛德矣；"
  },
  {
    "id": "s0207",
    "blockIndex": 16,
    "zh": "乃復任之以政，授之以兵，及事叢衅積，更加裁奪，遂至怨懼以生邪謀，豈徒霍氏之自禍哉？"
  },
  {
    "id": "s0208",
    "blockIndex": 16,
    "zh": "亦孝宣醞釀以成之也。"
  },
  {
    "id": "s0209",
    "blockIndex": 16,
    "zh": "昔鬬椒作亂於楚，莊王滅其族而赦箴尹克黃，以為子文無後，何以勸善。"
  },
  {
    "id": "s0210",
    "blockIndex": 16,
    "zh": "夫以顯、禹、雲、山之罪，雖應夷滅，而光之忠勳不可不祀；"
  },
  {
    "id": "s0211",
    "blockIndex": 16,
    "zh": "遂使家無噍類，孝宣亦少恩哉！"
  },
  {
    "id": "s0212",
    "blockIndex": 16,
    "zh": "----6九月，詔減天下鹽賈。"
  },
  {
    "id": "s0213",
    "blockIndex": 16,
    "zh": "又令郡國歲上系囚以掠笞若瘐死者，所坐縣、名、爵、-{里}-，丞相、御史課殿最以聞。"
  },
  {
    "id": "s0214",
    "blockIndex": 16,
    "zh": "----7十二月，清河王年坐內亂廢，遷房陵。"
  },
  {
    "id": "s0215",
    "blockIndex": 16,
    "zh": "----8是歲，北海太守廬江朱邑以治行第一入為大司農，勃海太守龔遂入為水衡都尉。"
  },
  {
    "id": "s0216",
    "blockIndex": 16,
    "zh": "先是，勃海左右郡歲饑，盜賊並起，二千石不能禽制。"
  },
  {
    "id": "s0217",
    "blockIndex": 16,
    "zh": "上選能治者，丞相、御史舉故昌邑郎中令龔遂，上拜為勃海太守。"
  },
  {
    "id": "s0218",
    "blockIndex": 16,
    "zh": "召見，問：「何以治勃海，息其盜賊？"
  },
  {
    "id": "s0219",
    "blockIndex": 16,
    "zh": "」對曰：「海瀕遐遠，不沾聖化，其民困於饑寒而吏不恤，故使陛下赤子盜弄陛下之兵於潢池中耳。"
  },
  {
    "id": "s0220",
    "blockIndex": 16,
    "zh": "今欲使臣勝之邪，將安之也？"
  },
  {
    "id": "s0221",
    "blockIndex": 16,
    "zh": "」上曰：「選用賢良，固欲安之也。"
  },
  {
    "id": "s0222",
    "blockIndex": 16,
    "zh": "」遂曰：「臣聞治亂民猶治亂繩，不可急也；"
  },
  {
    "id": "s0223",
    "blockIndex": 16,
    "zh": "唯緩之，然後可治。"
  },
  {
    "id": "s0224",
    "blockIndex": 16,
    "zh": "臣願丞相、御史且無拘臣以文法，得一切便宜從事。"
  },
  {
    "id": "s0225",
    "blockIndex": 16,
    "zh": "」上許焉，加賜黃金贈遣。"
  },
  {
    "id": "s0226",
    "blockIndex": 16,
    "zh": "乘傳至勃海界，郡聞新太守至，發兵以迎。"
  },
  {
    "id": "s0227",
    "blockIndex": 16,
    "zh": "遂皆遣還。"
  },
  {
    "id": "s0228",
    "blockIndex": 16,
    "zh": "移書敕屬縣：「悉罷逐捕盜賊吏，諸持鍺、鉤、田器者皆為良民，吏毋得問；"
  },
  {
    "id": "s0229",
    "blockIndex": 16,
    "zh": "持兵者乃為賊。"
  },
  {
    "id": "s0230",
    "blockIndex": 16,
    "zh": "」遂單車獨行至府。"
  },
  {
    "id": "s0231",
    "blockIndex": 16,
    "zh": "盜賊聞遂教令，即時解散，棄其兵弩而持鉤、鋤，於是悉平，民安土樂業。"
  },
  {
    "id": "s0232",
    "blockIndex": 16,
    "zh": "遂乃開倉廩假貧民，選用良吏尉安牧養焉。"
  },
  {
    "id": "s0233",
    "blockIndex": 16,
    "zh": "遂見齊俗奢侈，好末技，不田作，乃躬率以儉約，勸民務農桑，各以口率種樹畜養。"
  },
  {
    "id": "s0234",
    "blockIndex": 16,
    "zh": "民有帶持刀劍者，使賣劍買牛，賣刀買犢，曰：「何為帶牛佩犢！"
  },
  {
    "id": "s0235",
    "blockIndex": 16,
    "zh": "」勞來循行，郡中皆有畜積，獄訟止息。"
  },
  {
    "id": "s0236",
    "blockIndex": 16,
    "zh": "----9烏孫公主女為龜茲王絳賓夫人。"
  },
  {
    "id": "s0237",
    "blockIndex": 16,
    "zh": "絳賓上書言：「得尚漢外孫，願與公主女俱入朝。"
  },
  {
    "id": "s0239",
    "blockIndex": 17,
    "zh": "1春，正月，龜茲王及其夫人來朝；"
  },
  {
    "id": "s0240",
    "blockIndex": 17,
    "zh": "皆賜印綬，夫人號稱公主，賞賜甚厚。"
  },
  {
    "id": "s0241",
    "blockIndex": 17,
    "zh": "----2初作杜陵。"
  },
  {
    "id": "s0242",
    "blockIndex": 17,
    "zh": "徙丞相、將軍、列侯、吏二千石、訾百萬者杜陵。"
  },
  {
    "id": "s0243",
    "blockIndex": 17,
    "zh": "----3三月，詔以鳳皇集泰山、陳留，甘露降未央宮，赦天下。"
  },
  {
    "id": "s0244",
    "blockIndex": 17,
    "zh": "----4有司復言悼園宜稱尊號曰皇考；"
  },
  {
    "id": "s0245",
    "blockIndex": 17,
    "zh": "夏，五月，立皇考廟。"
  },
  {
    "id": "s0246",
    "blockIndex": 17,
    "zh": "----5冬，置建章衛尉。"
  },
  {
    "id": "s0247",
    "blockIndex": 17,
    "zh": "----6趙廣漢好用世吏子孫新進年少者，專厲強壯蠭氣，見事風生，無所迴避，率多果敢之計，莫為持難，終以此敗。"
  },
  {
    "id": "s0248",
    "blockIndex": 17,
    "zh": "廣漢以私怨論殺男子榮畜，人上書言之，事下丞相、御史按驗。"
  },
  {
    "id": "s0249",
    "blockIndex": 17,
    "zh": "廣漢疑丞相夫人殺侍婢，欲以此脅丞相，丞相按之愈急。"
  },
  {
    "id": "s0250",
    "blockIndex": 17,
    "zh": "廣漢乃將吏卒入丞相府，召其夫人跪庭下受辭，收奴婢十餘人去。"
  },
  {
    "id": "s0251",
    "blockIndex": 17,
    "zh": "丞相上書自陳，事下廷尉治，實丞相自以過譴笞傅婢，出至外第乃死，不如廣漢言。"
  },
  {
    "id": "s0252",
    "blockIndex": 17,
    "zh": "帝惡之，下廣漢廷尉獄。"
  },
  {
    "id": "s0253",
    "blockIndex": 17,
    "zh": "吏民守闕號泣者數萬人，或言：「臣生無益縣官，願代趙京兆死，使牧養小民！"
  },
  {
    "id": "s0254",
    "blockIndex": 17,
    "zh": "」廣漢竟坐要斬。"
  },
  {
    "id": "s0255",
    "blockIndex": 17,
    "zh": "廣漢為京兆尹，廉明，威制豪強，小民得職，百姓追思歌之。"
  },
  {
    "id": "s0256",
    "blockIndex": 17,
    "zh": "----7是歲，少府宋疇坐議「鳳皇下彭城，未至京師，不足美」，貶為泗水太傅。"
  },
  {
    "id": "s0257",
    "blockIndex": 17,
    "zh": "----8上遷博士、諫大夫通政事者補郡國守相，以蕭望之為平原太守。"
  },
  {
    "id": "s0258",
    "blockIndex": 17,
    "zh": "望之上疏曰：「陛下哀愍百姓，恐德之不究，悉出諫官以補郡吏。"
  },
  {
    "id": "s0259",
    "blockIndex": 17,
    "zh": "朝無爭臣，則不知過，所謂憂其末而忘其本者也。"
  },
  {
    "id": "s0260",
    "blockIndex": 17,
    "zh": "」上乃徵望之入守少府。"
  },
  {
    "id": "s0261",
    "blockIndex": 17,
    "zh": "----9東海太守河東尹翁歸，以治郡高第入為右扶風。"
  },
  {
    "id": "s0262",
    "blockIndex": 17,
    "zh": "翁歸為人，公廉明察，郡中吏民賢、不肖及奸邪罪名盡知之。"
  },
  {
    "id": "s0263",
    "blockIndex": 17,
    "zh": "縣縣各有記籍，自聽其政；"
  },
  {
    "id": "s0264",
    "blockIndex": 17,
    "zh": "有急名則少緩之。"
  },
  {
    "id": "s0265",
    "blockIndex": 17,
    "zh": "吏民小解，輒披籍。"
  },
  {
    "id": "s0266",
    "blockIndex": 17,
    "zh": "取人必於秋冬課吏大會中及出行縣，不以無事時。"
  },
  {
    "id": "s0267",
    "blockIndex": 17,
    "zh": "其有所取也，以一警百。"
  },
  {
    "id": "s0268",
    "blockIndex": 17,
    "zh": "吏民皆服，恐懼，改行自新。"
  },
  {
    "id": "s0269",
    "blockIndex": 17,
    "zh": "其為扶風，選用廉平疾奸吏以為右職，接待以禮，好惡與同之；"
  },
  {
    "id": "s0270",
    "blockIndex": 17,
    "zh": "其負翁歸，罰亦必行。"
  },
  {
    "id": "s0271",
    "blockIndex": 17,
    "zh": "然溫良謙退，不以行能驕人，故尤得名譽於朝廷。"
  },
  {
    "id": "s0272",
    "blockIndex": 17,
    "zh": "----10初，烏孫公主少子萬年有寵於莎車王。"
  },
  {
    "id": "s0273",
    "blockIndex": 17,
    "zh": "莎車王死而無子，時萬年在漢，莎車國人計，欲自托於漢，又欲得烏孫心，上書請萬年為莎車王。"
  },
  {
    "id": "s0274",
    "blockIndex": 17,
    "zh": "漢許之，遣使者奚充國送萬年。"
  },
  {
    "id": "s0275",
    "blockIndex": 17,
    "zh": "萬年初立，暴惡，國人不說。"
  },
  {
    "id": "s0276",
    "blockIndex": 18,
    "zh": "上令群臣舉可使西域者，前將軍韓增舉上黨馮奉世以衛候使持節送大苑諸國客至伊循城。"
  },
  {
    "id": "s0277",
    "blockIndex": 18,
    "zh": "會故莎車王弟呼屠徵與旁國共殺其王萬年及漢使者奚充國，自立為王。"
  },
  {
    "id": "s0278",
    "blockIndex": 18,
    "zh": "時匈奴又發兵攻車師城，不能下而去。"
  },
  {
    "id": "s0279",
    "blockIndex": 18,
    "zh": "莎車遣使揚言「北道諸國已屬匈奴矣」，於是攻劫南道，與歃盟畔漢，從鄯善以西皆絕不通。"
  },
  {
    "id": "s0280",
    "blockIndex": 18,
    "zh": "都護鄭吉、校尉司馬憙皆在北道諸國間，奉世與其副嚴昌計，以為不亟擊之，則莎車日強，其勢難制，必危西域，遂以節諭告諸國王，因發其兵，南北道合萬五千人，進擊莎車，攻拔其城。"
  },
  {
    "id": "s0281",
    "blockIndex": 18,
    "zh": "莎車王自殺，傳其首詣長安，更立它昆弟子為莎車王。"
  },
  {
    "id": "s0282",
    "blockIndex": 18,
    "zh": "諸國悉平，威振西域，奉世乃罷兵以聞。"
  },
  {
    "id": "s0283",
    "blockIndex": 18,
    "zh": "帝召見韓增曰：「賀將軍所舉得其人。"
  },
  {
    "id": "s0285",
    "blockIndex": 19,
    "zh": "奉世遂西至大宛。"
  },
  {
    "id": "s0286",
    "blockIndex": 19,
    "zh": "大宛聞其斬莎車王，敬之異於它使，得其名馬象龍而還。"
  },
  {
    "id": "s0287",
    "blockIndex": 19,
    "zh": "上甚說，議封奉世。"
  },
  {
    "id": "s0288",
    "blockIndex": 19,
    "zh": "丞相、將軍皆以為可，獨少府蕭望之以為：「奉世奉使有指，而擅制違命，發諸國兵，雖有功效，不可以為後法。"
  },
  {
    "id": "s0289",
    "blockIndex": 19,
    "zh": "即封奉世，開後奉使者利以奉世為比，爭逐發兵，要功萬里之外，為國家生事於夷狄，漸不可長。"
  },
  {
    "id": "s0290",
    "blockIndex": 19,
    "zh": "奉世不宜受封。"
  },
  {
    "id": "s0291",
    "blockIndex": 19,
    "zh": "」上善望之議，以奉世為光祿大夫。"
  },
  {
    "id": "s0293",
    "blockIndex": 20,
    "zh": "1春，正月，赦天下。"
  },
  {
    "id": "s0294",
    "blockIndex": 20,
    "zh": "----2上欲立皇后，時館陶主母華倢伃及淮陽憲王母張倢伃、楚孝王母衛倢伃皆愛幸。"
  },
  {
    "id": "s0295",
    "blockIndex": 20,
    "zh": "上欲立張倢伃為-{后}-；"
  },
  {
    "id": "s0296",
    "blockIndex": 20,
    "zh": "久之，懲艾霍氏欲害皇太子，乃更選後宮無子而謹慎者。"
  },
  {
    "id": "s0297",
    "blockIndex": 20,
    "zh": "二月，乙丑，立長陵王倢伃為皇后，令母養太子；"
  },
  {
    "id": "s0298",
    "blockIndex": 20,
    "zh": "封其父奉光為邛成侯。"
  },
  {
    "id": "s0299",
    "blockIndex": 20,
    "zh": "-{后}-無寵，希得進見。"
  },
  {
    "id": "s0300",
    "blockIndex": 20,
    "zh": "----3五月，詔曰：「獄者，萬民之命。"
  },
  {
    "id": "s0301",
    "blockIndex": 20,
    "zh": "能使生者不怨，死者不恨，則可謂文吏矣。"
  },
  {
    "id": "s0302",
    "blockIndex": 20,
    "zh": "今則不然。"
  },
  {
    "id": "s0303",
    "blockIndex": 20,
    "zh": "用法或持巧心，析律貳端，深淺不平，奏不如實，上亦亡由知，四方黎民將何仰哉！"
  },
  {
    "id": "s0304",
    "blockIndex": 20,
    "zh": "二千石各察官屬，勿用此人。"
  },
  {
    "id": "s0305",
    "blockIndex": 20,
    "zh": "吏或擅興徭役，飾廚傳，稱過使客，越職逾法以取名譽，譬如踐薄冰以待白日，豈不殆哉！"
  },
  {
    "id": "s0306",
    "blockIndex": 20,
    "zh": "今天下頗被疾疫之災，朕甚愍之，其令郡國被災甚者，毋出今年租賦。"
  },
  {
    "id": "s0307",
    "blockIndex": 20,
    "zh": "」----4又曰：「聞古天子之名，難知而易諱也；"
  },
  {
    "id": "s0308",
    "blockIndex": 20,
    "zh": "其更諱詢。"
  },
  {
    "id": "s0309",
    "blockIndex": 20,
    "zh": "」----5匈奴大臣皆以為「車師地肥美，近匈奴，使漢得之，多田積穀，必害人國，不可不爭」，由是數遣兵擊車師田者。"
  },
  {
    "id": "s0310",
    "blockIndex": 20,
    "zh": "鄭吉將渠犁田卒七千餘人救之，為匈奴所圍。"
  },
  {
    "id": "s0311",
    "blockIndex": 20,
    "zh": "吉上言：「車師去渠犁千餘里，漢兵在渠犁者少，勢不能相救，願益田卒。"
  },
  {
    "id": "s0312",
    "blockIndex": 20,
    "zh": "」上與後將軍趙充國等議，欲因匈奴衰弱，出兵擊其右地，使不得復擾西域。"
  },
  {
    "id": "s0313",
    "blockIndex": 21,
    "zh": "魏相上書諫曰：「臣聞之：救亂誅暴，謂之義兵，兵義者王；"
  },
  {
    "id": "s0314",
    "blockIndex": 21,
    "zh": "敵加於己，不得已而起者，謂之應兵，兵應者勝；"
  },
  {
    "id": "s0315",
    "blockIndex": 21,
    "zh": "爭恨小故，不忍憤怒者，謂之忿兵，兵忿者敗；"
  },
  {
    "id": "s0316",
    "blockIndex": 21,
    "zh": "利人土地、貨寶者，謂之貪兵，兵貪者破；"
  },
  {
    "id": "s0317",
    "blockIndex": 21,
    "zh": "恃國家之大，矜民人之眾，欲見威於敵者，謂之驕兵，兵驕者滅。"
  },
  {
    "id": "s0318",
    "blockIndex": 21,
    "zh": "此五者，非但人事，乃天道也。"
  },
  {
    "id": "s0319",
    "blockIndex": 21,
    "zh": "間者匈奴嘗有善意，所得漢民，輒奉歸之，未有犯於邊境；"
  },
  {
    "id": "s0320",
    "blockIndex": 21,
    "zh": "雖爭屯田車師，不足致意中。"
  },
  {
    "id": "s0321",
    "blockIndex": 21,
    "zh": "今聞諸將軍欲興兵入其地，臣愚不知此兵何名者也！"
  },
  {
    "id": "s0322",
    "blockIndex": 21,
    "zh": "今邊郡困乏，父子共犬羊之裘，食草萊之實，常恐不能自存，難以動兵。"
  },
  {
    "id": "s0323",
    "blockIndex": 21,
    "zh": "『軍旅之後，必有凶年，』言民以其愁苦之氣傷陰陽之和也。"
  },
  {
    "id": "s0324",
    "blockIndex": 21,
    "zh": "出兵雖勝，猶有後憂，恐災害之變因此以生。"
  },
  {
    "id": "s0325",
    "blockIndex": 21,
    "zh": "今郡國守相多不實選，風俗尤薄，水旱不時。"
  },
  {
    "id": "s0326",
    "blockIndex": 21,
    "zh": "按今年計子弟殺父兄、妻殺夫者凡二百二十二人，臣愚以為此非小變也。"
  },
  {
    "id": "s0327",
    "blockIndex": 21,
    "zh": "今左右不憂此，乃欲發兵報纖介之忿於遠夷，殆孔子所謂『吾恐季孫之憂不在顓臾而在蕭牆之內也』。"
  },
  {
    "id": "s0328",
    "blockIndex": 21,
    "zh": "」上從相言，止。"
  },
  {
    "id": "s0329",
    "blockIndex": 21,
    "zh": "遣長羅侯常惠將張掖、酒泉騎往車師，迎鄭吉及其吏士還渠犁。"
  },
  {
    "id": "s0330",
    "blockIndex": 21,
    "zh": "召故車師太子軍宿在焉耆者，立以為王；"
  },
  {
    "id": "s0331",
    "blockIndex": 21,
    "zh": "盡徙車師國民令居渠犁，遂以車師故地與匈奴。"
  },
  {
    "id": "s0332",
    "blockIndex": 21,
    "zh": "以鄭吉為衛司馬，使護善阜善以西南道。"
  },
  {
    "id": "s0333",
    "blockIndex": 21,
    "zh": "----6魏相好觀漢故事及便宜章奏，數條漢興已來國家便宜行事及賢臣賈誼、晁錯、董仲舒等所言，奏請施行之。"
  },
  {
    "id": "s0334",
    "blockIndex": 21,
    "zh": "相敕掾史按事郡國，及休告，從家還至府，輒白四方異聞。"
  },
  {
    "id": "s0335",
    "blockIndex": 21,
    "zh": "或有逆賊、風雨災變，郡不上，相輒奏言之。"
  },
  {
    "id": "s0336",
    "blockIndex": 21,
    "zh": "與御史大夫丙吉同心輔政，上皆重之。"
  },
  {
    "id": "s0337",
    "blockIndex": 22,
    "zh": "丙吉為人深厚，不伐善。"
  },
  {
    "id": "s0338",
    "blockIndex": 22,
    "zh": "自曾孫遭遇，吉絕口不道前恩，故朝廷莫能明其功也。"
  },
  {
    "id": "s0339",
    "blockIndex": 22,
    "zh": "會掖庭宮婢則令民夫上書，自陳嘗有阿保之功，章下掖庭令考問，則辭引使者丙吉知狀。"
  },
  {
    "id": "s0340",
    "blockIndex": 22,
    "zh": "掖庭令將則詣御史府以視吉，吉識，謂則曰：「汝嘗坐養皇曾孫不謹，督笞汝，汝安得有功！"
  },
  {
    "id": "s0341",
    "blockIndex": 22,
    "zh": "獨渭城胡組、淮陽郭徵卿有恩耳。"
  },
  {
    "id": "s0342",
    "blockIndex": 22,
    "zh": "」分別奏組等共養勞苦狀。"
  },
  {
    "id": "s0343",
    "blockIndex": 22,
    "zh": "詔吉求組、徵卿；"
  },
  {
    "id": "s0344",
    "blockIndex": 22,
    "zh": "已死，有子孫，皆受厚賞。"
  },
  {
    "id": "s0345",
    "blockIndex": 22,
    "zh": "詔免則為庶人，賜錢十萬。"
  },
  {
    "id": "s0346",
    "blockIndex": 22,
    "zh": "上親見問，然後知吉有舊恩而終不言，上大賢之。"
  },
  {
    "id": "s0347",
    "blockIndex": 22,
    "zh": "----7帝以蕭望之經明持重，議論有餘，材任宰相，欲詳試其政事，復以為左馮翊。"
  },
  {
    "id": "s0348",
    "blockIndex": 22,
    "zh": "望之從少府出為左遷，恐有不合意，即移病。"
  },
  {
    "id": "s0349",
    "blockIndex": 22,
    "zh": "上聞之，使侍中成都侯金安上諭意曰：「所用皆更治民以考功。"
  },
  {
    "id": "s0350",
    "blockIndex": 22,
    "zh": "君前為平原太守日淺，故複試之於三輔，非有所聞也。"
  },
  {
    "id": "s0351",
    "blockIndex": 22,
    "zh": "」望之即起視事。"
  },
  {
    "id": "s0352",
    "blockIndex": 22,
    "zh": "----8初，掖庭令張賀數為弟車騎將軍安世稱皇曾孫之材美及徵怪，安世輒絕止，以為少主在上，不宜稱述曾孫。"
  },
  {
    "id": "s0353",
    "blockIndex": 22,
    "zh": "及帝即位而賀已死，上謂安世曰：「掖庭令平生稱我，將軍止之，是也。"
  },
  {
    "id": "s0354",
    "blockIndex": 22,
    "zh": "」上追思賀恩，欲封其塚為恩德侯，置守塚二百家。"
  },
  {
    "id": "s0355",
    "blockIndex": 22,
    "zh": "賀有子蚤死，子安世小男彭祖。"
  },
  {
    "id": "s0356",
    "blockIndex": 22,
    "zh": "彭祖又小與上同席研書指，欲封之，先賜爵關內侯。"
  },
  {
    "id": "s0357",
    "blockIndex": 22,
    "zh": "安世深辭賀封；"
  },
  {
    "id": "s0358",
    "blockIndex": 22,
    "zh": "又求損守塚戶數，稍減至三十戶。"
  },
  {
    "id": "s0359",
    "blockIndex": 22,
    "zh": "上曰：「吾自為掖庭令，非為將軍也。"
  },
  {
    "id": "s0360",
    "blockIndex": 22,
    "zh": "」安世乃止，不敢復言。"
  },
  {
    "id": "s0361",
    "blockIndex": 22,
    "zh": "----9上心忌故昌邑王賀，賜山陽太守張敞璽書，令謹備盜賊，察往來過客；"
  },
  {
    "id": "s0362",
    "blockIndex": 22,
    "zh": "毋下所賜書。"
  },
  {
    "id": "s0363",
    "blockIndex": 22,
    "zh": "敞於是條奏賀居處，著其廢亡之效曰：「故昌邑王為人，青黑色，小目，鼻末銳卑，少鬚眉，身體長大，疾痿，行步不便。"
  },
  {
    "id": "s0364",
    "blockIndex": 22,
    "zh": "臣敞嘗與之言，欲動觀其意，即以惡鳥感之曰：『昌邑多梟。"
  },
  {
    "id": "s0365",
    "blockIndex": 22,
    "zh": "』故王應曰：『然。"
  },
  {
    "id": "s0366",
    "blockIndex": 22,
    "zh": "前賀西至長安，殊無梟；"
  },
  {
    "id": "s0367",
    "blockIndex": 22,
    "zh": "復來，東至濟陽，乃復聞梟聲。"
  },
  {
    "id": "s0368",
    "blockIndex": 22,
    "zh": "』察故王衣服、言語、跪起，清狂不惠。"
  },
  {
    "id": "s0369",
    "blockIndex": 22,
    "zh": "臣敞前言：『哀王歌舞者張脩等十人無子，留守哀王園，請罷歸。"
  },
  {
    "id": "s0370",
    "blockIndex": 22,
    "zh": "』故王聞之曰：『中人守園，疾者當勿治，相殺傷者當勿法，欲令亟死。"
  },
  {
    "id": "s0371",
    "blockIndex": 22,
    "zh": "太守奈何而欲罷之？"
  },
  {
    "id": "s0372",
    "blockIndex": 22,
    "zh": "』其天資喜由亂亡，終不見仁義如此。"
  },
  {
    "id": "s0373",
    "blockIndex": 22,
    "zh": "」上乃知賀不足忌也。"
  },
  {
    "id": "s0375",
    "blockIndex": 23,
    "zh": "1春，三月，詔封故昌邑王賀為海昏侯。"
  },
  {
    "id": "s0376",
    "blockIndex": 23,
    "zh": "----2乙未，詔曰：「朕微眇時，御史大夫丙吉，中郎將史曾、史玄，長樂衛尉許舜，侍中、光祿大夫許延壽，皆與朕有舊恩，及故掖庭令張賀，輔導朕躬，修文學經術，恩惠卓異，厥功茂焉。"
  },
  {
    "id": "s0377",
    "blockIndex": 23,
    "zh": "《詩》不雲乎：『無德不報』，封賀所子弟子侍中、中郎將彭祖為陽都侯，追賜賀謚曰陽都哀侯，吉為博陽侯，曾為將陵侯，玄為平台侯，舜為博望侯，延壽為樂成侯。"
  },
  {
    "id": "s0378",
    "blockIndex": 23,
    "zh": "」賀有孤孫霸，年七歲，拜為散騎、中郎將，賜爵關內侯。"
  },
  {
    "id": "s0379",
    "blockIndex": 23,
    "zh": "故人下至郡邸獄復作嘗有阿保之功者，皆受官祿、田宅、財物，各以恩深淺報之。"
  },
  {
    "id": "s0380",
    "blockIndex": 24,
    "zh": "吉臨當封，病；"
  },
  {
    "id": "s0381",
    "blockIndex": 24,
    "zh": "上憂其不起，將使人就加印紼而封之，及其生存也。"
  },
  {
    "id": "s0382",
    "blockIndex": 24,
    "zh": "太子太傅夏侯勝曰：「此未死也！"
  },
  {
    "id": "s0383",
    "blockIndex": 24,
    "zh": "臣聞有陰德者必饗其樂，以及子孫。"
  },
  {
    "id": "s0384",
    "blockIndex": 24,
    "zh": "今吉未獲報而疾甚，非其死疾也。"
  },
  {
    "id": "s0385",
    "blockIndex": 24,
    "zh": "」後病果愈。"
  },
  {
    "id": "s0386",
    "blockIndex": 25,
    "zh": "張安世自以父子封侯，在位太盛。"
  },
  {
    "id": "s0387",
    "blockIndex": 25,
    "zh": "乃辭祿，詔都內別藏張氏無名錢以百萬數。"
  },
  {
    "id": "s0388",
    "blockIndex": 25,
    "zh": "安世謹慎周密，每定大政，已決，輒移病出。"
  },
  {
    "id": "s0389",
    "blockIndex": 25,
    "zh": "聞有詔令，乃驚，使吏之丞相府問焉。"
  },
  {
    "id": "s0390",
    "blockIndex": 25,
    "zh": "自朝廷大臣，莫知其與議也。"
  },
  {
    "id": "s0391",
    "blockIndex": 25,
    "zh": "嘗有所薦，其人來謝，安世大恨，以為「舉賢達能，豈有私謝邪！"
  },
  {
    "id": "s0392",
    "blockIndex": 25,
    "zh": "」絕弗復為通。"
  },
  {
    "id": "s0393",
    "blockIndex": 25,
    "zh": "有郎功高不調，自言安世，安世應曰：「君之功高，明主所知，人臣執事，何長短而自言乎！"
  },
  {
    "id": "s0394",
    "blockIndex": 25,
    "zh": "」絕不許。"
  },
  {
    "id": "s0395",
    "blockIndex": 25,
    "zh": "已而郎果遷。"
  },
  {
    "id": "s0396",
    "blockIndex": 25,
    "zh": "安世自見父子尊顯，懷不自安，為子延壽求出補吏，上以為北地太守；"
  },
  {
    "id": "s0397",
    "blockIndex": 25,
    "zh": "歲餘，上閔安世年老，復徵延壽為左曹、太僕。"
  },
  {
    "id": "s0398",
    "blockIndex": 25,
    "zh": "----3夏，四月，丙子，立皇子欽為淮陽王。"
  },
  {
    "id": "s0399",
    "blockIndex": 25,
    "zh": "皇太子年十二，通《論語》、《孝經》。"
  },
  {
    "id": "s0400",
    "blockIndex": 25,
    "zh": "太傅疏廣謂少傅受曰：「吾聞『知足不辱，知止不殆。"
  },
  {
    "id": "s0401",
    "blockIndex": 25,
    "zh": "』今仕宦至二千石，官成名立，如此不去，懼有後悔。"
  },
  {
    "id": "s0402",
    "blockIndex": 25,
    "zh": "」即日，父子俱移病，上疏乞骸骨。"
  },
  {
    "id": "s0403",
    "blockIndex": 25,
    "zh": "上皆許之，加賜黃金二十斤，皇太子贈以五十斤。"
  },
  {
    "id": "s0404",
    "blockIndex": 25,
    "zh": "公卿故人設祖道供張東都門外，送者車數百兩。"
  },
  {
    "id": "s0405",
    "blockIndex": 25,
    "zh": "道路觀者皆曰：「賢哉二大夫！"
  },
  {
    "id": "s0406",
    "blockIndex": 25,
    "zh": "」或歎息為之下泣。"
  },
  {
    "id": "s0407",
    "blockIndex": 26,
    "zh": "廣、受歸鄉里，日令其家賣金共具，請族人、故舊、賓客，與相娛樂。"
  },
  {
    "id": "s0408",
    "blockIndex": 26,
    "zh": "或勸廣以其金為子孫頗立產業者，廣曰：「吾豈老悖不念子孫哉！"
  },
  {
    "id": "s0409",
    "blockIndex": 26,
    "zh": "顧自有舊田廬，令子孫勤力其中，足以共衣食，與凡人齊。"
  },
  {
    "id": "s0410",
    "blockIndex": 26,
    "zh": "今復增益之以為贏餘，但教子孫怠墮耳。"
  },
  {
    "id": "s0411",
    "blockIndex": 26,
    "zh": "賢而多財，則損其志；"
  },
  {
    "id": "s0412",
    "blockIndex": 26,
    "zh": "愚而多財，則益其過。"
  },
  {
    "id": "s0413",
    "blockIndex": 26,
    "zh": "且夫富者眾之怨也，吾既無以教化子孫，不欲益其過而生怨。"
  },
  {
    "id": "s0414",
    "blockIndex": 26,
    "zh": "又此金者，聖主所以惠養老臣也，故樂與鄉黨、宗族共饗其賜，以盡吾餘日，不亦可乎！"
  },
  {
    "id": "s0415",
    "blockIndex": 26,
    "zh": "」於是族人悅服。"
  },
  {
    "id": "s0416",
    "blockIndex": 26,
    "zh": "----4穎川太守黃霸使郵亭、鄉官皆畜雞、豚，以贍鰥、寡、貧、窮者；"
  },
  {
    "id": "s0417",
    "blockIndex": 26,
    "zh": "然後為條教，置父老、師帥、伍長，班行之於民間，勸以為善防奸之意，及務耕桑、節用、殖財、種樹、畜養，去浮淫之費。"
  },
  {
    "id": "s0418",
    "blockIndex": 26,
    "zh": "其治，米鹽靡密，初若煩碎，然霸精力能推行之。"
  },
  {
    "id": "s0419",
    "blockIndex": 26,
    "zh": "吏民見者，語次尋繹，問他陰伏以相參考，聰明識事，吏民不知所出，咸稱神明，豪厘不敢有所欺。"
  },
  {
    "id": "s0420",
    "blockIndex": 26,
    "zh": "奸人去入它郡，盜賊日少。"
  },
  {
    "id": "s0421",
    "blockIndex": 26,
    "zh": "霸力行教化而後誅罰，務在成就全安長吏。"
  },
  {
    "id": "s0422",
    "blockIndex": 26,
    "zh": "許丞老，病聾，督郵白欲逐之。"
  },
  {
    "id": "s0423",
    "blockIndex": 26,
    "zh": "霸曰：「許丞廉吏，雖老，尚能拜起送迎，正頗重聽何傷！"
  },
  {
    "id": "s0424",
    "blockIndex": 26,
    "zh": "且善助之，毋失賢者意！"
  },
  {
    "id": "s0425",
    "blockIndex": 26,
    "zh": "」或問其故，霸曰：「數易長吏，送故迎新之費，及奸吏因緣，絕簿書，盜財物，公私費耗甚多，皆當出於民。"
  },
  {
    "id": "s0426",
    "blockIndex": 26,
    "zh": "所易新吏又未必賢，或不如其故，徒相益為亂。"
  },
  {
    "id": "s0427",
    "blockIndex": 26,
    "zh": "凡治道，去其泰甚者耳。"
  },
  {
    "id": "s0428",
    "blockIndex": 26,
    "zh": "」霸以外寬內明，得吏民心，戶口歲增，治為天下第一，徵守京兆尹。"
  },
  {
    "id": "s0429",
    "blockIndex": 26,
    "zh": "頃之，坐法，連貶秩；"
  },
  {
    "id": "s0430",
    "blockIndex": 26,
    "zh": "有詔復歸穎川為太守，以八百石居。"
  },
  {
    "id": "s0432",
    "blockIndex": 27,
    "zh": "1春，正月，詔：「年八十以上，非誣告、殺傷人，他皆勿坐。"
  },
  {
    "id": "s0433",
    "blockIndex": 27,
    "zh": "」----2右扶風尹翁歸卒，家無餘財。"
  },
  {
    "id": "s0434",
    "blockIndex": 27,
    "zh": "秋，八月，詔曰：「翁歸廉平鄉正，治民異等。"
  },
  {
    "id": "s0435",
    "blockIndex": 27,
    "zh": "其賜翁歸子黃金百斤，以奉祭祀。"
  },
  {
    "id": "s0436",
    "blockIndex": 27,
    "zh": "」----3上令有司求高祖功臣子孫失侯者，得槐裡公乘周廣漢等百三十六人，皆賜黃金二十斤，復其家，令奉祭祀，世世勿絕。"
  },
  {
    "id": "s0437",
    "blockIndex": 27,
    "zh": "----4丙寅，富平敬侯張安世薨。"
  },
  {
    "id": "s0438",
    "blockIndex": 27,
    "zh": "----5初，扶陽節侯韋賢薨，長子弘有罪繫獄，家人矯賢令，以次子大河都尉玄成為後。"
  },
  {
    "id": "s0439",
    "blockIndex": 27,
    "zh": "玄成深知其非賢雅意，即陽為病狂，臥便利，妄笑語，昏亂。"
  },
  {
    "id": "s0440",
    "blockIndex": 27,
    "zh": "既葬，當襲爵，以狂不應召。"
  },
  {
    "id": "s0441",
    "blockIndex": 27,
    "zh": "大鴻臚奏狀，章下丞相、御史案驗。"
  },
  {
    "id": "s0442",
    "blockIndex": 27,
    "zh": "案事丞相史乃與玄成書曰：「古之辭讓，必有文義可觀，故能垂榮於後。"
  },
  {
    "id": "s0443",
    "blockIndex": 27,
    "zh": "今子獨壞容貌，蒙恥辱為狂癡，光曜晻而不宣，微哉子之所托名也！"
  },
  {
    "id": "s0444",
    "blockIndex": 27,
    "zh": "僕素愚陋，過為宰相執事，願少聞風聲；"
  },
  {
    "id": "s0445",
    "blockIndex": 27,
    "zh": "不然，恐子傷高而僕為小人也。"
  },
  {
    "id": "s0446",
    "blockIndex": 27,
    "zh": "」玄成友人侍郎章亦上疏言：「聖王貴以禮讓為國，宜優養玄成，勿枉其志，使得自安衡門之下。"
  },
  {
    "id": "s0447",
    "blockIndex": 27,
    "zh": "」而丞相、御史遂以玄成實不病，劾奏之，有詔勿劾，引拜；"
  },
  {
    "id": "s0448",
    "blockIndex": 27,
    "zh": "玄成不得已，受爵。"
  },
  {
    "id": "s0449",
    "blockIndex": 27,
    "zh": "帝高其節，以玄成為河南太守。"
  },
  {
    "id": "s0450",
    "blockIndex": 27,
    "zh": "----6車師王烏貴之走烏孫也，烏孫留不遣。"
  },
  {
    "id": "s0451",
    "blockIndex": 27,
    "zh": "漢遣使責烏孫，烏孫送烏貴詣闕。"
  },
  {
    "id": "s0452",
    "blockIndex": 27,
    "zh": "----7初，武帝開河西四郡，隔絕羌與匈奴相通之路，斥逐諸羌。"
  },
  {
    "id": "s0453",
    "blockIndex": 27,
    "zh": "不使居湟中地。"
  },
  {
    "id": "s0454",
    "blockIndex": 27,
    "zh": "及帝即位，光祿大夫義渠安國使行諸羌；"
  },
  {
    "id": "s0455",
    "blockIndex": 27,
    "zh": "先零豪言：「願時度湟水北，逐民所不田處畜牧。"
  },
  {
    "id": "s0456",
    "blockIndex": 27,
    "zh": "」安國以聞。"
  },
  {
    "id": "s0457",
    "blockIndex": 27,
    "zh": "後將軍趙充國劾安國奉使不敬。"
  },
  {
    "id": "s0458",
    "blockIndex": 27,
    "zh": "是後羌人旁緣前言，抵冒度湟水，郡縣不能禁。"
  },
  {
    "id": "s0459",
    "blockIndex": 28,
    "zh": "既而先零與諸羌種豪二百餘人解仇、交質、盟詛。"
  },
  {
    "id": "s0460",
    "blockIndex": 28,
    "zh": "上聞之，以問趙充國，對曰：「羌人所以易制者，以其種自有豪，數相攻擊，勢不壹也。"
  },
  {
    "id": "s0461",
    "blockIndex": 28,
    "zh": "往三十餘歲西羌反時，亦先解仇合約攻令居，與漢相距，五六年乃定。"
  },
  {
    "id": "s0462",
    "blockIndex": 28,
    "zh": "匈奴數誘羌人，欲與之共擊張掖、酒泉地，使羌居之。"
  },
  {
    "id": "s0463",
    "blockIndex": 28,
    "zh": "間者匈奴困於西方，疑其更遣使至羌中與相結。"
  },
  {
    "id": "s0464",
    "blockIndex": 28,
    "zh": "臣恐羌變未止此，且復結聯他種，宜及未然為之備。"
  },
  {
    "id": "s0465",
    "blockIndex": 28,
    "zh": "」後月餘，羌侯狼何果遣使至匈奴藉兵，欲擊鄯善、敦煌以絕漢道。"
  },
  {
    "id": "s0466",
    "blockIndex": 28,
    "zh": "充國以為「狼何勢不能獨造此計，疑匈奴使已至羌中，先零、罕、幵乃解仇作約。"
  },
  {
    "id": "s0467",
    "blockIndex": 28,
    "zh": "到秋馬肥，變必起矣。"
  },
  {
    "id": "s0468",
    "blockIndex": 28,
    "zh": "宜遣使者行邊兵，豫為備敕，視諸羌毋令解仇，以發覺其謀。"
  },
  {
    "id": "s0469",
    "blockIndex": 28,
    "zh": "」於是兩府復白遣義渠安國行視諸羌，分別善惡。"
  },
  {
    "id": "s0470",
    "blockIndex": 28,
    "zh": "----8是時，比年豐稔，穀石五錢。"
  },
  {
    "id": "s0471",
