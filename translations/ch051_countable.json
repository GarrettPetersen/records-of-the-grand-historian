[
  {
    "id": "s0001",
    "blockIndex": 0,
    "zh": "資治通鑑第051卷"
  },
  {
    "id": "s0002",
    "blockIndex": 1,
    "zh": "【漢紀四十三】起旃蒙赤奮若，盡昭陽作噩，凡九年。"
  },
  {
    "id": "s0003",
    "blockIndex": 2,
    "zh": "春，二月，乙亥，下邳惠王衍薨。"
  },
  {
    "id": "s0004",
    "blockIndex": 3,
    "zh": "甲辰，車駕南巡。"
  },
  {
    "id": "s0005",
    "blockIndex": 4,
    "zh": "三月，戊午朔，日有食之。"
  },
  {
    "id": "s0006",
    "blockIndex": 5,
    "zh": "庚申，帝至宛，不豫。"
  },
  {
    "id": "s0007",
    "blockIndex": 5,
    "zh": "乙丑，帝發自宛；"
  },
  {
    "id": "s0008",
    "blockIndex": 5,
    "zh": "丁卯，至葉，崩於乘輿。"
  },
  {
    "id": "s0009",
    "blockIndex": 5,
    "zh": "年三十二。"
  },
  {
    "id": "s0010",
    "blockIndex": 6,
    "zh": "皇后與閻顯兄弟、江京、樊豐等謀曰：「今晏駕道次，濟陰王在內，邂逅公卿立之，還為大害。"
  },
  {
    "id": "s0011",
    "blockIndex": 6,
    "zh": "」乃偽云「帝疾甚」，徙御臥車，所在上食、問起居如故。"
  },
  {
    "id": "s0012",
    "blockIndex": 6,
    "zh": "驅馳行四日，庚午，還宮。"
  },
  {
    "id": "s0013",
    "blockIndex": 6,
    "zh": "辛未，遣司徒劉熹詣郊廟、社稷，告天請命；"
  },
  {
    "id": "s0014",
    "blockIndex": 6,
    "zh": "其夕，發喪。"
  },
  {
    "id": "s0015",
    "blockIndex": 6,
    "zh": "尊皇后曰皇太后。"
  },
  {
    "id": "s0016",
    "blockIndex": 6,
    "zh": "太后臨朝。"
  },
  {
    "id": "s0017",
    "blockIndex": 6,
    "zh": "以顯為車騎將軍、儀同三司。"
  },
  {
    "id": "s0018",
    "blockIndex": 6,
    "zh": "太后欲久專國政，貪立幼年，與顯等定策禁中，迎濟北惠王子北鄉侯懿為嗣。"
  },
  {
    "id": "s0019",
    "blockIndex": 6,
    "zh": "濟陰王以廢黜，不得上殿親臨梓宮，悲號不食；"
  },
  {
    "id": "s0020",
    "blockIndex": 6,
    "zh": "內外群僚莫不哀之。"
  },
  {
    "id": "s0021",
    "blockIndex": 7,
    "zh": "甲戌，濟南孝王香薨，無子，國絕。"
  },
  {
    "id": "s0022",
    "blockIndex": 7,
    "zh": "乙酉，北鄉侯即皇帝位。"
  },
  {
    "id": "s0023",
    "blockIndex": 8,
    "zh": "夏，四月，丁酉，太尉馮石為太傅，司徒劉熹為太尉，參錄尚書事，前司空李郃為司徒。"
  },
  {
    "id": "s0024",
    "blockIndex": 9,
    "zh": "閻顯忌大將軍耿寶位尊權重，威行前朝，乃風有司奏「寶及其黨與中常侍樊豐、虎賁中郎將謝惲、侍中周廣、野王君王聖、聖女永等更相阿黨，互作威福，皆大不道。"
  },
  {
    "id": "s0025",
    "blockIndex": 9,
    "zh": "」辛卯，豐、惲、廣皆下獄，死；"
  },
  {
    "id": "s0026",
    "blockIndex": 9,
    "zh": "家屬徙比景。"
  },
  {
    "id": "s0027",
    "blockIndex": 9,
    "zh": "貶寶及弟子林慮侯承皆為亭侯，遣就國；"
  },
  {
    "id": "s0028",
    "blockIndex": 9,
    "zh": "寶於道自殺。"
  },
  {
    "id": "s0029",
    "blockIndex": 9,
    "zh": "王聖母子徙雁門。"
  },
  {
    "id": "s0030",
    "blockIndex": 9,
    "zh": "於是以閻景為衛尉，耀為城門校尉，晏為執金吾，兄弟並處權要，威福自由。"
  },
  {
    "id": "s0031",
    "blockIndex": 10,
    "zh": "己酉，葬孝安皇帝於恭陵，廟曰恭宗。"
  },
  {
    "id": "s0032",
    "blockIndex": 11,
    "zh": "六月，乙巳，赦天下。"
  },
  {
    "id": "s0033",
    "blockIndex": 12,
    "zh": "秋，七月，西域長史班勇發敦煌、張掖、酒泉六千騎及鄯善、疏勒、車師前部兵擊後部王軍就，大破之，獲首虜八千餘人，生得軍就及匈奴持節使者，將至索班沒處斬之，傳首京師。"
  },
  {
    "id": "s0034",
    "blockIndex": 13,
    "zh": "冬，十月，丙午，越巂山崩。"
  },
  {
    "id": "s0035",
    "blockIndex": 14,
    "zh": "北鄉侯病篤，中常侍孫程謂濟陰王謁者長興渠曰：「王以嫡統，本無失德。"
  },
  {
    "id": "s0036",
    "blockIndex": 14,
    "zh": "先帝用讒，遂至廢黜。"
  },
  {
    "id": "s0037",
    "blockIndex": 14,
    "zh": "若北鄉侯不起，相與共斷江京、閻顯，事無不成者。"
  },
  {
    "id": "s0038",
    "blockIndex": 14,
    "zh": "」渠然之。"
  },
  {
    "id": "s0039",
    "blockIndex": 14,
    "zh": "又中黃門南陽王康，先為太子府史，及長樂太官丞京兆王國等並附同於程。"
  },
  {
    "id": "s0040",
    "blockIndex": 14,
    "zh": "江京謂閻顯曰：「北鄉侯病不解，國嗣宜以時定，何不早徵諸王子，簡所置乎！"
  },
  {
    "id": "s0041",
    "blockIndex": 14,
    "zh": "」顯以為然。"
  },
  {
    "id": "s0042",
    "blockIndex": 14,
    "zh": "辛亥，北鄉侯薨。"
  },
  {
    "id": "s0043",
    "blockIndex": 14,
    "zh": "顯白太后，秘不發喪，而更徵諸王子，閉宮門，屯兵自守。"
  },
  {
    "id": "s0044",
    "blockIndex": 15,
    "zh": "十一月，乙卯，孫程、王康、王國與中黃門黃龍、彭愷、孟叔、李建、王成、張賢、史泛、馬國、王道、李元、楊佗、陳予、趙封、李剛、魏猛、苗光等聚謀於西鐘下，皆截單衣為誓。"
  },
  {
    "id": "s0045",
    "blockIndex": 15,
    "zh": "丁巳，京師及郡國十六地震。"
  },
  {
    "id": "s0046",
    "blockIndex": 15,
    "zh": "是夜，程等共會崇德殿上，因入章臺門。"
  },
  {
    "id": "s0047",
    "blockIndex": 15,
    "zh": "時江京、劉發及李閏、陳達等俱坐省門下，程與王康共就斬京、安、達。"
  },
  {
    "id": "s0048",
    "blockIndex": 15,
    "zh": "以李閏權勢積為省內所服，欲引為主，因舉刃脅閏曰：「今當立濟陰王，無得搖動！"
  },
  {
    "id": "s0049",
    "blockIndex": 15,
    "zh": "」閏曰：「諾。"
  },
  {
    "id": "s0050",
    "blockIndex": 15,
    "zh": "」於是扶閏起，俱於西鐘下迎濟陰王即皇帝位，時年十一。"
  },
  {
    "id": "s0051",
    "blockIndex": 15,
    "zh": "召尚書令、僕射以下從輦幸南宮，程等留守省門，遮扞內外。"
  },
  {
    "id": "s0052",
    "blockIndex": 15,
    "zh": "帝登雲台，召公卿、百僚，使虎賁、羽林士屯南、北宮諸門。"
  },
  {
    "id": "s0053",
    "blockIndex": 16,
    "zh": "閻顯時在禁中，憂迫不知所為，小黃門樊登勸顯以太后詔召越騎校尉馮詩、虎賁中郎將閻崇將兵屯平朔門以御程等。"
  },
  {
    "id": "s0054",
    "blockIndex": 16,
    "zh": "顯誘詩入省，謂曰：「濟陰王立，非皇太后意，璽綬在此。"
  },
  {
    "id": "s0055",
    "blockIndex": 16,
    "zh": "苟盡力效功，封侯可得。"
  },
  {
    "id": "s0056",
    "blockIndex": 16,
    "zh": "」太后使授之印曰：「能得濟陰王者，封萬戶侯；"
  },
  {
    "id": "s0057",
    "blockIndex": 16,
    "zh": "得李閏者，五千戶侯。"
  },
  {
    "id": "s0058",
    "blockIndex": 16,
    "zh": "」詩等皆許諾，辭以「卒被召，所將眾少。"
  },
  {
    "id": "s0059",
    "blockIndex": 16,
    "zh": "」顯使與登迎吏士於左掖門外，詩因格殺登，歸營屯守。"
  },
  {
    "id": "s0060",
    "blockIndex": 17,
    "zh": "顯弟衛尉景遽從省中還外府，收兵至盛德門。"
  },
  {
    "id": "s0061",
    "blockIndex": 17,
    "zh": "孫程傳召諸尚書使收景。"
  },
  {
    "id": "s0062",
    "blockIndex": 17,
    "zh": "尚書郭鎮時臥病，聞之，即率直宿羽林出南止車門，逢景從吏士拔白刃呼曰：「無干兵！"
  },
  {
    "id": "s0063",
    "blockIndex": 17,
    "zh": "」鎮即下車持節詔之，景曰：「何等詔！"
  },
  {
    "id": "s0064",
    "blockIndex": 17,
    "zh": "」因斫鎮，不中。"
  },
  {
    "id": "s0065",
    "blockIndex": 17,
    "zh": "鎮引劍擊景墮車，左右以戟叉其胸，遂禽之，送廷尉獄，即夜死。"
  },
  {
    "id": "s0066",
    "blockIndex": 18,
    "zh": "戊午，遣使者入省，奪得璽綬，帝乃幸嘉德殿，遣侍御史持節收閻顯及其弟城門校尉耀、執金吾晏，並下獄，誅；"
  },
  {
    "id": "s0067",
    "blockIndex": 18,
    "zh": "家屬皆徙比景。"
  },
  {
    "id": "s0068",
    "blockIndex": 18,
    "zh": "遷太后於離宮。"
  },
  {
    "id": "s0069",
    "blockIndex": 18,
    "zh": "己未，開門，罷屯兵。"
  },
  {
    "id": "s0070",
    "blockIndex": 18,
    "zh": "壬戌，詔司隸校尉：「惟閻顯、江京近親，當伏辜誅，其餘務崇寬貸。"
  },
  {
    "id": "s0072",
    "blockIndex": 19,
    "zh": "封孫程等皆為列侯：程食邑萬戶，王康、王國食九千戶，黃龍食五千戶，彭愷、孟叔、李建食四千二百戶，王成、張賢、史泛、馬國、王道、李元、楊佗、陳予、趙封、李剛食四千戶，魏猛食二千戶，苗光食千戶：是為十九侯，加賜車馬、金銀、錢帛各有差；"
  },
  {
    "id": "s0073",
    "blockIndex": 19,
    "zh": "李閏以先不豫謀，故不封。"
  },
  {
    "id": "s0074",
    "blockIndex": 19,
    "zh": "擢孫程為騎都尉。"
  },
  {
    "id": "s0075",
    "blockIndex": 20,
    "zh": "初，程等入章台門，苗光獨不入。"
  },
  {
    "id": "s0076",
    "blockIndex": 20,
    "zh": "詔書錄功臣，令王康疏名，康詐疏光入章台門。"
  },
  {
    "id": "s0077",
    "blockIndex": 20,
    "zh": "光未受符策，心不自安，詣黃門令自告。"
  },
  {
    "id": "s0078",
    "blockIndex": 20,
    "zh": "有司奏康、光欺詐主上；"
  },
  {
    "id": "s0079",
    "blockIndex": 20,
    "zh": "詔書勿問。"
  },
  {
    "id": "s0080",
    "blockIndex": 20,
    "zh": "以將作大匠來歷為衛尉。"
  },
  {
    "id": "s0081",
    "blockIndex": 20,
    "zh": "祋諷、劉瑋、閭丘弘等先卒，皆拜其子為郎。"
  },
  {
    "id": "s0082",
    "blockIndex": 20,
    "zh": "朱倀、施延、陳光、趙代皆見拔用，後至公卿。"
  },
  {
    "id": "s0083",
    "blockIndex": 20,
    "zh": "徵王男、邴吉家屬還京師，厚加賞賜。"
  },
  {
    "id": "s0084",
    "blockIndex": 20,
    "zh": "帝之見廢也，監太子家小黃門籍建、傅高梵、長秋長趙熹、丞良賀、藥長夏珍皆坐徙朔方；"
  },
  {
    "id": "s0085",
    "blockIndex": 20,
    "zh": "帝即位，並擢為中常侍。"
  },
  {
    "id": "s0086",
    "blockIndex": 21,
    "zh": "初，閻顯辟崔□因之子瑗為吏，瑗以北鄉侯立不以正，知顯將敗，欲說令廢立，而顯日沉醉，不能得見，乃謂長史陳禪曰：「中常侍江京等惑蠱先帝，廢黜正統，扶立疏孽。"
  },
  {
    "id": "s0087",
    "blockIndex": 21,
    "zh": "少帝即位，發病廟中，周勃之徵，於斯復見。"
  },
  {
    "id": "s0088",
    "blockIndex": 21,
    "zh": "今欲與君共求見說將軍，白太后，收京等，廢少帝，引立濟陰王，必上當天心，下合人望，伊、霍之功不下席而立，則將軍兄弟傳祚於無窮；"
  },
  {
    "id": "s0089",
    "blockIndex": 21,
    "zh": "若拒違天意，久曠神器，則將以無罪並辜元惡。"
  },
  {
    "id": "s0090",
    "blockIndex": 21,
    "zh": "此所謂禍福之會，分功之時也。"
  },
  {
    "id": "s0091",
    "blockIndex": 21,
    "zh": "」禪猶豫未敢從。"
  },
  {
    "id": "s0092",
    "blockIndex": 21,
    "zh": "會顯敗，瑗坐被斥；"
  },
  {
    "id": "s0093",
    "blockIndex": 21,
    "zh": "門生蘇祗欲上書言狀，瑗遽止之。"
  },
  {
    "id": "s0094",
    "blockIndex": 21,
    "zh": "時陳禪為司隸校尉，召瑗謂曰：「弟聽祗上書，禪請為之證。"
  },
  {
    "id": "s0095",
    "blockIndex": 21,
    "zh": "」瑗曰：「此譬猶兒妾屏語耳，願使君勿復出口。"
  },
  {
    "id": "s0096",
    "blockIndex": 21,
    "zh": "」遂辭歸，不復應州郡命。"
  },
  {
    "id": "s0097",
    "blockIndex": 22,
    "zh": "己卯，以諸王禮葬北鄉侯。"
  },
  {
    "id": "s0098",
    "blockIndex": 23,
    "zh": "司空劉授以阿附惡逆，辟召非其人，策免。"
  },
  {
    "id": "s0099",
    "blockIndex": 24,
    "zh": "十二月，甲申，以少府河南陶敦為司空。"
  },
  {
    "id": "s0100",
    "blockIndex": 25,
    "zh": "楊震門生虞放、陳翼詣闕追訟震事；"
  },
  {
    "id": "s0101",
    "blockIndex": 25,
    "zh": "詔除震二子為郎，贈錢百萬，以禮改葬於華陰潼亭，遠近畢至。"
  },
  {
    "id": "s0102",
    "blockIndex": 25,
    "zh": "有大鳥高丈餘集震喪前，郡以狀上。"
  },
  {
    "id": "s0103",
    "blockIndex": 25,
    "zh": "帝感震忠直，詔復以中牢具祠之。"
  },
  {
    "id": "s0104",
    "blockIndex": 25,
    "zh": "議郎陳禪以為：「閻太后與帝無母子恩，宜徙別館，絕朝見，」群臣議者咸以為宜。"
  },
  {
    "id": "s0105",
    "blockIndex": 25,
    "zh": "司徒掾汝南周舉謂李郃曰：「昔瞽瞍常欲殺舜，舜事之逾謹；"
  },
  {
    "id": "s0106",
    "blockIndex": 25,
    "zh": "鄭武姜謀殺莊公，莊公誓之黃泉，秦始皇怨母失行，久而隔絕，後感穎考叔、茅焦之言，復修子道；"
  },
  {
    "id": "s0107",
    "blockIndex": 25,
    "zh": "書傳美之。"
  },
  {
    "id": "s0108",
    "blockIndex": 25,
    "zh": "今諸閻新誅，太后幽在離宮，若悲愁生疾，一旦不虞，主上將何以令於天下！"
  },
  {
    "id": "s0109",
    "blockIndex": 25,
    "zh": "如從禪議，後世歸咎明公。"
  },
  {
    "id": "s0110",
    "blockIndex": 25,
    "zh": "宜密表朝廷，令奉太后，率群臣朝覲如舊，以厭天心，以答人望！"
  },
  {
    "id": "s0111",
    "blockIndex": 25,
    "zh": "」郃即上疏陳之。"
  },
  {
    "id": "s0112",
    "blockIndex": 26,
    "zh": "孝和皇帝上"
  },
  {
    "id": "s0113",
    "blockIndex": 27,
    "zh": "春，正月，帝朝太后於東宮，太后意乃安。"
  },
  {
    "id": "s0114",
    "blockIndex": 28,
    "zh": "甲寅，赦天下。"
  },
  {
    "id": "s0115",
    "blockIndex": 29,
    "zh": "辛未，皇太后閻氏崩。"
  },
  {
    "id": "s0116",
    "blockIndex": 30,
    "zh": "辛巳，太傅馮石、太尉劉熹以阿黨權貴免。"
  },
  {
    "id": "s0117",
    "blockIndex": 30,
    "zh": "司徒李郃罷。"
  },
  {
    "id": "s0118",
    "blockIndex": 31,
    "zh": "二月，甲申，葬安思皇后。"
  },
  {
    "id": "s0119",
    "blockIndex": 32,
    "zh": "丙戌，以太常桓焉為太傅；"
  },
  {
    "id": "s0120",
    "blockIndex": 32,
    "zh": "大鴻臚京兆朱寵為太尉，參錄尚書事；"
  },
  {
    "id": "s0121",
    "blockIndex": 32,
    "zh": "長樂少府朱倀為司徒。"
  },
  {
    "id": "s0122",
    "blockIndex": 33,
    "zh": "封尚書郭鎮為定穎侯。"
  },
  {
    "id": "s0123",
    "blockIndex": 34,
    "zh": "隴西鐘羌反，校尉馬賢擊之，戰於臨洮，斬首千餘級，羌眾皆降；"
  },
  {
    "id": "s0124",
    "blockIndex": 34,
    "zh": "由是涼州復安。"
  },
  {
    "id": "s0125",
    "blockIndex": 35,
    "zh": "六月，己亥，封濟南簡王錯子顯為濟南王。"
  },
  {
    "id": "s0126",
    "blockIndex": 36,
    "zh": "秋，七月，庚午，以衛尉來歷為車騎將軍。"
  },
  {
    "id": "s0127",
    "blockIndex": 37,
    "zh": "八月，鮮卑寇代郡，太守李超戰歿。"
  },
  {
    "id": "s0128",
    "blockIndex": 38,
    "zh": "司隸校尉虞詡到官數月，奏馮石、劉熹，免之，又劾奏中常侍程璜、陳秉、孟生、李閏等，百官側目，號為苛刻。"
  },
  {
    "id": "s0129",
    "blockIndex": 38,
    "zh": "三公劾奏：「詡盛夏多拘繫無辜，為吏民患。"
  },
  {
    "id": "s0130",
    "blockIndex": 38,
    "zh": "」詡上書自訟曰：「法禁者，俗之堤防；"
  },
  {
    "id": "s0131",
    "blockIndex": 38,
    "zh": "刑罰者，民之銜轡。"
  },
  {
    "id": "s0132",
    "blockIndex": 38,
    "zh": "今州曰任郡，郡曰任縣，更相委遠，百姓怨窮；"
  },
  {
    "id": "s0133",
    "blockIndex": 38,
    "zh": "以苟容為賢，盡節為愚。"
  },
  {
    "id": "s0134",
    "blockIndex": 38,
    "zh": "臣所發舉，臧罪非一。"
  },
  {
    "id": "s0135",
    "blockIndex": 38,
    "zh": "三府恐為臣所奏，遂加誣罪。"
  },
  {
    "id": "s0136",
    "blockIndex": 38,
    "zh": "臣將從史魚死，即以尸諫耳！"
  },
  {
    "id": "s0137",
    "blockIndex": 38,
    "zh": "」帝省其章，乃不罪詡。"
  },
  {
    "id": "s0138",
    "blockIndex": 38,
    "zh": "中常侍張防賣弄權勢，請托受取；"
  },
  {
    "id": "s0139",
    "blockIndex": 38,
    "zh": "詡案之，屢寢不報。"
  },
  {
    "id": "s0140",
    "blockIndex": 38,
    "zh": "詡不勝其憤，乃自系廷尉，奏言曰：「昔孝安皇帝任用樊豐，交亂嫡統，幾亡社稷。"
  },
  {
    "id": "s0141",
    "blockIndex": 38,
    "zh": "今者張防復弄威柄，國家之禍將重至矣。"
  },
  {
    "id": "s0142",
    "blockIndex": 38,
    "zh": "臣不忍與防同朝，謹自系以聞，無令臣襲楊震之跡！"
  },
  {
    "id": "s0143",
    "blockIndex": 38,
    "zh": "」書奏，防流涕訴帝，詡坐論輸左校；"
  },
  {
    "id": "s0144",
    "blockIndex": 38,
    "zh": "防必欲害之，二日之中，傳考四獄。"
  },
  {
    "id": "s0145",
    "blockIndex": 38,
    "zh": "獄吏勸詡自引，詡曰：「寧伏歐刀以示遠近！"
  },
  {
    "id": "s0146",
    "blockIndex": 38,
    "zh": "喑嗚自殺，是非孰辨邪！"
  },
  {
    "id": "s0147",
    "blockIndex": 38,
    "zh": "」浮陽侯孫程、祝阿侯張賢相率乞見，程曰：「陛下始與臥等造事之時，常疾奸臣，知其傾國。"
  },
  {
    "id": "s0148",
    "blockIndex": 38,
    "zh": "今者即位而復自為，何以非先帝乎！"
  },
  {
    "id": "s0149",
    "blockIndex": 38,
    "zh": "司隸校尉虞詡為陛下盡忠，而更被拘繫；"
  },
  {
    "id": "s0150",
    "blockIndex": 38,
    "zh": "常侍張防臧罪明正，反構忠良。"
  },
  {
    "id": "s0151",
    "blockIndex": 38,
    "zh": "今客星守羽林，其占宮中有奸臣；"
  },
  {
    "id": "s0152",
    "blockIndex": 38,
    "zh": "宜急收防送獄，以塞天變。"
  },
  {
    "id": "s0153",
    "blockIndex": 38,
    "zh": "」時防立在帝后，程叱防曰：「奸臣張防，何不下殿！"
  },
  {
    "id": "s0154",
    "blockIndex": 38,
    "zh": "」防不得已，趨就東箱。"
  },
  {
    "id": "s0155",
    "blockIndex": 38,
    "zh": "程曰：「陛下急收防，無令從阿母求請！"
  },
  {
    "id": "s0156",
    "blockIndex": 38,
    "zh": "」帝問諸尚書，尚書賈朗素與防善，證詡之罪；"
  },
  {
    "id": "s0157",
    "blockIndex": 38,
    "zh": "帝疑焉，謂程曰：「且出，吾方思之！"
  },
  {
    "id": "s0158",
    "blockIndex": 38,
    "zh": "」於是詡子顗與門生百餘人，舉幡候中常侍高梵車，叩頭流血，訴言枉狀。"
  },
  {
    "id": "s0159",
    "blockIndex": 38,
    "zh": "梵入言之，防坐徙邊，賈朗等六人或死或黜；"
  },
  {
    "id": "s0160",
    "blockIndex": 38,
    "zh": "即日赦出詡。"
  },
  {
    "id": "s0161",
    "blockIndex": 38,
    "zh": "程復上書陳詡有大功，語甚切激。"
  },
  {
    "id": "s0162",
    "blockIndex": 38,
    "zh": "帝感悟，復徵拜議郎；"
  },
  {
    "id": "s0163",
    "blockIndex": 38,
    "zh": "數日，遷尚書僕射。"
  },
  {
    "id": "s0164",
    "blockIndex": 38,
    "zh": "詡上疏薦議郎南陽左雄曰：「臣見方今公卿以下，類多拱默，以樹恩為賢，盡節為愚，至相戒曰：『白璧不可為，容容多後福。"
  },
  {
    "id": "s0165",
    "blockIndex": 38,
    "zh": "』伏見議郎左雄，有王臣蹇蹇之節，宜擢在喉舌之官，必有國弼之益。"
  },
  {
    "id": "s0166",
    "blockIndex": 38,
    "zh": "」由是拜雄尚書。"
  },
  {
    "id": "s0167",
    "blockIndex": 39,
    "zh": "浮陽侯孫程等懷表上殿爭功，帝怒。"
  },
  {
    "id": "s0168",
    "blockIndex": 39,
    "zh": "有司劾奏「程等於亂悖逆，王國等皆與程黨，久留京都，益其驕恣。"
  },
  {
    "id": "s0169",
    "blockIndex": 39,
    "zh": "」帝乃免程等官，悉徙封遠縣。"
  },
  {
    "id": "s0170",
    "blockIndex": 39,
    "zh": "因遺十九侯就國，敕洛陽令促期發遺。"
  },
  {
    "id": "s0171",
    "blockIndex": 39,
    "zh": "司徒掾周舉說朱倀曰：「朝廷在西鐘下時，非孫程等豈立！"
  },
  {
    "id": "s0172",
    "blockIndex": 39,
    "zh": "今忘其大德，錄其小過。"
  },
  {
    "id": "s0173",
    "blockIndex": 39,
    "zh": "如道路夭折，帝有殺功臣之譏。"
  },
  {
    "id": "s0174",
    "blockIndex": 39,
    "zh": "及今未去，宜急表之！"
  },
  {
    "id": "s0175",
    "blockIndex": 39,
    "zh": "倀曰：「今詔指方怒，吾獨表此，必致罪譴。"
  },
  {
    "id": "s0176",
    "blockIndex": 39,
    "zh": "」舉曰：「明公年過八十，位為台輔，不於今時竭忠報國，惜身安，欲以何求！"
  },
  {
    "id": "s0177",
    "blockIndex": 39,
    "zh": "祿位雖全，必陷佞邪之機；"
  },
  {
    "id": "s0178",
    "blockIndex": 39,
    "zh": "諫而獲罪，猶有忠貞之名。"
  },
  {
    "id": "s0179",
    "blockIndex": 39,
    "zh": "若舉言不足采，請從此辭！"
  },
  {
    "id": "s0180",
    "blockIndex": 39,
    "zh": "」倀乃表諫，帝果從之。"
  },
  {
    "id": "s0181",
    "blockIndex": 39,
    "zh": "程徙封宜城侯，到國，怨恨恚懟，封還印綬、符策，亡歸京師，往來山中。"
  },
  {
    "id": "s0182",
    "blockIndex": 39,
    "zh": "詔書追求，復故爵土，賜車馬、衣物，遣還國。"
  },
  {
    "id": "s0183",
    "blockIndex": 40,
    "zh": "冬，十月，丁亥，司空陶敦免。"
  },
  {
    "id": "s0184",
    "blockIndex": 41,
    "zh": "朔方以西，障塞多壞，鮮卑因此數侵南匈奴；"
  },
  {
    "id": "s0185",
    "blockIndex": 41,
    "zh": "單于憂恐，上書乞修復障塞。"
  },
  {
    "id": "s0186",
    "blockIndex": 41,
    "zh": "庚寅，詔：「黎陽營兵出屯中山北界；"
  },
  {
    "id": "s0187",
    "blockIndex": 41,
    "zh": "令緣邊郡增置步兵，列屯塞下，教習戰射。"
  },
  {
    "id": "s0189",
    "blockIndex": 42,
    "zh": "以廷尉張皓為司空。"
  },
  {
    "id": "s0190",
    "blockIndex": 43,
    "zh": "班勇更立車師後部故王子加特奴為王。"
  },
  {
    "id": "s0191",
    "blockIndex": 43,
    "zh": "勇又使別校誅斬東且彌王，亦更立其種人為王；"
  },
  {
    "id": "s0192",
    "blockIndex": 43,
    "zh": "於是車師六國悉平。"
  },
  {
    "id": "s0193",
    "blockIndex": 43,
    "zh": "勇遂發諸國兵擊匈奴，呼銜王亡走，其眾二萬餘人皆降。"
  },
  {
    "id": "s0194",
    "blockIndex": 43,
    "zh": "生得單于人兄，勇使加特奴手斬之，以結車師、匈奴之隙。"
  },
  {
    "id": "s0195",
    "blockIndex": 43,
    "zh": "北單于自將萬餘騎入後部，至金且谷；"
  },
  {
    "id": "s0196",
    "blockIndex": 43,
    "zh": "勇使假司馬曹俊救之，單于引去，俊追斬其貴人骨都侯。"
  },
  {
    "id": "s0197",
    "blockIndex": 43,
    "zh": "於是呼衍王遂徙居枯梧河上，是後車師無復虜跡。"
  },
  {
    "id": "s0198",
    "blockIndex": 44,
    "zh": "春，正月，中郎將張國以南單于兵擊鮮卑其至鞬，破之。"
  },
  {
    "id": "s0199",
    "blockIndex": 44,
    "zh": "二月，遼東鮮卑寇遼東玄菟；"
  },
  {
    "id": "s0200",
    "blockIndex": 44,
    "zh": "烏桓校尉耿曄發緣邊諸郡兵及烏桓出塞擊之，斬獲甚眾；"
  },
  {
    "id": "s0201",
    "blockIndex": 44,
    "zh": "鮮卑三萬人詣遼東降。"
  },
  {
    "id": "s0202",
    "blockIndex": 45,
    "zh": "三月，旱。"
  },
  {
    "id": "s0203",
    "blockIndex": 46,
    "zh": "初，帝母李氏瘞在洛陽北，帝初不知；"
  },
  {
    "id": "s0204",
    "blockIndex": 46,
    "zh": "至是，左右白之，帝乃發哀，親到瘞所，更以禮殯。"
  },
  {
    "id": "s0205",
    "blockIndex": 46,
    "zh": "六月，乙酉，追謚為恭愍皇后，葬於恭陵之北。"
  },
  {
    "id": "s0206",
    "blockIndex": 47,
    "zh": "西域城郭諸國皆服於漢，唯焉耆王元孟未降，班勇奏請攻之。"
  },
  {
    "id": "s0207",
    "blockIndex": 47,
    "zh": "於是遣敦煌太守張朗將河西四郡兵三千人配勇，因發諸國兵四萬餘人分為兩道擊之。"
  },
  {
    "id": "s0208",
    "blockIndex": 47,
    "zh": "勇從南道，朗從北道，約期俱至焉耆。"
  },
  {
    "id": "s0209",
    "blockIndex": 47,
    "zh": "而朗先有罪，欲徼功自贖，遂先期至爵離關，遣司馬將兵前戰，獲首虜二千餘人，元孟懼誅，逆遣使乞降。"
  },
  {
    "id": "s0210",
    "blockIndex": 47,
    "zh": "張朗徑入焉耆，受降而還。"
  },
  {
    "id": "s0211",
    "blockIndex": 47,
    "zh": "朗得免誅，勇以後期徵，下獄，免。"
  },
  {
    "id": "s0212",
    "blockIndex": 48,
    "zh": "秋，七月，甲戌朔，日有食之。"
  },
  {
    "id": "s0213",
    "blockIndex": 49,
    "zh": "壬午，太尉朱寵、司徒朱倀免。"
  },
  {
    "id": "s0214",
    "blockIndex": 49,
    "zh": "庚子，以太常劉光為太尉、錄尚書事，光祿勳汝南許敬為司徒。"
  },
  {
    "id": "s0215",
    "blockIndex": 49,
    "zh": "光，矩之弟也。"
  },
  {
    "id": "s0216",
    "blockIndex": 49,
    "zh": "敬仕於和、安之間，當竇、鄧、閻氏之盛，無所屈撓；"
  },
  {
    "id": "s0217",
    "blockIndex": 49,
    "zh": "三家既敗，士大夫多染污者，獨無謗言及於敬，當世以此貴之。"
  },
  {
    "id": "s0218",
    "blockIndex": 50,
    "zh": "初，南陽樊英，少有學行，名著海內，陷於壺山之陽，州郡前後禮請，不應；"
  },
  {
    "id": "s0219",
    "blockIndex": 50,
    "zh": "公卿舉賢良、方正、有道，皆不行；"
  },
  {
    "id": "s0220",
    "blockIndex": 50,
    "zh": "安帝賜策書徵之，不赴。"
  },
  {
    "id": "s0221",
    "blockIndex": 50,
    "zh": "是歲，帝復以策書、玄纁，備禮徵英，英固辭疾篤。"
  },
  {
    "id": "s0222",
    "blockIndex": 50,
    "zh": "詔切責郡縣，駕載上道。"
  },
  {
    "id": "s0223",
    "blockIndex": 50,
    "zh": "英不得已，到京，稱疾不肯起；"
  },
  {
    "id": "s0224",
    "blockIndex": 50,
    "zh": "強輿入殿，猶不能屈。"
  },
  {
    "id": "s0225",
    "blockIndex": 50,
    "zh": "帝使出就太醫養疾，月致羊酒。"
  },
  {
    "id": "s0226",
    "blockIndex": 50,
    "zh": "其後帝乃為英設壇，令公車令導，尚書奉引，賜幾、杖，待以師傅之禮，延問得失，拜五官中郎將。"
  },
  {
    "id": "s0227",
    "blockIndex": 50,
    "zh": "數月，英稱疾篤；"
  },
  {
    "id": "s0228",
    "blockIndex": 50,
    "zh": "詔以為光祿大夫，賜告歸，令在所送谷，以歲時致牛酒。"
  },
  {
    "id": "s0229",
    "blockIndex": 50,
    "zh": "英辭位不受，有詔譬旨，勿聽。"
  },
  {
    "id": "s0230",
    "blockIndex": 50,
    "zh": "英初被詔命，眾皆以為必不降志。"
  },
  {
    "id": "s0231",
    "blockIndex": 50,
    "zh": "南郡王逸素與英善，因與其書，多引古譬諭，勸使就聘。"
  },
  {
    "id": "s0232",
    "blockIndex": 50,
    "zh": "英順逸議而至；"
  },
  {
    "id": "s0233",
    "blockIndex": 50,
    "zh": "及後應對無奇謀深策，談者以為失望。"
  },
  {
    "id": "s0234",
    "blockIndex": 50,
    "zh": "河南張楷與英俱徵，謂英曰：「天下有二道，出與處也。"
  },
  {
    "id": "s0235",
    "blockIndex": 50,
    "zh": "吾前以子之出，能輔是君也，濟斯民也。"
  },
  {
    "id": "s0236",
    "blockIndex": 50,
    "zh": "而子始以不訾之身，怒萬乘之主，及其享受爵祿，又不聞匡救之術，進退無所據矣。"
  },
  {
    "id": "s0238",
    "blockIndex": 51,
    "zh": "臣光曰：古之君子，邦有道則仕，邦無道則隱。"
  },
  {
    "id": "s0239",
    "blockIndex": 51,
    "zh": "隱非君子之所欲也。"
  },
  {
    "id": "s0240",
    "blockIndex": 51,
    "zh": "人莫己知而道不得行，群邪共處而害將及身，故深藏以避之。"
  },
  {
    "id": "s0241",
    "blockIndex": 51,
    "zh": "王者舉逸民，揚仄陋，固為其有益於國家，非以徇世俗之耳目也。"
  },
  {
    "id": "s0242",
    "blockIndex": 51,
    "zh": "是故有道德足以尊主，智能足以庇民，被褐懷玉，深藏不市，則王者當盡禮以致之，屈體以下之，虛心以訪之，克己以從之，然後能利澤施於四表，功烈格於上下。"
  },
  {
    "id": "s0243",
    "blockIndex": 51,
    "zh": "蓋取其道不取其人，務其實不務其名也。"
  },
  {
    "id": "s0244",
    "blockIndex": 52,
    "zh": "其或禮備而不至，意勤而不起，則姑內自循省而不敢強致其人，曰：豈吾德之薄而不足慕乎？"
  },
  {
    "id": "s0245",
    "blockIndex": 52,
    "zh": "政之亂而不可輔乎？"
  },
  {
    "id": "s0246",
    "blockIndex": 52,
    "zh": "群小在朝而不敢進乎？"
  },
  {
    "id": "s0247",
    "blockIndex": 52,
    "zh": "誠心不至而憂其言之不用乎？"
  },
  {
    "id": "s0248",
    "blockIndex": 52,
    "zh": "何賢者之不我從也？"
  },
  {
    "id": "s0249",
    "blockIndex": 52,
    "zh": "苟其德已厚矣，政已治矣，群小遠矣，誠心至矣，彼將扣閽以自售，又安有勤求而不至者哉！"
  },
  {
    "id": "s0250",
    "blockIndex": 52,
    "zh": "荀子曰：「耀蟬者，務在明其火，振其木而已；"
  },
  {
    "id": "s0251",
    "blockIndex": 52,
    "zh": "火不明，雖振其木，無益也。"
  },
  {
    "id": "s0252",
    "blockIndex": 52,
    "zh": "今人主有能明其德，則天下歸之，若蟬之歸明火也。"
  },
  {
    "id": "s0253",
    "blockIndex": 52,
    "zh": "」或者人主恥不能致，乃至誘之以高位，脅之以嚴刑。"
  },
  {
    "id": "s0254",
    "blockIndex": 52,
    "zh": "使彼誠君子邪，則位非所貪，刑非所畏，終不可得而致也；"
  },
  {
    "id": "s0255",
    "blockIndex": 52,
    "zh": "可致者，皆貪位畏刑之人也，烏足貴哉！"
  },
  {
    "id": "s0256",
    "blockIndex": 52,
    "zh": "若乃孝弟著於家庭，行誼隆於鄉曲，利不苟取，仕不苟進，潔己安分，優遊卒歲，雖不足以尊主庇民，是亦清修之吉士也。"
  },
  {
    "id": "s0257",
    "blockIndex": 52,
    "zh": "王者當褒優安養，俾遂其志。"
  },
  {
    "id": "s0258",
    "blockIndex": 52,
    "zh": "若孝昭之待韓福，光武之遇周黨，以勵廉恥，美風俗，斯亦可矣，固不當如范升之詆毀，又不可如張楷之責望也。"
  },
  {
    "id": "s0259",
    "blockIndex": 52,
    "zh": "至於飾偽以邀譽，釣奇以驚俗，不食君祿而爭屠沽之利，不受小官而規卿相之位，名與實反，心與跡違，斯乃華士、少正卯之流，其得免於聖王之誅幸矣，尚何聘召之有哉！"
  },
  {
    "id": "s0260",
    "blockIndex": 53,
    "zh": "時又徵廣漢楊厚、江夏黃瓊。"
  },
  {
    "id": "s0261",
    "blockIndex": 53,
    "zh": "瓊，香之子也。"
  },
  {
    "id": "s0262",
    "blockIndex": 53,
    "zh": "厚既至，豫陳漢有三百五十年之厄以為戒，拜議郎。"
  },
  {
    "id": "s0263",
    "blockIndex": 53,
    "zh": "瓊將至，李固以書逆遺之曰：「君子謂伯夷隘，柳下惠不恭。"
  },
  {
    "id": "s0264",
    "blockIndex": 53,
    "zh": "不夷不惠，可否之間，聖賢居身之所珍也。"
  },
  {
    "id": "s0265",
    "blockIndex": 53,
    "zh": "誠遂欲枕山棲谷，擬跡巢、由，斯則可矣；"
  },
  {
    "id": "s0266",
    "blockIndex": 53,
    "zh": "若當輔政濟民，今其時也。"
  },
  {
    "id": "s0267",
    "blockIndex": 53,
    "zh": "自生民以來，善政少而亂俗多，必待堯、舜之君，此為士行其志終無時矣。"
  },
  {
    "id": "s0268",
    "blockIndex": 53,
    "zh": "常聞語曰：『嶢嶢者易缺，皦皦者易污。"
  },
  {
    "id": "s0269",
    "blockIndex": 53,
    "zh": "』盛名之下，其實難副。"
  },
  {
    "id": "s0270",
    "blockIndex": 53,
    "zh": "近魯陽樊君被徵，初至，朝廷設壇席，猶待神明，雖無大異，而言行所守，亦無所缺；"
  },
  {
    "id": "s0271",
    "blockIndex": 53,
    "zh": "而毀謗布流，應時折減者，豈非觀聽望深，聲名太盛乎！"
  },
  {
    "id": "s0272",
    "blockIndex": 53,
    "zh": "是故俗論皆言『處士純盜虛聲』。"
  },
  {
    "id": "s0273",
    "blockIndex": 53,
    "zh": "願先生弘此遠謨，令眾人歎服，一雪此言耳！"
  },
  {
    "id": "s0274",
    "blockIndex": 53,
    "zh": "」瓊至，拜議郎，稍遷尚書僕射。"
  },
  {
    "id": "s0275",
    "blockIndex": 53,
    "zh": "瓊昔隨父在台閣，習見故事；"
  },
  {
    "id": "s0276",
    "blockIndex": 53,
    "zh": "及後居職，達練官曹，爭議朝堂，莫能抗奪。"
  },
  {
    "id": "s0277",
    "blockIndex": 53,
    "zh": "數上疏言事，上頗採用之。"
  },
  {
    "id": "s0278",
    "blockIndex": 54,
    "zh": "李固，郃之子，少好學，常改易姓名，杖策驅驢，負笈從師，不遠千里，遂究覽墳籍，為世大儒。"
  },
  {
    "id": "s0279",
    "blockIndex": 54,
    "zh": "每到太學，密入公府，定省父母，不令同業諸生知其為郃子也。"
  },
  {
    "id": "s0280",
    "blockIndex": 55,
    "zh": "春，正月，丙子，京師地震。"
  },
  {
    "id": "s0281",
    "blockIndex": 56,
    "zh": "夏，六月，旱。"
  },
  {
    "id": "s0282",
    "blockIndex": 57,
    "zh": "秋，七月，丁酉，茂陵園寢災。"
  },
  {
    "id": "s0283",
    "blockIndex": 58,
    "zh": "九月，鮮卑寇漁陽。"
  },
  {
    "id": "s0284",
    "blockIndex": 59,
    "zh": "冬，十二月，己亥，太傅桓焉免。"
  },
  {
    "id": "s0285",
    "blockIndex": 59,
    "zh": "車騎將軍來歷罷。"
  },
  {
    "id": "s0286",
    "blockIndex": 60,
    "zh": "南單于拔死，弟休利立，為去特若屍逐就單于。"
  },
  {
    "id": "s0287",
    "blockIndex": 61,
    "zh": "帝悉召孫程等還京師。"
  },
  {
    "id": "s0288",
    "blockIndex": 62,
    "zh": "春，正月，丙寅，赦天下。"
  },
  {
    "id": "s0289",
    "blockIndex": 63,
    "zh": "丙子，帝加元服。"
  },
  {
    "id": "s0290",
    "blockIndex": 64,
    "zh": "夏，五月，壬辰，詔曰：「海內頗有災異，朝廷修政，太官減膳，珍玩不御。"
  },
  {
    "id": "s0291",
    "blockIndex": 64,
    "zh": "而桂陽太守文礱，不惟竭忠宣暢本朝，而遠獻大珠以求幸媚，今封以還之！"
  },
  {
    "id": "s0293",
    "blockIndex": 65,
    "zh": "五州雨水。"
  },
  {
    "id": "s0294",
    "blockIndex": 66,
    "zh": "秋，八月，丁巳，太尉劉光、司空張皓免。"
  },
  {
    "id": "s0295",
    "blockIndex": 67,
    "zh": "尚書偵射虞詡上言：「安定、北地、上郡，山川險厄，沃野千里，土宜畜牧，水可溉漕。"
  },
  {
    "id": "s0296",
    "blockIndex": 67,
    "zh": "頃遭元元之災，眾羌內潰，郡縣兵荒，二十餘年。"
  },
  {
    "id": "s0297",
    "blockIndex": 67,
    "zh": "夫棄沃壤之饒，捐自然之財，不可謂利；"
  },
  {
    "id": "s0298",
    "blockIndex": 67,
    "zh": "離河山之阻，守無險之處，難以為固。"
  },
  {
    "id": "s0299",
    "blockIndex": 67,
    "zh": "今三郡未復，園陵單外，而公卿選懦，容頭過身，張解設難，但計所費，不圖其安。"
  },
  {
    "id": "s0300",
    "blockIndex": 67,
    "zh": "宜開聖聽，考行所長。"
  },
  {
    "id": "s0301",
    "blockIndex": 67,
    "zh": "」九月，詔復安定、北地、上郡歸舊土。"
  },
  {
    "id": "s0302",
    "blockIndex": 68,
    "zh": "癸酉，以大鴻臚龐參為太尉、錄尚書事。"
  },
  {
    "id": "s0303",
    "blockIndex": 68,
    "zh": "太常王龔為司空。"
  },
  {
    "id": "s0304",
    "blockIndex": 69,
    "zh": "冬，十一月，庚辰，司徒許敬免。"
  },
  {
    "id": "s0305",
    "blockIndex": 70,
    "zh": "鮮卑寇朔方。"
  },
  {
    "id": "s0306",
    "blockIndex": 71,
    "zh": "十二月，巳卯，以宗正弘農劉崎為司徒。"
  },
  {
    "id": "s0307",
    "blockIndex": 72,
    "zh": "是歲，於窴王放前殺拘彌王興，自立其子為拘彌王，而遣使者貢獻，敦煌太守徐由上求討之。"
  },
  {
    "id": "s0308",
    "blockIndex": 72,
    "zh": "帝赦於窴罪，令歸拘彌國；"
  },
  {
    "id": "s0309",
    "blockIndex": 72,
    "zh": "放前不肯。"
  },
  {
    "id": "s0310",
    "blockIndex": 73,
    "zh": "夏，四月，京師旱。"
  },
  {
    "id": "s0311",
    "blockIndex": 74,
    "zh": "京師及郡國十二蝗。"
  },
  {
    "id": "s0312",
    "blockIndex": 75,
    "zh": "定遠侯班超之孫始尚帝姑陰城公主。"
  },
  {
    "id": "s0313",
    "blockIndex": 75,
    "zh": "主驕淫無道；"
  },
  {
    "id": "s0314",
    "blockIndex": 75,
    "zh": "始積忿怒，伏刃殺主。"
  },
  {
    "id": "s0315",
    "blockIndex": 75,
    "zh": "冬，十月，乙亥，始坐腰斬，同產皆棄市。"
  },
  {
    "id": "s0316",
    "blockIndex": 76,
    "zh": "春，二月，庚午，河間孝王開薨；"
  },
  {
    "id": "s0317",
    "blockIndex": 76,
    "zh": "子政嗣。"
  },
  {
    "id": "s0318",
    "blockIndex": 76,
    "zh": "政傲很不奉法，帝以侍御史吳郡沈景有強能，擢為河間相。"
  },
  {
    "id": "s0319",
    "blockIndex": 76,
    "zh": "景到國，謁王，王不正服，箕踞殿上；"
  },
  {
    "id": "s0320",
    "blockIndex": 76,
    "zh": "侍郎贊拜，景峙不為禮，問王所在。"
  },
  {
    "id": "s0321",
    "blockIndex": 76,
    "zh": "虎賁曰：「是非王邪！"
  },
  {
    "id": "s0322",
    "blockIndex": 76,
    "zh": "」景曰：「王不正服，常人何別！"
  },
  {
    "id": "s0323",
    "blockIndex": 76,
    "zh": "今相謁王，豈謁無禮者邪！"
  },
  {
    "id": "s0324",
    "blockIndex": 76,
    "zh": "」王慚而更服，景然後拜；"
  },
  {
    "id": "s0325",
    "blockIndex": 76,
    "zh": "出，住宮門外，請王傅責之曰：「前發京師，陛見受詔，以王不恭，使相檢督。"
  },
  {
    "id": "s0326",
    "blockIndex": 76,
    "zh": "諸君空受爵祿，曾無訓導之義！"
  },
  {
    "id": "s0327",
    "blockIndex": 76,
    "zh": "」因奏治其罪，詔書讓政而詰責傅。"
  },
  {
    "id": "s0328",
    "blockIndex": 76,
    "zh": "景因捕諸奸人，奏案其罪，殺戮尤惡者數十人，出冤獄百餘人。"
  },
  {
    "id": "s0329",
    "blockIndex": 76,
    "zh": "政遂為改節，悔過自修。"
  },
  {
    "id": "s0330",
    "blockIndex": 77,
    "zh": "帝以伊吾膏腴之地，傍近西域，匈奴資之以為鈔暴；"
  },
  {
    "id": "s0331",
    "blockIndex": 77,
    "zh": "三月，辛亥，復令開設屯田，如永元時事，置伊吾司馬一人。"
  },
  {
    "id": "s0332",
    "blockIndex": 78,
    "zh": "初，安帝薄於藝文，博士不復講習，朋徒相視怠散，學舍頹敝，鞠為園蔬，或牧兒、蕘豎薪刈其下。"
  },
  {
    "id": "s0333",
    "blockIndex": 78,
    "zh": "將作大匠翟酺上疏請更修繕，誘進後學，帝從之。"
  },
  {
    "id": "s0334",
    "blockIndex": 78,
    "zh": "秋，九月，繕起太學，凡所造構二百四十房，千八百五十室。"
  },
  {
    "id": "s0335",
    "blockIndex": 79,
    "zh": "護烏桓校尉耿曄遣兵擊鮮卑，破之。"
  },
  {
    "id": "s0336",
    "blockIndex": 80,
    "zh": "護羌校尉韓皓轉湟中屯田置兩河間，以逼群羌。"
  },
  {
    "id": "s0337",
    "blockIndex": 80,
    "zh": "皓坐事徵，以張掖太守馬續代為校尉。"
  },
  {
    "id": "s0338",
    "blockIndex": 80,
    "zh": "兩河間羌以屯田近之，恐必見圖，乃解仇詛盟，各自儆備；"
  },
  {
    "id": "s0339",
    "blockIndex": 80,
    "zh": "續上移屯田還湟中，羌意乃安。"
  },
  {
    "id": "s0340",
    "blockIndex": 81,
    "zh": "帝欲立皇后，而貴人有寵者四人，莫知所建，議欲探籌，以神定選。"
  },
  {
    "id": "s0341",
    "blockIndex": 81,
    "zh": "尚書僕射南郡胡廣與尚書馮翊郭虔、史敞上疏諫曰：「竊見詔書，以立後事大，謙大自專，欲假之籌策，決疑靈神；"
  },
  {
    "id": "s0342",
    "blockIndex": 81,
    "zh": "篇籍所記，祖宗典故，未嘗有也。"
  },
  {
    "id": "s0343",
    "blockIndex": 81,
    "zh": "恃神任筮，既不必當賢；"
  },
  {
    "id": "s0344",
    "blockIndex": 81,
    "zh": "就值其人，猶非德選。"
  },
  {
    "id": "s0345",
    "blockIndex": 81,
    "zh": "夫歧嶷形於自然，俔天必有異表，宜參良家，簡求有德，德同以年，年鈞以貌；"
  },
  {
    "id": "s0346",
    "blockIndex": 81,
    "zh": "稽之典經，斷之聖慮。"
  },
  {
    "id": "s0347",
    "blockIndex": 81,
    "zh": "」帝從之。"
  },
  {
    "id": "s0348",
    "blockIndex": 81,
    "zh": "恭懷皇后弟子乘氏侯商之女，選入掖庭為貴人，常特被引御，從容辭曰：「夫陽以博施為德，陰以不專為義。"
  },
  {
    "id": "s0349",
    "blockIndex": 81,
    "zh": "《螽斯》則百福所由興也。"
  },
  {
    "id": "s0350",
    "blockIndex": 81,
    "zh": "願陛下思雲雨之均澤，小妾得免於罪。"
  },
  {
    "id": "s0351",
    "blockIndex": 81,
    "zh": "」帝由是賢之。"
  },
  {
    "id": "s0352",
    "blockIndex": 82,
    "zh": "春，正月，乙巳，立貴人梁氏為皇后。"
  },
  {
    "id": "s0353",
    "blockIndex": 83,
    "zh": "京師旱。"
  },
  {
    "id": "s0354",
    "blockIndex": 84,
    "zh": "三月，揚州六郡妖賊章河等寇四十九縣，殺傷長吏。"
  },
  {
    "id": "s0355",
    "blockIndex": 85,
    "zh": "庚寅，赦天下，改元。"
  },
  {
    "id": "s0356",
    "blockIndex": 86,
    "zh": "夏，四月，梁商加位特進；"
  },
  {
    "id": "s0357",
    "blockIndex": 86,
    "zh": "頃之，拜執金吾。"
  },
  {
    "id": "s0358",
    "blockIndex": 87,
    "zh": "冬，耿曄遣烏桓戎末魔等鈔擊鮮卑，大獲而還。"
  },
  {
    "id": "s0359",
    "blockIndex": 87,
    "zh": "鮮卑復寇遼東屬國，耿曄移屯遼東無慮城以拒之。"
  },
  {
    "id": "s0360",
    "blockIndex": 88,
    "zh": "尚書令左雄上疏曰：「昔宣帝以為吏數變易，則下不安業；"
  },
  {
    "id": "s0361",
    "blockIndex": 88,
    "zh": "久於其事，則民服教化。"
  },
  {
    "id": "s0362",
    "blockIndex": 88,
    "zh": "其有政治者，輒以璽書勉勵，增秩賜金，公卿缺則以次用之。"
  },
  {
    "id": "s0363",
    "blockIndex": 88,
    "zh": "是以吏稱其職，民安其業，漢世良吏，於茲為盛。"
  },
  {
    "id": "s0364",
    "blockIndex": 88,
    "zh": "今典城百里，轉動無常，各懷一切，莫慮長久。"
  },
  {
    "id": "s0365",
    "blockIndex": 88,
    "zh": "謂殺害不辜為威風，聚斂整辦為賢能；"
  },
  {
    "id": "s0366",
    "blockIndex": 88,
    "zh": "以治己安民為劣弱，奉法循理為不治。"
  },
  {
    "id": "s0367",
    "blockIndex": 88,
    "zh": "髡鉗之戮，生於睚眥；"
  },
  {
    "id": "s0368",
    "blockIndex": 88,
    "zh": "覆屍之禍，成於喜怒。"
  },
  {
    "id": "s0369",
    "blockIndex": 88,
    "zh": "視民如寇仇，稅之如豺虎。"
  },
  {
    "id": "s0370",
    "blockIndex": 88,
    "zh": "監司項背相望，與同疾疢，見非不舉，聞惡不察。"
  },
  {
    "id": "s0371",
    "blockIndex": 88,
    "zh": "觀政於亭傳，責成於期月；"
  },
  {
    "id": "s0372",
    "blockIndex": 88,
    "zh": "言善不稱德，論功不據實。"
  },
  {
    "id": "s0373",
    "blockIndex": 88,
    "zh": "虛誕者獲譽，拘檢者離毀；"
  },
  {
    "id": "s0374",
    "blockIndex": 88,
    "zh": "或因罪而引高，或色斯而求名，州宰不覆，競共辟召，踴躍升騰，超等逾匹。"
  },
  {
    "id": "s0375",
    "blockIndex": 88,
    "zh": "或考奏捕案，而亡不受罪，會赦行賂，復見洗滌，朱紫同色，清濁不分。"
  },
  {
    "id": "s0376",
    "blockIndex": 88,
    "zh": "故使奸猾枉濫，輕忽去就，拜除如流，缺動百數。"
  },
  {
    "id": "s0377",
    "blockIndex": 88,
    "zh": "鄉官、部吏，職賤祿薄，車馬衣服，一出於民，廉者取足，貪者充家；"
  },
  {
    "id": "s0378",
    "blockIndex": 88,
    "zh": "特選、橫調，紛紛不絕，送迎煩費，損政傷民。"
  },
  {
    "id": "s0379",
    "blockIndex": 88,
    "zh": "和氣未洽，災眚不消，咎皆在此。"
  },
  {
    "id": "s0380",
    "blockIndex": 88,
    "zh": "臣愚以為守相、長吏惠和有顯效者，可就增秩，勿移徙；"
  },
  {
    "id": "s0381",
    "blockIndex": 88,
    "zh": "非父母喪，不得去官。"
  },
  {
    "id": "s0382",
    "blockIndex": 88,
    "zh": "其不從法禁，不式王命，錮之終身，雖會赦令，不得齒列。"
  },
  {
    "id": "s0383",
    "blockIndex": 88,
    "zh": "若被劾奏，亡不就法者，徙家邊郡，以懲其後。"
  },
  {
    "id": "s0384",
    "blockIndex": 88,
    "zh": "其鄉部親民之吏，皆用儒生清白任從政者，寬其負算，增其秩祿；"
  },
  {
    "id": "s0385",
    "blockIndex": 88,
    "zh": "吏職滿歲，宰府州郡乃得辟舉。"
  },
  {
    "id": "s0386",
    "blockIndex": 88,
    "zh": "如此，威福之路塞，虛偽之端絕，送迎之役損，賦斂之源息，循理之吏得成其化，率土之民各寧其所矣。"
  },
  {
    "id": "s0387",
    "blockIndex": 88,
    "zh": "」帝感其言，復申無故去官之禁，又下有司考吏治真偽，詳所施行；"
  },
  {
    "id": "s0388",
    "blockIndex": 88,
    "zh": "而宦官不便，終不能行。"
  },
  {
    "id": "s0389",
    "blockIndex": 89,
    "zh": "雄又上言：「孔子曰：『四十不惑』，《禮》稱強仕。"
  },
  {
    "id": "s0390",
    "blockIndex": 89,
    "zh": "請自今，孝廉年不滿四十，不得察舉，皆先詣公府，諸生試家法，文吏課箋奏，副之端門，練其虛實，以觀異能，以美風俗。"
  },
  {
    "id": "s0391",
    "blockIndex": 89,
    "zh": "有不承科令者，正其罪法。"
  },
  {
    "id": "s0392",
    "blockIndex": 89,
    "zh": "若有茂材異行，自可不拘年齒。"
  },
  {
    "id": "s0393",
    "blockIndex": 89,
    "zh": "」帝從之。"
  },
  {
    "id": "s0394",
    "blockIndex": 89,
    "zh": "胡廣、郭虔、史敞上書駁之曰：「凡選舉因才，無拘定制。"
  },
  {
    "id": "s0395",
    "blockIndex": 89,
    "zh": "六奇之策，不出經學；"
  },
  {
    "id": "s0396",
    "blockIndex": 89,
    "zh": "鄭、阿之政，非必章奏；"
  },
  {
    "id": "s0397",
    "blockIndex": 89,
    "zh": "甘、奇顯用，年乖強仁；"
  },
  {
    "id": "s0398",
    "blockIndex": 89,
    "zh": "終、賈揚聲，亦在弱冠。"
  },
  {
    "id": "s0399",
    "blockIndex": 89,
    "zh": "前世以來，貢舉之制，莫或回革。"
  },
  {
    "id": "s0400",
    "blockIndex": 89,
    "zh": "今以一臣之言，剷戾舊章，便利未明，眾心不厭。"
  },
  {
    "id": "s0401",
    "blockIndex": 89,
    "zh": "矯枉變常，政之所重，而不訪台司，不謀卿士，若事下之後，議者剝異，異之則朝失其便，同之則王言已行。"
  },
  {
    "id": "s0402",
    "blockIndex": 89,
    "zh": "臣愚以為可宣下百官，參其同異，然後覽擇勝否，詳采厥衷。"
  },
  {
    "id": "s0403",
    "blockIndex": 89,
    "zh": "」帝不從。"
  },
  {
    "id": "s0404",
    "blockIndex": 90,
    "zh": "辛卯，初令「郡國舉孝廉，限年四十以上；"
  },
  {
    "id": "s0405",
    "blockIndex": 90,
    "zh": "諸生通章句，文吏能箋奏，乃得應選。"
  },
  {
    "id": "s0406",
    "blockIndex": 90,
    "zh": "其有茂才異行，若顏淵、子奇，不拘年齒。"
  },
  {
    "id": "s0407",
    "blockIndex": 90,
    "zh": "」久之，廣陵所舉孝廉徐淑，年未四十。"
  },
  {
    "id": "s0408",
    "blockIndex": 90,
    "zh": "台郎詰之，對曰：「詔書曰：『有如顏回、子奇，不拘年齒。"
  },
  {
    "id": "s0409",
    "blockIndex": 90,
    "zh": "』是故本郡以臣充選。"
  },
  {
    "id": "s0410",
    "blockIndex": 90,
    "zh": "」郎不能屈。"
  },
  {
    "id": "s0411",
    "blockIndex": 90,
    "zh": "左雄詰之曰：「昔顏回聞一知十，孝廉聞一知幾邪？"
  },
  {
    "id": "s0412",
    "blockIndex": 90,
    "zh": "」淑無以對，乃罷卻之。"
  },
  {
    "id": "s0413",
    "blockIndex": 90,
    "zh": "郡守坐免。"
  },
  {
    "id": "s0414",
    "blockIndex": 91,
    "zh": "袁宏論曰：夫謀事作制，以經世訓物，必使可為也。"
  },
  {
    "id": "s0415",
    "blockIndex": 91,
    "zh": "古者四十而仕，非謂彈冠之會必將是年也。"
  },
  {
    "id": "s0416",
    "blockIndex": 91,
    "zh": "以為可事之時在於強盛，故舉其大限以為民衷。"
  },
  {
    "id": "s0417",
    "blockIndex": 91,
    "zh": "且顏淵、子奇，曠代一有，而欲以斯為格，豈不偏乎！"
  },
  {
    "id": "s0418",
    "blockIndex": 91,
    "zh": "然雄公直精明，能審核真偽，決志行之。"
  },
  {
    "id": "s0419",
    "blockIndex": 91,
    "zh": "頃之，胡廣出為濟陰太守，與諸郡守十餘人皆坐謬舉免黜；"
  },
  {
    "id": "s0420",
    "blockIndex": 91,
    "zh": "唯汝南陳蕃、穎川李膺、下邳陳球等三十餘人得拜郎中。"
  },
  {
    "id": "s0421",
    "blockIndex": 91,
    "zh": "自是牧、守畏栗，莫敢輕舉。"
  },
  {
    "id": "s0422",
    "blockIndex": 91,
    "zh": "迄於永嘉，察選清平，多得其人。"
  },
  {
    "id": "s0423",
    "blockIndex": 92,
    "zh": "閏月，庚子，恭陵百丈廡災。"
  },
  {
    "id": "s0424",
    "blockIndex": 93,
    "zh": "上聞北海郎顗精於陰陽之學。"
  },
  {
    "id": "s0425",
    "blockIndex": 94,
    "zh": "春，正月，詔公車徵顗，問以災異。"
  },
  {
    "id": "s0426",
    "blockIndex": 94,
    "zh": "顗上章曰：「三公上應臺階，不同元首，政失其道，則寒陰反節。"
  },
  {
    "id": "s0427",
    "blockIndex": 94,
    "zh": "今之在位，競托高虛，納累鐘之奉，亡天下之憂。"
  },
  {
    "id": "s0428",
    "blockIndex": 94,
    "zh": "棲遲偃仰，寢疾自逸，被策文，得賜錢，即復起矣，何疾之易而愈之速！"
  },
  {
    "id": "s0429",
    "blockIndex": 94,
    "zh": "以此消伏災眚，興致昇平，其可得乎！"
  },
  {
    "id": "s0430",
    "blockIndex": 94,
    "zh": "今選牧、守，委任三府；"
  },
  {
    "id": "s0431",
    "blockIndex": 94,
    "zh": "長吏不良，既咎州、郡，州、郡有失，豈得不歸責舉者！"
  },
  {
    "id": "s0432",
    "blockIndex": 94,
    "zh": "而陛下崇之彌優，自下慢事愈甚，所謂『大網疏，小網數』。"
  },
  {
    "id": "s0433",
    "blockIndex": 94,
    "zh": "三公非臣之仇，臣非狂夫之作，所以發憤忘食，懇懇不已者，誠念朝廷欲致興平。"
  },
  {
    "id": "s0434",
    "blockIndex": 94,
    "zh": "臣書不擇言，死不敢恨！"
  },
  {
    "id": "s0435",
    "blockIndex": 94,
    "zh": "」因條便宜七事：「一，園陵火災，宜念百姓之勞，罷繕修之役。"
  },
  {
    "id": "s0436",
    "blockIndex": 94,
    "zh": "二，立春以後陰寒失節，宜採納良臣，以助聖化。"
  },
  {
    "id": "s0437",
    "blockIndex": 94,
    "zh": "三，今年少陽之歲，春當旱，夏必有水，宜遵前典，惟節惟約。"
  },
  {
    "id": "s0438",
    "blockIndex": 94,
    "zh": "四，去年八月，熒惑出入軒轅，宜簡出宮女，恣其姻嫁。"
  },
  {
    "id": "s0439",
    "blockIndex": 94,
    "zh": "五，去年閏十月，有白氣從西方天苑趨參左足，入玉井，恐立秋以後，將有羌寇畔戾之患，宜豫宣告諸郡，嚴為備御。"
  },
  {
    "id": "s0440",
    "blockIndex": 94,
    "zh": "六，今月十四日乙卯，白虹貫日，宜令中外官司，並須立秋然後考事。"
  },
  {
    "id": "s0441",
    "blockIndex": 94,
    "zh": "七，漢興以來三百三十九歲，於詩三期，宜大蠲法令，有所變更。"
  },
  {
    "id": "s0442",
    "blockIndex": 94,
    "zh": "王者隨天，譬猶自春徂夏，改青服絳也。"
  },
  {
    "id": "s0443",
    "blockIndex": 94,
    "zh": "自文帝省刑，適三百年，而輕微之禁，漸已殷積。"
  },
  {
    "id": "s0444",
    "blockIndex": 94,
    "zh": "王者之法，譬猶江、河，當使易避而難犯也。"
  },
  {
    "id": "s0446",
    "blockIndex": 95,
    "zh": "二月，顗復上書薦黃瓊、李固，以為宜加擢用。"
  },
  {
    "id": "s0447",
    "blockIndex": 95,
    "zh": "又言：「自冬涉春，訖無嘉澤，數有西風，反逆時節，朝廷勞心，廣為禱祈，薦祭山川，暴龍移市。"
  },
  {
    "id": "s0448",
    "blockIndex": 95,
    "zh": "臣聞皇天感物，不為偽動；"
  },
  {
    "id": "s0449",
    "blockIndex": 95,
    "zh": "災變應人，要在責己。"
  },
  {
    "id": "s0450",
    "blockIndex": 95,
    "zh": "若令雨可請降，水可攘止，則歲無隔並，太平可待。"
  },
  {
    "id": "s0451",
    "blockIndex": 95,
    "zh": "然而災害不息者，患不在此也。"
  },
  {
    "id": "s0452",
    "blockIndex": 95,
    "zh": "」書奏，特拜郎中；"
  },
  {
    "id": "s0453",
    "blockIndex": 95,
    "zh": "辭病不就。"
  },
  {
    "id": "s0454",
    "blockIndex": 96,
    "zh": "三月，使匈奴中郎將趙稠遣從事將南匈奴兵出塞擊鮮卑，破之。"
  },
  {
    "id": "s0455",
    "blockIndex": 97,
    "zh": "初，帝之立也，乳母宋娥與其謀，帝封娥為山陽君，又封執金吾梁商子冀為襄邑侯。"
  },
  {
    "id": "s0456",
    "blockIndex": 97,
    "zh": "尚書令左雄上封事曰：「高皇帝約，非劉氏不王，非有功不侯。"
  },
  {
    "id": "s0457",
    "blockIndex": 97,
    "zh": "孝安皇帝封江京、王聖等，遂致地震之異。"
  },
  {
    "id": "s0458",
    "blockIndex": 97,
    "zh": "永建二年封陰謀之功，又有日食之變。"
  },
  {
    "id": "s0459",
    "blockIndex": 97,
    "zh": "數術之士，咸歸咎於封爵。"
  },
  {
    "id": "s0460",
    "blockIndex": 97,
    "zh": "今青州饑虛，盜賊未息，誠不宜追尋小恩，虧失大典。"
  },
  {
    "id": "s0461",
    "blockIndex": 97,
    "zh": "」詔不聽。"
  },
  {
    "id": "s0462",
    "blockIndex": 97,
    "zh": "雄復諫曰：「臣聞人君莫不好忠正而惡讒諛，然而歷世之患，莫不以忠正得罪，讒諛蒙幸者，蓋聽忠難，從諛易也。"
  },
  {
    "id": "s0463",
    "blockIndex": 97,
    "zh": "夫刑罪，人情之所甚惡，貴寵，人情之所甚欲，是以時俗為忠者少而習諛者多。"
  },
  {
    "id": "s0464",
    "blockIndex": 97,
    "zh": "故令人主數聞其美，稀知其過，迷而不悟，以至於危亡。"
  },
  {
    "id": "s0465",
    "blockIndex": 97,
    "zh": "臣伏見詔書，顧念阿母舊德宿恩，欲特加顯賞。"
  },
  {
    "id": "s0466",
    "blockIndex": 97,
    "zh": "案尚書故事，無乳母爵邑之制，唯先帝時阿母王聖為野王君，聖造生讒賊廢立之禍，生為天下所咀嚼，死為海內所歡快。"
  },
  {
    "id": "s0467",
    "blockIndex": 97,
    "zh": "桀、紂貴為天子，而庸僕羞與為比者，以其無義也；"
  },
  {
    "id": "s0468",
    "blockIndex": 97,
    "zh": "夷、齊賤為匹夫，而王侯爭與為伍者，以其有德也。"
  },
  {
    "id": "s0469",
    "blockIndex": 97,
    "zh": "今阿母躬蹈儉約，以身率下，群僚蒸庶，莫不向風。"
  },
  {
    "id": "s0470",
    "blockIndex": 97,
    "zh": "而與王聖並同爵號，懼違本操，失其常願。"
  },
  {
    "id": "s0471",
    "blockIndex": 97,
    "zh": "臣愚以為凡人之心，理不相遠，其所不安，古今一也。"
  },
  {
    "id": "s0472",
    "blockIndex": 97,
    "zh": "百姓深懲王聖傾覆之禍，民萌之命危於累卵，常懼時世復有此類，怵惕之念未離於心，恐懼之言未絕乎口。"
  },
  {
    "id": "s0473",
    "blockIndex": 97,
    "zh": "乞如前議，歲以千萬給奉阿母，內足以盡恩愛之歡，外可不為吏民所怪。"
  },
  {
    "id": "s0474",
    "blockIndex": 97,
    "zh": "梁冀之封，事非機急，宜過災顧之運，然後平議可否。"
  },
  {
    "id": "s0475",
    "blockIndex": 97,
    "zh": "」於是冀父商讓還冀封；"
  },
  {
    "id": "s0476",
    "blockIndex": 97,
    "zh": "書十餘上，帝乃從之。"
  },
  {
    "id": "s0477",
    "blockIndex": 98,
    "zh": "夏，四月，己亥，京師地震。"
  },
  {
    "id": "s0478",
    "blockIndex": 98,
    "zh": "五月，庚子，詔群公、卿士各直言厥咎，仍各舉敦樸士一人。"
  },
  {
    "id": "s0479",
    "blockIndex": 98,
    "zh": "左雄復上疏曰：「先帝封野王君，漢陽地震，今封山陽君而京城復震，專政在陰，其災尤大。"
  },
  {
    "id": "s0480",
    "blockIndex": 98,
    "zh": "臣前後瞽言，封爵至重，王者可私人以財，不可以官，宜還阿母之封以塞災異。"
  },
  {
    "id": "s0481",
    "blockIndex": 98,
    "zh": "今冀已高讓，山陽君亦宜崇其本節。"
  },
  {
    "id": "s0482",
    "blockIndex": 98,
    "zh": "」雄言切至，娥亦畏懼辭讓。"
  },
  {
    "id": "s0483",
    "blockIndex": 98,
    "zh": "而帝戀戀不能已，卒封之。"
  },
  {
    "id": "s0484",
    "blockIndex": 98,
    "zh": "是時，大司農劉據以職事被譴，召詣尚書，傳呼促步，又加以捶撲。"
  },
  {
    "id": "s0485",
    "blockIndex": 98,
    "zh": "雄上言：「九卿位亞三事，班在大臣，行有佩玉之節，動有癢序之儀。"
  },
  {
    "id": "s0486",
    "blockIndex": 98,
    "zh": "孝明皇帝始有撲罰，皆非古典。"
  },
  {
    "id": "s0487",
    "blockIndex": 98,
    "zh": "」帝納之，是後九卿無復捶撲者。"
  },
  {
    "id": "s0488",
    "blockIndex": 99,
    "zh": "戊午，司空王龔免。"
  },
  {
    "id": "s0489",
    "blockIndex": 99,
    "zh": "六月，辛未，以太常魯國孔扶為司空。"
  },
  {
    "id": "s0490",
    "blockIndex": 100,
    "zh": "丁丑，洛陽宣德亭地坼，長八十五丈；"
  },
  {
    "id": "s0491",
    "blockIndex": 100,
    "zh": "帝引公卿所舉敦樸之士，使之對策，及特問以當世之敝，為政所宜。"
  },
  {
    "id": "s0492",
    "blockIndex": 100,
    "zh": "李固對曰：「前孝安皇帝變亂舊典，封爵阿母，因造妖孽，改亂嫡嗣，至令聖躬狼狽，親遇其艱。"
  },
  {
    "id": "s0493",
    "blockIndex": 100,
    "zh": "既拔自困殆，龍興即位，天下喁喁，屬望風政。"
  },
  {
    "id": "s0494",
    "blockIndex": 100,
    "zh": "積敝之後，易致中興，誠當沛然思惟善道，而論者猶云『方今之事，復同於前』。"
  },
  {
    "id": "s0495",
    "blockIndex": 100,
    "zh": "臣伏在草澤，痛心傷臆！"
  },
  {
    "id": "s0496",
    "blockIndex": 100,
    "zh": "實以漢興以來三百餘年，賢聖相繼十有八主，豈無阿乳之恩，豈忘貴爵之寵？"
  },
  {
    "id": "s0497",
    "blockIndex": 100,
    "zh": "然上畏天威，俯案經典，知義不可，故不封也。"
  },
  {
    "id": "s0498",
    "blockIndex": 100,
    "zh": "今宋阿母雖有大功、勤謹之德，但加賞賜，足以酬其勞苦；"
  },
  {
    "id": "s0499",
    "blockIndex": 100,
    "zh": "至於裂土開國，實乖舊典。"
  },
  {
    "id": "s0500",
    "blockIndex": 100,
    "zh": "聞阿母體性謙虛，必有遜讓，陛下宜許其辭國之高，使成萬安之福。"
  },
  {
    "id": "s0501",
    "blockIndex": 100,
    "zh": "夫妃、後之家所以少完全者，豈天性當然？"
  },
  {
    "id": "s0502",
    "blockIndex": 100,
    "zh": "但以爵位尊顯，顓總權柄，天道惡盈，不知自損，故致顛仆。"
  },
  {
    "id": "s0503",
    "blockIndex": 100,
    "zh": "先帝寵遇閻氏，位號太疾，故其受禍曾不旋時，《老子》曰：『其進銳者其退速也。"
  },
  {
    "id": "s0504",
    "blockIndex": 100,
    "zh": "』今梁氏戚為椒房，禮所不臣，尊以高爵，尚可然也；"
  },
  {
    "id": "s0505",
    "blockIndex": 100,
    "zh": "而子弟群從，榮顯兼加，永平、建初故事，殆不如此。"
  },
  {
    "id": "s0506",
    "blockIndex": 100,
    "zh": "宜令步兵校尉冀及諸侍中還居黃門之官，使權去外戚，政歸國家，豈不休乎！"
  },
  {
    "id": "s0507",
    "blockIndex": 100,
    "zh": "又，詔書所以禁侍中、尚書、中臣子弟不得為吏、察孝廉者，以其秉威權，容請托故也。"
  },
  {
    "id": "s0508",
    "blockIndex": 100,
    "zh": "而中常侍在日月之側，聲勢振天下，子弟祿任，曾無限極，雖外托謙默，不干州郡，而諂偽之徒，望風進舉。"
  },
  {
    "id": "s0509",
    "blockIndex": 100,
    "zh": "今可為設常禁，同之中臣。"
  },
  {
    "id": "s0510",
    "blockIndex": 100,
    "zh": "昔館陶公主為子求郎，明帝不許，賜錢千萬，所以輕厚賜，重薄位者，為官人失才，害及百姓也。"
  },
  {
    "id": "s0511",
    "blockIndex": 100,
    "zh": "竊聞長水司馬武宣、開陽城門候羊迪等，無它功德，初拜便真，此雖小失而漸壞舊章。"
  },
  {
    "id": "s0512",
    "blockIndex": 100,
    "zh": "先聖法度，所宜堅守，故政教一跌，百年不復。"
  },
  {
    "id": "s0513",
    "blockIndex": 100,
    "zh": "《詩》云：『上帝板板，下民卒癉』，刺周王變祖法度，故使下民將盡病也。"
  },
  {
    "id": "s0514",
    "blockIndex": 100,
    "zh": "今陛下之有尚書，猶天之有北斗也。"
  },
  {
    "id": "s0515",
    "blockIndex": 100,
    "zh": "斗為天喉舌，尚書亦為陛下喉舌。"
  },
  {
    "id": "s0516",
    "blockIndex": 100,
    "zh": "斗斟酌元氣，運乎四時；"
  },
  {
    "id": "s0517",
    "blockIndex": 100,
    "zh": "尚書出納王命，賦政四海，權尊勢重，責之所歸，若不平心，災眚必至，誠宜審擇其人，以毘聖政。"
  },
  {
    "id": "s0518",
    "blockIndex": 100,
    "zh": "今與陛下共天下者，外則公、卿、尚書，內則常侍、黃門，譬猶一門之內，一家之事，安則共其福慶，危則通其禍敗。"
  },
  {
    "id": "s0519",
    "blockIndex": 100,
    "zh": "刺史、二千石，外統職事，內受法則。"
  },
  {
    "id": "s0520",
    "blockIndex": 100,
    "zh": "夫表曲者景必邪，源清者流必潔，猶叩樹本，百枝皆動也。"
  },
  {
    "id": "s0521",
    "blockIndex": 100,
    "zh": "由此言之，本朝號令，豈可蹉跌！"
  },
  {
    "id": "s0522",
    "blockIndex": 100,
    "zh": "天下之紀綱，當今之急務也。"
  },
  {
    "id": "s0523",
    "blockIndex": 100,
    "zh": "夫人君之有政，猶水之有堤坊。"
  },
  {
    "id": "s0524",
    "blockIndex": 100,
    "zh": "堤坊完全，雖遭雨水霖潦，不能為變。"
  },
  {
    "id": "s0525",
    "blockIndex": 100,
    "zh": "政教一立，暫遭凶年，不足為憂。"
  },
  {
    "id": "s0526",
    "blockIndex": 100,
    "zh": "誠令堤防穿漏，萬夫同力，不能復救；"
  },
  {
    "id": "s0527",
    "blockIndex": 100,
    "zh": "政教一壞，賢智馳鶩，不能復還。"
  },
  {
    "id": "s0528",
    "blockIndex": 100,
    "zh": "今堤防雖堅，漸有孔穴。"
  },
  {
    "id": "s0529",
    "blockIndex": 100,
    "zh": "譬之一人之身，本朝者，心腹也，州、郡者，四支也，心腹痛則四支不舉。"
  },
  {
    "id": "s0530",
    "blockIndex": 100,
    "zh": "故臣之所憂，在腹心之疾，非四支之患也。"
  },
  {
    "id": "s0531",
    "blockIndex": 100,
    "zh": "苟堅堤防，務政教，先安心腹，整理本朝，雖有寇賊、水旱之變，不足介意也；"
  },
  {
    "id": "s0532",
    "blockIndex": 100,
    "zh": "誠令堤防壞漏，心腹有疾，雖無水旱之災，天下固可以憂矣。"
  },
  {
    "id": "s0533",
    "blockIndex": 100,
    "zh": "又宜罷退宦官，去其權重，裁置常侍二人方直有德者省事左右，小黃門五人才智閑雅者給事殿中。"
  },
  {
    "id": "s0534",
    "blockIndex": 100,
    "zh": "如此，則論者厭塞，昇平可致也！"
  },
  {
    "id": "s0536",
    "blockIndex": 101,
    "zh": "扶風功曹馬融對曰：「今科條品制，四時禁令，所以承天順民者，備矣，悉矣，不可加矣。"
  },
  {
    "id": "s0537",
    "blockIndex": 101,
    "zh": "然而天猶有不平之效，民猶有咨嗟之怨者，百姓屢聞恩澤之聲，而未見惠和之實也。"
  },
  {
    "id": "s0538",
    "blockIndex": 101,
    "zh": "古之足民者，非能家贍而人足之，量其財用，為之制度。"
  },
  {
    "id": "s0539",
    "blockIndex": 101,
    "zh": "故嫁娶之禮儉，則婚者以時矣；"
  },
  {
    "id": "s0540",
    "blockIndex": 101,
    "zh": "喪制之禮約，則終者掩藏矣；"
  },
  {
    "id": "s0541",
    "blockIndex": 101,
    "zh": "不奪其時，則農夫利矣。"
  },
  {
    "id": "s0542",
    "blockIndex": 101,
    "zh": "夫妻子以累其心，產業以重其志，捨此而為非者，有必不多矣！"
  },
  {
    "id": "s0544",
    "blockIndex": 102,
    "zh": "太史令南陽張衡對曰：「自初舉孝廉，迄今二百歲矣，皆先孝行；"
  },
  {
    "id": "s0545",
    "blockIndex": 102,
    "zh": "行有餘力，始學文法。"
  },
  {
    "id": "s0546",
    "blockIndex": 102,
    "zh": "辛卯詔書，以能章句、奏案為限；"
  },
  {
    "id": "s0547",
    "blockIndex": 102,
    "zh": "雖有至孝，猶不應科，此棄本而取末。"
  },
  {
    "id": "s0548",
    "blockIndex": 102,
    "zh": "曾子長於孝，然實魯鈍，文學不若游、夏，政事不若冉、季。"
  },
  {
    "id": "s0549",
    "blockIndex": 102,
    "zh": "今欲使一人兼之，苟外有可觀，內必有闕，則違選舉孝廉之志矣。"
  },
  {
    "id": "s0550",
    "blockIndex": 102,
    "zh": "且郡國守相，剖符寧境，為國大臣，一旦免黜十有餘人，吏民罷於送迎之役，新故交際，公私放濫，或臨政為百姓所便而以小過免之，是為奪民父母使嗟號也。"
  },
  {
    "id": "s0551",
    "blockIndex": 102,
    "zh": "《易》不遠復，《論》不憚改，朋友交接且不宿過，況於帝王，承天理物，以天下為公者乎！"
  },
  {
    "id": "s0552",
    "blockIndex": 102,
    "zh": "中間以來，妖星見於上，震裂著於下，天誡詳矣，可為寒心。"
  },
  {
    "id": "s0553",
    "blockIndex": 102,
    "zh": "明者消禍於未萌。"
  },
  {
    "id": "s0554",
    "blockIndex": 102,
    "zh": "今既見矣，修政恐懼，則禍轉為福矣。"
  },
  {
    "id": "s0556",
    "blockIndex": 103,
    "zh": "上覽眾對，以李固為第一，即時出阿母還捨，諸常侍悉叩頭謝罪，朝廷肅然。"
  },
  {
    "id": "s0557",
    "blockIndex": 103,
    "zh": "以固為議郎；"
  },
  {
    "id": "s0558",
    "blockIndex": 103,
    "zh": "而阿母、宦者皆疾之，詐為飛章以陷其罪。"
  },
  {
    "id": "s0559",
    "blockIndex": 103,
    "zh": "事從中下，大司農南郡黃尚等請之於梁商，僕射黃瓊復救明其事。"
  },
  {
    "id": "s0560",
    "blockIndex": 103,
    "zh": "久乃得釋，出為洛令，固棄官歸漢中。"
  },
  {
    "id": "s0561",
    "blockIndex": 103,
    "zh": "融博通經籍，美文辭；"
  },
  {
    "id": "s0562",
    "blockIndex": 103,
    "zh": "對奏，亦拜議郎。"
  },
  {
    "id": "s0563",
    "blockIndex": 103,
    "zh": "衡善屬文，通貫《六藝》，雖才高於世，而無驕尚之情；"
  },
  {
    "id": "s0564",
    "blockIndex": 103,
    "zh": "善機巧，尤致思於天文、陰陽、歷算，作渾天儀，著《靈憲》。"
  },
  {
    "id": "s0565",
    "blockIndex": 103,
    "zh": "性恬憺，不慕當世；"
  },
  {
    "id": "s0566",
    "blockIndex": 103,
    "zh": "所居之官輒積年不徙。"
  },
  {
    "id": "s0567",
    "blockIndex": 104,
    "zh": "太尉寵參，在三公中最名忠直，數為左右所毀。"
  },
  {
    "id": "s0568",
    "blockIndex": 104,
    "zh": "會所舉用忤帝旨，司隸承風案之。"
  },
  {
    "id": "s0569",
    "blockIndex": 104,
    "zh": "時當會茂才、孝廉，參以被奏，稱疾不會。"
  },
  {
    "id": "s0570",
    "blockIndex": 104,
    "zh": "廣漢上計掾段恭因會上疏曰：「伏見道路行人、農夫、織婦皆曰：『太尉參竭忠盡節，徒以直道不能曲心，孤立群邪之間，自處中傷之地。"
  },
  {
    "id": "s0571",
    "blockIndex": 104,
    "zh": "』夫以讒佞傷毀忠正，此天地之大禁，人主之至誡也！"
  },
  {
    "id": "s0572",
    "blockIndex": 104,
    "zh": "昔白起賜死，諸侯酌酒相賀；"
  },
  {
    "id": "s0573",
    "blockIndex": 104,
    "zh": "季子來歸，魯人喜其紓難。"
  },
  {
    "id": "s0574",
    "blockIndex": 104,
    "zh": "夫國以賢治，君以忠安。"
  },
  {
    "id": "s0575",
    "blockIndex": 104,
    "zh": "今天下咸欣陛下有此忠賢，願卒寵任以安社稷。"
  },
  {
    "id": "s0576",
    "blockIndex": 104,
    "zh": "」書奏，詔即遣小黃門視參疾，太醫致羊酒。"
  },
  {
    "id": "s0577",
    "blockIndex": 104,
    "zh": "後參夫人疾前妻子，投於井而殺之；"
  },
  {
    "id": "s0578",
    "blockIndex": 104,
    "zh": "雒陽令祝良奏參罪。"
  },
  {
    "id": "s0579",
    "blockIndex": 104,
    "zh": "秋，七月，己未，參竟以災異免。"
  },
  {
    "id": "s0580",
    "blockIndex": 105,
    "zh": "八月，己巳，以大鴻臚施延為太尉。"
  },
  {
    "id": "s0581",
    "blockIndex": 106,
    "zh": "鮮卑寇馬城，代郡太守擊之，不克。"
  },
  {
    "id": "s0582",
    "blockIndex": 106,
    "zh": "頃之，其至鞬死。"
  },
  {
    "id": "s0583",
    "blockIndex": 106,
    "zh": "鮮卑由是抄盜差稀。"
  },
  {
    "id": "s0584",
    "blockIndex": 106,
    "zh": "category:資治通鑑"
  }
]
