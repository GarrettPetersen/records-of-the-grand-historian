[
  {
    "id": "s0001",
    "blockIndex": 0,
    "zh": "資治通鑑 第166卷卷第一百六十六"
  },
  {
    "id": "s0002",
    "blockIndex": 1,
    "zh": "【梁紀二十二】　起旃蒙大淵獻，盡柔兆困敦，凡二年。"
  },
  {
    "id": "s0003",
    "blockIndex": 2,
    "zh": "敬皇帝紹泰元年（"
  },
  {
    "id": "s0003",
    "blockIndex": 2,
    "zh": "乙亥，公元五五五年）"
  },
  {
    "id": "s0005",
    "blockIndex": 3,
    "zh": "春，正月，壬午朔，邵陵太守劉棻將兵援江陵，至三百里灘，部曲宋文徹殺之，帥其眾還據邵陵。"
  },
  {
    "id": "s0006",
    "blockIndex": 4,
    "zh": "梁王察即皇帝位於江陵，改元大定；"
  },
  {
    "id": "s0006",
    "blockIndex": 4,
    "zh": "追尊昭明太子為昭明皇帝，廟號高宗，妃蔡氏為昭德皇后；"
  },
  {
    "id": "s0006",
    "blockIndex": 4,
    "zh": "尊其母龔氏為皇太后，立妻王氏為皇后，子巋為皇太子。"
  },
  {
    "id": "s0006",
    "blockIndex": 4,
    "zh": "賞刑制度並同王者，唯上疏於魏則稱臣，奉其正朔。"
  },
  {
    "id": "s0006",
    "blockIndex": 4,
    "zh": "至於官爵其下，亦依梁氏之舊，其勳級則兼用柱國等名。"
  },
  {
    "id": "s0006",
    "blockIndex": 4,
    "zh": "以咨議參軍蔡大寶為侍中、尚書令，參掌選事；"
  },
  {
    "id": "s0006",
    "blockIndex": 4,
    "zh": "外兵參軍太原王操為五兵尚書。"
  },
  {
    "id": "s0006",
    "blockIndex": 4,
    "zh": "大寶嚴整有智謀，雅達政事，文辭贍速，後梁主推心任之，以為謀主，比之諸葛孔明；"
  },
  {
    "id": "s0006",
    "blockIndex": 4,
    "zh": "操亦亞之。"
  },
  {
    "id": "s0006",
    "blockIndex": 4,
    "zh": "追贈邵陵王綸太宰，謚曰壯武；"
  },
  {
    "id": "s0006",
    "blockIndex": 4,
    "zh": "河東王譽丞相，謚曰武桓。"
  },
  {
    "id": "s0006",
    "blockIndex": 4,
    "zh": "以莫勇為武州刺史，魏永壽為巴州刺史。"
  },
  {
    "id": "s0018",
    "blockIndex": 5,
    "zh": "湘州刺史王琳將兵自小桂北下，至蒸城，聞江陵已陷，為世祖發哀，三軍縞素，遣別將侯平帥舟師攻後梁。"
  },
  {
    "id": "s0018",
    "blockIndex": 5,
    "zh": "琳屯兵長沙，傳檄州郡，為進取之計。"
  },
  {
    "id": "s0018",
    "blockIndex": 5,
    "zh": "長沙王韶及上游諸將皆推琳為盟主。"
  },
  {
    "id": "s0021",
    "blockIndex": 6,
    "zh": "齊主使清河王岳將兵攻魏安州，以救江陵。"
  },
  {
    "id": "s0021",
    "blockIndex": 6,
    "zh": "岳至義陽，江陵陷，因進軍臨江，郢州刺史陸法和及儀同三司宋蒞舉州降之；"
  },
  {
    "id": "s0021",
    "blockIndex": 6,
    "zh": "長史江夏太守王鈱不從，殺之。"
  },
  {
    "id": "s0021",
    "blockIndex": 6,
    "zh": "甲午，齊召岳還，使儀同三司清都慕容儼戍郢州。"
  },
  {
    "id": "s0021",
    "blockIndex": 6,
    "zh": "王僧辯遣江州刺史侯瑱攻郢州，任約、徐世譜、宜豐侯循皆引兵會之。"
  },
  {
    "id": "s0026",
    "blockIndex": 7,
    "zh": "辛丑，齊立貞陽侯淵明為梁主，使其上黨王渙將兵送之，徐陵、湛海珍等皆聽從淵明歸。"
  },
  {
    "id": "s0027",
    "blockIndex": 8,
    "zh": "二月，癸丑，晉安王至自尋陽，入居朝堂，即梁王位，時年十三。"
  },
  {
    "id": "s0027",
    "blockIndex": 8,
    "zh": "以太尉王僧辯為中書監、錄尚書、驃騎大將軍、都督中外諸軍事，加陳霸先征西大將軍，以南豫州刺史侯瑱為江州刺史，湘州刺史蕭循為太尉，廣州刺史蕭勃為司徒，鎮東將軍張彪為郢州刺史。"
  },
  {
    "id": "s0029",
    "blockIndex": 9,
    "zh": "齊主先使殿中尚書邢子才馳傳詣建康，與王僧辯書，以為：「嗣主沖藐，未堪負荷。"
  },
  {
    "id": "s0029",
    "blockIndex": 9,
    "zh": "彼貞陽侯，梁武猶子，長沙之胤，以年以望，堪保金陵，故置為梁王，納於彼國。"
  },
  {
    "id": "s0029",
    "blockIndex": 9,
    "zh": "卿宜部分舟艫，迎接今主，並心一力，善建良圖。"
  },
  {
    "id": "s0029",
    "blockIndex": 9,
    "zh": "」乙卯，貞陽侯淵明亦與僧辯書求迎。"
  },
  {
    "id": "s0029",
    "blockIndex": 9,
    "zh": "僧辯復書曰：「嗣主體自宸極，受於文祖。"
  },
  {
    "id": "s0029",
    "blockIndex": 9,
    "zh": "明公倘能入朝，同獎王室，伊、呂之任，僉曰仰歸；"
  },
  {
    "id": "s0029",
    "blockIndex": 9,
    "zh": "意在主盟，不敢聞命。"
  },
  {
    "id": "s0029",
    "blockIndex": 9,
    "zh": "」甲子，齊以陸法和為都督荊、雍等十州諸軍事、太尉、大都督、西南道大行台，又以宋蒞為郢州刺史，蒞弟簉為湘州刺史。"
  },
  {
    "id": "s0029",
    "blockIndex": 9,
    "zh": "甲戌，上黨王渙克譙郡。"
  },
  {
    "id": "s0029",
    "blockIndex": 9,
    "zh": "己卯，淵明又與僧辯書，僧辯不從。"
  },
  {
    "id": "s0039",
    "blockIndex": 10,
    "zh": "魏以右僕射申徽為襄州刺史。"
  },
  {
    "id": "s0040",
    "blockIndex": 11,
    "zh": "侯平攻後梁巴、武二州，故劉棻主帥趙朗殺宋文徹，以邵陵歸於王琳。"
  },
  {
    "id": "s0041",
    "blockIndex": 12,
    "zh": "三月，貞陽侯淵明至東關，散騎常侍裴之橫御之。"
  },
  {
    "id": "s0041",
    "blockIndex": 12,
    "zh": "齊軍司尉瑾、儀同三司蕭軌南侵皎城，晉州刺史蕭惠以州降之。"
  },
  {
    "id": "s0041",
    "blockIndex": 12,
    "zh": "齊改晉熙為江州，以尉瑾為刺史。"
  },
  {
    "id": "s0041",
    "blockIndex": 12,
    "zh": "丙戌，齊克東關，斬裴之橫，俘數千人；"
  },
  {
    "id": "s0041",
    "blockIndex": 12,
    "zh": "王僧辯大懼，出屯姑孰，謀納淵明。"
  },
  {
    "id": "s0046",
    "blockIndex": 13,
    "zh": "丙申，齊主還鄴，封世宗二子孝珩為廣寧王，延宗為安德王。"
  },
  {
    "id": "s0047",
    "blockIndex": 14,
    "zh": "孫□易聞江陵陷，棄廣州還，曲江侯勃復據有之。"
  },
  {
    "id": "s0048",
    "blockIndex": 15,
    "zh": "魏太師泰遣王克、沈炯等還江南。"
  },
  {
    "id": "s0048",
    "blockIndex": 15,
    "zh": "泰得庾季才，厚遇之，令參掌太史。"
  },
  {
    "id": "s0048",
    "blockIndex": 15,
    "zh": "季才散私財，購親舊之為奴婢者。"
  },
  {
    "id": "s0048",
    "blockIndex": 15,
    "zh": "泰問：「何能如是？"
  },
  {
    "id": "s0048",
    "blockIndex": 15,
    "zh": "」對曰：「僕聞克國禮賢，言之道也。"
  },
  {
    "id": "s0048",
    "blockIndex": 15,
    "zh": "今郢都覆沒，其君信有罪矣，搢紳何咎，皆為皁隸！"
  },
  {
    "id": "s0048",
    "blockIndex": 15,
    "zh": "鄙人羈旅，不敢獻言，誠切哀之，故私購之耳。"
  },
  {
    "id": "s0048",
    "blockIndex": 15,
    "zh": "」泰乃悟，曰：「吾之過也！"
  },
  {
    "id": "s0048",
    "blockIndex": 15,
    "zh": "微君，遂失天下之望！"
  },
  {
    "id": "s0048",
    "blockIndex": 15,
    "zh": "」因出令，免梁俘為奴婢者數千口。"
  },
  {
    "id": "s0048",
    "blockIndex": 15,
    "zh": "夏，四月，庚申，齊主如晉陽。"
  },
  {
    "id": "s0059",
    "blockIndex": 16,
    "zh": "五月，庚辰，侯平等擒莫勇、魏永壽。"
  },
  {
    "id": "s0059",
    "blockIndex": 16,
    "zh": "江陵之陷也，永嘉王莊生七年矣，尼法慕匿之，王琳迎莊，送之建康。"
  },
  {
    "id": "s0061",
    "blockIndex": 17,
    "zh": "庚寅，齊主還鄴。"
  },
  {
    "id": "s0062",
    "blockIndex": 18,
    "zh": "王僧辯遣使奉啟於貞陽侯淵明，定君臣之禮，又遣別使奉表於齊，以子顯及顯母劉氏、弟子世珍為質於淵明，遣左民尚書周弘正至歷陽奉迎，因求以晉安王為皇太子；"
  },
  {
    "id": "s0062",
    "blockIndex": 18,
    "zh": "淵明許之。"
  },
  {
    "id": "s0062",
    "blockIndex": 18,
    "zh": "淵明求度衛士三千，僧辯慮其為變，止受散卒千人。"
  },
  {
    "id": "s0062",
    "blockIndex": 18,
    "zh": "庚子，遣龍舟法駕迎之。"
  },
  {
    "id": "s0062",
    "blockIndex": 18,
    "zh": "淵明與齊上黨王渙盟於江北，辛丑，自採石濟江。"
  },
  {
    "id": "s0062",
    "blockIndex": 18,
    "zh": "於是梁輿南渡，齊師北返。"
  },
  {
    "id": "s0062",
    "blockIndex": 18,
    "zh": "僧辯疑齊，擁楫中流，不敢就西岸。"
  },
  {
    "id": "s0062",
    "blockIndex": 18,
    "zh": "齊侍中裴英起衛送淵明，與僧辯會於江寧。"
  },
  {
    "id": "s0062",
    "blockIndex": 18,
    "zh": "癸卯，淵明入建康，望朱雀門而哭，道逆者以哭對。"
  },
  {
    "id": "s0062",
    "blockIndex": 18,
    "zh": "丙午，即皇帝位，改元天成，以晉安王為皇太子，王僧辯為大司馬，陳霸先為侍中。"
  },
  {
    "id": "s0072",
    "blockIndex": 19,
    "zh": "六月，庚戌朔，齊發民一百八十萬築長城，自幽州夏口西至恆州九百餘里，命定州刺史趙郡王睿將兵監之。"
  },
  {
    "id": "s0072",
    "blockIndex": 19,
    "zh": "睿，琛之子也。"
  },
  {
    "id": "s0074",
    "blockIndex": 20,
    "zh": "齊慕容儼始入郢州，而侯瑱等奄至城下，儼隨方備御，瑱等不能克；"
  },
  {
    "id": "s0074",
    "blockIndex": 20,
    "zh": "乘間出擊瑱等軍，大破之。"
  },
  {
    "id": "s0074",
    "blockIndex": 20,
    "zh": "城中食盡，煮草木根葉及靴皮帶角食之，與士卒分甘共苦，堅守半歲，人無異志。"
  },
  {
    "id": "s0074",
    "blockIndex": 20,
    "zh": "貞陽侯淵明立，乃命瑱等解圍，瑱還鎮豫章。"
  },
  {
    "id": "s0074",
    "blockIndex": 20,
    "zh": "齊人以城在江外難守，因割以還梁。"
  },
  {
    "id": "s0074",
    "blockIndex": 20,
    "zh": "儼歸，望齊主，悲不自勝。"
  },
  {
    "id": "s0074",
    "blockIndex": 20,
    "zh": "齊主呼前，執其手，脫帽看發，歎息久之。"
  },
  {
    "id": "s0081",
    "blockIndex": 21,
    "zh": "吳興太守杜龕，王僧辯之婿也。"
  },
  {
    "id": "s0081",
    "blockIndex": 21,
    "zh": "僧辯以吳興為震州，用龕為刺史，又以其弟侍中僧愔為豫章太守。"
  },
  {
    "id": "s0083",
    "blockIndex": 22,
    "zh": "壬子，齊主以梁國稱籓，詔凡梁民悉遣南還。"
  },
  {
    "id": "s0084",
    "blockIndex": 23,
    "zh": "丁卯，齊主如晉陽；"
  },
  {
    "id": "s0084",
    "blockIndex": 23,
    "zh": "壬申，自將擊柔然。"
  },
  {
    "id": "s0084",
    "blockIndex": 23,
    "zh": "秋，七月，己卯，至白道，留輜重，帥輕騎五千追柔然，壬午，及之於懷朔鎮。"
  },
  {
    "id": "s0084",
    "blockIndex": 23,
    "zh": "齊主親犯矢石，頻戰，大破之。"
  },
  {
    "id": "s0084",
    "blockIndex": 23,
    "zh": "至於沃野，獲其酋長，及生口二萬餘，牛羊數十萬。"
  },
  {
    "id": "s0084",
    "blockIndex": 23,
    "zh": "壬辰，還晉陽。"
  },
  {
    "id": "s0090",
    "blockIndex": 24,
    "zh": "八月，辛巳，王琳自蒸城還長沙。"
  },
  {
    "id": "s0091",
    "blockIndex": 25,
    "zh": "齊主還鄴，以佛、道二教不同，欲去其一，集二家學者論難於前，遂敕道士皆剃髮為沙門；"
  },
  {
    "id": "s0091",
    "blockIndex": 25,
    "zh": "有不從者，殺四人，乃奉命。"
  },
  {
    "id": "s0091",
    "blockIndex": 25,
    "zh": "於是齊境皆無道士。"
  },
  {
    "id": "s0094",
    "blockIndex": 26,
    "zh": "初，王僧辯與陳霸先共滅侯景，情好甚篤，僧辯為子頠娶霸先女，會僧辯有母喪，未成昏。"
  },
  {
    "id": "s0094",
    "blockIndex": 26,
    "zh": "僧辯居石頭城，霸先在京口，僧辯推心待之，頠兄顗屢諫，不聽。"
  },
  {
    "id": "s0094",
    "blockIndex": 26,
    "zh": "及僧辯納貞陽侯淵明，霸先遣使苦爭之，往返數四，僧辯不從。"
  },
  {
    "id": "s0094",
    "blockIndex": 26,
    "zh": "霸先切歎，謂所親曰：「武帝子孫甚多，唯孝元能復仇雪恥，其子何罪，而忽廢之！"
  },
  {
    "id": "s0094",
    "blockIndex": 26,
    "zh": "吾與王公並處托孤之地，而王公一旦改圖，外依戎狄，援立非次，其志欲何所為乎！"
  },
  {
    "id": "s0094",
    "blockIndex": 26,
    "zh": "」乃密具袍數千領及錦彩金銀為賞賜之具。"
  },
  {
    "id": "s0100",
    "blockIndex": 27,
    "zh": "會有告齊師大舉至壽春將入寇者，僧辯遣記室江旰告霸先，使為之備。"
  },
  {
    "id": "s0100",
    "blockIndex": 27,
    "zh": "霸先因是留旰於京口，舉兵襲僧辯。"
  },
  {
    "id": "s0100",
    "blockIndex": 27,
    "zh": "九月，壬寅，召部將侯安都、周文育及安陸徐度、錢塘杜稜謀之。"
  },
  {
    "id": "s0100",
    "blockIndex": 27,
    "zh": "稜以為難，霸先懼其謀洩，以手巾絞稜，悶絕於地，因閉於別室。"
  },
  {
    "id": "s0100",
    "blockIndex": 27,
    "zh": "部分將士，分賜金帛，以弟子著作郎曇朗鎮京口，知留府事，使徐度、侯安都帥水軍趨石頭，霸先帥馬步自江乘羅落會之。"
  },
  {
    "id": "s0100",
    "blockIndex": 27,
    "zh": "是夜，皆發，召杜稜與同行。"
  },
  {
    "id": "s0100",
    "blockIndex": 27,
    "zh": "知其謀者，唯安都等四將，外人皆以為江旰徵兵御齊，不之怪也。"
  },
  {
    "id": "s0107",
    "blockIndex": 28,
    "zh": "甲辰，安都引舟艦將趣石頭，霸先控馬未進，安都大懼，追霸先罵曰：「今日作賊，事勢已成，生死須決，在後欲何所望！"
  },
  {
    "id": "s0107",
    "blockIndex": 28,
    "zh": "若敗，俱死，後期得免斫頭邪？"
  },
  {
    "id": "s0107",
    "blockIndex": 28,
    "zh": "」霸先曰：「安都嗔我！"
  },
  {
    "id": "s0107",
    "blockIndex": 28,
    "zh": "」乃進。"
  },
  {
    "id": "s0107",
    "blockIndex": 28,
    "zh": "安都至石頭城北，棄舟登岸。"
  },
  {
    "id": "s0107",
    "blockIndex": 28,
    "zh": "石頭城北接岡阜，不甚危峻。"
  },
  {
    "id": "s0107",
    "blockIndex": 28,
    "zh": "安都被甲帶長刀，軍人捧之，投於女垣內，眾隨而入，進及僧辯臥室。"
  },
  {
    "id": "s0107",
    "blockIndex": 28,
    "zh": "霸先兵亦自南門入。"
  },
  {
    "id": "s0107",
    "blockIndex": 28,
    "zh": "僧辯方視事，外白有兵，俄而兵自內出。"
  },
  {
    "id": "s0107",
    "blockIndex": 28,
    "zh": "僧辯遽走，遇子頠，與俱出閣，帥左右數十人苦戰於廳事前，力不敵，走登南門樓，拜請求哀。"
  },
  {
    "id": "s0107",
    "blockIndex": 28,
    "zh": "霸先欲縱火焚之，僧辯與頠俱下就執。"
  },
  {
    "id": "s0107",
    "blockIndex": 28,
    "zh": "霸先曰：「我有何辜，公欲與齊師賜討？"
  },
  {
    "id": "s0107",
    "blockIndex": 28,
    "zh": "」且曰：「何意全無備？"
  },
  {
    "id": "s0107",
    "blockIndex": 28,
    "zh": "」僧辯曰：「委公北門，何謂無備？"
  },
  {
    "id": "s0107",
    "blockIndex": 28,
    "zh": "」是夜，霸先縊殺僧辯父子。"
  },
  {
    "id": "s0107",
    "blockIndex": 28,
    "zh": "既而竟無齊兵，亦非霸先之譎也。"
  },
  {
    "id": "s0107",
    "blockIndex": 28,
    "zh": "前青州刺史新安程靈洗帥所領救僧辯，力戰於石頭西門，軍敗。"
  },
  {
    "id": "s0107",
    "blockIndex": 28,
    "zh": "霸先遣使招諭，久之乃降。"
  },
  {
    "id": "s0107",
    "blockIndex": 28,
    "zh": "霸先義之，以為蘭陵太守，使助防京口。"
  },
  {
    "id": "s0107",
    "blockIndex": 28,
    "zh": "乙巳，霸先為檄佈告中外，列僧辯罪狀，且曰：「資斧所指，唯王僧辯父子兄弟，其餘親黨，一無所問。"
  },
  {
    "id": "s0128",
    "blockIndex": 29,
    "zh": "丙午，貞陽侯淵明遜位，出就邸，百僚上晉安王表，勸進。"
  },
  {
    "id": "s0128",
    "blockIndex": 29,
    "zh": "冬，十月，己酉，晉安王即皇帝位，大赦，改元，中外文武賜位一等。"
  },
  {
    "id": "s0128",
    "blockIndex": 29,
    "zh": "以貞陽侯淵明為司徒，封建安公。"
  },
  {
    "id": "s0128",
    "blockIndex": 29,
    "zh": "告齊云：「僧辯陰圖篡逆，故誅之。"
  },
  {
    "id": "s0128",
    "blockIndex": 29,
    "zh": "」仍請稱臣於齊，永為籓國。"
  },
  {
    "id": "s0128",
    "blockIndex": 29,
    "zh": "齊遣行台司馬恭與梁人盟於歷陽。"
  },
  {
    "id": "s0134",
    "blockIndex": 30,
    "zh": "辛亥，齊主如晉陽。"
  },
  {
    "id": "s0135",
    "blockIndex": 31,
    "zh": "壬子，加陳霸先尚書令、都督中外諸軍事、車騎將軍、揚、南徐二州刺史。"
  },
  {
    "id": "s0135",
    "blockIndex": 31,
    "zh": "癸丑，以宜豐侯循為太保，建安公淵明為太傅，曲江侯勃為太尉，王琳為車騎將軍、開府儀同三司。"
  },
  {
    "id": "s0137",
    "blockIndex": 32,
    "zh": "戊午，尊帝所生夏貴妃為皇太后，立妃王氏為皇后。"
  },
  {
    "id": "s0138",
    "blockIndex": 33,
    "zh": "杜龕恃王僧辯之勢，素不禮於陳霸先。"
  },
  {
    "id": "s0138",
    "blockIndex": 33,
    "zh": "在吳興，每以法繩其宗族，霸先深怨之。"
  },
  {
    "id": "s0138",
    "blockIndex": 33,
    "zh": "及將圖僧辯，密使兄子茜還長城，立柵以備龕。"
  },
  {
    "id": "s0138",
    "blockIndex": 33,
    "zh": "僧辯死，龕據吳興拒霸先，義興太守韋載以郡應之。"
  },
  {
    "id": "s0138",
    "blockIndex": 33,
    "zh": "吳郡太守王僧智，僧辯之弟也，亦據城守。"
  },
  {
    "id": "s0138",
    "blockIndex": 33,
    "zh": "陳茜至長城，收兵才數百人，杜龕遣其將杜泰將精兵五千奄至，將士相視失色。"
  },
  {
    "id": "s0138",
    "blockIndex": 33,
    "zh": "茜言笑自若，部分益明，眾心乃定。"
  },
  {
    "id": "s0138",
    "blockIndex": 33,
    "zh": "泰日夜苦攻數旬，不克而退。"
  },
  {
    "id": "s0138",
    "blockIndex": 33,
    "zh": "霸先使周文育攻義興，義興屬縣卒皆霸先舊兵，善用弩，韋載收得數十人，系以長鎖，命所親監之，使射文育軍，約曰：「十發不兩中者死。"
  },
  {
    "id": "s0138",
    "blockIndex": 33,
    "zh": "」故每發輒斃一人，文育軍稍卻。"
  },
  {
    "id": "s0138",
    "blockIndex": 33,
    "zh": "載因於城外據水立柵，相持數旬。"
  },
  {
    "id": "s0138",
    "blockIndex": 33,
    "zh": "杜龕遣其從弟北叟將兵拒戰，北叟敗，歸於義興。"
  },
  {
    "id": "s0138",
    "blockIndex": 33,
    "zh": "霸先聞文育軍不利，辛未，自表東討，留高州刺史侯安都、石州刺史杜稜宿衛台省。"
  },
  {
    "id": "s0138",
    "blockIndex": 33,
    "zh": "甲戌，軍至義興，丙子，拔其水柵。"
  },
  {
    "id": "s0152",
    "blockIndex": 34,
    "zh": "譙、秦二州刺史徐嗣徽從弟嗣先，僧辯之甥也。"
  },
  {
    "id": "s0152",
    "blockIndex": 34,
    "zh": "僧辯死，嗣先亡就嗣徽，嗣徽以州入於齊。"
  },
  {
    "id": "s0152",
    "blockIndex": 34,
    "zh": "及陳霸先東討義興，嗣徽密結南豫州刺史任約，將精兵五千乘虛襲建康，是日，入據石頭，游騎至闕下。"
  },
  {
    "id": "s0152",
    "blockIndex": 34,
    "zh": "侯安都閉門藏旗幟，示之以弱，令城中曰：「登陴窺賊者斬！"
  },
  {
    "id": "s0152",
    "blockIndex": 34,
    "zh": "」及夕，嗣徽等收兵還石頭。"
  },
  {
    "id": "s0152",
    "blockIndex": 34,
    "zh": "安都夜為戰備，將旦，嗣徽等又至，安都帥甲士三百開東、西掖門出戰，大破之，嗣徽等奔還石頭，不敢復逼台城。"
  },
  {
    "id": "s0158",
    "blockIndex": 35,
    "zh": "陳霸先遣韋載族弟翽繼書諭載，丁丑，載及杜北叟皆降，霸先厚撫之，以翽監義興郡，引載置左右，與之謀議。"
  },
  {
    "id": "s0158",
    "blockIndex": 35,
    "zh": "霸先卷甲還建康，使周文育討杜龕，救長城。"
  },
  {
    "id": "s0158",
    "blockIndex": 35,
    "zh": "將軍黃他攻王僧智於吳郡，不克，霸先使寧遠將軍裴忌助之。"
  },
  {
    "id": "s0158",
    "blockIndex": 35,
    "zh": "忌選所部精兵輕行倍道，自錢塘直趣吳郡，夜，至城下，鼓噪薄之。"
  },
  {
    "id": "s0158",
    "blockIndex": 35,
    "zh": "僧智以為大軍至，輕舟奔吳興。"
  },
  {
    "id": "s0158",
    "blockIndex": 35,
    "zh": "忌入據吳郡，因以忌為太守。"
  },
  {
    "id": "s0164",
    "blockIndex": 36,
    "zh": "十一月，己卯，齊遣兵五千度江據姑孰，以應徐嗣徽、任約。"
  },
  {
    "id": "s0164",
    "blockIndex": 36,
    "zh": "陳霸先使合州刺史徐度立柵於冶城。"
  },
  {
    "id": "s0164",
    "blockIndex": 36,
    "zh": "庚辰，齊又遣安州刺史翟子崇、楚州刺史劉士榮、淮州刺史柳達摩將兵萬人於胡墅度米三萬石、馬千匹入石頭。"
  },
  {
    "id": "s0164",
    "blockIndex": 36,
    "zh": "霸先問計於韋載。"
  },
  {
    "id": "s0164",
    "blockIndex": 36,
    "zh": "載曰：「齊師若分兵先據三吳之路，略地東境，則時事去矣。"
  },
  {
    "id": "s0164",
    "blockIndex": 36,
    "zh": "今可急於淮南因侯景故壘築城，以通東道轉輸，分兵絕彼之糧運，使進無所資，則齊將之首旬日可致。"
  },
  {
    "id": "s0164",
    "blockIndex": 36,
    "zh": "」霸先從之。"
  },
  {
    "id": "s0164",
    "blockIndex": 36,
    "zh": "癸未，使侯安都夜襲胡墅，燒齊船千餘艘；"
  },
  {
    "id": "s0164",
    "blockIndex": 36,
    "zh": "仁威將軍周鐵虎斷齊運輸，擒其北徐州刺史張領州；"
  },
  {
    "id": "s0164",
    "blockIndex": 36,
    "zh": "仍遣韋載於大航築侯景故壘，使杜稜守之。"
  },
  {
    "id": "s0164",
    "blockIndex": 36,
    "zh": "齊人於倉門、水南立二柵，與梁兵相拒。"
  },
  {
    "id": "s0164",
    "blockIndex": 36,
    "zh": "壬辰，齊大都督蕭軌將兵屯江北。"
  },
  {
    "id": "s0176",
    "blockIndex": 37,
    "zh": "初，齊平秦王歸彥幼孤，高祖令清河昭武王岳養之，岳情禮甚薄，歸彥心銜之。"
  },
  {
    "id": "s0176",
    "blockIndex": 37,
    "zh": "及顯祖即位，歸彥為領軍大將軍，大被寵遇，岳謂其德己，更倚賴之。"
  },
  {
    "id": "s0176",
    "blockIndex": 37,
    "zh": "岳屢將兵立功，有威名，而性豪侈，好酒色，起第於城南，廳事後開巷。"
  },
  {
    "id": "s0176",
    "blockIndex": 37,
    "zh": "歸彥譖之於帝曰：「清河僭擬宮禁，制為永巷，但無闕耳。"
  },
  {
    "id": "s0176",
    "blockIndex": 37,
    "zh": "」帝由是惡之。"
  },
  {
    "id": "s0176",
    "blockIndex": 37,
    "zh": "帝納倡婦薛氏於後宮，岳先嘗因其姊迎之至第。"
  },
  {
    "id": "s0176",
    "blockIndex": 37,
    "zh": "帝夜遊於薛氏家，其姊為父乞司徒。"
  },
  {
    "id": "s0176",
    "blockIndex": 37,
    "zh": "帝大怒，懸其姊，鋸殺之。"
  },
  {
    "id": "s0176",
    "blockIndex": 37,
    "zh": "讓岳以奸，岳不服，帝益怒，乙亥，使歸彥鴆岳。"
  },
  {
    "id": "s0176",
    "blockIndex": 37,
    "zh": "岳自訴無罪，歸彥曰：「飲之則家全。"
  },
  {
    "id": "s0176",
    "blockIndex": 37,
    "zh": "」飲之而卒，葬贈如禮。"
  },
  {
    "id": "s0187",
    "blockIndex": 38,
    "zh": "薛嬪有寵於帝，久之，帝忽思其與岳通，無故斬首，藏之於懷，出東山宴飲。"
  },
  {
    "id": "s0187",
    "blockIndex": 38,
    "zh": "勸酬始合，忽探出其首，投於柈上，支解其屍，弄其髀為琵琶，一座大驚。"
  },
  {
    "id": "s0187",
    "blockIndex": 38,
    "zh": "帝方收取，對之流涕曰：「佳人難再得！"
  },
  {
    "id": "s0187",
    "blockIndex": 38,
    "zh": "」載屍以出，被發步哭而隨之。"
  },
  {
    "id": "s0191",
    "blockIndex": 39,
    "zh": "甲辰，徐嗣徽等攻冶城柵，陳霸先將精甲自西明門出擊之，嗣徽等大敗，留柳達摩等守城，自往採石迎齊援。"
  },
  {
    "id": "s0192",
    "blockIndex": 40,
    "zh": "以郢州刺史宜豐侯循為太保，廣州刺史曲江侯勃為司空，並征入侍。"
  },
  {
    "id": "s0192",
    "blockIndex": 40,
    "zh": "循受太保而辭不入。"
  },
  {
    "id": "s0192",
    "blockIndex": 40,
    "zh": "勃方謀舉兵，遂不受命。"
  },
  {
    "id": "s0195",
    "blockIndex": 41,
    "zh": "鎮南將軍王琳侵魏，魏大將軍豆盧寧御之。"
  },
  {
    "id": "s0196",
    "blockIndex": 42,
    "zh": "十二月，癸丑，侯安都襲秦郡，破徐嗣徽柵，俘數百人。"
  },
  {
    "id": "s0196",
    "blockIndex": 42,
    "zh": "收其家，得其琵琶及鷹，遣使送之曰：「昨至弟處得此，今以相還。"
  },
  {
    "id": "s0196",
    "blockIndex": 42,
    "zh": "」嗣徽大懼。"
  },
  {
    "id": "s0196",
    "blockIndex": 42,
    "zh": "丙辰，陳霸先對冶城立航，悉渡眾軍，攻其水南二柵。"
  },
  {
    "id": "s0196",
    "blockIndex": 42,
    "zh": "柳達摩等渡淮置陳，霸先督兵疾戰，縱火燒柵，齊兵大敗，爭舟相擠，溺死者以千數，呼聲震天地，盡收其船艦。"
  },
  {
    "id": "s0196",
    "blockIndex": 42,
    "zh": "是日，嗣徽與任約引齊兵水步萬餘人還據石頭，霸先遣兵詣江寧，據險要。"
  },
  {
    "id": "s0196",
    "blockIndex": 42,
    "zh": "嗣徽等水步不敢進。"
  },
  {
    "id": "s0196",
    "blockIndex": 42,
    "zh": "頓江寧浦口，霸先遣侯安都將水軍襲破之，嗣徽等單舸脫走，盡收其軍資器械。"
  },
  {
    "id": "s0204",
    "blockIndex": 43,
    "zh": "己未，霸先四面攻石頭，城中無水，升水直絹一匹。"
  },
  {
    "id": "s0204",
    "blockIndex": 43,
    "zh": "庚申，達摩遣使請和於霸先，且求質子。"
  },
  {
    "id": "s0204",
    "blockIndex": 43,
    "zh": "時建康虛弱，糧運不繼，朝臣皆欲與齊和，請以霸先從子曇朗為質。"
  },
  {
    "id": "s0204",
    "blockIndex": 43,
    "zh": "霸先曰：「今在位諸賢欲息肩於齊，若違眾議，謂孤愛曇朗，不恤國家，今決遣曇朗，棄之寇庭。"
  },
  {
    "id": "s0204",
    "blockIndex": 43,
    "zh": "齊人無信，謂我微弱，必當背盟。"
  },
  {
    "id": "s0204",
    "blockIndex": 43,
    "zh": "齊寇若來，諸君須為孤力鬥也！"
  },
  {
    "id": "s0204",
    "blockIndex": 43,
    "zh": "」乃以曇朗及永嘉王莊、丹楊尹王沖之子鈱為質，與齊人盟於城外，將士咨其南北。"
  },
  {
    "id": "s0204",
    "blockIndex": 43,
    "zh": "辛酉，霸先陳兵石頭南門，送齊人歸北，徐嗣徽、任約皆奔齊。"
  },
  {
    "id": "s0204",
    "blockIndex": 43,
    "zh": "收齊馬仗船米，不可勝計。"
  },
  {
    "id": "s0204",
    "blockIndex": 43,
    "zh": "齊主誅柳達摩。"
  },
  {
    "id": "s0204",
    "blockIndex": 43,
    "zh": "壬戌，齊和州長史烏丸遠自南州奔還歷陽。"
  },
  {
    "id": "s0215",
    "blockIndex": 44,
    "zh": "江寧令陳嗣、黃門侍郎曹朗據姑孰反，霸先命侯安都等討平之。"
  },
  {
    "id": "s0215",
    "blockIndex": 44,
    "zh": "霸先恐陳曇朗亡竄，自帥步騎至京口迎之。"
  },
  {
    "id": "s0217",
    "blockIndex": 45,
    "zh": "交州刺史劉元偃帥其屬數千人歸王琳。"
  },
  {
    "id": "s0218",
    "blockIndex": 46,
    "zh": "魏以侍中李遠為尚書左僕射。"
  },
  {
    "id": "s0219",
    "blockIndex": 47,
    "zh": "魏益州刺史宇文貴使譙淹從子子嗣誘說淹，以為大將軍，淹不從，斬子嗣。"
  },
  {
    "id": "s0219",
    "blockIndex": 47,
    "zh": "貴怒，攻之，淹自東遂寧徙屯墊江。"
  },
  {
    "id": "s0221",
    "blockIndex": 48,
    "zh": "初，晉安民陳羽，世為閩中豪姓，其子寶應多權詐，郡中畏服。"
  },
  {
    "id": "s0221",
    "blockIndex": 48,
    "zh": "侯景之亂，晉安太守賓化侯雲以郡讓羽，羽老，但治郡事，令寶應典兵。"
  },
  {
    "id": "s0221",
    "blockIndex": 48,
    "zh": "時東境荒饉，而晉安獨豐衍。"
  },
  {
    "id": "s0221",
    "blockIndex": 48,
    "zh": "寶應數自海道出，寇抄臨安、永嘉、會稽，或載米粟與之貿易，由是能致富強。"
  },
  {
    "id": "s0221",
    "blockIndex": 48,
    "zh": "侯景平，世祖因以羽為晉安太守。"
  },
  {
    "id": "s0221",
    "blockIndex": 48,
    "zh": "及陳霸先輔政，羽求傳郡於寶應，霸先許之。"
  },
  {
    "id": "s0227",
    "blockIndex": 49,
    "zh": "是歲，魏宇文泰諷淮安王育上表請如古制降爵為公，於是宗室諸王皆降為公。"
  },
  {
    "id": "s0228",
    "blockIndex": 50,
    "zh": "突厥木桿可汗擊柔然主鄧叔子，滅之，叔子收其餘燼奔魏。"
  },
  {
    "id": "s0228",
    "blockIndex": 50,
    "zh": "木桿西破厭噠，東走契丹，北並契骨，威服塞外諸國。"
  },
  {
    "id": "s0228",
    "blockIndex": 50,
    "zh": "其地東自遼海，西至西海，長萬里，南自沙漠以北五六千里皆屬焉。"
  },
  {
    "id": "s0228",
    "blockIndex": 50,
    "zh": "木桿恃其強，請盡誅鄧叔子等於魏，使者相繼於道。"
  },
  {
    "id": "s0228",
    "blockIndex": 50,
    "zh": "太師泰收叔子以下三千餘人付其使者，盡殺之於青門外。"
  },
  {
    "id": "s0233",
    "blockIndex": 51,
    "zh": "初，魏太師泰以漢、魏官繁，命蘇綽及尚書令盧辯依《周禮》更定六官。"
  },
  {
    "id": "s0234",
    "blockIndex": 52,
    "zh": "敬皇帝太平元年（"
  },
  {
    "id": "s0234",
    "blockIndex": 52,
    "zh": "丙子，公元五五六年）"
  },
  {
    "id": "s0236",
    "blockIndex": 53,
    "zh": "春，正月，丁丑，魏初建六官，以宇文泰為太師、大塚宰，柱國李弼為太傅、大司徒，趙貴為太保、大宗伯，獨孤信為大司馬，於謹為大司寇，侯莫陳崇為大司空。"
  },
  {
    "id": "s0236",
    "blockIndex": 53,
    "zh": "自餘百官，皆仿《周禮》。"
  },
  {
    "id": "s0238",
    "blockIndex": 54,
    "zh": "戊寅，大赦，其與任約、徐嗣徽同謀者，一無所問。"
  },
  {
    "id": "s0238",
    "blockIndex": 54,
    "zh": "癸未，陳霸先使從事中郎江旰說徐嗣徽使南歸，嗣徽執旰送齊。"
  },
  {
    "id": "s0240",
    "blockIndex": 55,
    "zh": "陳茜、周文育合軍攻杜龕於吳興。"
  },
  {
    "id": "s0240",
    "blockIndex": 55,
    "zh": "龕勇而無謀，嗜酒常醉，其將杜泰陰與茜等通。"
  },
  {
    "id": "s0240",
    "blockIndex": 55,
    "zh": "龕與茜等戰，敗，泰因說龕使降，龕然之。"
  },
  {
    "id": "s0240",
    "blockIndex": 55,
    "zh": "其妻王氏曰：「霸先仇隙如此，何可求和！"
  },
  {
    "id": "s0240",
    "blockIndex": 55,
    "zh": "」因出私財賞募，復擊茜等，大破之。"
  },
  {
    "id": "s0240",
    "blockIndex": 55,
    "zh": "既而杜泰降於茜，龕尚醉未覺，茜遣人負出，於項王寺前斬之。"
  },
  {
    "id": "s0240",
    "blockIndex": 55,
    "zh": "王僧智與其弟豫章太守僧愔俱奔齊。"
  },
  {
    "id": "s0247",
    "blockIndex": 56,
    "zh": "東揚州刺史張彪素為王僧辯所厚，不附霸先。"
  },
  {
    "id": "s0247",
    "blockIndex": 56,
    "zh": "二月，庚戌，陳茜、周文育輕兵襲會稽，彪兵敗，走入若邪山中，茜遣其將吳興章昭遠追斬之。"
  },
  {
    "id": "s0247",
    "blockIndex": 56,
    "zh": "東陽太守留異饋茜糧食，霸先以異為縉州刺史。"
  },
  {
    "id": "s0250",
    "blockIndex": 57,
    "zh": "江州刺史侯瑱本事王僧辯，亦擁兵據豫章及江州，不附霸先。"
  },
  {
    "id": "s0250",
    "blockIndex": 57,
    "zh": "霸先以周文育為南豫州刺史，使將兵擊湓城，庚申，又遣侯安都、周鐵虎將舟師立柵於梁山，以備江州。"
  },
  {
    "id": "s0252",
    "blockIndex": 58,
    "zh": "癸亥，徐嗣徽、任約襲採石，執戍主明州刺史張懷鈞送於齊。"
  },
  {
    "id": "s0253",
    "blockIndex": 59,
    "zh": "後梁主擊侯平於公安，平與長沙王韶引兵還長沙。"
  },
  {
    "id": "s0253",
    "blockIndex": 59,
    "zh": "王琳遣平鎮巴州。"
  },
  {
    "id": "s0255",
    "blockIndex": 60,
    "zh": "三月，壬午，詔雜用古今錢。"
  },
  {
    "id": "s0256",
    "blockIndex": 61,
    "zh": "戊戌，齊遣儀同三司蕭軌、庫狄伏連、堯難宗、東方老等與任約、徐嗣徽合兵十萬入寇，出柵口，向梁山。"
  },
  {
    "id": "s0256",
    "blockIndex": 61,
    "zh": "陳霸先帳內蕩主黃叢逆擊，破之，齊師退保蕪湖。"
  },
  {
    "id": "s0256",
    "blockIndex": 61,
    "zh": "霸先遣定州刺史沈泰等就侯安都，共據梁山以御之。"
  },
  {
    "id": "s0256",
    "blockIndex": 61,
    "zh": "周文育攻湓城，未克，召之還。"
  },
  {
    "id": "s0256",
    "blockIndex": 61,
    "zh": "夏，四月，丁巳，霸先如梁山巡撫諸軍。"
  },
  {
    "id": "s0261",
    "blockIndex": 62,
    "zh": "乙丑，齊儀同三司婁睿討魯陽蠻，破之。"
  },
  {
    "id": "s0262",
    "blockIndex": 63,
    "zh": "侯安都輕兵襲齊行台司馬恭於歷陽，大破之，俘獲萬計。"
  },
  {
    "id": "s0263",
    "blockIndex": 64,
    "zh": "魏太師泰尚孝武妹馮翊公主，生略陽公覺；"
  },
  {
    "id": "s0263",
    "blockIndex": 64,
    "zh": "姚夫人生寧都公毓。"
  },
  {
    "id": "s0263",
    "blockIndex": 64,
    "zh": "毓於諸子最長，娶大司馬獨孤信女。"
  },
  {
    "id": "s0263",
    "blockIndex": 64,
    "zh": "泰將立嗣，謂公卿曰：「孤欲立子以嫡，恐大司馬有疑，如何？"
  },
  {
    "id": "s0263",
    "blockIndex": 64,
    "zh": "」眾默然，未有言者。"
  },
  {
    "id": "s0263",
    "blockIndex": 64,
    "zh": "尚書左僕射李遠曰：「夫立子以嫡不以長，略陽公為世子，公何所疑！"
  },
  {
    "id": "s0263",
    "blockIndex": 64,
    "zh": "若以信為嫌，請先斬之。"
  },
  {
    "id": "s0263",
    "blockIndex": 64,
    "zh": "」遂拔刀而起。"
  },
  {
    "id": "s0263",
    "blockIndex": 64,
    "zh": "泰亦起，曰：「何至於是！"
  },
  {
    "id": "s0263",
    "blockIndex": 64,
    "zh": "」信又自陳解，遠乃止。"
  },
  {
    "id": "s0263",
    "blockIndex": 64,
    "zh": "於是群公並從遠議。"
  },
  {
    "id": "s0263",
    "blockIndex": 64,
    "zh": "遠出外，拜謝信曰：「臨大事不得不爾！"
  },
  {
    "id": "s0263",
    "blockIndex": 64,
    "zh": "」信亦謝遠曰：「今日賴公決此大議。"
  },
  {
    "id": "s0263",
    "blockIndex": 64,
    "zh": "」遂立覺為世子。"
  },
  {
    "id": "s0277",
    "blockIndex": 65,
    "zh": "太師泰北巡。"
  },
  {
    "id": "s0278",
    "blockIndex": 66,
    "zh": "五月，齊人召建安公淵明，詐許退師，陳霸先具舟送之。"
  },
  {
    "id": "s0278",
    "blockIndex": 66,
    "zh": "癸未，淵明疽發背卒。"
  },
  {
    "id": "s0278",
    "blockIndex": 66,
    "zh": "甲申，齊兵發蕪湖，庚寅，入丹楊縣，丙申，至秣稜故治。"
  },
  {
    "id": "s0278",
    "blockIndex": 66,
    "zh": "陳霸先遣周文育屯方山，徐度頓馬牧，杜稜頓大航南以御之。"
  },
  {
    "id": "s0282",
    "blockIndex": 67,
    "zh": "齊漢陽敬懷王洽卒。"
  },
  {
    "id": "s0283",
    "blockIndex": 68,
    "zh": "辛丑，齊人跨淮，立橋柵渡兵，夜至方山。"
  },
  {
    "id": "s0283",
    "blockIndex": 68,
    "zh": "徐嗣徽等列艦於青墩，至於七磯，以斷周文育歸路。"
  },
  {
    "id": "s0283",
    "blockIndex": 68,
    "zh": "文育鼓噪而發，嗣徽等不能制；"
  },
  {
    "id": "s0283",
    "blockIndex": 68,
    "zh": "至旦，反攻嗣徽。"
  },
  {
    "id": "s0283",
    "blockIndex": 68,
    "zh": "嗣徽驍將鮑砰獨以小艦殿軍，文育乘單舴艋與戰，跳入艦中，斬砰，仍牽其艦而還。"
  },
  {
    "id": "s0283",
    "blockIndex": 68,
    "zh": "嗣徽眾大駭，因留船蕪湖，自丹楊步上。"
  },
  {
    "id": "s0283",
    "blockIndex": 68,
    "zh": "陳霸先追侯安都、徐度皆還。"
  },
  {
    "id": "s0290",
    "blockIndex": 69,
    "zh": "癸卯，齊兵自方山進及倪塘，游騎至台，建康震駭。"
  },
  {
    "id": "s0290",
    "blockIndex": 69,
    "zh": "帝總禁兵出頓長樂寺，內外纂嚴。"
  },
  {
    "id": "s0290",
    "blockIndex": 69,
    "zh": "霸先拒嗣徽等於白城，適與周文育會。"
  },
  {
    "id": "s0290",
    "blockIndex": 69,
    "zh": "將戰，風急，霸先曰：「兵不逆風。"
  },
  {
    "id": "s0290",
    "blockIndex": 69,
    "zh": "」文育曰：「事急矣，何用古法！"
  },
  {
    "id": "s0290",
    "blockIndex": 69,
    "zh": "」抽槊上馬先進，眾軍從之，風亦尋轉，殺傷數百人。"
  },
  {
    "id": "s0290",
    "blockIndex": 69,
    "zh": "侯安都與嗣徽等戰於耕壇南，安都帥十二騎突其陳，破之，生擒齊儀同三司乞伏無勞。"
  },
  {
    "id": "s0290",
    "blockIndex": 69,
    "zh": "霸先潛撤精卒三千配沈泰渡江，襲齊行台趙彥深於瓜步，獲艦百餘艘，粟萬斛。"
  },
  {
    "id": "s0298",
    "blockIndex": 70,
    "zh": "六月，甲辰，齊兵潛至鐘山，侯安都與齊將王敬寶戰於龍尾，軍主張纂戰死。"
  },
  {
    "id": "s0298",
    "blockIndex": 70,
    "zh": "丁未，齊師至幕府山，霸先遣別將錢明將水軍出江乘，邀擊齊人糧運，盡獲其船米。"
  },
  {
    "id": "s0298",
    "blockIndex": 70,
    "zh": "齊軍乏食，殺馬驢食之。"
  },
  {
    "id": "s0298",
    "blockIndex": 70,
    "zh": "庚戌，齊軍逾鐘山，霸先與眾軍分頓樂游苑東及覆舟山北，斷其衝要。"
  },
  {
    "id": "s0298",
    "blockIndex": 70,
    "zh": "壬子，齊軍至玄武湖西北，將據北郊壇，眾軍自覆舟東移頓壇北，與齊人相對。"
  },
  {
    "id": "s0303",
    "blockIndex": 71,
    "zh": "會連日大雨，平地水丈餘，齊軍晝夜坐立泥中，足指皆爛，懸鬲以爨，而台中及潮溝北路燥，梁軍每得番易。"
  },
  {
    "id": "s0303",
    "blockIndex": 71,
    "zh": "時四方壅隔，糧運不至，建康戶口流散，徵求無所。"
  },
  {
    "id": "s0303",
    "blockIndex": 71,
    "zh": "甲寅，少霽，霸先將戰，調市人得麥飯，分給軍士，士皆饑疲。"
  },
  {
    "id": "s0303",
    "blockIndex": 71,
    "zh": "會陳茜饋米三千斛、鴨千頭，霸先命炊米煮鴨，人人以荷葉裹飯，緄以鴨肉數臠。"
  },
  {
    "id": "s0303",
    "blockIndex": 71,
    "zh": "乙卯，未明，蓐食，比曉，霸先帥麾下出莫府山。"
  },
  {
    "id": "s0303",
    "blockIndex": 71,
    "zh": "侯安都謂其部將蕭摩訶曰：「卿驍勇有名，千聞不如一見。"
  },
  {
    "id": "s0303",
    "blockIndex": 71,
    "zh": "」摩訶對曰：「今日令公見之。"
  },
  {
    "id": "s0303",
    "blockIndex": 71,
    "zh": "」及戰，安都墜馬，齊人圍之，摩訶單騎大呼，直衝齊軍，齊軍披靡，安都乃免。"
  },
  {
    "id": "s0303",
    "blockIndex": 71,
    "zh": "霸先與吳明徹、沈泰等眾軍首尾齊舉，縱兵大戰，安都自白下引兵橫出其後，齊師大潰，斬獲數千人，相蹂籍而死者不可勝計。"
  },
  {
    "id": "s0303",
    "blockIndex": 71,
    "zh": "生擒徐嗣徽及其弟嗣宗，斬之以徇，追奔至於臨沂。"
  },
  {
    "id": "s0303",
    "blockIndex": 71,
    "zh": "其江乘、攝山、鐘山等諸軍相次克捷，虜蕭軌、東方老、王敬寶等將帥凡四十六人。"
  },
  {
    "id": "s0303",
    "blockIndex": 71,
    "zh": "其軍士得竄至江者，縛荻筏以濟，中江而溺，流屍至京口，翳水彌岸；"
  },
  {
    "id": "s0303",
    "blockIndex": 71,
    "zh": "唯任約、王僧愔得免。"
  },
  {
    "id": "s0303",
    "blockIndex": 71,
    "zh": "丁巳，眾軍出南州，燒齊舟艦。"
  },
  {
    "id": "s0317",
    "blockIndex": 72,
    "zh": "戊午，大赦。"
  },
  {
    "id": "s0317",
    "blockIndex": 72,
    "zh": "己未，解嚴。"
  },
  {
    "id": "s0317",
    "blockIndex": 72,
    "zh": "軍士以賞俘貿酒，一人裁得一醉。"
  },
  {
    "id": "s0317",
    "blockIndex": 72,
    "zh": "庚申，斬齊將蕭軌等，齊人聞之，亦殺陳曇朗。"
  },
  {
    "id": "s0317",
    "blockIndex": 72,
    "zh": "霸先啟解南徐州以授侯安都。"
  },
  {
    "id": "s0322",
    "blockIndex": 73,
    "zh": "侯平頻破後梁軍，以王琳兵威不接，更不受指麾；"
  },
  {
    "id": "s0322",
    "blockIndex": 73,
    "zh": "琳遣將討之。"
  },
  {
    "id": "s0322",
    "blockIndex": 73,
    "zh": "平殺巴州助防呂旬，收其眾，奔江州，侯瑱與之結為兄弟。"
  },
  {
    "id": "s0322",
    "blockIndex": 73,
    "zh": "琳軍勢益衰，乙丑，遣使奉表詣齊，並獻馴象。"
  },
  {
    "id": "s0322",
    "blockIndex": 73,
    "zh": "江陵之陷也，琳妻蔡氏、世子毅皆沒於魏，琳又獻款於魏以求妻子；"
  },
  {
    "id": "s0322",
    "blockIndex": 73,
    "zh": "亦稱臣於梁。"
  },
  {
    "id": "s0328",
    "blockIndex": 74,
    "zh": "齊發丁匠三十餘萬，修廣三台宮殿。"
  },
  {
    "id": "s0329",
    "blockIndex": 75,
    "zh": "齊顯祖之初立也，留心政術，務存簡靖，坦於任使，人得盡力。"
  },
  {
    "id": "s0329",
    "blockIndex": 75,
    "zh": "又能以法馭下，或有違犯，不容勳戚，內外莫不肅然。"
  },
  {
    "id": "s0329",
    "blockIndex": 75,
    "zh": "至於軍國機策，獨決懷抱；"
  },
  {
    "id": "s0329",
    "blockIndex": 75,
    "zh": "每臨行陣，親當矢石，所向有功。"
  },
  {
    "id": "s0329",
    "blockIndex": 75,
    "zh": "數年之後，漸以功業自矜，遂嗜酒淫泆，肆行狂暴；"
  },
  {
    "id": "s0329",
    "blockIndex": 75,
    "zh": "或身自歌舞，盡日通宵；"
  },
  {
    "id": "s0329",
    "blockIndex": 75,
    "zh": "或散發胡服，雜衣錦彩；"
  },
  {
    "id": "s0329",
    "blockIndex": 75,
    "zh": "或袒露形體，塗傅粉黛；"
  },
  {
    "id": "s0329",
    "blockIndex": 75,
    "zh": "或乘牛、驢、橐駝、白象，不施鞍勒；"
  },
  {
    "id": "s0329",
    "blockIndex": 75,
    "zh": "或令崔季舒、劉桃枝負之而行，擔胡鼓拍之；"
  },
  {
    "id": "s0329",
    "blockIndex": 75,
    "zh": "勳戚之第，朝夕臨幸，遊行市裡，街坐巷宿；"
  },
  {
    "id": "s0329",
    "blockIndex": 75,
    "zh": "或盛夏日中暴身，或隆冬去衣馳走；"
  },
  {
    "id": "s0329",
    "blockIndex": 75,
    "zh": "從者不堪，帝居之自若。"
  },
  {
    "id": "s0329",
    "blockIndex": 75,
    "zh": "三台構木高二十七丈，兩棟相距二百餘尺，工匠危怯，皆繫繩自防，帝登脊疾走，殊無怖畏；"
  },
  {
    "id": "s0329",
    "blockIndex": 75,
    "zh": "時復雅舞，折旋中節，傍人見者莫不寒心。"
  },
  {
    "id": "s0329",
    "blockIndex": 75,
    "zh": "嘗於道上問婦人曰：「天子何如？"
  },
  {
    "id": "s0329",
    "blockIndex": 75,
    "zh": "」曰：「顛顛癡癡，何成天子！"
  },
  {
    "id": "s0329",
    "blockIndex": 75,
    "zh": "」帝殺之。"
  },
  {
    "id": "s0347",
    "blockIndex": 76,
    "zh": "婁太后以帝酒狂，舉杖擊之曰：「如此父生如此兒！"
  },
  {
    "id": "s0347",
    "blockIndex": 76,
    "zh": "」帝曰：「即當嫁此老母與胡。"
  },
  {
    "id": "s0347",
    "blockIndex": 76,
    "zh": "」太后大怒，遂不言笑。"
  },
  {
    "id": "s0347",
    "blockIndex": 76,
    "zh": "帝欲太后笑，自匍匐以身舉床，墜太后於地，頗有所傷。"
  },
  {
    "id": "s0347",
    "blockIndex": 76,
    "zh": "既醒，大慚恨，使積柴熾火，欲入其中。"
  },
  {
    "id": "s0347",
    "blockIndex": 76,
    "zh": "太后驚懼，親自持挽，強為之笑，曰：「向汝醉耳！"
  },
  {
    "id": "s0347",
    "blockIndex": 76,
    "zh": "」帝乃設地席，命平秦王歸彥執杖，口自責數，脫背就罰，謂歸彥曰：「杖不出血，當斬汝。"
  },
  {
    "id": "s0347",
    "blockIndex": 76,
    "zh": "」太后前自抱之，帝流涕苦請，乃笞腳五十，然後衣冠拜謝，悲不自勝。"
  },
  {
    "id": "s0347",
    "blockIndex": 76,
    "zh": "因是戒酒，一旬，又復如初。"
  },
  {
    "id": "s0356",
    "blockIndex": 77,
    "zh": "帝幸李後家，以鳴鏑射後母崔氏，罵曰：「吾醉時尚不識太后，老婢何事！"
  },
  {
    "id": "s0356",
    "blockIndex": 77,
    "zh": "」馬鞭亂擊一百有餘。"
  },
  {
    "id": "s0356",
    "blockIndex": 77,
    "zh": "雖以楊愔為宰相，使進廁籌，以馬鞭鞭其背，流血浹袍。"
  },
  {
    "id": "s0356",
    "blockIndex": 77,
    "zh": "嘗欲以小刀嫠其腹，崔季舒托俳言曰：「老小公子惡戲。"
  },
  {
    "id": "s0356",
    "blockIndex": 77,
    "zh": "」因掣刀去之。"
  },
  {
    "id": "s0356",
    "blockIndex": 77,
    "zh": "又置愔於棺中，載以□車。"
  },
  {
    "id": "s0356",
    "blockIndex": 77,
    "zh": "又嘗持槊走馬，以擬左丞相斛律金之胸者三，金立不動，乃賜帛千段。"
  },
  {
    "id": "s0363",
    "blockIndex": 78,
    "zh": "高氏婦女不問親疏，多與之亂，或以賜左右，又多方苦辱之。"
  },
  {
    "id": "s0363",
    "blockIndex": 78,
    "zh": "彭城王浟太妃爾朱氏，魏敬宗之後也，帝欲蒸之，不從；"
  },
  {
    "id": "s0363",
    "blockIndex": 78,
    "zh": "手刃殺之。"
  },
  {
    "id": "s0363",
    "blockIndex": 78,
    "zh": "故魏樂安王元昂，李後之姊婿也，其妻有色，帝數幸之，欲納為昭儀。"
  },
  {
    "id": "s0363",
    "blockIndex": 78,
    "zh": "召昂，令伏，以鳴鏑射之百餘下，凝血垂將一石，竟至於死。"
  },
  {
    "id": "s0363",
    "blockIndex": 78,
    "zh": "後啼不食，乞讓位於姊，太后又以為言，帝乃止。"
  },
  {
    "id": "s0369",
    "blockIndex": 79,
    "zh": "又嘗於眾中召都督韓哲，無罪，斬之。"
  },
  {
    "id": "s0369",
    "blockIndex": 79,
    "zh": "作大鑊、長鋸、坐刀、碓之屬，陳之於庭。"
  },
  {
    "id": "s0369",
    "blockIndex": 79,
    "zh": "每醉，輒手殺人，以為戲樂。"
  },
  {
    "id": "s0369",
    "blockIndex": 79,
    "zh": "所殺者多令支解，或焚之於火，或投之於水。"
  },
  {
    "id": "s0369",
    "blockIndex": 79,
    "zh": "楊愔乃簡鄴下死囚，置之仗內，謂之供御囚，帝欲殺人，輒執以應命。"
  },
  {
    "id": "s0369",
    "blockIndex": 79,
    "zh": "三月不殺，則宥之。"
  },
  {
    "id": "s0375",
    "blockIndex": 80,
    "zh": "開府參軍裴謂之上書極諫，帝謂楊愔曰：「此愚人，何敢如是！"
  },
  {
    "id": "s0375",
    "blockIndex": 80,
    "zh": "」對曰：「彼欲陛下殺之，以成名於後世耳。"
  },
  {
    "id": "s0375",
    "blockIndex": 80,
    "zh": "」帝曰：「小人，我且不殺，爾焉得名！"
  },
  {
    "id": "s0375",
    "blockIndex": 80,
    "zh": "」帝與左右飲，曰：「樂哉！"
  },
  {
    "id": "s0375",
    "blockIndex": 80,
    "zh": "」都督王紘曰：「有大樂，亦有大苦。"
  },
  {
    "id": "s0375",
    "blockIndex": 80,
    "zh": "帝曰：「何謂也？"
  },
  {
    "id": "s0375",
    "blockIndex": 80,
    "zh": "」對曰：「長夜之飲，不寤國亡身隕，所謂大苦！"
  },
  {
    "id": "s0375",
    "blockIndex": 80,
    "zh": "」帝縛紘，欲斬之，思其有救世宗之功，乃捨之。"
  },
  {
    "id": "s0383",
    "blockIndex": 81,
    "zh": "帝游宴東山，以關、隴未平，投杯震怒，召魏收於前，立為詔書，宣示遠近，將事西行。"
  },
  {
    "id": "s0383",
    "blockIndex": 81,
    "zh": "魏人震恐，常為度隴之計。"
  },
  {
    "id": "s0383",
    "blockIndex": 81,
    "zh": "然實未行。"
  },
  {
    "id": "s0383",
    "blockIndex": 81,
    "zh": "一日，泣謂群臣曰：「黑獺不受我命，奈何？"
  },
  {
    "id": "s0383",
    "blockIndex": 81,
    "zh": "」都督劉桃枝曰：「臣得三千騎，請就長安擒之以來。"
  },
  {
    "id": "s0383",
    "blockIndex": 81,
    "zh": "」帝壯之，賜帛千匹。"
  },
  {
    "id": "s0383",
    "blockIndex": 81,
    "zh": "趙道德進曰：「東西兩國，強弱力均，彼可擒之以來，此亦可擒之以往。"
  },
  {
    "id": "s0383",
    "blockIndex": 81,
    "zh": "桃枝妄言應誅，陛下奈何濫賞！"
  },
  {
    "id": "s0383",
    "blockIndex": 81,
    "zh": "」帝曰：「道德言是。"
  },
  {
    "id": "s0383",
    "blockIndex": 81,
    "zh": "」回絹賜之。"
  },
  {
    "id": "s0383",
    "blockIndex": 81,
    "zh": "帝乘馬欲下峻岸入於漳，道德攬轡回之。"
  },
  {
    "id": "s0383",
    "blockIndex": 81,
    "zh": "帝怒，將斬之。"
  },
  {
    "id": "s0383",
    "blockIndex": 81,
    "zh": "道德曰：「臣死不恨！"
  },
  {
    "id": "s0383",
    "blockIndex": 81,
    "zh": "當於地下啟先帝：論此兒酣酗顛狂，不可教訓！"
  },
  {
    "id": "s0383",
    "blockIndex": 81,
    "zh": "」帝默然而止。"
  },
  {
    "id": "s0383",
    "blockIndex": 81,
    "zh": "它日，帝謂道德曰：「我飲酒過，須痛杖我。"
  },
  {
    "id": "s0383",
    "blockIndex": 81,
    "zh": "」道德抶之，帝走。"
  },
  {
    "id": "s0383",
    "blockIndex": 81,
    "zh": "道德逐之曰：「何物人，為此舉止！"
  },
  {
    "id": "s0402",
    "blockIndex": 82,
    "zh": "典御丞李集面諫，比帝於桀、紂。"
  },
  {
    "id": "s0402",
    "blockIndex": 82,
    "zh": "帝令縛置流中，沉沒久之，復令引出，謂曰：「吾何如桀、紂？"
  },
  {
    "id": "s0402",
    "blockIndex": 82,
    "zh": "」集曰：「向來彌不及矣！"
  },
  {
    "id": "s0402",
    "blockIndex": 82,
    "zh": "」帝又令沉之，引出，更問，如此數四，集對如初。"
  },
  {
    "id": "s0402",
    "blockIndex": 82,
    "zh": "帝大笑曰：「天下有如此癡人，方知龍逄、比干未是俊物！"
  },
  {
    "id": "s0402",
    "blockIndex": 82,
    "zh": "」遂釋之。"
  },
  {
    "id": "s0402",
    "blockIndex": 82,
    "zh": "頃之，又被引入見，似有所諫，帝令將出要斬。"
  },
  {
    "id": "s0402",
    "blockIndex": 82,
    "zh": "其或斬或赦，莫能測焉。"
  },
  {
    "id": "s0402",
    "blockIndex": 82,
    "zh": "內外憯憯，各懷怨毒。"
  },
  {
    "id": "s0402",
    "blockIndex": 82,
    "zh": "而素能默識強記，加以嚴斷，群下戰慄，不敢為非。"
  },
  {
    "id": "s0402",
    "blockIndex": 82,
    "zh": "又能委政楊愔，愔總攝機衡，百度修敕，故時人皆言主昏於上，政清於下。"
  },
  {
    "id": "s0402",
    "blockIndex": 82,
    "zh": "愔風表鑒裁，為朝野所重，少歷屯□厄，及得志，有一餐之惠者必重報之，雖先嘗欲殺己者亦不問；"
  },
  {
    "id": "s0402",
    "blockIndex": 82,
    "zh": "典選二十餘年，以獎拔賢才為己任。"
  },
  {
    "id": "s0402",
    "blockIndex": 82,
    "zh": "性復強記，一見皆不忘其姓名，選人魯漫漢自言猥賤獨不見識，愔曰：「卿前在元子思坊，乘短尾牝驢，見我不下，以方麴障面，我何為不識卿！"
  },
  {
    "id": "s0402",
    "blockIndex": 82,
    "zh": "」漫漢驚服。"
  },
  {
    "id": "s0417",
    "blockIndex": 83,
    "zh": "秋，七月，甲戌，前天門太守樊毅襲武陵，殺武州刺史衡陽王護；"
  },
  {
    "id": "s0417",
    "blockIndex": 83,
    "zh": "王琳使司馬潘忠擊之，執毅以歸。"
  },
  {
    "id": "s0417",
    "blockIndex": 83,
    "zh": "護，暢之孫也。"
  },
  {
    "id": "s0420",
    "blockIndex": 84,
    "zh": "丙子，以陳霸先為中書監、司徒、揚州刺史，進爵長城公，餘如故。"
  },
  {
    "id": "s0421",
    "blockIndex": 85,
    "zh": "初，余孝頃為豫章太守，侯瑱鎮豫章，孝頃於新吳縣別立城柵，與瑱相拒。"
  },
  {
    "id": "s0421",
    "blockIndex": 85,
    "zh": "瑱使其從弟奫守豫章，悉眾攻孝頃，久不克，築長圍守之。"
  },
  {
    "id": "s0421",
    "blockIndex": 85,
    "zh": "癸酉，侯平發兵攻奫，大掠豫章，焚之，奔於建康。"
  },
  {
    "id": "s0421",
    "blockIndex": 85,
    "zh": "瑱眾潰，奔湓城，依其將焦僧度。"
  },
  {
    "id": "s0421",
    "blockIndex": 85,
    "zh": "僧度勸之奔齊，會霸先使記室濟陽蔡景歷南上，說瑱令降，瑱乃詣闕歸罪，霸先為之誅侯平。"
  },
  {
    "id": "s0421",
    "blockIndex": 85,
    "zh": "丁亥，以瑱為司空。"
  },
  {
    "id": "s0427",
    "blockIndex": 86,
    "zh": "南昌民熊曇朗，世為郡著姓。"
  },
  {
    "id": "s0427",
    "blockIndex": 86,
    "zh": "曇朗有勇力，侯景之亂，聚眾據豐城為柵，世祖以為巴山太守。"
  },
  {
    "id": "s0427",
    "blockIndex": 86,
    "zh": "江陵陷，曇朗兵力浸強，侵掠鄰縣。"
  },
  {
    "id": "s0427",
    "blockIndex": 86,
    "zh": "侯瑱在豫章，曇朗外示服從而陰圖之，及瑱敗走，曇朗獲其馬仗。"
  },
  {
    "id": "s0431",
    "blockIndex": 87,
    "zh": "己亥，齊大赦。"
  },
  {
    "id": "s0432",
    "blockIndex": 88,
    "zh": "魏太師泰遣安州長史鉗耳康買使於王琳，琳遣長史席豁報之，且請歸世祖及愍懷太子之柩；"
  },
  {
    "id": "s0432",
    "blockIndex": 88,
    "zh": "泰許之。"
  },
  {
    "id": "s0434",
    "blockIndex": 89,
    "zh": "八月，己酉，鄱陽王循卒於江夏，弟豐城侯泰監郢州事。"
  },
  {
    "id": "s0434",
    "blockIndex": 89,
    "zh": "王琳使兗州刺史吳藏攻江夏，不克而死。"
  },
  {
    "id": "s0436",
    "blockIndex": 90,
    "zh": "魏太師泰北渡河。"
  },
  {
    "id": "s0437",
    "blockIndex": 91,
    "zh": "魏以王琳為大將軍、長沙郡公。"
  },
  {
    "id": "s0438",
    "blockIndex": 92,
    "zh": "魏江州刺史陸騰討陵州叛獠，獠因山為城，攻之難拔。"
  },
  {
    "id": "s0438",
    "blockIndex": 92,
    "zh": "騰乃陳伎樂於城下一面，獠棄兵，攜妻子臨城觀之，騰潛師三面俱上，斬首萬五千級，遂平之。"
  },
  {
    "id": "s0438",
    "blockIndex": 92,
    "zh": "騰，俟之玄孫也。"
  },
  {
    "id": "s0441",
    "blockIndex": 93,
    "zh": "庚申，齊主將西巡，百官辭於紫陌，帝使槊騎圍之，曰：「我舉鞭，即殺之。"
  },
  {
    "id": "s0441",
    "blockIndex": 93,
    "zh": "」日晏，帝醉不能起。"
  },
  {
    "id": "s0441",
    "blockIndex": 93,
    "zh": "黃門郎是連子暢曰：「陛下如此，群臣不勝恐怖。"
  },
  {
    "id": "s0441",
    "blockIndex": 93,
    "zh": "」帝曰：「大怖邪？"
  },
  {
    "id": "s0441",
    "blockIndex": 93,
    "zh": "若然，勿殺。"
  },
  {
    "id": "s0441",
    "blockIndex": 93,
    "zh": "」遂如晉陽。"
  },
  {
    "id": "s0447",
    "blockIndex": 94,
    "zh": "九月，壬寅，改元，大赦。"
  },
  {
    "id": "s0447",
    "blockIndex": 94,
    "zh": "以陳霸先為丞相、錄尚書事、鎮衛大將軍、揚州牧、義興公。"
  },
  {
    "id": "s0447",
    "blockIndex": 94,
    "zh": "以吏部尚書王通為右僕射。"
  },
  {
    "id": "s0450",
    "blockIndex": 95,
    "zh": "突厥木桿可汗假道於涼州以襲吐谷渾，魏太師泰使涼州刺史史寧帥騎隨之，至番禾，吐谷渾覺之，奔南山。"
  },
  {
    "id": "s0450",
    "blockIndex": 95,
    "zh": "木桿將分兵追之，寧曰：「樹敦、賀真二城，吐谷渾之巢穴也。"
  },
  {
    "id": "s0450",
    "blockIndex": 95,
    "zh": "拔其本根，餘眾自散。"
  },
  {
    "id": "s0450",
    "blockIndex": 95,
    "zh": "」木桿從之。"
  },
  {
    "id": "s0450",
    "blockIndex": 95,
    "zh": "木桿從北道趣賀真，寧從南道趣樹敦。"
  },
  {
    "id": "s0450",
    "blockIndex": 95,
    "zh": "吐谷渾可汗誇呂在賀真，使其征南王將數千人守樹敦。"
  },
  {
    "id": "s0450",
    "blockIndex": 95,
    "zh": "木桿破賀真，獲誇呂妻子；"
  },
  {
    "id": "s0450",
    "blockIndex": 95,
    "zh": "寧破樹敦，虜征南王，還，與木桿會於青海，木桿歎寧勇決，贈遺甚厚。"
  },
  {
    "id": "s0450",
    "blockIndex": 95,
    "zh": "甲子，王琳以舟師襲江夏；"
  },
  {
    "id": "s0450",
    "blockIndex": 95,
    "zh": "冬，十月，壬申，豐城侯泰以州降之。"
  },
  {
    "id": "s0460",
    "blockIndex": 96,
    "zh": "齊發山東寡婦二千六百人以配軍，有夫而濫奪者什二三。"
  },
  {
    "id": "s0461",
    "blockIndex": 97,
    "zh": "魏安定文公宇文泰還至牽屯山而病，驛召中山公護。"
  },
  {
    "id": "s0461",
    "blockIndex": 97,
    "zh": "護至涇州，見泰，泰謂護曰：「吾諸子皆幼，外寇方強，天下之事，屬之於汝，宜努力以成吾志。"
  },
  {
    "id": "s0461",
    "blockIndex": 97,
    "zh": "」乙亥，卒於雲陽。"
  },
  {
    "id": "s0461",
    "blockIndex": 97,
    "zh": "護還長安，發喪。"
  },
  {
    "id": "s0461",
    "blockIndex": 97,
    "zh": "泰能駕御英豪，得其力用，性好質素，不尚虛飾，明達政事，崇儒好古，凡所施設，皆依仿三代而為之。"
  },
  {
    "id": "s0461",
    "blockIndex": 97,
    "zh": "丙子，世子覺嗣位，為太師、柱國、大塚宰，出鎮同州，時年十五。"
  },
  {
    "id": "s0467",
    "blockIndex": 98,
    "zh": "中山公護，名位素卑，雖為泰所屬，而群公各圖執政，莫肯服從。"
  },
  {
    "id": "s0467",
    "blockIndex": 98,
    "zh": "護問計於大司寇於謹，謹曰：「謹早蒙先公非常之知，恩深骨肉，今日之事，必以死爭之。"
  },
  {
    "id": "s0467",
    "blockIndex": 98,
    "zh": "若對眾定策，公必不得讓。"
  },
  {
    "id": "s0467",
    "blockIndex": 98,
    "zh": "」明日，群公會議，謹曰：「昔帝室傾危，非安定公無復今日。"
  },
  {
    "id": "s0467",
    "blockIndex": 98,
    "zh": "今公一旦違世，嗣子雖幼，中山公親其兄子，兼受顧托，軍國之事，理須歸之。"
  },
  {
    "id": "s0467",
    "blockIndex": 98,
    "zh": "」辭色抗厲，眾皆悚動。"
  },
  {
    "id": "s0467",
    "blockIndex": 98,
    "zh": "護曰：「此乃家事，護雖庸昧，何敢有辭！"
  },
  {
    "id": "s0467",
    "blockIndex": 98,
    "zh": "」謹素與泰等夷，護常拜之，至是，謹起而言曰：「公若統理軍國，謹等皆有所依。"
  },
  {
    "id": "s0467",
    "blockIndex": 98,
    "zh": "」遂再拜。"
  },
  {
    "id": "s0467",
    "blockIndex": 98,
    "zh": "群公迫於謹，亦再拜，於是眾議始定。"
  },
  {
    "id": "s0467",
    "blockIndex": 98,
    "zh": "護綱紀內外，撫循文武，人心遂安。"
  },
  {
    "id": "s0478",
    "blockIndex": 99,
    "zh": "十一月，辛丑，豐城侯泰奔齊，齊以為永州刺史。"
  },
  {
    "id": "s0479",
    "blockIndex": 100,
    "zh": "詔征王琳為司空，琳辭不至，留其將潘純陀監郢州，身還長沙。"
  },
  {
    "id": "s0479",
    "blockIndex": 100,
    "zh": "魏人歸其妻子。"
  },
  {
    "id": "s0481",
    "blockIndex": 101,
    "zh": "壬子，齊主詔以「魏末豪傑糾合鄉部，因緣請托，各立州郡，離大合小，公私煩費，丁口減於疇日，守令倍於昔時，且要荒向化，舊多浮偽，百室之邑，遽立州名，三戶之民，空張郡目，循名督實，事歸焉有。"
  },
  {
    "id": "s0481",
    "blockIndex": 101,
    "zh": "」於是並省三州、一百五十三郡、五百八十九縣、三鎮、二十六戍。"
  },
  {
    "id": "s0483",
    "blockIndex": 102,
    "zh": "詔分江州四郡置高州。"
  },
  {
    "id": "s0483",
    "blockIndex": 102,
    "zh": "以明威將軍黃法□為刺史，鎮巴山。"
  },
  {
    "id": "s0485",
    "blockIndex": 103,
    "zh": "十二月，壬申，以曲江侯勃為太保。"
  },
  {
    "id": "s0486",
    "blockIndex": 104,
    "zh": "甲申，魏葬安定文公。"
  },
  {
    "id": "s0486",
    "blockIndex": 104,
    "zh": "丁亥，以岐陽之地封世子覺為周公。"
  },
  {
    "id": "s0488",
    "blockIndex": 105,
    "zh": "初，侯景之亂，臨川民周續起兵郡中，始興王毅以郡讓之而去。"
  },
  {
    "id": "s0488",
    "blockIndex": 105,
    "zh": "續部將皆郡中豪族，多驕橫，續裁製之，諸將皆怨，相與殺之。"
  },
  {
    "id": "s0488",
    "blockIndex": 105,
    "zh": "續宗人迪，勇冠軍中，眾推為主。"
  },
  {
    "id": "s0488",
    "blockIndex": 105,
    "zh": "迪素寒微，恐郡人不服，以同郡周敷族望高顯，折節交之，敷亦事迪甚謹。"
  },
  {
    "id": "s0488",
    "blockIndex": 105,
    "zh": "迪據上塘，敷據故郡，朝廷以迪為衡州刺史，領臨川內史。"
  },
  {
    "id": "s0488",
    "blockIndex": 105,
    "zh": "時民遭侯景之亂，皆棄農業，群聚為盜，唯迪所部獨務農桑，各有贏儲，政教嚴明，征斂必至，餘郡乏絕者皆仰以取給。"
  },
  {
    "id": "s0488",
    "blockIndex": 105,
    "zh": "迪性質樸，不事威儀，居常徒跣，雖外列兵衛，內有女伎，挼繩破篾，傍若無人，訥於言語而襟懷信實，臨川人皆附之。"
  },
  {
    "id": "s0488",
    "blockIndex": 105,
    "zh": "齊自西河總秦戍築長城，東至於海，前後所築三千餘里，率十里一戍，其要害置州鎮，凡二十五所。"
  },
  {
    "id": "s0496",
    "blockIndex": 106,
    "zh": "魏宇文護以周公幼弱，欲早使正位以定人心。"
  },
  {
    "id": "s0496",
    "blockIndex": 106,
    "zh": "庚子，以魏恭帝詔禪位於周，使大宗伯趙貴持節奉冊，濟北公迪致皇帝璽紱；"
  },
  {
    "id": "s0496",
    "blockIndex": 106,
    "zh": "恭帝出居大司馬府。"
  },
  {
    "id": "s0499",
    "blockIndex": 107,
    "zh": "category:資治通鑑"
  }
]
