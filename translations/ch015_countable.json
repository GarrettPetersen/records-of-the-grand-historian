[
  {
    "id": "s0001",
    "blockIndex": 0,
    "zh": "起玄黓涒灘，盡柔兆閹茂，凡十五年。"
  },
  {
    "id": "s0002",
    "blockIndex": 1,
    "zh": "1冬，十一月，上行幸代。"
  },
  {
    "id": "s0003",
    "blockIndex": 1,
    "zh": "----2春，正月，自代還。"
  },
  {
    "id": "s0004",
    "blockIndex": 1,
    "zh": "----3夏，六月，梁懷王揖薨，無子。"
  },
  {
    "id": "s0005",
    "blockIndex": 1,
    "zh": "賈誼復上疏曰：「陛下即不定製，如今之勢，不過一傳、再傳，諸侯猶且人恣而不制，豪植而大強，漢法不得行矣。"
  },
  {
    "id": "s0006",
    "blockIndex": 1,
    "zh": "陛下所以為籓扞及皇太子之所恃者，唯淮陽、代二國耳。"
  },
  {
    "id": "s0007",
    "blockIndex": 1,
    "zh": "代，北邊匈奴，與強敵為鄰，能自完則足矣；"
  },
  {
    "id": "s0008",
    "blockIndex": 1,
    "zh": "而淮陽之比大諸侯，廑如黑子之著面，適足以餌大國，而不足以有所禁御。"
  },
  {
    "id": "s0009",
    "blockIndex": 1,
    "zh": "方今制在陛下，制國而令子適足以為餌，豈可謂工哉！"
  },
  {
    "id": "s0010",
    "blockIndex": 1,
    "zh": "臣之愚計，願舉淮南地以益淮陽，而為梁王立後，割淮陽北邊二、三列城與東郡以益梁。"
  },
  {
    "id": "s0011",
    "blockIndex": 1,
    "zh": "不可者，可徙代王而都睢陽。"
  },
  {
    "id": "s0012",
    "blockIndex": 1,
    "zh": "梁起於新郪而北著之河，淮陽包陳而南揵之江，則大諸侯之有異心者破膽而不敢謀。"
  },
  {
    "id": "s0013",
    "blockIndex": 1,
    "zh": "梁足以扞齊、趙，淮陽足以禁吳、楚，陛下高枕，終無山東之憂矣，此二世之利也。"
  },
  {
    "id": "s0014",
    "blockIndex": 1,
    "zh": "當今恬然，適遇諸侯之皆少；"
  },
  {
    "id": "s0015",
    "blockIndex": 1,
    "zh": "數歲之後，陛下且見之矣。"
  },
  {
    "id": "s0016",
    "blockIndex": 1,
    "zh": "夫秦日夜苦心勞力以除六國之禍；"
  },
  {
    "id": "s0017",
    "blockIndex": 1,
    "zh": "今陛下力制天下，頤指如意，高拱以成六國之禍，難以言智，苟身無事，畜亂，宿祝，孰視而不定；"
  },
  {
    "id": "s0018",
    "blockIndex": 1,
    "zh": "萬年之後，傳之老母、弱子，將使不寧，不可謂仁。"
  },
  {
    "id": "s0019",
    "blockIndex": 1,
    "zh": "」帝於是從誼計，徙淮陽王武為梁王，北界泰山，西至高陽，得大縣四十餘城。"
  },
  {
    "id": "s0020",
    "blockIndex": 1,
    "zh": "後歲餘，賈誼亦死，死時年三十三矣。"
  },
  {
    "id": "s0021",
    "blockIndex": 1,
    "zh": "----4徙城陽王喜為淮南王。"
  },
  {
    "id": "s0022",
    "blockIndex": 1,
    "zh": "----5匈奴寇狄道。"
  },
  {
    "id": "s0023",
    "blockIndex": 2,
    "zh": "時匈奴數為邊患，太子家令穎川晁錯上言兵事曰："
  },
  {
    "id": "s0024",
    "blockIndex": 3,
    "zh": ":「《兵法》曰：『有必勝之將，無必勝之民。"
  },
  {
    "id": "s0025",
    "blockIndex": 3,
    "zh": "』由此觀之，安邊境，立功名，在於良將，不可不擇也。"
  },
  {
    "id": "s0026",
    "blockIndex": 3,
    "zh": ":臣又聞，用兵臨戰合刃之急者三：一曰得地形，二曰卒服習，三曰器用利。"
  },
  {
    "id": "s0027",
    "blockIndex": 3,
    "zh": "兵法：步兵、車騎、弓弩、長戟、矛鋋、劍楯之地，各有所宜；"
  },
  {
    "id": "s0028",
    "blockIndex": 3,
    "zh": "不得其宜者，或十不當一。"
  },
  {
    "id": "s0029",
    "blockIndex": 3,
    "zh": "士不選練，卒不服習，起居不精，動靜不集，趨利弗及，避難不畢，前擊後解，與金鼓之指相失，此不習勒卒之過也，百不當十。"
  },
  {
    "id": "s0030",
    "blockIndex": 3,
    "zh": "兵不完利，與空手同；"
  },
  {
    "id": "s0031",
    "blockIndex": 3,
    "zh": "甲不堅密，與袒裼同；"
  },
  {
    "id": "s0032",
    "blockIndex": 3,
    "zh": "弩不可以及遠，與短兵同；"
  },
  {
    "id": "s0033",
    "blockIndex": 3,
    "zh": "射不能中，與無矢同；"
  },
  {
    "id": "s0034",
    "blockIndex": 3,
    "zh": "中不能入，與無鏃同；"
  },
  {
    "id": "s0035",
    "blockIndex": 3,
    "zh": "此將不省兵之禍也，五不當一。"
  },
  {
    "id": "s0036",
    "blockIndex": 3,
    "zh": "故《兵法》曰：『器械不利，以其卒予敵也；"
  },
  {
    "id": "s0037",
    "blockIndex": 3,
    "zh": "卒不可用，以其將予敵也；"
  },
  {
    "id": "s0038",
    "blockIndex": 3,
    "zh": "將不知兵，以其主予敵也；"
  },
  {
    "id": "s0039",
    "blockIndex": 3,
    "zh": "君不擇將，以其國予敵也。"
  },
  {
    "id": "s0040",
    "blockIndex": 3,
    "zh": "』四者，兵之至要也。"
  },
  {
    "id": "s0041",
    "blockIndex": 3,
    "zh": ":臣又聞：小大異形，強弱異勢，險易異備。"
  },
  {
    "id": "s0042",
    "blockIndex": 3,
    "zh": "夫卑身以事強，小國之形也；"
  },
  {
    "id": "s0043",
    "blockIndex": 3,
    "zh": "合小以攻大，敵國之形也；"
  },
  {
    "id": "s0044",
    "blockIndex": 3,
    "zh": "以蠻夷攻蠻夷，中國之形也。"
  },
  {
    "id": "s0045",
    "blockIndex": 3,
    "zh": "今匈奴地形、技藝與中國異，上下山阪，出入溪澗，中國之馬弗與也；"
  },
  {
    "id": "s0046",
    "blockIndex": 3,
    "zh": "險道傾仄，且馳且射，中國之騎弗與也；"
  },
  {
    "id": "s0047",
    "blockIndex": 3,
    "zh": "風雨罷勞，饑渴不困，中國之人弗與也；"
  },
  {
    "id": "s0048",
    "blockIndex": 3,
    "zh": "此匈奴之長技也。"
  },
  {
    "id": "s0049",
    "blockIndex": 3,
    "zh": "若夫平原、易地、輕車、突騎，則匈奴之眾易撓亂也；"
  },
  {
    "id": "s0050",
    "blockIndex": 3,
    "zh": "勁弩、長戟、射疏、及遠，則匈奴之弓弗能格也；"
  },
  {
    "id": "s0051",
    "blockIndex": 3,
    "zh": "堅甲、利刃，長短相雜，游弩往來，什伍俱前，則匈奴之兵弗能當也；"
  },
  {
    "id": "s0052",
    "blockIndex": 3,
    "zh": "材官騶發，矢道同的，則匈奴之革笥、木薦弗能支也；"
  },
  {
    "id": "s0053",
    "blockIndex": 3,
    "zh": "下馬地斗，劍戟相接，去就相薄，則匈奴之足弗能給也；"
  },
  {
    "id": "s0054",
    "blockIndex": 3,
    "zh": "此中國之長技也。"
  },
  {
    "id": "s0055",
    "blockIndex": 3,
    "zh": "以此觀之，匈奴之長技三，中國之長技五。"
  },
  {
    "id": "s0056",
    "blockIndex": 3,
    "zh": "陛下又興數十萬之眾以誅數萬之匈奴，眾寡之計，以一擊十之術也。"
  },
  {
    "id": "s0057",
    "blockIndex": 3,
    "zh": ":雖然，兵，兇器；"
  },
  {
    "id": "s0058",
    "blockIndex": 3,
    "zh": "戰，危事也。"
  },
  {
    "id": "s0059",
    "blockIndex": 3,
    "zh": "故以大為小，以強為弱，在俛仰之間耳。"
  },
  {
    "id": "s0060",
    "blockIndex": 3,
    "zh": "夫以人之死爭勝，跌而不振，則悔之無及也。"
  },
  {
    "id": "s0061",
    "blockIndex": 3,
    "zh": "帝王之道，出於萬全。"
  },
  {
    "id": "s0062",
    "blockIndex": 3,
    "zh": "今降胡、義渠、蠻夷之屬來歸誼者，其眾數千，飲食、長技與匈奴同。"
  },
  {
    "id": "s0063",
    "blockIndex": 3,
    "zh": "可賜之堅甲、絮衣、勁弓、利矢，益以邊郡之良騎，令明將能知其習俗、和輯其心者，以陛下之明約將之。"
  },
  {
    "id": "s0064",
    "blockIndex": 3,
    "zh": "即有險阻，以此當之；"
  },
  {
    "id": "s0065",
    "blockIndex": 3,
    "zh": "平地通道，則以輕車、材官制之；"
  },
  {
    "id": "s0066",
    "blockIndex": 3,
    "zh": "兩軍相為表里，各用其長技，衡加之以眾，此萬全之術也。"
  },
  {
    "id": "s0068",
    "blockIndex": 4,
    "zh": "帝嘉之，賜錯書，寵答焉。"
  },
  {
    "id": "s0069",
    "blockIndex": 5,
    "zh": "錯又上言曰：:「臣聞秦起兵而攻胡、粵者，非以衛邊地而救民死也，貪戾而欲廣大也，故功未立而天下亂。"
  },
  {
    "id": "s0070",
    "blockIndex": 5,
    "zh": "且夫起兵而不知其勢，戰則為人禽，屯則卒積死。"
  },
  {
    "id": "s0071",
    "blockIndex": 5,
    "zh": "夫胡、貉之人，其性耐寒；"
  },
  {
    "id": "s0072",
    "blockIndex": 5,
    "zh": "揚、粵之人，其性耐暑。"
  },
  {
    "id": "s0073",
    "blockIndex": 5,
    "zh": "秦之戍卒不耐其水土，戍者死於邊，輸者僨於道。"
  },
  {
    "id": "s0074",
    "blockIndex": 5,
    "zh": "秦民見行，如往棄市，因以謫發之，名曰『謫戍』；"
  },
  {
    "id": "s0075",
    "blockIndex": 5,
    "zh": "先發吏有謫及贅婿、賈人，後以嘗有市籍者，又後以大父母、父母嘗有市籍者，後入閭取其左。"
  },
  {
    "id": "s0076",
    "blockIndex": 5,
    "zh": "發之不順，行者憤怨，有萬死之害而亡銖兩之報，死事之後，不得一算之復，天下明知禍烈及己也。"
  },
  {
    "id": "s0077",
    "blockIndex": 5,
    "zh": "陳勝行戍，至於大澤，為天下先倡，天下從之如流水者，秦以威劫而行之之敝也。"
  },
  {
    "id": "s0078",
    "blockIndex": 6,
    "zh": ":胡人衣食之業，不著於地，其勢易以擾亂邊境，往來轉徙，時至時去。"
  },
  {
    "id": "s0079",
    "blockIndex": 6,
    "zh": "此胡人之生業，而中國之所以離南□也。"
  },
  {
    "id": "s0080",
    "blockIndex": 6,
    "zh": "今胡人數轉牧、行獵於塞下，以候備塞之卒，卒少則入。"
  },
  {
    "id": "s0081",
    "blockIndex": 6,
    "zh": "陛下不救，則邊民絕望而有降敵之心；"
  },
  {
    "id": "s0082",
    "blockIndex": 6,
    "zh": "救之，少發則不足，多發，遠縣才至，則胡又已去。"
  },
  {
    "id": "s0083",
    "blockIndex": 6,
    "zh": "聚而不罷，為費甚大；"
  },
  {
    "id": "s0084",
    "blockIndex": 6,
    "zh": "罷之，則胡復入。"
  },
  {
    "id": "s0085",
    "blockIndex": 6,
    "zh": "如此連年，則中國貧苦而民不安矣。"
  },
  {
    "id": "s0086",
    "blockIndex": 6,
    "zh": "陛下幸憂邊境，遣將吏發卒以治塞，甚大惠也。"
  },
  {
    "id": "s0087",
    "blockIndex": 6,
    "zh": "然今遠方之卒守塞，一歲而更，不知胡人之能。"
  },
  {
    "id": "s0088",
    "blockIndex": 6,
    "zh": "不如選常居者家室田作，且以備之，以便為之高城深塹；"
  },
  {
    "id": "s0089",
    "blockIndex": 6,
    "zh": "要害之處，通川之道，調立城邑，毋下千家。"
  },
  {
    "id": "s0090",
    "blockIndex": 6,
    "zh": "先為室屋，具田器，乃募民，免罪，拜爵，復其家，予冬夏衣、稟食，能自給而止。"
  },
  {
    "id": "s0091",
    "blockIndex": 6,
    "zh": "塞下之民，祿利不厚，不可使久居危難之地。"
  },
  {
    "id": "s0092",
    "blockIndex": 6,
    "zh": "胡人入驅而能止其所驅者，以其半予之，縣官為贖。"
  },
  {
    "id": "s0093",
    "blockIndex": 6,
    "zh": "其民如是，則邑里相救助，赴胡不避死。"
  },
  {
    "id": "s0094",
    "blockIndex": 6,
    "zh": "非以德上也，欲全親戚而利其財也；"
  },
  {
    "id": "s0095",
    "blockIndex": 6,
    "zh": "此與東方之戍卒不習地勢而心畏胡者功相萬也。"
  },
  {
    "id": "s0096",
    "blockIndex": 6,
    "zh": "以陛下之時，徙民實邊，使遠方無屯戍之事；"
  },
  {
    "id": "s0097",
    "blockIndex": 6,
    "zh": "塞下之民，父子相保，無系虜之患；"
  },
  {
    "id": "s0098",
    "blockIndex": 6,
    "zh": "利施後世，名稱聖明，其與秦之行怨民，相去遠矣。"
  },
  {
    "id": "s0100",
    "blockIndex": 7,
    "zh": "上從其言，募民徙塞下。"
  },
  {
    "id": "s0101",
    "blockIndex": 8,
    "zh": "錯復言：:「陛下幸募民徙以實塞下，使屯戍之事益省，輸將之費益寡，甚大惠也。"
  },
  {
    "id": "s0102",
    "blockIndex": 8,
    "zh": "下吏誠能稱厚惠，奉明法，存恤所徙之老弱，善遇其壯士，和輯其心而勿侵刻，使先至者安樂而不思故鄉，則貧民相慕而勸往矣。"
  },
  {
    "id": "s0103",
    "blockIndex": 8,
    "zh": "臣聞古之徙民者，相其陰陽之和，嘗其水泉之味，然後營邑、立城、制里、割宅，先為築室家，置器物焉。"
  },
  {
    "id": "s0104",
    "blockIndex": 8,
    "zh": "民至有所居，作有所用。"
  },
  {
    "id": "s0105",
    "blockIndex": 8,
    "zh": "此民所以輕去故鄉而勸之新邑也。"
  },
  {
    "id": "s0106",
    "blockIndex": 8,
    "zh": "為置醫、巫以救疾病，以修祭祀，男女有昏，生死相恤，墳墓相從，種樹畜長，室屋完安。"
  },
  {
    "id": "s0107",
    "blockIndex": 8,
    "zh": "此所以使民樂其處而有長居之心也。"
  },
  {
    "id": "s0108",
    "blockIndex": 9,
    "zh": ":臣又聞古之制邊縣以備敵也，使五家為伍，伍有長；"
  },
  {
    "id": "s0109",
    "blockIndex": 9,
    "zh": "十長一里，里有假士；"
  },
  {
    "id": "s0110",
    "blockIndex": 9,
    "zh": "四里一連，連有假五百；"
  },
  {
    "id": "s0111",
    "blockIndex": 9,
    "zh": "十連一邑，邑有假候。"
  },
  {
    "id": "s0112",
    "blockIndex": 9,
    "zh": "皆擇其邑之賢材有護、習地形、知民心者。"
  },
  {
    "id": "s0113",
    "blockIndex": 9,
    "zh": "居則習民於射法，出則教民於應敵。"
  },
  {
    "id": "s0114",
    "blockIndex": 9,
    "zh": "故卒伍成於內，則軍政定於外。"
  },
  {
    "id": "s0115",
    "blockIndex": 9,
    "zh": "服習以成，勿令遷徙，幼則同游，長則共事。"
  },
  {
    "id": "s0116",
    "blockIndex": 9,
    "zh": "夜戰聲相知，則足以相救；"
  },
  {
    "id": "s0117",
    "blockIndex": 9,
    "zh": "晝戰目相見，則足以相識；"
  },
  {
    "id": "s0118",
    "blockIndex": 9,
    "zh": "歡愛之心，足以相死。"
  },
  {
    "id": "s0119",
    "blockIndex": 9,
    "zh": "如此而勸以厚賞，威以重罰，則前死不還踵矣。"
  },
  {
    "id": "s0120",
    "blockIndex": 9,
    "zh": "所徙之民非壯有材者，但費衣糧，不可用也；"
  },
  {
    "id": "s0121",
    "blockIndex": 9,
    "zh": "雖有材力，不得良吏，猶亡功也。"
  },
  {
    "id": "s0122",
    "blockIndex": 10,
    "zh": ":陛下絕匈奴不與和親，臣竊意其冬來南也；"
  },
  {
    "id": "s0123",
    "blockIndex": 10,
    "zh": "壹大治，則終身創矣。"
  },
  {
    "id": "s0124",
    "blockIndex": 10,
    "zh": "欲立威者，始於折膠；"
  },
  {
    "id": "s0125",
    "blockIndex": 10,
    "zh": "來而不能困，使得氣去，後未易服也。"
  },
  {
    "id": "s0127",
    "blockIndex": 11,
    "zh": "錯為人峭直刻深，以其辯得幸太子，太子家號曰「智囊」。"
  },
  {
    "id": "s0128",
    "blockIndex": 11,
    "zh": "----1冬，十二月，河決酸棗，東潰金堤、東郡；"
  },
  {
    "id": "s0129",
    "blockIndex": 11,
    "zh": "大興卒塞之。"
  },
  {
    "id": "s0130",
    "blockIndex": 11,
    "zh": "----2春，三月，除關，無用傳。"
  },
  {
    "id": "s0131",
    "blockIndex": 11,
    "zh": "----3晁錯言於上曰："
  },
  {
    "id": "s0132",
    "blockIndex": 12,
    "zh": ":「聖王在上而民不凍饑者，非能耕而食之，織而衣之也，為開其資財之道也。"
  },
  {
    "id": "s0133",
    "blockIndex": 12,
    "zh": "故堯有九年之水，湯有七年之旱，而國亡捐瘠者，以畜積多而備先具也。"
  },
  {
    "id": "s0134",
    "blockIndex": 12,
    "zh": "今海內為一，土地、人民之眾不減湯、禹，加以無天災數年之水旱，而畜積未及者，何也？"
  },
  {
    "id": "s0135",
    "blockIndex": 12,
    "zh": "地有遺利，民有餘力；"
  },
  {
    "id": "s0136",
    "blockIndex": 12,
    "zh": "生谷之土未盡墾，山澤之利未盡出，游食之民未盡歸農也。"
  },
  {
    "id": "s0137",
    "blockIndex": 13,
    "zh": ":夫寒之於衣，不待輕暖；"
  },
  {
    "id": "s0138",
    "blockIndex": 13,
    "zh": "饑之於食，不待甘旨；"
  },
  {
    "id": "s0139",
    "blockIndex": 13,
    "zh": "饑寒至身，不顧廉恥。"
  },
  {
    "id": "s0140",
    "blockIndex": 13,
    "zh": "人情，一日不再食則饑，終歲不製衣則寒。"
  },
  {
    "id": "s0141",
    "blockIndex": 13,
    "zh": "夫腹饑不得食，膚寒不得衣，雖慈母不能保其子，君安能以有其民哉！"
  },
  {
    "id": "s0142",
    "blockIndex": 13,
    "zh": "明主知其然也，故務民於農桑，薄賦斂，廣畜積，以實倉廩，備水旱，故民可得而有也。"
  },
  {
    "id": "s0143",
    "blockIndex": 13,
    "zh": "民者，在上所以牧之；"
  },
  {
    "id": "s0144",
    "blockIndex": 13,
    "zh": "民之趨利，如水走下，四方無擇也。"
  },
  {
    "id": "s0145",
    "blockIndex": 14,
    "zh": ":夫珠、玉、金、銀，饑不可食，寒不可衣；"
  },
  {
    "id": "s0146",
    "blockIndex": 14,
    "zh": "然而眾貴之者，以上用之故也。"
  },
  {
    "id": "s0147",
    "blockIndex": 14,
    "zh": "其為物輕微易藏，在於把握，可以周海內而無饑寒之患。"
  },
  {
    "id": "s0148",
    "blockIndex": 14,
    "zh": "此令臣輕背其主，而民易去其鄉，盜賊有所勸，亡逃者得輕資也。"
  },
  {
    "id": "s0149",
    "blockIndex": 14,
    "zh": "粟、米、布、帛，生於地，長於時，聚於力，非可一日成也；"
  },
  {
    "id": "s0150",
    "blockIndex": 14,
    "zh": "數石之重，中人弗勝，不為奸邪所利，一日弗得而饑寒至。"
  },
  {
    "id": "s0151",
    "blockIndex": 14,
    "zh": "是故明君貴五穀而賤金玉。"
  },
  {
    "id": "s0152",
    "blockIndex": 15,
    "zh": ":今農夫五口之家，其服役者不下二人，其能耕者不過百□，百□之收不過百石。"
  },
  {
    "id": "s0153",
    "blockIndex": 15,
    "zh": "春耕，夏耘，秋獲，冬藏，伐薪樵，治官府，給繇役；"
  },
  {
    "id": "s0154",
    "blockIndex": 15,
    "zh": "春不得避風塵，夏不得避暑熱，秋不得避陰雨，冬不得避寒凍，四時之間亡日休息；"
  },
  {
    "id": "s0155",
    "blockIndex": 15,
    "zh": "又私自送往迎來、吊死問疾、養孤長幼在其中。"
  },
  {
    "id": "s0156",
    "blockIndex": 15,
    "zh": "勤苦如此，尚復被水旱之災，急政暴賦，賦斂不時，朝令而暮改。"
  },
  {
    "id": "s0157",
    "blockIndex": 15,
    "zh": "有者半賈而賣，無者取倍稱之息，於是有賣田宅、鬻子孫以償責者矣。"
  },
  {
    "id": "s0158",
    "blockIndex": 15,
    "zh": "而商賈大者積貯倍息，小者坐列販賣，操其奇贏，日游都市，乘上之急，所賣必倍。"
  },
  {
    "id": "s0159",
    "blockIndex": 15,
    "zh": "故其男不耕耘，女不蠶織，衣必文采，食必粱肉；"
  },
  {
    "id": "s0160",
    "blockIndex": 15,
    "zh": "無農夫之苦，有仟伯之得。"
  },
  {
    "id": "s0161",
    "blockIndex": 15,
    "zh": "因其富厚，交通王侯，力過吏勢，以利相傾；"
  },
  {
    "id": "s0162",
    "blockIndex": 15,
    "zh": "千里游敖，冠蓋相望，乘堅、策肥，履絲、曳縞。"
  },
  {
    "id": "s0163",
    "blockIndex": 15,
    "zh": "此商人所以兼併農人，農人所以流亡者也。"
  },
  {
    "id": "s0164",
    "blockIndex": 16,
    "zh": ":方今之務，莫若使民務農而已矣。"
  },
  {
    "id": "s0165",
    "blockIndex": 16,
    "zh": "欲民務農，在於貴粟。"
  },
  {
    "id": "s0166",
    "blockIndex": 16,
    "zh": "貴粟之道，在於使民以粟為賞罰。"
  },
  {
    "id": "s0167",
    "blockIndex": 16,
    "zh": "今募天下入粟縣官，得以拜爵，得以除罪。"
  },
  {
    "id": "s0168",
    "blockIndex": 16,
    "zh": "如此，富人有爵，農民有錢，粟有所渫。"
  },
  {
    "id": "s0169",
    "blockIndex": 16,
    "zh": "夫能入粟以受爵，皆有餘者也。"
  },
  {
    "id": "s0170",
    "blockIndex": 16,
    "zh": "取於有餘以供上用，則貧民之賦可損，所謂損有餘，補不足，令出而民利者也。"
  },
  {
    "id": "s0171",
    "blockIndex": 16,
    "zh": "今令民有車騎馬一匹者，復卒三人；"
  },
  {
    "id": "s0172",
    "blockIndex": 16,
    "zh": "車騎者，天下武備也，故為復卒。"
  },
  {
    "id": "s0173",
    "blockIndex": 16,
    "zh": "神農之教曰：『有石城十仞，湯池百步，帶甲百萬，而無粟，弗能守也。"
  },
  {
    "id": "s0174",
    "blockIndex": 16,
    "zh": "』以是觀之，粟者，王者大用，政之本務。"
  },
  {
    "id": "s0175",
    "blockIndex": 16,
    "zh": "令民入粟受爵至五大夫以上，乃復一人耳，此其與騎馬之功相去遠矣。"
  },
  {
    "id": "s0176",
    "blockIndex": 16,
    "zh": "爵者，上之所擅，出於口而無窮；"
  },
  {
    "id": "s0177",
    "blockIndex": 16,
    "zh": "粟者，民之所種，生於地而不乏。"
  },
  {
    "id": "s0178",
    "blockIndex": 16,
    "zh": "夫得高爵與免罪，人之所甚欲也；"
  },
  {
    "id": "s0179",
    "blockIndex": 16,
    "zh": "使天下人入粟於邊以受爵、免罪，不過三歲，塞下之粟必多矣。"
  },
  {
    "id": "s0181",
    "blockIndex": 17,
    "zh": "帝從之，令民入粟邊，拜爵各以多少級數為差。"
  },
  {
    "id": "s0182",
    "blockIndex": 18,
    "zh": "錯復奏言：「陛下幸使天下入粟塞下以拜爵，甚大惠也。"
  },
  {
    "id": "s0183",
    "blockIndex": 18,
    "zh": "竊恐塞卒之食不足用，大渫天下粟。"
  },
  {
    "id": "s0184",
    "blockIndex": 18,
    "zh": "邊食足以支五歲，可令入粟郡縣矣；"
  },
  {
    "id": "s0185",
    "blockIndex": 18,
    "zh": "郡縣足支一歲以上，可時赦，勿收農民租。"
  },
  {
    "id": "s0186",
    "blockIndex": 18,
    "zh": "如此，德澤加於萬民，民愈勤農，大富樂矣。"
  },
  {
    "id": "s0188",
    "blockIndex": 19,
    "zh": "上復從其言，詔曰：「道民之路，在於務本。"
  },
  {
    "id": "s0189",
    "blockIndex": 19,
    "zh": "朕親率天下農，十年於今，而野不加辟，歲一不登，民有饑色；"
  },
  {
    "id": "s0190",
    "blockIndex": 19,
    "zh": "是從事焉尚寡而吏未加務。"
  },
  {
    "id": "s0191",
    "blockIndex": 19,
    "zh": "吾詔書數下，歲勸民種樹而功未興，是吏奉吾詔不勤而勸民不明也。"
  },
  {
    "id": "s0192",
    "blockIndex": 19,
    "zh": "且吾農民甚苦而吏莫之省，將何以功焉！"
  },
  {
    "id": "s0193",
    "blockIndex": 19,
    "zh": "其賜農民今年租稅之半。"
  },
  {
    "id": "s0194",
    "blockIndex": 19,
    "zh": "」----1春，二月，甲寅，詔日；"
  },
  {
    "id": "s0195",
    "blockIndex": 19,
    "zh": "「朕親率天下農耕以供粢盛，皇后親桑以供祭服；"
  },
  {
    "id": "s0196",
    "blockIndex": 19,
    "zh": "其具禮儀。"
  },
  {
    "id": "s0197",
    "blockIndex": 19,
    "zh": "」----2初，秦時祝官有祕祝，即有災祥，輒移過於下。"
  },
  {
    "id": "s0198",
    "blockIndex": 19,
    "zh": "夏，詔曰：「蓋聞天道，禍自怨起而福繇德興，百官之非，宜由朕躬。"
  },
  {
    "id": "s0199",
    "blockIndex": 19,
    "zh": "今祕祝之官移過於下，以彰吾之不德，朕甚弗取。"
  },
  {
    "id": "s0200",
    "blockIndex": 19,
    "zh": "其除之！"
  },
  {
    "id": "s0201",
    "blockIndex": 19,
    "zh": "」----3齊太倉令淳于意有罪，當刑，詔獄逮系長安。"
  },
  {
    "id": "s0202",
    "blockIndex": 19,
    "zh": "其少女緹縈上書曰：「妾父為吏，齊中皆稱其廉平；"
  },
  {
    "id": "s0203",
    "blockIndex": 19,
    "zh": "今坐法當刑。"
  },
  {
    "id": "s0204",
    "blockIndex": 19,
    "zh": "妾傷夫死者不可復生，刑者不可復屬，雖後欲改過自新，其道無繇也。"
  },
  {
    "id": "s0205",
    "blockIndex": 19,
    "zh": "妾願沒入為官婢，以贖父刑罪，使得自新。"
  },
  {
    "id": "s0207",
    "blockIndex": 20,
    "zh": "天子憐悲其意，五月，詔曰：「《詩》曰：『愷弟君子，民之父母。"
  },
  {
    "id": "s0208",
    "blockIndex": 20,
    "zh": "』今人有過，教未施而刑已加焉，或欲改行為善而道無繇至，朕甚憐之！"
  },
  {
    "id": "s0209",
    "blockIndex": 20,
    "zh": "夫刑至斷支體，刻肌膚，終身不息，何其刑之痛而不德也！"
  },
  {
    "id": "s0210",
    "blockIndex": 20,
    "zh": "豈為民父母之意哉！"
  },
  {
    "id": "s0211",
    "blockIndex": 20,
    "zh": "其除肉刑，有以易之；"
  },
  {
    "id": "s0212",
    "blockIndex": 20,
    "zh": "及令罪人各以輕重，不記逃，有年而免。"
  },
  {
    "id": "s0213",
    "blockIndex": 20,
    "zh": "具為令！"
  },
  {
    "id": "s0215",
    "blockIndex": 21,
    "zh": "丞相張蒼、御史大夫馮敬奏請定律曰：「諸當髡者為城旦、舂；"
  },
  {
    "id": "s0216",
    "blockIndex": 21,
    "zh": "當黥者髡鉗為城旦、舂；"
  },
  {
    "id": "s0217",
    "blockIndex": 21,
    "zh": "當劓者笞三百；"
  },
  {
    "id": "s0218",
    "blockIndex": 21,
    "zh": "當斬左止者笞五百；"
  },
  {
    "id": "s0219",
    "blockIndex": 21,
    "zh": "當斬右止及殺人先自告及吏坐受賕、枉法、守縣官財物而即盜之、已論而復有笞罪皆棄市。"
  },
  {
    "id": "s0220",
    "blockIndex": 21,
    "zh": "罪人獄已決為城旦、舂者，各有歲數以免。"
  },
  {
    "id": "s0221",
    "blockIndex": 21,
    "zh": "」制曰：「可。"
  },
  {
    "id": "s0223",
    "blockIndex": 22,
    "zh": "是時，上既躬修玄默，而將相皆舊功臣，少文多質。"
  },
  {
    "id": "s0224",
    "blockIndex": 22,
    "zh": "懲惡亡秦之政，論議務在寬厚，恥言人之過失，化行天下，告訐之俗易。"
  },
  {
    "id": "s0225",
    "blockIndex": 22,
    "zh": "吏安其官，民樂其業，畜積歲增，戶口浸息。"
  },
  {
    "id": "s0226",
    "blockIndex": 22,
    "zh": "風流篤厚，禁罔疏闊，罪疑者予民，是以刑罰大省，至於斷獄四百，有刑錯之風焉。"
  },
  {
    "id": "s0227",
    "blockIndex": 22,
    "zh": "----4六月，詔曰：「農，天下之本，務莫大焉。"
  },
  {
    "id": "s0228",
    "blockIndex": 22,
    "zh": "今勤身從事而有租稅之賦，是為本末者無以異也，其於勸農之道未備。"
  },
  {
    "id": "s0229",
    "blockIndex": 22,
    "zh": "其除田之租稅。"
  },
  {
    "id": "s0230",
    "blockIndex": 22,
    "zh": "」----1冬，匈奴老上單于十四萬騎入朝那、蕭關，殺北地都尉卬，虜人民畜產甚多；"
  },
  {
    "id": "s0231",
    "blockIndex": 22,
    "zh": "遂至彭陽，使奇兵入燒回中宮，候騎至雍甘泉。"
  },
  {
    "id": "s0232",
    "blockIndex": 22,
    "zh": "帝以中尉周舍、郎中令張武為將軍，發車千乘、騎卒十萬軍長安旁，以備胡寇；"
  },
  {
    "id": "s0233",
    "blockIndex": 22,
    "zh": "而拜昌侯盧卿為上郡將軍，甯侯魏□為北地將軍，隆慮侯周灶為隴西將軍，屯三郡。"
  },
  {
    "id": "s0234",
    "blockIndex": 22,
    "zh": "上親勞軍，勒兵，申教令，賜吏卒，自欲征匈奴。"
  },
  {
    "id": "s0235",
    "blockIndex": 22,
    "zh": "群臣諫，不聽；"
  },
  {
    "id": "s0236",
    "blockIndex": 22,
    "zh": "皇太后固要，上乃止。"
  },
  {
    "id": "s0237",
    "blockIndex": 22,
    "zh": "於是以東陽侯張相如為大將軍，成侯董赤、內史欒布皆為將軍，擊匈奴。"
  },
  {
    "id": "s0238",
    "blockIndex": 22,
    "zh": "單于留塞內月餘，乃去。"
  },
  {
    "id": "s0239",
    "blockIndex": 22,
    "zh": "漢逐出塞即還，不能有所殺。"
  },
  {
    "id": "s0240",
    "blockIndex": 22,
    "zh": "----2上輦過郎署，問郎署長馮唐曰：「父家安在？"
  },
  {
    "id": "s0241",
    "blockIndex": 22,
    "zh": "」對曰：「臣大父趙人，父徙代。"
  },
  {
    "id": "s0242",
    "blockIndex": 22,
    "zh": "」上曰：「吾居代時，吾尚食監高祛數為我言趙將李齊之賢，戰於巨鹿下。"
  },
  {
    "id": "s0243",
    "blockIndex": 22,
    "zh": "今吾每飯意未嘗不在巨鹿也。"
  },
  {
    "id": "s0244",
    "blockIndex": 22,
    "zh": "父知之乎？"
  },
  {
    "id": "s0245",
    "blockIndex": 22,
    "zh": "」唐對曰：「尚不如廉頗、李牧之為將也。"
  },
  {
    "id": "s0246",
    "blockIndex": 22,
    "zh": "」上搏髀曰：「嗟乎！"
  },
  {
    "id": "s0247",
    "blockIndex": 22,
    "zh": "吾獨不得廉頗、李牧為將！"
  },
  {
    "id": "s0248",
    "blockIndex": 22,
    "zh": "吾豈憂匈奴哉！"
  },
  {
    "id": "s0249",
    "blockIndex": 22,
    "zh": "」唐曰：「陛下雖得廉頗、李牧，弗能用也。"
  },
  {
    "id": "s0251",
    "blockIndex": 23,
    "zh": "上怒，起，入禁中，良久，召唐，讓曰：「公奈何眾辱我，獨無間處乎！"
  },
  {
    "id": "s0252",
    "blockIndex": 23,
    "zh": "」唐謝曰：「鄙人不知忌諱。"
  },
  {
    "id": "s0253",
    "blockIndex": 23,
    "zh": "」上方以胡寇為意，乃卒復問唐曰：「公何以知吾不能用廉頗、李牧也？"
  },
  {
    "id": "s0254",
    "blockIndex": 23,
    "zh": "」唐對曰：「臣聞上古王者之遣將也，跪而推轂，曰：『閫以內者，寡人制之；"
  },
  {
    "id": "s0255",
    "blockIndex": 23,
    "zh": "閫以外者，將軍制之。"
  },
  {
    "id": "s0256",
    "blockIndex": 23,
    "zh": "』軍功爵賞皆決於外，歸而奏之，此非虛言也。"
  },
  {
    "id": "s0257",
    "blockIndex": 23,
    "zh": "臣大父言：李牧為趙將，居邊，軍市之租，皆自用饗士；"
  },
  {
    "id": "s0258",
    "blockIndex": 23,
    "zh": "賞賜決於外，不從中覆也。"
  },
  {
    "id": "s0259",
    "blockIndex": 23,
    "zh": "委任而責成功，故李牧乃得盡其智能；"
  },
  {
    "id": "s0260",
    "blockIndex": 23,
    "zh": "選車千三百乘，彀騎萬三千，百金之士十萬，是以北逐單于，破東胡，滅澹林，西抑強秦，南支韓、魏。"
  },
  {
    "id": "s0261",
    "blockIndex": 23,
    "zh": "當是之時，趙幾霸。"
  },
  {
    "id": "s0262",
    "blockIndex": 23,
    "zh": "其後會趙王遷立，用郭開讒，卒誅李牧，令顏聚代之；"
  },
  {
    "id": "s0263",
    "blockIndex": 23,
    "zh": "是以兵破士北，為秦所禽滅。"
  },
  {
    "id": "s0264",
    "blockIndex": 23,
    "zh": "今臣竊聞魏尚為雲中守，其軍市租盡以饗士卒，私養錢五日一椎牛，自饗賓客、軍吏、舍人，是以匈奴遠避，不近雲中之塞。"
  },
  {
    "id": "s0265",
    "blockIndex": 23,
    "zh": "虜曾一入，尚率車騎擊之，所殺甚眾。"
  },
  {
    "id": "s0266",
    "blockIndex": 23,
    "zh": "夫士卒盡家人子，起田中從軍，安知尺籍、伍符！"
  },
  {
    "id": "s0267",
    "blockIndex": 23,
    "zh": "終日力戰，斬首捕虜，上功幕府，一言不相應，文吏以法繩之，其賞不行，而吏奉法必用。"
  },
  {
    "id": "s0268",
    "blockIndex": 23,
    "zh": "臣愚以為陛下賞太輕，罰太重。"
  },
  {
    "id": "s0269",
    "blockIndex": 23,
    "zh": "且雲中守魏尚坐上功首虜差六級，陛下下之吏，削其爵，罰作之。"
  },
  {
    "id": "s0270",
    "blockIndex": 23,
    "zh": "由此言之，陛下雖得廉頗、李牧，弗能用也！"
  },
  {
    "id": "s0271",
    "blockIndex": 23,
    "zh": "」上說。"
  },
  {
    "id": "s0272",
    "blockIndex": 23,
    "zh": "是日，令唐持節赦魏尚，復以為雲中守，而拜唐為車騎都尉。"
  },
  {
    "id": "s0273",
    "blockIndex": 23,
    "zh": "----3春，詔廣增諸祀壇場、珪幣，且曰：「吾聞祠官祝釐，皆歸福於朕躬，不為百姓，朕甚愧之。"
  },
  {
    "id": "s0274",
    "blockIndex": 23,
    "zh": "夫以朕之不德，而專饗獨美其福，百姓不與焉，是重吾不德也。"
  },
  {
    "id": "s0275",
    "blockIndex": 23,
    "zh": "其令祠官致敬，無有所祈！"
  },
  {
    "id": "s0276",
    "blockIndex": 23,
    "zh": "」----4是歲，河間文王辟強薨。"
  },
  {
    "id": "s0277",
    "blockIndex": 23,
    "zh": "----5初，丞相張蒼以為漢得水德，魯人公孫臣以為漢當土德，其應，黃龍見；"
  },
  {
    "id": "s0278",
    "blockIndex": 23,
    "zh": "蒼以為非是，罷之。"
  },
  {
    "id": "s0279",
    "blockIndex": 23,
    "zh": "----1春，黃龍見成紀。"
  },
  {
    "id": "s0280",
    "blockIndex": 23,
    "zh": "帝召公孫臣，拜為博士，與諸生申明土德，草改歷、服色事。"
  },
  {
    "id": "s0281",
    "blockIndex": 23,
    "zh": "張蒼由此自絀。"
  },
  {
    "id": "s0282",
    "blockIndex": 23,
    "zh": "----2夏，四月，上始幸雍，郊見五帝，赦天下。"
  },
  {
    "id": "s0283",
    "blockIndex": 23,
    "zh": "----3九月，詔諸侯王、公卿、郡守舉賢良、能直言極諫者，上親策之。"
  },
  {
    "id": "s0284",
    "blockIndex": 23,
    "zh": "太子家令晁錯對策高第，擢為中大夫。"
  },
  {
    "id": "s0285",
    "blockIndex": 23,
    "zh": "錯又上言宜削諸侯及法令可更定者書凡三十篇。"
  },
  {
    "id": "s0286",
    "blockIndex": 23,
    "zh": "上雖不盡聽，然奇其材。"
  },
  {
    "id": "s0287",
    "blockIndex": 23,
    "zh": "----4是歲，齊文王則、河間哀王福皆薨，無子，國除。"
  },
  {
    "id": "s0288",
    "blockIndex": 23,
    "zh": "----5趙人新垣平以望氣見上，言長安東北有神氣，成五采，於是作渭陽五帝廟。"
  },
  {
    "id": "s0289",
    "blockIndex": 23,
    "zh": "----1夏，四月，上郊祀上帝於渭陽五帝廟。"
  },
  {
    "id": "s0290",
    "blockIndex": 23,
    "zh": "於是貴新垣平至上大夫，賜累千金；"
  },
  {
    "id": "s0291",
    "blockIndex": 23,
    "zh": "而使博士、諸生刺《六經》中作《王制》，謀議巡狩、封禪事。"
  },
  {
    "id": "s0292",
    "blockIndex": 23,
    "zh": "又於長門道北立五帝壇。"
  },
  {
    "id": "s0293",
    "blockIndex": 23,
    "zh": "----2徙淮南王喜復為城陽王，又分齊為六國；"
  },
  {
    "id": "s0294",
    "blockIndex": 23,
    "zh": "丙寅，立齊悼惠王子在者六人：楊虛侯將閭為齊王，安都侯志為濟北王，武成侯賢為菑川王，白石侯雄渠為膠東王，平昌侯卬為膠西王，扐侯辟光為濟南王。"
  },
  {
    "id": "s0295",
    "blockIndex": 23,
    "zh": "淮南厲王子在者三人：阜陵安為淮南王，安陽侯勃為衡山王，陽周侯賜為廬江王。"
  },
  {
    "id": "s0296",
    "blockIndex": 23,
    "zh": "----3秋，九月，新垣平使人持玉杯上書闕下獻之。"
  },
  {
    "id": "s0297",
    "blockIndex": 23,
    "zh": "平言上曰：「闕下有寶玉氣來者。"
  },
  {
    "id": "s0298",
    "blockIndex": 23,
    "zh": "」已，視之，果有獻玉杯者，刻曰「人主延壽」。"
  },
  {
    "id": "s0299",
    "blockIndex": 23,
    "zh": "平又言：「臣侯日再中。"
  },
  {
    "id": "s0300",
    "blockIndex": 23,
    "zh": "」居頃之，日卻，復中。"
  },
  {
    "id": "s0301",
    "blockIndex": 23,
    "zh": "於是始更以十七年為元年，令天下大酺。"
  },
  {
    "id": "s0302",
    "blockIndex": 23,
    "zh": "平言曰：「周鼎亡在泗水中。"
  },
  {
    "id": "s0303",
    "blockIndex": 23,
    "zh": "今河決，通於泗，臣望東北汾陰直有金寶氣，意周鼎其出乎！"
  },
  {
    "id": "s0304",
    "blockIndex": 23,
    "zh": "兆見，不迎則不至。"
  },
  {
    "id": "s0305",
    "blockIndex": 23,
    "zh": "」於是上使使治廟汾陰南，臨河，欲祠出周鼎。"
  },
  {
    "id": "s0306",
    "blockIndex": 23,
    "zh": "----1冬，十月，人有上書告新垣平「所言諧詐也」；"
  },
  {
    "id": "s0307",
    "blockIndex": 23,
    "zh": "下吏治，誅夷平。"
  },
  {
    "id": "s0308",
    "blockIndex": 23,
    "zh": "是後，上亦怠於改正、服、鬼神之事，而渭陽、長門五帝，使祠官領，以時致禮，不往焉。"
  },
  {
    "id": "s0309",
    "blockIndex": 23,
    "zh": "----2春，三月，孝惠皇后張氏薨。"
  },
  {
    "id": "s0310",
    "blockIndex": 23,
    "zh": "----3詔曰：「間者數年不登，又有水旱、疾疫之災，朕甚憂之。"
  },
  {
    "id": "s0311",
    "blockIndex": 23,
    "zh": "愚而不明，未達其咎：意者朕之政有所失而行有過與？"
  },
  {
    "id": "s0312",
    "blockIndex": 23,
    "zh": "乃天道有不順，地利或不得，人事多失和，鬼神廢不享與？"
  },
  {
    "id": "s0313",
    "blockIndex": 23,
    "zh": "何以致此？"
  },
  {
    "id": "s0314",
    "blockIndex": 23,
    "zh": "將百官之奉養或廢，無用之事或多與？"
  },
  {
    "id": "s0315",
    "blockIndex": 23,
    "zh": "何其民食之寡乏也？"
  },
  {
    "id": "s0316",
    "blockIndex": 23,
    "zh": "夫度田非益寡，而計民未加益，以口量地，其於古猶有餘，而食之甚不足者，其咎安在？"
  },
  {
    "id": "s0317",
    "blockIndex": 23,
    "zh": "無乃百姓之從事於末以害農者蕃，為酒醪以靡谷者多，六畜之食焉者眾與？"
  },
  {
    "id": "s0318",
    "blockIndex": 23,
    "zh": "細大之義，吾未得其中，其與丞相、列侯、吏二千石、博士議之。"
  },
  {
    "id": "s0319",
    "blockIndex": 23,
    "zh": "有可以佐百姓者，率意遠思，無有所隱！"
  },
  {
    "id": "s0320",
    "blockIndex": 23,
    "zh": "」----1夏，上行幸雍棫陽宮。"
  },
  {
    "id": "s0321",
    "blockIndex": 23,
    "zh": "----2六月，代孝王參薨。"
  },
  {
    "id": "s0322",
    "blockIndex": 23,
    "zh": "----3匈奴連歲入邊，殺略人民、畜產甚多；"
  },
  {
    "id": "s0323",
    "blockIndex": 23,
    "zh": "雲中、遼東最甚，郡萬餘人。"
  },
  {
    "id": "s0324",
    "blockIndex": 23,
    "zh": "上患之，乃使使遺匈奴書。"
  },
  {
    "id": "s0325",
    "blockIndex": 23,
    "zh": "單于亦使當戶報謝，復與匈奴和親。"
  },
  {
    "id": "s0326",
    "blockIndex": 23,
    "zh": "----4八月，戊戌，丞相張蒼免。"
  },
  {
    "id": "s0327",
    "blockIndex": 23,
    "zh": "帝以皇后弟竇廣國賢，有行，欲相之，曰：「恐天下以吾私廣國，久念不可。"
  },
  {
    "id": "s0328",
    "blockIndex": 23,
    "zh": "」而高帝時大臣，餘見無可者。"
  },
  {
    "id": "s0329",
    "blockIndex": 23,
    "zh": "御史大夫梁國申屠嘉，故以材官蹶張從高帝，封關內侯；"
  },
  {
    "id": "s0330",
    "blockIndex": 23,
    "zh": "庚午，以嘉為丞相，封故安侯。"
  },
  {
    "id": "s0331",
    "blockIndex": 23,
    "zh": "嘉為人廉直，門不受私謁。"
  },
  {
    "id": "s0332",
    "blockIndex": 23,
    "zh": "是時，太中大夫鄧通方愛幸，賞賜累巨萬。"
  },
  {
    "id": "s0333",
    "blockIndex": 23,
    "zh": "帝嘗燕飲通家，其寵幸無比。"
  },
  {
    "id": "s0334",
    "blockIndex": 23,
    "zh": "嘉嘗入朝，而通居上旁，有怠慢之禮，嘉奏事畢，因言曰：「陛下幸愛群臣，則富貴之；"
  },
  {
    "id": "s0335",
    "blockIndex": 23,
    "zh": "至於朝廷之禮，不可以不肅。"
  },
  {
    "id": "s0336",
    "blockIndex": 23,
    "zh": "」上曰：「君勿言，吾私之。"
  },
  {
    "id": "s0337",
    "blockIndex": 23,
    "zh": "」罷朝，坐府中，嘉為檄召通詣丞相府，不來，且斬通。"
  },
  {
    "id": "s0338",
    "blockIndex": 23,
    "zh": "通恐，入言上；"
  },
  {
    "id": "s0339",
    "blockIndex": 23,
    "zh": "上曰：「汝第往，吾今使人召若。"
  },
  {
    "id": "s0340",
    "blockIndex": 23,
    "zh": "」通詣丞相，免冠、徒跣，頓首謝嘉。"
  },
  {
    "id": "s0341",
    "blockIndex": 23,
    "zh": "嘉坐自如，弗為禮，責曰：「夫朝廷者，高帝之朝廷也。"
  },
  {
    "id": "s0342",
    "blockIndex": 23,
    "zh": "通小臣，戲殿上，大不敬，當斬。"
  },
  {
    "id": "s0343",
    "blockIndex": 23,
    "zh": "吏！"
  },
  {
    "id": "s0344",
    "blockIndex": 23,
    "zh": "今行斬之！"
  },
  {
    "id": "s0345",
    "blockIndex": 23,
    "zh": "」通頓首，首盡出血，不解。"
  },
  {
    "id": "s0346",
    "blockIndex": 23,
    "zh": "上度丞相已困通，使使持節召通而謝丞相：「此吾弄臣，君釋之！"
  },
  {
    "id": "s0347",
    "blockIndex": 23,
    "zh": "」鄧通既至，為上泣曰：「丞相幾殺臣！"
  },
  {
    "id": "s0348",
    "blockIndex": 23,
    "zh": "」----1春，二月，上行幸代。"
  },
  {
    "id": "s0349",
    "blockIndex": 23,
    "zh": "----2是歲，匈奴老上單于死，子軍臣單于立。"
  },
  {
    "id": "s0350",
    "blockIndex": 23,
    "zh": "----1夏，四月，丙寅晦，日有食之。"
  },
  {
    "id": "s0351",
    "blockIndex": 23,
    "zh": "----2五月，赦天下。"
  },
  {
    "id": "s0352",
    "blockIndex": 23,
    "zh": "----3上行幸雍。"
  },
  {
    "id": "s0353",
    "blockIndex": 23,
    "zh": "----1春，正月，上行幸隴西；"
  },
  {
    "id": "s0354",
    "blockIndex": 23,
    "zh": "三月，行幸雍；"
  },
  {
    "id": "s0355",
    "blockIndex": 23,
    "zh": "秋，七月，行幸代。"
  },
  {
    "id": "s0356",
    "blockIndex": 23,
    "zh": "----1冬，匈奴三萬騎入上郡，三萬騎入雲中，所殺略甚眾，烽火通於甘泉、長安。"
  },
  {
    "id": "s0357",
    "blockIndex": 23,
    "zh": "以中大夫令免為車騎將軍，屯飛狐；"
  },
  {
    "id": "s0358",
    "blockIndex": 23,
    "zh": "故楚相蘇意為將軍，屯句注；"
  },
  {
    "id": "s0359",
    "blockIndex": 23,
    "zh": "將軍張武屯北地；"
  },
  {
    "id": "s0360",
    "blockIndex": 23,
    "zh": "河內太守周亞夫為將軍，次細柳；"
  },
  {
    "id": "s0361",
    "blockIndex": 23,
    "zh": "宗正劉禮為將軍，次霸上，祝茲侯徐厲為將軍，次棘門；"
  },
  {
    "id": "s0362",
    "blockIndex": 23,
    "zh": "以備胡。"
  },
  {
    "id": "s0363",
    "blockIndex": 24,
    "zh": "上自勞軍，至霸上及棘門軍，直馳入，將以下騎送迎。"
  },
  {
    "id": "s0364",
    "blockIndex": 24,
    "zh": "已而之細柳軍，軍士吏被甲，銳兵刃，彀弓弩持滿，天子先驅至，不得入。"
  },
  {
    "id": "s0365",
    "blockIndex": 24,
    "zh": "先驅曰：「天子且至！"
  },
  {
    "id": "s0366",
    "blockIndex": 24,
    "zh": "」軍門都尉曰；"
  },
  {
    "id": "s0367",
    "blockIndex": 24,
    "zh": "「將軍令曰：『軍中聞將軍令，不聞天子之詔！"
  },
  {
    "id": "s0368",
    "blockIndex": 24,
    "zh": "』」居無何，上至，又不得入。"
  },
  {
    "id": "s0369",
    "blockIndex": 24,
    "zh": "於是上乃使使持節詔將軍：「吾欲入營勞軍。"
  },
  {
    "id": "s0370",
    "blockIndex": 24,
    "zh": "」亞夫乃傳言「開壁門」。"
  },
  {
    "id": "s0371",
    "blockIndex": 24,
    "zh": "壁門士請車騎曰：「將軍約：軍中不得驅馳。"
  },
  {
    "id": "s0372",
    "blockIndex": 24,
    "zh": "」於是天子乃按轡徐行。"
  },
  {
    "id": "s0373",
    "blockIndex": 24,
    "zh": "至營，將軍亞夫持兵揖曰：「介冑之士不拜，請以軍禮見。"
  },
  {
    "id": "s0374",
    "blockIndex": 24,
    "zh": "」天子為動，改容，式車，使人稱謝：「皇帝敬勞將軍。"
  },
  {
    "id": "s0375",
    "blockIndex": 24,
    "zh": "」成禮而去。"
  },
  {
    "id": "s0376",
    "blockIndex": 24,
    "zh": "既出軍門，群臣皆驚。"
  },
  {
    "id": "s0377",
    "blockIndex": 24,
    "zh": "上曰：「嗟乎，此真將軍矣！"
  },
  {
    "id": "s0378",
    "blockIndex": 24,
    "zh": "曩者霸上、棘門軍若兒戲耳，其將固可襲而虜也。"
  },
  {
    "id": "s0379",
    "blockIndex": 24,
    "zh": "至於亞夫，可得而犯耶！"
  },
  {
    "id": "s0380",
    "blockIndex": 24,
    "zh": "」稱善者久之。"
  },
  {
    "id": "s0381",
    "blockIndex": 24,
    "zh": "月餘，漢後至邊，匈奴亦遠塞，漢兵亦罷。"
  },
  {
    "id": "s0382",
    "blockIndex": 24,
    "zh": "乃拜周亞夫為中尉。"
  },
  {
    "id": "s0383",
    "blockIndex": 24,
    "zh": "----2夏，四月，大旱，蝗。"
  },
  {
    "id": "s0384",
    "blockIndex": 24,
    "zh": "令諸侯無入貢；"
  },
  {
    "id": "s0385",
    "blockIndex": 24,
    "zh": "弛山澤，減諸服御，損郎吏員；"
  },
  {
    "id": "s0386",
    "blockIndex": 24,
    "zh": "發倉庾以振民；"
  },
  {
    "id": "s0387",
    "blockIndex": 24,
    "zh": "民得賣爵。"
  },
  {
    "id": "s0388",
    "blockIndex": 24,
    "zh": "----1夏，六月，已亥，帝崩於未央宮。"
  },
  {
    "id": "s0389",
    "blockIndex": 24,
    "zh": "遺詔曰：:「朕聞之：蓋天下萬物之萌生，靡有不死。"
  },
  {
    "id": "s0390",
    "blockIndex": 24,
    "zh": "死者，天地之理，物之自然，奚可甚哀！"
  },
  {
    "id": "s0391",
    "blockIndex": 24,
    "zh": "當今之世，咸嘉生而惡死，厚葬以破業，重服以傷生，吾甚不取。"
  },
  {
    "id": "s0392",
    "blockIndex": 24,
    "zh": "且朕既不德，無在佐百姓；"
  },
  {
    "id": "s0393",
    "blockIndex": 24,
    "zh": "今崩，又使重服久臨以罹寒暑之數，哀人父子，傷長老之志，損其飲食，絕鬼神之祭祀，以重吾不德，謂天下何！"
  },
  {
    "id": "s0394",
    "blockIndex": 24,
    "zh": "朕獲保宗廟，以眇眇之身托於天下君王之上，二十有餘年矣。"
  },
  {
    "id": "s0395",
    "blockIndex": 24,
    "zh": "賴天之靈，社稷之福，方內安寧，靡有兵革。"
  },
  {
    "id": "s0396",
    "blockIndex": 24,
    "zh": "朕既不敏，常畏過行以羞先帝之遺德，惟年之久長，懼於不終。"
  },
  {
    "id": "s0397",
    "blockIndex": 24,
    "zh": "今乃幸以天年得復供養於高廟，其奚哀念之有！"
  },
  {
    "id": "s0398",
    "blockIndex": 24,
    "zh": "其令天下吏民：令到，出臨三日，皆釋服；"
  },
  {
    "id": "s0399",
    "blockIndex": 24,
    "zh": "毋禁取婦、嫁女、祠祀、飲酒、食肉，自當給喪事服臨者，皆無跣；"
  },
  {
    "id": "s0400",
    "blockIndex": 24,
    "zh": "絰帶毋過三寸；"
  },
  {
    "id": "s0401",
    "blockIndex": 24,
    "zh": "毋布車及兵器；"
  },
  {
    "id": "s0402",
    "blockIndex": 24,
    "zh": "毋發民哭臨宮殿中；"
  },
  {
    "id": "s0403",
    "blockIndex": 24,
    "zh": "殿中當臨者，皆以旦夕各十五舉音，禮畢罷；"
  },
  {
    "id": "s0404",
    "blockIndex": 24,
    "zh": "非旦夕臨時，禁毋得擅哭臨；"
  },
  {
    "id": "s0405",
    "blockIndex": 24,
    "zh": "已下棺，服大功十五日，小功十四日，纖七日，釋服。"
  },
  {
    "id": "s0406",
    "blockIndex": 24,
    "zh": "它不在令中者，皆以此令比類從事。"
  },
  {
    "id": "s0407",
    "blockIndex": 24,
    "zh": "佈告天下，使明知朕意。"
  },
  {
    "id": "s0408",
    "blockIndex": 24,
    "zh": "霸陵山川因其故，毋有所改。"
  },
  {
    "id": "s0409",
    "blockIndex": 24,
    "zh": "歸夫以下至少使。"
  },
  {
    "id": "s0411",
    "blockIndex": 25,
    "zh": "乙巳，葬霸陵。"
  },
  {
    "id": "s0412",
    "blockIndex": 26,
    "zh": "帝即位二十三年，宮室、苑囿、車騎、服御，無所增益；"
  },
  {
    "id": "s0413",
    "blockIndex": 26,
    "zh": "有不便，輒馳以利民。"
  },
  {
    "id": "s0414",
    "blockIndex": 26,
    "zh": "嘗欲作露台，召匠計之，直百金。"
  },
  {
    "id": "s0415",
    "blockIndex": 26,
    "zh": "上曰：「百金，中人十家之產也。"
  },
  {
    "id": "s0416",
    "blockIndex": 26,
    "zh": "吾奉先帝宮室，常恐羞之，何以台為！"
  },
  {
    "id": "s0417",
    "blockIndex": 26,
    "zh": "」身衣弋綈；"
  },
  {
    "id": "s0418",
    "blockIndex": 26,
    "zh": "所幸慎夫人，衣不曳地；"
  },
  {
    "id": "s0419",
    "blockIndex": 26,
    "zh": "帷帳無文繡；"
  },
  {
    "id": "s0420",
    "blockIndex": 26,
    "zh": "以示敦樸，為天下先。"
  },
  {
    "id": "s0421",
    "blockIndex": 26,
    "zh": "治霸陵，皆瓦器，不得以金、銀、銅、錫為飾，因其山，不起墳。"
  },
  {
    "id": "s0422",
    "blockIndex": 26,
    "zh": "吳王詐病不朝，賜以幾杖。"
  },
  {
    "id": "s0423",
    "blockIndex": 26,
    "zh": "群臣袁盎等諫說雖切，常假借納用焉。"
  },
  {
    "id": "s0424",
    "blockIndex": 26,
    "zh": "張武等受賂金錢，覺，更加賞賜以愧其心；"
  },
  {
    "id": "s0425",
    "blockIndex": 26,
    "zh": "專務以德化民。"
  },
  {
    "id": "s0426",
    "blockIndex": 26,
    "zh": "是以海內安寧，家給人足，後世鮮能及之。"
  },
  {
    "id": "s0427",
    "blockIndex": 26,
    "zh": "----2丁未，太子即皇帝位，尊皇太后薄氏曰太皇太后，皇后曰皇太后。"
  },
  {
    "id": "s0428",
    "blockIndex": 26,
    "zh": "----3九月，有星孛於西方。"
  },
  {
    "id": "s0429",
    "blockIndex": 26,
    "zh": "----4是歲，長沙王吳著薨，無子，國除。"
  },
  {
    "id": "s0430",
    "blockIndex": 27,
    "zh": "初，高祖賢文王芮，制誥御史：「長沙王忠，其令著令。"
  },
  {
    "id": "s0431",
    "blockIndex": 27,
    "zh": "」至孝惠、高后時，封芮庶子二人為列侯，傳國數世絕。"
  },
  {
    "id": "s0432",
    "blockIndex": 28,
    "zh": "1冬，十月，丞相嘉等奏：「功莫大於高皇帝，德莫盛於孝文皇帝。"
  },
  {
    "id": "s0433",
    "blockIndex": 28,
    "zh": "高皇帝廟，宜為帝者太祖之廟；"
  },
  {
    "id": "s0434",
    "blockIndex": 28,
    "zh": "孝文皇帝廟，宜為帝者太宗之廟。"
  },
  {
    "id": "s0435",
    "blockIndex": 28,
    "zh": "天子宜世世獻祖宗之廟，郡國諸侯宜各為孝文皇帝立太宗之廟。"
  },
  {
    "id": "s0436",
    "blockIndex": 28,
    "zh": "」制曰：「可。"
  },
  {
    "id": "s0437",
    "blockIndex": 28,
    "zh": "」----2夏，四月，乙卯，赦天下。"
  },
  {
    "id": "s0438",
    "blockIndex": 28,
    "zh": "----3遣御史大夫青至代下與匈奴和親。"
  },
  {
    "id": "s0439",
    "blockIndex": 28,
    "zh": "----4五月，復收民田半租，三十而稅一。"
  },
  {
    "id": "s0440",
    "blockIndex": 28,
    "zh": "----5初，文帝除肉刑，外有輕刑之名，內實殺人；"
  },
  {
    "id": "s0441",
    "blockIndex": 28,
    "zh": "斬右止者又當死；"
  },
  {
    "id": "s0442",
    "blockIndex": 28,
    "zh": "斬左止者笞五百，當劓者笞三百，率多死。"
  },
  {
    "id": "s0443",
    "blockIndex": 28,
    "zh": "是歲，下詔曰：「加笞、重罪無異；"
  },
  {
    "id": "s0444",
    "blockIndex": 28,
    "zh": "幸而不死，不可為人。"
  },
  {
    "id": "s0445",
    "blockIndex": 28,
    "zh": "其定律：笞五百曰三百，笞三百曰二百。"
  },
  {
    "id": "s0446",
    "blockIndex": 28,
    "zh": "」----6以太中大夫周仁為郎中令，張歐為廷尉，楚元王子平陸侯禮為宗正，中大夫晁錯為左內史。"
  },
  {
    "id": "s0447",
    "blockIndex": 28,
    "zh": "仁始為太子舍人，以廉謹得幸。"
  },
  {
    "id": "s0448",
    "blockIndex": 28,
    "zh": "張歐亦事帝於太子宮，雖治刑名家，為人長者，帝由是重之，用為九卿。"
  },
  {
    "id": "s0449",
    "blockIndex": 28,
    "zh": "歐為吏未嘗言按人，專以誠長者處官；"
  },
  {
    "id": "s0450",
    "blockIndex": 28,
    "zh": "官屬以為長者，亦不敢大欺。"
  },
  {
    "id": "s0451",
    "blockIndex": 28,
    "zh": "----1冬，十二月，有星孛於西南。"
  },
  {
    "id": "s0452",
    "blockIndex": 28,
    "zh": "----2令天下男子年二十始傅。"
  },
  {
    "id": "s0453",
    "blockIndex": 28,
    "zh": "----3春，三月，甲寅，立皇子德為河間王，閼為臨江王，餘為淮陽王，非為汝南王，彭祖為廣川王，發為長沙王。"
  },
  {
    "id": "s0454",
    "blockIndex": 28,
    "zh": "----4夏，四月，壬午，太皇太后薄氏崩。"
  },
  {
    "id": "s0455",
    "blockIndex": 28,
    "zh": "----5六月，丞相申屠嘉薨。"
  },
  {
    "id": "s0456",
    "blockIndex": 28,
    "zh": "時內史晁錯數請間言事，輒聽，寵幸傾九卿，法令多所更定。"
  },
  {
    "id": "s0457",
    "blockIndex": 28,
    "zh": "丞相嘉自絀所言不用，疾錯。"
  },
  {
    "id": "s0458",
    "blockIndex": 28,
    "zh": "錯為內史，東出不便，更穿一門南出。"
  },
  {
    "id": "s0459",
    "blockIndex": 28,
    "zh": "南出者，太上皇廟堧垣也。"
  },
  {
    "id": "s0460",
    "blockIndex": 28,
    "zh": "嘉聞錯穿宗廟垣，為奏，請誅錯。"
  },
  {
    "id": "s0461",
    "blockIndex": 28,
    "zh": "客有語錯，錯恐，夜入宮上謁，自歸上。"
  },
  {
    "id": "s0462",
    "blockIndex": 28,
    "zh": "至朝，嘉請誅內史錯。"
  },
  {
    "id": "s0463",
    "blockIndex": 28,
    "zh": "上曰：「錯所穿非真廟垣，乃外堧垣，故冗官居其中；"
  },
  {
    "id": "s0464",
    "blockIndex": 28,
    "zh": "且又我使為之，錯無罪。"
  },
  {
    "id": "s0465",
    "blockIndex": 28,
    "zh": "」丞相嘉謝。"
  },
  {
    "id": "s0466",
    "blockIndex": 28,
    "zh": "罷朝，嘉謂長史曰：「吾悔不先斬錯乃請之，為錯所賣。"
  },
  {
    "id": "s0467",
    "blockIndex": 28,
    "zh": "」至舍，因歐血而死。"
  },
  {
    "id": "s0468",
    "blockIndex": 28,
    "zh": "錯以此愈貴。"
  },
  {
    "id": "s0469",
    "blockIndex": 28,
    "zh": "----6秋，與匈奴和親。"
  },
  {
    "id": "s0470",
    "blockIndex": 28,
    "zh": "----7八月，丁未，以御史大夫開封侯陶青為丞相。"
  },
  {
    "id": "s0471",
    "blockIndex": 28,
    "zh": "丁巳，以內史晁錯為御史大夫。"
  },
  {
    "id": "s0472",
    "blockIndex": 28,
    "zh": "----8彗星出東北。"
  },
  {
    "id": "s0473",
    "blockIndex": 28,
    "zh": "----9秋，衡山雨雹，大者五寸，深者二尺。"
  },
  {
    "id": "s0474",
    "blockIndex": 28,
    "zh": "----10熒惑逆行守北辰，月出北辰間；"
  },
  {
    "id": "s0475",
    "blockIndex": 28,
    "zh": "歲星逆行天廷中。"
  },
  {
    "id": "s0476",
    "blockIndex": 28,
    "zh": "----11梁孝王以竇太后少子故，有寵，王四十餘城，居天下膏腴地。"
  },
  {
    "id": "s0477",
    "blockIndex": 28,
    "zh": "賞賜不可勝道，府庫金錢且百巨萬，珠玉寶器多於京師。"
  },
  {
    "id": "s0478",
    "blockIndex": 28,
    "zh": "築東苑，方三百餘里，廣睢陽城七十里，大治宮室，為覆道，自宮連屬於平台三十餘里。"
  },
  {
    "id": "s0479",
    "blockIndex": 28,
    "zh": "招延四方豪俊之士，如吳人枚乘、嚴忌，齊人羊勝、公孫詭、鄒陽，蜀人司馬相如之屬皆從之游。"
  },
  {
    "id": "s0480",
    "blockIndex": 28,
    "zh": "每入朝，上使使持節以乘輿駟馬迎梁王於關下。"
  },
  {
    "id": "s0481",
    "blockIndex": 28,
    "zh": "既至，寵幸無比，入則侍上同輦，出則同車，射獵上林中。"
  },
  {
    "id": "s0482",
    "blockIndex": 28,
    "zh": "因上疏請留，且半歲。"
  },
  {
    "id": "s0483",
    "blockIndex": 28,
    "zh": "梁侍中、郎、謁者著籍引出入天子殿門，與漢宦官無異。"
  },
  {
    "id": "s0484",
    "blockIndex": 29,
    "zh": "category:資治通鑑"
  }
]
