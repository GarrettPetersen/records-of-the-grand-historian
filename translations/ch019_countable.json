[
  {
    "id": "s0001",
    "blockIndex": 0,
    "zh": "起強圉大荒落，盡玄黓閹茂，凡六年。"
  },
  {
    "id": "s0002",
    "blockIndex": 1,
    "zh": "1冬，十一月，乙丑，薛澤免。"
  },
  {
    "id": "s0003",
    "blockIndex": 1,
    "zh": "以公孫弘為丞相，封平津侯。"
  },
  {
    "id": "s0004",
    "blockIndex": 1,
    "zh": "丞相封侯自弘始。"
  },
  {
    "id": "s0005",
    "blockIndex": 2,
    "zh": "時上方興功業，弘於是開東閤以延賢人，與參謀議。"
  },
  {
    "id": "s0006",
    "blockIndex": 2,
    "zh": "每朝覲奏事，因言國家便宜，上亦使左右文學之臣與之論難。"
  },
  {
    "id": "s0007",
    "blockIndex": 2,
    "zh": "弘嘗奏言：「十賊彍弩，百吏不敢前。"
  },
  {
    "id": "s0008",
    "blockIndex": 2,
    "zh": "請禁民毋得挾弓弩，便。"
  },
  {
    "id": "s0009",
    "blockIndex": 2,
    "zh": "」上下其議。"
  },
  {
    "id": "s0010",
    "blockIndex": 2,
    "zh": "侍中吾丘壽王對曰：「臣聞古者作五兵，非以相害，以禁暴討邪也。"
  },
  {
    "id": "s0011",
    "blockIndex": 2,
    "zh": "秦兼天下，銷甲兵，折鋒刃；"
  },
  {
    "id": "s0012",
    "blockIndex": 2,
    "zh": "其後民以耰鋤、棰梃相撻擊，犯法滋眾，盜賊不勝，卒以亂亡。"
  },
  {
    "id": "s0013",
    "blockIndex": 2,
    "zh": "故聖王務教化而省禁防，知其不足恃也。"
  },
  {
    "id": "s0014",
    "blockIndex": 2,
    "zh": "禮曰：『男子生，桑弧、蓬矢以舉之，』明示有事也。"
  },
  {
    "id": "s0015",
    "blockIndex": 2,
    "zh": "大射之禮，自天子降及庶人，三代之道也。"
  },
  {
    "id": "s0016",
    "blockIndex": 2,
    "zh": "愚聞聖王合射以明教矣，未聞弓矢之為禁也。"
  },
  {
    "id": "s0017",
    "blockIndex": 2,
    "zh": "且所為禁者，為盜賊之以攻奪也；"
  },
  {
    "id": "s0018",
    "blockIndex": 2,
    "zh": "攻奪之罪死，然而不止者，大奸之於重誅，固不避也。"
  },
  {
    "id": "s0019",
    "blockIndex": 2,
    "zh": "臣恐邪人挾之而吏不能止，良民以自備而抵法禁，是擅賊威而奪民救也。"
  },
  {
    "id": "s0020",
    "blockIndex": 2,
    "zh": "竊以為大不便。"
  },
  {
    "id": "s0021",
    "blockIndex": 2,
    "zh": "」書奏，上以難弘，弘詘服焉。"
  },
  {
    "id": "s0022",
    "blockIndex": 3,
    "zh": "弘性意忌，外寬內深。"
  },
  {
    "id": "s0023",
    "blockIndex": 3,
    "zh": "諸嘗與弘有隙，無近遠，雖陽與善，後竟報其過。"
  },
  {
    "id": "s0024",
    "blockIndex": 3,
    "zh": "董仲舒為人廉直，以弘為從諛，弘嫉之。"
  },
  {
    "id": "s0025",
    "blockIndex": 3,
    "zh": "膠西王端驕恣，數犯法，所殺傷二千石甚眾。"
  },
  {
    "id": "s0026",
    "blockIndex": 3,
    "zh": "弘乃薦仲舒為膠西相；"
  },
  {
    "id": "s0027",
    "blockIndex": 3,
    "zh": "仲舒以病免。"
  },
  {
    "id": "s0028",
    "blockIndex": 3,
    "zh": "汲黯常毀儒，面觸弘，弘欲誅之以事，乃言上曰：「右內史界部中多貴臣、宗室，難治，非素重臣不能任，請徙黯為右內史。"
  },
  {
    "id": "s0029",
    "blockIndex": 3,
    "zh": "」上從之。"
  },
  {
    "id": "s0030",
    "blockIndex": 3,
    "zh": "----2春，大旱。"
  },
  {
    "id": "s0031",
    "blockIndex": 3,
    "zh": "----3匈奴右賢王數侵擾朔方。"
  },
  {
    "id": "s0032",
    "blockIndex": 3,
    "zh": "天子令車騎將軍青將三萬騎出高闕，衛尉蘇建為游擊將軍，左內史李沮為強弩將軍，太僕公孫賀為騎將軍，代相李蔡為輕車將軍，皆領屬車騎將軍，俱出朔方；"
  },
  {
    "id": "s0033",
    "blockIndex": 3,
    "zh": "大行李息、岸頭侯張次公為將軍，俱出右北平；"
  },
  {
    "id": "s0034",
    "blockIndex": 3,
    "zh": "凡十餘萬人，擊匈奴。"
  },
  {
    "id": "s0035",
    "blockIndex": 3,
    "zh": "右賢王以為漢兵遠，不能至，飲酒，醉。"
  },
  {
    "id": "s0036",
    "blockIndex": 3,
    "zh": "衛青等兵出塞六七百里，夜至，圍右賢王。"
  },
  {
    "id": "s0037",
    "blockIndex": 3,
    "zh": "右賢王驚，夜逃，獨與壯騎數百馳，潰圍北去。"
  },
  {
    "id": "s0038",
    "blockIndex": 3,
    "zh": "得右賢裨王十餘人，眾男女萬五千餘人，畜數十百萬，於是引兵而還。"
  },
  {
    "id": "s0039",
    "blockIndex": 4,
    "zh": "至塞，天子使使者持大將軍印，即軍中拜衛青為大將軍，諸將皆屬焉。"
  },
  {
    "id": "s0040",
    "blockIndex": 4,
    "zh": "夏，四月，乙未，復益封青八千七百戶，封青三子伉、不疑、登皆為列侯。"
  },
  {
    "id": "s0041",
    "blockIndex": 4,
    "zh": "青固謝曰：「臣幸得待罪行間，賴陛下神靈，軍大捷，皆諸校尉力戰之功也。"
  },
  {
    "id": "s0042",
    "blockIndex": 4,
    "zh": "陛下幸已益封臣青；"
  },
  {
    "id": "s0043",
    "blockIndex": 4,
    "zh": "臣青子在襁褓中，未有勤勞，上列地封為三侯，非臣待罪行間所以勸士力戰之意也。"
  },
  {
    "id": "s0044",
    "blockIndex": 4,
    "zh": "」天子曰：「我非忘諸校尉功也。"
  },
  {
    "id": "s0045",
    "blockIndex": 4,
    "zh": "」乃封護軍都尉公孫敖為合騎侯，都尉韓說為龍額侯，公孫賀為南窌侯，李蔡為樂安侯，校尉李朔為涉軹侯，趙不虞為隨成侯，公孫戎奴為從平侯，李沮、李息及校尉豆如意皆賜爵關內侯。"
  },
  {
    "id": "s0046",
    "blockIndex": 5,
    "zh": "於是青尊寵，於群臣無二，公卿以下皆卑奉之，獨汲黯與亢禮。"
  },
  {
    "id": "s0047",
    "blockIndex": 5,
    "zh": "人或說黯曰：「自天子欲群臣下大將軍，大將軍尊重，君不可以不拜。"
  },
  {
    "id": "s0048",
    "blockIndex": 5,
    "zh": "」黯曰：「夫以大將軍，有揖客反不重邪！"
  },
  {
    "id": "s0049",
    "blockIndex": 5,
    "zh": "」大將軍聞，愈賢黯，數請問國家朝廷所疑，遇黯加於平日。"
  },
  {
    "id": "s0050",
    "blockIndex": 5,
    "zh": "大將軍青雖貴，有時侍中，上踞廁而視之；"
  },
  {
    "id": "s0051",
    "blockIndex": 5,
    "zh": "丞相弘燕見，上或時不冠；"
  },
  {
    "id": "s0052",
    "blockIndex": 5,
    "zh": "至如汲黯見，上不冠不見也。"
  },
  {
    "id": "s0053",
    "blockIndex": 5,
    "zh": "上嘗坐武帳中，黯前奏事，上不冠，望見黯，避帳中，使人可其奏。"
  },
  {
    "id": "s0054",
    "blockIndex": 5,
    "zh": "其見敬禮如此。"
  },
  {
    "id": "s0055",
    "blockIndex": 5,
    "zh": "----4夏，六月，詔曰：「蓋聞導民以禮，風之以樂。"
  },
  {
    "id": "s0056",
    "blockIndex": 5,
    "zh": "今禮壞、樂崩，朕甚閔焉。"
  },
  {
    "id": "s0057",
    "blockIndex": 5,
    "zh": "其令禮官勸學興禮以為天下先！"
  },
  {
    "id": "s0058",
    "blockIndex": 5,
    "zh": "」於是丞相弘等奏：「請為博士官置弟子五十人，復其身，第其高下，以補郎中、文學、掌故。"
  },
  {
    "id": "s0059",
    "blockIndex": 5,
    "zh": "即有秀才異等，輒以名聞；"
  },
  {
    "id": "s0060",
    "blockIndex": 5,
    "zh": "其不事學若下材，輒罷之。"
  },
  {
    "id": "s0061",
    "blockIndex": 5,
    "zh": "又，吏通一藝以上者，請皆選擇以補右職。"
  },
  {
    "id": "s0062",
    "blockIndex": 5,
    "zh": "」上從之。"
  },
  {
    "id": "s0063",
    "blockIndex": 5,
    "zh": "自此公卿、大夫、士、吏彬彬多文學之士矣。"
  },
  {
    "id": "s0064",
    "blockIndex": 5,
    "zh": "----5秋，匈奴萬騎入代，殺都尉朱英，略千餘人。"
  },
  {
    "id": "s0065",
    "blockIndex": 5,
    "zh": "----6初，淮南王安，好讀書屬文，喜立名譽，招致賓客方術之士數千人。"
  },
  {
    "id": "s0066",
    "blockIndex": 5,
    "zh": "其群臣、賓客，多江、淮間輕薄士，常以厲王遷死感激安。"
  },
  {
    "id": "s0067",
    "blockIndex": 5,
    "zh": "建元六年，彗星見，或說王曰：「先吳軍時，彗星出，長數尺，然尚流血千里。"
  },
  {
    "id": "s0068",
    "blockIndex": 5,
    "zh": "今彗星竟天，天下兵當大起。"
  },
  {
    "id": "s0069",
    "blockIndex": 5,
    "zh": "」王心以為然，乃益治攻戰具，積金錢。"
  },
  {
    "id": "s0070",
    "blockIndex": 6,
    "zh": "郎中雷被獲罪於太子遷，時有詔，欲從軍者輒詣長安，被即願奮擊匈奴。"
  },
  {
    "id": "s0071",
    "blockIndex": 6,
    "zh": "太子惡被於王，斥免之，欲以禁後。"
  },
  {
    "id": "s0072",
    "blockIndex": 6,
    "zh": "是歲，被亡之長安，上書自明。"
  },
  {
    "id": "s0073",
    "blockIndex": 6,
    "zh": "事下廷尉治，蹤跡連王，公卿請逮捕治王。"
  },
  {
    "id": "s0074",
    "blockIndex": 6,
    "zh": "太子遷謀令人衣衛士衣，持戟居王旁，漢使有非是者，即刺殺之，因發兵反。"
  },
  {
    "id": "s0075",
    "blockIndex": 6,
    "zh": "天子使中尉宏即訊王，王視中尉顏色和，遂不發。"
  },
  {
    "id": "s0076",
    "blockIndex": 6,
    "zh": "公卿奏：「安壅閼奮擊匈奴者，格明詔，當棄市。"
  },
  {
    "id": "s0077",
    "blockIndex": 6,
    "zh": "」詔削二縣。"
  },
  {
    "id": "s0078",
    "blockIndex": 6,
    "zh": "既而安自傷曰：「吾行仁義，反見削地。"
  },
  {
    "id": "s0079",
    "blockIndex": 6,
    "zh": "」恥之，於是為反謀益甚。"
  },
  {
    "id": "s0080",
    "blockIndex": 7,
    "zh": "安與衡山王賜相責望，禮節間不相能。"
  },
  {
    "id": "s0081",
    "blockIndex": 7,
    "zh": "衡山王聞淮南王有反謀，恐為所并，亦結賓客為反具，以為淮南已西，欲發兵定江、淮之間而有之。"
  },
  {
    "id": "s0082",
    "blockIndex": 7,
    "zh": "衡山-{王后}-徐來譖太子爽於王，欲廢之而立其弟孝。"
  },
  {
    "id": "s0083",
    "blockIndex": 7,
    "zh": "王囚太子而佩孝以王印，令招致賓客。"
  },
  {
    "id": "s0084",
    "blockIndex": 7,
    "zh": "賓客來者微知淮南、衡山有逆計，日夜從容勸之。"
  },
  {
    "id": "s0085",
    "blockIndex": 7,
    "zh": "王乃使孝客江都人枚赫、陳喜作輣車、鍛矢，刻天子璽、將相軍吏印。"
  },
  {
    "id": "s0086",
    "blockIndex": 7,
    "zh": "秋，衡山王當入朝，過淮南；"
  },
  {
    "id": "s0087",
    "blockIndex": 7,
    "zh": "淮南王乃昆弟語，除前隙，約束反具。"
  },
  {
    "id": "s0088",
    "blockIndex": 7,
    "zh": "衡山王即上書謝病，上賜書不朝。"
  },
  {
    "id": "s0090",
    "blockIndex": 8,
    "zh": "1春，二月，大將軍青出定襄，擊匈奴；"
  },
  {
    "id": "s0091",
    "blockIndex": 8,
    "zh": "以合騎侯公孫敖為中將軍，太僕公孫賀為左將軍，翕侯趙信為前將軍，衛尉蘇建為右將軍，郎中令李廣為後將軍，左內史李沮為強弩將軍，咸屬大將軍。"
  },
  {
    "id": "s0092",
    "blockIndex": 8,
    "zh": "斬首數千級而還，休士馬於定襄、雲中、雁門。"
  },
  {
    "id": "s0093",
    "blockIndex": 8,
    "zh": "----2赦天下。"
  },
  {
    "id": "s0094",
    "blockIndex": 8,
    "zh": "----3夏，四月，衛青復將六將軍出定襄，擊匈奴，斬首虜萬餘人。"
  },
  {
    "id": "s0095",
    "blockIndex": 8,
    "zh": "右將軍建、前將軍信並軍三千餘騎獨逢單于兵，與戰一日餘，漢兵且盡。"
  },
  {
    "id": "s0096",
    "blockIndex": 8,
    "zh": "信故胡小王，降漢，漢封為翕侯，及敗，匈奴誘之，遂將其餘騎可八百降匈奴。"
  },
  {
    "id": "s0097",
    "blockIndex": 8,
    "zh": "建盡亡其軍，脫身亡，自歸大將軍。"
  },
  {
    "id": "s0098",
    "blockIndex": 9,
    "zh": "議郎周霸曰：「自大將軍出，未嘗斬裨將。"
  },
  {
    "id": "s0099",
    "blockIndex": 9,
    "zh": "今建棄軍，可斬，以明將軍之威。"
  },
  {
    "id": "s0100",
    "blockIndex": 9,
    "zh": "」軍正閎、長史安曰：「不然。"
  },
  {
    "id": "s0101",
    "blockIndex": 9,
    "zh": "《兵法》：『小敵之堅，大敵之禽也。"
  },
  {
    "id": "s0102",
    "blockIndex": 9,
    "zh": "』今建以數千當單于數萬，力戰一日餘，士盡，不敢有二心，自歸，而斬之，是示後無反意也，不當斬。"
  },
  {
    "id": "s0103",
    "blockIndex": 9,
    "zh": "」大將軍曰：「青幸得以肺腑待罪行間，不患無威，而霸說我以明威，甚失臣意。"
  },
  {
    "id": "s0104",
    "blockIndex": 9,
    "zh": "且使臣職雖當斬將，以臣之尊寵而不敢擅誅於境外，而具歸天子，天子自裁之，於以見為人臣不敢專權，不亦可乎？"
  },
  {
    "id": "s0105",
    "blockIndex": 9,
    "zh": "」軍吏皆曰：「善！"
  },
  {
    "id": "s0106",
    "blockIndex": 9,
    "zh": "」遂囚建詣行在所。"
  },
  {
    "id": "s0107",
    "blockIndex": 10,
    "zh": "初，平陽縣吏霍仲孺給事平陽侯家，與青姊衛少兒私通，生霍去病。"
  },
  {
    "id": "s0108",
    "blockIndex": 10,
    "zh": "去病年十八，為侍中，善騎射，再從大將軍擊匈奴，為嫖姚校尉，與輕騎勇八百，直棄大軍數百里赴利，斬捕首虜過當。"
  },
  {
    "id": "s0109",
    "blockIndex": 10,
    "zh": "於是天子曰：「嫖姚校尉去病，斬首虜二千餘級，得相國、當戶，斬單于大父行藉若侯產，生捕季父羅姑，比再冠軍，封去病為冠軍侯。"
  },
  {
    "id": "s0110",
    "blockIndex": 10,
    "zh": "上谷太守郝賢四從大將軍，捕斬首虜二千餘級，封賢為眾利侯。"
  },
  {
    "id": "s0112",
    "blockIndex": 11,
    "zh": "是歲，失兩將軍，亡翕侯，軍功不多，故大將軍不益封，止賜千金。"
  },
  {
    "id": "s0113",
    "blockIndex": 11,
    "zh": "右將軍建至，天子不誅，贖為庶人。"
  },
  {
    "id": "s0114",
    "blockIndex": 12,
    "zh": "單于既得翕侯，以為自次王，用其姊妻之，與謀漢。"
  },
  {
    "id": "s0115",
    "blockIndex": 12,
    "zh": "信教單于益北絕幕，以誘罷漢兵，徼極而取之，無近塞。"
  },
  {
    "id": "s0116",
    "blockIndex": 12,
    "zh": "單于從其計。"
  },
  {
    "id": "s0117",
    "blockIndex": 13,
    "zh": "是時，漢比歲發十餘萬眾擊胡，斬捕首虜之士受賜黃金二十餘萬斤，而漢軍士馬死者十餘萬，兵甲轉漕之費不與焉。"
  },
  {
    "id": "s0118",
    "blockIndex": 13,
    "zh": "於是大司農經用竭，不足以奉戰士。"
  },
  {
    "id": "s0119",
    "blockIndex": 13,
    "zh": "六月，詔令民得買爵及贖禁錮，免臧罪。"
  },
  {
    "id": "s0120",
    "blockIndex": 13,
    "zh": "置賞官，名曰武功爵，級十七萬，凡直三十餘萬金。"
  },
  {
    "id": "s0121",
    "blockIndex": 13,
    "zh": "諸買武功爵至千夫者，得先除為吏。"
  },
  {
    "id": "s0122",
    "blockIndex": 13,
    "zh": "吏道雜而多端，官職耗廢矣。"
  },
  {
    "id": "s0124",
    "blockIndex": 14,
    "zh": "1冬，十月，上行幸雍，祠五畤，獲獸，一角而足有五蹄。"
  },
  {
    "id": "s0125",
    "blockIndex": 14,
    "zh": "有司言：「陛下肅祗郊祀，上帝報享，錫一角獸，蓋麟雲。"
  },
  {
    "id": "s0126",
    "blockIndex": 14,
    "zh": "」於是以慶五畤，畤加一牛，以燎。"
  },
  {
    "id": "s0127",
    "blockIndex": 14,
    "zh": "久之，有司又言：「元宜以天瑞命，不宜以一二數，一元曰建，二元以長星曰光，今元以郊得一角獸曰狩雲。"
  },
  {
    "id": "s0128",
    "blockIndex": 14,
    "zh": "」於是濟北王以為天子且封禪，上書獻太山及其旁邑。"
  },
  {
    "id": "s0129",
    "blockIndex": 14,
    "zh": "天子以他縣償之。"
  },
  {
    "id": "s0130",
    "blockIndex": 14,
    "zh": "----2淮南王安與賓客左吳等日夜為反謀，按輿地圖，部署兵所從入。"
  },
  {
    "id": "s0131",
    "blockIndex": 14,
    "zh": "諸使者道長安來，為妄言，言「上無男，漢不治」，即喜；"
  },
  {
    "id": "s0132",
    "blockIndex": 14,
    "zh": "即言「漢廷治，有男」，王怒，以為妄言，非也。"
  },
  {
    "id": "s0133",
    "blockIndex": 15,
    "zh": "王召中郎伍被與謀反事，被曰：「王安得此亡國之言乎？"
  },
  {
    "id": "s0134",
    "blockIndex": 15,
    "zh": "臣見宮中生荊棘，露霑衣也。"
  },
  {
    "id": "s0135",
    "blockIndex": 15,
    "zh": "」王怒，系伍被父母，囚之。"
  },
  {
    "id": "s0136",
    "blockIndex": 15,
    "zh": "三月，復召問之，被曰：「昔秦為無道，窮奢極虐，百姓思亂者十家而六七。"
  },
  {
    "id": "s0137",
    "blockIndex": 15,
    "zh": "高皇帝起於行陳之中，立為天子，此所謂蹈瑕候間，因秦之亡而動者也。"
  },
  {
    "id": "s0138",
    "blockIndex": 15,
    "zh": "今大王見高皇帝得天下之易也，獨不觀近世之吳、楚乎！"
  },
  {
    "id": "s0139",
    "blockIndex": 15,
    "zh": "夫吳王王四郡，國富民眾，計定謀成，舉兵而西；"
  },
  {
    "id": "s0140",
    "blockIndex": 15,
    "zh": "然破於大梁，奔走而東，身死祀絕者何？"
  },
  {
    "id": "s0141",
    "blockIndex": 15,
    "zh": "誠逆天道而不知時也。"
  },
  {
    "id": "s0142",
    "blockIndex": 15,
    "zh": "方今大王之兵，眾不能十分吳、楚之一，天下安寧，萬倍吳、楚之時，大王不從臣之計，今見大王棄千乘之君，賜絕命之書，為群臣先死於東宮也。"
  },
  {
    "id": "s0143",
    "blockIndex": 15,
    "zh": "」王涕泣而起。"
  },
  {
    "id": "s0144",
    "blockIndex": 16,
    "zh": "王有孽子不害，最長，王弗愛，王后、太子皆不以為子、兄數。"
  },
  {
    "id": "s0145",
    "blockIndex": 16,
    "zh": "不害有子建，材高有氣，常怨望太子，陰使人告太子謀殺漢中尉事，下廷尉治。"
  },
  {
    "id": "s0146",
    "blockIndex": 17,
    "zh": "王患之，欲發，復問伍被曰：「公以為吳興兵，是邪？"
  },
  {
    "id": "s0147",
    "blockIndex": 17,
    "zh": "非邪？"
  },
  {
    "id": "s0148",
    "blockIndex": 17,
    "zh": "」被曰：「非也。"
  },
  {
    "id": "s0149",
    "blockIndex": 17,
    "zh": "臣聞吳王悔之甚，願王無為吳王之所悔。"
  },
  {
    "id": "s0150",
    "blockIndex": 17,
    "zh": "」王曰：「吳何知反！"
  },
  {
    "id": "s0151",
    "blockIndex": 17,
    "zh": "漢將一日過成皋者四十餘人，今我絕成皋之口，據三川之險，招山東之兵，舉事如此，左吳、趙賢、朱驕如皆以為什事九成，公獨以為有禍無福，何也？"
  },
  {
    "id": "s0152",
    "blockIndex": 17,
    "zh": "必如公言，不可徼幸邪？"
  },
  {
    "id": "s0153",
    "blockIndex": 17,
    "zh": "」被曰：「必不得已，被有愚計。"
  },
  {
    "id": "s0154",
    "blockIndex": 17,
    "zh": "當今諸侯無異心，百姓無怨氣，可偽為丞相、御史請書，徙郡國豪桀高貲於朔方，益發甲卒，急其會日；"
  },
  {
    "id": "s0155",
    "blockIndex": 17,
    "zh": "又偽為詔獄書，逮諸侯太子、幸臣。"
  },
  {
    "id": "s0156",
    "blockIndex": 17,
    "zh": "如此，則民怨，諸侯懼，即使辯士隨而說之，儻可徼幸什得一乎！"
  },
  {
    "id": "s0157",
    "blockIndex": 17,
    "zh": "」王曰：「此可也。"
  },
  {
    "id": "s0158",
    "blockIndex": 17,
    "zh": "雖然，吾以為不至若此。"
  },
  {
    "id": "s0160",
    "blockIndex": 18,
    "zh": "於是王乃作皇帝璽，丞相、御史大夫、將軍、軍吏、中二千石及旁近郡太守、都尉印，漢使節。"
  },
  {
    "id": "s0161",
    "blockIndex": 18,
    "zh": "欲使人偽得罪而西，事大將軍，一日發兵，即刺殺大將軍。"
  },
  {
    "id": "s0162",
    "blockIndex": 18,
    "zh": "且曰：「漢廷大臣，獨汲黯好直諫，守節死義，難惑以非；"
  },
  {
    "id": "s0163",
    "blockIndex": 18,
    "zh": "至如說丞相弘等，如發蒙振落耳！"
  },
  {
    "id": "s0165",
    "blockIndex": 19,
    "zh": "王欲發國中兵，恐其相、二千石不聽，王乃與伍被謀先殺相、二千石。"
  },
  {
    "id": "s0166",
    "blockIndex": 19,
    "zh": "又欲令人衣求盜衣，持羽檄從東方來，呼曰：「南越兵入界！"
  },
  {
    "id": "s0167",
    "blockIndex": 19,
    "zh": "」欲因以發兵。"
  },
  {
    "id": "s0168",
    "blockIndex": 20,
    "zh": "會廷尉逮捕淮南太子，淮南王聞之，與太子謀，召相、二千石，欲殺而發兵。"
  },
  {
    "id": "s0169",
    "blockIndex": 20,
    "zh": "召相，相至，內史、中尉皆不至。"
  },
  {
    "id": "s0170",
    "blockIndex": 20,
    "zh": "王念，獨殺相無益也，即罷相。"
  },
  {
    "id": "s0171",
    "blockIndex": 20,
    "zh": "王猶豫，計未決。"
  },
  {
    "id": "s0172",
    "blockIndex": 20,
    "zh": "太子即自剄，不殊。"
  },
  {
    "id": "s0173",
    "blockIndex": 21,
    "zh": "伍被自詣吏，告與淮南王謀反蹤跡如此。"
  },
  {
    "id": "s0174",
    "blockIndex": 21,
    "zh": "吏因捕太子、王后，圍王宮，盡求捕王所與謀反賓客在國中者，索得反具，以上。"
  },
  {
    "id": "s0175",
    "blockIndex": 21,
    "zh": "下公卿治其黨與，使宗正以符節治王。"
  },
  {
    "id": "s0176",
    "blockIndex": 21,
    "zh": "未至，淮南王安自剄。"
  },
  {
    "id": "s0177",
    "blockIndex": 21,
    "zh": "殺王后荼、太子遷，諸所與謀反者皆族。"
  },
  {
    "id": "s0178",
    "blockIndex": 22,
    "zh": "天子以伍被雅辭多引漢之美，欲勿誅。"
  },
  {
    "id": "s0179",
    "blockIndex": 22,
    "zh": "廷尉湯曰：「被首為王畫反計，罪不可赦。"
  },
  {
    "id": "s0180",
    "blockIndex": 22,
    "zh": "」乃誅被。"
  },
  {
    "id": "s0181",
    "blockIndex": 22,
    "zh": "侍中莊助素與淮南王相結交，私論議，王厚賂遺助；"
  },
  {
    "id": "s0182",
    "blockIndex": 22,
    "zh": "上薄其罪，欲勿誅。"
  },
  {
    "id": "s0183",
    "blockIndex": 22,
    "zh": "張湯爭，以為：「助出入禁門，腹心之臣，而外與諸侯交私如此，不誅，後不可治。"
  },
  {
    "id": "s0184",
    "blockIndex": 22,
    "zh": "」助竟棄市。"
  },
  {
    "id": "s0185",
    "blockIndex": 23,
    "zh": "衡山王上書，請廢太子爽，立其弟孝為太子。"
  },
  {
    "id": "s0186",
    "blockIndex": 23,
    "zh": "爽聞，即遣所善白嬴之長安上書，言「孝作輣車、鍛矢，與王御者奸」，欲以敗孝。"
  },
  {
    "id": "s0187",
    "blockIndex": 23,
    "zh": "會有司捕所與淮南謀反者，得陳喜於衡山王子孝家，吏劾孝首匿喜。"
  },
  {
    "id": "s0188",
    "blockIndex": 23,
    "zh": "孝聞「律：先自告，除其罪」，即先自告所與謀反者枚赫、陳喜等。"
  },
  {
    "id": "s0189",
    "blockIndex": 23,
    "zh": "公卿請逮捕衡山王治之，王自剄死。"
  },
  {
    "id": "s0190",
    "blockIndex": 23,
    "zh": "王后徐來、太子爽及孝皆棄市，所與謀反者皆族。"
  },
  {
    "id": "s0191",
    "blockIndex": 24,
    "zh": "凡淮南、衡山二獄，所連引列侯、二千石、豪桀等，死者數萬人。"
  },
  {
    "id": "s0192",
    "blockIndex": 24,
    "zh": "----3夏，四月，赦天下。"
  },
  {
    "id": "s0193",
    "blockIndex": 24,
    "zh": "----4丁卯，立皇子據為太子，年七歲。"
  },
  {
    "id": "s0194",
    "blockIndex": 24,
    "zh": "----5五月，乙巳晦，日有食之。"
  },
  {
    "id": "s0195",
    "blockIndex": 24,
    "zh": "----6匈奴萬人入上谷，殺數百人。"
  },
  {
    "id": "s0196",
    "blockIndex": 24,
    "zh": "----7初，張騫自月氏還，具為天子言西域諸國風俗：「大宛在漢正西，可萬里。"
  },
  {
    "id": "s0197",
    "blockIndex": 24,
    "zh": "其俗土著，耕田；"
  },
  {
    "id": "s0198",
    "blockIndex": 24,
    "zh": "多善馬，馬汗血；"
  },
  {
    "id": "s0199",
    "blockIndex": 24,
    "zh": "有城郭、室屋，如中國。"
  },
  {
    "id": "s0200",
    "blockIndex": 24,
    "zh": "其東北則烏孫，東則-{于窴}-。"
  },
  {
    "id": "s0201",
    "blockIndex": 24,
    "zh": "-{于窴}-之西，則水皆西流注西海，其東，水東流注鹽澤。"
  },
  {
    "id": "s0202",
    "blockIndex": 24,
    "zh": "鹽澤潛行地下，其南則河源出焉。"
  },
  {
    "id": "s0203",
    "blockIndex": 24,
    "zh": "鹽澤去長安可五千里。"
  },
  {
    "id": "s0204",
    "blockIndex": 24,
    "zh": "匈奴右方居鹽澤以東，至隴西長城，南接羌，鬲漢道焉。"
  },
  {
    "id": "s0205",
    "blockIndex": 24,
    "zh": "烏孫、康居、奄蔡、大月氏，皆行國，隨畜牧，與匈奴同俗。"
  },
  {
    "id": "s0206",
    "blockIndex": 24,
    "zh": "大夏在大宛西南，與大宛同俗。"
  },
  {
    "id": "s0207",
    "blockIndex": 24,
    "zh": "臣在大夏時，見邛竹杖、蜀布，問曰：『安得此？"
  },
  {
    "id": "s0208",
    "blockIndex": 24,
    "zh": "』大夏國人曰：『吾賈人往市之身毒。"
  },
  {
    "id": "s0209",
    "blockIndex": 24,
    "zh": "』身毒在大夏東南可數千里，其俗土著，與大夏同。"
  },
  {
    "id": "s0210",
    "blockIndex": 24,
    "zh": "以騫度之，大夏去漢萬二千里，居漢西南；"
  },
  {
    "id": "s0211",
    "blockIndex": 24,
    "zh": "今身毒國又居大夏東南數千里，有蜀物，此其去蜀不遠矣。"
  },
  {
    "id": "s0212",
    "blockIndex": 24,
    "zh": "今使大夏，從羌中，險，羌人惡之；"
  },
  {
    "id": "s0213",
    "blockIndex": 24,
    "zh": "少北，則為匈奴所得；"
  },
  {
    "id": "s0214",
    "blockIndex": 24,
    "zh": "從蜀，宜徑，又無寇。"
  },
  {
    "id": "s0216",
    "blockIndex": 25,
    "zh": "天子既聞大宛及大夏、安息之屬皆大國，多奇物，土著，頗與中國同業，而兵弱，貴漢財物。"
  },
  {
    "id": "s0217",
    "blockIndex": 25,
    "zh": "其北有大月氏、康居之屬，兵強，可以賂遺設利朝也。"
  },
  {
    "id": "s0218",
    "blockIndex": 25,
    "zh": "誠得而以義屬之，則廣地萬里，重九譯，致殊俗，威德遍於四海，欣然以騫言為然。"
  },
  {
    "id": "s0219",
    "blockIndex": 25,
    "zh": "乃令騫因蜀、犍為發間使-{王然于}-等四道並出：出駹，出冉，出徙，出邛、僰，指求身毒國，各行一二千里，其北方閉氐、莋，南方閉巂、昆明。"
  },
  {
    "id": "s0220",
    "blockIndex": 25,
    "zh": "昆明之屬無君長，善寇盜，輒殺略漢使，終莫得通。"
  },
  {
    "id": "s0221",
    "blockIndex": 25,
    "zh": "於是漢以求身毒道，始通滇國。"
  },
  {
    "id": "s0222",
    "blockIndex": 25,
    "zh": "滇王當羌謂漢使者曰：「漢孰與我大？"
  },
  {
    "id": "s0223",
    "blockIndex": 25,
    "zh": "」及夜郎侯亦然。"
  },
  {
    "id": "s0224",
    "blockIndex": 25,
    "zh": "以道不通，故各自以為一州主，不知漢廣大。"
  },
  {
    "id": "s0225",
    "blockIndex": 25,
    "zh": "使者還，因盛言滇大國，足事親附；"
  },
  {
    "id": "s0226",
    "blockIndex": 25,
    "zh": "天子注意焉，乃復事西南夷。"
  },
  {
    "id": "s0227",
    "blockIndex": 25,
    "zh": "----1冬，十月，上幸雍，祠五畤。"
  },
  {
    "id": "s0228",
    "blockIndex": 25,
    "zh": "----2三月，戊寅，平津獻侯公孫弘薨。"
  },
  {
    "id": "s0229",
    "blockIndex": 25,
    "zh": "壬辰，以御史大夫樂安侯李蔡為丞相，廷尉張湯為御史大夫。"
  },
  {
    "id": "s0230",
    "blockIndex": 25,
    "zh": "----3霍去病為驃騎將軍，將萬騎出隴西，擊匈奴，歷五王國，轉戰六日，過焉支山千餘里，殺折蘭王，斬盧侯王，執渾邪王子及相國、都尉，獲首虜八千九百餘級，收休屠王祭天金人。"
  },
  {
    "id": "s0231",
    "blockIndex": 25,
    "zh": "詔益封去病二千戶。"
  },
  {
    "id": "s0232",
    "blockIndex": 26,
    "zh": "夏，去病復與合騎侯公孫敖將數萬騎俱出北地，異道。"
  },
  {
    "id": "s0233",
    "blockIndex": 26,
    "zh": "衛尉張騫、郎中令李廣俱出右北平，異道。"
  },
  {
    "id": "s0234",
    "blockIndex": 26,
    "zh": "廣將四千騎先行，可數百里，騫將萬騎在後。"
  },
  {
    "id": "s0235",
    "blockIndex": 26,
    "zh": "匈奴左賢王將四萬騎圍廣，廣軍士皆恐；"
  },
  {
    "id": "s0236",
    "blockIndex": 26,
    "zh": "廣乃使其子敢獨與數十騎馳貫胡騎，出其左右而還，告廣曰：「胡虜易與耳！"
  },
  {
    "id": "s0237",
    "blockIndex": 26,
    "zh": "」軍士乃安。"
  },
  {
    "id": "s0238",
    "blockIndex": 26,
    "zh": "廣為圜陳，外向。"
  },
  {
    "id": "s0239",
    "blockIndex": 26,
    "zh": "胡急擊之，矢下如雨。"
  },
  {
    "id": "s0240",
    "blockIndex": 26,
    "zh": "漢兵死者過半，漢矢且盡。"
  },
  {
    "id": "s0241",
    "blockIndex": 26,
    "zh": "廣乃令士持滿毋發，而廣身自以大黃射其裨將，殺數人，胡虜益解。"
  },
  {
    "id": "s0242",
    "blockIndex": 26,
    "zh": "會日暮，吏士皆無人色，而廣意氣自如，益治軍，軍中皆服其勇。"
  },
  {
    "id": "s0243",
    "blockIndex": 26,
    "zh": "明日，復力戰，死者過半，所殺亦過當。"
  },
  {
    "id": "s0244",
    "blockIndex": 26,
    "zh": "會博望侯軍亦至，匈奴軍乃解去。"
  },
  {
    "id": "s0245",
    "blockIndex": 26,
    "zh": "漢軍罷，弗能追，罷歸。"
  },
  {
    "id": "s0246",
    "blockIndex": 26,
    "zh": "漢法：博望侯留遲後期，當死，贖為庶人。"
  },
  {
    "id": "s0247",
    "blockIndex": 26,
    "zh": "廣軍功自如，無賞。"
  },
  {
    "id": "s0248",
    "blockIndex": 26,
    "zh": "而驃騎將軍去病深入二千餘里，與合騎侯失，不相得。"
  },
  {
    "id": "s0249",
    "blockIndex": 26,
    "zh": "驃騎將軍逾居延，過小月氏，至祁連山，得單桓、酋塗王，及相國、都尉以眾降者二千五百人，斬首虜三萬二百級，獲裨小王七十餘人。"
  },
  {
    "id": "s0250",
    "blockIndex": 26,
    "zh": "天子益封去病五千戶，封其裨將有功者鷹擊司馬趙破奴為從驃侯，校尉高不識為宜冠侯，校尉僕多為煇渠侯。"
  },
  {
    "id": "s0251",
    "blockIndex": 26,
    "zh": "合騎侯敖坐行留不與驃騎會，當斬，贖為庶人。"
  },
  {
    "id": "s0252",
    "blockIndex": 27,
    "zh": "是時，諸宿將所將士、馬、兵皆不如驃騎，驃騎所將常選，然亦敢深入，常與壯騎先其大軍；"
  },
  {
    "id": "s0253",
    "blockIndex": 27,
    "zh": "軍亦有天幸，未嘗困絕也。"
  },
  {
    "id": "s0254",
    "blockIndex": 27,
    "zh": "而諸宿將常留落不偶，由此驃騎日以親貴，比大將軍矣。"
  },
  {
    "id": "s0255",
    "blockIndex": 28,
    "zh": "匈奴入代、雁門，殺略數百人。"
  },
  {
    "id": "s0256",
    "blockIndex": 28,
    "zh": "----4江都王建與其父易王所幸淖姬等及女弟徵臣奸。"
  },
  {
    "id": "s0257",
    "blockIndex": 28,
    "zh": "建游雷陂，天大風，建使郎二人乘小船入陂中。"
  },
  {
    "id": "s0258",
    "blockIndex": 28,
    "zh": "船覆，兩郎溺，攀船，乍見乍沒。"
  },
  {
    "id": "s0259",
    "blockIndex": 28,
    "zh": "建臨觀大笑，令勿救，皆死。"
  },
  {
    "id": "s0260",
    "blockIndex": 28,
    "zh": "凡殺不辜三十五人，專為淫虐。"
  },
  {
    "id": "s0261",
    "blockIndex": 28,
    "zh": "自知罪多，恐誅，與其-{后}-成光共使越婢下神，祝詛上。"
  },
  {
    "id": "s0262",
    "blockIndex": 28,
    "zh": "又聞淮南、衡山陰謀，建亦作兵器，刻皇帝璽，為反具。"
  },
  {
    "id": "s0263",
    "blockIndex": 28,
    "zh": "事發覺，有司請捕誅，建自殺，-{后}-成光等皆棄市，國除。"
  },
  {
    "id": "s0264",
    "blockIndex": 28,
    "zh": "----5膠東康王寄薨。"
  },
  {
    "id": "s0265",
    "blockIndex": 28,
    "zh": "----6秋，匈奴渾邪王降。"
  },
  {
    "id": "s0266",
    "blockIndex": 28,
    "zh": "是時，單于怒渾邪王、休屠王居西方為漢所殺虜數萬人，欲召誅之。"
  },
  {
    "id": "s0267",
    "blockIndex": 28,
    "zh": "渾邪王與休屠王恐，謀降漢，先遣使向邊境要遮漢人，令報天子。"
  },
  {
    "id": "s0268",
    "blockIndex": 28,
    "zh": "是時，大行李息將城河上，得渾邪王使，馳傳以聞。"
  },
  {
    "id": "s0269",
    "blockIndex": 28,
    "zh": "天子聞之，恐其以詐降而襲邊，乃令驃騎將軍將兵往迎之。"
  },
  {
    "id": "s0270",
    "blockIndex": 28,
    "zh": "休屠王後悔，渾邪王殺之，并其眾。"
  },
  {
    "id": "s0271",
    "blockIndex": 28,
    "zh": "驃騎既渡河，與渾邪王眾相望。"
  },
  {
    "id": "s0272",
    "blockIndex": 28,
    "zh": "渾邪王裨將見漢軍，而多不欲降者，頗遁去。"
  },
  {
    "id": "s0273",
    "blockIndex": 28,
    "zh": "驃騎乃馳入，得與渾邪王相見，斬其欲亡者八千人，遂獨遣渾邪王乘傳詣至行在所，盡將其眾渡河。"
  },
  {
    "id": "s0274",
    "blockIndex": 28,
    "zh": "降者四萬餘人，號稱十萬。"
  },
  {
    "id": "s0275",
    "blockIndex": 28,
    "zh": "既至長安，天子所以賞賜者數十巨萬；"
  },
  {
    "id": "s0276",
    "blockIndex": 28,
    "zh": "封渾邪王萬戶，為漯陰侯，封其裨王呼毒尼等四人皆為列侯。"
  },
  {
    "id": "s0277",
    "blockIndex": 28,
    "zh": "益封驃騎千七百戶。"
  },
  {
    "id": "s0278",
    "blockIndex": 29,
    "zh": "渾邪之降也，漢發車二萬乘以迎之，縣官無錢，從民貰馬，民或匿馬，馬不具。"
  },
  {
    "id": "s0279",
    "blockIndex": 29,
    "zh": "上怒，欲斬長安令，右內史汲黯曰：「長安令無罪，獨斬臣黯，民乃肯出馬。"
  },
  {
    "id": "s0280",
    "blockIndex": 29,
    "zh": "且匈奴畔其主而降漢，漢徐以縣次傳之，何至令天下騷動，罷敝中國而以事夷狄之人乎！"
  },
  {
    "id": "s0281",
    "blockIndex": 29,
    "zh": "」上默然。"
  },
  {
    "id": "s0282",
    "blockIndex": 29,
    "zh": "及渾邪至，賈人與市者坐當死五百餘人，黯請間見高門，曰：「夫匈奴攻當路塞，絕和親，中國興兵誅之，死傷者不可勝計，而費以巨萬百數。"
  },
  {
    "id": "s0283",
    "blockIndex": 29,
    "zh": "臣愚以為陛下得胡人，皆以為奴婢，以賜從軍死事者家，所鹵獲，因予之，以謝天下之苦，塞百姓之心。"
  },
  {
    "id": "s0284",
    "blockIndex": 29,
    "zh": "今縱不能，渾邪率數萬之眾來降，虛府庫賞賜，發良民侍養，譬若奉驕子，愚民安知市買長安中物，而文吏繩以為闌出財物於邊關乎！"
  },
  {
    "id": "s0285",
    "blockIndex": 29,
    "zh": "陛下縱不能得匈奴之資以謝天下，又以微文殺無知者五百餘人，是所謂庇其葉而傷其枝者也。"
  },
  {
    "id": "s0286",
    "blockIndex": 29,
    "zh": "臣竊為陛下不取也。"
  },
  {
    "id": "s0287",
    "blockIndex": 29,
    "zh": "」上默然不許，曰：「吾久不聞汲黯之言，今又復妄發矣。"
  },
  {
    "id": "s0289",
    "blockIndex": 30,
    "zh": "居頃之，乃分徙降者邊五郡故塞外，而皆在河南，因其故俗為五屬國。"
  },
  {
    "id": "s0290",
    "blockIndex": 30,
    "zh": "而金城河西，西並南山至鹽澤，空無匈奴，匈奴時有候者到而希矣。"
  },
  {
    "id": "s0291",
    "blockIndex": 31,
    "zh": "休屠王太子日磾與母閼氏、弟倫俱沒入官，輸黃門養馬。"
  },
  {
    "id": "s0292",
    "blockIndex": 31,
    "zh": "久之，帝游宴，見馬，後宮滿側，日磾等數十人牽馬過殿下，莫不竊視，至日磾獨不敢。"
  },
  {
    "id": "s0293",
    "blockIndex": 31,
    "zh": "日磾長八尺二寸，容貌甚嚴，馬又肥好，上異而問之，具以本狀對。"
  },
  {
    "id": "s0294",
    "blockIndex": 31,
    "zh": "對奇焉，即日賜湯沐、衣冠，拜為馬監，遷侍中、駙馬都尉、光祿大夫。"
  },
  {
    "id": "s0295",
    "blockIndex": 31,
    "zh": "日磾既親近，未嘗有過失，上甚信愛之，賞賜累千金，出則驂乘，入侍左右。"
  },
  {
    "id": "s0296",
    "blockIndex": 31,
    "zh": "貴戚多竊怨曰：「陛下妄得一胡兒，反貴重之。"
  },
  {
    "id": "s0297",
    "blockIndex": 31,
    "zh": "」上聞，愈厚焉。"
  },
  {
    "id": "s0298",
    "blockIndex": 31,
    "zh": "以休屠作金人為祭天主，故賜日磾姓金氏。"
  },
  {
    "id": "s0300",
    "blockIndex": 32,
    "zh": "1春，有星孛於東方。"
  },
  {
    "id": "s0301",
    "blockIndex": 32,
    "zh": "----2夏，五月。"
  },
  {
    "id": "s0302",
    "blockIndex": 32,
    "zh": "赦天下。"
  },
  {
    "id": "s0303",
    "blockIndex": 32,
    "zh": "----3淮南王之謀反也，膠東康王寄微聞其事，私作戰守備。"
  },
  {
    "id": "s0304",
    "blockIndex": 32,
    "zh": "及吏治淮南事，辭出之。"
  },
  {
    "id": "s0305",
    "blockIndex": 32,
    "zh": "寄母王夫人，即皇太后之女弟也，於上最親，意自傷，發病而死，不敢置後。"
  },
  {
    "id": "s0306",
    "blockIndex": 32,
    "zh": "上聞而憐之，立其長子賢為膠東王。"
  },
  {
    "id": "s0307",
    "blockIndex": 32,
    "zh": "又封其所愛少子慶為六安王，王故衡山王地。"
  },
  {
    "id": "s0308",
    "blockIndex": 32,
    "zh": "----4秋，匈奴入右北平、定襄，各數萬騎，殺略千餘人。"
  },
  {
    "id": "s0309",
    "blockIndex": 32,
    "zh": "----5山東大水，民多饑乏。"
  },
  {
    "id": "s0310",
    "blockIndex": 32,
    "zh": "天子遣使者虛郡國倉癐以振貧民，猶不足，又募豪富吏民能假貸貧民者以名聞，尚不能相救。"
  },
  {
    "id": "s0311",
    "blockIndex": 32,
    "zh": "乃徙貧民於關以西及充朔方以南新秦中七十餘萬口，衣食皆仰給縣官，數歲假予產業。"
  },
  {
    "id": "s0312",
    "blockIndex": 32,
    "zh": "使者分部護之，冠蓋相望。"
  },
  {
    "id": "s0313",
    "blockIndex": 32,
    "zh": "其費以億計，不可勝數。"
  },
  {
    "id": "s0314",
    "blockIndex": 32,
    "zh": "----6漢既得渾邪王地，隴西、北地、上郡益少胡寇，詔減三郡戍卒之半，以寬天下之繇。"
  },
  {
    "id": "s0315",
    "blockIndex": 32,
    "zh": "----7上將討昆明，以昆明有滇池方三百里，乃作昆明池以習水戰。"
  },
  {
    "id": "s0316",
    "blockIndex": 32,
    "zh": "是時法既益嚴，吏多廢免。"
  },
  {
    "id": "s0317",
    "blockIndex": 32,
    "zh": "兵革數動，民多買復及五大夫，征發之士益鮮。"
  },
  {
    "id": "s0318",
    "blockIndex": 32,
    "zh": "於是除千夫、五大夫為吏，不欲者出馬，以故吏弄法，皆謫令伐棘上林，穿昆明池。"
  },
  {
    "id": "s0319",
    "blockIndex": 32,
    "zh": "----8是歲，得神馬於渥窪水中。"
  },
  {
    "id": "s0320",
    "blockIndex": 32,
    "zh": "上方立樂府，使司馬相如等造為詩賦，以宦者李延年為協律都尉，佩二千石印；"
  },
  {
    "id": "s0321",
    "blockIndex": 32,
    "zh": "弦次初詩以合八音之調。"
  },
  {
    "id": "s0322",
    "blockIndex": 32,
    "zh": "詩多《爾雅》之文，通一經之士不能獨知其辭，必集會《五經》家相與共講習讀之，乃能通知其意。"
  },
  {
    "id": "s0323",
    "blockIndex": 32,
    "zh": "及得神馬，次以為歌。"
  },
  {
    "id": "s0324",
    "blockIndex": 32,
    "zh": "汲黯曰：「凡王者作樂，上以承祖宗，下以化兆民。"
  },
  {
    "id": "s0325",
    "blockIndex": 32,
    "zh": "今陛下得馬，詩以為歌，協於宗廟，先帝百姓豈能知其音邪？"
  },
  {
    "id": "s0326",
    "blockIndex": 32,
    "zh": "」上默然不說。"
  },
  {
    "id": "s0327",
    "blockIndex": 33,
    "zh": "上招延士大夫，常如不足；"
  },
  {
    "id": "s0328",
    "blockIndex": 33,
    "zh": "然性嚴峻，群臣雖素所愛信者，或小有犯法，或欺罔，輒按誅之，無所寬假。"
  },
  {
    "id": "s0329",
    "blockIndex": 33,
    "zh": "汲黯諫曰：「陛下求賢甚勞，未盡其用，輒已殺之。"
  },
  {
    "id": "s0330",
    "blockIndex": 33,
    "zh": "以有限之士恣無已之誅，臣恐天下賢才將盡，陛下誰與共為治乎！"
  },
  {
    "id": "s0331",
    "blockIndex": 33,
    "zh": "」黯言之甚怒，上笑而諭之曰：「何世無才，患人不能識之耳，苟能識之，何患無人！"
  },
  {
    "id": "s0332",
    "blockIndex": 33,
    "zh": "夫所謂才者，猶有用之器也，有才而不肯盡用，與無才同，不殺何施！"
  },
  {
    "id": "s0333",
    "blockIndex": 33,
    "zh": "」黯曰：「臣雖不能以言屈陛下，而心猶以為非。"
  },
  {
    "id": "s0334",
    "blockIndex": 33,
    "zh": "願陛下自今改之，無以臣為愚而不知理也。"
  },
  {
    "id": "s0335",
    "blockIndex": 33,
    "zh": "」上顧群臣曰：「黯自言為便辟則不可，自言為愚，豈不信然乎！"
  },
  {
    "id": "s0337",
    "blockIndex": 34,
    "zh": "1冬，有司言：「縣官用度太空，而富商大賈冶鑄、煮鹽，財或累萬金，不佐國家之急。"
  },
  {
    "id": "s0338",
    "blockIndex": 34,
    "zh": "請更錢造幣以贍用，而摧浮淫并兼之徒。"
  },
  {
    "id": "s0339",
    "blockIndex": 34,
    "zh": "」是時，禁苑有白鹿而少府多銀、錫，乃以白鹿皮方尺，緣以藻繢，為皮幣，直四十萬。"
  },
  {
    "id": "s0340",
    "blockIndex": 34,
    "zh": "王侯、宗室，朝覲、聘享，必以皮幣薦璧，然後得行。"
  },
  {
    "id": "s0341",
    "blockIndex": 34,
    "zh": "又造銀、錫為白金三品：大者圜之，其文龍，直三千；"
  },
  {
    "id": "s0342",
    "blockIndex": 34,
    "zh": "次方之，其文馬，直五百；"
  },
  {
    "id": "s0343",
    "blockIndex": 34,
    "zh": "小者橢之，其文龜，直三百。"
  },
  {
    "id": "s0344",
    "blockIndex": 34,
    "zh": "令縣官銷半兩錢，更鑄三銖錢，盜鑄諸金錢罪皆死；"
  },
  {
    "id": "s0345",
    "blockIndex": 34,
    "zh": "而吏民之盜鑄白金者不可勝數。"
  },
  {
    "id": "s0346",
    "blockIndex": 35,
    "zh": "於是以東郭咸陽、孔僅為大農丞，領鹽鐵事；"
  },
  {
    "id": "s0347",
    "blockIndex": 35,
    "zh": "桑弘羊以計算用事。"
  },
  {
    "id": "s0348",
    "blockIndex": 35,
    "zh": "咸陽，齊之大煮鹽；"
  },
  {
    "id": "s0349",
    "blockIndex": 35,
    "zh": "僅，南陽大冶，皆致生累千金。"
  },
  {
    "id": "s0350",
    "blockIndex": 35,
    "zh": "弘羊，洛陽賈人之子，以心計，年十三侍中。"
  },
  {
    "id": "s0351",
    "blockIndex": 35,
    "zh": "三人言利，事析秋毫矣。"
  },
  {
    "id": "s0352",
    "blockIndex": 36,
    "zh": "詔禁民敢私鑄鐵器、煮鹽者釱左趾，沒入其器物。"
  },
  {
    "id": "s0353",
    "blockIndex": 36,
    "zh": "公卿又請令諸賈人末作各以其物自占，率緡錢二千而一算；"
  },
  {
    "id": "s0354",
    "blockIndex": 36,
    "zh": "及民有軺車若船五丈以上者，皆有算。"
  },
  {
    "id": "s0355",
    "blockIndex": 36,
    "zh": "匿不自占，占不悉，戍邊一歲，沒入緡錢。"
  },
  {
    "id": "s0356",
    "blockIndex": 36,
    "zh": "有能告者，以其半畀之。"
  },
  {
    "id": "s0357",
    "blockIndex": 36,
    "zh": "其法大抵出張湯。"
  },
  {
    "id": "s0358",
    "blockIndex": 36,
    "zh": "湯每朝奏事，語國家用，日晏，天子忘食。"
  },
  {
    "id": "s0359",
    "blockIndex": 36,
    "zh": "丞相充位，天下事皆決於湯。"
  },
  {
    "id": "s0360",
    "blockIndex": 36,
    "zh": "百姓騷動，不安其生，咸指怨湯。"
  },
  {
    "id": "s0361",
    "blockIndex": 36,
    "zh": "----2初，河南人卜式，數請輸財縣官以助邊，天子使使問式：「欲官乎？"
  },
  {
    "id": "s0362",
    "blockIndex": 36,
    "zh": "」式曰：「臣少田牧，不習仕宦，不願也。"
  },
  {
    "id": "s0363",
    "blockIndex": 36,
    "zh": "」使者問曰：「家豈有冤，欲言事乎？"
  },
  {
    "id": "s0364",
    "blockIndex": 36,
    "zh": "」式曰：「臣生與人無分爭，邑人貧者貸之，不善者教之，所居人皆從式，式何故見冤於人！"
  },
  {
    "id": "s0365",
    "blockIndex": 36,
    "zh": "無所欲言也。"
  },
  {
    "id": "s0366",
    "blockIndex": 36,
    "zh": "」使者曰：「苟如此，子何欲而然？"
  },
  {
    "id": "s0367",
    "blockIndex": 36,
    "zh": "」式曰：「天子誅匈奴，愚以為賢者宜死節於邊，有財者宜輸委，如此而匈奴可滅也。"
  },
  {
    "id": "s0368",
    "blockIndex": 36,
    "zh": "」上由是賢之，欲尊顯以風百姓，乃召拜式為中郎，爵左庶長，賜田十頃，佈告下天，使明知之。"
  },
  {
    "id": "s0369",
    "blockIndex": 36,
    "zh": "未幾，又擢式為齊太傅。"
  },
  {
    "id": "s0370",
    "blockIndex": 36,
    "zh": "----3春，有星孛於東北。"
  },
  {
    "id": "s0371",
    "blockIndex": 36,
    "zh": "夏，有長星出於西北。"
  },
  {
    "id": "s0372",
    "blockIndex": 36,
    "zh": "----4上與諸將議曰：「翕侯趙信為單于畫計，常以為漢兵不能度幕輕留，今大發士卒，其勢必得所欲。"
  },
  {
    "id": "s0373",
    "blockIndex": 36,
    "zh": "」乃粟馬十萬，令大將軍青、驃騎將軍去病各將五萬騎，私負從馬復四萬匹，步兵轉者踵軍後又數十萬人，而敢力戰深入之士皆屬驃騎。"
  },
  {
    "id": "s0374",
    "blockIndex": 36,
    "zh": "驃騎始為出定襄，當單于，捕虜言單于東，乃更令驃騎出代郡，令大將軍出定襄。"
  },
  {
    "id": "s0375",
    "blockIndex": 36,
    "zh": "郎中令李廣數自請行，天子以為老，弗許；"
  },
  {
    "id": "s0376",
    "blockIndex": 36,
    "zh": "良久，乃許之，以為前將軍。"
  },
  {
    "id": "s0377",
    "blockIndex": 36,
    "zh": "太僕公孫賀為左將軍，主爵都尉趙食其為右將軍，平陽侯曹瓤為後將軍，皆屬大將軍。"
  },
  {
    "id": "s0378",
    "blockIndex": 36,
    "zh": "趙信為單于謀曰：「漢兵既度幕，人馬罷，匈奴可坐收虜耳。"
  },
  {
    "id": "s0379",
    "blockIndex": 36,
    "zh": "」乃悉遠北其輜重，以精兵待幕北。"
  },
  {
    "id": "s0380",
    "blockIndex": 37,
    "zh": "大將軍青既出塞，捕虜知單于所居，乃自以精兵走之，而令前將軍廣并於右將軍軍，出東道。"
  },
  {
    "id": "s0381",
    "blockIndex": 37,
    "zh": "東道回遠而水草少，廣自請曰：「臣部為前將軍，今大將軍乃徙令臣出東道。"
  },
  {
    "id": "s0382",
    "blockIndex": 37,
    "zh": "且臣結髮而與匈奴戰，今乃一得當單于，臣願居前，先死單于。"
  },
  {
    "id": "s0383",
    "blockIndex": 37,
    "zh": "」大將軍亦陰受上誡，以為「李廣老，數奇，毋令當單于，恐不得所欲。"
  },
  {
    "id": "s0384",
    "blockIndex": 37,
    "zh": "」而公孫敖新失侯，大將軍亦欲使敖與俱當單于，故徙前將軍廣。"
  },
  {
    "id": "s0385",
    "blockIndex": 37,
    "zh": "廣知之，固自辭於大將軍；"
  },
  {
    "id": "s0386",
    "blockIndex": 37,
    "zh": "大將軍不聽，廣不謝而起行，意甚慍怒。"
  },
  {
    "id": "s0387",
    "blockIndex": 38,
    "zh": "大將軍出塞千餘里，度幕，見單于兵陳而待。"
  },
  {
    "id": "s0388",
    "blockIndex": 38,
    "zh": "於是大將軍令武剛車自環為營，而縱五千騎往當匈奴。"
  },
  {
    "id": "s0389",
    "blockIndex": 38,
    "zh": "匈奴亦縱可萬騎。"
  },
  {
    "id": "s0390",
    "blockIndex": 38,
    "zh": "會日且入，大風起，砂礫擊面，兩軍不相見，漢益縱左右翼繞單于。"
  },
  {
    "id": "s0391",
    "blockIndex": 38,
    "zh": "單于視漢兵多而士馬尚強，自度戰不能如漢兵，單于遂乘六騾，壯騎可數百，直冒漢圍，西北馳去。"
  },
  {
    "id": "s0392",
    "blockIndex": 38,
    "zh": "時已昏，漢匈奴相紛拏，殺傷大當。"
  },
  {
    "id": "s0393",
    "blockIndex": 38,
    "zh": "當軍左校捕虜言，單于未昏而去，漢軍發輕騎夜追之，大將軍軍因隨其後，匈奴兵亦散走。"
  },
  {
    "id": "s0394",
    "blockIndex": 38,
    "zh": "遲明，行二百餘里，不得單于，捕斬首虜萬九千級，遂至窴顏山趙信城，得匈奴積粟食軍，留一日，悉燒其城餘粟而歸。"
  },
  {
    "id": "s0395",
    "blockIndex": 39,
    "zh": "前將軍廣與右將軍食其軍無導，惑失道，後大將軍，不及單于戰。"
  },
  {
    "id": "s0396",
    "blockIndex": 39,
    "zh": "大將軍引還，過幕南，乃遇二將軍。"
  },
  {
    "id": "s0397",
    "blockIndex": 39,
    "zh": "大將軍使長史責問廣、食其失道狀，急責廣之幕府對簿。"
  },
  {
    "id": "s0398",
    "blockIndex": 39,
    "zh": "廣曰：「諸校尉無罪，乃我自失道，吾今自上簿至莫府」。"
  },
  {
    "id": "s0399",
    "blockIndex": 39,
    "zh": "廣謂其麾下曰：「廣結髮與匈奴大小七十餘戰，今幸從大將軍出接單于兵，而大將軍徙廣部行回遠，而又迷失道，豈非天哉！"
  },
  {
    "id": "s0400",
    "blockIndex": 39,
    "zh": "且廣年六十餘矣，終不能復對刀筆之吏！"
  },
  {
    "id": "s0401",
    "blockIndex": 39,
    "zh": "」遂引刀自剄。"
  },
  {
    "id": "s0402",
    "blockIndex": 39,
    "zh": "廣為人廉，得賞賜輒分其麾下，飲食與士共之，為二千石四十餘年，家無餘財。"
  },
  {
    "id": "s0403",
    "blockIndex": 39,
    "zh": "猿臂，善射，度不中不發。"
  },
  {
    "id": "s0404",
    "blockIndex": 39,
    "zh": "將兵，乏絕之處見水，士卒不盡飲，廣不近水，士卒不盡食，廣不嘗食。"
  },
  {
    "id": "s0405",
    "blockIndex": 39,
    "zh": "士以此愛樂為用。"
  },
  {
    "id": "s0406",
    "blockIndex": 39,
    "zh": "及死，一軍皆哭。"
  },
  {
    "id": "s0407",
    "blockIndex": 39,
    "zh": "百姓聞之，知與不知，無老壯皆為垂涕。"
  },
  {
    "id": "s0408",
    "blockIndex": 39,
    "zh": "而右將軍獨下吏，當死，贖為庶人。"
  },
  {
    "id": "s0409",
    "blockIndex": 40,
    "zh": "單于之遁走，其兵往往與漢兵相亂而隨單于，單于久不與其大眾相得。"
  },
  {
    "id": "s0410",
    "blockIndex": 40,
    "zh": "其右谷蠡王以為單于死，乃自立為單于。"
  },
  {
    "id": "s0411",
    "blockIndex": 40,
    "zh": "十餘日，真單于復得其眾，而右谷蠡王乃去其單于號。"
  },
  {
    "id": "s0412",
    "blockIndex": 41,
    "zh": "驃騎將軍騎兵車重與大將軍軍等，而無裨將，悉以李敢等為大校，當裨將，出代、右北平二千餘里，絕大幕，直左方兵，獲屯頭王、韓王等三人，將軍、相國、當戶、都尉八十三人，封狼居胥山，禪於姑衍，登臨翰海，鹵獲七萬四百四十三級。"
  },
  {
    "id": "s0413",
    "blockIndex": 41,
    "zh": "天子以五千八百戶益封驃騎將軍；"
  },
  {
    "id": "s0414",
    "blockIndex": 41,
    "zh": "又封其所部右北平太守路博德等四人列侯，從驃侯破奴等二人益封，校尉敢為關內侯，食邑；"
  },
  {
    "id": "s0415",
    "blockIndex": 41,
    "zh": "軍吏卒為官、賞賜甚多。"
  },
  {
    "id": "s0416",
    "blockIndex": 41,
    "zh": "而大將軍不得益封，軍吏卒皆無封侯者。"
  },
  {
    "id": "s0417",
    "blockIndex": 42,
    "zh": "兩軍之出塞，塞閱官及私馬凡十四萬匹，而復入塞者不滿三萬匹。"
  },
  {
    "id": "s0418",
    "blockIndex": 43,
    "zh": "乃益置大司馬位，大將軍、驃騎將軍皆為大司馬，定令，令驃騎將軍秩祿與大將軍等。"
  },
  {
    "id": "s0419",
    "blockIndex": 43,
    "zh": "自是之後，大將軍青日退而驃騎日益貴。"
  },
  {
    "id": "s0420",
    "blockIndex": 43,
    "zh": "大將軍故人、門下士多去事,驃騎，輒得官爵，唯任安不肯。"
  },
  {
    "id": "s0421",
    "blockIndex": 44,
    "zh": "驃騎將軍為人，少言不洩，有氣敢往。"
  },
  {
    "id": "s0422",
    "blockIndex": 44,
    "zh": "天子嘗欲教之孫、吳兵法，對曰：「顧方略何如耳，不至學古兵法。"
  },
  {
    "id": "s0423",
    "blockIndex": 44,
    "zh": "」天子為治第，令驃騎視之，對曰：「匈奴未滅，無以家為也！"
  },
  {
    "id": "s0424",
    "blockIndex": 44,
    "zh": "」由此上益重愛之。"
  },
  {
    "id": "s0425",
    "blockIndex": 44,
    "zh": "然少貴，不省士，其從軍，天子為遣太官賫數十乘，既還，重車餘棄粱肉，而士有饑者；"
  },
  {
    "id": "s0426",
    "blockIndex": 44,
    "zh": "其在塞外，卒乏糧或不能自振，而驃騎尚穿域蹋鞠，事多此類。"
  },
  {
    "id": "s0427",
    "blockIndex": 44,
    "zh": "大將軍為人仁，喜士退讓，以和柔自媚於上。"
  },
  {
    "id": "s0428",
    "blockIndex": 44,
    "zh": "兩人志操如此。"
  },
  {
    "id": "s0429",
    "blockIndex": 45,
    "zh": "是時，漢所殺虜匈奴合八九萬，而漢士卒物故亦數萬。"
  },
  {
    "id": "s0430",
    "blockIndex": 45,
    "zh": "是後匈奴遠遁，而幕南無王庭。"
  },
  {
    "id": "s0431",
    "blockIndex": 45,
    "zh": "漢渡河自朔方以西至令居，往往通渠，置田官，吏卒五六萬人，稍蠶食匈奴以北；"
  },
  {
    "id": "s0432",
    "blockIndex": 45,
    "zh": "然亦以馬少，不復大出擊匈奴矣。"
  },
  {
    "id": "s0433",
    "blockIndex": 46,
    "zh": "匈奴用趙信計，遣使於漢，好辭請和親。"
  },
  {
    "id": "s0434",
    "blockIndex": 46,
    "zh": "天子下其議，或言和親，或言遂臣之。"
  },
  {
    "id": "s0435",
    "blockIndex": 46,
    "zh": "丞相長史任敞曰：「匈奴新破困，宜可使為外臣，朝請於邊。"
  },
  {
    "id": "s0436",
    "blockIndex": 46,
    "zh": "」漢使任敞於單于，單于大怒，留之不遣。"
  },
  {
    "id": "s0437",
    "blockIndex": 46,
    "zh": "是時，博士狄山議以為和親便，上以問張湯，湯曰：「此愚儒無知。"
  },
  {
    "id": "s0438",
    "blockIndex": 46,
    "zh": "」狄山曰：「臣固愚，愚忠。"
  },
  {
    "id": "s0439",
    "blockIndex": 46,
    "zh": "若御史大夫湯，乃詐忠。"
  },
  {
    "id": "s0440",
    "blockIndex": 46,
    "zh": "」於是上作色曰：「吾使生居一郡，能無使虜入盜乎？"
  },
  {
    "id": "s0441",
    "blockIndex": 46,
    "zh": "」曰：「不能。"
  },
  {
    "id": "s0442",
    "blockIndex": 46,
    "zh": "」曰：「居一縣？"
  },
  {
    "id": "s0443",
    "blockIndex": 46,
    "zh": "」對曰：「不能。"
  },
  {
    "id": "s0444",
    "blockIndex": 46,
    "zh": "」復曰：「居一障間？"
  },
  {
    "id": "s0445",
    "blockIndex": 46,
    "zh": "」山自度辯窮且下吏，曰：「能。"
  },
  {
    "id": "s0446",
    "blockIndex": 46,
    "zh": "」於是上遣山乘障，至月餘，匈奴斬山頭而去。"
  },
  {
    "id": "s0447",
    "blockIndex": 46,
    "zh": "自是之後，群臣震懾，無敢忤湯者。"
  },
  {
    "id": "s0448",
    "blockIndex": 46,
    "zh": "----5是歲，汲黯坐法免，以定襄太守義縱為右內史，河內太守王溫舒為中尉。"
  },
  {
    "id": "s0449",
    "blockIndex": 47,
    "zh": "先是，寧成為關都尉，吏民出入關者號曰：「寧見乳虎，無值寧成之怒。"
  },
  {
    "id": "s0450",
    "blockIndex": 47,
    "zh": "」及義縱為南陽太守，至關，寧成側行送迎。"
  },
  {
    "id": "s0451",
    "blockIndex": 47,
    "zh": "至郡，遂按寧氏，破碎其家；"
  },
  {
    "id": "s0452",
    "blockIndex": 47,
    "zh": "南陽吏民重足一跡。"
  },
  {
    "id": "s0453",
    "blockIndex": 47,
    "zh": "後徙定襄太守，初至，掩定襄獄中重罪輕系二百餘人，及賓客、昆弟私人視亦二百餘人，一捕，鞠曰「為死罪解脫」。"
  },
  {
    "id": "s0454",
    "blockIndex": 47,
    "zh": "是日，皆報殺四百餘人。"
  },
  {
    "id": "s0455",
    "blockIndex": 47,
    "zh": "其後郡中不寒而慄。"
  },
  {
    "id": "s0456",
    "blockIndex": 47,
    "zh": "是時，趙禹、張湯以深刻為九卿。"
  },
  {
    "id": "s0457",
    "blockIndex": 47,
    "zh": "然其治尚輔法而行；"
  },
  {
    "id": "s0458",
    "blockIndex": 47,
    "zh": "縱專以鷹擊為治。"
  },
  {
    "id": "s0459",
    "blockIndex": 48,
    "zh": "王溫舒始為廣平都尉，擇郡中豪敢往吏十餘人，以為爪牙，皆把其陰重罪，而縱使督盜賊。"
  },
  {
    "id": "s0460",
    "blockIndex": 48,
    "zh": "快其意所欲得，此人雖有百罪，弗法；"
  },
  {
    "id": "s0461",
    "blockIndex": 48,
    "zh": "即有避，因其事夷之，亦滅宗。"
  },
  {
    "id": "s0462",
    "blockIndex": 48,
    "zh": "以其故，齊、趙之郊盜賊不敢近廣平，廣平聲為道不拾遺。"
  },
  {
    "id": "s0463",
    "blockIndex": 48,
    "zh": "遷河內太守，以九月至，令郡具私馬五十匹為驛，捕郡中豪猾，相連坐千餘家。"
  },
  {
    "id": "s0464",
    "blockIndex": 48,
    "zh": "上書請，大者至族，小者乃死，家盡沒入償臧。"
  },
  {
    "id": "s0465",
    "blockIndex": 48,
    "zh": "奏行不過二三日得可，事論報，至流血十餘里，河內皆怪其奏，以為神速。"
  },
  {
    "id": "s0466",
    "blockIndex": 48,
    "zh": "盡十二月，郡中毋聲，毋敢夜行，野無犬吠之盜。"
  },
  {
    "id": "s0467",
    "blockIndex": 48,
    "zh": "其頗不得，失之旁郡國，追求。"
  },
  {
    "id": "s0468",
    "blockIndex": 48,
    "zh": "會春，溫舒頓足歎曰：「嗟乎！"
  },
  {
    "id": "s0469",
    "blockIndex": 48,
    "zh": "令冬月益展一月，足吾事矣！"
  },
  {
    "id": "s0471",
    "blockIndex": 49,
    "zh": "天子聞之，皆以為能，故擢為中二千石。"
  },
  {
    "id": "s0472",
    "blockIndex": 49,
    "zh": "----6齊人少翁，以鬼神方見上。"
  },
  {
    "id": "s0473",
    "blockIndex": 49,
    "zh": "上有所幸王夫人卒，少翁以方夜致鬼，如王夫人之貌，天子自帷中望見焉。"
  },
  {
    "id": "s0474",
    "blockIndex": 49,
    "zh": "於是乃拜少翁為文成將軍，賞賜甚多，以客禮禮之。"
  },
  {
    "id": "s0475",
    "blockIndex": 49,
    "zh": "文成又勸上作甘泉宮，中為台室，畫天、地、太一諸鬼神而置祭具，以致天神。"
  },
  {
    "id": "s0476",
    "blockIndex": 49,
    "zh": "居歲餘，其方益衰，神不至。"
  },
  {
    "id": "s0477",
    "blockIndex": 49,
    "zh": "乃為帛書以飯牛，佯不知，言曰：「此牛腹中有奇。"
  },
  {
    "id": "s0478",
    "blockIndex": 49,
    "zh": "」殺視，得書，書言甚怪，天子識其手書，問其人，果是偽書。"
  },
  {
    "id": "s0479",
    "blockIndex": 49,
    "zh": "於是誅文成將軍而隱之。"
  },
  {
    "id": "s0481",
    "blockIndex": 50,
    "zh": "category:資治通鑑"
  }
]
