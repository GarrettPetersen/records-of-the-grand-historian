[
  {
    "id": "s0001",
    "blockIndex": 0,
    "zh": "【漢紀三十一】起昭陽協洽，盡閼逢涒灘，凡二年。"
  },
  {
    "id": "s0002",
    "blockIndex": 1,
    "zh": "春，正月，甲子朔，漢兵與下江兵共攻甄阜、梁丘賜，斬之，殺士卒二萬餘人。"
  },
  {
    "id": "s0003",
    "blockIndex": 1,
    "zh": "王莽納言將軍嚴尤、秩宗將軍陳茂引兵欲據宛，劉縯與戰於淯陽下，大破之，遂圍宛。"
  },
  {
    "id": "s0004",
    "blockIndex": 1,
    "zh": "先是，青、徐賊眾雖數十萬人，訖無文書、號令、旌旗、部曲。"
  },
  {
    "id": "s0005",
    "blockIndex": 1,
    "zh": "及漢兵起，皆稱將軍，攻城略地，移書稱說。"
  },
  {
    "id": "s0006",
    "blockIndex": 1,
    "zh": "莽聞之，始懼。"
  },
  {
    "id": "s0007",
    "blockIndex": 2,
    "zh": "舂陵戴侯曾孫玄在平林兵中，號更始將軍。"
  },
  {
    "id": "s0008",
    "blockIndex": 2,
    "zh": "時漢兵已十餘萬，諸將議以兵多而無所統一，欲立劉氏以從人望。"
  },
  {
    "id": "s0009",
    "blockIndex": 2,
    "zh": "南陽豪桀及王常等皆欲立劉縯；"
  },
  {
    "id": "s0010",
    "blockIndex": 2,
    "zh": "而新市、平林將帥樂放縱，憚縯威明，貪玄懦弱，先共定策立之，然後召縯示其議。"
  },
  {
    "id": "s0011",
    "blockIndex": 2,
    "zh": "縯曰：「諸將軍幸欲尊立宗室，甚厚，然今赤眉起青、徐，眾數十萬，聞南陽立宗室，恐赤眉復有所立，王莽未滅而宗室相攻，是疑天下而自損權，非所以破莽也。"
  },
  {
    "id": "s0012",
    "blockIndex": 2,
    "zh": "舂陵去宛三百里耳，遽自尊立，為天下准的，使後人得承吾敝，非計之善者也。"
  },
  {
    "id": "s0013",
    "blockIndex": 2,
    "zh": "不如且稱王以號令，王勢亦足以斬諸將。"
  },
  {
    "id": "s0014",
    "blockIndex": 2,
    "zh": "若赤眉所立者賢，相率而往從之，必不奪吾爵位。"
  },
  {
    "id": "s0015",
    "blockIndex": 2,
    "zh": "若無所立，破莽，降赤眉，然後舉尊號，亦未晚也。"
  },
  {
    "id": "s0016",
    "blockIndex": 2,
    "zh": "」諸將多曰：「善！"
  },
  {
    "id": "s0017",
    "blockIndex": 2,
    "zh": "」張卬拔劍擊地曰：「疑事無功，今日之議，不得有二！"
  },
  {
    "id": "s0018",
    "blockIndex": 2,
    "zh": "」眾皆從之。"
  },
  {
    "id": "s0019",
    "blockIndex": 2,
    "zh": "二月，辛巳朔，設壇場於淯水上沙中，玄即皇帝位，南面立，朝群臣；"
  },
  {
    "id": "s0020",
    "blockIndex": 2,
    "zh": "羞愧流汗，舉手不能言。"
  },
  {
    "id": "s0021",
    "blockIndex": 2,
    "zh": "於是大赦，改元，以族父良為國三老，王匡為定國上公，王鳳為成國上公，朱鮪為大司馬，劉縯為大司徒，陳牧為大司空，餘皆九卿將軍。"
  },
  {
    "id": "s0022",
    "blockIndex": 2,
    "zh": "由是豪桀失望，多不服。"
  },
  {
    "id": "s0023",
    "blockIndex": 3,
    "zh": "王莽欲外示自安，乃染其鬚髮，立杜陵史諶女為皇后；"
  },
  {
    "id": "s0024",
    "blockIndex": 3,
    "zh": "置後宮，位號視公、卿、大夫、元士者凡百二十人。"
  },
  {
    "id": "s0025",
    "blockIndex": 4,
    "zh": "莽赦天下，詔：「王匡、哀章等討青、徐盜賊，嚴尤、陳茂等討前隊丑虜，明告以生活、丹青之信。"
  },
  {
    "id": "s0026",
    "blockIndex": 4,
    "zh": "復迷惑不解散，將遣大司空、隆新公將百萬之師劋絕之矣。"
  },
  {
    "id": "s0028",
    "blockIndex": 5,
    "zh": "三月，王鳳與太常偏將軍劉秀等徇昆陽、定陵、郾，皆下之。"
  },
  {
    "id": "s0029",
    "blockIndex": 6,
    "zh": "王莽聞嚴尤、陳茂敗，乃遣司空王邑馳傳，與司徒王尋發兵平定山東。"
  },
  {
    "id": "s0030",
    "blockIndex": 6,
    "zh": "征諸明兵法六十三家以備軍吏，以長人巨母霸為壘尉，又驅諸猛獸虎、豹、犀、象之屬以助威武。"
  },
  {
    "id": "s0031",
    "blockIndex": 6,
    "zh": "邑至洛陽，州郡各選精兵，牧守自將，定會者四十二萬人，號百萬；"
  },
  {
    "id": "s0032",
    "blockIndex": 6,
    "zh": "餘在道者，旌旗、輜重，千里不絕。"
  },
  {
    "id": "s0033",
    "blockIndex": 6,
    "zh": "夏，五月，尋、邑南出穎川，與嚴尤、陳茂合。"
  },
  {
    "id": "s0034",
    "blockIndex": 7,
    "zh": "諸將見尋、邑兵盛，皆反走，入昆陽，惶怖，憂念妻孥，欲散歸諸城。"
  },
  {
    "id": "s0035",
    "blockIndex": 7,
    "zh": "劉秀曰：「今兵谷既少而外寇強大，並力御之，功庶可立；"
  },
  {
    "id": "s0036",
    "blockIndex": 7,
    "zh": "如欲分散，勢無俱全。"
  },
  {
    "id": "s0037",
    "blockIndex": 7,
    "zh": "且宛城未拔，不能相救；"
  },
  {
    "id": "s0038",
    "blockIndex": 7,
    "zh": "昆陽即拔，一日之間，諸部亦滅矣。"
  },
  {
    "id": "s0039",
    "blockIndex": 7,
    "zh": "今不同心膽，共舉功名，反欲守妻子財物邪！"
  },
  {
    "id": "s0040",
    "blockIndex": 7,
    "zh": "」諸將怒曰：「劉將軍何敢如是！"
  },
  {
    "id": "s0041",
    "blockIndex": 7,
    "zh": "」秀笑而起。"
  },
  {
    "id": "s0042",
    "blockIndex": 7,
    "zh": "會候騎還，言：「大兵且至城北，軍陳數百里，不見其後。"
  },
  {
    "id": "s0043",
    "blockIndex": 7,
    "zh": "」諸將素輕秀，及迫急，乃相謂曰：「更請劉將軍計之。"
  },
  {
    "id": "s0044",
    "blockIndex": 7,
    "zh": "」秀復為圖畫成敗，諸將皆曰：「諾。"
  },
  {
    "id": "s0045",
    "blockIndex": 7,
    "zh": "」時城中唯有八九千人，秀使王鳳與廷尉大將軍王常守昆陽，夜與五威將軍李軼等十三騎出城南門，於外收兵。"
  },
  {
    "id": "s0046",
    "blockIndex": 7,
    "zh": "時莽兵到城下者且十萬，秀等幾不得出。"
  },
  {
    "id": "s0047",
    "blockIndex": 7,
    "zh": "尋、邑縱兵圍昆陽，嚴尤說邑曰：「昆陽城小而堅，今假號者在宛，亟進大兵，彼必奔走。"
  },
  {
    "id": "s0048",
    "blockIndex": 7,
    "zh": "宛敗，昆陽自服。"
  },
  {
    "id": "s0049",
    "blockIndex": 7,
    "zh": "」邑曰：「吾昔圍翟義，坐不生得以見責讓。"
  },
  {
    "id": "s0050",
    "blockIndex": 7,
    "zh": "今將百萬之眾，遇城而不能下，非所以示威也。"
  },
  {
    "id": "s0051",
    "blockIndex": 7,
    "zh": "當先屠此城，蹀血而進，前歌後舞，顧不快邪！"
  },
  {
    "id": "s0052",
    "blockIndex": 7,
    "zh": "」遂圍之數十重，列營百數，鉦鼓之聲聞數十里，或為地道、沖輣撞城；"
  },
  {
    "id": "s0053",
    "blockIndex": 7,
    "zh": "積弩亂髮，矢下如雨，城中負戶而汲。"
  },
  {
    "id": "s0054",
    "blockIndex": 7,
    "zh": "王鳳等乞降，不許。"
  },
  {
    "id": "s0055",
    "blockIndex": 7,
    "zh": "尋、邑自以為功在漏刻，不以軍事為憂。"
  },
  {
    "id": "s0056",
    "blockIndex": 7,
    "zh": "嚴尤曰：「《兵法》：『圍城為之闕』，宜使得逸出以怖宛下。"
  },
  {
    "id": "s0057",
    "blockIndex": 7,
    "zh": "」邑又不聽。"
  },
  {
    "id": "s0058",
    "blockIndex": 8,
    "zh": "棘陽守長岑彭與前隊貳嚴說共守宛城，漢兵攻之數月，城中人相食，乃舉城降。"
  },
  {
    "id": "s0059",
    "blockIndex": 8,
    "zh": "更始入都之。"
  },
  {
    "id": "s0060",
    "blockIndex": 8,
    "zh": "諸將欲殺彭，劉縯曰：「彭，郡之大吏，執心堅守，是其節也。"
  },
  {
    "id": "s0061",
    "blockIndex": 8,
    "zh": "今舉大事，當表義士，不如封之。"
  },
  {
    "id": "s0062",
    "blockIndex": 8,
    "zh": "」更始乃封彭為歸德侯。"
  },
  {
    "id": "s0063",
    "blockIndex": 9,
    "zh": "劉秀至郾、定陵，悉發諸營兵。"
  },
  {
    "id": "s0064",
    "blockIndex": 9,
    "zh": "諸將貪惜財物，欲分兵守之。"
  },
  {
    "id": "s0065",
    "blockIndex": 9,
    "zh": "秀曰：「今若破敵，珍寶萬倍，大功可成；"
  },
  {
    "id": "s0066",
    "blockIndex": 9,
    "zh": "如為所敗，首領無餘，何財物之有！"
  },
  {
    "id": "s0067",
    "blockIndex": 9,
    "zh": "」乃悉發之。"
  },
  {
    "id": "s0068",
    "blockIndex": 10,
    "zh": "六月，己卯朔，秀與諸營俱進，自將步騎千餘為前鋒，去大軍四五里而陳；"
  },
  {
    "id": "s0069",
    "blockIndex": 10,
    "zh": "尋、邑亦遣兵數千合成，秀奔之，斬首數十級。"
  },
  {
    "id": "s0070",
    "blockIndex": 10,
    "zh": "諸將喜曰：「劉將軍平生見小敵怯，今見大敵勇，甚可怪也！"
  },
  {
    "id": "s0071",
    "blockIndex": 10,
    "zh": "且復居前，請助將軍！"
  },
  {
    "id": "s0072",
    "blockIndex": 10,
    "zh": "」秀復進，尋、邑兵卻，諸部共乘之，斬首數百千級。"
  },
  {
    "id": "s0073",
    "blockIndex": 10,
    "zh": "連勝，遂前，諸將膽氣益壯，無不一當百，秀乃與敢死者三千人從城西水上衝其中堅。"
  },
  {
    "id": "s0074",
    "blockIndex": 10,
    "zh": "尋、邑易之，自將萬餘人行陳，敕諸營皆按部毋得動，獨迎與漢兵戰，不利，大軍不敢擅相救。"
  },
  {
    "id": "s0075",
    "blockIndex": 10,
    "zh": "尋、邑陳亂，漢兵乘銳崩之，遂殺王尋。"
  },
  {
    "id": "s0076",
    "blockIndex": 10,
    "zh": "城中亦鼓噪而出，中外合勢，震呼動天地。"
  },
  {
    "id": "s0077",
    "blockIndex": 10,
    "zh": "莽兵大潰，走者相騰踐，伏屍百餘里。"
  },
  {
    "id": "s0078",
    "blockIndex": 10,
    "zh": "會大雷、風、屋瓦皆飛，雨下如注，滍川盛溢，虎豹皆股戰，士卒赴水溺死者以萬數，水為不流。"
  },
  {
    "id": "s0079",
    "blockIndex": 10,
    "zh": "王邑、嚴尤、陳茂輕騎乘死人度水逃去，盡獲其軍實輜重，不可勝算，舉之連月不盡，或燔燒其餘。"
  },
  {
    "id": "s0080",
    "blockIndex": 10,
    "zh": "士卒奔走，各還其郡，王邑獨與所將長安勇敢數千人還洛陽，關中聞之震恐。"
  },
  {
    "id": "s0081",
    "blockIndex": 10,
    "zh": "於是海內豪桀翕然響應，皆殺其牧守，自稱將軍，用漢年號以待詔命。"
  },
  {
    "id": "s0082",
    "blockIndex": 10,
    "zh": "旬月之間，遍於天下。"
  },
  {
    "id": "s0083",
    "blockIndex": 11,
    "zh": "莽聞漢兵言莽鴆殺孝平皇帝，乃會公卿於王路堂，開所為平帝請命金縢之策，泣以示群臣。"
  },
  {
    "id": "s0084",
    "blockIndex": 12,
    "zh": "劉秀復徇穎川，攻父城不下，屯兵巾車鄉。"
  },
  {
    "id": "s0085",
    "blockIndex": 12,
    "zh": "穎川郡掾馮異監五縣，為漢兵所獲。"
  },
  {
    "id": "s0086",
    "blockIndex": 12,
    "zh": "異曰：「異有老母在父城，願歸，據五城以效功報德！"
  },
  {
    "id": "s0087",
    "blockIndex": 12,
    "zh": "」秀許之。"
  },
  {
    "id": "s0088",
    "blockIndex": 12,
    "zh": "異歸，謂父城長苗萌曰：「諸將多暴橫，獨劉將軍所到不虜略，觀其言語舉止，非庸人也。"
  },
  {
    "id": "s0089",
    "blockIndex": 12,
    "zh": "」遂與萌率五縣以降。"
  },
  {
    "id": "s0090",
    "blockIndex": 13,
    "zh": "新市、平林諸將以劉縯兄弟威名益盛，陰勸更始除之。"
  },
  {
    "id": "s0091",
    "blockIndex": 13,
    "zh": "秀謂縯曰：「事欲不善。"
  },
  {
    "id": "s0092",
    "blockIndex": 13,
    "zh": "」縯笑曰：「常如是耳。"
  },
  {
    "id": "s0093",
    "blockIndex": 13,
    "zh": "」更始大會諸將，取縯寶劍視之。"
  },
  {
    "id": "s0094",
    "blockIndex": 13,
    "zh": "繡衣御史申徒建隨獻玉玦，更始不敢發。"
  },
  {
    "id": "s0095",
    "blockIndex": 13,
    "zh": "縯舅樊宏謂縯曰：「建得無有范增之意乎？"
  },
  {
    "id": "s0096",
    "blockIndex": 13,
    "zh": "」縯不應。"
  },
  {
    "id": "s0097",
    "blockIndex": 13,
    "zh": "李軼初與縯兄弟善，後更諂事新貴。"
  },
  {
    "id": "s0098",
    "blockIndex": 13,
    "zh": "秀戒縯曰：「此人不可覆信。"
  },
  {
    "id": "s0099",
    "blockIndex": 13,
    "zh": "」縯不從。"
  },
  {
    "id": "s0100",
    "blockIndex": 13,
    "zh": "縯部將劉稷，勇冠三軍，聞更始立，怒曰：「本起兵圖大事者，伯升兄弟也。"
  },
  {
    "id": "s0101",
    "blockIndex": 13,
    "zh": "今更始何為者邪！"
  },
  {
    "id": "s0102",
    "blockIndex": 13,
    "zh": "」更始以稷為抗威將軍，稷不肯拜。"
  },
  {
    "id": "s0103",
    "blockIndex": 13,
    "zh": "更始乃與諸將陳兵數千人，先收稷，將誅之，縯固爭。"
  },
  {
    "id": "s0104",
    "blockIndex": 13,
    "zh": "李軼、朱鮪因勸更始並執縯，即日殺之。"
  },
  {
    "id": "s0105",
    "blockIndex": 13,
    "zh": "以族兄光祿勳賜為大司徒。"
  },
  {
    "id": "s0106",
    "blockIndex": 13,
    "zh": "秀聞之，自父城馳詣宛謝。"
  },
  {
    "id": "s0107",
    "blockIndex": 13,
    "zh": "司徒官屬迎吊秀，秀不與交私語，惟深引過而已，未嘗自伐昆陽之功；"
  },
  {
    "id": "s0108",
    "blockIndex": 13,
    "zh": "又不敢為縯服喪，飲食言笑如平常。"
  },
  {
    "id": "s0109",
    "blockIndex": 13,
    "zh": "更始以是慚，拜秀為破虜大將軍，封武信侯。"
  },
  {
    "id": "s0110",
    "blockIndex": 14,
    "zh": "道士西門君惠謂王莽衛將軍王涉曰：「讖文劉氏當復興，國師公姓名是也。"
  },
  {
    "id": "s0111",
    "blockIndex": 14,
    "zh": "」涉遂與國師公劉秀、大司馬董忠、司中大贅孫人及謀以所部兵劫莽降漢，以全宗族。"
  },
  {
    "id": "s0112",
    "blockIndex": 14,
    "zh": "秋，七月，人及以其謀告莽，莽召忠詰責，因格殺之，使虎賁以斬馬劍剉忠，收其宗族，以醇醯、毒藥、白刃、叢棘並一坎而埋之；"
  },
  {
    "id": "s0113",
    "blockIndex": 14,
    "zh": "秀、涉皆自殺。"
  },
  {
    "id": "s0114",
    "blockIndex": 14,
    "zh": "莽以其骨肉、舊臣，惡其內潰，故隱其誅。"
  },
  {
    "id": "s0115",
    "blockIndex": 14,
    "zh": "莽以軍師外破，大臣內畔，左右亡所信，不能復遠念郡國，乃召王邑還，為大司馬，以大長秋張邯為大司徒，崔發為大司空，司中壽容苗訢為國師。"
  },
  {
    "id": "s0116",
    "blockIndex": 14,
    "zh": "莽憂懣不能食，但飲酒，啖鰒魚；"
  },
  {
    "id": "s0117",
    "blockIndex": 14,
    "zh": "讀軍書倦，因馮幾寐，不復就枕矣。"
  },
  {
    "id": "s0118",
    "blockIndex": 15,
    "zh": "成紀隗崔、隗義、上邽楊廣、冀人周宗同起兵以應漢，眾數千人，攻平襄，殺莽鎮戎大尹李育。"
  },
  {
    "id": "s0119",
    "blockIndex": 15,
    "zh": "崔兄子囂，素有名，好經書，崔等共推為上將軍。"
  },
  {
    "id": "s0120",
    "blockIndex": 15,
    "zh": "崔為白虎將軍，義為左將軍。"
  },
  {
    "id": "s0121",
    "blockIndex": 15,
    "zh": "囂遣使聘平陵方望，以為軍師。"
  },
  {
    "id": "s0122",
    "blockIndex": 15,
    "zh": "望說囂立高廟於邑東。"
  },
  {
    "id": "s0123",
    "blockIndex": 15,
    "zh": "己巳，祀高祖、太宗、世宗，囂等皆稱臣執事，殺馬同盟，以興輔劉宗；"
  },
  {
    "id": "s0124",
    "blockIndex": 15,
    "zh": "移檄郡國，數莽罪惡。"
  },
  {
    "id": "s0125",
    "blockIndex": 15,
    "zh": "勒兵十萬，擊殺雍州牧陳慶、安定大尹王向。"
  },
  {
    "id": "s0126",
    "blockIndex": 15,
    "zh": "分遣諸將徇隴西、武都、金城、武威、張掖、酒泉、敦煌，皆下之。"
  },
  {
    "id": "s0127",
    "blockIndex": 16,
    "zh": "初，茂陵公孫述為清水長，有能名；"
  },
  {
    "id": "s0128",
    "blockIndex": 16,
    "zh": "遷導江卒正，治臨邛。"
  },
  {
    "id": "s0129",
    "blockIndex": 16,
    "zh": "漢兵起，南陽宗成、商人王岑起兵徇漢中以應漢，殺王莽庸部牧宋遵，眾合數萬人。"
  },
  {
    "id": "s0130",
    "blockIndex": 16,
    "zh": "述遣使迎成等，成等至成都，虜掠暴橫。"
  },
  {
    "id": "s0131",
    "blockIndex": 16,
    "zh": "述召群中豪桀謂曰：「天下同苦新室，思劉氏久矣，故聞漢將軍到，馳迎道路。"
  },
  {
    "id": "s0132",
    "blockIndex": 16,
    "zh": "今百姓無辜而婦子係獲，此寇賊，非義兵也。"
  },
  {
    "id": "s0133",
    "blockIndex": 16,
    "zh": "」乃使人詐稱漢使者，假述輔漢將軍、蜀郡太守兼益州牧印綬；"
  },
  {
    "id": "s0134",
    "blockIndex": 16,
    "zh": "選精兵西擊成等，殺之，並其眾。"
  },
  {
    "id": "s0135",
    "blockIndex": 17,
    "zh": "前鐘武侯劉望起兵汝南，嚴尤、陳茂往歸之；"
  },
  {
    "id": "s0136",
    "blockIndex": 17,
    "zh": "八月，望即帝位，以尤為大司馬，茂為丞相。"
  },
  {
    "id": "s0137",
    "blockIndex": 18,
    "zh": "王莽使太師王匡、國將哀章守洛陽。"
  },
  {
    "id": "s0138",
    "blockIndex": 18,
    "zh": "更始遣定國上公王匡攻洛陽，西屏大將軍申屠建、丞相司直李松攻武關，三輔震動。"
  },
  {
    "id": "s0139",
    "blockIndex": 18,
    "zh": "析人鄧曄、於匡起兵南鄉以應漢，攻武關都尉朱萌，萌降；"
  },
  {
    "id": "s0140",
    "blockIndex": 18,
    "zh": "進攻右隊大夫宋綱，殺之；"
  },
  {
    "id": "s0141",
    "blockIndex": 18,
    "zh": "西拔湖。"
  },
  {
    "id": "s0142",
    "blockIndex": 18,
    "zh": "莽愈憂，不知所出。"
  },
  {
    "id": "s0143",
    "blockIndex": 18,
    "zh": "崔發言：「古者國有大災，則哭以厭之。"
  },
  {
    "id": "s0144",
    "blockIndex": 18,
    "zh": "宜告天以求救。"
  },
  {
    "id": "s0145",
    "blockIndex": 18,
    "zh": "」莽乃率群臣至南郊，陳其符命本末，仰天大哭，氣盡，伏而叩頭。"
  },
  {
    "id": "s0146",
    "blockIndex": 18,
    "zh": "諸生、小民旦夕會哭，為設飧粥；"
  },
  {
    "id": "s0147",
    "blockIndex": 18,
    "zh": "甚悲哀者，除以為郎，郎至五千餘人。"
  },
  {
    "id": "s0148",
    "blockIndex": 18,
    "zh": "莽拜將軍九人，皆以虎為號，將北軍精兵數萬人以東，內其妻子宮中以為質。"
  },
  {
    "id": "s0149",
    "blockIndex": 18,
    "zh": "時省中黃金尚六十餘萬斤，它財物稱是，莽愈愛之，賜九虎士人四千錢；"
  },
  {
    "id": "s0150",
    "blockIndex": 18,
    "zh": "眾重怨，無鬥意。"
  },
  {
    "id": "s0151",
    "blockIndex": 18,
    "zh": "九虎至華陰回谿，距隘自守。"
  },
  {
    "id": "s0152",
    "blockIndex": 18,
    "zh": "於匡、鄧曄擊之，六虎敗走；"
  },
  {
    "id": "s0153",
    "blockIndex": 18,
    "zh": "二虎詣闕歸死，莽使使責死者安在，皆自殺；"
  },
  {
    "id": "s0154",
    "blockIndex": 18,
    "zh": "其四虎亡。"
  },
  {
    "id": "s0155",
    "blockIndex": 18,
    "zh": "三虎收散卒保渭口京師倉。"
  },
  {
    "id": "s0156",
    "blockIndex": 18,
    "zh": "鄧曄開武關迎漢兵。"
  },
  {
    "id": "s0157",
    "blockIndex": 18,
    "zh": "李松將三千餘人至湖，與曄等共攻京師倉，未下。"
  },
  {
    "id": "s0158",
    "blockIndex": 18,
    "zh": "曄以弘農掾王憲為校尉，將數百人北度渭，入左馮翊界。"
  },
  {
    "id": "s0159",
    "blockIndex": 18,
    "zh": "李松遣偏將軍韓臣等徑西至新豐擊破莽波水將軍，追奔至長門宮。"
  },
  {
    "id": "s0160",
    "blockIndex": 18,
    "zh": "王憲北至頻陽，所過迎降。"
  },
  {
    "id": "s0161",
    "blockIndex": 18,
    "zh": "諸縣大姓名各起兵稱漢將，率眾隨憲。"
  },
  {
    "id": "s0162",
    "blockIndex": 18,
    "zh": "李松、鄧曄引軍至華陰，而長安旁兵四會城下；"
  },
  {
    "id": "s0163",
    "blockIndex": 18,
    "zh": "又聞天水隗氏方到，皆爭欲先入城，貪立大功、鹵掠之利。"
  },
  {
    "id": "s0164",
    "blockIndex": 18,
    "zh": "莽赦城中囚徒，皆授兵，殺豨，飲其血，與誓曰：「有不為新室者，社鬼記之！"
  },
  {
    "id": "s0165",
    "blockIndex": 18,
    "zh": "」使更始將軍史諶將之。"
  },
  {
    "id": "s0166",
    "blockIndex": 18,
    "zh": "度渭橋，皆散走；"
  },
  {
    "id": "s0167",
    "blockIndex": 18,
    "zh": "諶空還。"
  },
  {
    "id": "s0168",
    "blockIndex": 18,
    "zh": "眾兵發掘莽妻、子、父、祖塚，燒其棺槨及九廟、明堂、辟雍，火照城中。"
  },
  {
    "id": "s0169",
    "blockIndex": 19,
    "zh": "九月，戊申朔，兵從宣平城門入。"
  },
  {
    "id": "s0170",
    "blockIndex": 19,
    "zh": "張邯逢兵見殺；"
  },
  {
    "id": "s0171",
    "blockIndex": 19,
    "zh": "王邑、王林、王巡、帶足惲等分將兵距擊北闕下，會日暮，官府、邸第盡奔亡。"
  },
  {
    "id": "s0172",
    "blockIndex": 19,
    "zh": "己酉，城中少年朱弟、張魚等恐見鹵掠，趨讙並和，燒作室門，斧敬法闥，呼曰：「反虜王莽，何不出降！"
  },
  {
    "id": "s0173",
    "blockIndex": 19,
    "zh": "」火及掖庭、承明，黃皇室主所居。"
  },
  {
    "id": "s0174",
    "blockIndex": 19,
    "zh": "黃皇室主曰：「何面目以見漢家！"
  },
  {
    "id": "s0175",
    "blockIndex": 19,
    "zh": "」自投火中而死。"
  },
  {
    "id": "s0176",
    "blockIndex": 20,
    "zh": "莽避火宣室前殿，火輒隨之。"
  },
  {
    "id": "s0177",
    "blockIndex": 20,
    "zh": "莽紺袀服，持虞帝匕首，天文郎按式於前，莽旋席隨斗柄而坐，曰：「天生德於予，漢兵其如予何！"
  },
  {
    "id": "s0178",
    "blockIndex": 20,
    "zh": "」庚戌，旦明，群臣扶掖莽自前殿之漸台，欲阻池水，公卿從官尚千餘人隨之。"
  },
  {
    "id": "s0179",
    "blockIndex": 20,
    "zh": "王邑晝夜戰，罷極，士死傷略盡；"
  },
  {
    "id": "s0180",
    "blockIndex": 20,
    "zh": "馳入宮，間關至漸台，見其子侍中睦解衣冠欲逃，邑叱之，令還，父子共守莽。"
  },
  {
    "id": "s0181",
    "blockIndex": 20,
    "zh": "軍人入殿中，聞莽在漸台，眾共圍之數百重。"
  },
  {
    "id": "s0182",
    "blockIndex": 20,
    "zh": "台上猶與相射，矢盡，短兵接。"
  },
  {
    "id": "s0183",
    "blockIndex": 20,
    "zh": "王邑父子、帶++足惲、王巡戰死，莽入室。"
  },
  {
    "id": "s0184",
    "blockIndex": 20,
    "zh": "下餔時，眾兵上台，苗訢、唐尊、王盛等皆死。"
  },
  {
    "id": "s0185",
    "blockIndex": 20,
    "zh": "商人杜吳殺莽，校尉東海公賓就斬莽首；"
  },
  {
    "id": "s0186",
    "blockIndex": 20,
    "zh": "軍人分莽身，節解臠分，爭相殺者數十人。"
  },
  {
    "id": "s0187",
    "blockIndex": 20,
    "zh": "公賓就持莽首詣王憲。"
  },
  {
    "id": "s0188",
    "blockIndex": 20,
    "zh": "憲自稱漢大將軍，城中兵數十萬皆屬焉。"
  },
  {
    "id": "s0189",
    "blockIndex": 20,
    "zh": "捨東宮，妻莽後宮，乘其車服。"
  },
  {
    "id": "s0190",
    "blockIndex": 20,
    "zh": "癸丑，李松、鄧曄入長安，將軍趙萌、申屠建亦至。"
  },
  {
    "id": "s0191",
    "blockIndex": 20,
    "zh": "以王憲得璽綬不上，多挾宮女，建天子鼓旗，收斬之。"
  },
  {
    "id": "s0192",
    "blockIndex": 20,
    "zh": "傳莽首詣宛，縣於市。"
  },
  {
    "id": "s0193",
    "blockIndex": 20,
    "zh": "百姓共提擊之，或切食其舌。"
  },
  {
    "id": "s0194",
    "blockIndex": 21,
    "zh": "班固贊曰：王莽始起外戚，折節力行以要名譽，及居位輔政，勤勞國家，直道而行，豈所謂「色取仁而行違」者邪！"
  },
  {
    "id": "s0195",
    "blockIndex": 21,
    "zh": "莽既不仁而有佞邪之材，又乘四父歷世之權，遭漢中微，國統三絕，而太后壽考，為之宗主，故得肆其奸慝以成篡盜之禍。"
  },
  {
    "id": "s0196",
    "blockIndex": 21,
    "zh": "推是言之，亦天時，非人力之致矣！"
  },
  {
    "id": "s0197",
    "blockIndex": 21,
    "zh": "及其竊位南面，顛覆之勢險於桀、紂，而莽晏然自以黃、虞復出也，乃始恣睢，奮其威詐，毒流諸夏，亂延蠻貉，猶未足逞其欲焉。"
  },
  {
    "id": "s0198",
    "blockIndex": 21,
    "zh": "是以四海之內，囂然喪其樂生之心，中外憤怨，遠近俱發，城池不守，支體分裂，遂令天下城邑為虛，害遍生民，自書傳所載亂臣賊子，考其禍敗，未有如莽之甚者也！"
  },
  {
    "id": "s0199",
    "blockIndex": 21,
    "zh": "昔秦燔《詩》、《書》以立私議，莽誦《六藝》以文奸言，同歸殊塗，俱用滅亡。"
  },
  {
    "id": "s0200",
    "blockIndex": 21,
    "zh": "皆聖王之驅除云爾。"
  },
  {
    "id": "s0201",
    "blockIndex": 22,
    "zh": "定國上公王匡拔洛陽，生縛莽太師王匡、哀章，皆斬之。"
  },
  {
    "id": "s0202",
    "blockIndex": 22,
    "zh": "冬，十月，奮威大將軍劉信擊殺劉望於汝南，並誅嚴尤、陳茂，郡縣皆降。"
  },
  {
    "id": "s0203",
    "blockIndex": 23,
    "zh": "更始將都洛陽，以劉秀行司隸校尉，使前整修宮府。"
  },
  {
    "id": "s0204",
    "blockIndex": 23,
    "zh": "秀乃致僚屬，作文移，從事司察，一如舊章。"
  },
  {
    "id": "s0205",
    "blockIndex": 23,
    "zh": "時三輔吏士東迎更始，見諸將過，皆冠幘而服婦人衣，莫不笑之。"
  },
  {
    "id": "s0206",
    "blockIndex": 23,
    "zh": "及見司隸僚屬，皆歡喜不自勝，老吏或垂涕曰：「不圖今日復見漢官威儀！"
  },
  {
    "id": "s0207",
    "blockIndex": 23,
    "zh": "」由是識者皆屬心焉。"
  },
  {
    "id": "s0208",
    "blockIndex": 24,
    "zh": "更始北都洛陽，分遣使者徇郡國，曰：「先降者復爵位！"
  },
  {
    "id": "s0209",
    "blockIndex": 24,
    "zh": "」使者至上谷，上谷太守扶風耿況迎，上印綬；"
  },
  {
    "id": "s0210",
    "blockIndex": 24,
    "zh": "使者納之，一宿，無還意。"
  },
  {
    "id": "s0211",
    "blockIndex": 24,
    "zh": "功曹寇恂勒兵入見使者，請之，使者不與，曰：「天王使者，功曹欲脅之邪！"
  },
  {
    "id": "s0212",
    "blockIndex": 24,
    "zh": "」恂曰：「非敢脅使君，竊傷計之不詳也。"
  },
  {
    "id": "s0213",
    "blockIndex": 24,
    "zh": "今天下初定，使君建節銜命，郡國莫不延頸傾耳。"
  },
  {
    "id": "s0214",
    "blockIndex": 24,
    "zh": "今始至上谷而先墮大信，將復何以號令他郡乎！"
  },
  {
    "id": "s0215",
    "blockIndex": 24,
    "zh": "」使者不應。"
  },
  {
    "id": "s0216",
    "blockIndex": 24,
    "zh": "恂叱左右以使者命召況；"
  },
  {
    "id": "s0217",
    "blockIndex": 24,
    "zh": "況至，恂進取印綬帶況。"
  },
  {
    "id": "s0218",
    "blockIndex": 24,
    "zh": "使者不得已，乃承製詔之，況受而歸。"
  },
  {
    "id": "s0219",
    "blockIndex": 24,
    "zh": "宛人彭寵、吳漢亡命在漁陽，鄉人韓鴻為更始使，徇北州，承製拜寵偏將軍，行漁陽太守事，以漢為安樂令。"
  },
  {
    "id": "s0220",
    "blockIndex": 24,
    "zh": "更始遣使降赤眉。"
  },
  {
    "id": "s0221",
    "blockIndex": 24,
    "zh": "樊崇等聞漢室復興，即留其兵，將渠帥二十餘人隨使者至洛陽，更始皆封為列侯。"
  },
  {
    "id": "s0222",
    "blockIndex": 24,
    "zh": "崇等既未有國邑，而留眾稍有離叛者，乃覆亡歸其營。"
  },
  {
    "id": "s0223",
    "blockIndex": 25,
    "zh": "王莽廬江連率穎川李憲據郡自守，稱淮南王。"
  },
  {
    "id": "s0224",
    "blockIndex": 26,
    "zh": "故梁王立之子永詣洛陽；"
  },
  {
    "id": "s0225",
    "blockIndex": 26,
    "zh": "更始封為梁王，都睢陽。"
  },
  {
    "id": "s0226",
    "blockIndex": 27,
    "zh": "更始欲令親近大將徇河北，大司徒賜言：「諸家子獨有文叔可用。"
  },
  {
    "id": "s0227",
    "blockIndex": 27,
    "zh": "」朱鮪等以為不可，更始狐疑，賜深勸之。"
  },
  {
    "id": "s0228",
    "blockIndex": 27,
    "zh": "更始乃以劉秀行大司馬事，持節北渡河，鎮慰州郡。"
  },
  {
    "id": "s0229",
    "blockIndex": 28,
    "zh": "以大司徒賜為丞相，令先入關修宗廟、宮室。"
  },
  {
    "id": "s0230",
    "blockIndex": 29,
    "zh": "大司馬秀至河北，所過郡縣，考察官吏，黜陟能否，平遣囚徒，除王莽苛政，復漢官名。"
  },
  {
    "id": "s0231",
    "blockIndex": 29,
    "zh": "吏民喜悅，爭持牛酒迎勞，秀皆不受。"
  },
  {
    "id": "s0232",
    "blockIndex": 29,
    "zh": "南陽鄧禹杖策追秀，及於鄴。"
  },
  {
    "id": "s0233",
    "blockIndex": 29,
    "zh": "秀曰：「我得專封拜，生遠來，寧欲仕乎？"
  },
  {
    "id": "s0234",
    "blockIndex": 29,
    "zh": "」禹曰：「不願也。"
  },
  {
    "id": "s0235",
    "blockIndex": 29,
    "zh": "」秀曰：「即如是，何欲為？"
  },
  {
    "id": "s0236",
    "blockIndex": 29,
    "zh": "」禹曰：「但願明公威德加於四海，禹得效其尺寸，垂功名於竹帛耳！"
  },
  {
    "id": "s0237",
    "blockIndex": 29,
    "zh": "」秀笑，因留宿間語。"
  },
  {
    "id": "s0238",
    "blockIndex": 29,
    "zh": "禹進說曰：「今山東未安，赤眉、青犢之屬動以萬數。"
  },
  {
    "id": "s0239",
    "blockIndex": 29,
    "zh": "更始既是常才而不自聽斷，諸將皆庸人屈起，志在財幣，爭用威力。"
  },
  {
    "id": "s0240",
    "blockIndex": 29,
    "zh": "朝夕自快而已，非有忠良明智、深慮遠圖，欲尊主安民者也。"
  },
  {
    "id": "s0241",
    "blockIndex": 29,
    "zh": "歷觀往古聖人之興，二科而已，天時與人事也。"
  },
  {
    "id": "s0242",
    "blockIndex": 29,
    "zh": "今以天時觀之，更始既立而災變方興；"
  },
  {
    "id": "s0243",
    "blockIndex": 29,
    "zh": "以人事觀之，帝王大業非凡夫所任，分崩離析，形勢可見。"
  },
  {
    "id": "s0244",
    "blockIndex": 29,
    "zh": "明公雖建籓輔之功，猶恐無所成立也。"
  },
  {
    "id": "s0245",
    "blockIndex": 29,
    "zh": "況明公素有盛德大功，為天下所向服，軍政齊肅，賞罰明信。"
  },
  {
    "id": "s0246",
    "blockIndex": 29,
    "zh": "為今之計，莫如延攬英雄，務悅民心，立高祖之業，救萬民之命。"
  },
  {
    "id": "s0247",
    "blockIndex": 29,
    "zh": "以公而慮，天下不足定也。"
  },
  {
    "id": "s0248",
    "blockIndex": 29,
    "zh": "」秀大悅，因令禹常宿止於中，與定計議。"
  },
  {
    "id": "s0249",
    "blockIndex": 29,
    "zh": "每任使諸將，多訪於禹，皆當其才。"
  },
  {
    "id": "s0250",
    "blockIndex": 29,
    "zh": "秀自兄縯之死，每獨居輒不御酒肉，枕席有涕泣處，主簿馮異獨叩頭寬譬，秀止之曰：「卿勿妄言！"
  },
  {
    "id": "s0251",
    "blockIndex": 29,
    "zh": "」異因進說曰：「更始政亂，百姓無所依戴。"
  },
  {
    "id": "s0252",
    "blockIndex": 29,
    "zh": "夫人久飢渴，易為充飽。"
  },
  {
    "id": "s0253",
    "blockIndex": 29,
    "zh": "今公專命方面，宜分遣官屬徇行郡縣，宣佈惠澤。"
  },
  {
    "id": "s0254",
    "blockIndex": 29,
    "zh": "」秀納之。"
  },
  {
    "id": "s0255",
    "blockIndex": 29,
    "zh": "騎都尉宋子耿純謁秀於邯鄲，退，見官屬將兵法度不與它將同，遂自結納。"
  },
  {
    "id": "s0256",
    "blockIndex": 30,
    "zh": "故趙繆王子林說秀決列人河水以灌赤眉，秀不從；"
  },
  {
    "id": "s0257",
    "blockIndex": 30,
    "zh": "去之真定。"
  },
  {
    "id": "s0258",
    "blockIndex": 30,
    "zh": "林素任俠於趙、魏間。"
  },
  {
    "id": "s0259",
    "blockIndex": 30,
    "zh": "王莽時，長安中有自稱成帝子子輿者，莽殺之。"
  },
  {
    "id": "s0260",
    "blockIndex": 30,
    "zh": "邯鄲卜者王郎緣是詐稱真子輿，云「母故成帝謳者，嘗見黃氣從上下，遂任身；"
  },
  {
    "id": "s0261",
    "blockIndex": 30,
    "zh": "趙後欲害之，偽易它人子，以故得全。"
  },
  {
    "id": "s0262",
    "blockIndex": 30,
    "zh": "」林等信之，與趙國大豪李育、張參等謀共立郎。"
  },
  {
    "id": "s0263",
    "blockIndex": 30,
    "zh": "會民間傳赤眉將渡河，林等因此宣言「赤眉當立劉子輿」，以觀眾心，百姓多信之。"
  },
  {
    "id": "s0264",
    "blockIndex": 30,
    "zh": "十二月，林等率車騎數百晨入邯鄲城，止於王宮，立郎為天子；"
  },
  {
    "id": "s0265",
    "blockIndex": 30,
    "zh": "分遣將帥徇下幽、冀，移檄州郡，趙國以北、遼東以西皆望風響應。"
  },
  {
    "id": "s0266",
    "blockIndex": 31,
    "zh": "春，正月，大司馬秀以王郎新盛，乃北徇薊。"
  },
  {
    "id": "s0267",
    "blockIndex": 32,
    "zh": "申屠建、李松自長安迎更始遷都。"
  },
  {
    "id": "s0268",
    "blockIndex": 32,
    "zh": "二月，更始發洛陽。"
  },
  {
    "id": "s0269",
    "blockIndex": 32,
    "zh": "初，三輔豪桀假號誅莽者，人人皆望封侯。"
  },
  {
    "id": "s0270",
    "blockIndex": 32,
    "zh": "申屠建既斬王憲，又揚言「三輔兒大黠，共殺其主。"
  },
  {
    "id": "s0271",
    "blockIndex": 32,
    "zh": "」吏民惶恐，屬縣屯聚；"
  },
  {
    "id": "s0272",
    "blockIndex": 32,
    "zh": "建等不能下。"
  },
  {
    "id": "s0273",
    "blockIndex": 32,
    "zh": "更始至長安，乃下詔大赦，非王莽子，他皆除其罪，於是三輔悉平。"
  },
  {
    "id": "s0274",
    "blockIndex": 32,
    "zh": "時長安唯未央宮被焚，其餘宮室、供帳、倉庫、官府皆案堵如故，市裡不改於舊。"
  },
  {
    "id": "s0275",
    "blockIndex": 32,
    "zh": "更始居長樂宮，升前殿，郎吏以次列庭中。"
  },
  {
    "id": "s0276",
    "blockIndex": 32,
    "zh": "更始羞怍，俯首刮席，不敢視。"
  },
  {
    "id": "s0277",
    "blockIndex": 32,
    "zh": "諸將後至者，更始問：「虜掠得幾何？"
  },
  {
    "id": "s0278",
    "blockIndex": 32,
    "zh": "」左右侍官皆宮省久吏，驚愕相視。"
  },
  {
    "id": "s0279",
    "blockIndex": 33,
    "zh": "李松與棘陽趙萌說更始宜悉王諸功臣；"
  },
  {
    "id": "s0280",
    "blockIndex": 33,
    "zh": "朱鮪爭之，以為高祖約，非劉氏不王。"
  },
  {
    "id": "s0281",
    "blockIndex": 33,
    "zh": "更始乃先封諸宗室：祉為定陶王，慶為燕王，歙為元氏王，嘉為漢中王，賜為宛王，信為汝陰王，然後立王匡為泚陽王，王鳳為宜城王，朱鮪為膠東王，王常為鄧王，申屠建為平氏王，陳牧為陰平王，衛尉大將軍張卬為淮陽王，執金吾、大將軍廖湛為穰王，尚書胡殷為隨王，柱天大將軍李通為西平王，五威中郎將李軼為舞陰王，水衡大將軍成丹為襄邑王，驃騎大將軍宗佻為穎陰王，尹尊為郾王。"
  },
  {
    "id": "s0282",
    "blockIndex": 33,
    "zh": "唯朱鮪辭不受。"
  },
  {
    "id": "s0283",
    "blockIndex": 33,
    "zh": "乃以鮪為左大司馬，宛王賜為前大司馬，使與李軼等鎮撫關東。"
  },
  {
    "id": "s0284",
    "blockIndex": 33,
    "zh": "又使李通鎮荊州，王常行南陽太守事。"
  },
  {
    "id": "s0285",
    "blockIndex": 33,
    "zh": "以李松為丞相，趙萌為右大司馬，共秉內任。"
  },
  {
    "id": "s0286",
    "blockIndex": 33,
    "zh": "更始納趙萌女為夫人，故委政於萌，日夜飲宴後庭。"
  },
  {
    "id": "s0287",
    "blockIndex": 33,
    "zh": "群臣欲言事，輒醉不能見，時不得已，乃令侍中坐帷內與語。"
  },
  {
    "id": "s0288",
    "blockIndex": 33,
    "zh": "韓夫人尤嗜酒，每侍飲，見常侍奏事，輒怒曰：「帝方對我飲，正用此時持事來邪！"
  },
  {
    "id": "s0289",
    "blockIndex": 33,
    "zh": "」起，抵破書案。"
  },
  {
    "id": "s0290",
    "blockIndex": 33,
    "zh": "趙萌專權，生殺自恣。"
  },
  {
    "id": "s0291",
    "blockIndex": 33,
    "zh": "郎吏有說萌放縱者，更始怒，拔劍斬之，自是無敢復言。"
  },
  {
    "id": "s0292",
    "blockIndex": 33,
    "zh": "以至群小、膳夫皆濫授官爵，長安為之語曰：「灶下養，中郎將；"
  },
  {
    "id": "s0293",
    "blockIndex": 33,
    "zh": "爛羊胃，騎都尉；"
  },
  {
    "id": "s0294",
    "blockIndex": 33,
    "zh": "爛羊頭，關內侯。"
  },
  {
    "id": "s0295",
    "blockIndex": 33,
    "zh": "」軍師將軍李淑上書諫曰：「陛下定業，雖因下江、平林之勢，斯蓋臨時濟用，不可施之既安。"
  },
  {
    "id": "s0296",
    "blockIndex": 33,
    "zh": "唯名與器，聖人所重。"
  },
  {
    "id": "s0297",
    "blockIndex": 33,
    "zh": "今加非其人，望其裨益萬分，猶緣木求魚，升山採珠。"
  },
  {
    "id": "s0298",
    "blockIndex": 33,
    "zh": "海內望此，有以窺度漢祚！"
  },
  {
    "id": "s0299",
    "blockIndex": 33,
    "zh": "」更始怒，囚之。"
  },
  {
    "id": "s0300",
    "blockIndex": 33,
    "zh": "諸將在外者皆專行誅賞，各置牧守；"
  },
  {
    "id": "s0301",
    "blockIndex": 33,
    "zh": "州郡交錯，不知所從。"
  },
  {
    "id": "s0302",
    "blockIndex": 33,
    "zh": "由是關中離心，四海怨叛。"
  },
  {
    "id": "s0303",
    "blockIndex": 34,
    "zh": "更始征隗囂及其叔父崔、義等，囂將行，方望以為更始成敗未可知，固止之。"
  },
  {
    "id": "s0304",
    "blockIndex": 34,
    "zh": "囂不聽，望以書辭謝而去。"
  },
  {
    "id": "s0305",
    "blockIndex": 34,
    "zh": "囂等至長安，更始以囂為右將軍，崔、義皆即舊號。"
  },
  {
    "id": "s0306",
    "blockIndex": 35,
    "zh": "耿況遣其子弇奉奏詣長安，弇時年二十一。"
  },
  {
    "id": "s0307",
    "blockIndex": 35,
    "zh": "行至宋子，會王郎起，弇從吏孫倉、衛包曰：「劉子輿，成帝正統；"
  },
  {
    "id": "s0308",
    "blockIndex": 35,
    "zh": "捨此不歸，遠行安之！"
  },
  {
    "id": "s0309",
    "blockIndex": 35,
    "zh": "」弇按劍曰：「子輿弊賊，卒為降虜耳！"
  },
  {
    "id": "s0310",
    "blockIndex": 35,
    "zh": "我至長安，與國家陳漁陽、上谷兵馬，歸發突騎，以轔烏合之眾，如摧枯折腐耳。"
  },
  {
    "id": "s0311",
    "blockIndex": 35,
    "zh": "觀公等不識去就，族滅不久也！"
  },
  {
    "id": "s0312",
    "blockIndex": 35,
    "zh": "」倉、包遂亡，降王郎。"
  },
  {
    "id": "s0313",
    "blockIndex": 35,
    "zh": "弇聞大司馬秀在盧奴，乃馳北上謁；"
  },
  {
    "id": "s0314",
    "blockIndex": 35,
    "zh": "秀留署長史，與俱北至薊。"
  },
  {
    "id": "s0315",
    "blockIndex": 35,
    "zh": "王郎移檄購秀十萬戶，秀令功曹令史穎川王霸至市中募人擊王郎，市人皆大笑，舉手邪揄之，霸慚懅而反。"
  },
  {
    "id": "s0316",
    "blockIndex": 35,
    "zh": "秀將南歸，耿弇曰：「今兵從南方來，不可南行。"
  },
  {
    "id": "s0317",
    "blockIndex": 35,
    "zh": "漁陽太守彭寵，公之邑人；"
  },
  {
    "id": "s0318",
    "blockIndex": 35,
    "zh": "上谷太守，即弇父也。"
  },
  {
    "id": "s0319",
    "blockIndex": 35,
    "zh": "發此兩郡控弦萬騎，邯鄲不足慮也。"
  },
  {
    "id": "s0320",
    "blockIndex": 35,
    "zh": "」秀官屬腹心皆不肯，曰：「死尚南首，奈何北行入囊中！"
  },
  {
    "id": "s0321",
    "blockIndex": 35,
    "zh": "」秀指弇曰：「是我北道主人也。"
  },
  {
    "id": "s0323",
    "blockIndex": 36,
    "zh": "會故廣陽王子接起兵薊中以應郎，城內擾亂，言邯鄲使者方到，二千石以下皆出迎。"
  },
  {
    "id": "s0324",
    "blockIndex": 36,
    "zh": "於是秀趣駕而出，至南城門，門已閉。"
  },
  {
    "id": "s0325",
    "blockIndex": 36,
    "zh": "攻之，得出。"
  },
  {
    "id": "s0326",
    "blockIndex": 36,
    "zh": "遂晨夜南馳，不敢入城邑，捨食道傍。"
  },
  {
    "id": "s0327",
    "blockIndex": 36,
    "zh": "至蕪蔞亭，時天寒烈，馮異上豆粥。"
  },
  {
    "id": "s0328",
    "blockIndex": 36,
    "zh": "至饒陽，官屬皆乏食。"
  },
  {
    "id": "s0329",
    "blockIndex": 36,
    "zh": "秀乃自稱邯鄲使者，入傳捨，傳吏方進食，從者饑，爭奪之。"
  },
  {
    "id": "s0330",
    "blockIndex": 36,
    "zh": "傳吏疑其偽，乃椎鼓數十通，紿言「邯鄲將軍至」，官屬皆失色。"
  },
  {
    "id": "s0331",
    "blockIndex": 36,
    "zh": "秀升車欲馳，既而懼不免，徐還坐，曰：「請邯鄲將軍入。"
  },
  {
    "id": "s0332",
    "blockIndex": 36,
    "zh": "」久，乃駕去。"
  },
  {
    "id": "s0333",
    "blockIndex": 36,
    "zh": "晨夜兼行，蒙犯霜雪，面皆破裂。"
  },
  {
    "id": "s0334",
    "blockIndex": 37,
    "zh": "至下曲陽，傳聞王郎兵在後，從者皆恐。"
  },
  {
    "id": "s0335",
    "blockIndex": 37,
    "zh": "至滹沱河，候吏還白「河水流澌，無船，不可濟」。"
  },
  {
    "id": "s0336",
    "blockIndex": 37,
    "zh": "秀使王霸往視之。"
  },
  {
    "id": "s0337",
    "blockIndex": 37,
    "zh": "霸恐驚眾，欲且前，阻水還，即詭曰：「冰堅可度。"
  },
  {
    "id": "s0338",
    "blockIndex": 37,
    "zh": "」官屬皆喜。"
  },
  {
    "id": "s0339",
    "blockIndex": 37,
    "zh": "秀笑曰：「候吏果妄語也。"
  },
  {
    "id": "s0340",
    "blockIndex": 37,
    "zh": "」遂前。"
  },
  {
    "id": "s0341",
    "blockIndex": 37,
    "zh": "比至河，河冰亦合，乃令王霸護度，未畢數騎而冰解。"
  },
  {
    "id": "s0342",
    "blockIndex": 37,
    "zh": "至南宮，遇大風雨，秀引車入道傍空捨，馮異抱薪，鄧禹爇火，秀對灶燎衣，馮異復進麥飯。"
  },
  {
    "id": "s0343",
    "blockIndex": 38,
    "zh": "進至下博城西，惶惑不知所之。"
  },
  {
    "id": "s0344",
    "blockIndex": 38,
    "zh": "有白衣老父在道旁，指曰：「努力！"
  },
  {
    "id": "s0345",
    "blockIndex": 38,
    "zh": "信都郡為長安城守，去此八十里。"
  },
  {
    "id": "s0346",
    "blockIndex": 38,
    "zh": "」秀即馳赴之。"
  },
  {
    "id": "s0347",
    "blockIndex": 38,
    "zh": "是時郡國皆已降王郎，獨信都太守南陽任光、和戎太守信都邳肜不肯從。"
  },
  {
    "id": "s0348",
    "blockIndex": 38,
    "zh": "光自以孤城獨守，恐不能全，聞秀至，大喜，吏民皆稱萬歲。"
  },
  {
    "id": "s0349",
    "blockIndex": 38,
    "zh": "邳肜亦自和戎來會，議者多言可因信都兵自送，西還長安。"
  },
  {
    "id": "s0350",
    "blockIndex": 38,
    "zh": "邳肜曰：「吏民歌吟思漢久矣，故更始舉尊號而天下響應，三輔清宮除道以迎之。"
  },
  {
    "id": "s0351",
    "blockIndex": 38,
    "zh": "今卜者王郎，假名因勢，驅集烏合之眾，遂振燕、趙之地，無有根本之固。"
  },
  {
    "id": "s0352",
    "blockIndex": 38,
    "zh": "明公奮二郡之兵以討之，何患不克！"
  },
  {
    "id": "s0353",
    "blockIndex": 38,
    "zh": "今釋此而歸，豈徒空失河北，必更驚動三輔，墮損威重，非計之得者也。"
  },
  {
    "id": "s0354",
    "blockIndex": 38,
    "zh": "若明公無復征伐之意，則雖信都之兵，猶難會也。"
  },
  {
    "id": "s0355",
    "blockIndex": 38,
    "zh": "何者？"
  },
  {
    "id": "s0356",
    "blockIndex": 38,
    "zh": "明公既西，則邯鄲勢成，民不肯捐父母、背成主而千里送公，其離散亡逃可必也！"
  },
  {
    "id": "s0357",
    "blockIndex": 38,
    "zh": "」秀乃止。"
  },
  {
    "id": "s0358",
    "blockIndex": 39,
    "zh": "秀以二郡兵弱，欲入城頭子路、力子都軍中，任光以為不可。"
  },
  {
    "id": "s0359",
    "blockIndex": 39,
    "zh": "乃發傍縣，得精兵四千人，拜任光為左大將軍，信都都尉李忠為右大將軍，邳肜為後大將軍、和戎太守如故，信都令萬修為偏將軍，皆封列侯。"
  },
  {
    "id": "s0360",
    "blockIndex": 39,
    "zh": "留南陽宗廣領信都太守事；"
  },
  {
    "id": "s0361",
    "blockIndex": 39,
    "zh": "使任光、李忠、萬修將兵以從，邳肜將兵居前。"
  },
  {
    "id": "s0362",
    "blockIndex": 39,
    "zh": "任光乃多作檄文曰：「大司馬劉公將城頭子路、力子都兵百萬眾從東方來，擊諸反虜！"
  },
  {
    "id": "s0363",
    "blockIndex": 39,
    "zh": "」遣騎馳至巨鹿界中。"
  },
  {
    "id": "s0364",
    "blockIndex": 39,
    "zh": "吏民得檄，傳相告語。"
  },
  {
    "id": "s0365",
    "blockIndex": 39,
    "zh": "秀投暮入堂陽界，多張騎火，彌滿澤中，堂陽即降；"
  },
  {
    "id": "s0366",
    "blockIndex": 39,
    "zh": "又擊貰縣，降之。"
  },
  {
    "id": "s0367",
    "blockIndex": 39,
    "zh": "城頭子路者，東平爰曾也，寇掠河、濟間，有眾二十餘萬，力子都有眾六七萬，故秀欲依之。"
  },
  {
    "id": "s0368",
    "blockIndex": 39,
    "zh": "昌城人劉植聚兵數千人據昌城，迎秀；"
  },
  {
    "id": "s0369",
    "blockIndex": 39,
    "zh": "秀以植為驍騎將軍。"
  },
  {
    "id": "s0370",
    "blockIndex": 39,
    "zh": "耿純率宗族賓客二千餘人，老病者皆載木自隨，迎秀於育；"
  },
  {
    "id": "s0371",
    "blockIndex": 39,
    "zh": "拜純為前將軍。"
  },
  {
    "id": "s0372",
    "blockIndex": 39,
    "zh": "進攻下曲陽，降之。"
  },
  {
    "id": "s0373",
    "blockIndex": 39,
    "zh": "眾稍合，至數萬人，復北擊中山。"
  },
  {
    "id": "s0374",
    "blockIndex": 39,
    "zh": "耿純恐宗家懷異心，乃使從弟訢宿歸，燒廬舍以絕其反顧之望。"
  },
  {
    "id": "s0375",
    "blockIndex": 40,
    "zh": "秀進拔盧奴，所過發奔命兵，移檄邊郡共擊邯鄲；"
  },
  {
    "id": "s0376",
    "blockIndex": 40,
    "zh": "郡縣還復響應。"
  },
  {
    "id": "s0377",
    "blockIndex": 40,
    "zh": "時真定王楊起兵附王郎，眾十餘萬，秀遣劉植說楊，楊乃降。"
  },
  {
    "id": "s0378",
    "blockIndex": 40,
    "zh": "秀因留真定，納楊甥郭氏為夫人以結之。"
  },
  {
    "id": "s0379",
    "blockIndex": 40,
    "zh": "進擊元氏、防子，皆下之。"
  },
  {
    "id": "s0380",
    "blockIndex": 40,
    "zh": "至鄗，擊斬王郎將李惲；"
  },
  {
    "id": "s0381",
    "blockIndex": 40,
    "zh": "至柏人，復破郎將李育。"
  },
  {
    "id": "s0382",
    "blockIndex": 40,
    "zh": "育還保城；"
  },
  {
    "id": "s0383",
    "blockIndex": 40,
    "zh": "攻之，不下。"
  },
  {
    "id": "s0384",
    "blockIndex": 41,
    "zh": "南鄭人延岑起兵據漢中，漢中王嘉擊降之，有眾數十萬。"
  },
  {
    "id": "s0385",
    "blockIndex": 41,
    "zh": "校尉南陽賈復見更始政亂，乃說嘉曰：「今天下未定，而大王安守所保，所保得無不可保乎？"
  },
  {
    "id": "s0386",
    "blockIndex": 41,
    "zh": "」嘉曰：「卿言大，非吾任也。"
  },
  {
    "id": "s0387",
    "blockIndex": 41,
    "zh": "大司馬在河北，必能相用。"
  },
  {
    "id": "s0388",
    "blockIndex": 41,
    "zh": "」乃為書薦復及長史南陽陳俊於劉秀。"
  },
  {
    "id": "s0389",
    "blockIndex": 41,
    "zh": "復等見秀於柏人，秀以復為破虜將軍，俊為安集掾。"
  },
  {
    "id": "s0390",
    "blockIndex": 42,
    "zh": "秀捨中兒犯法，軍市令穎川祭遵格殺之，秀怒，命收遵。"
  },
  {
    "id": "s0391",
    "blockIndex": 42,
    "zh": "主簿陳副諫曰：「明公常欲眾軍整齊，今遵奉法不避，是教令所行也。"
  },
  {
    "id": "s0392",
    "blockIndex": 42,
    "zh": "」乃貰之，以為刺奸將軍，謂諸將曰：「當備祭遵！"
  },
  {
    "id": "s0393",
    "blockIndex": 42,
    "zh": "吾捨中兒犯法尚殺之，必不私諸卿也。"
  },
  {
    "id": "s0395",
    "blockIndex": 43,
    "zh": "初，王莽既殺鮑宣，上黨都尉路平欲殺其子永；"
  },
  {
    "id": "s0396",
    "blockIndex": 43,
    "zh": "太守苟諫保護之，永由是得全。"
  },
  {
    "id": "s0397",
    "blockIndex": 43,
    "zh": "更始征永為尚書僕射，行大將軍事，將兵安集河東、并州，得自置偏裨。"
  },
  {
    "id": "s0398",
    "blockIndex": 43,
    "zh": "永至河東，擊青犢，大破之。"
  },
  {
    "id": "s0399",
    "blockIndex": 43,
    "zh": "以馮衍為立漢將軍，屯太原，與上黨太守田邑等繕甲養士，以扞衛並土。"
  },
  {
    "id": "s0400",
    "blockIndex": 44,
    "zh": "或說大司馬秀以守柏人不如定巨鹿，秀乃引兵東北拔廣阿。"
  },
  {
    "id": "s0401",
    "blockIndex": 44,
    "zh": "秀披輿地圖，指示鄧禹曰：「天下郡國如是，今始乃得其一。"
  },
  {
    "id": "s0402",
    "blockIndex": 44,
    "zh": "子前言以吾慮天下不足定，何也？"
  },
  {
    "id": "s0403",
    "blockIndex": 44,
    "zh": "」禹曰：「方今海內殽亂，人思明君，猶赤子之慕慈母。"
  },
  {
    "id": "s0404",
    "blockIndex": 44,
    "zh": "古之興者在德薄厚，不以大小也。"
  },
  {
    "id": "s0405",
    "blockIndex": 44,
    "zh": "」薊中之亂，耿弇與劉秀相失，北走昌平，就其父況，因說況擊邯鄲。"
  },
  {
    "id": "s0406",
    "blockIndex": 44,
    "zh": "時王郎遣將徇漁陽、上谷，急發其兵。"
  },
  {
    "id": "s0407",
    "blockIndex": 44,
    "zh": "北州疑惑，多欲從之。"
  },
  {
    "id": "s0408",
    "blockIndex": 44,
    "zh": "上谷功曹寇恂、門下掾閔業說況曰：「邯鄲拔起，難可信向。"
  },
  {
    "id": "s0409",
    "blockIndex": 44,
    "zh": "大司馬，劉伯升母弟，尊賢下士，可以歸之。"
  },
  {
    "id": "s0410",
    "blockIndex": 44,
    "zh": "」況曰：「邯鄲方盛，力不能獨拒，如何？"
  },
  {
    "id": "s0411",
    "blockIndex": 44,
    "zh": "」對曰：「今上谷完實，控弦萬騎，可以詳擇去就。"
  },
  {
    "id": "s0412",
    "blockIndex": 44,
    "zh": "恂請東約漁陽，齊心合眾，邯鄲不足圖也！"
  },
  {
    "id": "s0413",
    "blockIndex": 44,
    "zh": "」況然之，遣恂東約彭寵，欲各發突騎二千匹、步兵千人詣大司馬秀。"
  },
  {
    "id": "s0414",
    "blockIndex": 44,
    "zh": "安樂令吳漢、護軍蓋延、狐奴令王梁亦勸寵從秀，寵以為然，而官屬皆欲附王郎，寵不能奪。"
  },
  {
    "id": "s0415",
    "blockIndex": 44,
    "zh": "漢出止外亭，遇一儒生，召而食之，問以所聞。"
  },
  {
    "id": "s0416",
    "blockIndex": 44,
    "zh": "生言：「大司馬劉公，所過為郡縣所稱，邯鄲舉尊號者，實非劉氏。"
  },
  {
    "id": "s0417",
    "blockIndex": 44,
    "zh": "」漢大喜，即詐為秀書，移檄漁陽，使生繼以詣寵，令具以所聞說之。"
  },
  {
    "id": "s0418",
    "blockIndex": 44,
    "zh": "會寇恂至，寵乃發步騎三千人，以吳漢行長史，與蓋延、王梁將之，南攻薊，殺王郎大將趙閎。"
  },
  {
    "id": "s0419",
    "blockIndex": 45,
    "zh": "寇恂還，遂與上谷長史景丹及耿弇將兵俱南，與漁陽軍合，所過擊斬王郎大將、九卿、校尉以下，凡斬首三萬級，定涿郡、中山、巨鹿、清河、河間凡二十二縣。"
  },
  {
    "id": "s0420",
    "blockIndex": 45,
    "zh": "前及廣阿，聞城中車騎甚眾，丹等勒兵問曰：「此何兵？"
  },
  {
    "id": "s0421",
    "blockIndex": 45,
    "zh": "」曰：「大司馬劉公也。"
  },
  {
    "id": "s0422",
    "blockIndex": 45,
    "zh": "」諸將喜，即進至城下。"
  },
  {
    "id": "s0423",
    "blockIndex": 45,
    "zh": "城下初傳言二郡兵為邯鄲來，眾皆恐。"
  },
  {
    "id": "s0424",
    "blockIndex": 45,
    "zh": "劉秀自登西城樓勒兵問之；"
  },
  {
    "id": "s0425",
    "blockIndex": 45,
    "zh": "耿弇拜於城下，即召入，具言發兵狀。"
  },
  {
    "id": "s0426",
    "blockIndex": 45,
    "zh": "秀乃悉召景丹等入，笑曰：「邯鄣將帥數言我發漁陽、上谷兵，吾聊應言『我亦發之』，何意二郡良為吾來！"
  },
  {
    "id": "s0427",
    "blockIndex": 45,
    "zh": "方與士大夫共此功名耳。"
  },
  {
    "id": "s0428",
    "blockIndex": 45,
    "zh": "」乃以景丹、寇恂、耿弇、蓋延、吳漢、王梁皆為偏將軍，使還領其兵，加耿況、彭寵大將軍；"
  },
  {
    "id": "s0429",
    "blockIndex": 45,
    "zh": "封況、寵、丹、延皆為列侯。"
  },
  {
    "id": "s0430",
    "blockIndex": 45,
    "zh": "吳漢為人，質厚少文，造次不能以辭自達，然沉勇有智略，鄧禹數薦之於秀，秀漸親重之。"
  },
  {
    "id": "s0431",
    "blockIndex": 46,
    "zh": "更始遣尚書令謝躬率六將軍討王郎，不能下。"
  },
  {
    "id": "s0432",
    "blockIndex": 46,
    "zh": "秀至，與之合軍，東圍巨鹿，月餘未下。"
  },
  {
    "id": "s0433",
    "blockIndex": 46,
    "zh": "王郎遣將攻信都，大姓馬寵等開城內之。"
  },
  {
    "id": "s0434",
    "blockIndex": 46,
    "zh": "更始遣兵攻破信都，秀使李忠還，行太守事。"
  },
  {
    "id": "s0435",
    "blockIndex": 46,
    "zh": "王郎遣將倪宏、劉奉率數萬人救巨鹿，秀逆戰於南□，不利。"
  },
  {
    "id": "s0436",
    "blockIndex": 46,
    "zh": "景丹等縱突騎擊之，宏等大敗。"
  },
  {
    "id": "s0437",
    "blockIndex": 46,
    "zh": "秀曰：「吾聞突騎天下精兵，今見其戰，樂可言邪？"
  },
  {
    "id": "s0438",
    "blockIndex": 46,
    "zh": "」耿純言於秀曰：「久守巨鹿，士眾疲弊；"
  },
  {
    "id": "s0439",
    "blockIndex": 46,
    "zh": "不如及大兵精銳，進攻邯鄲。"
  },
  {
    "id": "s0440",
    "blockIndex": 46,
    "zh": "若王郎已誅，巨鹿不戰自服矣。"
  },
  {
    "id": "s0441",
    "blockIndex": 46,
    "zh": "」秀從之。"
  },
  {
    "id": "s0442",
    "blockIndex": 46,
    "zh": "夏，四月，留將軍鄧滿守巨鹿。"
  },
  {
    "id": "s0443",
    "blockIndex": 46,
    "zh": "進軍邯鄲，連戰，破之。"
  },
  {
    "id": "s0444",
    "blockIndex": 46,
    "zh": "郎乃使其諫大夫杜威請降。"
  },
  {
    "id": "s0445",
    "blockIndex": 46,
    "zh": "威雅稱郎實成帝遺體，秀曰：「設使成帝復生，天下不可得，況詐子輿者乎！"
  },
  {
    "id": "s0446",
    "blockIndex": 46,
    "zh": "」威請求萬戶侯，秀曰：「顧得全身可矣！"
  },
  {
    "id": "s0447",
    "blockIndex": 46,
    "zh": "」威怒而去。"
  },
  {
    "id": "s0448",
    "blockIndex": 46,
    "zh": "秀急攻之，二十餘日。"
  },
  {
    "id": "s0449",
    "blockIndex": 46,
    "zh": "五月，甲辰，郎少傅李立開門內漢兵，遂拔邯鄲。"
  },
  {
    "id": "s0450",
    "blockIndex": 46,
    "zh": "郎夜亡走，王霸追斬之。"
  },
  {
    "id": "s0451",
    "blockIndex": 46,
    "zh": "秀收郎文書，得吏民與郎交關謗毀者數千章。"
  },
  {
    "id": "s0452",
    "blockIndex": 46,
    "zh": "秀不省，會諸將軍燒之，曰：「令反側子自安！"
  },
  {
    "id": "s0453",
    "blockIndex": 46,
    "zh": "」秀部分吏卒各隸諸軍，士皆言願屬大樹將軍。"
  },
  {
    "id": "s0454",
    "blockIndex": 46,
    "zh": "大樹將軍者，偏將軍馮異也，為人謙退不伐，敕吏士非交戰受敵，常行諸營之後。"
  },
  {
    "id": "s0455",
    "blockIndex": 46,
    "zh": "每所止捨，諸將並坐論功，異常獨屏樹下，故軍中號曰：「大樹將軍」。"
  },
  {
    "id": "s0456",
    "blockIndex": 47,
    "zh": "護軍宛人朱祜從容言於秀曰：「長安政亂，公有日角之相，此天命也！"
  },
  {
    "id": "s0457",
    "blockIndex": 47,
    "zh": "」秀曰：「召刺奸收護軍！"
  },
  {
    "id": "s0458",
    "blockIndex": 47,
    "zh": "」祜乃不敢復言。"
  },
  {
    "id": "s0459",
    "blockIndex": 47,
    "zh": "更始遣使立秀為蕭王，悉令罷兵，與諸將有功者詣行在所。"
  },
  {
    "id": "s0460",
    "blockIndex": 47,
    "zh": "遣苗曾為幽州牧，韋順為上谷太守，蔡充為漁陽太守，並北之部。"
  },
  {
    "id": "s0461",
    "blockIndex": 48,
    "zh": "蕭王居邯鄲宮，晝臥溫明殿，耿弇入，造床下請間，因說曰：「吏士死傷者多，請歸上谷益兵。"
  },
  {
    "id": "s0462",
    "blockIndex": 48,
    "zh": "」蕭王曰：「王郎已破，河北略平，復用兵何為？"
  },
  {
    "id": "s0463",
    "blockIndex": 48,
    "zh": "」弇曰：「王郎雖破，天下兵革乃始耳。"
  },
  {
    "id": "s0464",
    "blockIndex": 48,
    "zh": "今使者從西方來，欲罷兵，不可聽也。"
  },
  {
    "id": "s0465",
    "blockIndex": 48,
    "zh": "銅馬、赤眉之屬數十輩，輩數十百萬人，所向無前，聖公不能辦也，敗必不久。"
  },
  {
    "id": "s0466",
    "blockIndex": 48,
    "zh": "」蕭王起坐曰：「卿失言，我斬卿！"
  },
  {
    "id": "s0467",
    "blockIndex": 48,
    "zh": "」弇曰：「大王哀厚弇如父子，故敢披赤心。"
  },
  {
    "id": "s0468",
    "blockIndex": 48,
    "zh": "」蕭王曰：「我戲卿耳，何以言之？"
  },
  {
    "id": "s0469",
    "blockIndex": 48,
    "zh": "」弇曰：「百姓患苦王莽，復思劉氏，聞漢兵起，莫不歡喜，如去虎口得歸慈母。"
  },
  {
    "id": "s0470",
    "blockIndex": 48,
    "zh": "今更始為天子，而諸將擅命於山東，貴戚縱橫於都內，虜掠自恣，元元叩心，更思莽朝，是以知其必敗也。"
  },
  {
    "id": "s0471",
    "blockIndex": 48,
    "zh": "公功名已著，以義征伐，天下可傳檄而定也。"
  },
  {
    "id": "s0472",
    "blockIndex": 48,
    "zh": "天下至重，公可自取，毋令他姓得之。"
  },
  {
    "id": "s0473",
    "blockIndex": 48,
    "zh": "」蕭王乃辭以河北未平，不就征，始貳於更始。"
  },
  {
    "id": "s0474",
    "blockIndex": 49,
    "zh": "是時，諸賊銅馬、大彤、高湖、重連、鐵脛、大槍、尤來、上江、青犢、五校、五幡、五樓、富平、獲索等各領部曲，眾合數百萬人，所在寇掠。"
  },
  {
    "id": "s0475",
    "blockIndex": 49,
    "zh": "蕭王欲擊之，乃拜吳漢、耿弇俱為大將軍，持節北發幽州十郡突騎。"
  },
  {
    "id": "s0476",
    "blockIndex": 49,
    "zh": "苗曾聞之，陰敕諸郡不得應調。"
  },
  {
    "id": "s0477",
    "blockIndex": 49,
    "zh": "吳漢將二十騎先馳至無終，曾出迎於路，漢即收曾，斬之。"
  },
  {
    "id": "s0478",
    "blockIndex": 49,
    "zh": "耿弇到上谷，亦收韋順、蔡充，斬之。"
  },
  {
    "id": "s0479",
    "blockIndex": 49,
    "zh": "北州震駭，於是悉發其兵。"
  },
  {
    "id": "s0480",
    "blockIndex": 50,
    "zh": "秋，蕭王擊銅馬於鄡，吳漢將突騎來會清陽，士馬甚盛，漢悉上兵簿於莫府，請所付與，不敢自私，王益重之。"
  },
  {
    "id": "s0481",
    "blockIndex": 50,
    "zh": "王以偏將軍沛國朱浮為大將軍、幽州牧，使治薊城。"
  },
  {
    "id": "s0482",
    "blockIndex": 50,
    "zh": "銅馬食盡，夜遁，蕭王追擊於館陶，大破之。"
  },
  {
    "id": "s0483",
    "blockIndex": 50,
    "zh": "受降未盡，而高湖、重連從東南來，與銅馬餘眾合。"
  },
  {
    "id": "s0484",
    "blockIndex": 50,
    "zh": "蕭王復與大戰於蒲陽，悉破降之，封其渠帥為列侯。"
  },
  {
    "id": "s0485",
    "blockIndex": 50,
    "zh": "諸將未能信賊，降者亦不自安。"
  },
  {
    "id": "s0486",
    "blockIndex": 50,
    "zh": "王知其意，敕令降者各歸營勒兵，自乘輕騎按行部陳。"
  },
  {
    "id": "s0487",
    "blockIndex": 50,
    "zh": "降者更相語曰：「蕭王推赤心置人腹中，安得不投死乎！"
  },
  {
    "id": "s0488",
    "blockIndex": 50,
    "zh": "」由是皆服。"
  },
  {
    "id": "s0489",
    "blockIndex": 50,
    "zh": "悉以降人分配諸將，眾遂數十萬。"
  },
  {
    "id": "s0490",
    "blockIndex": 50,
    "zh": "赤眉別帥與青犢、上江、大彤、鐵脛、五幡十餘萬眾在射犬，蕭王引兵進擊，大破之。"
  },
  {
    "id": "s0491",
    "blockIndex": 50,
    "zh": "南徇河內，河內太守韓歆降。"
  },
  {
    "id": "s0492",
    "blockIndex": 51,
    "zh": "初，謝躬與蕭王共滅王郎，數與蕭王違戾，常欲襲蕭王，畏其兵強而止。"
  },
  {
    "id": "s0493",
    "blockIndex": 51,
    "zh": "雖俱在邯鄲，遂分城而處，然蕭王每有以慰安之。"
  },
  {
    "id": "s0494",
    "blockIndex": 51,
    "zh": "躬勤於吏職，蕭王常稱之曰：「謝尚書，真吏也！"
  },
  {
    "id": "s0495",
    "blockIndex": 51,
    "zh": "」故不自疑。"
  },
  {
    "id": "s0496",
    "blockIndex": 51,
    "zh": "其妻知之，常戒之曰：「君與劉公積不相能，而信其虛談，終受制矣。"
  },
  {
    "id": "s0497",
    "blockIndex": 51,
    "zh": "」躬不納。"
  },
  {
    "id": "s0498",
    "blockIndex": 51,
    "zh": "既而躬率其兵數萬還屯於鄴。"
  },
  {
    "id": "s0499",
    "blockIndex": 51,
    "zh": "及蕭王南擊青犢，使躬邀擊尤來於隆慮山，躬兵大敗。"
  },
  {
    "id": "s0500",
    "blockIndex": 51,
    "zh": "蕭王因躬在外，使吳漢與刺奸大將軍岑彭襲據鄴城。"
  },
  {
    "id": "s0501",
    "blockIndex": 51,
    "zh": "躬不知，輕騎還鄴，漢等收斬之，其眾悉降。"
  },
  {
    "id": "s0502",
    "blockIndex": 52,
    "zh": "更始遣柱功侯李寶、益州刺史張忠將兵萬餘人徇蜀、漢。"
  },
  {
    "id": "s0503",
    "blockIndex": 52,
    "zh": "公孫述遣其弟恢擊寶、忠於綿竹，大破走之。"
  },
  {
    "id": "s0504",
    "blockIndex": 52,
    "zh": "述遂自立為蜀王，都成都，民、夷皆附之。"
  },
  {
    "id": "s0505",
    "blockIndex": 53,
    "zh": "冬，更始遣中郎將歸德侯颯、大司馬護軍陳遵使匈奴，授單于漢舊制璽綬，因送雲、當餘親屬、貴人、從者還匈奴。"
  },
  {
    "id": "s0506",
    "blockIndex": 53,
    "zh": "單于輿驕，謂遵、颯曰：「匈奴本與漢為兄弟，匈奴中亂，孝宣皇帝輔立呼韓邪單于，故稱臣以尊漢。"
  },
  {
    "id": "s0507",
    "blockIndex": 53,
    "zh": "今漢亦大亂，為王莽所篡，匈奴亦出兵擊莽，空其邊境，令天下騷動思漢；"
  },
  {
    "id": "s0508",
    "blockIndex": 53,
    "zh": "莽卒以敗而漢復興，亦我力也，當復尊我！"
  },
  {
    "id": "s0509",
    "blockIndex": 53,
    "zh": "」遵與相撐拒，單于終持此言。"
  },
  {
    "id": "s0510",
    "blockIndex": 54,
    "zh": "赤眉樊崇等將兵入穎川，分其眾為二部，崇與逢安為一部，徐宣、謝祿、楊音為一部。"
  },
  {
    "id": "s0511",
    "blockIndex": 54,
    "zh": "赤眉雖數戰勝，而疲敝厭兵，皆日夜愁泣，思欲東歸。"
  },
  {
    "id": "s0512",
    "blockIndex": 54,
    "zh": "崇等計議，慮眾東向必散，不如西攻長安。"
  },
  {
    "id": "s0513",
    "blockIndex": 54,
    "zh": "於是崇、安自武關，宣等從陸渾關，兩道俱入。"
  },
  {
    "id": "s0514",
    "blockIndex": 54,
    "zh": "更始使王匡、成丹與抗威將軍劉均等分據河東、弘農以拒之。"
  },
  {
    "id": "s0515",
    "blockIndex": 55,
    "zh": "蕭王將北徇燕、趙，度赤眉必破長安，又欲乘釁並關中，而未知所寄，乃拜鄧禹為前將軍，中分麾下精兵二萬人，遣西入關，令自選偏裨以下可與俱者。"
  },
  {
    "id": "s0516",
    "blockIndex": 55,
    "zh": "時朱鮪、李軼、田立、陳僑將兵號三十萬，與河南太守武勃共守洛陽；"
  },
  {
    "id": "s0517",
    "blockIndex": 55,
    "zh": "鮑永、田邑在并州。"
  },
  {
    "id": "s0518",
    "blockIndex": 55,
    "zh": "蕭王以河內險要富實，欲擇諸將守河內者而難其人，問於鄧禹。"
  },
  {
    "id": "s0519",
    "blockIndex": 55,
    "zh": "鄧禹曰：「寇恂文武備足，有牧民御眾之才，非此子莫可使也！"
  },
  {
    "id": "s0520",
    "blockIndex": 55,
    "zh": "」乃拜恂河內太守，行大將軍事。"
  },
  {
    "id": "s0521",
    "blockIndex": 55,
    "zh": "蕭王謂恂曰：「昔高祖留蕭何關中，吾今委公以河內。"
  },
  {
    "id": "s0522",
    "blockIndex": 55,
    "zh": "當給足軍糧，率厲士馬，防遏它兵，勿令北度而已！"
  },
  {
    "id": "s0523",
    "blockIndex": 55,
    "zh": "」拜馮異為孟津將軍，統魏郡、河內兵於河上，以拒洛陽。"
  },
  {
    "id": "s0524",
    "blockIndex": 55,
    "zh": "蕭王親送鄧禹至野王，禹既西，蕭王乃復引兵而北。"
  },
  {
    "id": "s0525",
    "blockIndex": 55,
    "zh": "寇恂調餱糧、治器械以供軍；"
  },
  {
    "id": "s0526",
    "blockIndex": 55,
    "zh": "軍雖遠征，未嘗乏絕。"
  },
  {
    "id": "s0527",
    "blockIndex": 56,
    "zh": "隗崔、隗義謀叛歸天水。"
  },
  {
    "id": "s0528",
    "blockIndex": 56,
    "zh": "隗囂恐並及禍，乃告之。"
  },
  {
    "id": "s0529",
    "blockIndex": 56,
    "zh": "更始誅崔、義，以囂為御史大夫。"
  },
  {
    "id": "s0530",
    "blockIndex": 57,
    "zh": "梁王永據國起兵，招諸郡豪桀，沛人周建等並署為將帥，攻下濟陰、山陽、沛、楚、淮陽、汝南，凡得二十八城。"
  },
  {
    "id": "s0531",
    "blockIndex": 57,
    "zh": "又遣使拜西防賊帥山陽佼強為橫行將軍，東海賊帥董憲為翼漢大將軍，琅邪賊帥張步為輔漢大將軍，督青、徐二州，與之連兵，遂專據東方。"
  },
  {
    "id": "s0532",
    "blockIndex": 58,
    "zh": "已阜人秦豐起兵於黎丘，攻得已阜、宜城等十餘縣，有眾萬人，自號楚黎王。"
  },
  {
    "id": "s0533",
    "blockIndex": 59,
    "zh": "汝南田戎攻陷夷陵，自稱掃地大將軍；"
  },
  {
    "id": "s0534",
    "blockIndex": 59,
    "zh": "轉寇郡縣，眾數萬人。"
  },
  {
    "id": "s0535",
    "blockIndex": 60,
    "zh": "category:資治通鑑"
  }
]
