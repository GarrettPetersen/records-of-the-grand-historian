[
  {
    "id": "s0001",
    "blockIndex": 0,
    "zh": "起昭陽協洽，盡閼逢敦牂，凡十二年。"
  },
  {
    "id": "s0002",
    "blockIndex": 0,
    "zh": "世宗孝武皇帝下之下 天漢三年（癸未，公元前九八年） 1 春，二月，王卿有罪自殺，以執金吾杜周為御史大夫。"
  },
  {
    "id": "s0003",
    "blockIndex": 0,
    "zh": "---- 2 初榷酒酤。"
  },
  {
    "id": "s0004",
    "blockIndex": 0,
    "zh": "---- 3 三月，上行幸泰山，脩封，祀明堂，因受計。"
  },
  {
    "id": "s0005",
    "blockIndex": 0,
    "zh": "還，祠常山，瘞玄玉。"
  },
  {
    "id": "s0006",
    "blockIndex": 0,
    "zh": "方士之候祠神人、入海求蓬萊者終無有驗，而公孫卿猶以大人跡為解。"
  },
  {
    "id": "s0007",
    "blockIndex": 0,
    "zh": "天子益怠厭方士之怪迂語矣，然猶羈縻不絕，冀遇其真。"
  },
  {
    "id": "s0008",
    "blockIndex": 0,
    "zh": "自此之後，方士言神祠者彌眾，然其效可睹矣。"
  },
  {
    "id": "s0009",
    "blockIndex": 0,
    "zh": "---- 4 夏，四月，大旱。"
  },
  {
    "id": "s0010",
    "blockIndex": 0,
    "zh": "赦天下。"
  },
  {
    "id": "s0011",
    "blockIndex": 0,
    "zh": "---- 5 秋，匈奴入雁門。"
  },
  {
    "id": "s0012",
    "blockIndex": 0,
    "zh": "太守坐畏愞棄市。"
  },
  {
    "id": "s0013",
    "blockIndex": 0,
    "zh": "---- 天漢四年（甲申，公元前九七年） 1 春，正月，朝諸侯王於甘泉宮。"
  },
  {
    "id": "s0014",
    "blockIndex": 0,
    "zh": "---- 2 發天下七科謫及勇敢士，遣貳師將軍李廣利將騎六萬、步兵七萬出朔方；"
  },
  {
    "id": "s0015",
    "blockIndex": 0,
    "zh": "強弩都尉路博德將萬餘人與貳師會；"
  },
  {
    "id": "s0016",
    "blockIndex": 0,
    "zh": "游擊將軍韓說將步兵三萬人出五原；"
  },
  {
    "id": "s0017",
    "blockIndex": 0,
    "zh": "因杅將軍公孫敖將騎萬、步兵三萬人出雁門。"
  },
  {
    "id": "s0018",
    "blockIndex": 0,
    "zh": "匈奴聞之，悉遠其累重於余吾水北；"
  },
  {
    "id": "s0019",
    "blockIndex": 0,
    "zh": "而單于以兵十萬待水南，與貳師接戰。"
  },
  {
    "id": "s0020",
    "blockIndex": 0,
    "zh": "貳師解而引歸，與單于連鬥十餘日。"
  },
  {
    "id": "s0021",
    "blockIndex": 0,
    "zh": "游擊無所得。"
  },
  {
    "id": "s0022",
    "blockIndex": 0,
    "zh": "因杅與左賢王戰，不利，引歸。"
  },
  {
    "id": "s0023",
    "blockIndex": 0,
    "zh": "時上遣敖深入匈奴迎李陵，敖軍無功還，因曰：「捕得生口，言李陵教單于為兵以備漢軍，故臣無所得。"
  },
  {
    "id": "s0024",
    "blockIndex": 0,
    "zh": "」上於是族陵家。"
  },
  {
    "id": "s0025",
    "blockIndex": 0,
    "zh": "既而聞之，乃漢將降匈奴者李緒，非陵也。"
  },
  {
    "id": "s0026",
    "blockIndex": 0,
    "zh": "陵使人刺殺緒。"
  },
  {
    "id": "s0027",
    "blockIndex": 0,
    "zh": "大閼氏欲殺陵，單于匿之北方。"
  },
  {
    "id": "s0028",
    "blockIndex": 0,
    "zh": "大閼氏死，乃還。"
  },
  {
    "id": "s0029",
    "blockIndex": 0,
    "zh": "單于以女妻陵，立為右校王，與衛律皆貴用事。"
  },
  {
    "id": "s0030",
    "blockIndex": 0,
    "zh": "衛律常在單于左右；"
  },
  {
    "id": "s0031",
    "blockIndex": 0,
    "zh": "陵居外，有大事乃入議。"
  },
  {
    "id": "s0032",
    "blockIndex": 0,
    "zh": "---- 3 夏，四月，立皇子髆為昌邑王。"
  },
  {
    "id": "s0033",
    "blockIndex": 0,
    "zh": "---- 太始元年（乙酉，公元前九六年） 1 春，正月，公孫敖坐妻為巫蠱要斬。"
  },
  {
    "id": "s0034",
    "blockIndex": 0,
    "zh": "---- 2 徙郡國豪桀於茂陵。"
  },
  {
    "id": "s0035",
    "blockIndex": 0,
    "zh": "---- 3 夏，六月，赦天下。"
  },
  {
    "id": "s0036",
    "blockIndex": 0,
    "zh": "---- 4 是歲，匈奴且鞮侯單于死。"
  },
  {
    "id": "s0037",
    "blockIndex": 0,
    "zh": "有兩子，長為左賢王，次為左大將。"
  },
  {
    "id": "s0038",
    "blockIndex": 0,
    "zh": "左賢王未至，貴人以為有病，更立左大將為單于。"
  },
  {
    "id": "s0039",
    "blockIndex": 0,
    "zh": "左賢王聞之，不敢進。"
  },
  {
    "id": "s0040",
    "blockIndex": 0,
    "zh": "左大將使人召左賢王而讓位焉。"
  },
  {
    "id": "s0041",
    "blockIndex": 0,
    "zh": "左賢王辭以病，左大將不聽，謂曰：「即不幸死，傳之於我。"
  },
  {
    "id": "s0042",
    "blockIndex": 0,
    "zh": "」左賢王許之，遂立，為狐鹿姑單于。"
  },
  {
    "id": "s0043",
    "blockIndex": 0,
    "zh": "以左大將為左賢王，數年，病死；"
  },
  {
    "id": "s0044",
    "blockIndex": 0,
    "zh": "其子先賢撣不得代，更以為日逐王。"
  },
  {
    "id": "s0045",
    "blockIndex": 0,
    "zh": "單于自以其子為左賢王。"
  },
  {
    "id": "s0046",
    "blockIndex": 0,
    "zh": "---- 太始二年（丙戌，公元前九五年） 1 春，正月，上行幸回中。"
  },
  {
    "id": "s0047",
    "blockIndex": 0,
    "zh": "---- 2 杜周卒，光祿大夫暴勝之為御史大夫。"
  },
  {
    "id": "s0048",
    "blockIndex": 0,
    "zh": "---- 3 秋，旱。"
  },
  {
    "id": "s0049",
    "blockIndex": 0,
    "zh": "---- 4 趙中大夫白公奏穿渠引涇水，首起谷口，尾入櫟陽，注渭中，袤二百里，溉田四千五百餘頃，因名曰白渠；"
  },
  {
    "id": "s0050",
    "blockIndex": 0,
    "zh": "民得其饒。"
  },
  {
    "id": "s0051",
    "blockIndex": 0,
    "zh": "---- 太始三年（丁亥，公元前九四年） 1 春，正月，上行幸甘泉宮。"
  },
  {
    "id": "s0052",
    "blockIndex": 0,
    "zh": "二月，幸東海，獲赤雁。"
  },
  {
    "id": "s0053",
    "blockIndex": 0,
    "zh": "幸琅邪，禮日成山，登之罘，浮大海而還。"
  },
  {
    "id": "s0054",
    "blockIndex": 0,
    "zh": "---- 2 是歲，皇子弗陵生。"
  },
  {
    "id": "s0055",
    "blockIndex": 0,
    "zh": "弗陵母曰河間趙倢伃，居鉤弋宮，任身十四月而生。"
  },
  {
    "id": "s0056",
    "blockIndex": 0,
    "zh": "上曰：「聞昔堯十四月而生，今鉤弋亦然。"
  },
  {
    "id": "s0057",
    "blockIndex": 0,
    "zh": "」乃命其所生門曰堯母門。"
  },
  {
    "id": "s0058",
    "blockIndex": 0,
    "zh": ":臣光曰：為人君者，動靜舉措不可不慎，發於中必形於外，天下無不知之。"
  },
  {
    "id": "s0059",
    "blockIndex": 0,
    "zh": "當是時也，皇后、太子皆無恙，而命鉤弋之門曰堯母，非名也。"
  },
  {
    "id": "s0060",
    "blockIndex": 0,
    "zh": "是以奸人逆探上意，知其奇愛少子，欲以為嗣，遂有危皇后、太子之心，卒成巫蠱之禍，悲夫！"
  },
  {
    "id": "s0061",
    "blockIndex": 0,
    "zh": "---- 3 趙人江充為水衡都尉。"
  },
  {
    "id": "s0062",
    "blockIndex": 0,
    "zh": "初，充為趙敬肅王客，得罪於太子丹，亡逃；"
  },
  {
    "id": "s0063",
    "blockIndex": 0,
    "zh": "詣闕告趙太子陰事，太子坐廢。"
  },
  {
    "id": "s0064",
    "blockIndex": 0,
    "zh": "上召充入見。"
  },
  {
    "id": "s0065",
    "blockIndex": 0,
    "zh": "充容貌魁岸，被服輕靡，上奇之；"
  },
  {
    "id": "s0066",
    "blockIndex": 0,
    "zh": "與語政事，大悅，由是有寵，拜為直指繡衣使者，使督察貴戚、近臣逾侈者。"
  },
  {
    "id": "s0067",
    "blockIndex": 0,
    "zh": "充舉劾無所避，上以為忠直，所言皆中意。"
  },
  {
    "id": "s0068",
    "blockIndex": 0,
    "zh": "嘗從上甘泉，逢太子家使乘車馬行馳道中，充以屬吏。"
  },
  {
    "id": "s0069",
    "blockIndex": 0,
    "zh": "太子聞之，使人謝充曰：「非愛車馬，誠不欲令上聞之，以教敕亡素者，唯江君寬之。"
  },
  {
    "id": "s0070",
    "blockIndex": 0,
    "zh": "」充不聽，遂白奏，上曰：「人臣當如是矣！"
  },
  {
    "id": "s0071",
    "blockIndex": 0,
    "zh": "」大見信用，威震京師。"
  },
  {
    "id": "s0072",
    "blockIndex": 0,
    "zh": "---- 太始四年（戊子，公元前九三年） 1 春，三月，上行幸泰山。"
  },
  {
    "id": "s0073",
    "blockIndex": 0,
    "zh": "壬午，祀高祖於明堂以配上帝，因受計。"
  },
  {
    "id": "s0074",
    "blockIndex": 0,
    "zh": "癸未，祀孝景皇帝於明堂。"
  },
  {
    "id": "s0075",
    "blockIndex": 0,
    "zh": "甲申，修封。"
  },
  {
    "id": "s0076",
    "blockIndex": 0,
    "zh": "丙戌，禪石閭。"
  },
  {
    "id": "s0077",
    "blockIndex": 0,
    "zh": "夏，四月，幸不其。"
  },
  {
    "id": "s0078",
    "blockIndex": 0,
    "zh": "五月，還，幸建章宮，赦天下。"
  },
  {
    "id": "s0079",
    "blockIndex": 0,
    "zh": "---- 2 冬，十月，甲寅晦，日有食之。"
  },
  {
    "id": "s0080",
    "blockIndex": 0,
    "zh": "---- 3 十二月，上行幸雍，祠五畤。"
  },
  {
    "id": "s0081",
    "blockIndex": 0,
    "zh": "西至安定、北地。"
  },
  {
    "id": "s0082",
    "blockIndex": 0,
    "zh": "征和元年（己丑，公元前九二年） 1 春，正月，上還，幸建章宮。"
  },
  {
    "id": "s0083",
    "blockIndex": 0,
    "zh": "---- 2 三月，趙敬肅王彭祖薨。"
  },
  {
    "id": "s0084",
    "blockIndex": 0,
    "zh": "彭祖取江都易王所幸淖姬，生男，號淖子。"
  },
  {
    "id": "s0085",
    "blockIndex": 0,
    "zh": "時淖姬兄為漢宦者，上召問：「淖子何如？"
  },
  {
    "id": "s0086",
    "blockIndex": 0,
    "zh": "」對曰：「為人多欲。"
  },
  {
    "id": "s0087",
    "blockIndex": 0,
    "zh": "」上曰：「多欲不宜君國子民。"
  },
  {
    "id": "s0088",
    "blockIndex": 0,
    "zh": "」問武始侯昌，曰：「無咎無譽。"
  },
  {
    "id": "s0089",
    "blockIndex": 0,
    "zh": "」上曰：「如是可矣。"
  },
  {
    "id": "s0090",
    "blockIndex": 0,
    "zh": "」遣使者立昌為趙王。"
  },
  {
    "id": "s0091",
    "blockIndex": 0,
    "zh": "---- 3 夏，大旱。"
  },
  {
    "id": "s0092",
    "blockIndex": 0,
    "zh": "---- 4 上居建章宮，見一男子帶劍入中龍華門，疑其異人，命收之。"
  },
  {
    "id": "s0093",
    "blockIndex": 0,
    "zh": "男子捐劍走，逐之弗獲。"
  },
  {
    "id": "s0094",
    "blockIndex": 0,
    "zh": "上怒，斬門候。"
  },
  {
    "id": "s0095",
    "blockIndex": 0,
    "zh": "冬，十一月，發三輔騎士大搜上林，閉長安城門索；"
  },
  {
    "id": "s0096",
    "blockIndex": 0,
    "zh": "十一日乃解。"
  },
  {
    "id": "s0097",
    "blockIndex": 0,
    "zh": "巫蠱始起。"
  },
  {
    "id": "s0098",
    "blockIndex": 0,
    "zh": "---- 5 丞相公孫賀夫人君孺，衛皇后姊也，賀由是有寵。"
  },
  {
    "id": "s0099",
    "blockIndex": 0,
    "zh": "賀子敬聲代父為太僕，驕奢不奉法，擅用北軍錢千九百萬；"
  },
  {
    "id": "s0100",
    "blockIndex": 0,
    "zh": "發覺，下獄。"
  },
  {
    "id": "s0101",
    "blockIndex": 0,
    "zh": "是時詔捕陽陵大俠朱安世甚急，賀自請逐捕安世以贖敬聲罪，上許之。"
  },
  {
    "id": "s0102",
    "blockIndex": 0,
    "zh": "後果得安世。"
  },
  {
    "id": "s0103",
    "blockIndex": 0,
    "zh": "安世笑曰：「丞相禍及宗矣！"
  },
  {
    "id": "s0104",
    "blockIndex": 0,
    "zh": "」遂從獄中上書，告「敬聲與陽石公主私通；"
  },
  {
    "id": "s0105",
    "blockIndex": 0,
    "zh": "上且上甘泉，使巫當馳道埋偶人，祝詛上，有惡言。"
  },
  {
    "id": "s0106",
    "blockIndex": 0,
    "zh": "」 ---- 征和二年（庚寅，公元前九一年） 1 春，正月，下賀獄，案驗；"
  },
  {
    "id": "s0107",
    "blockIndex": 0,
    "zh": "父子死獄中，家族。"
  },
  {
    "id": "s0108",
    "blockIndex": 0,
    "zh": "以涿郡太守劉屈氂為左丞相，封澎侯。"
  },
  {
    "id": "s0109",
    "blockIndex": 0,
    "zh": "屈氂，中山靖王子也。"
  },
  {
    "id": "s0110",
    "blockIndex": 0,
    "zh": "---- 2 夏，四月，大風，發屋折木。"
  },
  {
    "id": "s0111",
    "blockIndex": 0,
    "zh": "---- 3 閏月，諸邑公主、陽石公主及皇后弟子長平侯伉皆坐巫蠱誅。"
  },
  {
    "id": "s0112",
    "blockIndex": 0,
    "zh": "---- 4 上行幸甘泉。"
  },
  {
    "id": "s0113",
    "blockIndex": 0,
    "zh": "---- 5 初，上年二十九乃生戾太子，甚愛之。"
  },
  {
    "id": "s0114",
    "blockIndex": 0,
    "zh": "及長，性仁恕溫謹，上嫌其材能少，不類己；"
  },
  {
    "id": "s0115",
    "blockIndex": 0,
    "zh": "而所幸王夫人生子閎，李姬生子旦、胥，李夫人生子髆，皇后、太子寵浸衰，常有不自安之意。"
  },
  {
    "id": "s0116",
    "blockIndex": 0,
    "zh": "上覺之，謂大將軍青曰：「漢家庶事草創，加四夷侵陵中國，朕不變更制度，後世無法；"
  },
  {
    "id": "s0117",
    "blockIndex": 0,
    "zh": "不出師征伐，天下不安；"
  },
  {
    "id": "s0118",
    "blockIndex": 0,
    "zh": "為此者不得不勞民。"
  },
  {
    "id": "s0119",
    "blockIndex": 0,
    "zh": "若後世又如朕所為，是襲亡秦之跡也。"
  },
  {
    "id": "s0120",
    "blockIndex": 0,
    "zh": "太子敦重好靜，必能安天下，不使朕憂。"
  },
  {
    "id": "s0121",
    "blockIndex": 0,
    "zh": "欲求守文之主，安有賢於太子者乎！"
  },
  {
    "id": "s0122",
    "blockIndex": 0,
    "zh": "聞皇后與太子有不安之意，豈有之邪？"
  },
  {
    "id": "s0123",
    "blockIndex": 0,
    "zh": "可以意曉之。"
  },
  {
    "id": "s0124",
    "blockIndex": 0,
    "zh": "」大將軍頓首謝。"
  },
  {
    "id": "s0125",
    "blockIndex": 0,
    "zh": "皇后聞之，脫簪請罪。"
  },
  {
    "id": "s0126",
    "blockIndex": 0,
    "zh": "太子每諫證伐四夷，上笑曰：「吾當其勞，以逸遺汝，不亦可乎！"
  },
  {
    "id": "s0127",
    "blockIndex": 0,
    "zh": "」 上每行幸，常以後事付太子，宮內付皇后。"
  },
  {
    "id": "s0128",
    "blockIndex": 0,
    "zh": "有所平決，還，白其最，上亦無異，有時不省也。"
  },
  {
    "id": "s0129",
    "blockIndex": 0,
    "zh": "上用法嚴，多任深刻吏。"
  },
  {
    "id": "s0130",
    "blockIndex": 0,
    "zh": "太子寬厚，多所平反，雖得百姓心，而用法大臣皆不悅。"
  },
  {
    "id": "s0131",
    "blockIndex": 0,
    "zh": "皇后恐久獲罪，每戒太子，宜留取上意，不應擅有所縱捨。"
  },
  {
    "id": "s0132",
    "blockIndex": 0,
    "zh": "上聞之，是太子而非皇后。"
  },
  {
    "id": "s0133",
    "blockIndex": 0,
    "zh": "群臣寬厚長者皆附太子，而深酷用法者皆毀之。"
  },
  {
    "id": "s0134",
    "blockIndex": 0,
    "zh": "邪臣多黨與，故太子譽少而毀多。"
  },
  {
    "id": "s0135",
    "blockIndex": 0,
    "zh": "衛青薨後，臣下無復外家為據，競欲構太子。"
  },
  {
    "id": "s0136",
    "blockIndex": 0,
    "zh": "上與諸子疏，皇后希得見。"
  },
  {
    "id": "s0137",
    "blockIndex": 0,
    "zh": "太子嘗謁皇后，移日乃出。"
  },
  {
    "id": "s0138",
    "blockIndex": 0,
    "zh": "黃門蘇文告上曰：「太子與宮人戲。"
  },
  {
    "id": "s0139",
    "blockIndex": 0,
    "zh": "」上益太子宮人滿二百人。"
  },
  {
    "id": "s0140",
    "blockIndex": 0,
    "zh": "太子後知之，心銜文。"
  },
  {
    "id": "s0141",
    "blockIndex": 0,
    "zh": "文與小黃門常融、王弼等常微伺太子過，輒增加白之。"
  },
  {
    "id": "s0142",
    "blockIndex": 0,
    "zh": "皇后切齒，使太子白誅文等。"
  },
  {
    "id": "s0143",
    "blockIndex": 0,
    "zh": "太子曰：「第勿為過，何畏文等！"
  },
  {
    "id": "s0144",
    "blockIndex": 0,
    "zh": "上聰明，不信邪佞，不足憂也」上嘗小不平，使常融召太子，融言「太子有喜色」，上嘿然。"
  },
  {
    "id": "s0145",
    "blockIndex": 0,
    "zh": "及太子至，上察其貌，有涕泣處，而佯語笑，上怪之；"
  },
  {
    "id": "s0146",
    "blockIndex": 0,
    "zh": "更微問，知其情，乃誅融。"
  },
  {
    "id": "s0147",
    "blockIndex": 0,
    "zh": "皇后亦善自防閒，避嫌疑，雖久無寵，尚被禮遇。"
  },
  {
    "id": "s0148",
    "blockIndex": 0,
    "zh": "是時，方士及諸神巫多聚京師，率皆左道惑眾，變幻無所不為。"
  },
  {
    "id": "s0149",
    "blockIndex": 0,
    "zh": "女巫往來宮中，教美人度厄，每屋輒埋木人祭祀之。"
  },
  {
    "id": "s0150",
    "blockIndex": 0,
    "zh": "因妒忌恚詈，更相告訐，以為祝詛上，無道。"
  },
  {
    "id": "s0151",
    "blockIndex": 0,
    "zh": "上怒，所殺後宮延及大臣，死者數百人。"
  },
  {
    "id": "s0152",
    "blockIndex": 0,
    "zh": "上心既以為疑，嘗晝寢，夢木人數千持杖欲擊上，上驚寤，因是體不平，遂苦忽忽善忘。"
  },
  {
    "id": "s0153",
    "blockIndex": 0,
    "zh": "江充自以與太子及衛氏有隙，見上年老，恐晏駕後為太子所誅，因是為奸，言上疾祟在巫蠱。"
  },
  {
    "id": "s0154",
    "blockIndex": 0,
    "zh": "於是上以充為使者，治巫蠱獄。"
  },
  {
    "id": "s0155",
    "blockIndex": 0,
    "zh": "充將胡巫掘地求偶人，捕蠱及夜祠、視鬼，染污令有處，輒收捕驗治，燒鐵鉗灼，強服之。"
  },
  {
    "id": "s0156",
    "blockIndex": 0,
    "zh": "民轉相誣以巫蠱，吏輒劾以為大逆無道；"
  },
  {
    "id": "s0157",
    "blockIndex": 0,
    "zh": "自京師、三輔連及郡、國，坐而死者前後數萬人。"
  },
  {
    "id": "s0158",
    "blockIndex": 0,
    "zh": "是時，上春秋高，疑左右皆為蠱祝詛；"
  },
  {
    "id": "s0159",
    "blockIndex": 0,
    "zh": "有與無，莫敢訟其冤者。"
  },
  {
    "id": "s0160",
    "blockIndex": 0,
    "zh": "充既知上意，因胡巫檀何言：「宮中有蠱氣，不除之，上終不差。"
  },
  {
    "id": "s0161",
    "blockIndex": 0,
    "zh": "」上乃使充入宮，至省中，壞御座，掘地求蠱；"
  },
  {
    "id": "s0162",
    "blockIndex": 0,
    "zh": "又使按道侯韓說、御史章贛、黃門蘇文等助充。"
  },
  {
    "id": "s0163",
    "blockIndex": 0,
    "zh": "充先治後宮希幸夫人，以次及皇后、太子宮，掘地縱橫，太子、皇后無復施床處。"
  },
  {
    "id": "s0164",
    "blockIndex": 0,
    "zh": "充云：「於太子宮得木人尤多，又有帛書，所言不道；"
  },
  {
    "id": "s0165",
    "blockIndex": 0,
    "zh": "當奏聞。"
  },
  {
    "id": "s0166",
    "blockIndex": 0,
    "zh": "」太子懼，問少傅石德。"
  },
  {
    "id": "s0167",
    "blockIndex": 0,
    "zh": "德懼為師傅並誅，因謂太子曰：「前丞相父子、兩公主及衛氏皆坐此，今巫與使者掘地得征驗，不知巫置之邪，將實有也，無以自明。"
  },
  {
    "id": "s0168",
    "blockIndex": 0,
    "zh": "可矯以節收捕充等繫獄，窮治其奸詐。"
  },
  {
    "id": "s0169",
    "blockIndex": 0,
    "zh": "且上疾在甘泉，皇后及家吏請問皆不報；"
  },
  {
    "id": "s0170",
    "blockIndex": 0,
    "zh": "上存亡未可知，而奸臣如此，太子將不念秦扶蘇事邪？"
  },
  {
    "id": "s0171",
    "blockIndex": 0,
    "zh": "」太子曰：「吾人子，安得擅誅！"
  },
  {
    "id": "s0172",
    "blockIndex": 0,
    "zh": "不如歸謝，幸得無罪。"
  },
  {
    "id": "s0173",
    "blockIndex": 0,
    "zh": "」太子將往之甘泉，而江充持太子甚急；"
  },
  {
    "id": "s0174",
    "blockIndex": 0,
    "zh": "太子計不知所出，遂從石德計。"
  },
  {
    "id": "s0175",
    "blockIndex": 0,
    "zh": "秋，七月，壬午，太子使客詐為使者，收捕充等。"
  },
  {
    "id": "s0176",
    "blockIndex": 0,
    "zh": "按道侯說疑使者有詐，不肯受詔，客格殺說。"
  },
  {
    "id": "s0177",
    "blockIndex": 0,
    "zh": "太子自臨斬充，罵曰：「趙虜！"
  },
  {
    "id": "s0178",
    "blockIndex": 0,
    "zh": "前亂乃國王父子不足邪！"
  },
  {
    "id": "s0179",
    "blockIndex": 0,
    "zh": "乃復亂吾父子也！"
  },
  {
    "id": "s0180",
    "blockIndex": 0,
    "zh": "」又炙胡巫上林中。"
  },
  {
    "id": "s0181",
    "blockIndex": 0,
    "zh": "太子使舍人無且持節夜入未央宮殿長秋門，因長御倚華具白皇后，發中廄車載射士，出武庫兵，發長樂宮衛卒。"
  },
  {
    "id": "s0182",
    "blockIndex": 0,
    "zh": "長安擾亂，言太子反。"
  },
  {
    "id": "s0183",
    "blockIndex": 0,
    "zh": "蘇文迸走，得亡歸甘泉，說太子無狀。"
  },
  {
    "id": "s0184",
    "blockIndex": 0,
    "zh": "上曰：「太子必懼，又忿充等，故有此變。"
  },
  {
    "id": "s0185",
    "blockIndex": 0,
    "zh": "」乃使使召太子。"
  },
  {
    "id": "s0186",
    "blockIndex": 0,
    "zh": "使者不敢進，歸報云：「太子反已成，欲斬臣，臣逃歸。"
  },
  {
    "id": "s0187",
    "blockIndex": 0,
    "zh": "」上大怒。"
  },
  {
    "id": "s0188",
    "blockIndex": 0,
    "zh": "丞相屈氂聞變，挺身逃，亡其印綬，使長史乘疾置以聞。"
  },
  {
    "id": "s0189",
    "blockIndex": 0,
    "zh": "上問：「丞相何為？"
  },
  {
    "id": "s0190",
    "blockIndex": 0,
    "zh": "」對曰：「丞相秘之，未敢發兵。"
  },
  {
    "id": "s0191",
    "blockIndex": 0,
    "zh": "」上怒曰：「事籍籍如此，何謂秘也！"
  },
  {
    "id": "s0192",
    "blockIndex": 0,
    "zh": "丞相無周公之風矣，周公不誅管、蔡乎！"
  },
  {
    "id": "s0193",
    "blockIndex": 0,
    "zh": "」乃賜丞相璽書曰：「捕斬反者，自有賞罰。"
  },
  {
    "id": "s0194",
    "blockIndex": 0,
    "zh": "以牛車為櫓，毋接短兵，多殺傷士眾！"
  },
  {
    "id": "s0195",
    "blockIndex": 0,
    "zh": "堅閉城門，毋令反者得出！"
  },
  {
    "id": "s0196",
    "blockIndex": 0,
    "zh": "」太子宣言告令百官云：「帝在甘泉病困，疑有變；"
  },
  {
    "id": "s0197",
    "blockIndex": 0,
    "zh": "奸臣欲作亂。"
  },
  {
    "id": "s0198",
    "blockIndex": 0,
    "zh": "」上於是從甘泉來，幸城西建章宮，詔發三輔近縣兵，部中二千石以下，丞相兼將之。"
  },
  {
    "id": "s0199",
    "blockIndex": 0,
    "zh": "太子亦遣使者矯制赦長安中都官囚徒，命少傅石德及賓客張光等分將；"
  },
  {
    "id": "s0200",
    "blockIndex": 0,
    "zh": "使長安囚如侯持節發長水及宣曲胡騎，皆以裝會。"
  },
  {
    "id": "s0201",
    "blockIndex": 0,
    "zh": "侍郎馬通使長安，因追捕如侯，告胡人曰：「節有詐，勿聽也！"
  },
  {
    "id": "s0202",
    "blockIndex": 0,
    "zh": "」遂斬如侯，引騎入長安；"
  },
  {
    "id": "s0203",
    "blockIndex": 0,
    "zh": "又發楫棹士以予大鴻臚商丘成。"
  },
  {
    "id": "s0204",
    "blockIndex": 0,
    "zh": "初，漢節純赤，以太子持赤節，故更為黃旄加上以相別。"
  },
  {
    "id": "s0205",
    "blockIndex": 0,
    "zh": "太子立車北軍南門外，召護北軍使者任安，與節，令發兵。"
  },
  {
    "id": "s0206",
    "blockIndex": 0,
    "zh": "安拜受節；"
  },
  {
    "id": "s0207",
    "blockIndex": 0,
    "zh": "入，閉門不出。"
  },
  {
    "id": "s0208",
    "blockIndex": 0,
    "zh": "太子引兵去，驅四市人凡數萬眾，至長樂西闕下，逢丞相軍，合戰五日，死者數萬人，血流入溝中。"
  },
  {
    "id": "s0209",
    "blockIndex": 0,
    "zh": "民間皆云太子反，以故眾不附太子，丞相附兵浸多。"
  },
  {
    "id": "s0210",
    "blockIndex": 0,
    "zh": "庚寅，太子兵敗，南奔覆盎城門。"
  },
  {
    "id": "s0211",
    "blockIndex": 0,
    "zh": "司直田仁部閉城門，以為太子父子之親，不欲急之，太子由是得出亡。"
  },
  {
    "id": "s0212",
    "blockIndex": 0,
    "zh": "丞相欲斬仁，御史大夫暴勝之謂丞相曰：「司直，吏二千石，當先請，奈何擅斬之！"
  },
  {
    "id": "s0213",
    "blockIndex": 0,
    "zh": "」丞相釋仁。"
  },
  {
    "id": "s0214",
    "blockIndex": 0,
    "zh": "上聞而大怒，下吏責問御史大夫曰：「司直縱反者，丞相斬之，法也；"
  },
  {
    "id": "s0215",
    "blockIndex": 0,
    "zh": "大夫何以擅止之？"
  },
  {
    "id": "s0216",
    "blockIndex": 0,
    "zh": "」勝之惶恐，自殺。"
  },
  {
    "id": "s0217",
    "blockIndex": 0,
    "zh": "詔遣宗正劉長、執金吾劉敢奉策收皇后璽綬，后自殺。"
  },
  {
    "id": "s0218",
    "blockIndex": 0,
    "zh": "上以為任安老吏，見兵事起，欲坐觀成敗，見勝者合從之，有兩心，與田仁皆要斬。"
  },
  {
    "id": "s0219",
    "blockIndex": 0,
    "zh": "上以馬通獲如侯，長安男子景建從通獲石德，商丘成力戰獲張光，封通為重合侯，建為德侯，成為秺侯。"
  },
  {
    "id": "s0220",
    "blockIndex": 0,
    "zh": "諸太子賓客嘗出入宮門，皆坐誅；"
  },
  {
    "id": "s0221",
    "blockIndex": 0,
    "zh": "其隨太子發兵，以反法族，吏士劫略者皆徙敦煌郡。"
  },
  {
    "id": "s0222",
    "blockIndex": 0,
    "zh": "以太子在外，始置屯兵長安諸城門。"
  },
  {
    "id": "s0223",
    "blockIndex": 0,
    "zh": "上怒甚，群下憂懼，不知所出。"
  },
  {
    "id": "s0224",
    "blockIndex": 0,
    "zh": "壺關三老茂上書曰：「臣聞父者猶天，母者猶地，子猶萬物也，故天平，地安，物乃茂成；"
  },
  {
    "id": "s0225",
    "blockIndex": 0,
    "zh": "父慈，母愛，子乃孝順。"
  },
  {
    "id": "s0226",
    "blockIndex": 0,
    "zh": "今皇太子為漢嗣，承萬世之業，體祖宗之重，親則皇帝之宗子也。"
  },
  {
    "id": "s0227",
    "blockIndex": 0,
    "zh": "江充，布衣之人，閭閻之隸臣耳；"
  },
  {
    "id": "s0228",
    "blockIndex": 0,
    "zh": "陛下顯而用之，銜至尊之命以迫蹴皇太子，造飾奸詐，群邪錯繆，是以親戚之路鬲塞而不通。"
  },
  {
    "id": "s0229",
    "blockIndex": 0,
    "zh": "太子進則不得見上，退則困於亂臣，獨冤結而無告，不忍忿忿之心，起而殺充，恐懼逋逃，子盜父兵，以救難自免耳。"
  },
  {
    "id": "s0230",
    "blockIndex": 0,
    "zh": "臣竊以為無邪心。"
  },
  {
    "id": "s0231",
    "blockIndex": 0,
    "zh": "《詩》曰：『營營青蠅，止於籓。"
  },
  {
    "id": "s0232",
    "blockIndex": 0,
    "zh": "愷悌君子，無信讒言。"
  },
  {
    "id": "s0233",
    "blockIndex": 0,
    "zh": "讒言罔極，交亂四國。"
  },
  {
    "id": "s0234",
    "blockIndex": 0,
    "zh": "』往者江充讒殺趙太子，天下莫不聞。"
  },
  {
    "id": "s0235",
    "blockIndex": 0,
    "zh": "陛下不省察，深過太子，發盛怒，舉大兵而求之，三公自將。"
  },
  {
    "id": "s0236",
    "blockIndex": 0,
    "zh": "智者不敢言，辯士不敢說，臣竊痛之！"
  },
  {
    "id": "s0237",
    "blockIndex": 0,
    "zh": "唯陛下寬心慰意，少察所親，毋患太子之非，亟罷甲兵，無令太子久亡！"
  },
  {
    "id": "s0238",
    "blockIndex": 0,
    "zh": "臣不勝惓惓，出一旦之命，待罪建章宮下！"
  },
  {
    "id": "s0239",
    "blockIndex": 0,
    "zh": "」書奏，天子感寤，然尚未顯言赦之也。"
  },
  {
    "id": "s0240",
    "blockIndex": 0,
    "zh": "太子亡，東至湖，藏匿泉鳩里；"
  },
  {
    "id": "s0241",
    "blockIndex": 0,
    "zh": "主人家貧，常賣屨以給太子。"
  },
  {
    "id": "s0242",
    "blockIndex": 0,
    "zh": "太子有故人在湖，聞其富贍，使人呼之而發覺。"
  },
  {
    "id": "s0243",
    "blockIndex": 0,
    "zh": "八月，辛亥，吏圍捕太子。"
  },
  {
    "id": "s0244",
    "blockIndex": 0,
    "zh": "太子自度不得脫，即入室距戶自經。"
  },
  {
    "id": "s0245",
    "blockIndex": 0,
    "zh": "山陽男子張富昌為卒，足蹋開戶，新安令史李壽趨抱解太子。"
  },
  {
    "id": "s0246",
    "blockIndex": 0,
    "zh": "主人公遂格鬥死，皇孫二人皆並遇害。"
  },
  {
    "id": "s0247",
    "blockIndex": 0,
    "zh": "上既傷太子，乃封李壽為邘侯，張富昌為題侯。"
  },
  {
    "id": "s0248",
    "blockIndex": 0,
    "zh": "初，上為太子立博望苑，使通賓客，從其所好，故賓客多以異端進者。"
  },
  {
    "id": "s0249",
    "blockIndex": 0,
    "zh": ":臣光曰：古之明王教養太子，為之擇方正敦良之士，以為保傅、師友，使朝夕與之遊處。"
  },
  {
    "id": "s0250",
    "blockIndex": 0,
    "zh": "左右前後無非正人，出入起居無非正道，然猶有淫放邪僻而陷於禍敗者焉，今乃使太子自通賓客，從其所好。"
  },
  {
    "id": "s0251",
    "blockIndex": 0,
    "zh": "夫正直難親，諂諛易合，此固中人之常情，宜太子之不終也！"
  },
  {
    "id": "s0252",
    "blockIndex": 0,
    "zh": "---- 6 癸亥，地震。"
  },
  {
    "id": "s0253",
    "blockIndex": 0,
    "zh": "---- 7 九月，商丘成為御史大夫。"
  },
  {
    "id": "s0254",
    "blockIndex": 0,
    "zh": "---- 8 立趙敬肅王小子偃為平干王。"
  },
  {
    "id": "s0255",
    "blockIndex": 0,
    "zh": "---- 9 匈奴入上谷，五原，殺掠吏民。"
  },
  {
    "id": "s0256",
    "blockIndex": 0,
    "zh": "征和三年（辛卯，公元前九零年） 1 春，正月，上行幸雍，至安定、北地。"
  },
  {
    "id": "s0257",
    "blockIndex": 0,
    "zh": "---- 2 匈奴入五原、酒泉，殺兩都尉。"
  },
  {
    "id": "s0258",
    "blockIndex": 0,
    "zh": "三月，遣李廣利將七萬人出五原，商丘成將二萬人出西河，馬通將四萬騎出酒泉，擊匈奴。"
  },
  {
    "id": "s0259",
    "blockIndex": 0,
    "zh": "---- 3 夏，五月，赦天下。"
  },
  {
    "id": "s0260",
    "blockIndex": 0,
    "zh": "---- 4 匈奴單于聞漢兵大出，悉徙其輜重北邸郅居水；"
  },
  {
    "id": "s0261",
    "blockIndex": 0,
    "zh": "左賢王驅其人民度余吾水六七百里，居兜銜山；"
  },
  {
    "id": "s0262",
    "blockIndex": 0,
    "zh": "單于自將精兵渡姑且水。"
  },
  {
    "id": "s0263",
    "blockIndex": 0,
    "zh": "商丘成軍至，追邪徑，無所見，還。"
  },
  {
    "id": "s0264",
    "blockIndex": 0,
    "zh": "匈奴使大將與李陵將三萬餘騎追漢軍，轉戰九日，至蒲奴水；"
  },
  {
    "id": "s0265",
    "blockIndex": 0,
    "zh": "虜不利，還去。"
  },
  {
    "id": "s0266",
    "blockIndex": 0,
    "zh": "馬通軍至天山，匈奴使大將偃渠將二萬餘騎要漢兵，見漢兵強，引去；"
  },
  {
    "id": "s0267",
    "blockIndex": 0,
    "zh": "通無所得失。"
  },
  {
    "id": "s0268",
    "blockIndex": 0,
    "zh": "是時，漢恐車師遮馬通軍，遣開陵侯成娩將樓蘭、尉犁、危須等六國兵共圍車師，盡得其王民眾而還。"
  },
  {
    "id": "s0269",
    "blockIndex": 0,
    "zh": "貳師將軍出塞，匈奴使右大都尉與衛律將五千騎要擊漢軍於夫羊句山峽，貳師擊破之，乘勝追北至范夫人城。"
  },
  {
    "id": "s0270",
    "blockIndex": 0,
    "zh": "匈奴奔走，莫敢距敵。"
  },
  {
    "id": "s0271",
    "blockIndex": 0,
    "zh": "初，貳師之出也，丞相劉屈氂為祖道，送至渭橋。"
  },
  {
    "id": "s0272",
    "blockIndex": 0,
    "zh": "廣利曰：「願君侯早請昌邑王為太子；"
  },
  {
    "id": "s0273",
    "blockIndex": 0,
    "zh": "如立為帝，君侯長何憂乎！"
  },
  {
    "id": "s0274",
    "blockIndex": 0,
    "zh": "」屈氂許諾。"
  },
  {
    "id": "s0275",
    "blockIndex": 0,
    "zh": "昌邑王者，貳師將軍女弟李夫人子也；"
  },
  {
    "id": "s0276",
    "blockIndex": 0,
    "zh": "貳師女為屈氂子妻，故共欲立焉。"
  },
  {
    "id": "s0277",
    "blockIndex": 0,
    "zh": "會內者令郭穰告「丞相夫人祝詛上及與貳師共禱祠，欲令昌邑王為帝」，按驗，罪至大逆不道。"
  },
  {
    "id": "s0278",
    "blockIndex": 0,
    "zh": "六月，詔載屈氂廚車以徇，要斬東市，妻子梟首華陽街；"
  },
  {
    "id": "s0279",
    "blockIndex": 0,
    "zh": "貳師妻子亦收。"
  },
  {
    "id": "s0280",
    "blockIndex": 0,
    "zh": "貳師聞之，憂懼，其掾胡亞夫亦避罪從軍，說貳師曰：「夫人、室家皆在吏，若還，不稱意，適與獄會，郅居以北，可復得見乎！"
  },
  {
    "id": "s0281",
    "blockIndex": 0,
    "zh": "」貳師由是狐疑，深入要功，遂北至郅居水上。"
  },
  {
    "id": "s0282",
    "blockIndex": 0,
    "zh": "虜已去，貳師遣護軍將二萬騎度郅居之水，逢左賢王、左大將將二萬騎，與漢軍合戰一日，漢軍殺左大將，虜死傷甚眾。"
  },
  {
    "id": "s0283",
    "blockIndex": 0,
    "zh": "軍長史與決眭都尉輝渠侯謀曰：「將軍懷異心，欲危眾求功，恐必敗。"
  },
  {
    "id": "s0284",
    "blockIndex": 0,
    "zh": "」謀共執貳師。"
  },
  {
    "id": "s0285",
    "blockIndex": 0,
    "zh": "貳師聞之，斬長史，引兵還至燕然山。"
  },
  {
    "id": "s0286",
    "blockIndex": 0,
    "zh": "單于知漢軍勞倦，自將五萬騎遮擊貳師，相殺傷甚眾；"
  },
  {
    "id": "s0287",
    "blockIndex": 0,
    "zh": "夜，塹漢軍前，深數尺，從後急擊之，軍大亂；"
  },
  {
    "id": "s0288",
    "blockIndex": 0,
    "zh": "貳師遂降。"
  },
  {
    "id": "s0289",
    "blockIndex": 0,
    "zh": "單于素知其漢大將，以女妻之，尊寵在衛律上。"
  },
  {
    "id": "s0290",
    "blockIndex": 0,
    "zh": "宗族遂滅。"
  },
  {
    "id": "s0291",
    "blockIndex": 0,
    "zh": "---- 5 秋，蝗。"
  },
  {
    "id": "s0292",
    "blockIndex": 0,
    "zh": "---- 6 九月，故城父令公孫勇與客胡倩等謀反，倩詐稱光祿大夫，言使督盜賊；"
  },
  {
    "id": "s0293",
    "blockIndex": 0,
    "zh": "淮陽太守田廣明覺知，發兵捕斬焉。"
  },
  {
    "id": "s0294",
    "blockIndex": 0,
    "zh": "公孫勇衣繡衣、乘駟馬車至圉；"
  },
  {
    "id": "s0295",
    "blockIndex": 0,
    "zh": "圉守尉魏不害等誅之。"
  },
  {
    "id": "s0296",
    "blockIndex": 0,
    "zh": "封不害等四人為侯。"
  },
  {
    "id": "s0297",
    "blockIndex": 0,
    "zh": "---- 7 吏民以巫蠱相告言者，案驗多不實。"
  },
  {
    "id": "s0298",
    "blockIndex": 0,
    "zh": "上頗知太子惶恐無它意，會高寢郎田千秋上急變，訟太子冤曰：「子弄父兵，罪當笞。"
  },
  {
    "id": "s0299",
    "blockIndex": 0,
    "zh": "天子之子過誤殺人，當何罪哉！"
  },
  {
    "id": "s0300",
    "blockIndex": 0,
    "zh": "臣嘗夢一白頭翁教臣言。"
  },
  {
    "id": "s0301",
    "blockIndex": 0,
    "zh": "」上乃大感寤，召見千秋，謂曰：「父子之間，人所難言也，公獨明其不然。"
  },
  {
    "id": "s0302",
    "blockIndex": 0,
    "zh": "此高廟神靈使公教我，公當遂為吾輔佐。"
  },
  {
    "id": "s0303",
    "blockIndex": 0,
    "zh": "」立拜千秋為大鴻臚，而族滅江充家，焚蘇文於橫橋上，及泉鳩裡加兵刃於太子者，初為北地太守，後族。"
  },
  {
    "id": "s0304",
    "blockIndex": 0,
    "zh": "上憐太子無辜，乃作思子宮，為歸來望思之台於湖，天下聞而悲之。"
  },
  {
    "id": "s0305",
    "blockIndex": 0,
    "zh": "---- 征和四年（壬辰，公元前八九年） 1 春，正月，上行幸東萊，臨大海，欲浮海求神山。"
  },
  {
    "id": "s0306",
    "blockIndex": 0,
    "zh": "群臣諫，上弗聽；"
  },
  {
    "id": "s0307",
    "blockIndex": 0,
    "zh": "而大風晦冥，海水沸湧。"
  },
  {
    "id": "s0308",
    "blockIndex": 0,
    "zh": "上留十餘日，不得御樓船，乃還。"
  },
  {
    "id": "s0309",
    "blockIndex": 0,
    "zh": "---- 2 二月，丁酉，雍縣無雲，如雷者三，隕石二，黑如黳。"
  },
  {
    "id": "s0310",
    "blockIndex": 0,
    "zh": "---- 3 三月，上耕於距定。"
  },
  {
    "id": "s0311",
    "blockIndex": 0,
    "zh": "還，幸泰山，脩封。"
  },
  {
    "id": "s0312",
    "blockIndex": 0,
    "zh": "庚寅，祀於明堂。"
  },
  {
    "id": "s0313",
    "blockIndex": 0,
    "zh": "癸己，禪石閭，見群臣，上乃言曰：「朕即位以來，所為狂悖，使天下愁苦，不可追悔。"
  },
  {
    "id": "s0314",
    "blockIndex": 0,
    "zh": "自今事有傷害百姓，糜費天下者，悉罷之。"
  },
  {
    "id": "s0315",
    "blockIndex": 0,
    "zh": "」田千秋曰：「方士言神仙者甚眾，而無顯功，臣請皆罷斥遣之。"
  },
  {
    "id": "s0316",
    "blockIndex": 0,
    "zh": "」上曰：「大鴻臚言是也。"
  },
  {
    "id": "s0317",
    "blockIndex": 0,
    "zh": "」於是悉罷諸方士候神人者。"
  },
  {
    "id": "s0318",
    "blockIndex": 0,
    "zh": "是後上每對群臣自歎：「向時愚惑，為方士所欺。"
  },
  {
    "id": "s0319",
    "blockIndex": 0,
    "zh": "天下豈有仙人，盡妖妄耳！"
  },
  {
    "id": "s0320",
    "blockIndex": 0,
    "zh": "節食服藥，差可少病而已。"
  },
  {
    "id": "s0321",
    "blockIndex": 0,
    "zh": "」夏，六月，還，幸甘泉。"
  },
  {
    "id": "s0322",
    "blockIndex": 0,
    "zh": "---- 4 丁巳，以大鴻臚田千秋為丞相，封富民侯。"
  },
  {
    "id": "s0323",
    "blockIndex": 0,
    "zh": "千秋無它材能，又無伐閱功勞，特以一言寤意，數月取宰相，封侯，世未嘗有也。"
  },
  {
    "id": "s0324",
    "blockIndex": 0,
    "zh": "然為人敦厚有智，居位自稱，逾於前後數公。"
  },
  {
    "id": "s0325",
    "blockIndex": 0,
    "zh": "先是搜粟都尉桑弘羊與丞相、御史奏言：「輪台東有溉田五千頃以上，可遣屯田卒，置校尉三人分護，益種五穀；"
  },
  {
    "id": "s0326",
    "blockIndex": 0,
    "zh": "張掖、酒泉遣騎假司馬為斥候；"
  },
  {
    "id": "s0327",
    "blockIndex": 0,
    "zh": "募民壯健敢徙者詣田所，益墾溉田，稍築列亭，連城而西，以威西國，輔烏孫。"
  },
  {
    "id": "s0328",
    "blockIndex": 0,
    "zh": "」上乃下詔，深陳既往之悔曰：「前有司奏欲益民賦三十，助邊用，是重困老弱孤獨也。"
  },
  {
    "id": "s0329",
    "blockIndex": 0,
    "zh": "而今又請遣卒田輪台。"
  },
  {
    "id": "s0330",
    "blockIndex": 0,
    "zh": "輪台西於車師千餘里，前開陵侯擊車師時，雖勝，降其王，以遼遠乏食，道死者尚數千人，況益西乎！"
  },
  {
    "id": "s0331",
    "blockIndex": 0,
    "zh": "曩者朕之不明，以軍候弘上書，言『匈奴縛馬前後足置城下，馳言「秦人，我匄若馬，」』又，漢使者久留不還，故興遣貳師將軍，欲以為使者威重也。"
  },
  {
    "id": "s0332",
    "blockIndex": 0,
    "zh": "古者卿、大夫與謀，參以蓍、龜，不吉不行。"
  },
  {
    "id": "s0333",
    "blockIndex": 0,
    "zh": "乃者以縛馬書遍視丞相、御史、二千石、諸大夫、郎、為文學者，乃至郡、屬國都尉等，皆以『虜自縛其馬，不祥甚哉！"
  },
  {
    "id": "s0334",
    "blockIndex": 0,
    "zh": "』或以為『欲以見強，夫不足者視人有餘。"
  },
  {
    "id": "s0335",
    "blockIndex": 0,
    "zh": "』公車方士、太史、治星、望氣及太卜龜蓍皆以為『吉，匈奴必破，時不可再得也。"
  },
  {
    "id": "s0336",
    "blockIndex": 0,
    "zh": "』又曰：『北伐行將，於鬴山必克。"
  },
  {
    "id": "s0337",
    "blockIndex": 0,
    "zh": "卦，諸將貳師最吉。"
  },
  {
    "id": "s0338",
    "blockIndex": 0,
    "zh": "』故朕親發貳師下鬴山，詔之必毋深入。"
  },
  {
    "id": "s0339",
    "blockIndex": 0,
    "zh": "今計謀、卦兆皆反繆。"
  },
  {
    "id": "s0340",
    "blockIndex": 0,
    "zh": "重合侯得虜候者，乃言『縛馬者匈奴詛軍事也。"
  },
  {
    "id": "s0341",
    "blockIndex": 0,
    "zh": "』匈奴常言『漢極大，然不耐飢渴，失一狼，走千羊。"
  },
  {
    "id": "s0342",
    "blockIndex": 0,
    "zh": "』乃者貳師敗，軍士死略離散，悲痛常在朕心。"
  },
  {
    "id": "s0343",
    "blockIndex": 0,
    "zh": "今又請遠田輪台，欲起亭隧，是擾勞天下，非所以優民也，朕不忍聞！"
  },
  {
    "id": "s0344",
    "blockIndex": 0,
    "zh": "大鴻臚等又議欲募囚徒送匈奴使者，明封侯之賞以報忿，此五伯所弗為也。"
  },
  {
    "id": "s0345",
    "blockIndex": 0,
    "zh": "且匈奴得漢降者常提掖搜索，問以所聞，豈得行其計乎！"
  },
  {
    "id": "s0346",
    "blockIndex": 0,
    "zh": "當今務在禁苛暴，止擅賦，力本農，修馬復令，以補缺、毋乏武備而已。"
  },
  {
    "id": "s0347",
    "blockIndex": 0,
    "zh": "郡國二千石各上進畜馬方略補邊狀，與計對。"
  },
  {
    "id": "s0348",
    "blockIndex": 0,
    "zh": "」 由是不復出軍，而封田千秋為富民侯，以明休息，思富養民也。"
  },
  {
    "id": "s0349",
    "blockIndex": 0,
    "zh": "又以趙過為搜粟都尉。"
  },
  {
    "id": "s0350",
    "blockIndex": 0,
    "zh": "過能為代田，其耕耘田器皆有便巧，以教民，用力少而得穀多，民皆便之。"
  },
  {
    "id": "s0351",
    "blockIndex": 0,
    "zh": ":臣光曰：天下信未嘗無士也！"
  },
  {
    "id": "s0352",
    "blockIndex": 0,
    "zh": "武帝好四夷之功，而勇銳輕死之士充滿朝廷，闢土廣地，無不如意。"
  },
  {
    "id": "s0353",
    "blockIndex": 0,
    "zh": "及後息民重農，而趙過之儔教民耕耘，民亦被其利。"
  },
  {
    "id": "s0354",
    "blockIndex": 0,
    "zh": "此一君之身趣好殊別，而士輒應之，誠使武帝兼三王之量以興商、周之治，其無三代之臣乎！"
  },
  {
    "id": "s0355",
    "blockIndex": 0,
    "zh": "---- 5 秋，八月，辛酉晦，日有食之。"
  },
  {
    "id": "s0356",
    "blockIndex": 0,
    "zh": "---- 6 衛律害貳師之寵，會匈奴單于母閼氏病，律飭胡巫言：「先單于怒曰：『胡故時祠兵，常言得貳師以社，何故不用？"
  },
  {
    "id": "s0357",
    "blockIndex": 0,
    "zh": "』」於是收貳師。"
  },
  {
    "id": "s0358",
    "blockIndex": 0,
    "zh": "貳師罵曰：「我死必滅匈奴！"
  },
  {
    "id": "s0359",
    "blockIndex": 0,
    "zh": "」遂屠貳師以祠。"
  },
  {
    "id": "s0360",
    "blockIndex": 0,
    "zh": "---- 後元元年（癸巳，公元前八八年） 1 春，正月，上行幸甘泉，郊泰畤；"
  },
  {
    "id": "s0361",
    "blockIndex": 0,
    "zh": "遂幸安定。"
  },
  {
    "id": "s0362",
    "blockIndex": 0,
    "zh": "---- 2 昌邑哀王髆薨。"
  },
  {
    "id": "s0363",
    "blockIndex": 0,
    "zh": "---- 3 二月，赦天下。"
  },
  {
    "id": "s0364",
    "blockIndex": 0,
    "zh": "---- 4 夏，六月，商丘成坐祝詛自殺。"
  },
  {
    "id": "s0365",
    "blockIndex": 0,
    "zh": "---- 5 初，侍中僕射馬何羅與江充相善。"
  },
  {
    "id": "s0366",
    "blockIndex": 0,
    "zh": "及衛太子起兵，何羅弟通以力戰封重合侯。"
  },
  {
    "id": "s0367",
    "blockIndex": 0,
    "zh": "後上夷滅充宗族、黨與，何羅兄弟懼及，遂謀為逆。"
  },
  {
    "id": "s0368",
    "blockIndex": 0,
    "zh": "侍中駙馬都尉金日磾視其志意有非常，心疑之，陰獨察其動靜，與俱上下。"
  },
  {
    "id": "s0369",
    "blockIndex": 0,
    "zh": "何羅亦覺日磾意，以故久不得發。"
  },
  {
    "id": "s0370",
    "blockIndex": 0,
    "zh": "是時上行幸林光宮，日磾小疾臥廬，何羅與通及小弟安成矯制夜出，共殺使者，發兵。"
  },
  {
    "id": "s0371",
    "blockIndex": 0,
    "zh": "明旦，上未起，何羅無何從外入。"
  },
  {
    "id": "s0372",
    "blockIndex": 0,
    "zh": "日磾奏廁，心動，立入，坐內戶下。"
  },
  {
    "id": "s0373",
    "blockIndex": 0,
    "zh": "須臾，何羅袖白刃從東廂上，見日磾，色變；"
  },
  {
    "id": "s0374",
    "blockIndex": 0,
    "zh": "走趨臥內，欲入，行觸寶瑟，僵。"
  },
  {
    "id": "s0375",
    "blockIndex": 0,
    "zh": "日磾得抱何羅，因傳曰：「馬何羅反！"
  },
  {
    "id": "s0376",
    "blockIndex": 0,
    "zh": "」上驚起。"
  },
  {
    "id": "s0377",
    "blockIndex": 0,
    "zh": "左右拔刃欲格之，上恐並中日磾，止勿格。"
  },
  {
    "id": "s0378",
    "blockIndex": 0,
    "zh": "日磾投何羅殿下，得禽縛之。"
  },
  {
    "id": "s0379",
    "blockIndex": 0,
    "zh": "窮治，皆伏辜。"
  },
  {
    "id": "s0380",
    "blockIndex": 0,
    "zh": "---- 6 秋，七月，地震。"
  },
  {
    "id": "s0381",
    "blockIndex": 0,
    "zh": "---- 7 燕王旦自以次第當為太子，上書求入宿衛。"
  },
  {
    "id": "s0382",
    "blockIndex": 0,
    "zh": "上怒，斬其使於北闕；"
  },
  {
    "id": "s0383",
    "blockIndex": 0,
    "zh": "又坐藏匿亡命，削良鄉、安次、文安三縣。"
  },
  {
    "id": "s0384",
    "blockIndex": 0,
    "zh": "上由是惡旦。"
  },
  {
    "id": "s0385",
    "blockIndex": 0,
    "zh": "旦辯慧博學，其弟廣陵王胥，有勇力，而皆動作無法度，多過失，故上皆不立。"
  },
  {
    "id": "s0386",
    "blockIndex": 0,
    "zh": "時鉤弋夫人之子弗陵，年數歲，形體壯大，多知，上奇愛之，心欲立焉；"
  },
  {
    "id": "s0387",
    "blockIndex": 0,
    "zh": "以其年稚，母少，猶與久之。"
  },
  {
    "id": "s0388",
    "blockIndex": 0,
    "zh": "欲以大臣輔之，察群臣，唯奉車都尉、光祿大夫霍光，忠厚可任大事，上乃使黃門畫周公負成王朝諸侯以賜光。"
  },
  {
    "id": "s0389",
    "blockIndex": 0,
    "zh": "後數日，帝譴責鉤弋夫人。"
  },
  {
    "id": "s0390",
    "blockIndex": 0,
    "zh": "夫人脫簪珥，叩頭。"
  },
  {
    "id": "s0391",
    "blockIndex": 0,
    "zh": "帝曰：「引持去，送掖庭獄！"
  },
  {
    "id": "s0392",
    "blockIndex": 0,
    "zh": "」夫人還顧，帝曰：「趣行，汝不得活！"
  },
  {
    "id": "s0393",
    "blockIndex": 0,
    "zh": "」卒賜死。"
  },
  {
    "id": "s0394",
    "blockIndex": 0,
    "zh": "頃之，帝閒居，問左右曰：「外人言雲何？"
  },
  {
    "id": "s0395",
    "blockIndex": 0,
    "zh": "」左右對曰：「人言『且立其子，何去其母乎？"
  },
  {
    "id": "s0396",
    "blockIndex": 0,
    "zh": "』」帝曰：「然，是非兒曹愚人之所知也。"
  },
  {
    "id": "s0397",
    "blockIndex": 0,
    "zh": "往古國家所以亂，由主少、母壯也。"
  },
  {
    "id": "s0398",
    "blockIndex": 0,
    "zh": "女主獨居驕蹇，淫亂自恣，莫能禁也。"
  },
  {
    "id": "s0399",
    "blockIndex": 0,
    "zh": "汝不聞呂后邪！"
  },
  {
    "id": "s0400",
    "blockIndex": 0,
    "zh": "故不得不先去之也。"
  },
  {
    "id": "s0401",
    "blockIndex": 0,
    "zh": "」 ---- 後元二年（甲午，公元前八七年） 1 春，正月，上朝諸侯王於甘泉宮。"
  },
  {
    "id": "s0402",
    "blockIndex": 0,
    "zh": "二月，行幸盩厔五柞宮。"
  },
  {
    "id": "s0403",
    "blockIndex": 0,
    "zh": "---- 2 上病篤，霍光涕泣問曰：「如有不諱，誰當嗣者？"
  },
  {
    "id": "s0404",
    "blockIndex": 0,
    "zh": "」上曰：「君未諭前畫意邪？"
  },
  {
    "id": "s0405",
    "blockIndex": 0,
    "zh": "立少子，君行周公之事。"
  },
  {
    "id": "s0406",
    "blockIndex": 0,
    "zh": "」光頓首讓曰：「臣不如金日磾！"
  },
  {
    "id": "s0407",
    "blockIndex": 0,
    "zh": "」日磾亦曰：「臣，外國人，不如光；"
  },
  {
    "id": "s0408",
    "blockIndex": 0,
    "zh": "且使匈奴輕漢矣！"
  },
  {
    "id": "s0409",
    "blockIndex": 0,
    "zh": "」乙丑，詔立弗陵為皇太子，時年八歲。"
  },
  {
    "id": "s0410",
    "blockIndex": 0,
    "zh": "丙寅，以光為大司馬、大將軍，日磾為車騎將軍，太僕上官桀為左將軍，受遺詔輔少主，又以搜粟都尉桑弘羊為御史大夫，皆拜臥內床下。"
  },
  {
    "id": "s0411",
    "blockIndex": 0,
    "zh": "光出入禁闥二十餘年，出則奉車，入侍左右，小心謹慎，未嘗有過。"
  },
  {
    "id": "s0412",
    "blockIndex": 0,
    "zh": "為人沈靜詳審，每出入、下殿門，止進有常處，郎、僕射竊識視之，不失尺寸。"
  },
  {
    "id": "s0413",
    "blockIndex": 0,
    "zh": "日磾在上左右，目不忤視者數十年；"
  },
  {
    "id": "s0414",
    "blockIndex": 0,
    "zh": "賜出宮女，不敢近；"
  },
  {
    "id": "s0415",
    "blockIndex": 0,
    "zh": "上欲內其女後宮，不肯；"
  },
  {
    "id": "s0416",
    "blockIndex": 0,
    "zh": "其篤慎如此，上尤奇異之。"
  },
  {
    "id": "s0417",
    "blockIndex": 0,
    "zh": "日磾長子為帝弄兒，帝甚愛之，其後弄兒壯大，不謹，自殿下與宮人戲；"
  },
  {
    "id": "s0418",
    "blockIndex": 0,
    "zh": "日磾適見之，惡其淫亂，遂殺弄兒。"
  },
  {
    "id": "s0419",
    "blockIndex": 0,
    "zh": "上聞之，大怒，日磾頓首謝，具言所以殺弄兒狀。"
  },
  {
    "id": "s0420",
    "blockIndex": 0,
    "zh": "上甚哀，為之泣；"
  },
  {
    "id": "s0421",
    "blockIndex": 0,
    "zh": "已而心敬日磾。"
  },
  {
    "id": "s0422",
    "blockIndex": 0,
    "zh": "上官桀始以材力得幸，為未央廄令；"
  },
  {
    "id": "s0423",
    "blockIndex": 0,
    "zh": "上嘗體不安，及愈，見馬，馬多瘦，上大怒曰：「令以我不復見馬邪！"
  },
  {
    "id": "s0424",
    "blockIndex": 0,
    "zh": "」欲下吏。"
  },
  {
    "id": "s0425",
    "blockIndex": 0,
    "zh": "桀頓首曰：「臣聞聖體不安，日夜憂懼，意誠不在馬。"
  },
  {
    "id": "s0426",
    "blockIndex": 0,
    "zh": "」言未卒，泣數行下。"
  },
  {
    "id": "s0427",
    "blockIndex": 0,
    "zh": "上以為愛己，由是親近，為侍中，稍遷至太僕。"
  },
  {
    "id": "s0428",
    "blockIndex": 0,
    "zh": "三人皆上素所愛信者，故特舉之，授以後事。"
  },
  {
    "id": "s0429",
    "blockIndex": 0,
    "zh": "丁卯，帝崩於五柞宮；"
  },
  {
    "id": "s0430",
    "blockIndex": 0,
    "zh": "入殯未央宮前殿。"
  },
  {
    "id": "s0431",
    "blockIndex": 0,
    "zh": "帝聰明能斷，善用人，行法無所假貸。"
  },
  {
    "id": "s0432",
    "blockIndex": 0,
    "zh": "隆慮公主子昭平君尚帝女夷安公主。"
  },
  {
    "id": "s0433",
    "blockIndex": 0,
    "zh": "隆慮主病困，以金千斤、錢千萬為昭平君豫贖死罪，上許之。"
  },
  {
    "id": "s0434",
    "blockIndex": 0,
    "zh": "隆慮主卒，昭平君日驕，醉殺主傅，繫獄；"
  },
  {
    "id": "s0435",
    "blockIndex": 0,
    "zh": "廷尉以公主子上請。"
  },
  {
    "id": "s0436",
    "blockIndex": 0,
    "zh": "左右人人為言：「前又入贖，陛下許之。"
  },
  {
    "id": "s0437",
    "blockIndex": 0,
    "zh": "」上曰：「吾弟老有是一子，死，以屬我。"
  },
  {
    "id": "s0438",
    "blockIndex": 0,
    "zh": "」於是為之垂涕，歎息良久，曰：「法令者，先帝所造也，用弟故而誣先帝之法，吾何面目入高廟乎！"
  },
  {
    "id": "s0439",
    "blockIndex": 0,
    "zh": "又下負萬民。"
  },
  {
    "id": "s0440",
    "blockIndex": 0,
    "zh": "」乃可其奏，哀不能自止，左右盡悲，待詔東方朔前上壽，曰：「臣聞聖王為政，賞不避仇讎，誅不擇骨肉。"
  },
  {
    "id": "s0441",
    "blockIndex": 0,
    "zh": "《書》曰：『不偏不黨，王道蕩蕩。"
  },
  {
    "id": "s0442",
    "blockIndex": 0,
    "zh": "』此二者，五帝所重，三王所難也，陛下行之，天下幸甚！"
  },
  {
    "id": "s0443",
    "blockIndex": 0,
    "zh": "臣朔奉觴昧死再拜上萬歲壽！"
  },
  {
    "id": "s0444",
    "blockIndex": 0,
    "zh": "」上初怒朔，既而善之，以朔為中郎。"
  },
  {
    "id": "s0445",
    "blockIndex": 0,
    "zh": ":班固贊曰：漢承百王之弊，高祖撥亂反正，文、景務在養民，至於稽古禮文之事，猶多闕焉。"
  },
  {
    "id": "s0446",
    "blockIndex": 0,
    "zh": "孝武初立，卓然罷黜百家，表章《六經》，遂疇咨海內，舉其俊茂，與之立功；"
  },
  {
    "id": "s0447",
    "blockIndex": 0,
    "zh": "興太學，修郊祀，改正朔，定歷數，協音律，作詩樂，建封禪，禮百神，紹周後，號令文章，煥焉可述，後嗣得遵洪業而有三代之風。"
  },
  {
    "id": "s0448",
    "blockIndex": 0,
    "zh": "如武帝之雄材大略，不改文、景之恭儉以濟斯民，雖《詩》、《書》所稱何有加焉！"
  },
  {
    "id": "s0449",
    "blockIndex": 0,
    "zh": ":臣光曰：孝武窮奢極欲，繁刑重斂，內侈宮室，外事四夷，信惑神怪，巡遊無度，使百姓疲敝，起為盜賊，其所以異於秦始皇者無幾矣。"
  },
  {
    "id": "s0450",
    "blockIndex": 0,
    "zh": "然秦以之亡，漢以之興者，孝武能尊先王之道，知所統守，受忠直之言，惡人欺蔽，好賢不倦，誅賞嚴明，晚而改過，顧托得人，此其所以有亡秦之失而免亡秦之禍乎！"
  },
  {
    "id": "s0451",
    "blockIndex": 0,
    "zh": "---- 3 戊辰，太子即皇帝位。"
  },
  {
    "id": "s0452",
    "blockIndex": 0,
    "zh": "帝姊鄂邑公主共養省中，霍光、金日磾、上官桀共領尚書事。"
  },
  {
    "id": "s0453",
    "blockIndex": 0,
    "zh": "光輔幼主，政自己出，天下想聞其風采。"
  },
  {
    "id": "s0454",
    "blockIndex": 0,
    "zh": "殿中嘗有怪，一夜，群臣相驚，光召尚符璽郎，欲收取璽。"
  },
  {
    "id": "s0455",
    "blockIndex": 0,
    "zh": "郎不肯授，光欲奪之。"
  },
  {
    "id": "s0456",
    "blockIndex": 0,
    "zh": "郎按劍曰：「臣頭可得，璽不可得也！"
  },
  {
    "id": "s0457",
    "blockIndex": 0,
    "zh": "」光甚誼之。"
  },
  {
    "id": "s0458",
    "blockIndex": 0,
    "zh": "明日，詔增此郎秩二等。"
  },
  {
    "id": "s0459",
    "blockIndex": 0,
    "zh": "眾庶莫不多光。"
  },
  {
    "id": "s0460",
    "blockIndex": 0,
    "zh": "---- 4 三月，甲辰，葬孝武皇帝於茂陵。"
  },
  {
    "id": "s0461",
    "blockIndex": 0,
    "zh": "---- 5 夏，六月，赦天下。"
  },
  {
    "id": "s0462",
    "blockIndex": 0,
    "zh": "---- 6 秋，七月，有星孛於東方。"
  },
  {
    "id": "s0463",
    "blockIndex": 0,
    "zh": "---- 7 濟北王寬坐禽獸行自殺。"
  },
  {
    "id": "s0464",
    "blockIndex": 0,
    "zh": "---- 8 冬，匈奴入朔方，殺略吏民；"
  },
  {
    "id": "s0465",
    "blockIndex": 0,
    "zh": "發軍屯西河，左將軍桀行北邊。"
  },
  {
    "id": "s0466",
    "blockIndex": 0,
    "zh": "---- category:資治通鑑"
  }
]
