[
  {
    "id": "s0001",
    "blockIndex": 0,
    "zh": "資治通鑑第032卷"
  },
  {
    "id": "s0002",
    "blockIndex": 1,
    "zh": "【漢紀二十四】起著雍涒灘，盡昭陽赤奮若，凡六年。"
  },
  {
    "id": "s0003",
    "blockIndex": 2,
    "zh": "春，正月，上行幸甘泉，郊泰畤；"
  },
  {
    "id": "s0004",
    "blockIndex": 2,
    "zh": "大赦天下，三月，行幸河東，祠后土。"
  },
  {
    "id": "s0005",
    "blockIndex": 3,
    "zh": "夏，大旱。"
  },
  {
    "id": "s0006",
    "blockIndex": 4,
    "zh": "四月，癸未，長樂臨華殿、未央宮東司馬門皆災。"
  },
  {
    "id": "s0007",
    "blockIndex": 4,
    "zh": "六月，甲午，霸陵園門闕災。"
  },
  {
    "id": "s0008",
    "blockIndex": 5,
    "zh": "秋，七月，辛未晦，日有食之。"
  },
  {
    "id": "s0009",
    "blockIndex": 6,
    "zh": "冬，十一月，庚申，衛將軍王商病免。"
  },
  {
    "id": "s0010",
    "blockIndex": 7,
    "zh": "梁王立驕恣無度，至一日十一犯法。"
  },
  {
    "id": "s0011",
    "blockIndex": 7,
    "zh": "相禹奏「立對外家怨望，有惡言。"
  },
  {
    "id": "s0012",
    "blockIndex": 7,
    "zh": "」有司案驗，因發其與姑園子奸事，奏「立禽獸行，請誅。"
  },
  {
    "id": "s0013",
    "blockIndex": 7,
    "zh": "」太中大夫谷永上書曰：「臣聞禮，天子外屏，不欲見外也。"
  },
  {
    "id": "s0014",
    "blockIndex": 7,
    "zh": "是故帝王之意，不窺人閨門之私，聽聞中冓之言。"
  },
  {
    "id": "s0015",
    "blockIndex": 7,
    "zh": "《春秋》為親者諱。"
  },
  {
    "id": "s0016",
    "blockIndex": 7,
    "zh": "今梁王年少，頗有狂病，始以惡言按驗，既無事實，而發閨門之私，非本章所指。"
  },
  {
    "id": "s0017",
    "blockIndex": 7,
    "zh": "王辭又不服，猥強劾立，傅致難明之事，獨以偏辭成罪斷獄，無益於治道。"
  },
  {
    "id": "s0018",
    "blockIndex": 7,
    "zh": "污蔑宗室以內亂之惡，披布宣揚於天下，非所以為公族隱諱，增朝廷之榮華，昭聖德之風化也。"
  },
  {
    "id": "s0019",
    "blockIndex": 7,
    "zh": "臣愚以為王少而父同產長，年齒不倫；"
  },
  {
    "id": "s0020",
    "blockIndex": 7,
    "zh": "梁國之富足以厚聘美女，招致妖麗；"
  },
  {
    "id": "s0021",
    "blockIndex": 7,
    "zh": "父同產亦有恥辱之心。"
  },
  {
    "id": "s0022",
    "blockIndex": 7,
    "zh": "案事者乃驗問惡言，何故猥自發舒！"
  },
  {
    "id": "s0023",
    "blockIndex": 7,
    "zh": "以三者揆之，殆非人情，疑有所迫切，過誤失言，文吏躡尋，不得轉移。"
  },
  {
    "id": "s0024",
    "blockIndex": 7,
    "zh": "萌牙之時，加恩勿治，上也。"
  },
  {
    "id": "s0025",
    "blockIndex": 7,
    "zh": "既已案驗舉憲，宜及王辭不服，詔廷尉選上德通理之吏更審考清問，著不然之效，定失誤之法，而反命於下吏，以廣公族附疏之德，為宗室刷污亂之恥，甚得治親之誼。"
  },
  {
    "id": "s0026",
    "blockIndex": 7,
    "zh": "」天子由是寢而不治。"
  },
  {
    "id": "s0027",
    "blockIndex": 8,
    "zh": "是歲，司隸校尉蜀郡何武為京兆尹。"
  },
  {
    "id": "s0028",
    "blockIndex": 8,
    "zh": "武為吏，守法盡公，進善退惡，其所居無赫赫名，去後常見思。"
  },
  {
    "id": "s0029",
    "blockIndex": 9,
    "zh": "春，正月，己亥朔，日有食之。"
  },
  {
    "id": "s0030",
    "blockIndex": 10,
    "zh": "壬戌，王商復為大司馬、衛將軍。"
  },
  {
    "id": "s0031",
    "blockIndex": 11,
    "zh": "三月，上行幸雍，祠五畤。"
  },
  {
    "id": "s0032",
    "blockIndex": 12,
    "zh": "夏，四月，丁酉，無雲而雷，有流星從日下東南行，四面燿燿如雨，自晡及昏而止。"
  },
  {
    "id": "s0033",
    "blockIndex": 13,
    "zh": "赦天下。"
  },
  {
    "id": "s0034",
    "blockIndex": 14,
    "zh": "秋，七月，有星孛於東井。"
  },
  {
    "id": "s0035",
    "blockIndex": 15,
    "zh": "上以災變，博謀群臣。"
  },
  {
    "id": "s0036",
    "blockIndex": 15,
    "zh": "北地太守谷永對曰：「王者躬行道德，承順天地，則五征時序，百姓壽考，符瑞並降；"
  },
  {
    "id": "s0037",
    "blockIndex": 15,
    "zh": "失道妄行，逆天暴物，則咎徵著郵，妖孽並見，饑饉荐臻；"
  },
  {
    "id": "s0038",
    "blockIndex": 15,
    "zh": "終不改寤，惡洽變備，不復譴告，更命有德。"
  },
  {
    "id": "s0039",
    "blockIndex": 15,
    "zh": "此天地之常經，百王之所同也。"
  },
  {
    "id": "s0040",
    "blockIndex": 15,
    "zh": "加以功德有厚薄，期質有修短，時世有中季，天道有盛衰。"
  },
  {
    "id": "s0041",
    "blockIndex": 15,
    "zh": "陛下承八世之功業，當陽數之標季，涉三七之節紀，遭《無妄》之卦運，直百六之災厄，三難異科，雜焉同會。"
  },
  {
    "id": "s0042",
    "blockIndex": 15,
    "zh": "建始元年以來，二十載間，群災大異，交錯鋒起，多於《春秋》所書。"
  },
  {
    "id": "s0043",
    "blockIndex": 15,
    "zh": "內則為深宮後庭，將有驕臣悍妾、醉酒狂悖卒起之敗，北宮苑囿街巷之中、臣妾之家幽閒之處征舒、崔杼之亂；"
  },
  {
    "id": "s0044",
    "blockIndex": 15,
    "zh": "外則為諸夏下土，將有樊並、蘇令、陳勝、項梁奮臂之禍。"
  },
  {
    "id": "s0045",
    "blockIndex": 15,
    "zh": "安危之分界，宗廟之至憂，臣永所以破膽寒心，豫言之累年。"
  },
  {
    "id": "s0046",
    "blockIndex": 15,
    "zh": "下有其萌，然後變見於上，可不致慎！"
  },
  {
    "id": "s0047",
    "blockIndex": 15,
    "zh": "禍起細微，奸生所易。"
  },
  {
    "id": "s0048",
    "blockIndex": 15,
    "zh": "願陛下正君臣之義，無復與群小□葉黷燕飲；"
  },
  {
    "id": "s0049",
    "blockIndex": 15,
    "zh": "勤三綱之嚴，修後宮之政，抑遠驕妒之寵，崇近婉順之行；"
  },
  {
    "id": "s0050",
    "blockIndex": 15,
    "zh": "朝覲法駕而後出，陳兵清道而後行，無復輕身獨出，飲食臣妾之家。"
  },
  {
    "id": "s0051",
    "blockIndex": 15,
    "zh": "三者既除，內亂之路塞矣。"
  },
  {
    "id": "s0052",
    "blockIndex": 15,
    "zh": "諸夏舉兵，萌在民饑饉而吏不恤，興於百姓困而賦斂重，發於下怨離而上不知。"
  },
  {
    "id": "s0053",
    "blockIndex": 15,
    "zh": "《傳》曰：『饑而不損，茲謂泰，厥咎亡。"
  },
  {
    "id": "s0054",
    "blockIndex": 15,
    "zh": "』比年郡國傷於水災，禾麥不收，宜損常稅之時，而有司奏請加賦，甚繆經義，逆於民心，市怨趨禍之道也。"
  },
  {
    "id": "s0055",
    "blockIndex": 15,
    "zh": "臣願陛下勿許加賦之奏，益減奢泰之費，流恩廣施，振贍困乏，敕勸耕桑，以慰綏元元之心，諸夏之亂庶幾可息。"
  },
  {
    "id": "s0057",
    "blockIndex": 16,
    "zh": "中壘校尉劉向上書曰：「臣聞帝舜戒伯禹『毋若丹朱敖』，周公戒成王『毋若殷王紂』，聖帝明王常以敗亂自戒，不諱廢興，故臣敢極陳其愚，唯陛下留神察焉！"
  },
  {
    "id": "s0058",
    "blockIndex": 16,
    "zh": "謹案《春秋》二百四十二年，日食三十六，今連三年比食，自建始以來，二十歲間而八食，率二歲六月而一發，古今罕有。"
  },
  {
    "id": "s0059",
    "blockIndex": 16,
    "zh": "異有小大希稠，佔有舒疾緩急。"
  },
  {
    "id": "s0060",
    "blockIndex": 16,
    "zh": "觀秦、漢之易世，覽惠、昭之無後，察昌邑之不終，視孝宣之紹起，皆有變異著於漢紀。"
  },
  {
    "id": "s0061",
    "blockIndex": 16,
    "zh": "天之去就，豈不昭昭然哉！"
  },
  {
    "id": "s0062",
    "blockIndex": 16,
    "zh": "臣幸得托末屬，誠見陛下寬明之德，冀銷大異而興高宗、成王之聲，以崇劉氏，故懇懇數奸死亡之誅！"
  },
  {
    "id": "s0063",
    "blockIndex": 16,
    "zh": "天文難以相曉，臣雖圖上，猶須口說，然後可知；"
  },
  {
    "id": "s0064",
    "blockIndex": 16,
    "zh": "願賜清燕之閒，指圖陳狀。"
  },
  {
    "id": "s0065",
    "blockIndex": 16,
    "zh": "」上輒入之，然終不能用也。"
  },
  {
    "id": "s0066",
    "blockIndex": 17,
    "zh": "紅陽侯立舉陳鹹方正，對策，拜為光祿大夫、給事中。"
  },
  {
    "id": "s0067",
    "blockIndex": 17,
    "zh": "丞相方進復奏「鹹前為九卿，坐為貪邪免，不當蒙方正舉，備內朝臣」；"
  },
  {
    "id": "s0068",
    "blockIndex": 17,
    "zh": "並劾「紅陽侯立選舉故不以實。"
  },
  {
    "id": "s0069",
    "blockIndex": 17,
    "zh": "」有詔免鹹，勿劾立。"
  },
  {
    "id": "s0070",
    "blockIndex": 18,
    "zh": "十二月，乙未，王商為大將軍。"
  },
  {
    "id": "s0071",
    "blockIndex": 18,
    "zh": "辛亥，商薨。"
  },
  {
    "id": "s0072",
    "blockIndex": 18,
    "zh": "其弟紅陽侯立次當輔政，先是立使客因南郡太守李尚占墾草田數百頃，上書以入縣官，貴取其直一萬萬以上，丞相司直孫寶發之，上由是廢立，而用其弟光祿勳曲陽侯根。"
  },
  {
    "id": "s0073",
    "blockIndex": 18,
    "zh": "庚申，以根為大司馬、驃騎將軍。"
  },
  {
    "id": "s0074",
    "blockIndex": 19,
    "zh": "特進、安昌侯張禹請平陵肥牛亭地；"
  },
  {
    "id": "s0075",
    "blockIndex": 19,
    "zh": "曲陽侯根爭，以為此地當平陵寢廟，衣冠所出遊道，宜更賜禹它地。"
  },
  {
    "id": "s0076",
    "blockIndex": 19,
    "zh": "上不從，卒以賜禹。"
  },
  {
    "id": "s0077",
    "blockIndex": 19,
    "zh": "根由是害禹寵，數毀惡之。"
  },
  {
    "id": "s0078",
    "blockIndex": 19,
    "zh": "天子愈益敬厚禹，每病，輒以起居聞，車駕自臨問之。"
  },
  {
    "id": "s0079",
    "blockIndex": 19,
    "zh": "上親拜禹床下，禹頓首謝恩。"
  },
  {
    "id": "s0080",
    "blockIndex": 19,
    "zh": "禹小子未有官，禹數視其小子，上即禹床下拜為黃門郎、給事中。"
  },
  {
    "id": "s0081",
    "blockIndex": 19,
    "zh": "禹雖家居，以特進為天子師，國家每有大政，必與定議。"
  },
  {
    "id": "s0082",
    "blockIndex": 19,
    "zh": "時吏民多上書言災異之應，譏切王氏專政所致，上意頗然之，未有以明見，乃車駕至禹弟，辟左右，親問禹以天變，因用吏民所言王氏事示禹。"
  },
  {
    "id": "s0083",
    "blockIndex": 19,
    "zh": "禹自見年老，子孫弱，又與曲陽侯不平，恐為所怨，則謂上曰：「《春秋》日食、地震，或為諸侯相殺，夷狄侵中國。"
  },
  {
    "id": "s0084",
    "blockIndex": 19,
    "zh": "災變之意，深遠難見，故聖人罕言命，不語怪神，性與天道，自子貢之屬不得聞，何況淺見鄙儒之所言。"
  },
  {
    "id": "s0085",
    "blockIndex": 19,
    "zh": "陛下宜修政事，以善應之，與下同其福喜，此經義意也。"
  },
  {
    "id": "s0086",
    "blockIndex": 19,
    "zh": "新學小生，亂道誤人，宜無信用，以經術斷之。"
  },
  {
    "id": "s0087",
    "blockIndex": 19,
    "zh": "」上雅信愛禹，由此不疑王氏。"
  },
  {
    "id": "s0088",
    "blockIndex": 19,
    "zh": "後曲陽侯根及諸王子弟聞知禹言，皆喜說，遂親就禹。"
  },
  {
    "id": "s0089",
    "blockIndex": 19,
    "zh": "故槐裡令朱雲上書求見，公卿在前，雲曰：「今朝廷大臣，上不能匡主，下無以益民，皆尸位素餐，孔子所謂『鄙夫不可與事君，苟患失之，亡所不至』者也！"
  },
  {
    "id": "s0090",
    "blockIndex": 19,
    "zh": "臣願賜尚方斬馬劍，斷佞臣一人頭以厲其餘！"
  },
  {
    "id": "s0091",
    "blockIndex": 19,
    "zh": "」上問：「誰也？"
  },
  {
    "id": "s0092",
    "blockIndex": 19,
    "zh": "」對曰：「安昌侯張禹！"
  },
  {
    "id": "s0093",
    "blockIndex": 19,
    "zh": "」上大怒曰：「小臣居下訕上，廷辱師傅，罪死不赦！"
  },
  {
    "id": "s0094",
    "blockIndex": 19,
    "zh": "」御史將雲下，雲攀殿檻，檻折。"
  },
  {
    "id": "s0095",
    "blockIndex": 19,
    "zh": "雲呼曰：「臣得下從龍逄、比干游於地下，足矣！"
  },
  {
    "id": "s0096",
    "blockIndex": 19,
    "zh": "未知聖朝何如耳！"
  },
  {
    "id": "s0097",
    "blockIndex": 19,
    "zh": "」御史遂將雲去。"
  },
  {
    "id": "s0098",
    "blockIndex": 19,
    "zh": "於是左將軍辛慶忌免冠，解印綬，叩頭殿下曰：「此臣素著狂直於世，使其言是，一可誅；"
  },
  {
    "id": "s0099",
    "blockIndex": 19,
    "zh": "其言非，因當容之。"
  },
  {
    "id": "s0100",
    "blockIndex": 19,
    "zh": "臣敢以死爭！"
  },
  {
    "id": "s0101",
    "blockIndex": 19,
    "zh": "」慶忌叩頭流血，上意解，然後得已。"
  },
  {
    "id": "s0102",
    "blockIndex": 19,
    "zh": "及後當治檻，上曰：「勿易，因而輯之，以旌直臣！"
  },
  {
    "id": "s0104",
    "blockIndex": 20,
    "zh": "匈奴搜諧單于將入朝；"
  },
  {
    "id": "s0105",
    "blockIndex": 20,
    "zh": "未入塞，病死。"
  },
  {
    "id": "s0106",
    "blockIndex": 20,
    "zh": "弟且莫車立，為車牙若鞮單于；"
  },
  {
    "id": "s0107",
    "blockIndex": 20,
    "zh": "以囊知牙斯為左賢王。"
  },
  {
    "id": "s0108",
    "blockIndex": 21,
    "zh": "北地都尉張放到官數月，復征入侍中。"
  },
  {
    "id": "s0109",
    "blockIndex": 21,
    "zh": "太后與上書曰：「前所道尚未效，富平侯反覆來，其能默虖！"
  },
  {
    "id": "s0110",
    "blockIndex": 21,
    "zh": "」上謝曰：「請今奉詔！"
  },
  {
    "id": "s0111",
    "blockIndex": 21,
    "zh": "」上於是出放為天水屬國都尉。"
  },
  {
    "id": "s0112",
    "blockIndex": 21,
    "zh": "引少府許商、光祿勳師丹為光祿大夫，班伯為水衡都尉，並侍中，皆秩中二千石，每朝東宮，常從；"
  },
  {
    "id": "s0113",
    "blockIndex": 21,
    "zh": "及大政，俱使諭指於公卿。"
  },
  {
    "id": "s0114",
    "blockIndex": 21,
    "zh": "上亦稍厭游宴，復修經書之業；"
  },
  {
    "id": "s0115",
    "blockIndex": 21,
    "zh": "太后甚悅。"
  },
  {
    "id": "s0116",
    "blockIndex": 22,
    "zh": "是歲，左將軍辛慶忌卒。"
  },
  {
    "id": "s0117",
    "blockIndex": 22,
    "zh": "慶忌為國虎臣，遭世承平，匈奴、西域親附，敬其威信。"
  },
  {
    "id": "s0118",
    "blockIndex": 23,
    "zh": "春，正月，上行幸甘泉，郊泰畤。"
  },
  {
    "id": "s0119",
    "blockIndex": 23,
    "zh": "三月，行幸河東，祠后土。"
  },
  {
    "id": "s0120",
    "blockIndex": 23,
    "zh": "既祭，行遊龍門，登歷觀，陟西嶽而歸。"
  },
  {
    "id": "s0121",
    "blockIndex": 24,
    "zh": "夏，四月，立廣陵孝王子守為王。"
  },
  {
    "id": "s0122",
    "blockIndex": 25,
    "zh": "初，烏孫小昆彌安日為降民所殺，諸翎侯大亂。"
  },
  {
    "id": "s0123",
    "blockIndex": 25,
    "zh": "詔征故金城太守段會宗為左曹、中郎將、光祿大夫，使安輯烏孫；"
  },
  {
    "id": "s0124",
    "blockIndex": 25,
    "zh": "立安日弟末振將為小昆彌，定其國而還。"
  },
  {
    "id": "s0125",
    "blockIndex": 25,
    "zh": "時大昆彌雌栗靡勇健，末振將恐為所並，使貴人烏日領詐降，刺殺雌栗靡。"
  },
  {
    "id": "s0126",
    "blockIndex": 25,
    "zh": "漢欲以兵討之而未能，遣中郎將段會宗立公主孫伊秩靡為大昆彌。"
  },
  {
    "id": "s0127",
    "blockIndex": 25,
    "zh": "久之，大昆彌、翕侯難棲殺末振將，安日子安犁靡代為小昆彌。"
  },
  {
    "id": "s0128",
    "blockIndex": 25,
    "zh": "漢恨不自誅末振將，復遣段會宗發戊己校尉諸國兵，即誅末振將太子番丘。"
  },
  {
    "id": "s0129",
    "blockIndex": 25,
    "zh": "會宗恐大兵入烏孫，驚番丘，亡逃不可得，即留所發兵墊婁地，選精兵三十弩，逕至昆彌所在，召番丘，責以末振將之罪，即手劍擊殺番丘，官屬以下驚恐，馳歸。"
  },
  {
    "id": "s0130",
    "blockIndex": 25,
    "zh": "小昆彌安犁靡勒兵數千騎圍會宗，會宗為言來誅之意，「今圍守殺我，如取漢牛一毛耳。"
  },
  {
    "id": "s0131",
    "blockIndex": 25,
    "zh": "宛王、郅支頭縣槁街，烏孫所知也。"
  },
  {
    "id": "s0132",
    "blockIndex": 25,
    "zh": "」昆彌以下服，曰：「末振將負漢，誅其子可也，獨不可告我，令飲食之邪？"
  },
  {
    "id": "s0133",
    "blockIndex": 25,
    "zh": "」會宗曰：「豫告昆彌，逃匿之，為大罪，即飲食以付我，傷骨肉恩。"
  },
  {
    "id": "s0134",
    "blockIndex": 25,
    "zh": "故不先告。"
  },
  {
    "id": "s0135",
    "blockIndex": 25,
    "zh": "」昆彌以下號泣罷去。"
  },
  {
    "id": "s0136",
    "blockIndex": 25,
    "zh": "會宗還，奏事，天子賜會宗爵關內侯、黃金百斤。"
  },
  {
    "id": "s0137",
    "blockIndex": 25,
    "zh": "會宗以難棲殺末振將，奏以為堅守都尉。"
  },
  {
    "id": "s0138",
    "blockIndex": 25,
    "zh": "責大祿、大監以雌栗靡見殺狀，奪金印、紫綬，更與銅、墨雲。"
  },
  {
    "id": "s0139",
    "blockIndex": 25,
    "zh": "末振將弟卑爰疐本共謀殺大昆彌，將眾八萬餘口北附康居，謀欲借兵兼併兩昆彌；"
  },
  {
    "id": "s0140",
    "blockIndex": 25,
    "zh": "漢復遣會宗與都護孫建並力以備之。"
  },
  {
    "id": "s0141",
    "blockIndex": 26,
    "zh": "自烏孫分立兩昆彌，漢用憂勞，且無寧歲。"
  },
  {
    "id": "s0142",
    "blockIndex": 26,
    "zh": "時康居復遣子侍漢，貢獻，都護郭舜上言；"
  },
  {
    "id": "s0143",
    "blockIndex": 26,
    "zh": "「本匈奴盛時，非以兼有烏孫、康居故也；"
  },
  {
    "id": "s0144",
    "blockIndex": 26,
    "zh": "及其稱臣妾，非以失二國也。"
  },
  {
    "id": "s0145",
    "blockIndex": 26,
    "zh": "漢雖皆受其質子，然三國內相輸遺，交通如故；"
  },
  {
    "id": "s0146",
    "blockIndex": 26,
    "zh": "亦相候司，見便則發。"
  },
  {
    "id": "s0147",
    "blockIndex": 26,
    "zh": "合不能相親信，離不能相臣役。"
  },
  {
    "id": "s0148",
    "blockIndex": 26,
    "zh": "以今言之，結配烏孫，竟未有益，反為中國生事。"
  },
  {
    "id": "s0149",
    "blockIndex": 26,
    "zh": "然烏孫既結在前，今與匈奴俱稱臣，義不可距。"
  },
  {
    "id": "s0150",
    "blockIndex": 26,
    "zh": "而康居驕黠，訖不肯拜使者；"
  },
  {
    "id": "s0151",
    "blockIndex": 26,
    "zh": "都護吏至其國，坐之烏孫諸使下，王及貴人先飲食已，乃飲啖都護吏，故為無所省以誇旁國。"
  },
  {
    "id": "s0152",
    "blockIndex": 26,
    "zh": "以此度之，何故遣子入侍？"
  },
  {
    "id": "s0153",
    "blockIndex": 26,
    "zh": "其欲賈市，為好辭之詐也。"
  },
  {
    "id": "s0154",
    "blockIndex": 26,
    "zh": "匈奴，百蠻大國，今事漢甚備；"
  },
  {
    "id": "s0155",
    "blockIndex": 26,
    "zh": "聞康居不拜，且使單于有悔自卑之意。"
  },
  {
    "id": "s0156",
    "blockIndex": 26,
    "zh": "宜歸其侍子，絕勿復使，以章漢家不通無禮之國！"
  },
  {
    "id": "s0157",
    "blockIndex": 26,
    "zh": "」漢為其新通，重致遠人，終羈縻不絕。"
  },
  {
    "id": "s0158",
    "blockIndex": 27,
    "zh": "春，正月，丙寅，蜀郡岷山崩，壅江三日，江水竭。"
  },
  {
    "id": "s0159",
    "blockIndex": 27,
    "zh": "劉向大惡之，曰：「昔周岐山崩，三川竭，而幽王亡。"
  },
  {
    "id": "s0160",
    "blockIndex": 27,
    "zh": "岐山者，周所興也。"
  },
  {
    "id": "s0161",
    "blockIndex": 27,
    "zh": "漢家本起於蜀、漢，今所起之地，山崩川竭，星孛又及攝提、大角，從參至辰，殆必亡矣！"
  },
  {
    "id": "s0163",
    "blockIndex": 28,
    "zh": "二月，丙午，封淳于長為定陵侯。"
  },
  {
    "id": "s0164",
    "blockIndex": 29,
    "zh": "三月，上行幸雍，祠五畤。"
  },
  {
    "id": "s0165",
    "blockIndex": 30,
    "zh": "上將大誇胡人以多禽獸。"
  },
  {
    "id": "s0166",
    "blockIndex": 30,
    "zh": "秋，命右扶風發民入南山，西自褒、斜，東至弘農，南驅漢中，張羅罔罝罘，捕熊羆禽獸，載以檻車，輸長楊射熊館，以罔為周阹，縱禽獸其中，令胡人手搏之，自取其獲，上親臨觀焉。"
  },
  {
    "id": "s0167",
    "blockIndex": 31,
    "zh": "春，正月，上行幸甘泉，郊泰畤。"
  },
  {
    "id": "s0168",
    "blockIndex": 32,
    "zh": "中山王興，定陶王欣皆來朝，中山王獨從傅，定陶王盡從傅、相、中尉。"
  },
  {
    "id": "s0169",
    "blockIndex": 32,
    "zh": "上怪之，以問定陶王，對曰：「令：諸侯王朝，得從其國二千石。"
  },
  {
    "id": "s0170",
    "blockIndex": 32,
    "zh": "傅、相、中尉，皆國二千石，故盡從之。"
  },
  {
    "id": "s0171",
    "blockIndex": 32,
    "zh": "」上令誦《詩》，通習，能說。"
  },
  {
    "id": "s0172",
    "blockIndex": 32,
    "zh": "佗日，問中山王：「獨從傅在何法令？"
  },
  {
    "id": "s0173",
    "blockIndex": 32,
    "zh": "」不能對；"
  },
  {
    "id": "s0174",
    "blockIndex": 32,
    "zh": "令誦《尚書》，又廢；"
  },
  {
    "id": "s0175",
    "blockIndex": 32,
    "zh": "及賜食於前，後飽；"
  },
  {
    "id": "s0176",
    "blockIndex": 32,
    "zh": "起下，襪系解。"
  },
  {
    "id": "s0177",
    "blockIndex": 32,
    "zh": "帝由此以為不能，而賢定陶王，數稱其材。"
  },
  {
    "id": "s0178",
    "blockIndex": 32,
    "zh": "是時諸侯王唯二人於帝為至親，定陶王祖母傅太后隨王來朝，私賂遺趙皇后、昭儀及票騎將軍王根。"
  },
  {
    "id": "s0179",
    "blockIndex": 32,
    "zh": "后、昭儀、根見上無子，亦欲豫自結，為長久計，皆更稱定陶王，勸帝以為嗣。"
  },
  {
    "id": "s0180",
    "blockIndex": 32,
    "zh": "帝亦自美其材，為加元服而遣之，時年十七矣。"
  },
  {
    "id": "s0181",
    "blockIndex": 33,
    "zh": "三月，上行幸河東，祠后土。"
  },
  {
    "id": "s0182",
    "blockIndex": 34,
    "zh": "隕石於關東二。"
  },
  {
    "id": "s0183",
    "blockIndex": 35,
    "zh": "王根薦谷永，征入，為大司農。"
  },
  {
    "id": "s0184",
    "blockIndex": 35,
    "zh": "永前後所上四十餘事，略相反覆，專攻上身與後宮而已；"
  },
  {
    "id": "s0185",
    "blockIndex": 35,
    "zh": "黨於王氏，上亦知之，不甚親信也。"
  },
  {
    "id": "s0186",
    "blockIndex": 35,
    "zh": "為大司農歲餘，病；"
  },
  {
    "id": "s0187",
    "blockIndex": 35,
    "zh": "滿三月，上不賜告，即時免。"
  },
  {
    "id": "s0188",
    "blockIndex": 35,
    "zh": "數月，卒。"
  },
  {
    "id": "s0189",
    "blockIndex": 36,
    "zh": "春，正月，大赦天下。"
  },
  {
    "id": "s0190",
    "blockIndex": 37,
    "zh": "上召丞相翟方進、御史大夫孔光、右將軍廉褒、後將軍朱博入禁中，議「中山、定陶王誰宜為嗣者」。"
  },
  {
    "id": "s0191",
    "blockIndex": 37,
    "zh": "方進、根、褒、博皆以為：「定陶王，帝弟之子，《禮》曰：『昆弟之子，猶子也。"
  },
  {
    "id": "s0192",
    "blockIndex": 37,
    "zh": "為其後者，為之子也，』定陶王宜為嗣。"
  },
  {
    "id": "s0193",
    "blockIndex": 37,
    "zh": "」光獨以為：「禮，立嗣以親。"
  },
  {
    "id": "s0194",
    "blockIndex": 37,
    "zh": "以《尚書‧盤庚》殷之及王為比，兄終弟及。"
  },
  {
    "id": "s0195",
    "blockIndex": 37,
    "zh": "中山王，先帝之子，帝親弟，宜為嗣。"
  },
  {
    "id": "s0196",
    "blockIndex": 37,
    "zh": "」上以「中山王不材；"
  },
  {
    "id": "s0197",
    "blockIndex": 37,
    "zh": "又禮，兄弟不得相入廟，」不從光議。"
  },
  {
    "id": "s0198",
    "blockIndex": 37,
    "zh": "二月，癸丑，詔立定陶王欣為皇太子，封中山王舅諫大夫馮參為宜鄉侯，益中山國三萬戶，以慰其意；"
  },
  {
    "id": "s0199",
    "blockIndex": 37,
    "zh": "使執金吾任宏守大鴻臚，持節征定陶王。"
  },
  {
    "id": "s0200",
    "blockIndex": 37,
    "zh": "定陶王謝曰：「臣材質不足以假充太子之宮；"
  },
  {
    "id": "s0201",
    "blockIndex": 37,
    "zh": "臣願且得留國邸，旦夕奉問起居，俟有聖嗣，歸國守籓。"
  },
  {
    "id": "s0202",
    "blockIndex": 37,
    "zh": "」書奏，天子報聞。"
  },
  {
    "id": "s0203",
    "blockIndex": 37,
    "zh": "戊午，孔光以議不合意，左遷廷尉；"
  },
  {
    "id": "s0204",
    "blockIndex": 37,
    "zh": "何武為御史大夫。"
  },
  {
    "id": "s0205",
    "blockIndex": 38,
    "zh": "初，詔求殷後，分散為十餘姓，推求其嫡，不能得。"
  },
  {
    "id": "s0206",
    "blockIndex": 38,
    "zh": "匡衡、梅福皆以為宜封孔子世為湯後，上從之，封孔吉為殷紹嘉侯。"
  },
  {
    "id": "s0207",
    "blockIndex": 38,
    "zh": "三月，與周承休侯皆進爵為公，地各百里。"
  },
  {
    "id": "s0208",
    "blockIndex": 39,
    "zh": "上行幸雍，祠五畤。"
  },
  {
    "id": "s0209",
    "blockIndex": 40,
    "zh": "初，何武之為廷尉也，建言：「末俗之敝，政事煩多，宰相之材不能及古，而丞相獨兼三公之事，所以久廢而不治也。"
  },
  {
    "id": "s0210",
    "blockIndex": 40,
    "zh": "宜建三公官。"
  },
  {
    "id": "s0211",
    "blockIndex": 40,
    "zh": "」上從之。"
  },
  {
    "id": "s0212",
    "blockIndex": 40,
    "zh": "夏，四月，賜曲陽侯根大司馬印綬，置官屬，罷票騎將軍官；"
  },
  {
    "id": "s0213",
    "blockIndex": 40,
    "zh": "以御史大夫何武為大司空，封汜鄉侯。"
  },
  {
    "id": "s0214",
    "blockIndex": 40,
    "zh": "皆增奉如丞相，以備三公焉。"
  },
  {
    "id": "s0215",
    "blockIndex": 41,
    "zh": "秋，八月，庚戌，中山孝王興薨。"
  },
  {
    "id": "s0216",
    "blockIndex": 42,
    "zh": "匈奴車牙單于死；"
  },
  {
    "id": "s0217",
    "blockIndex": 42,
    "zh": "弟囊知牙斯立，為烏珠留若鞮單于。"
  },
  {
    "id": "s0218",
    "blockIndex": 42,
    "zh": "烏珠留單于立，以弟樂為左賢王，輿為右賢王，漢遣中郎將夏侯籓、副校尉韓容使匈奴。"
  },
  {
    "id": "s0219",
    "blockIndex": 43,
    "zh": "或說王根曰：「匈奴有斗入漢地，直張掖郡，生奇材木箭竿，鷲羽；"
  },
  {
    "id": "s0220",
    "blockIndex": 43,
    "zh": "如得之，於邊甚饒，國家有廣地之實，將軍顯功垂於無窮！"
  },
  {
    "id": "s0221",
    "blockIndex": 43,
    "zh": "」根為上言其利，上直欲從單于求之，為有不得，傷命損威。"
  },
  {
    "id": "s0222",
    "blockIndex": 43,
    "zh": "根即但以上指曉籓，令從籓所說而求之。"
  },
  {
    "id": "s0223",
    "blockIndex": 43,
    "zh": "籓至匈奴，以語次說單于曰：「竊見匈奴斗入漢地，直張掖郡，漢三都尉居塞上，士卒數百人，寒苦，候望久勞，單于宜上書獻此地，直斷割之，省兩都尉士卒數百人，以復天子厚恩，其報必大。"
  },
  {
    "id": "s0224",
    "blockIndex": 43,
    "zh": "」單于曰：「此天子詔語邪，將從使者所求也？"
  },
  {
    "id": "s0225",
    "blockIndex": 43,
    "zh": "」籓曰：「詔指也；"
  },
  {
    "id": "s0226",
    "blockIndex": 43,
    "zh": "然籓亦為單于畫善計耳。"
  },
  {
    "id": "s0227",
    "blockIndex": 43,
    "zh": "」單于曰：「此溫偶駼王所居地也，未曉其形狀、所生，請遣使問之。"
  },
  {
    "id": "s0228",
    "blockIndex": 43,
    "zh": "」籓、容歸漢；"
  },
  {
    "id": "s0229",
    "blockIndex": 43,
    "zh": "後復使匈奴，至則求地。"
  },
  {
    "id": "s0230",
    "blockIndex": 43,
    "zh": "單于曰：「父兄傳五世，漢不求此地，至知獨求，何也？"
  },
  {
    "id": "s0231",
    "blockIndex": 43,
    "zh": "已問溫偶駼王，匈奴西邊諸侯作穹廬及車，皆仰此山材木，且先父地，不敢失也。"
  },
  {
    "id": "s0232",
    "blockIndex": 43,
    "zh": "」籓還，遷為太原太守。"
  },
  {
    "id": "s0233",
    "blockIndex": 43,
    "zh": "單于遣使上書，以籓求地狀聞。"
  },
  {
    "id": "s0234",
    "blockIndex": 43,
    "zh": "詔報單于曰：「籓擅稱詔，從單于求地，法當死；"
  },
  {
    "id": "s0235",
    "blockIndex": 43,
    "zh": "更大赦二，令徙籓為濟南太守，不令當匈奴。"
  },
  {
    "id": "s0237",
    "blockIndex": 44,
    "zh": "冬，十月，甲寅，王根病免。"
  },
  {
    "id": "s0238",
    "blockIndex": 45,
    "zh": "上以太子既奉大宗後，不得顧私親，十一月，立楚孝王孫景為定陶王，以奉恭王後。"
  },
  {
    "id": "s0239",
    "blockIndex": 45,
    "zh": "太子議欲謝；"
  },
  {
    "id": "s0240",
    "blockIndex": 45,
    "zh": "少傅閻崇以為為人後之禮，不得顧私親，不當謝；"
  },
  {
    "id": "s0241",
    "blockIndex": 45,
    "zh": "太傅趙玄以為當謝，太子從之。"
  },
  {
    "id": "s0242",
    "blockIndex": 45,
    "zh": "詔問所以謝狀，尚書劾奏玄，左遷少府；"
  },
  {
    "id": "s0243",
    "blockIndex": 45,
    "zh": "以光祿勳師丹為太傅。"
  },
  {
    "id": "s0244",
    "blockIndex": 45,
    "zh": "初，太子之幼也，王祖母傅太后躬自養視；"
  },
  {
    "id": "s0245",
    "blockIndex": 45,
    "zh": "及為太子，詔傅太后與太子母丁姬自居定陶國邸，不得相見。"
  },
  {
    "id": "s0246",
    "blockIndex": 45,
    "zh": "頃之，王太后欲令傅太后、丁姬十日一至太子家，帝曰：「太子承正統，當共養陛下，不得復顧私親。"
  },
  {
    "id": "s0247",
    "blockIndex": 45,
    "zh": "」王太后曰：「太子小而傅太后抱養之；"
  },
  {
    "id": "s0248",
    "blockIndex": 45,
    "zh": "今至太子家，以乳母恩耳，不足有所妨。"
  },
  {
    "id": "s0249",
    "blockIndex": 45,
    "zh": "」於是令傅太后得至太子家；"
  },
  {
    "id": "s0250",
    "blockIndex": 45,
    "zh": "丁姬以不養太子，獨不得。"
  },
  {
    "id": "s0251",
    "blockIndex": 46,
    "zh": "衛尉、侍中淳于長有寵於上，大見信用，貴傾公卿，外交諸侯、牧、守，賂遺、賞賜累巨萬，淫於聲色。"
  },
  {
    "id": "s0252",
    "blockIndex": 46,
    "zh": "許後姊孊為龍雒思侯夫人，寡居；"
  },
  {
    "id": "s0253",
    "blockIndex": 46,
    "zh": "長與孊私通，因取為小妻。"
  },
  {
    "id": "s0254",
    "blockIndex": 46,
    "zh": "許後時居長定宮，因孊賂遺長，欲求復為婕妤。"
  },
  {
    "id": "s0255",
    "blockIndex": 46,
    "zh": "長受許後金錢、乘輿、服御物前後千餘萬，詐許為白上，立以為左皇后。"
  },
  {
    "id": "s0256",
    "blockIndex": 46,
    "zh": "孊每入長定宮，輒與孊書，戲侮許後，嫚易無不言；"
  },
  {
    "id": "s0257",
    "blockIndex": 46,
    "zh": "交通書記，賂遺連年。"
  },
  {
    "id": "s0258",
    "blockIndex": 46,
    "zh": "時曲陽侯根輔政，久病，數乞骸骨。"
  },
  {
    "id": "s0259",
    "blockIndex": 46,
    "zh": "長以外親居九卿位，次第當代根。"
  },
  {
    "id": "s0260",
    "blockIndex": 46,
    "zh": "侍中、騎都尉、光祿大夫王莽心害長寵，私聞其事。"
  },
  {
    "id": "s0261",
    "blockIndex": 46,
    "zh": "莽侍曲陽侯病，因言：「長見將軍久病意喜，自以當代輔政，至對及冠議語署置。"
  },
  {
    "id": "s0262",
    "blockIndex": 46,
    "zh": "」具言其罪過。"
  },
  {
    "id": "s0263",
    "blockIndex": 46,
    "zh": "根怒曰：「即如是，何不白也」？"
  },
  {
    "id": "s0264",
    "blockIndex": 46,
    "zh": "莽曰：「未知將軍意，故未敢言！"
  },
  {
    "id": "s0265",
    "blockIndex": 46,
    "zh": "」根曰：「趣白東宮！"
  },
  {
    "id": "s0266",
    "blockIndex": 46,
    "zh": "」莽求見太后，具言長驕佚，欲代曲陽侯；"
  },
  {
    "id": "s0267",
    "blockIndex": 46,
    "zh": "私與長定貴人姊通，受取其衣物。"
  },
  {
    "id": "s0268",
    "blockIndex": 46,
    "zh": "太后亦怒曰：「兒至如此！"
  },
  {
    "id": "s0269",
    "blockIndex": 46,
    "zh": "往，白之帝！"
  },
  {
    "id": "s0270",
    "blockIndex": 46,
    "zh": "」莽白上；"
  },
  {
    "id": "s0271",
    "blockIndex": 46,
    "zh": "上以太后故，免長官，勿治罪，遣就國。"
  },
  {
    "id": "s0272",
    "blockIndex": 47,
    "zh": "初，紅陽侯立不得輔政，疑為長毀譖，常怨毒長；"
  },
  {
    "id": "s0273",
    "blockIndex": 47,
    "zh": "上知之。"
  },
  {
    "id": "s0274",
    "blockIndex": 47,
    "zh": "及長當就國，立嗣子融從長請車騎，長以珍寶因融重遺立。"
  },
  {
    "id": "s0275",
    "blockIndex": 47,
    "zh": "立因上封事，為長求留，曰：「陛下既托文以皇太后故，誠不可更有它計。"
  },
  {
    "id": "s0276",
    "blockIndex": 47,
    "zh": "」於是天子疑焉，下有司按驗。"
  },
  {
    "id": "s0277",
    "blockIndex": 47,
    "zh": "吏捕融，立令融自殺以滅口。"
  },
  {
    "id": "s0278",
    "blockIndex": 47,
    "zh": "上愈疑其有大奸，遂逮長系洛陽詔獄，窮治。"
  },
  {
    "id": "s0279",
    "blockIndex": 47,
    "zh": "長具服戲侮長定宮，謀立左皇后，罪至大逆，死獄中。"
  },
  {
    "id": "s0280",
    "blockIndex": 47,
    "zh": "妻子當坐者徙合浦；"
  },
  {
    "id": "s0281",
    "blockIndex": 47,
    "zh": "母若歸故郡。"
  },
  {
    "id": "s0282",
    "blockIndex": 47,
    "zh": "上使廷尉孔光持節賜廢後藥，自殺。"
  },
  {
    "id": "s0283",
    "blockIndex": 47,
    "zh": "丞相方進復劾奏「紅陽侯立，狡猾不閫，請下獄。"
  },
  {
    "id": "s0284",
    "blockIndex": 47,
    "zh": "」上曰：「紅陽侯，朕之舅，不忍致法；"
  },
  {
    "id": "s0285",
    "blockIndex": 47,
    "zh": "遣就國。"
  },
  {
    "id": "s0286",
    "blockIndex": 47,
    "zh": "」於是方進復奏立黨友後將軍朱博、巨鹿太守孫閎，皆免官，與故光祿大夫陳鹹皆歸故郡。"
  },
  {
    "id": "s0287",
    "blockIndex": 47,
    "zh": "鹹自知廢錮，以憂死。"
  },
  {
    "id": "s0288",
    "blockIndex": 48,
    "zh": "方進智能有餘，兼通文法吏事，以儒雅緣飾法律，號為通明相，天子器重之；"
  },
  {
    "id": "s0289",
    "blockIndex": 48,
    "zh": "又善求人主微指，奏事無不當意。"
  },
  {
    "id": "s0290",
    "blockIndex": 48,
    "zh": "方淳于長用事，方進獨與長交，稱薦之；"
  },
  {
    "id": "s0291",
    "blockIndex": 48,
    "zh": "及長坐大逆誅，上以方進大臣，為之隱諱，方進內慚，上疏謝罪乞骸骨。"
  },
  {
    "id": "s0292",
    "blockIndex": 48,
    "zh": "上報曰：「定陵侯長已伏其辜，君雖交通，《傳》不雲乎：『朝過夕改，君子與之。"
  },
  {
    "id": "s0293",
    "blockIndex": 48,
    "zh": "』君何疑焉！"
  },
  {
    "id": "s0294",
    "blockIndex": 48,
    "zh": "其專心壹意，毋怠醫藥，以自持。"
  },
  {
    "id": "s0295",
    "blockIndex": 48,
    "zh": "」方進起視事，復條奏長所厚善京光尹孫寶、右扶風蕭育，刺史二千石以上，免二十餘人。"
  },
  {
    "id": "s0296",
    "blockIndex": 48,
    "zh": "函谷都尉、建平侯杜業，素與方進不平，方進奏「業受紅陽侯書聽請，不敬，」免，就國。"
  },
  {
    "id": "s0297",
    "blockIndex": 49,
    "zh": "上以王莽首發大奸，稱其忠直；"
  },
  {
    "id": "s0298",
    "blockIndex": 49,
    "zh": "王根因薦莽自代。"
  },
  {
    "id": "s0299",
    "blockIndex": 49,
    "zh": "丙寅，以莽為大司馬，時年三十八。"
  },
  {
    "id": "s0300",
    "blockIndex": 49,
    "zh": "莽既拔出同列，繼四父而輔政，欲令名譽過前人，遂克己不倦。"
  },
  {
    "id": "s0301",
    "blockIndex": 49,
    "zh": "聘諸賢良以為掾、史，賞賜、邑錢悉以享士，愈為儉約，母病，公卿列侯遣夫人問疾，莽妻迎之，衣不曳地，布蔽膝，見之者以為僮使，問知其夫人，皆驚。"
  },
  {
    "id": "s0302",
    "blockIndex": 49,
    "zh": "其飾名如此。"
  },
  {
    "id": "s0303",
    "blockIndex": 50,
    "zh": "丞相方進、大司空武奏言：「《春秋》之義，用貴治賤，不以卑臨尊。"
  },
  {
    "id": "s0304",
    "blockIndex": 50,
    "zh": "刺史位下大夫而臨二千石，輕重不相準。"
  },
  {
    "id": "s0305",
    "blockIndex": 50,
    "zh": "臣請罷刺史，更置州牧以應古制！"
  },
  {
    "id": "s0306",
    "blockIndex": 50,
    "zh": "」十二月，罷刺史，更置州牧，秩二千石。"
  },
  {
    "id": "s0307",
    "blockIndex": 51,
    "zh": "犍為郡於水濱得古磬十六枚，議者以為善祥。"
  },
  {
    "id": "s0308",
    "blockIndex": 51,
    "zh": "劉向因是說上：「宜興辟雍，設庠序，陳禮樂，隆雅頌之聲，盛揖讓之容，以風化天下。"
  },
  {
    "id": "s0309",
    "blockIndex": 51,
    "zh": "如此而不治者，未之有也。"
  },
  {
    "id": "s0310",
    "blockIndex": 51,
    "zh": "或曰：不能具禮。"
  },
  {
    "id": "s0311",
    "blockIndex": 51,
    "zh": "禮以養人為本，如有過差，是過而養人也。"
  },
  {
    "id": "s0312",
    "blockIndex": 51,
    "zh": "刑罰之過或至死傷，今之刑非皋陶之法也，而有司請定法，削則削，筆則筆，救時務也。"
  },
  {
    "id": "s0313",
    "blockIndex": 51,
    "zh": "至於禮樂，則曰不敢，是敢於殺人、不敢於養人也。"
  },
  {
    "id": "s0314",
    "blockIndex": 51,
    "zh": "為其俎豆、管弦之間小不備，因是絕而不為，是去小不備而就大不備，惑莫甚焉！"
  },
  {
    "id": "s0315",
    "blockIndex": 51,
    "zh": "夫教化之比於刑法，刑法輕，是捨所重而急所輕也。"
  },
  {
    "id": "s0316",
    "blockIndex": 51,
    "zh": "教化，所恃以為治也；"
  },
  {
    "id": "s0317",
    "blockIndex": 51,
    "zh": "刑法，所以助治也；"
  },
  {
    "id": "s0318",
    "blockIndex": 51,
    "zh": "今廢所恃而獨立其所助，非所以致太平也。"
  },
  {
    "id": "s0319",
    "blockIndex": 51,
    "zh": "自京師有悖逆不順之子孫，至於陷大辟、受刑戮者不絕，由不習五常之道也。"
  },
  {
    "id": "s0320",
    "blockIndex": 51,
    "zh": "夫承千歲之衰周，繼暴秦之餘敝，民漸漬惡俗，貪饕險詖，不閒義理，不示以大化而獨歐以刑罰，終已不改！"
  },
  {
    "id": "s0321",
    "blockIndex": 51,
    "zh": "」帝以向言下公卿議，丞相、大司空奏請立辟雍，按行長安城南營表；"
  },
  {
    "id": "s0322",
    "blockIndex": 51,
    "zh": "未作而罷。"
  },
  {
    "id": "s0323",
    "blockIndex": 51,
    "zh": "時又有言「孔子布衣，養徒三千人，今天子太學弟子少。"
  },
  {
    "id": "s0324",
    "blockIndex": 51,
    "zh": "」於是增弟子員三千人，歲餘，復如故。"
  },
  {
    "id": "s0325",
    "blockIndex": 52,
    "zh": "劉向自見得信於上，故常顯訟宗室，譏刺王氏及在位大臣，其言多痛切，發於至誠。"
  },
  {
    "id": "s0326",
    "blockIndex": 52,
    "zh": "上數欲用向為九卿，輒不為王氏居位者及丞相、御史所持，故終不遷，居列大夫官前後三十餘年而卒。"
  },
  {
    "id": "s0327",
    "blockIndex": 52,
    "zh": "後十三歲而王氏代漢。"
  },
  {
    "id": "s0328",
    "blockIndex": 53,
    "zh": "category:資治通鑑"
  }
]
