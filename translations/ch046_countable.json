[
  {
    "id": "s0001",
    "blockIndex": 0,
    "zh": "資治通鑑第046卷"
  },
  {
    "id": "s0002",
    "blockIndex": 1,
    "zh": "【漢紀三十八】起柔兆困敦，盡閼逢涒灘，凡九年。"
  },
  {
    "id": "s0003",
    "blockIndex": 2,
    "zh": "春，正月，詔兗、豫、徐三州稟贍饑民。"
  },
  {
    "id": "s0004",
    "blockIndex": 2,
    "zh": "上問司徒鮑昱：「何以消復旱災？"
  },
  {
    "id": "s0005",
    "blockIndex": 2,
    "zh": "」對曰：「陛下始踐天位，雖有失得，未能致異。"
  },
  {
    "id": "s0006",
    "blockIndex": 2,
    "zh": "臣前為汝南太守，典治楚事，系者千餘人，恐未能盡當其罪。"
  },
  {
    "id": "s0007",
    "blockIndex": 2,
    "zh": "夫大獄一起，冤者過半。"
  },
  {
    "id": "s0008",
    "blockIndex": 2,
    "zh": "又，諸徙者骨肉離分，孤魂不祀。"
  },
  {
    "id": "s0009",
    "blockIndex": 2,
    "zh": "宜一切還諸徙家。"
  },
  {
    "id": "s0010",
    "blockIndex": 2,
    "zh": "蠲除禁錮，使死生獲所，則和氣可致。"
  },
  {
    "id": "s0011",
    "blockIndex": 2,
    "zh": "」帝納其言。"
  },
  {
    "id": "s0012",
    "blockIndex": 3,
    "zh": "校書郎楊終上疏曰：「間者北征匈奴，西開三十六國，百姓頻年服役，轉輸煩費；"
  },
  {
    "id": "s0013",
    "blockIndex": 3,
    "zh": "愁困之民足以感動天地。"
  },
  {
    "id": "s0014",
    "blockIndex": 3,
    "zh": "陛下宜留念省察。"
  },
  {
    "id": "s0015",
    "blockIndex": 3,
    "zh": "」帝下其章，第五倫亦同終議。"
  },
  {
    "id": "s0016",
    "blockIndex": 3,
    "zh": "牟融、飽昱皆以為：「孝子無改父之道。"
  },
  {
    "id": "s0017",
    "blockIndex": 3,
    "zh": "征伐匈奴，屯戍西域，先帝所建，不宜迥異。"
  },
  {
    "id": "s0018",
    "blockIndex": 3,
    "zh": "」終復上疏曰：「秦築長城，功役繁興；"
  },
  {
    "id": "s0019",
    "blockIndex": 3,
    "zh": "胡亥不革，卒亡四海。"
  },
  {
    "id": "s0020",
    "blockIndex": 3,
    "zh": "故孝元棄珠崖之郡，光武絕西域之國，不以介鱗易我衣裳。"
  },
  {
    "id": "s0021",
    "blockIndex": 3,
    "zh": "魯文公毀泉台，《春秋》譏之曰：『先祖為之而己毀之，不如勿居而已，』以其無妨害於民也；"
  },
  {
    "id": "s0022",
    "blockIndex": 3,
    "zh": "襄公作三軍，昭公捨之，君子大其復古，以為不捨則有害於民也。"
  },
  {
    "id": "s0023",
    "blockIndex": 3,
    "zh": "今伊吾之役，樓蘭之屯兵久而未還，非天意也。"
  },
  {
    "id": "s0024",
    "blockIndex": 3,
    "zh": "」帝從之。"
  },
  {
    "id": "s0025",
    "blockIndex": 4,
    "zh": "丙寅，詔：「二千石勉勸農桑。"
  },
  {
    "id": "s0026",
    "blockIndex": 4,
    "zh": "罪非殊死，須秋案驗。"
  },
  {
    "id": "s0027",
    "blockIndex": 4,
    "zh": "有司明慎選舉，進柔良，退貪猾，順時令，理冤獄。"
  },
  {
    "id": "s0028",
    "blockIndex": 4,
    "zh": "」是時承永平故事，吏政尚嚴切，尚書決事，率近於重。"
  },
  {
    "id": "s0029",
    "blockIndex": 4,
    "zh": "尚書沛國陳寵以帝新即位，宜改前世苛俗，乃上疏曰：「臣聞先王之政，賞不僭，刑不濫。"
  },
  {
    "id": "s0030",
    "blockIndex": 4,
    "zh": "與其不得已，寧僭無濫。"
  },
  {
    "id": "s0031",
    "blockIndex": 4,
    "zh": "往者斷獄嚴明，所以威懲奸慝；"
  },
  {
    "id": "s0032",
    "blockIndex": 4,
    "zh": "奸慝既平，必宜濟之以寬。"
  },
  {
    "id": "s0033",
    "blockIndex": 4,
    "zh": "陛下即位，率由此義，數詔群僚，弘崇晏晏，而有司未悉奉承，猶尚深刻。"
  },
  {
    "id": "s0034",
    "blockIndex": 4,
    "zh": "斷獄者急於篣格酷烈之痛，執憲者煩於詆欺放濫之文，或因公行私，逞縱威福。"
  },
  {
    "id": "s0035",
    "blockIndex": 4,
    "zh": "夫為政猶張琴瑟，大弦急者小弦絕。"
  },
  {
    "id": "s0036",
    "blockIndex": 4,
    "zh": "陛下宜隆先王之道，蕩滌煩苛之法，輕薄棰楚以濟群生，全廣至德以奉天心。"
  },
  {
    "id": "s0037",
    "blockIndex": 4,
    "zh": "」帝深納寵言，每事務於寬厚。"
  },
  {
    "id": "s0038",
    "blockIndex": 5,
    "zh": "酒泉太守段彭等兵會柳中，擊車師，攻交河城，斬首三千八百級，獲生口三千餘人。"
  },
  {
    "id": "s0039",
    "blockIndex": 5,
    "zh": "北匈奴驚走，車師復降。"
  },
  {
    "id": "s0040",
    "blockIndex": 5,
    "zh": "會關寵已歿，謁者王蒙等欲引兵還；"
  },
  {
    "id": "s0041",
    "blockIndex": 5,
    "zh": "耿恭軍吏范羌，時在軍中，固請迎恭。"
  },
  {
    "id": "s0042",
    "blockIndex": 5,
    "zh": "諸將不敢前，乃分兵二千人與羌，從山北迎恭，遇大雪丈餘，軍僅能至。"
  },
  {
    "id": "s0043",
    "blockIndex": 5,
    "zh": "城中夜聞兵馬聲，以為虜來，大驚。"
  },
  {
    "id": "s0044",
    "blockIndex": 5,
    "zh": "羌遙呼曰：「我范羌也，漢遣軍迎校尉耳。"
  },
  {
    "id": "s0045",
    "blockIndex": 5,
    "zh": "」城中皆稱萬歲。"
  },
  {
    "id": "s0046",
    "blockIndex": 5,
    "zh": "開門，共相持涕泣。"
  },
  {
    "id": "s0047",
    "blockIndex": 5,
    "zh": "明日，遂相隨俱歸。"
  },
  {
    "id": "s0048",
    "blockIndex": 5,
    "zh": "虜兵追之，且戰且行。"
  },
  {
    "id": "s0049",
    "blockIndex": 5,
    "zh": "吏士素饑困，發疏勒時，尚有二十六人，隨路死沒，三月至玉門，唯餘十三人，衣屨穿決，形容枯槁。"
  },
  {
    "id": "s0050",
    "blockIndex": 6,
    "zh": "中郎將鄭眾為恭已下洗沐，易衣冠，上疏奏：「恭以單兵守孤城，當匈奴數萬之眾，連月逾年，心力困盡，鑿山為井，煮弩為糧，前後殺傷丑虜數百千計，卒全忠勇，不為大漢恥，宜蒙顯爵，以厲將帥。"
  },
  {
    "id": "s0051",
    "blockIndex": 6,
    "zh": "」恭至雒陽，拜騎都尉。"
  },
  {
    "id": "s0052",
    "blockIndex": 7,
    "zh": "詔悉罷戊、己校尉及都護官，征還班超。"
  },
  {
    "id": "s0053",
    "blockIndex": 7,
    "zh": "超將發還，疏勒舉國憂恐；"
  },
  {
    "id": "s0054",
    "blockIndex": 7,
    "zh": "其都尉黎弇曰：「漢使棄我，我必復為龜茲所滅耳，誠不忍見漢使去。"
  },
  {
    "id": "s0055",
    "blockIndex": 7,
    "zh": "」因以刀自剄。"
  },
  {
    "id": "s0056",
    "blockIndex": 7,
    "zh": "超還至於窴，王侯以下皆號泣，曰：「依漢使如父母，誠不可去！"
  },
  {
    "id": "s0057",
    "blockIndex": 7,
    "zh": "」互抱超馬腳不得行。"
  },
  {
    "id": "s0058",
    "blockIndex": 7,
    "zh": "超亦欲遂其本志，乃更還疏勒。"
  },
  {
    "id": "s0059",
    "blockIndex": 7,
    "zh": "疏勒兩城已降龜茲，而與尉頭連兵。"
  },
  {
    "id": "s0060",
    "blockIndex": 7,
    "zh": "超捕斬反者，擊破尉頭，殺六百餘人，疏勒復安。"
  },
  {
    "id": "s0061",
    "blockIndex": 8,
    "zh": "甲寅，山陽、山平地震。"
  },
  {
    "id": "s0062",
    "blockIndex": 9,
    "zh": "東平王蒼上便宜三事。"
  },
  {
    "id": "s0063",
    "blockIndex": 9,
    "zh": "帝報書曰：「間吏民奏事亦有此言，但明智淺短，或謂倘是，復慮為非，不知所定。"
  },
  {
    "id": "s0064",
    "blockIndex": 9,
    "zh": "得王深策，恢然意解；"
  },
  {
    "id": "s0065",
    "blockIndex": 9,
    "zh": "思惟嘉謀，以次奉行。"
  },
  {
    "id": "s0066",
    "blockIndex": 9,
    "zh": "特賜王錢五百萬。"
  },
  {
    "id": "s0067",
    "blockIndex": 9,
    "zh": "」後帝欲為原陵、顯節陵起縣邑，蒼上疏諫曰：「竊見光武皇帝躬履儉約之行，深睹始終之分，勤勤懇懇，以葬制為言；"
  },
  {
    "id": "s0068",
    "blockIndex": 9,
    "zh": "孝明皇帝大孝無違，承奉遵行。"
  },
  {
    "id": "s0069",
    "blockIndex": 9,
    "zh": "謙德之美，於斯為盛。"
  },
  {
    "id": "s0070",
    "blockIndex": 9,
    "zh": "臣愚以園邑之興，始自強秦。"
  },
  {
    "id": "s0071",
    "blockIndex": 9,
    "zh": "古者丘隴且不欲其著明，豈況築郭邑、建都郛哉！"
  },
  {
    "id": "s0072",
    "blockIndex": 9,
    "zh": "上違先帝聖心，下造無益之功，虛費國用，動搖百姓，非所以致和氣、祈豐年也。"
  },
  {
    "id": "s0073",
    "blockIndex": 9,
    "zh": "陛下履有虞之至性，追祖檷之深思，臣蒼誠傷二帝純德之美不暢於無窮也。"
  },
  {
    "id": "s0074",
    "blockIndex": 9,
    "zh": "」帝乃止。"
  },
  {
    "id": "s0075",
    "blockIndex": 9,
    "zh": "自是朝廷每有疑政，輒驛使諮問，蒼悉心以對，皆見納用。"
  },
  {
    "id": "s0076",
    "blockIndex": 9,
    "zh": "秋，八月，庚寅，有星孛於天市。"
  },
  {
    "id": "s0077",
    "blockIndex": 10,
    "zh": "初，益州西部都尉廣漢鄭純，為政清潔，化行夷貊，君長感慕，皆奉珍內附；"
  },
  {
    "id": "s0078",
    "blockIndex": 10,
    "zh": "明帝為之置永昌郡，以純為太守。"
  },
  {
    "id": "s0079",
    "blockIndex": 10,
    "zh": "純在官十年而卒，後人不能撫循夷人。"
  },
  {
    "id": "s0080",
    "blockIndex": 10,
    "zh": "九月，哀牢王類牢殺守令反，攻博南。"
  },
  {
    "id": "s0081",
    "blockIndex": 11,
    "zh": "阜陵王延數懷怨望，有告延與子男魴造逆謀者；"
  },
  {
    "id": "s0082",
    "blockIndex": 11,
    "zh": "上不忍誅，冬十一月，貶延為阜陵侯，食一縣，不得與吏民通。"
  },
  {
    "id": "s0083",
    "blockIndex": 12,
    "zh": "北匈奴皋林溫禺犢王將眾還居涿邪山，南單于與邊郡及烏桓共擊破之。"
  },
  {
    "id": "s0084",
    "blockIndex": 12,
    "zh": "是歲，南部大饑，詔稟給之。"
  },
  {
    "id": "s0085",
    "blockIndex": 13,
    "zh": "春，三月，甲辰，罷伊吾盧屯兵，匈奴復遣兵守其地。"
  },
  {
    "id": "s0086",
    "blockIndex": 14,
    "zh": "永昌、越巂、益州三郡兵及昆明夷鹵承等，擊哀牢王類牢於博南，大破，斬之。"
  },
  {
    "id": "s0087",
    "blockIndex": 15,
    "zh": "夏，四月，戊子，詔還坐楚、淮陽事徙者四百餘家。"
  },
  {
    "id": "s0088",
    "blockIndex": 16,
    "zh": "上欲封爵諸舅，太后不聽。"
  },
  {
    "id": "s0089",
    "blockIndex": 16,
    "zh": "會大旱，言事者以為不封外戚之故，有司請依舊典。"
  },
  {
    "id": "s0090",
    "blockIndex": 16,
    "zh": "太后詔曰：「凡言事者，皆欲媚朕以要福耳。"
  },
  {
    "id": "s0091",
    "blockIndex": 16,
    "zh": "昔王氏五侯同日俱封，黃霧四塞，不聞澍雨之應。"
  },
  {
    "id": "s0092",
    "blockIndex": 16,
    "zh": "夫外戚貴盛，鮮不傾覆；"
  },
  {
    "id": "s0093",
    "blockIndex": 16,
    "zh": "故先帝防慎舅氏，不令在樞機之位，又言『我子不當與先帝子等』，今有司奈何欲以馬氏比陰氏乎！"
  },
  {
    "id": "s0094",
    "blockIndex": 16,
    "zh": "且陰衛尉，天下稱之，省中御者至門，出不及履，此蘧伯玉之敬也；"
  },
  {
    "id": "s0095",
    "blockIndex": 16,
    "zh": "新陽侯雖剛強，微失理，然有方略，據地談論，一朝無雙；"
  },
  {
    "id": "s0096",
    "blockIndex": 16,
    "zh": "原鹿貞侯，勇猛誠信；"
  },
  {
    "id": "s0097",
    "blockIndex": 16,
    "zh": "此三人者，天下選臣，豈可及哉！"
  },
  {
    "id": "s0098",
    "blockIndex": 16,
    "zh": "馬氏不及陰氏遠矣。"
  },
  {
    "id": "s0099",
    "blockIndex": 16,
    "zh": "吾不才，夙夜累息，常恐虧先後之法，有毛髮之罪吾不釋，言之不捨晝夜，而親屬犯之不止，治喪起墳，又不時覺，是吾言之不立而耳目之塞也。"
  },
  {
    "id": "s0100",
    "blockIndex": 17,
    "zh": "吾為天下母，而身服大練，食不求甘，左右但著帛布，無香蕃之飾者，欲身率下也。"
  },
  {
    "id": "s0101",
    "blockIndex": 17,
    "zh": "以為外親見之，當傷心自敕，但笑言『太后素好儉』。"
  },
  {
    "id": "s0102",
    "blockIndex": 17,
    "zh": "前過濯龍門上，見外家問起居者，車如流水，馬如游龍，倉頭衣綠韝，領袖正白，顧視御者，不及遠矣。"
  },
  {
    "id": "s0103",
    "blockIndex": 17,
    "zh": "故不加譴怒，但絕歲用而已，冀以默愧其心，猶懈怠無憂國忘家之慮。"
  },
  {
    "id": "s0104",
    "blockIndex": 17,
    "zh": "知臣莫若君，況親屬乎！"
  },
  {
    "id": "s0105",
    "blockIndex": 17,
    "zh": "吾豈可上負先帝之旨，下虧先人之德，重襲西京敗亡之禍哉！"
  },
  {
    "id": "s0106",
    "blockIndex": 17,
    "zh": "」固不許。"
  },
  {
    "id": "s0107",
    "blockIndex": 17,
    "zh": "帝省詔悲歎，復重請曰：「漢興，舅氏之封侯，猶皇子之為王也。"
  },
  {
    "id": "s0108",
    "blockIndex": 17,
    "zh": "太后誠存謙虛，奈何令臣獨不加恩三舅乎！"
  },
  {
    "id": "s0109",
    "blockIndex": 17,
    "zh": "且衛尉年尊，兩校尉有大病，如令不諱，使臣長抱刻骨之恨。"
  },
  {
    "id": "s0110",
    "blockIndex": 17,
    "zh": "宜及吉時，不可稽留。"
  },
  {
    "id": "s0111",
    "blockIndex": 17,
    "zh": "」太后報曰：「吾反覆念之，思令兩善，豈徒欲獲謙讓之名而使帝受不外施之嫌哉！"
  },
  {
    "id": "s0112",
    "blockIndex": 17,
    "zh": "昔竇太后欲封王皇后之兄，丞相條侯言：『高祖約，無軍功不侯。"
  },
  {
    "id": "s0113",
    "blockIndex": 17,
    "zh": "』今馬氏無功於國，豈得與陰、郭中興之後等邪！"
  },
  {
    "id": "s0114",
    "blockIndex": 17,
    "zh": "常觀富貴之家，祿位重疊，猶再實之木，其根必傷。"
  },
  {
    "id": "s0115",
    "blockIndex": 17,
    "zh": "且人所以願封侯者，欲上奉祭祀，不求溫飽耳；"
  },
  {
    "id": "s0116",
    "blockIndex": 17,
    "zh": "今祭祀則受太官之賜，衣食則蒙御府餘資，斯豈不可足，而必當得一縣乎！"
  },
  {
    "id": "s0117",
    "blockIndex": 17,
    "zh": "吾計之孰矣，勿有疑也。"
  },
  {
    "id": "s0118",
    "blockIndex": 17,
    "zh": "夫至孝之行，安親為上。"
  },
  {
    "id": "s0119",
    "blockIndex": 17,
    "zh": "今數遭變異，谷價數倍，憂惶晝夜，不安坐臥，而欲先營外家之封，違慈母之拳拳乎！"
  },
  {
    "id": "s0120",
    "blockIndex": 17,
    "zh": "吾素剛急，有胸中氣，不可不順也。"
  },
  {
    "id": "s0121",
    "blockIndex": 17,
    "zh": "子之未冠，由於父母，已冠成人，則行子之志。"
  },
  {
    "id": "s0122",
    "blockIndex": 17,
    "zh": "念帝，人君也；"
  },
  {
    "id": "s0123",
    "blockIndex": 17,
    "zh": "吾以未逾三年之故，自吾家族，故得專之。"
  },
  {
    "id": "s0124",
    "blockIndex": 17,
    "zh": "若陰陽調和，邊境清靜，然後行子之志；"
  },
  {
    "id": "s0125",
    "blockIndex": 17,
    "zh": "吾但當含飴弄孫，不能復關政矣。"
  },
  {
    "id": "s0126",
    "blockIndex": 17,
    "zh": "」上乃止。"
  },
  {
    "id": "s0127",
    "blockIndex": 18,
    "zh": "太后嘗詔三輔：諸馬昏親有屬托郡縣、干亂吏治者，以法聞。"
  },
  {
    "id": "s0128",
    "blockIndex": 18,
    "zh": "太夫人葬起墳微高，太后以為言，兄衛尉廖等即時減削。"
  },
  {
    "id": "s0129",
    "blockIndex": 18,
    "zh": "其外親有謙素義行者，輒假借溫言，賞以財位；"
  },
  {
    "id": "s0130",
    "blockIndex": 18,
    "zh": "如有纖介，則先見嚴恪之色，然後加譴。"
  },
  {
    "id": "s0131",
    "blockIndex": 18,
    "zh": "其美車服、不尊法度者，便絕屬籍，遣歸田裡。"
  },
  {
    "id": "s0132",
    "blockIndex": 18,
    "zh": "廣平、巨鹿、樂成王，車騎樸素，無金銀之飾，帝以白太后，即賜錢各五百萬。"
  },
  {
    "id": "s0133",
    "blockIndex": 18,
    "zh": "於是內外從化，被服如一；"
  },
  {
    "id": "s0134",
    "blockIndex": 18,
    "zh": "諸家惶恐，倍於永平時。"
  },
  {
    "id": "s0135",
    "blockIndex": 18,
    "zh": "置織室，蠶於濯龍中，數往觀視，以為娛樂。"
  },
  {
    "id": "s0136",
    "blockIndex": 18,
    "zh": "常與帝旦夕言道政事，及教授小王《論語》經書，述敘平生，雍和終日。"
  },
  {
    "id": "s0137",
    "blockIndex": 19,
    "zh": "馬廖慮美業難終，上疏勸成德政曰：「昔元帝罷服官，成帝御浣衣，哀帝去樂府，然而侈費不息，至於衰亂者，百姓從行不從言也。"
  },
  {
    "id": "s0138",
    "blockIndex": 19,
    "zh": "夫改政移風，必有其本。"
  },
  {
    "id": "s0139",
    "blockIndex": 19,
    "zh": "《傳》曰：吳王好劍客，百姓多創瘢；"
  },
  {
    "id": "s0140",
    "blockIndex": 19,
    "zh": "楚王好細腰，宮中多餓死。"
  },
  {
    "id": "s0141",
    "blockIndex": 19,
    "zh": "』長安語曰：『城中好高結，四方高一尺；"
  },
  {
    "id": "s0142",
    "blockIndex": 19,
    "zh": "城中好廣眉，四方且半額；"
  },
  {
    "id": "s0143",
    "blockIndex": 19,
    "zh": "城中好大袖，四方全匹帛。"
  },
  {
    "id": "s0144",
    "blockIndex": 19,
    "zh": "』斯言如戲，有切事實。"
  },
  {
    "id": "s0145",
    "blockIndex": 19,
    "zh": "前下制度未幾，後稍不行，雖或吏不奉法，良由慢起京師。"
  },
  {
    "id": "s0146",
    "blockIndex": 19,
    "zh": "今陛下素簡所安，發自聖性，誠令斯事一竟，則四海誦德，聲薰天地，神明可通，況於行令乎！"
  },
  {
    "id": "s0147",
    "blockIndex": 19,
    "zh": "」太后深納之。"
  },
  {
    "id": "s0148",
    "blockIndex": 20,
    "zh": "初，安夷縣吏略妻卑湳種羌人婦，吏為其夫所殺，安夷長宗延追之出塞。"
  },
  {
    "id": "s0149",
    "blockIndex": 20,
    "zh": "種人恐見誅，遂共殺延而與勒姐、吾良二種相結為寇。"
  },
  {
    "id": "s0150",
    "blockIndex": 20,
    "zh": "於是燒當羌豪滇吾之子迷吾率諸種俱反，敗金城太守郝崇。"
  },
  {
    "id": "s0151",
    "blockIndex": 20,
    "zh": "詔以武威太守北地傅育為護羌校尉，自安夷徙居臨羌。"
  },
  {
    "id": "s0152",
    "blockIndex": 20,
    "zh": "迷吾又與封養種豪布橋等五萬餘人共寇隴西、漢陽。"
  },
  {
    "id": "s0153",
    "blockIndex": 20,
    "zh": "秋，八月，遣行車騎將軍馬防、長水校尉耿恭將北軍五校兵及諸郡射士三萬人擊之。"
  },
  {
    "id": "s0154",
    "blockIndex": 20,
    "zh": "第五倫上疏曰：「臣愚以為貴戚可封侯以富之，不當任以職事。"
  },
  {
    "id": "s0155",
    "blockIndex": 20,
    "zh": "何者？"
  },
  {
    "id": "s0156",
    "blockIndex": 20,
    "zh": "繩以法則傷恩，私以親則違憲。"
  },
  {
    "id": "s0157",
    "blockIndex": 20,
    "zh": "伏聞馬防今當西征，臣以太后恩仁，陛下至孝，恐卒有纖介，難為意愛。"
  },
  {
    "id": "s0158",
    "blockIndex": 20,
    "zh": "」帝不從。"
  },
  {
    "id": "s0159",
    "blockIndex": 20,
    "zh": "馬防等軍到冀，布橋等圍南部都尉於臨洮，防進擊，破之，斬首虜四千餘人，遂解臨洮圍；"
  },
  {
    "id": "s0160",
    "blockIndex": 20,
    "zh": "其眾皆降，唯布橋等二萬餘人屯望曲谷不下。"
  },
  {
    "id": "s0161",
    "blockIndex": 21,
    "zh": "十二月，戊寅，有星孛於紫宮。"
  },
  {
    "id": "s0162",
    "blockIndex": 22,
    "zh": "帝納竇勳女為貴人，有寵。"
  },
  {
    "id": "s0163",
    "blockIndex": 22,
    "zh": "貴人母，即東海恭王女沘公主也。"
  },
  {
    "id": "s0164",
    "blockIndex": 23,
    "zh": "第五倫上疏曰：「光武承王莽之餘，頗以嚴猛為政，後代因之，遂成風化；"
  },
  {
    "id": "s0165",
    "blockIndex": 23,
    "zh": "郡國所舉，類多辦職俗吏，殊未有寬博之選以應上求者也。"
  },
  {
    "id": "s0166",
    "blockIndex": 23,
    "zh": "陳留令劉豫，冠軍令駟協，並以刻薄之姿，務為嚴苦，吏民愁怨，莫不疾之。"
  },
  {
    "id": "s0167",
    "blockIndex": 23,
    "zh": "而今之議者反以為能，違天心，失經義；"
  },
  {
    "id": "s0168",
    "blockIndex": 23,
    "zh": "非徒應坐豫、協，亦宜譴舉者。"
  },
  {
    "id": "s0169",
    "blockIndex": 23,
    "zh": "務進仁賢以任時政，不過數人，則風俗自化矣。"
  },
  {
    "id": "s0170",
    "blockIndex": 23,
    "zh": "臣嘗讀書記，知秦以酷急亡國，又目見王莽亦以苛法自滅，故勤勤懇懇，實在於此。"
  },
  {
    "id": "s0171",
    "blockIndex": 23,
    "zh": "又聞諸王、主、貴戚，驕奢逾制，京師尚然，何以示遠！"
  },
  {
    "id": "s0172",
    "blockIndex": 23,
    "zh": "故曰：『其身不正，雖令不行。"
  },
  {
    "id": "s0173",
    "blockIndex": 23,
    "zh": "』以身教者從，以言教者訟。"
  },
  {
    "id": "s0174",
    "blockIndex": 23,
    "zh": "」上善之。"
  },
  {
    "id": "s0175",
    "blockIndex": 23,
    "zh": "倫雖天性峭直，然常疾俗吏苛刻，論議每依寬厚雲。"
  },
  {
    "id": "s0176",
    "blockIndex": 24,
    "zh": "春，正月，己酉，宗祀明堂，登靈台，赦天下。"
  },
  {
    "id": "s0177",
    "blockIndex": 25,
    "zh": "馬防擊布橋，大破之，布橋將種人萬餘降，詔征防還。"
  },
  {
    "id": "s0178",
    "blockIndex": 25,
    "zh": "留耿恭擊諸未服者，斬首虜千餘人，勒姐、燒何等十三種數萬人，皆詣恭降。"
  },
  {
    "id": "s0179",
    "blockIndex": 25,
    "zh": "恭嘗以言事忤馬防，監營謁者承旨，奏恭不憂軍事，坐征下獄，免官。"
  },
  {
    "id": "s0180",
    "blockIndex": 26,
    "zh": "三月，癸巳，立貴人竇氏為皇后。"
  },
  {
    "id": "s0181",
    "blockIndex": 27,
    "zh": "初，顯宗之世，治虖沱、石臼河，從都慮至羊腸倉，欲令通漕。"
  },
  {
    "id": "s0182",
    "blockIndex": 27,
    "zh": "太原吏民苦役，連年無成，死者不可勝算。"
  },
  {
    "id": "s0183",
    "blockIndex": 27,
    "zh": "帝以郎中鄧訓為謁者，監領其事。"
  },
  {
    "id": "s0184",
    "blockIndex": 27,
    "zh": "訓考量隱括，知其難成，具以上言。"
  },
  {
    "id": "s0185",
    "blockIndex": 27,
    "zh": "夏，四月，己巳，詔罷其役，更用驢輦，歲省費億萬計，全活徒士數千人。"
  },
  {
    "id": "s0186",
    "blockIndex": 27,
    "zh": "訓，禹之子也。"
  },
  {
    "id": "s0187",
    "blockIndex": 28,
    "zh": "閏月，西域假司馬班超率疏勒、康居、於窴、拘彌兵一萬人攻姑墨石城，破之，斬首七百級。"
  },
  {
    "id": "s0188",
    "blockIndex": 29,
    "zh": "冬，十二月，丁酉，以馬防為車騎將軍。"
  },
  {
    "id": "s0189",
    "blockIndex": 30,
    "zh": "武陵漊中蠻反。"
  },
  {
    "id": "s0190",
    "blockIndex": 31,
    "zh": "是歲，有司奏遣廣平王羨、巨鹿王恭、樂成王黨俱就國。"
  },
  {
    "id": "s0191",
    "blockIndex": 31,
    "zh": "上性篤愛，不忍與諸王乖離，遂皆留京師。"
  },
  {
    "id": "s0192",
    "blockIndex": 32,
    "zh": "春，二月，庚寅，太尉牟融薨。"
  },
  {
    "id": "s0193",
    "blockIndex": 33,
    "zh": "夏，四月，戊子，立皇子慶為太子。"
  },
  {
    "id": "s0194",
    "blockIndex": 34,
    "zh": "己丑，徙巨鹿王恭為江陵王，汝南王暢為梁王，常山王昺為淮陽王。"
  },
  {
    "id": "s0195",
    "blockIndex": 35,
    "zh": "辛卯，封皇子伉為千乘王，全為平春王。"
  },
  {
    "id": "s0196",
    "blockIndex": 36,
    "zh": "有司連據舊典，請封諸舅。"
  },
  {
    "id": "s0197",
    "blockIndex": 36,
    "zh": "帝以天下豐稔，方垂無事，癸卯，遂封衛尉廖為順陽侯，車騎將軍防為穎陽侯，執金吾光為許侯。"
  },
  {
    "id": "s0198",
    "blockIndex": 36,
    "zh": "太后聞之曰：「吾少壯時，但慕竹帛，志不顧命。"
  },
  {
    "id": "s0199",
    "blockIndex": 36,
    "zh": "今雖已老，猶戒之在得，故日夜惕厲，思自降損，冀乘此道，不負先帝。"
  },
  {
    "id": "s0200",
    "blockIndex": 36,
    "zh": "所以化導兄弟，共同斯志，欲令瞑目之日，無所復恨，何意老志復不從哉！"
  },
  {
    "id": "s0201",
    "blockIndex": 36,
    "zh": "萬年之日長恨矣！"
  },
  {
    "id": "s0202",
    "blockIndex": 36,
    "zh": "」廖等並辭讓，願就關內侯，帝不許。"
  },
  {
    "id": "s0203",
    "blockIndex": 36,
    "zh": "廖等不得已受封爵而上書辭位，帝許之。"
  },
  {
    "id": "s0204",
    "blockIndex": 36,
    "zh": "五月，丙辰，防、廖、光皆以特進就第。"
  },
  {
    "id": "s0205",
    "blockIndex": 37,
    "zh": "甲戌，以司徒鮑昱為太尉，南陽太守桓虞為司徒。"
  },
  {
    "id": "s0206",
    "blockIndex": 37,
    "zh": "六月，癸丑，皇太后馬氏崩。"
  },
  {
    "id": "s0207",
    "blockIndex": 37,
    "zh": "帝既為太后所養，專以馬氏為外家，故賈貴人不登極位，賈氏親族無受寵榮者。"
  },
  {
    "id": "s0208",
    "blockIndex": 37,
    "zh": "及太后崩，但加貴人王赤綬，安車一駟，永巷宮人二百，御府雜帛二萬匹，大司農黃金千斤，錢二千萬而已。"
  },
  {
    "id": "s0209",
    "blockIndex": 38,
    "zh": "秋，七月，壬戌，葬明德皇后。"
  },
  {
    "id": "s0210",
    "blockIndex": 39,
    "zh": "校書郎楊終建言：「宣帝博征群儒，論定《五經》於石渠閣。"
  },
  {
    "id": "s0211",
    "blockIndex": 39,
    "zh": "方今天下少事，學者得成其業，而章句之徒，破環大體。"
  },
  {
    "id": "s0212",
    "blockIndex": 39,
    "zh": "宜如石渠故事，永為後世則。"
  },
  {
    "id": "s0213",
    "blockIndex": 39,
    "zh": "」帝從之。"
  },
  {
    "id": "s0214",
    "blockIndex": 39,
    "zh": "冬，十一月，壬戌，詔太常：「將、大夫、博士、郎官及諸儒會白虎觀，議《五經》同異。"
  },
  {
    "id": "s0215",
    "blockIndex": 39,
    "zh": "」使五官中郎將魏應承製問，侍中淳於恭奏，帝親稱制臨決，作《白虎議奏》，名儒丁鴻、樓望、成封、桓郁、班固、賈逵及廣平王羨皆與焉。"
  },
  {
    "id": "s0216",
    "blockIndex": 39,
    "zh": "固，超之兄也。"
  },
  {
    "id": "s0217",
    "blockIndex": 40,
    "zh": "春，二月，庚辰朔，日有食之。"
  },
  {
    "id": "s0218",
    "blockIndex": 40,
    "zh": "詔舉直言極諫。"
  },
  {
    "id": "s0219",
    "blockIndex": 41,
    "zh": "荊、豫諸郡兵討漊中蠻，破之。"
  },
  {
    "id": "s0220",
    "blockIndex": 42,
    "zh": "夏，五月，辛亥，詔曰：「朕思遲直士，側席異聞，其先至者，各已發憤吐懣，略聞子大夫之志矣。"
  },
  {
    "id": "s0221",
    "blockIndex": 42,
    "zh": "皆欲置於左右，顧問省納。"
  },
  {
    "id": "s0222",
    "blockIndex": 42,
    "zh": "建武詔書又曰：『堯試臣以職，不直以言語筆札。"
  },
  {
    "id": "s0223",
    "blockIndex": 42,
    "zh": "』今外官多曠，並可以補任。"
  },
  {
    "id": "s0225",
    "blockIndex": 43,
    "zh": "戊辰，太傅趙熹薨。"
  },
  {
    "id": "s0226",
    "blockIndex": 44,
    "zh": "班超欲遂平西域，上疏請兵曰：「臣竊見先帝欲開西域，故北擊匈奴，西使外國，善阜善、於窴即時向化，今拘彌、莎車、疏勒、月氏、烏孫、康居復願歸附，欲共並力，破滅龜茲，平通漢道。"
  },
  {
    "id": "s0227",
    "blockIndex": 44,
    "zh": "若得龜茲，則西域未服者百分之一耳。"
  },
  {
    "id": "s0228",
    "blockIndex": 44,
    "zh": "前世議者皆曰：『取三十六國，號為斷匈奴右臂。"
  },
  {
    "id": "s0229",
    "blockIndex": 44,
    "zh": "』今西域諸國，自日之所入，莫不向化，大小欣欣，貢奉不絕，唯焉耆、龜茲獨未服從。"
  },
  {
    "id": "s0230",
    "blockIndex": 44,
    "zh": "臣前與官屬三十六人奉使絕域，備遭艱厄，自孤守疏勒，於今五載，胡夷情數，臣頗識之，問其城郭小大，皆言倚漢與依天等。"
  },
  {
    "id": "s0231",
    "blockIndex": 44,
    "zh": "以是效之，則蔥領可通，龜茲可伐。"
  },
  {
    "id": "s0232",
    "blockIndex": 44,
    "zh": "今宜拜龜茲侍子白霸為其國王，以步騎數百送之，與諸國連兵，歲月之間，龜茲可禽。"
  },
  {
    "id": "s0233",
    "blockIndex": 44,
    "zh": "以夷狄攻夷狄，計之善者也。"
  },
  {
    "id": "s0234",
    "blockIndex": 44,
    "zh": "臣見莎車、疏勒田地肥廣，草故饒衍，不比敦煌、善阜善間也，兵可不費中國而糧食自足。"
  },
  {
    "id": "s0235",
    "blockIndex": 44,
    "zh": "且姑墨、溫宿二王，特為龜茲所置，既非其種，更相厭苦，其勢必有降者。"
  },
  {
    "id": "s0236",
    "blockIndex": 44,
    "zh": "若二國來降，則龜茲自破。"
  },
  {
    "id": "s0237",
    "blockIndex": 44,
    "zh": "願下臣章，參考行事，誠有萬分，死復何恨！"
  },
  {
    "id": "s0238",
    "blockIndex": 44,
    "zh": "臣超區區特蒙神靈，竊冀未便僵仆，目見西域平定，陛下舉萬年之觴，薦勳祖廟，布大喜於天下。"
  },
  {
    "id": "s0239",
    "blockIndex": 44,
    "zh": "」書奏，帝知其功可成，議欲給兵。"
  },
  {
    "id": "s0240",
    "blockIndex": 44,
    "zh": "平陵徐幹上疏，願奮身佐超，帝以幹為假司馬，將馳刑及義從千人就超。"
  },
  {
    "id": "s0241",
    "blockIndex": 44,
    "zh": "先是莎車以為漢兵不出，遂降於龜茲，而疏勒都尉番辰亦叛。"
  },
  {
    "id": "s0242",
    "blockIndex": 44,
    "zh": "會徐幹適至，超遂與幹擊番辰，大破之，斬首千餘級。"
  },
  {
    "id": "s0243",
    "blockIndex": 44,
    "zh": "欲進攻龜茲，以烏孫兵強，宜因其力，乃上言：「烏孫大國，控弦十萬。"
  },
  {
    "id": "s0244",
    "blockIndex": 44,
    "zh": "故武帝妻以公主，至孝宣帝卒得其用。"
  },
  {
    "id": "s0245",
    "blockIndex": 44,
    "zh": "今可遣使招慰，與共合力。"
  },
  {
    "id": "s0246",
    "blockIndex": 44,
    "zh": "」帝納之。"
  },
  {
    "id": "s0247",
    "blockIndex": 45,
    "zh": "春。"
  },
  {
    "id": "s0248",
    "blockIndex": 45,
    "zh": "二月，辛卯，琅邪孝王京薨。"
  },
  {
    "id": "s0249",
    "blockIndex": 46,
    "zh": "夏，六月，丙辰，太尉鮑昱薨。"
  },
  {
    "id": "s0250",
    "blockIndex": 47,
    "zh": "辛未晦，日有食之。"
  },
  {
    "id": "s0251",
    "blockIndex": 48,
    "zh": "秋，七月，癸巳，以大司農鄧彪為太尉。"
  },
  {
    "id": "s0252",
    "blockIndex": 49,
    "zh": "武都太守廉范遷蜀郡太守。"
  },
  {
    "id": "s0253",
    "blockIndex": 49,
    "zh": "成都民物豐盛，邑宇逼側，舊制，禁民夜作以防火災，而更相隱蔽，燒者日屬。"
  },
  {
    "id": "s0254",
    "blockIndex": 49,
    "zh": "范乃毀削先令，但嚴使儲水而已。"
  },
  {
    "id": "s0255",
    "blockIndex": 49,
    "zh": "百姓以為便，歌之曰：「廉叔度，來何暮！"
  },
  {
    "id": "s0256",
    "blockIndex": 49,
    "zh": "不禁火，民安作。"
  },
  {
    "id": "s0257",
    "blockIndex": 49,
    "zh": "昔無襦，今五褲。"
  },
  {
    "id": "s0259",
    "blockIndex": 50,
    "zh": "帝以沛王等將入朝，遣謁者賜貂裘及太官食物、珍果，又使大鴻臚竇固持節郊迎。"
  },
  {
    "id": "s0260",
    "blockIndex": 50,
    "zh": "帝親自循行邸第，豫設帷床，其錢帛、器物無不充備。"
  },
  {
    "id": "s0261",
    "blockIndex": 51,
    "zh": "春，正月，沛王輔、濟南王康、東平王蒼、中山王焉、東海王政、琅邪王宇來朝。"
  },
  {
    "id": "s0262",
    "blockIndex": 51,
    "zh": "詔沛、濟南、東平、中山王贊拜不名，升殿乃拜，上親答之，所以寵光榮顯，加於前古。"
  },
  {
    "id": "s0263",
    "blockIndex": 51,
    "zh": "每入宮，輒以輦迎，至省閣乃下，上為之興席改容，皇后親拜於內，皆鞠躬辭謝不自安。"
  },
  {
    "id": "s0264",
    "blockIndex": 51,
    "zh": "三月，大鴻臚奏遣諸王歸國，帝特留東平王蒼於京師。"
  },
  {
    "id": "s0265",
    "blockIndex": 52,
    "zh": "初，明德太后為帝納扶風宋楊二女為貴人，大貴人生太子慶。"
  },
  {
    "id": "s0266",
    "blockIndex": 52,
    "zh": "梁松弟竦有二女，亦為貴人，小貴人生皇子肇。"
  },
  {
    "id": "s0267",
    "blockIndex": 52,
    "zh": "竇皇后無子，養肇為子。"
  },
  {
    "id": "s0268",
    "blockIndex": 52,
    "zh": "宋貴人有寵於馬太后，太后崩，竇皇后寵盛，與母沘陽公主謀陷宋氏，外令兄弟求其纖過，內使御者偵伺得失。"
  },
  {
    "id": "s0269",
    "blockIndex": 52,
    "zh": "宋貴人病，思生兔，令家求之，因誣言欲為厭勝之術，由是太子出居承祿觀。"
  },
  {
    "id": "s0270",
    "blockIndex": 52,
    "zh": "夏，六月，甲寅，詔曰：「皇太子有失惑無常之性，不可以奉宗廟。"
  },
  {
    "id": "s0271",
    "blockIndex": 52,
    "zh": "大義滅親，況降退乎！"
  },
  {
    "id": "s0272",
    "blockIndex": 52,
    "zh": "今廢慶為清河王。"
  },
  {
    "id": "s0273",
    "blockIndex": 52,
    "zh": "皇子肇，保育皇后，承訓懷衽，今以肇為皇太子。"
  },
  {
    "id": "s0274",
    "blockIndex": 52,
    "zh": "」遂出宋貴人姊妹置丙捨，使小黃門蔡倫案之。"
  },
  {
    "id": "s0275",
    "blockIndex": 52,
    "zh": "二貴人皆飲藥自殺，父議郎楊免歸本郡。"
  },
  {
    "id": "s0276",
    "blockIndex": 52,
    "zh": "慶時雖幼，亦知避嫌畏禍，言不敢及宋氏；"
  },
  {
    "id": "s0277",
    "blockIndex": 52,
    "zh": "帝更憐之，敕皇后令衣服與太子齊等。"
  },
  {
    "id": "s0278",
    "blockIndex": 52,
    "zh": "，太子亦親愛慶，入則共室，出則同輿。"
  },
  {
    "id": "s0279",
    "blockIndex": 52,
    "zh": "己未，徙廣平王羨為西平王。"
  },
  {
    "id": "s0280",
    "blockIndex": 53,
    "zh": "秋，八月，飲酎畢，有司復奏遣東平王蒼歸國，帝乃許之，手詔賜蒼曰：「骨肉天性，誠不以遠近為親疏；"
  },
  {
    "id": "s0281",
    "blockIndex": 53,
    "zh": "然數見顏色，情重昔時。"
  },
  {
    "id": "s0282",
    "blockIndex": 53,
    "zh": "念王久勞，思得還休，欲署大鴻臚奏，不忍下筆，顧授小黃門；"
  },
  {
    "id": "s0283",
    "blockIndex": 53,
    "zh": "中心戀戀，惻然不能言。"
  },
  {
    "id": "s0284",
    "blockIndex": 53,
    "zh": "」於是車駕祖送，流涕而訣；"
  },
  {
    "id": "s0285",
    "blockIndex": 53,
    "zh": "復賜乘輿服御，珍寶、輿馬，錢布以億萬計。"
  },
  {
    "id": "s0286",
    "blockIndex": 54,
    "zh": "九月，甲戌，帝幸偃師，東涉卷津，至河內，下詔曰：「車駕行秋稼，觀收穫，因涉郡界，皆精騎輕行，無它輜重。"
  },
  {
    "id": "s0287",
    "blockIndex": 54,
    "zh": "不得輒修道橋，遠離城郭，遣吏逢迎，刺探起居，出入前後，以為煩擾。"
  },
  {
    "id": "s0288",
    "blockIndex": 54,
    "zh": "動務省約，但患不能脫粟瓢飲耳。"
  },
  {
    "id": "s0289",
    "blockIndex": 54,
    "zh": "」己酉，進幸鄴。"
  },
  {
    "id": "s0290",
    "blockIndex": 54,
    "zh": "辛卯，還宮。"
  },
  {
    "id": "s0291",
    "blockIndex": 55,
    "zh": "冬，十月，癸丑，帝行幸長安，封蕭何末孫熊為酇侯。"
  },
  {
    "id": "s0292",
    "blockIndex": 55,
    "zh": "進幸槐裡、岐山；"
  },
  {
    "id": "s0293",
    "blockIndex": 55,
    "zh": "又幸長平，御池陽宮，東至高陵。"
  },
  {
    "id": "s0294",
    "blockIndex": 55,
    "zh": "十二月，丁亥，還宮。"
  },
  {
    "id": "s0295",
    "blockIndex": 56,
    "zh": "東平獻王蒼疾病，馳遣名醫、小黃門侍疾，使者冠蓋不絕於道。"
  },
  {
    "id": "s0296",
    "blockIndex": 56,
    "zh": "又置驛馬，千里傳問起居。"
  },
  {
    "id": "s0297",
    "blockIndex": 57,
    "zh": "春，正月，壬辰，王薨。"
  },
  {
    "id": "s0298",
    "blockIndex": 57,
    "zh": "詔告中傅「封上王自建武以來章奏，並集覽焉。"
  },
  {
    "id": "s0299",
    "blockIndex": 57,
    "zh": "」遣大鴻臚持節監喪，令四姓小侯、諸國王、主悉會葬。"
  },
  {
    "id": "s0300",
    "blockIndex": 58,
    "zh": "夏，六月，北匈奴三木樓訾大人稽留斯等率三萬餘人款五原塞降。"
  },
  {
    "id": "s0301",
    "blockIndex": 59,
    "zh": "冬，十二月，甲午，上行幸陳留、梁國、淮陽、穎陽；"
  },
  {
    "id": "s0302",
    "blockIndex": 59,
    "zh": "戊申，還宮。"
  },
  {
    "id": "s0303",
    "blockIndex": 60,
    "zh": "太子肇之立也，梁氏私相慶；"
  },
  {
    "id": "s0304",
    "blockIndex": 60,
    "zh": "諸竇聞而惡之。"
  },
  {
    "id": "s0305",
    "blockIndex": 60,
    "zh": "皇后欲專名外家，忌梁貴人姊妹，數譖之於帝，漸致疏嫌。"
  },
  {
    "id": "s0306",
    "blockIndex": 60,
    "zh": "是歲，竇氏作飛書，陷梁竦以惡逆，竦遂死獄中，家屬徙九真，貴人姊妹以憂死。"
  },
  {
    "id": "s0307",
    "blockIndex": 60,
    "zh": "辭語連及梁松妻舞陰公主，坐徙新城。"
  },
  {
    "id": "s0308",
    "blockIndex": 61,
    "zh": "順陽侯馬廖，謹篤自守，而性寬緩，不能教勒子弟，皆驕奢不謹。"
  },
  {
    "id": "s0309",
    "blockIndex": 61,
    "zh": "校書郎楊終與廖書，戒之曰；"
  },
  {
    "id": "s0310",
    "blockIndex": 61,
    "zh": "「君位地尊重，海內所望。"
  },
  {
    "id": "s0311",
    "blockIndex": 61,
    "zh": "黃門郎年幼，血氣方盛，既無長君退讓之風，而要結輕狡無行之客，縱而莫誨，視成任性，覽念前往，可為寒心！"
  },
  {
    "id": "s0312",
    "blockIndex": 61,
    "zh": "」廖不能從。"
  },
  {
    "id": "s0313",
    "blockIndex": 61,
    "zh": "防、光兄弟資產巨億，大起第觀，彌亙街路，食客常數百人。"
  },
  {
    "id": "s0314",
    "blockIndex": 61,
    "zh": "防又多牧馬畜，賦斂羌、胡。"
  },
  {
    "id": "s0315",
    "blockIndex": 61,
    "zh": "帝不喜之，數加譴敕，所以禁遏甚備。"
  },
  {
    "id": "s0316",
    "blockIndex": 61,
    "zh": "由是權勢稍損，賓客亦衰。"
  },
  {
    "id": "s0317",
    "blockIndex": 61,
    "zh": "廖子豫為步兵校尉，投書怨誹。"
  },
  {
    "id": "s0318",
    "blockIndex": 61,
    "zh": "於是有司並奏防、光兄弟奢侈逾僭，濁亂聖化，悉免就國。"
  },
  {
    "id": "s0319",
    "blockIndex": 61,
    "zh": "臨上路，詔曰：「舅氏一門俱就國封，四時陵廟無助祭先後者，朕甚傷之，其令許侯思愆田廬，有司勿復請，以慰朕渭陽之情。"
  },
  {
    "id": "s0320",
    "blockIndex": 61,
    "zh": "」光比防稍為謹密，故帝特留之，後復位特進。"
  },
  {
    "id": "s0321",
    "blockIndex": 61,
    "zh": "豫隨廖歸國，考擊物故。"
  },
  {
    "id": "s0322",
    "blockIndex": 61,
    "zh": "後復有詔還廖京師。"
  },
  {
    "id": "s0323",
    "blockIndex": 62,
    "zh": "諸馬既得罪，竇氏益貴盛。"
  },
  {
    "id": "s0324",
    "blockIndex": 62,
    "zh": "皇后兄憲為侍中、虎賁中郎將，弟篤為黃門侍郎，並侍宮省，賞賜累積；"
  },
  {
    "id": "s0325",
    "blockIndex": 62,
    "zh": "喜交通賓客。"
  },
  {
    "id": "s0326",
    "blockIndex": 62,
    "zh": "司空第五倫上疏曰：「臣伏見虎賁中郎將竇憲，椒房之親，典司禁兵，出入省闥，年盛志美，卑讓樂善，此誠其好士交結之方。"
  },
  {
    "id": "s0327",
    "blockIndex": 62,
    "zh": "然諸出入貴戚者，類多瑕釁禁錮之人，尤少守約安貧之節。"
  },
  {
    "id": "s0328",
    "blockIndex": 62,
    "zh": "士大夫無志之徒，更相販賣，雲集其門，蓋驕佚所從生也。"
  },
  {
    "id": "s0329",
    "blockIndex": 62,
    "zh": "三輔論議者至云：『以貴戚廢錮，當復以貴戚浣濯之，猶解酲當以酒也。"
  },
  {
    "id": "s0330",
    "blockIndex": 62,
    "zh": "』詖險趣勢之徒，誠不可親近。"
  },
  {
    "id": "s0331",
    "blockIndex": 62,
    "zh": "臣愚願陛下、中宮嚴敕憲等閉門自守，無妄交通士大夫，防其未萌，慮於無形，令憲永保福祿，君臣交歡，無纖介之隙，此臣之所至願也。"
  },
  {
    "id": "s0333",
    "blockIndex": 63,
    "zh": "憲恃宮掖聲勢，自王、主及陰、馬諸家，莫不畏憚。"
  },
  {
    "id": "s0334",
    "blockIndex": 63,
    "zh": "憲以賤直請奪泌水公主園田，主逼畏不敢計。"
  },
  {
    "id": "s0335",
    "blockIndex": 63,
    "zh": "後帝出過園，指以問憲，憲陰喝不得對。"
  },
  {
    "id": "s0336",
    "blockIndex": 63,
    "zh": "後發覺，帝大怒，召憲切責曰：「深思前過奪主田園時，何用愈趙高指鹿為馬！"
  },
  {
    "id": "s0337",
    "blockIndex": 63,
    "zh": "久念使人驚怖。"
  },
  {
    "id": "s0338",
    "blockIndex": 63,
    "zh": "昔永平中，常令陰黨、陰博、鄧疊三人更相糾察，故諸豪戚莫敢犯法者。"
  },
  {
    "id": "s0339",
    "blockIndex": 63,
    "zh": "今貴主尚見枉奪，何況小民哉！"
  },
  {
    "id": "s0340",
    "blockIndex": 63,
    "zh": "國家棄憲，如孤雛、腐鼠耳！"
  },
  {
    "id": "s0341",
    "blockIndex": 63,
    "zh": "」憲大懼，皇后為毀服深謝，良久乃得解，使以田還主。"
  },
  {
    "id": "s0342",
    "blockIndex": 63,
    "zh": "雖不繩其罪，然亦不授以重任。"
  },
  {
    "id": "s0343",
    "blockIndex": 64,
    "zh": "臣光曰：人臣之罪，莫大於欺罔，是以明君疾之。"
  },
  {
    "id": "s0344",
    "blockIndex": 64,
    "zh": "孝章謂竇憲何異指鹿為馬，善矣；"
  },
  {
    "id": "s0345",
    "blockIndex": 64,
    "zh": "然卒不能罪憲，則奸臣安所懲哉！"
  },
  {
    "id": "s0346",
    "blockIndex": 64,
    "zh": "夫人主之於臣下，患在不知其奸，苟或知之而復赦之，則不若不知之為愈也。"
  },
  {
    "id": "s0347",
    "blockIndex": 64,
    "zh": "何以言之？"
  },
  {
    "id": "s0348",
    "blockIndex": 64,
    "zh": "彼或為奸而上不之知，猶有所畏；"
  },
  {
    "id": "s0349",
    "blockIndex": 64,
    "zh": "既知而不能討，彼知其不足畏也，則放縱而無所顧矣！"
  },
  {
    "id": "s0350",
    "blockIndex": 64,
    "zh": "是故知善而不能用，知惡而不能去，人主之深戒也。"
  },
  {
    "id": "s0351",
    "blockIndex": 65,
    "zh": "下邳周紆為雒陽令，下車，先問大姓主名；"
  },
  {
    "id": "s0352",
    "blockIndex": 65,
    "zh": "吏數閭裡豪強以對。"
  },
  {
    "id": "s0353",
    "blockIndex": 65,
    "zh": "紆厲聲怒曰：「本問貴戚若馬、竇等輩，豈能知此賣菜傭乎！"
  },
  {
    "id": "s0354",
    "blockIndex": 65,
    "zh": "」於是部吏望風旨，爭以激切為事，貴戚跼蹐，京師肅清。"
  },
  {
    "id": "s0355",
    "blockIndex": 65,
    "zh": "竇篤夜至止奸亭，亭長霍延拔劍擬篤，肆詈恣口。"
  },
  {
    "id": "s0356",
    "blockIndex": 65,
    "zh": "篤以表聞，詔召司隸校尉、河南尹詣尚書譴問；"
  },
  {
    "id": "s0357",
    "blockIndex": 65,
    "zh": "遣劍戟士收紆，送廷尉詔獄，數日，貰出之。"
  },
  {
    "id": "s0358",
    "blockIndex": 66,
    "zh": "帝拜班超為將兵長史，以徐幹為軍司馬，別遣衛侯李邑護送烏孫使者。"
  },
  {
    "id": "s0359",
    "blockIndex": 66,
    "zh": "邑到於窴，值龜茲攻疏勒，恐懼不敢前，因上書陳西域之功不可成，又盛毀超：「擁愛妻，抱愛子，安樂外國，無內顧心。"
  },
  {
    "id": "s0360",
    "blockIndex": 66,
    "zh": "」超聞之歎曰：「身非曾參而有三至之讒，恐見疑於當時矣！"
  },
  {
    "id": "s0361",
    "blockIndex": 66,
    "zh": "」遂去其妻。"
  },
  {
    "id": "s0362",
    "blockIndex": 66,
    "zh": "帝知超忠，乃切責邑曰：「縱超擁愛妻，抱愛子，思歸之士千餘人，何能盡與超同心乎！"
  },
  {
    "id": "s0363",
    "blockIndex": 66,
    "zh": "」令邑詣超受節度，詔：「若邑任在外者，便留與從事。"
  },
  {
    "id": "s0364",
    "blockIndex": 66,
    "zh": "」超即遣邑將烏孫侍子還京師。"
  },
  {
    "id": "s0365",
    "blockIndex": 66,
    "zh": "徐幹謂超曰：「邑前親毀君，欲敗西域，今何不緣詔書留之，更遣它吏送侍子乎？"
  },
  {
    "id": "s0366",
    "blockIndex": 66,
    "zh": "」超曰：「是何言之陋也！"
  },
  {
    "id": "s0367",
    "blockIndex": 66,
    "zh": "以邑毀超，故今遣之。"
  },
  {
    "id": "s0368",
    "blockIndex": 66,
    "zh": "內省不疚，何恤人言！"
  },
  {
    "id": "s0369",
    "blockIndex": 66,
    "zh": "快意留之，非忠臣也。"
  },
  {
    "id": "s0371",
    "blockIndex": 67,
    "zh": "帝以侍中會稽鄭弘為大司農。"
  },
  {
    "id": "s0372",
    "blockIndex": 67,
    "zh": "舊交趾七郡貢獻轉運，皆從東冶泛海而至，風波艱阻，沒溺相系。"
  },
  {
    "id": "s0373",
    "blockIndex": 67,
    "zh": "弘奏開零陵、桂陽嶠道，自是夷通，遂為常路。"
  },
  {
    "id": "s0374",
    "blockIndex": 67,
    "zh": "在職二年，所息省以億萬計。"
  },
  {
    "id": "s0375",
    "blockIndex": 67,
    "zh": "遭天下旱，邊方有警，民食不足，而帑藏殷積。"
  },
  {
    "id": "s0376",
    "blockIndex": 67,
    "zh": "弘又奏宜省貢獻，減徭費以利饑民；"
  },
  {
    "id": "s0377",
    "blockIndex": 67,
    "zh": "帝從之。"
  },
  {
    "id": "s0378",
    "blockIndex": 68,
    "zh": "春，閏正月，辛丑，濟陰悼王長薨。"
  },
  {
    "id": "s0379",
    "blockIndex": 69,
    "zh": "夏，四月，己卯，分東平國，封獻王子尚為任城王。"
  },
  {
    "id": "s0380",
    "blockIndex": 70,
    "zh": "六月，辛酉，沛獻王輔薨。"
  },
  {
    "id": "s0381",
    "blockIndex": 71,
    "zh": "陳事者多言「郡國貢舉，率非功次，故守職益懈而吏事浸疏，咎在州郡。"
  },
  {
    "id": "s0382",
    "blockIndex": 71,
    "zh": "」有詔下公卿朝臣議。"
  },
  {
    "id": "s0383",
    "blockIndex": 71,
    "zh": "大鴻臚韋彪上議曰：「夫國以簡賢為務，賢以孝行為首，是以求忠臣必於孝子之門。"
  },
  {
    "id": "s0384",
    "blockIndex": 71,
    "zh": "夫人才行少能相兼，是以孟公綽優於趙、魏老，不可以為滕、薛大夫。"
  },
  {
    "id": "s0385",
    "blockIndex": 71,
    "zh": "忠孝之人，持心近厚；"
  },
  {
    "id": "s0386",
    "blockIndex": 71,
    "zh": "鍛練之吏，持心近薄。"
  },
  {
    "id": "s0387",
    "blockIndex": 71,
    "zh": "士宜以才行為先，不可純以閥閱。"
  },
  {
    "id": "s0388",
    "blockIndex": 71,
    "zh": "然其要歸，在於選二千石。"
  },
  {
    "id": "s0389",
    "blockIndex": 71,
    "zh": "二千石賢，則貢舉皆得其人矣。"
  },
  {
    "id": "s0390",
    "blockIndex": 71,
    "zh": "」彪又上疏曰：「天下樞要，在於尚書，尚書之選，豈可不重！"
  },
  {
    "id": "s0391",
    "blockIndex": 71,
    "zh": "而間者多從郎官超升此位，雖曉習文法，長於應對，然察察小慧，類無大能。"
  },
  {
    "id": "s0392",
    "blockIndex": 71,
    "zh": "宜鑒嗇夫捷急之對，深思絳侯木訥之功也。"
  },
  {
    "id": "s0393",
    "blockIndex": 71,
    "zh": "」帝皆納之。"
  },
  {
    "id": "s0394",
    "blockIndex": 71,
    "zh": "彪，賢之玄孫也。"
  },
  {
    "id": "s0395",
    "blockIndex": 72,
    "zh": "秋，七月，丁未，詔曰：「律云：『掠者唯得榜、笞、立』；"
  },
  {
    "id": "s0396",
    "blockIndex": 72,
    "zh": "又《令丙》，棰長短有數。"
  },
  {
    "id": "s0397",
    "blockIndex": 72,
    "zh": "自往者大獄已來，掠者多酷，鑽金贊之屬，慘苦無極。"
  },
  {
    "id": "s0398",
    "blockIndex": 72,
    "zh": "念其痛毒，怵然動心。"
  },
  {
    "id": "s0399",
    "blockIndex": 72,
    "zh": "宜及秋冬治獄，明為其禁。"
  },
  {
    "id": "s0401",
    "blockIndex": 73,
    "zh": "八月，甲子，太尉鄧彪罷，以大司農鄭弘為太尉。"
  },
  {
    "id": "s0402",
    "blockIndex": 74,
    "zh": "癸酉，詔改元。"
  },
  {
    "id": "s0403",
    "blockIndex": 75,
    "zh": "丁酉，車駕南巡。"
  },
  {
    "id": "s0404",
    "blockIndex": 75,
    "zh": "詔：「所經道上郡縣，無得設儲跱。"
  },
  {
    "id": "s0405",
    "blockIndex": 75,
    "zh": "命司空自將徒支柱橋樑。"
  },
  {
    "id": "s0406",
    "blockIndex": 75,
    "zh": "有遣使奉迎，探知起居，二千石當坐。"
  },
  {
    "id": "s0408",
    "blockIndex": 76,
    "zh": "九月，辛丑，幸章陵；"
  },
  {
    "id": "s0409",
    "blockIndex": 76,
    "zh": "十月，己未，進幸江陵；"
  },
  {
    "id": "s0410",
    "blockIndex": 76,
    "zh": "還，幸宛。"
  },
  {
    "id": "s0411",
    "blockIndex": 76,
    "zh": "召前臨淮太守宛人朱暉，拜尚書僕射。"
  },
  {
    "id": "s0412",
    "blockIndex": 76,
    "zh": "暉在臨淮，有善政，民歌之曰：「強直自遂，南陽朱季，吏畏其威，民懷其惠。"
  },
  {
    "id": "s0413",
    "blockIndex": 76,
    "zh": "」時坐法免，家居，故上召而用之。"
  },
  {
    "id": "s0414",
    "blockIndex": 76,
    "zh": "十一月，己丑，車駕還宮。"
  },
  {
    "id": "s0415",
    "blockIndex": 76,
    "zh": "尚書張林上言：「縣官經用不足，宜自煮鹽，及復修武帝均輸之法。"
  },
  {
    "id": "s0416",
    "blockIndex": 76,
    "zh": "」朱暉固執以為不可，曰：「均輸之法，與賈販無異，鹽利歸官，則下民窮怨，誠非明主所宜行。"
  },
  {
    "id": "s0417",
    "blockIndex": 76,
    "zh": "」帝因發怒切責諸尚書，暉等皆自繫獄。"
  },
  {
    "id": "s0418",
    "blockIndex": 76,
    "zh": "三日，詔敕出之，曰：「國家樂聞駁議，黃發無愆。"
  },
  {
    "id": "s0419",
    "blockIndex": 76,
    "zh": "詔書過耳，何故自系！"
  },
  {
    "id": "s0420",
    "blockIndex": 76,
    "zh": "」暉因稱病篤，不肯復署議。"
  },
  {
    "id": "s0421",
    "blockIndex": 76,
    "zh": "尚書令以下惶怖，謂暉曰：「今臨得譴讓，奈何稱病，其禍不細！"
  },
  {
    "id": "s0422",
    "blockIndex": 76,
    "zh": "」暉曰：「行年八十，蒙恩得在機密，當以死報。"
  },
  {
    "id": "s0423",
    "blockIndex": 76,
    "zh": "若心知不可，而順旨雷同，負臣子之義！"
  },
  {
    "id": "s0424",
    "blockIndex": 76,
    "zh": "今耳目無所聞見，伏待死命。"
  },
  {
    "id": "s0425",
    "blockIndex": 76,
    "zh": "」遂閉口不復言。"
  },
  {
    "id": "s0426",
    "blockIndex": 76,
    "zh": "諸尚書不知所為，乃共劾奏暉。"
  },
  {
    "id": "s0427",
    "blockIndex": 76,
    "zh": "帝意解，寢其事。"
  },
  {
    "id": "s0428",
    "blockIndex": 76,
    "zh": "後數日，詔使直事郎問暉起居，太醫視疾，太官賜食，暉乃起謝；"
  },
  {
    "id": "s0429",
    "blockIndex": 76,
    "zh": "復賜錢十萬，布百匹，衣十領。"
  },
  {
    "id": "s0430",
    "blockIndex": 77,
    "zh": "魯國孔僖、涿郡崔□因同游太學，相與論：「孝武皇帝，始為天子，崇信聖道，五六年間，號勝文、景；"
  },
  {
    "id": "s0431",
    "blockIndex": 77,
    "zh": "及後恣己，忘其前善。"
  },
  {
    "id": "s0432",
    "blockIndex": 77,
    "zh": "」鄰房生梁郁上書，告「駰、僖誹謗先帝，刺譏當世」，事下有司。"
  },
  {
    "id": "s0433",
    "blockIndex": 77,
    "zh": "□因詣吏受訊。"
  },
  {
    "id": "s0434",
    "blockIndex": 77,
    "zh": "僖以書自訟曰：「凡言誹謗者，謂實無此事而虛加誣之也。"
  },
  {
    "id": "s0435",
    "blockIndex": 77,
    "zh": "至如孝武皇帝，政之美惡，顯在漢史，坦如日月，是為直說書傳實事，非虛謗也。"
  },
  {
    "id": "s0436",
    "blockIndex": 77,
    "zh": "夫帝者，為善為惡，天下莫不知，斯皆有以致之，故不可以誅於人也。"
  },
  {
    "id": "s0437",
    "blockIndex": 77,
    "zh": "且陛下即位以來，政教未過而德澤有加，天下所具知也，臣等獨何譏刺哉！"
  },
  {
    "id": "s0438",
    "blockIndex": 77,
    "zh": "假使所非實是，則固應悛改，儻其不當，亦宜含容，又何罪焉！"
  },
  {
    "id": "s0439",
    "blockIndex": 77,
    "zh": "陛下不推原大數，深自為計，徒肆私忌以快其意，臣等受戮，死即死耳，顧天下之人，必回視易慮，以此事窺陛下心，自今以後，苟見不可之事，終莫復言者矣。"
  },
  {
    "id": "s0440",
    "blockIndex": 77,
    "zh": "齊桓公親揚其先君之惡以唱管仲，然後群臣得盡其心，今陛下乃欲為十世之武帝遠諱實事，豈不與桓公異哉！"
  },
  {
    "id": "s0441",
    "blockIndex": 77,
    "zh": "臣恐有司卒然見構，銜恨蒙枉，不得自敘，使後世論者擅以陛下有所比方，寧可復使子孫追掩之乎！"
  },
  {
    "id": "s0442",
    "blockIndex": 77,
    "zh": "謹詣闕伏待重誅。"
  },
  {
    "id": "s0443",
    "blockIndex": 77,
    "zh": "」書奏，帝立詔勿問，拜僖蘭台令史。"
  },
  {
    "id": "s0444",
    "blockIndex": 78,
    "zh": "十二月，壬子，詔：「前以妖惡禁錮三屬者，一皆蠲除之，但不得在宿衛而已。"
  },
  {
    "id": "s0446",
    "blockIndex": 79,
    "zh": "廬江毛義，東平鄭均，皆以行義稱於鄉里。"
  },
  {
    "id": "s0447",
    "blockIndex": 79,
    "zh": "南陽張奉慕義名，往候之，坐定而府檄適至，以義守安陽令，以捧檄而入，喜動顏色，奉心賤之，辭去。"
  },
  {
    "id": "s0448",
    "blockIndex": 79,
    "zh": "後義母死。"
  },
  {
    "id": "s0449",
    "blockIndex": 79,
    "zh": "征辟皆不至，奉乃歎曰：「賢者固不可測。"
  },
  {
    "id": "s0450",
    "blockIndex": 79,
    "zh": "往日之喜，乃為親屈也。"
  },
  {
    "id": "s0451",
    "blockIndex": 79,
    "zh": "」均兄為縣吏，頗受禮遺，均諫不聽，乃脫身為傭，歲餘得錢帛，歸以與兄曰：「物盡可復得，為吏坐臧，終身捐棄。"
  },
  {
    "id": "s0452",
    "blockIndex": 79,
    "zh": "」兄感其言，遂為廉潔。"
  },
  {
    "id": "s0453",
    "blockIndex": 79,
    "zh": "均仕為尚書，免歸。"
  },
  {
    "id": "s0454",
    "blockIndex": 79,
    "zh": "帝下詔褒寵義、均，賜谷各千斛，常以八月長吏差問起居，加賜羊酒。"
  },
  {
    "id": "s0455",
    "blockIndex": 80,
    "zh": "武威太守孟雲上言：「北匈奴復願與吏民合市。"
  },
  {
    "id": "s0456",
    "blockIndex": 80,
    "zh": "」詔許之。"
  },
  {
    "id": "s0457",
    "blockIndex": 80,
    "zh": "北匈奴大且渠伊莫訾王等驅牛馬萬餘頭來與漢交易，南單于遣輕騎出上郡鈔之，大獲而還。"
  },
  {
    "id": "s0458",
    "blockIndex": 81,
    "zh": "帝復遣假司馬和恭等將兵八百人詣班超，超因發疏勒、於窴兵擊莎車。"
  },
  {
    "id": "s0459",
    "blockIndex": 81,
    "zh": "莎車以賂誘疏勒王忠，忠遂反，從之，西保烏即城。"
  },
  {
    "id": "s0460",
    "blockIndex": 81,
    "zh": "超乃更立其府丞成大為疏勒王，悉發其不反者以攻忠。"
  },
  {
    "id": "s0461",
    "blockIndex": 81,
    "zh": "使人說康居王執忠以歸其國，烏即城遂降。"
  },
  {
    "id": "s0462",
    "blockIndex": 82,
    "zh": "category:資治通鑑"
  }
]
