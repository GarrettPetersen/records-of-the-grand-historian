[
  {
    "id": "s0001",
    "blockIndex": 0,
    "zh": "資治通鑑第050卷"
  },
  {
    "id": "s0002",
    "blockIndex": 1,
    "zh": "【漢紀四十二】起柔兆執徐，盡閼逢困敦，凡九年。"
  },
  {
    "id": "s0003",
    "blockIndex": 2,
    "zh": "春，正月，蒼梧、鬱林、合浦蠻夷反；"
  },
  {
    "id": "s0004",
    "blockIndex": 2,
    "zh": "二月，遣侍御史任逴督州郡兵討之。"
  },
  {
    "id": "s0005",
    "blockIndex": 3,
    "zh": "郡國十地震。"
  },
  {
    "id": "s0006",
    "blockIndex": 4,
    "zh": "三月，辛亥，日有食之。"
  },
  {
    "id": "s0007",
    "blockIndex": 5,
    "zh": "夏，四月，京師旱。"
  },
  {
    "id": "s0008",
    "blockIndex": 6,
    "zh": "五月，武陵蠻反，州郡討破之。"
  },
  {
    "id": "s0009",
    "blockIndex": 7,
    "zh": "癸酉，度遼將軍鄧遵率南單于擊零昌於靈州，斬首八百餘級。"
  },
  {
    "id": "s0010",
    "blockIndex": 8,
    "zh": "越巂徼外夷舉種內屬。"
  },
  {
    "id": "s0011",
    "blockIndex": 9,
    "zh": "六月，中郎將任尚遣兵擊破先零羌於丁奚城。"
  },
  {
    "id": "s0012",
    "blockIndex": 10,
    "zh": "秋，七月，武陵蠻復反，州郡討平之。"
  },
  {
    "id": "s0013",
    "blockIndex": 11,
    "zh": "九月，築馮翊北界候塢五百所以備羌。"
  },
  {
    "id": "s0014",
    "blockIndex": 12,
    "zh": "冬，十一月，蒼梧、鬱林、合浦蠻夷降。"
  },
  {
    "id": "s0015",
    "blockIndex": 12,
    "zh": "舊制：公卿、二千石、刺史不得行三年喪，司徒劉愷以為「非所以師表百姓，宣美風俗。"
  },
  {
    "id": "s0016",
    "blockIndex": 12,
    "zh": "」丙戌，初聽大臣行三年喪。"
  },
  {
    "id": "s0017",
    "blockIndex": 13,
    "zh": "癸卯，郡國九地震。"
  },
  {
    "id": "s0018",
    "blockIndex": 14,
    "zh": "十二月，丁巳，任尚遣兵擊零昌於北地，殺其妻子，燒其廬落，斬首七百餘級。"
  },
  {
    "id": "s0019",
    "blockIndex": 15,
    "zh": "春，二月，乙巳朔，日有食之。"
  },
  {
    "id": "s0020",
    "blockIndex": 16,
    "zh": "乙卯，赦天下。"
  },
  {
    "id": "s0021",
    "blockIndex": 17,
    "zh": "壬戌，武庫災。"
  },
  {
    "id": "s0022",
    "blockIndex": 18,
    "zh": "任尚遣當闐種羌榆鬼等刺殺杜季貢，封榆鬼為破羌侯。"
  },
  {
    "id": "s0023",
    "blockIndex": 19,
    "zh": "司空袁敞，廉勁不阿權貴，失鄧氏旨。"
  },
  {
    "id": "s0024",
    "blockIndex": 19,
    "zh": "尚書郎張俊有私書與敞子俊，怨家封上之。"
  },
  {
    "id": "s0025",
    "blockIndex": 19,
    "zh": "夏，四月，戊申，敞坐策免，自殺；"
  },
  {
    "id": "s0026",
    "blockIndex": 19,
    "zh": "俊等下獄當死。"
  },
  {
    "id": "s0027",
    "blockIndex": 19,
    "zh": "俊上書自訟；"
  },
  {
    "id": "s0028",
    "blockIndex": 19,
    "zh": "臨刑，太后詔以減死論。"
  },
  {
    "id": "s0029",
    "blockIndex": 20,
    "zh": "己巳，遼西鮮卑連休等入寇，郡兵與烏桓大人於秩居等共擊，大破之，斬首千三百級。"
  },
  {
    "id": "s0030",
    "blockIndex": 21,
    "zh": "六月，戊辰，三郡雨雹。"
  },
  {
    "id": "s0031",
    "blockIndex": 22,
    "zh": "尹就坐不能定益州，征抵罪；"
  },
  {
    "id": "s0032",
    "blockIndex": 22,
    "zh": "以益州刺史張喬領其軍屯，招誘叛羌，稍稍降散。"
  },
  {
    "id": "s0033",
    "blockIndex": 23,
    "zh": "秋，七月，京師及郡國十雨水。"
  },
  {
    "id": "s0034",
    "blockIndex": 24,
    "zh": "九月，護羌校尉任尚復募效功種羌號封刺殺零昌；"
  },
  {
    "id": "s0035",
    "blockIndex": 24,
    "zh": "封號封為羌王。"
  },
  {
    "id": "s0036",
    "blockIndex": 25,
    "zh": "冬，十一月，己卯，彭城靖王恭薨。"
  },
  {
    "id": "s0037",
    "blockIndex": 26,
    "zh": "越巂夷以郡縣賦斂煩數，十二月，大牛種封離等反，殺遂久令。"
  },
  {
    "id": "s0038",
    "blockIndex": 27,
    "zh": "甲子，任尚與騎都尉馬賢共擊先零羌狼莫，追至北地，相持六十餘日，戰於富平河上，大破之，斬首五千級，狼莫逃去。"
  },
  {
    "id": "s0039",
    "blockIndex": 27,
    "zh": "於是西河虔人種羌萬人詣鄧遵降，隴右平。"
  },
  {
    "id": "s0040",
    "blockIndex": 28,
    "zh": "是歲，郡國十三地震。"
  },
  {
    "id": "s0041",
    "blockIndex": 29,
    "zh": "春，三月，京師及郡國五旱。"
  },
  {
    "id": "s0042",
    "blockIndex": 30,
    "zh": "夏，六月，高句驪與濊貊寇玄菟。"
  },
  {
    "id": "s0043",
    "blockIndex": 31,
    "zh": "永昌、益州、蜀郡夷皆叛應封離，眾至十餘萬，破壞二十餘縣，殺長吏，焚掠百姓，骸骨委積，千里無人。"
  },
  {
    "id": "s0044",
    "blockIndex": 32,
    "zh": "秋，八月，丙申朔，日有食之。"
  },
  {
    "id": "s0045",
    "blockIndex": 33,
    "zh": "代郡鮮卑入寇，殺長史；"
  },
  {
    "id": "s0046",
    "blockIndex": 33,
    "zh": "發緣邊甲卒、黎陽營兵屯上谷以備之。"
  },
  {
    "id": "s0047",
    "blockIndex": 33,
    "zh": "冬，十月，鮮卑寇上谷，攻居庸關，復發緣邊諸郡黎陽營兵、積射士步騎二萬人屯列衝要。"
  },
  {
    "id": "s0048",
    "blockIndex": 34,
    "zh": "鄧遵募上郡全無種羌雕何刺殺狼莫；"
  },
  {
    "id": "s0049",
    "blockIndex": 34,
    "zh": "封雕何為羌侯。"
  },
  {
    "id": "s0050",
    "blockIndex": 34,
    "zh": "自羌叛十餘年間，軍旅之費，凡用二百四十餘億，府帑空竭，邊民及內郡死者不可勝數，並、涼二州遂至虛耗。"
  },
  {
    "id": "s0051",
    "blockIndex": 34,
    "zh": "及零昌、狼莫死，諸羌瓦解，三輔、益州無復寇警。"
  },
  {
    "id": "s0052",
    "blockIndex": 34,
    "zh": "詔封鄧遵為武陽侯，邑三千戶。"
  },
  {
    "id": "s0053",
    "blockIndex": 34,
    "zh": "遵以太后從弟，故爵封優大。"
  },
  {
    "id": "s0054",
    "blockIndex": 34,
    "zh": "任尚與遵爭功，又坐詐增首級、受賕枉法贓千萬已上，十二月，檻車征尚，棄市，沒入財物。"
  },
  {
    "id": "s0055",
    "blockIndex": 34,
    "zh": "鄧騭子侍中鳳嘗受尚馬，騭髡妻及鳳以謝罪。"
  },
  {
    "id": "s0056",
    "blockIndex": 35,
    "zh": "是歲，郡國十四地震。"
  },
  {
    "id": "s0057",
    "blockIndex": 36,
    "zh": "太后弟悝、閶皆卒，封悝子廣宗為葉侯，閶子忠為西華侯。"
  },
  {
    "id": "s0058",
    "blockIndex": 37,
    "zh": "春，二月，乙巳，京師及郡國四十二地震。"
  },
  {
    "id": "s0059",
    "blockIndex": 38,
    "zh": "夏，四月，沛國、勃海大風，雨雹。"
  },
  {
    "id": "s0060",
    "blockIndex": 39,
    "zh": "五月，京師旱。"
  },
  {
    "id": "s0061",
    "blockIndex": 40,
    "zh": "六月，丙戌，平原哀王得薨，無子。"
  },
  {
    "id": "s0062",
    "blockIndex": 41,
    "zh": "秋，七月，鮮卑寇馬城塞，殺長吏，度遼將軍鄧遵及中郎將馬續率南單于追擊，大破之。"
  },
  {
    "id": "s0063",
    "blockIndex": 42,
    "zh": "九月，癸巳，陳懷王竦薨，無子，國除。"
  },
  {
    "id": "s0064",
    "blockIndex": 43,
    "zh": "冬，十二月，戊午朔，日有食之，既。"
  },
  {
    "id": "s0065",
    "blockIndex": 44,
    "zh": "郡國八地震。"
  },
  {
    "id": "s0066",
    "blockIndex": 45,
    "zh": "是歲，太后征和帝弟濟北王壽、河間王開子男女年五歲以上四十餘人，及鄧氏近親子孫三十餘人，並為開邸第，教學經書，躬自監試。"
  },
  {
    "id": "s0067",
    "blockIndex": 45,
    "zh": "詔從兄河南尹豹、越騎校尉康等曰：「末世貴戚食祿之家，溫衣美飯，乘堅驅良，而面牆術學，不識臧否，斯故禍敗所從來也。"
  },
  {
    "id": "s0069",
    "blockIndex": 46,
    "zh": "豫章有芝草生，太守劉祗欲上之，以問郡人唐檀，檀曰：「方今外戚豪盛，君道微弱，斯豈嘉瑞乎！"
  },
  {
    "id": "s0070",
    "blockIndex": 46,
    "zh": "」祗乃止。"
  },
  {
    "id": "s0071",
    "blockIndex": 47,
    "zh": "益州刺史張喬遣從事楊竦將兵至楪榆，擊封離等，大破之，斬首三萬餘級，獲生口千五百人。"
  },
  {
    "id": "s0072",
    "blockIndex": 47,
    "zh": "封離等惶怖，斬其同謀渠帥，詣竦乞降。"
  },
  {
    "id": "s0073",
    "blockIndex": 47,
    "zh": "竦厚加慰納，其餘三十六種皆來降附。"
  },
  {
    "id": "s0074",
    "blockIndex": 47,
    "zh": "竦因奏長吏奸猾，侵犯蠻夷者九十人，皆減死論。"
  },
  {
    "id": "s0075",
    "blockIndex": 48,
    "zh": "初，西域諸國既絕於漢，北匈奴復以兵威役屬之，與共為邊寇。"
  },
  {
    "id": "s0076",
    "blockIndex": 48,
    "zh": "敦煌太守曹宗患之，乃上遣行長史索班將千餘人屯伊吾以招撫之。"
  },
  {
    "id": "s0077",
    "blockIndex": 48,
    "zh": "於是車師前王及鄯善王復來降。"
  },
  {
    "id": "s0078",
    "blockIndex": 49,
    "zh": "初，疏勒王安國死，無子，國人立其舅子遺腹為王，遺腹叔父臣磐在月氏，月氏納而立之。"
  },
  {
    "id": "s0079",
    "blockIndex": 49,
    "zh": "後莎車畔於窴，屬疏勒，疏勒遂強，與龜茲、於窴為敵國焉。"
  },
  {
    "id": "s0080",
    "blockIndex": 50,
    "zh": "春，三月，丁酉，濟北惠王壽薨。"
  },
  {
    "id": "s0081",
    "blockIndex": 51,
    "zh": "北匈奴率車師後王軍就共殺後部司馬及敦煌長史索班等，遂擊走其前王，略有北道。"
  },
  {
    "id": "s0082",
    "blockIndex": 51,
    "zh": "鄯善逼急，求救於曹宗，宗因此請出兵五千人擊匈奴，以報索班之恥，因復取西域；"
  },
  {
    "id": "s0083",
    "blockIndex": 51,
    "zh": "公卿多以為宜閉玉門關，絕西域。"
  },
  {
    "id": "s0084",
    "blockIndex": 51,
    "zh": "太后聞軍司馬班勇有父風，召詣朝堂問之。"
  },
  {
    "id": "s0085",
    "blockIndex": 51,
    "zh": "為上議曰：「昔孝武皇帝患匈奴強盛，於是開通西域，論者以為奪匈奴府藏，斷其右臂。"
  },
  {
    "id": "s0086",
    "blockIndex": 51,
    "zh": "光武中興，未遑外事，故匈奴負強，驅率諸國；"
  },
  {
    "id": "s0087",
    "blockIndex": 51,
    "zh": "及至永平，再攻敦煌，河西諸郡，城門晝閉。"
  },
  {
    "id": "s0088",
    "blockIndex": 51,
    "zh": "孝明皇帝深惟廟策，乃命虎臣出征西域，故匈奴遠遁，邊境得安；"
  },
  {
    "id": "s0089",
    "blockIndex": 51,
    "zh": "及至永元，莫不內屬。"
  },
  {
    "id": "s0090",
    "blockIndex": 51,
    "zh": "會間者羌亂，西域復絕，北虜遂遣責諸國，備其逋租，高其價直，嚴以期會，鄯善、車師皆懷憤怨，思樂事漢，其路無從；"
  },
  {
    "id": "s0091",
    "blockIndex": 51,
    "zh": "前所以時有叛者，皆由牧養失宜，還為其害故也。"
  },
  {
    "id": "s0092",
    "blockIndex": 51,
    "zh": "今曹宗徒恥於前負，欲報雪匈奴，而不尋出兵故事，未度當時之宜也。"
  },
  {
    "id": "s0093",
    "blockIndex": 51,
    "zh": "夫要功荒外，萬無一成。"
  },
  {
    "id": "s0094",
    "blockIndex": 51,
    "zh": "若兵連禍結，悔無所及。"
  },
  {
    "id": "s0095",
    "blockIndex": 51,
    "zh": "況今府藏未充，師無後繼，是示弱於遠夷，暴短於海內，臣愚以為不可許也。"
  },
  {
    "id": "s0096",
    "blockIndex": 51,
    "zh": "舊敦煌郡有營兵三百人，今宜復之，復置護西域副校尉，居於敦煌，如永元故事，又宜遣西域長史將五百人屯樓蘭，西當焉耆、龜茲徑路，南強鄯善、於窴心膽，北扞匈奴，東近敦煌，如此誠便。"
  },
  {
    "id": "s0098",
    "blockIndex": 52,
    "zh": "尚書復問勇：「利害云何？"
  },
  {
    "id": "s0099",
    "blockIndex": 52,
    "zh": "」勇對曰：「昔永平之末，始通西域，初遣申郎將居敦煌，後置副校於車師，既為胡虜節度，又禁漢人不得有所侵擾，故外夷歸心，匈奴畏威。"
  },
  {
    "id": "s0100",
    "blockIndex": 52,
    "zh": "今鄯善王尤還，漢人外孫。"
  },
  {
    "id": "s0101",
    "blockIndex": 52,
    "zh": "若匈奴得志，則尤還必死。"
  },
  {
    "id": "s0102",
    "blockIndex": 52,
    "zh": "此等雖同鳥獸，亦知避害，若出屯樓蘭，足以招附其心，愚以為便。"
  },
  {
    "id": "s0103",
    "blockIndex": 52,
    "zh": "」長樂衛尉鐔顯、廷尉綦毋參、司隸校尉崔據難曰：「朝廷前所以棄西域者，以其無益於中國，而費難供也。"
  },
  {
    "id": "s0104",
    "blockIndex": 52,
    "zh": "今車師已屬匈奴，鄯善不可保信，一旦反覆，班將能保北虜不為邊害乎？"
  },
  {
    "id": "s0105",
    "blockIndex": 52,
    "zh": "」勇對曰；"
  },
  {
    "id": "s0106",
    "blockIndex": 52,
    "zh": "「今中國置州牧者，以禁郡縣奸猾盜賊也。"
  },
  {
    "id": "s0107",
    "blockIndex": 52,
    "zh": "若州牧能保盜賊不起者，臣亦願以要斬保匈奴之不為邊害也。"
  },
  {
    "id": "s0108",
    "blockIndex": 52,
    "zh": "今通西域則虜勢必弱，虜勢弱則為患微矣；"
  },
  {
    "id": "s0109",
    "blockIndex": 52,
    "zh": "孰與歸其府藏，續其斷臂哉？"
  },
  {
    "id": "s0110",
    "blockIndex": 52,
    "zh": "今置校尉以扞撫西域，設長史以招懷諸國，若棄而不立，則西域望絕，望絕之後，屈就北虜，緣邊之郡將受困害，恐河西城門必須復有晝閉之儆矣！"
  },
  {
    "id": "s0111",
    "blockIndex": 52,
    "zh": "今不廓開朝廷之德而拘屯戍之費，若此，北虜遂熾，豈安邊久長之策哉！"
  },
  {
    "id": "s0112",
    "blockIndex": 52,
    "zh": "」太尉屬毛軫難曰：「今若置校尉，則西域駱驛遣使，求索無厭，與之則費難供，不與則失其心，一旦為匈奴所迫，當復求救，則為役大矣。"
  },
  {
    "id": "s0113",
    "blockIndex": 52,
    "zh": "」勇對曰：「今設以西域歸匈奴，而使其恩德大漢，不為鈔盜，則可矣。"
  },
  {
    "id": "s0114",
    "blockIndex": 52,
    "zh": "如其不然，則因西域租入之饒，兵馬之眾，以擾動緣邊，是為富仇讎之財，增暴夷之勢也。"
  },
  {
    "id": "s0115",
    "blockIndex": 52,
    "zh": "置校尉者，宣威布德，以系諸國內向之心，以疑匈奴覬覦之情，而無費財耗國之慮也。"
  },
  {
    "id": "s0116",
    "blockIndex": 52,
    "zh": "且西域之人，無它求索，其來入者不過稟食而已；"
  },
  {
    "id": "s0117",
    "blockIndex": 52,
    "zh": "今若拒絕，勢歸北屬夷虜，並力以寇並、涼，則中國之費不止十億。"
  },
  {
    "id": "s0118",
    "blockIndex": 52,
    "zh": "置之誠便。"
  },
  {
    "id": "s0119",
    "blockIndex": 52,
    "zh": "」於是從勇議，復敦煌郡營兵三百人，置西域副校尉居敦煌，雖復羈縻西域，然亦未能出屯。"
  },
  {
    "id": "s0120",
    "blockIndex": 52,
    "zh": "其後匈奴果數與車師共入寇鈔，河西大被其害。"
  },
  {
    "id": "s0121",
    "blockIndex": 52,
    "zh": "沈氐羌寇張掖。"
  },
  {
    "id": "s0122",
    "blockIndex": 53,
    "zh": "夏，四月，丙寅，立皇子保為太子，改元，赦天下。"
  },
  {
    "id": "s0123",
    "blockIndex": 54,
    "zh": "己巳，紹封陳敬王子崇為陳王，濟北惠王子萇為樂成王，河間孝王子翼為平原王。"
  },
  {
    "id": "s0124",
    "blockIndex": 55,
    "zh": "六月，護羌校尉馬賢將萬人討沈氐羌於張掖，破之，斬首千八百級，獲生口千餘人，餘虜悉降。"
  },
  {
    "id": "s0125",
    "blockIndex": 55,
    "zh": "時當煎種大豪饑五等，以賢兵在張掖，乃乘虛寇金城，賢還軍追之出塞，斬首數千級而還。"
  },
  {
    "id": "s0126",
    "blockIndex": 55,
    "zh": "燒當、燒何種聞賢軍還，復寇張掖，殺長吏。"
  },
  {
    "id": "s0127",
    "blockIndex": 56,
    "zh": "秋，七月，乙酉朔，日有食之。"
  },
  {
    "id": "s0128",
    "blockIndex": 57,
    "zh": "冬，十月，己巳，司空李郃免。"
  },
  {
    "id": "s0129",
    "blockIndex": 57,
    "zh": "癸酉，以衛尉廬江陳褒為司空。"
  },
  {
    "id": "s0130",
    "blockIndex": 58,
    "zh": "京師及郡國三十三大水。"
  },
  {
    "id": "s0131",
    "blockIndex": 59,
    "zh": "十二月，永昌徼外撣國王雍曲調遣使者獻樂及幻人。"
  },
  {
    "id": "s0132",
    "blockIndex": 60,
    "zh": "戊辰，司徒劉愷請致仕；"
  },
  {
    "id": "s0133",
    "blockIndex": 60,
    "zh": "許之，以千石祿歸養。"
  },
  {
    "id": "s0134",
    "blockIndex": 61,
    "zh": "遼西鮮卑大人烏倫、其至鞬各以其眾詣度遼將軍鄧遵降。"
  },
  {
    "id": "s0135",
    "blockIndex": 62,
    "zh": "癸酉，以太常楊震為司徒。"
  },
  {
    "id": "s0136",
    "blockIndex": 63,
    "zh": "是歲，郡國二十三地震。"
  },
  {
    "id": "s0137",
    "blockIndex": 64,
    "zh": "太后從弟越騎校尉康，以太后久臨朝政，宗門盛滿，數上書太后，以為宜崇公室，自損私權，言甚切至，太后不從。"
  },
  {
    "id": "s0138",
    "blockIndex": 64,
    "zh": "康謝病不朝，太后使內侍者問之；"
  },
  {
    "id": "s0139",
    "blockIndex": 64,
    "zh": "所使者乃康家先婢，自通「中大人」，康聞而詬之。"
  },
  {
    "id": "s0140",
    "blockIndex": 64,
    "zh": "婢怨恚，還，白康詐疾而言不遜。"
  },
  {
    "id": "s0141",
    "blockIndex": 64,
    "zh": "太后大怒，免康官，遣歸國，絕屬籍。"
  },
  {
    "id": "s0142",
    "blockIndex": 65,
    "zh": "初，當煎種饑五同種大豪盧匆心、忍良等千餘戶別留允街，而首施兩端。"
  },
  {
    "id": "s0143",
    "blockIndex": 66,
    "zh": "春，護羌校尉馬賢召盧匆++心，斬之，因放兵擊其種人，獲首虜二千餘，忍良等皆亡出塞。"
  },
  {
    "id": "s0144",
    "blockIndex": 67,
    "zh": "幽州刺史巴郡馮煥、玄菟太守姚光、遼東太守蔡諷等將兵擊高句麗，高句麗王宮遣嗣子遂成詐降，而襲玄菟、遼東，殺傷二千餘人。"
  },
  {
    "id": "s0145",
    "blockIndex": 68,
    "zh": "二月，皇太后寢疾，癸亥，赦天下。"
  },
  {
    "id": "s0146",
    "blockIndex": 68,
    "zh": "三月，癸巳，皇太后鄧氏崩。"
  },
  {
    "id": "s0147",
    "blockIndex": 68,
    "zh": "未及大斂，帝復申前命，封鄧騭為上蔡侯，位特進。"
  },
  {
    "id": "s0148",
    "blockIndex": 68,
    "zh": "丙午，葬和熹皇后。"
  },
  {
    "id": "s0149",
    "blockIndex": 68,
    "zh": "太后自臨朝以來，水旱十載，四夷外侵，盜賊內起，每聞民饑，或達旦不寐，躬自減徹以救災厄，故天下復平，歲還豐穰。"
  },
  {
    "id": "s0150",
    "blockIndex": 69,
    "zh": "上始親政事，尚書陳忠薦隱逸及直道之士穎川杜根、平原成翊世之徒，上皆納用之。"
  },
  {
    "id": "s0151",
    "blockIndex": 69,
    "zh": "忠，寵之子也。"
  },
  {
    "id": "s0152",
    "blockIndex": 69,
    "zh": "初，鄧太后臨朝，根為郎中，與同時郎上書言：「帝年長，宜親政事。"
  },
  {
    "id": "s0153",
    "blockIndex": 69,
    "zh": "」太后大怒，皆令盛以縑囊，於殿上撲殺之，既而載出城外，根得蘇；"
  },
  {
    "id": "s0154",
    "blockIndex": 69,
    "zh": "太后使人檢視，根遂詐死，三日，目中生蛆，因得逃竄，為宜城山中酒家保，積十五年。"
  },
  {
    "id": "s0155",
    "blockIndex": 69,
    "zh": "成翊世以郡吏亦坐諫太后不歸政抵罪。"
  },
  {
    "id": "s0156",
    "blockIndex": 69,
    "zh": "帝皆征詣公車，拜根侍御史，翊世尚書郎。"
  },
  {
    "id": "s0157",
    "blockIndex": 69,
    "zh": "或問根曰：「往者遇禍，天下同義，知故不少，何至自苦如此？"
  },
  {
    "id": "s0158",
    "blockIndex": 69,
    "zh": "」根曰：「周旋民間，非絕跡之處，邂逅發露，禍及親知，故不為也。"
  },
  {
    "id": "s0160",
    "blockIndex": 70,
    "zh": "戊申，追尊清河孝王曰孝德皇，皇妣左氏曰孝德後，祖妣宋貴人曰敬隱後。"
  },
  {
    "id": "s0161",
    "blockIndex": 70,
    "zh": "初，長樂太僕蔡倫受竇後諷旨誣陷宋貴人，帝敕使自致延尉，倫飲藥死。"
  },
  {
    "id": "s0162",
    "blockIndex": 71,
    "zh": "夏，四月，高句麗復與鮮卑入寇遼東，蔡諷追擊於新昌，戰歿。"
  },
  {
    "id": "s0163",
    "blockIndex": 71,
    "zh": "功曹掾龍端、兵馬掾公孫酺以身扞諷，俱沒於陳。"
  },
  {
    "id": "s0164",
    "blockIndex": 72,
    "zh": "丁巳，尊帝嫡母耿姬為甘陵大貴人。"
  },
  {
    "id": "s0165",
    "blockIndex": 73,
    "zh": "甲子，樂成王萇坐驕淫不法，貶為蕪湖侯。"
  },
  {
    "id": "s0166",
    "blockIndex": 74,
    "zh": "己巳，令公卿下至郡國守相各舉有道之士一人。"
  },
  {
    "id": "s0167",
    "blockIndex": 74,
    "zh": "尚書陳忠以詔書既開諫爭，慮言事者必多激切，或致不能容，乃上疏豫通廣帝意曰：「臣聞仁君廣山藪之大，納切直之謀，忠臣盡謇諤之節，不畏逆耳之害，是以高祖捨周昌桀、紂之譬，孝文嘉袁盎人豕之譏，武帝納東方朔宣室之正，元帝容薛廣德自刎之切。"
  },
  {
    "id": "s0168",
    "blockIndex": 74,
    "zh": "今明詔崇高宗之德，推宋景之誠，引咎克躬，諮訪群吏。"
  },
  {
    "id": "s0169",
    "blockIndex": 74,
    "zh": "言事者見杜根、成翊世等新蒙表錄，顯列二台，必承風響應，爭為切直。"
  },
  {
    "id": "s0170",
    "blockIndex": 74,
    "zh": "若嘉謀異策，宜輒納用；"
  },
  {
    "id": "s0171",
    "blockIndex": 74,
    "zh": "如其管穴，妄有譏刺，雖苦口逆耳，不得事實，且優遊寬容，以示聖朝無諱之美；"
  },
  {
    "id": "s0172",
    "blockIndex": 74,
    "zh": "若有道之士對問高者，宜垂省覽，特遷一等，以廣直言之路。"
  },
  {
    "id": "s0173",
    "blockIndex": 74,
    "zh": "」書御，有詔，拜有道高第士沛國施延為侍中。"
  },
  {
    "id": "s0174",
    "blockIndex": 75,
    "zh": "初，汝南薛包，少有至行，父娶後妻而憎包，分出之。"
  },
  {
    "id": "s0175",
    "blockIndex": 75,
    "zh": "包日夜號泣，不能去，至被驅撲，不得已，廬於捨外，旦入灑掃。"
  },
  {
    "id": "s0176",
    "blockIndex": 75,
    "zh": "父怒，又逐之，乃廬於里門，昏晨不廢。"
  },
  {
    "id": "s0177",
    "blockIndex": 75,
    "zh": "積歲餘，父母慚而還之。"
  },
  {
    "id": "s0178",
    "blockIndex": 75,
    "zh": "及父母亡，弟子求分財異居。"
  },
  {
    "id": "s0179",
    "blockIndex": 75,
    "zh": "包不能止，乃中分其財，奴婢引其老者，曰：「與我共事久，若不能使也。"
  },
  {
    "id": "s0180",
    "blockIndex": 75,
    "zh": "」田廬取其荒頓者，曰：「吾少時所治，意所戀也。"
  },
  {
    "id": "s0181",
    "blockIndex": 75,
    "zh": "」器物取朽敗者，曰：「我素所服食，身口所安也。"
  },
  {
    "id": "s0182",
    "blockIndex": 75,
    "zh": "」弟子數破其產，輒復賑給。"
  },
  {
    "id": "s0183",
    "blockIndex": 75,
    "zh": "帝聞其名，令公車特徵，至，拜侍中。"
  },
  {
    "id": "s0184",
    "blockIndex": 75,
    "zh": "包以死自乞，有詔賜告歸，加禮如毛義。"
  },
  {
    "id": "s0185",
    "blockIndex": 76,
    "zh": "帝少號聰明，故鄧太后立之。"
  },
  {
    "id": "s0186",
    "blockIndex": 76,
    "zh": "及長，多不德，稍不可太后意；"
  },
  {
    "id": "s0187",
    "blockIndex": 76,
    "zh": "帝乳母王聖知之。"
  },
  {
    "id": "s0188",
    "blockIndex": 76,
    "zh": "太后征濟北、河間王子詣京師，河間王子冀美容儀，太后奇之，以為平原懷王后，留京師。"
  },
  {
    "id": "s0189",
    "blockIndex": 76,
    "zh": "王聖見太后久不歸政，慮有廢置，常與中黃門李閏、江京候伺左右，共毀短太后於帝，帝每懷忿懼。"
  },
  {
    "id": "s0190",
    "blockIndex": 76,
    "zh": "及太后崩，宮人先有受罰者懷怨恚，因誣告太后兄弟悝、弘、閶先從尚書鄧訪取廢帝故事，謀立平原王。"
  },
  {
    "id": "s0191",
    "blockIndex": 76,
    "zh": "帝聞，追怒，今有司奏悝等大逆無道，遂廢西平侯廣宗、葉侯廣德、西華侯忠、陽安侯珍、都鄉侯甫德皆為庶人，鄧騭以不與謀，但免特進，遣就國；"
  },
  {
    "id": "s0192",
    "blockIndex": 76,
    "zh": "宗族免官歸故郡，沒入騭等貲財田宅。"
  },
  {
    "id": "s0193",
    "blockIndex": 76,
    "zh": "徙鄧訪及家屬於遠郡，郡縣逼迫，廣宗及忠皆自殺。"
  },
  {
    "id": "s0194",
    "blockIndex": 76,
    "zh": "又徙封騭為羅侯；"
  },
  {
    "id": "s0195",
    "blockIndex": 76,
    "zh": "五月，庚辰，騭與子鳳並不食而死。"
  },
  {
    "id": "s0196",
    "blockIndex": 76,
    "zh": "騭從弟河南尹豹、度遼將軍舞陽侯遵、將作大匠暢皆自殺；"
  },
  {
    "id": "s0197",
    "blockIndex": 76,
    "zh": "唯廣德兄弟以母與閻後同產，得留京師。"
  },
  {
    "id": "s0198",
    "blockIndex": 76,
    "zh": "復以耿夔為度遼將軍，征樂安侯鄧康為太僕。"
  },
  {
    "id": "s0199",
    "blockIndex": 76,
    "zh": "丙申，貶平原王翼為都鄉侯，譴歸河間。"
  },
  {
    "id": "s0200",
    "blockIndex": 76,
    "zh": "翼謝絕賓客，閉門自守，由是得免。"
  },
  {
    "id": "s0201",
    "blockIndex": 77,
    "zh": "初，鄧後之立也，太尉張禹、司徒徐防欲與司空陳寵共奏追封後父訓，寵以先世無奏請故事，爭之，連日不能奪。"
  },
  {
    "id": "s0202",
    "blockIndex": 77,
    "zh": "及訓追加封謚，禹、防復約寵俱遣子奉禮於虎賁中郎將騭，寵不從，故寵子忠不得志於鄧氏。"
  },
  {
    "id": "s0203",
    "blockIndex": 77,
    "zh": "騭等敗，忠為尚書，數上疏陷成其惡。"
  },
  {
    "id": "s0204",
    "blockIndex": 77,
    "zh": "大司農京兆朱寵痛騭無罪遇禍，乃肉袒輿櫬上疏曰：「伏惟和熹皇后聖善之德，為漢文母。"
  },
  {
    "id": "s0205",
    "blockIndex": 77,
    "zh": "兄弟忠孝，同心憂國，宗廟有主，王室是賴。"
  },
  {
    "id": "s0206",
    "blockIndex": 77,
    "zh": "功成身退，讓國遜位，歷世外戚，無與為比，當享積善履謙祐。"
  },
  {
    "id": "s0207",
    "blockIndex": 77,
    "zh": "而橫為宮人單辭所陷，利口傾險，反亂國家，罪無申證，獄不訊鞫，遂令騭等罹此酷濫，一門七人，並不以命，屍骸流離，冤魂不反，逆天感人，率土喪氣。"
  },
  {
    "id": "s0208",
    "blockIndex": 77,
    "zh": "宜收還塚次，寵樹遺孤，奉承血祀，以謝亡靈。"
  },
  {
    "id": "s0209",
    "blockIndex": 77,
    "zh": "」寵知其言切，自致廷尉；"
  },
  {
    "id": "s0210",
    "blockIndex": 77,
    "zh": "陳忠復劾奏寵，詔免官歸田裡。"
  },
  {
    "id": "s0211",
    "blockIndex": 77,
    "zh": "眾庶多為騭稱枉者，帝意頗悟，乃譴讓州郡，還葬騭等於北芒，諸從昆弟皆得歸京師。"
  },
  {
    "id": "s0212",
    "blockIndex": 78,
    "zh": "帝以耿貴人兄牟平侯寶監羽林左軍車騎，封宋楊四子皆為列侯，宋氏為卿、校、侍中大夫、謁者、郎吏十餘人；"
  },
  {
    "id": "s0213",
    "blockIndex": 78,
    "zh": "閻皇后兄弟顯、景、耀，並為卿、校，典禁兵。"
  },
  {
    "id": "s0214",
    "blockIndex": 78,
    "zh": "於是內寵始盛。"
  },
  {
    "id": "s0215",
    "blockIndex": 79,
    "zh": "帝以江京嘗迎帝於邸，以為京功，封都鄉侯，封李閏為雍鄉侯，閏、京並遷中常侍，京兼大長秋，與中常侍樊豐、黃門令劉安、鉤盾令陳達及王聖、聖女伯榮扇動內外，競為侈虐；"
  },
  {
    "id": "s0216",
    "blockIndex": 79,
    "zh": "伯榮出入宮掖，傳通姦賂。"
  },
  {
    "id": "s0217",
    "blockIndex": 80,
    "zh": "司徒楊震上疏曰：「臣聞政以得賢為本，治以去穢為務；"
  },
  {
    "id": "s0218",
    "blockIndex": 80,
    "zh": "是以唐、虞俊乂在官，四凶流放，天下咸服，以致雍熙。"
  },
  {
    "id": "s0219",
    "blockIndex": 80,
    "zh": "方今九德未事，嬖倖充庭。"
  },
  {
    "id": "s0220",
    "blockIndex": 80,
    "zh": "阿母王聖，出自賤微，得遭千載，奉養聖躬，雖有推燥居濕之勤，前後賞惠，過報勞苦，而無厭之心不知紀極，外交屬托，擾亂天下，損辱清朝，塵點日月。"
  },
  {
    "id": "s0221",
    "blockIndex": 80,
    "zh": "夫女子、小人，近之喜，遠之怨，實為難養。"
  },
  {
    "id": "s0222",
    "blockIndex": 80,
    "zh": "宜速出阿母，令居外捨，斷絕伯榮，莫使往來。"
  },
  {
    "id": "s0223",
    "blockIndex": 80,
    "zh": "令恩德兩隆，上下俱美。"
  },
  {
    "id": "s0224",
    "blockIndex": 80,
    "zh": "」奏御，帝以示阿母等，內幸皆懷忿恚。"
  },
  {
    "id": "s0225",
    "blockIndex": 81,
    "zh": "而伯榮驕淫尤甚，通於故朝陽侯劉護從兄瑰，瑰遂以為妻，官至侍中，得襲護爵。"
  },
  {
    "id": "s0226",
    "blockIndex": 81,
    "zh": "震上疏曰：「經制，父死子繼，兄亡弟及，以防篡也。"
  },
  {
    "id": "s0227",
    "blockIndex": 81,
    "zh": "伏見詔書，封故朝陽侯劉護再從兄瑰襲護爵為侯；"
  },
  {
    "id": "s0228",
    "blockIndex": 81,
    "zh": "護同產弟威，今猶見在。"
  },
  {
    "id": "s0229",
    "blockIndex": 81,
    "zh": "臣聞天子專封，封有功；"
  },
  {
    "id": "s0230",
    "blockIndex": 81,
    "zh": "諸侯專爵，爵有德。"
  },
  {
    "id": "s0231",
    "blockIndex": 81,
    "zh": "今瑰無佗功行，但以配阿母女，一時之間，既位侍中，又至封侯，不稽舊制，不合經義，行人喧嘩，百姓不安。"
  },
  {
    "id": "s0232",
    "blockIndex": 81,
    "zh": "陛下宜鑒鏡既往，順帝之則。"
  },
  {
    "id": "s0233",
    "blockIndex": 81,
    "zh": "」尚書廣陵翟瑰上疏曰：「昔竇、鄧之寵，傾動四方，兼官重紱，盈金積貨，至使議弄神器，改更社稷，豈不以勢尊威廣以致斯患乎！"
  },
  {
    "id": "s0234",
    "blockIndex": 81,
    "zh": "及其破壞，頭顙墮地，願為孤豚，豈可得哉！"
  },
  {
    "id": "s0235",
    "blockIndex": 81,
    "zh": "夫致貴無漸，失必暴；"
  },
  {
    "id": "s0236",
    "blockIndex": 81,
    "zh": "受爵非道，殃必疾。"
  },
  {
    "id": "s0237",
    "blockIndex": 81,
    "zh": "今外戚寵幸，功均造化，漢元以來未有等比。"
  },
  {
    "id": "s0238",
    "blockIndex": 81,
    "zh": "陛下誠仁恩周洽，以親九族，然祿去公室，政移私門，覆車重尋，寧無摧折！"
  },
  {
    "id": "s0239",
    "blockIndex": 81,
    "zh": "此最安危之極戒，社稷之深計也。"
  },
  {
    "id": "s0240",
    "blockIndex": 81,
    "zh": "昔文帝愛百金於露台，飾帷帳於皁囊，或有譏其儉者，上曰：『朕為天下守財耳，豈得妄用之哉！"
  },
  {
    "id": "s0241",
    "blockIndex": 81,
    "zh": "』今自初政已來，日月未久，費用賞賜，已不可算。"
  },
  {
    "id": "s0242",
    "blockIndex": 81,
    "zh": "斂天下之財，積無功之家，帑藏單盡，民物雕傷，卒有不虞，復當重賦，百姓怨叛既生，危敵可待也。"
  },
  {
    "id": "s0243",
    "blockIndex": 81,
    "zh": "願陛下勉求忠貞之臣，誅遠佞諂之黨，割情慾之歡，罷宴私之好，心存亡國所以失之，鑒觀興王所以得之，庶災害可息，豐年可招矣。"
  },
  {
    "id": "s0244",
    "blockIndex": 81,
    "zh": "」書奏，皆不省。"
  },
  {
    "id": "s0245",
    "blockIndex": 82,
    "zh": "秋，七月，己卿，改元，赦天下。"
  },
  {
    "id": "s0246",
    "blockIndex": 83,
    "zh": "壬寅，太尉馬英薨。"
  },
  {
    "id": "s0247",
    "blockIndex": 84,
    "zh": "燒當羌忍良等，以麻奴兄弟本燒當世嫡，而校尉馬賢撫恤不至，常有怨心，遂相結，共脅將諸種寇湟中，攻金城諸縣。"
  },
  {
    "id": "s0248",
    "blockIndex": 84,
    "zh": "八月，賢將先零種擊之，戰於牧苑，不利。"
  },
  {
    "id": "s0249",
    "blockIndex": 84,
    "zh": "麻奴等又敗武威、張掖郡兵於令居，因脅將先零、沈氐諸種四千餘戶緣山西走，寇武威。"
  },
  {
    "id": "s0250",
    "blockIndex": 84,
    "zh": "賢追到鸞鳥，招引之，諸種降者數千，麻奴南還湟中。"
  },
  {
    "id": "s0251",
    "blockIndex": 85,
    "zh": "甲子，以前司徒劉愷為太尉。"
  },
  {
    "id": "s0252",
    "blockIndex": 85,
    "zh": "初，清河相叔孫光坐臧抵罪，遂增禁錮二世。"
  },
  {
    "id": "s0253",
    "blockIndex": 85,
    "zh": "至是，居延都尉范邠復犯臧罪，朝廷欲依光比；"
  },
  {
    "id": "s0254",
    "blockIndex": 85,
    "zh": "劉愷獨以為：「《春秋》之義，善善及子孫，惡惡止其身，所以進人於善也。"
  },
  {
    "id": "s0255",
    "blockIndex": 85,
    "zh": "如今使臧吏禁錮子孫，以輕從重，懼及善人，非先王詳刑之意也。"
  },
  {
    "id": "s0256",
    "blockIndex": 85,
    "zh": "」尚書陳忠亦以為然。"
  },
  {
    "id": "s0257",
    "blockIndex": 85,
    "zh": "有詔：「太尉議是。"
  },
  {
    "id": "s0259",
    "blockIndex": 86,
    "zh": "鮮卑其至鞬寇居庸關。"
  },
  {
    "id": "s0260",
    "blockIndex": 86,
    "zh": "九月，雲中太守成嚴擊之，兵敗，功曹楊穆以身捍嚴，與之俱歿；"
  },
  {
    "id": "s0261",
    "blockIndex": 86,
    "zh": "鮮卑於是圍烏桓校尉徐常於馬城。"
  },
  {
    "id": "s0262",
    "blockIndex": 86,
    "zh": "度遼將軍耿夔與幽州刺史龐參發廣陽、漁陽、涿郡甲卒救之，鮮卑解去。"
  },
  {
    "id": "s0263",
    "blockIndex": 87,
    "zh": "戊子，帝幸衛尉馮石府，留飲十許日，賞賜甚厚，拜其子世為黃門侍郎，世弟二人皆為郎中。"
  },
  {
    "id": "s0264",
    "blockIndex": 87,
    "zh": "石，陽邑侯魴之孫也，父柱尚顯宗女獲嘉公主，石襲公主爵，為獲嘉侯，能取悅當世，故為帝所寵。"
  },
  {
    "id": "s0265",
    "blockIndex": 87,
    "zh": "京師及郡國二十七雨水。"
  },
  {
    "id": "s0266",
    "blockIndex": 88,
    "zh": "冬，十一月，己丑，郡國三十五地震。"
  },
  {
    "id": "s0267",
    "blockIndex": 89,
    "zh": "鮮卑寇玄菟。"
  },
  {
    "id": "s0268",
    "blockIndex": 90,
    "zh": "尚書令祋諷等奏，以為「孝文皇帝定約禮之制，光武皇帝絕告寧之典，貽則萬世，誠不可改，宜復斷大臣行三年喪。"
  },
  {
    "id": "s0269",
    "blockIndex": 90,
    "zh": "」尚書陳忠上疏曰：「高祖受命，蕭何創製，大臣有寧告之科，合於致憂之義。"
  },
  {
    "id": "s0270",
    "blockIndex": 90,
    "zh": "建武之初，新承大亂，凡諸國政，多趣簡易，大臣既不得告寧而群司營祿念私，鮮循三年之喪以報顧復之恩者，禮義之方，實為雕損。"
  },
  {
    "id": "s0271",
    "blockIndex": 90,
    "zh": "陛下聽大臣終喪，聖功美業，靡以尚茲。"
  },
  {
    "id": "s0272",
    "blockIndex": 90,
    "zh": "《孟子》有言：『老吾老，以及人之老；"
  },
  {
    "id": "s0273",
    "blockIndex": 90,
    "zh": "幼吾幼，以及人之幼，天下可運如掌。"
  },
  {
    "id": "s0274",
    "blockIndex": 90,
    "zh": "』臣願陛下登高北望，以甘陵之思揆度臣子之心，則海內咸得其所。"
  },
  {
    "id": "s0275",
    "blockIndex": 90,
    "zh": "」時宦官不便之，竟寢忠奏。"
  },
  {
    "id": "s0276",
    "blockIndex": 90,
    "zh": "庚子，復斷二千石以上行三年喪。"
  },
  {
    "id": "s0277",
    "blockIndex": 91,
    "zh": "袁宏論曰：古之帝王所以篤化美俗，率民為善，因其自然而不奪其情，民猶有不及者，而況毀禮止哀，滅其天性乎！"
  },
  {
    "id": "s0278",
    "blockIndex": 92,
    "zh": "十二月，高句驪王宮率馬韓、濊貊數千騎圍玄菟，夫餘王遣子尉仇台將二萬餘人與州郡並力討破之。"
  },
  {
    "id": "s0279",
    "blockIndex": 92,
    "zh": "是歲，宮死，子遂成立。"
  },
  {
    "id": "s0280",
    "blockIndex": 92,
    "zh": "玄菟太守姚光上言，欲因其喪，發兵擊之，議者皆以為可許。"
  },
  {
    "id": "s0281",
    "blockIndex": 92,
    "zh": "陳忠曰：「宮前桀黠，光不能討，死而擊之，非義也。"
  },
  {
    "id": "s0282",
    "blockIndex": 92,
    "zh": "宜遣使弔問，因責讓前罪，赦不加誅，取其後善。"
  },
  {
    "id": "s0283",
    "blockIndex": 92,
    "zh": "」帝從之。"
  },
  {
    "id": "s0284",
    "blockIndex": 93,
    "zh": "春，三月，丙午，改元，赦天下。"
  },
  {
    "id": "s0285",
    "blockIndex": 94,
    "zh": "護羌校尉馬賢追擊麻奴，到湟中，破之，種眾散遁。"
  },
  {
    "id": "s0286",
    "blockIndex": 95,
    "zh": "夏，四月，癸未，京師、郡國二十一雨雹，河西雹大者如斗。"
  },
  {
    "id": "s0287",
    "blockIndex": 96,
    "zh": "幽州刺史馮煥、玄菟太守姚光數糾發奸惡，怨者詐作璽書，譴責煥、光，賜以歐刀，又下遼東都尉龐奮，使速行刑。"
  },
  {
    "id": "s0288",
    "blockIndex": 96,
    "zh": "奮即斬光，收煥。"
  },
  {
    "id": "s0289",
    "blockIndex": 96,
    "zh": "煥欲自殺，其子緄疑詔文有異，止煥曰：「大人在州，志欲去惡，實無它故。"
  },
  {
    "id": "s0290",
    "blockIndex": 96,
    "zh": "必是凶人妄詐，規肆奸毒。"
  },
  {
    "id": "s0291",
    "blockIndex": 96,
    "zh": "願以事自上，甘罪無晚。"
  },
  {
    "id": "s0292",
    "blockIndex": 96,
    "zh": "」煥從其言，上書自訟，果詐者所為，征奮，抵罪。"
  },
  {
    "id": "s0293",
    "blockIndex": 97,
    "zh": "癸巳，司空陳褒免。"
  },
  {
    "id": "s0294",
    "blockIndex": 97,
    "zh": "五月，庚戌，宗正彭城劉授為司空。"
  },
  {
    "id": "s0295",
    "blockIndex": 98,
    "zh": "己巳，封河間孝王子德為安平王，嗣樂成靖王后。"
  },
  {
    "id": "s0296",
    "blockIndex": 99,
    "zh": "六月，郡國蝗。"
  },
  {
    "id": "s0297",
    "blockIndex": 100,
    "zh": "秋，七月，癸卯，京師及郡國十三地震。"
  },
  {
    "id": "s0298",
    "blockIndex": 101,
    "zh": "高句驪王遂成還漢生口，詣玄菟降，其後濊貊率服，東垂少事。"
  },
  {
    "id": "s0299",
    "blockIndex": 102,
    "zh": "虔人羌與上郡胡反，度遼將軍耿夔擊破之。"
  },
  {
    "id": "s0300",
    "blockIndex": 102,
    "zh": "八月，陽陵園寢火。"
  },
  {
    "id": "s0301",
    "blockIndex": 103,
    "zh": "九月，甲戌，郡國二十七地震。"
  },
  {
    "id": "s0302",
    "blockIndex": 104,
    "zh": "鮮卑既累殺郡守，膽氣轉盛，控弦數萬騎，冬，十月，復寇雁門、定襄；"
  },
  {
    "id": "s0303",
    "blockIndex": 104,
    "zh": "十一月，寇太原。"
  },
  {
    "id": "s0304",
    "blockIndex": 105,
    "zh": "燒當羌麻奴饑困，將種眾詣漢陽太守耿種降。"
  },
  {
    "id": "s0305",
    "blockIndex": 106,
    "zh": "是歲，京師及郡國二十七雨水。"
  },
  {
    "id": "s0306",
    "blockIndex": 107,
    "zh": "帝數遣黃門常侍及中使伯榮往來甘陵，尚書僕射陳忠上疏曰：「今天心未得，隔並屢臻，青、冀之域，淫雨漏河，徐、岱之濱，海水盆溢，兗、豫蝗蝝滋生，荊、揚稻收儉薄，並、涼二州羌戎叛戾，加以百姓不足，府帑虛匱。"
  },
  {
    "id": "s0307",
    "blockIndex": 107,
    "zh": "陛下以不得親奉孝德皇園廟，比遣中使致敬甘陵，朱軒駢馬，相望道路，可謂孝至矣。"
  },
  {
    "id": "s0308",
    "blockIndex": 107,
    "zh": "然臣竊聞使者所過，威權翕赫，震動郡縣，王、侯、二千石至為伯榮獨拜車下，發民修道，繕理亭傳，多設儲偫，征役無度，老弱相隨，動有萬計，賂遺僕從，人數百匹，頓踣呼嗟，莫不叩心。"
  },
  {
    "id": "s0309",
    "blockIndex": 107,
    "zh": "河間托叔父之屬，清河有陵廟之尊，及剖符大臣，皆猥為伯榮屈節車下，陛下不問，必以為陛下欲其然也。"
  },
  {
    "id": "s0310",
    "blockIndex": 107,
    "zh": "伯榮之威，重於陛下，陛下之柄，在於臣妾，水災之發，必起於此。"
  },
  {
    "id": "s0311",
    "blockIndex": 107,
    "zh": "昔韓嫣托副車之乘，受馳視之使，江都誤為一拜，而嫣受歐刀之誅。"
  },
  {
    "id": "s0312",
    "blockIndex": 107,
    "zh": "臣願明主嚴天元之尊，正乾剛之位，不宜復令女使幹錯萬機。"
  },
  {
    "id": "s0313",
    "blockIndex": 107,
    "zh": "重察左右，得無石顯洩漏之奸？"
  },
  {
    "id": "s0314",
    "blockIndex": 107,
    "zh": "尚書納言，得無趙昌譖崇之詐？"
  },
  {
    "id": "s0315",
    "blockIndex": 107,
    "zh": "公卿大臣，得無朱博阿傅之援？"
  },
  {
    "id": "s0316",
    "blockIndex": 107,
    "zh": "外屬近戚，得無王鳳害商之謀？"
  },
  {
    "id": "s0317",
    "blockIndex": 107,
    "zh": "若國政一由帝命，王事每決於己，則下不得逼上，臣不得干君，常雨大水必當霽止，四方眾異不能為害。"
  },
  {
    "id": "s0318",
    "blockIndex": 107,
    "zh": "」書奏，不省。"
  },
  {
    "id": "s0319",
    "blockIndex": 108,
    "zh": "時三府任輕，機事專委尚書，而災眚變咎，輒切免三公，陳忠上疏曰：「漢典舊事，丞相所請，靡有不聽。"
  },
  {
    "id": "s0320",
    "blockIndex": 108,
    "zh": "今之三公，雖當其名而無其實，選舉誅賞，一由尚書，尚書見任，重於三公，陵遲以來，其漸久矣。"
  },
  {
    "id": "s0321",
    "blockIndex": 108,
    "zh": "臣忠心常獨不安。"
  },
  {
    "id": "s0322",
    "blockIndex": 108,
    "zh": "近以地震，策免司空陳褒，今者災異，復欲切讓三公。"
  },
  {
    "id": "s0323",
    "blockIndex": 108,
    "zh": "昔孝成皇帝以妖星守心，移咎丞相，卒不蒙上天之福，徒乖宋景之誠。"
  },
  {
    "id": "s0324",
    "blockIndex": 108,
    "zh": "故知是非之分，較然有歸矣。"
  },
  {
    "id": "s0325",
    "blockIndex": 108,
    "zh": "又尚書決事，多違故典，罪法無例，詆欺為先，文慘言丑，有乖章憲。"
  },
  {
    "id": "s0326",
    "blockIndex": 108,
    "zh": "宜責求其意，割而勿聽，上順國典，下防威福，置方員於規矩，審輕重於衡石，誠國家之典，萬世之法也！"
  },
  {
    "id": "s0328",
    "blockIndex": 109,
    "zh": "汝南太守山陽王龔，政崇溫和，好才愛士。"
  },
  {
    "id": "s0329",
    "blockIndex": 109,
    "zh": "以袁閬為功曹，引進郡人黃憲、陳蕃等；"
  },
  {
    "id": "s0330",
    "blockIndex": 109,
    "zh": "憲雖不屈，蕃遂就吏。"
  },
  {
    "id": "s0331",
    "blockIndex": 109,
    "zh": "閬不修異操而致名當時，蕃性氣高明，龔皆禮之，由是群士莫不歸心。"
  },
  {
    "id": "s0332",
    "blockIndex": 110,
    "zh": "憲世貧賤，父為牛醫。"
  },
  {
    "id": "s0333",
    "blockIndex": 110,
    "zh": "穎川荀淑至慎陽，遇憲於逆旅，時年十四；"
  },
  {
    "id": "s0334",
    "blockIndex": 110,
    "zh": "淑辣然異之，揖與語，移日不能去，謂憲曰：「子，吾之師表也。"
  },
  {
    "id": "s0335",
    "blockIndex": 110,
    "zh": "」既而前至袁閬所，未及勞問，逆曰：「子國有顏子，寧識之乎？"
  },
  {
    "id": "s0336",
    "blockIndex": 110,
    "zh": "」閬曰：「見吾叔度邪？"
  },
  {
    "id": "s0337",
    "blockIndex": 110,
    "zh": "」是時同郡戴良，才高倨傲，而見憲未嘗不正容，及歸，惘然若有失也。"
  },
  {
    "id": "s0338",
    "blockIndex": 110,
    "zh": "其母問曰：「汝復從牛醫兒來邪？"
  },
  {
    "id": "s0339",
    "blockIndex": 110,
    "zh": "」對曰：「良不見叔度，自以為無不及；"
  },
  {
    "id": "s0340",
    "blockIndex": 110,
    "zh": "既睹其人，則瞻之在前，忽焉在後，固難得而測矣。"
  },
  {
    "id": "s0341",
    "blockIndex": 110,
    "zh": "」陳蕃及同郡周舉常相謂曰：「時月之間不見黃生，則鄙吝之萌復存乎心矣。"
  },
  {
    "id": "s0342",
    "blockIndex": 110,
    "zh": "」太原郭泰，少游汝南，先過袁閬，不宿而退；"
  },
  {
    "id": "s0343",
    "blockIndex": 110,
    "zh": "進，往從憲，累日方還。"
  },
  {
    "id": "s0344",
    "blockIndex": 110,
    "zh": "或以問泰，曰：「奉高之器，譬諸氿濫，雖清而易挹。"
  },
  {
    "id": "s0345",
    "blockIndex": 110,
    "zh": "叔度汪汪若千頃陂，澄之不清，淆之不濁，不可量也。"
  },
  {
    "id": "s0346",
    "blockIndex": 110,
    "zh": "」憲初舉孝廉，又辟公府。"
  },
  {
    "id": "s0347",
    "blockIndex": 110,
    "zh": "友人勸其仕，憲亦不拒之，暫到京師，即還，竟無所就，年四十八終。"
  },
  {
    "id": "s0348",
    "blockIndex": 111,
    "zh": "范曄論曰：黃憲言論風旨，無所傳聞；"
  },
  {
    "id": "s0349",
    "blockIndex": 111,
    "zh": "然士君子見之者，靡不服深遠，去玭吝，將以道周性全，無德而稱乎！"
  },
  {
    "id": "s0350",
    "blockIndex": 111,
    "zh": "余曾祖穆侯以為：「憲，隤然其處順，淵乎其似道，淺深莫臻其分，清濁未議其方，若及門於孔氏，其殆庶乎！"
  },
  {
    "id": "s0352",
    "blockIndex": 112,
    "zh": "春，正月，旄牛夷反，益州刺史張喬擊破之。"
  },
  {
    "id": "s0353",
    "blockIndex": 113,
    "zh": "夏，四月，戊子，爵乳母王聖為野王君。"
  },
  {
    "id": "s0354",
    "blockIndex": 114,
    "zh": "北匈奴連與車師入寇河西，議者欲復閉玉門、陽關以絕其患。"
  },
  {
    "id": "s0355",
    "blockIndex": 114,
    "zh": "敦煌太守張璫上書曰：「臣在京師，亦以為西域宜棄，今親踐其土地，乃知棄西域則河西不能自存。"
  },
  {
    "id": "s0356",
    "blockIndex": 114,
    "zh": "謹陳西域三策：北虜呼衍王常展轉蒲類、秦海之間，專制西域，共為寇鈔。"
  },
  {
    "id": "s0357",
    "blockIndex": 114,
    "zh": "今以酒泉屬國吏士二千餘人集崑崙塞，先擊呼衍王，絕其根本，因發鄯善兵五千人脅車師後部，此上計也。"
  },
  {
    "id": "s0358",
    "blockIndex": 114,
    "zh": "若不能出兵，可置軍司馬，將士五百人，四郡供其犁牛、谷食，出據柳中，此中計也。"
  },
  {
    "id": "s0359",
    "blockIndex": 114,
    "zh": "如又不能，則宜棄交河城，收鄯善等悉使入塞，此下計也。"
  },
  {
    "id": "s0360",
    "blockIndex": 114,
    "zh": "」朝廷下其議。"
  },
  {
    "id": "s0361",
    "blockIndex": 114,
    "zh": "陳忠上疏曰：「西域內附日久，區區東望扣關者數矣，此其不樂匈奴、慕漢之效也。"
  },
  {
    "id": "s0362",
    "blockIndex": 114,
    "zh": "今北虜已破車師，勢必南攻鄯善，棄而不救，則諸國從矣。"
  },
  {
    "id": "s0363",
    "blockIndex": 114,
    "zh": "若然，則虜財賄益增，膽勢益殖，威臨南羌，與之交通，如此，河西四郡危矣。"
  },
  {
    "id": "s0364",
    "blockIndex": 114,
    "zh": "河西既危，不可不救，則百倍之役興，不訾之費發矣。"
  },
  {
    "id": "s0365",
    "blockIndex": 114,
    "zh": "議者但念西域絕遠，恤之煩費，不見孝武苦心勤勞之意也。"
  },
  {
    "id": "s0366",
    "blockIndex": 114,
    "zh": "方今敦煌孤危，遠來告急；"
  },
  {
    "id": "s0367",
    "blockIndex": 114,
    "zh": "復不輔助，內無以慰勞吏民，外無以威示百蠻，蹙國減土，非良計也。"
  },
  {
    "id": "s0368",
    "blockIndex": 114,
    "zh": "臣以為敦煌宜置校尉，按舊增四郡屯兵，以西撫諸國。"
  },
  {
    "id": "s0369",
    "blockIndex": 114,
    "zh": "」帝納之，於是復以班勇為西域長史，將兵五百人出屯柳中。"
  },
  {
    "id": "s0370",
    "blockIndex": 115,
    "zh": "秋，七月，丹楊山崩。"
  },
  {
    "id": "s0371",
    "blockIndex": 116,
    "zh": "九月，郡國五雨水。"
  },
  {
    "id": "s0372",
    "blockIndex": 117,
    "zh": "冬，十月，辛未，太尉劉愷罷；"
  },
  {
    "id": "s0373",
    "blockIndex": 117,
    "zh": "甲戌，以司徒楊震為太尉，光祿勳東萊劉熹為司徒。"
  },
  {
    "id": "s0374",
    "blockIndex": 117,
    "zh": "大鴻臚耿寶自候震，薦中常侍李閏兄於震曰：「李常侍國家所重，欲令公辟其兄；"
  },
  {
    "id": "s0375",
    "blockIndex": 117,
    "zh": "寶唯傳上意耳。"
  },
  {
    "id": "s0376",
    "blockIndex": 117,
    "zh": "」震曰：「如朝廷欲令三府辟召，故宜有尚書敕。"
  },
  {
    "id": "s0377",
    "blockIndex": 117,
    "zh": "」寶大恨而去。"
  },
  {
    "id": "s0378",
    "blockIndex": 117,
    "zh": "執金吾閻顯亦薦所親於震，震又不從。"
  },
  {
    "id": "s0379",
    "blockIndex": 117,
    "zh": "司空劉授聞之，即辟此二人；"
  },
  {
    "id": "s0380",
    "blockIndex": 117,
    "zh": "由是震益見怨。"
  },
  {
    "id": "s0381",
    "blockIndex": 117,
    "zh": "時詔遣使者大為王聖修第；"
  },
  {
    "id": "s0382",
    "blockIndex": 117,
    "zh": "中常侍樊豐及侍中周廣、謝惲等更相扇動，傾搖朝廷。"
  },
  {
    "id": "s0383",
    "blockIndex": 117,
    "zh": "震上疏曰：「臣伏念方今災害滋甚，百姓空虛，三邊震擾，帑藏匱乏，殆非社稷安寧之時。"
  },
  {
    "id": "s0384",
    "blockIndex": 117,
    "zh": "詔書為阿母興起第捨，合兩為一，連裡竟街，雕修繕飾，窮極巧伎，攻山採石，轉相迫促，為費巨億。"
  },
  {
    "id": "s0385",
    "blockIndex": 117,
    "zh": "周廣、謝惲兄弟，與國無肺府枝葉之屬，依倚近幸奸佞之人，與之分威共權，屬托州郡，傾動大臣。"
  },
  {
    "id": "s0386",
    "blockIndex": 117,
    "zh": "宰司辟召，承望旨意，招來海內貪污之人，受其貨賂，至有臧錮棄世之徒，復得顯用；"
  },
  {
    "id": "s0387",
    "blockIndex": 117,
    "zh": "白黑混淆，清濁同源，天下讙嘩，為朝結譏。"
  },
  {
    "id": "s0388",
    "blockIndex": 117,
    "zh": "臣聞師言，上之所取，財盡則怨，力盡則叛，怨叛之人，不可復使，惟陛下度之！"
  },
  {
    "id": "s0389",
    "blockIndex": 117,
    "zh": "」上不聽。"
  },
  {
    "id": "s0390",
    "blockIndex": 118,
    "zh": "鮮卑其至鞬自將萬餘騎攻南匈奴於曼柏，薁鞬日逐王戰死，殺千餘人。"
  },
  {
    "id": "s0391",
    "blockIndex": 119,
    "zh": "十二月，戊辰，京師及郡國三地震。"
  },
  {
    "id": "s0392",
    "blockIndex": 120,
    "zh": "陳忠薦汝南周燮、南陽馮良學行深純，隱居不仕，名重於世；"
  },
  {
    "id": "s0393",
    "blockIndex": 120,
    "zh": "帝以玄纁羔幣聘之；"
  },
  {
    "id": "s0394",
    "blockIndex": 120,
    "zh": "燮宗族更勸之曰：「夫修德立行，所以為國，君獨何為守東岡之陂乎？"
  },
  {
    "id": "s0395",
    "blockIndex": 120,
    "zh": "」燮曰：「夫修道者度其時而動，動而不時，焉得亨乎！"
  },
  {
    "id": "s0396",
    "blockIndex": 120,
    "zh": "」與良皆自載至近縣，稱病而還。"
  },
  {
    "id": "s0397",
    "blockIndex": 121,
    "zh": "春，正月，班勇至樓蘭，以鄯善歸附，特加三綬，而龜茲王白英猶自疑未下。"
  },
  {
    "id": "s0398",
    "blockIndex": 121,
    "zh": "勇開以恩信，白英乃率姑墨、溫宿，自縛詣勇，因發其兵步騎萬餘人到車師前王庭，擊走匈奴伊蠡王於伊和谷，收得前部五千餘人，於是前部始復開通。"
  },
  {
    "id": "s0399",
    "blockIndex": 121,
    "zh": "還，屯田柳中。"
  },
  {
    "id": "s0400",
    "blockIndex": 122,
    "zh": "二月，丙子，車駕東巡。"
  },
  {
    "id": "s0401",
    "blockIndex": 122,
    "zh": "辛卯，幸泰山。"
  },
  {
    "id": "s0402",
    "blockIndex": 122,
    "zh": "三月，戊戌，幸魯，還，幸東平，至東郡，歷魏郡、河內而還。"
  },
  {
    "id": "s0403",
    "blockIndex": 123,
    "zh": "初，樊豐、周廣、謝惲等見楊震連諫不從，無所顧忌，遂詐作詔書，調發司農錢穀、大匠見徒材木，各起家捨、園池、廬觀，役費無數。"
  },
  {
    "id": "s0404",
    "blockIndex": 123,
    "zh": "震復上疏曰：「臣備台輔，不能調和陰陽，去年十二月四日，京師地動，其日戊辰；"
  },
  {
    "id": "s0405",
    "blockIndex": 123,
    "zh": "三者皆土，位在中宮，此中臣、近官持權用事之象也。"
  },
  {
    "id": "s0406",
    "blockIndex": 123,
    "zh": "臣伏惟陛下以邊境未寧，躬身菲薄，宮殿垣屋傾倚，枝拄而已。"
  },
  {
    "id": "s0407",
    "blockIndex": 123,
    "zh": "而親近幸臣，未崇斷金，驕溢逾法，多請徒士，盛修第捨，賣弄威福，道路讙嘩，地動之變，殆為此發。"
  },
  {
    "id": "s0408",
    "blockIndex": 123,
    "zh": "又，冬無宿雪，春節未雨，百僚焦心，而繕修不止，誠致旱之征也。"
  },
  {
    "id": "s0409",
    "blockIndex": 123,
    "zh": "惟陛下奮乾剛之德，棄驕奢之臣，以承皇天之戒！"
  },
  {
    "id": "s0410",
    "blockIndex": 123,
    "zh": "」震前後所言轉切，帝既不平之，而樊豐等皆側目憤怨，以其名儒，未敢加害。"
  },
  {
    "id": "s0411",
    "blockIndex": 123,
    "zh": "會河間男子趙騰上書指陳得失，帝發怒，遂收考詔獄，結以罔上不道。"
  },
  {
    "id": "s0412",
    "blockIndex": 123,
    "zh": "震上疏救之曰：「臣聞殷、周哲王，小人怨詈，則還自敬德。"
  },
  {
    "id": "s0413",
    "blockIndex": 123,
    "zh": "今趙騰所坐，激訐謗語，為罪與手刃犯法有差，乞為虧除，全騰之命，以誘芻蕘輿論人之言。"
  },
  {
    "id": "s0414",
    "blockIndex": 123,
    "zh": "」帝不聽，騰竟伏屍都市。"
  },
  {
    "id": "s0415",
    "blockIndex": 123,
    "zh": "及帝東巡，樊豐等因乘輿在外，競修第宅，太尉部掾高舒召大匠令史考校之，得豐等所詐下詔書，具奏，須行還上之，豐等惶怖。"
  },
  {
    "id": "s0416",
    "blockIndex": 123,
    "zh": "會太史言星變逆行，遂共譖震云：「自趙騰死後，深用怨懟；"
  },
  {
    "id": "s0417",
    "blockIndex": 123,
    "zh": "且鄧氏故吏，有恚恨之心。"
  },
  {
    "id": "s0418",
    "blockIndex": 123,
    "zh": "」壬戌，車駕還京師，便時太學，夜，遺使者策收震太尉印綬；"
  },
  {
    "id": "s0419",
    "blockIndex": 123,
    "zh": "震於是柴門絕賓客。"
  },
  {
    "id": "s0420",
    "blockIndex": 123,
    "zh": "豐等復惡之，令大鴻臚耿寶奏：「震大臣，不服罪，懷恚望。"
  },
  {
    "id": "s0421",
    "blockIndex": 123,
    "zh": "」有詔，遣歸本郡。"
  },
  {
    "id": "s0422",
    "blockIndex": 123,
    "zh": "震行至城西幾陽亭，乃慷慨謂其諸子、門人曰：「死者，士之常分。"
  },
  {
    "id": "s0423",
    "blockIndex": 123,
    "zh": "吾蒙恩居上司，疾奸臣狡猾而不能誅，惡嬖女傾亂而不能禁，何面目復見日月！"
  },
  {
    "id": "s0424",
    "blockIndex": 123,
    "zh": "身死之日，以雜木為棺，布單被，裁足蓋形，勿歸塚次，勿設祭祀！"
  },
  {
    "id": "s0425",
    "blockIndex": 123,
    "zh": "」因飲鴆而卒。"
  },
  {
    "id": "s0426",
    "blockIndex": 123,
    "zh": "弘農太守移良承樊豐等旨，遣吏於陝縣留停震喪，露棺道側，謫震諸子代郵行書；"
  },
  {
    "id": "s0427",
    "blockIndex": 123,
    "zh": "道路皆為隕涕。"
  },
  {
    "id": "s0428",
    "blockIndex": 124,
    "zh": "太僕征羌侯來歷曰：「耿寶托元舅之親，榮寵過厚，不念報國恩，而傾側奸臣，傷害忠良，其天禍亦將至矣。"
  },
  {
    "id": "s0429",
    "blockIndex": 124,
    "zh": "」歷，歙之曾孫也。"
  },
  {
    "id": "s0430",
    "blockIndex": 125,
    "zh": "夏，四月，乙丑，車駕入宮。"
  },
  {
    "id": "s0431",
    "blockIndex": 126,
    "zh": "戊辰，以光祿勳馮石為太尉。"
  },
  {
    "id": "s0432",
    "blockIndex": 127,
    "zh": "南單于檀死，弟拔立，為烏稽侯屍逐鞮單于。"
  },
  {
    "id": "s0433",
    "blockIndex": 127,
    "zh": "時鮮卑數寇邊，度遼將軍耿夔與溫禺犢王呼尤徽將新降者連年出塞擊之，還使屯列衝要。"
  },
  {
    "id": "s0434",
    "blockIndex": 127,
    "zh": "耿夔征發煩劇，新降者皆怨恨，大人阿族等遂反，脅呼尤徽欲與俱去。"
  },
  {
    "id": "s0435",
    "blockIndex": 127,
    "zh": "呼尤徽曰：「我老矣，受漢家恩，寧死，不能相隨！"
  },
  {
    "id": "s0436",
    "blockIndex": 127,
    "zh": "」眾所殺之，有救者，得免。"
  },
  {
    "id": "s0437",
    "blockIndex": 127,
    "zh": "阿族等遂將其眾亡去。"
  },
  {
    "id": "s0438",
    "blockIndex": 127,
    "zh": "中郎將馬翼與胡騎追擊，破之，斬獲殆盡。"
  },
  {
    "id": "s0439",
    "blockIndex": 128,
    "zh": "日南徼外蠻夷內屬。"
  },
  {
    "id": "s0440",
    "blockIndex": 129,
    "zh": "六月，鮮卑寇玄菟。"
  },
  {
    "id": "s0441",
    "blockIndex": 130,
    "zh": "庚午，閬中山崩。"
  },
  {
    "id": "s0442",
    "blockIndex": 131,
    "zh": "秋，八月，辛巳，以大鴻臚耿寶為大將軍。"
  },
  {
    "id": "s0443",
    "blockIndex": 132,
    "zh": "王聖、江京、樊豐等譖太子乳母王男、廚監邴吉等，殺之，家屬徙比景；"
  },
  {
    "id": "s0444",
    "blockIndex": 132,
    "zh": "太子思男、吉，數為歎息。"
  },
  {
    "id": "s0445",
    "blockIndex": 132,
    "zh": "京、豐懼有後害，乃與閻後妄造虛無，構讒太子及東宮官屬。"
  },
  {
    "id": "s0446",
    "blockIndex": 132,
    "zh": "帝怒，召公卿以下，議廢太子。"
  },
  {
    "id": "s0447",
    "blockIndex": 132,
    "zh": "耿寶等承旨，皆以為當廢。"
  },
  {
    "id": "s0448",
    "blockIndex": 132,
    "zh": "太僕來歷與太常桓焉、廷尉犍為張皓議曰：「經說，年未滿十五，過惡不在其身；"
  },
  {
    "id": "s0449",
    "blockIndex": 132,
    "zh": "且男、吉之謀，皇太子容有不知；"
  },
  {
    "id": "s0450",
    "blockIndex": 132,
    "zh": "宜選忠良保傅，輔以禮義。"
  },
  {
    "id": "s0451",
    "blockIndex": 132,
    "zh": "廢置事重，此誠聖恩所宜宿留！"
  },
  {
    "id": "s0452",
    "blockIndex": 132,
    "zh": "」帝不從。"
  },
  {
    "id": "s0453",
    "blockIndex": 132,
    "zh": "焉，郁之子也。"
  },
  {
    "id": "s0454",
    "blockIndex": 132,
    "zh": "張皓退，復上書曰：「昔賊臣江充造構讒逆，傾覆戾園，孝武久乃覺寤，雖追前失，悔之何及。"
  },
  {
    "id": "s0455",
    "blockIndex": 132,
    "zh": "今皇太子方十歲，未習保傅之教，可遽責乎！"
  },
  {
    "id": "s0456",
    "blockIndex": 132,
    "zh": "」書奏，不省。"
  },
  {
    "id": "s0457",
    "blockIndex": 133,
    "zh": "九月，丁酉，廢皇太子保為濟陰王，居於德陽殿西鐘下。"
  },
  {
    "id": "s0458",
    "blockIndex": 133,
    "zh": "來歷乃要結光祿勳祋諷、宗正劉瑋、將作大匠薛皓、侍中閭丘弘、陳光、趙代、施延、太中大夫九江朱倀等十餘人，俱詣鴻都門證太子無過。"
  },
  {
    "id": "s0459",
    "blockIndex": 134,
    "zh": "帝與左右患之，乃使中常侍奉詔脅群臣曰：「父子一體，天性自然；"
  },
  {
    "id": "s0460",
    "blockIndex": 134,
    "zh": "以義割恩，為天下也。"
  },
  {
    "id": "s0461",
    "blockIndex": 134,
    "zh": "歷、諷等不識大典，而與群小共為歡嘩，外見忠直而內希後福，飾邪違義，豈事君之禮！"
  },
  {
    "id": "s0462",
    "blockIndex": 134,
    "zh": "朝廷廣開言事之路，故且一切假貸；"
  },
  {
    "id": "s0463",
    "blockIndex": 134,
    "zh": "若懷迷不反，當顯明刑書。"
  },
  {
    "id": "s0464",
    "blockIndex": 134,
    "zh": "」諫者莫不失色。"
  },
  {
    "id": "s0465",
    "blockIndex": 134,
    "zh": "薛皓先頓首曰：「固宜如明詔。"
  },
  {
    "id": "s0466",
    "blockIndex": 134,
    "zh": "」歷怫然，廷詰皓曰：「屬通諫何言，而今復背之？"
  },
  {
    "id": "s0467",
    "blockIndex": 134,
    "zh": "大臣乘朝車，處國事，固得輾轉若此乎！"
  },
  {
    "id": "s0468",
    "blockIndex": 134,
    "zh": "」乃各稍自引起。"
  },
  {
    "id": "s0469",
    "blockIndex": 134,
    "zh": "歷獨守闕，連日不肯去。"
  },
  {
    "id": "s0470",
    "blockIndex": 134,
    "zh": "帝不怒，尚書令陳忠與諸尚書遂共劾奏歷等，帝乃免歷兄弟官，削國租，黜歷母武安公主不得會見。"
  },
  {
    "id": "s0471",
    "blockIndex": 135,
    "zh": "隴西郡始還狄道。"
  },
  {
    "id": "s0472",
    "blockIndex": 136,
    "zh": "燒當羌豪麻奴死，弟犀苦立。"
  },
  {
    "id": "s0473",
    "blockIndex": 137,
    "zh": "庚申晦，日有食之。"
  },
  {
    "id": "s0474",
    "blockIndex": 138,
    "zh": "冬，十月，上行幸長安；"
  },
  {
    "id": "s0475",
    "blockIndex": 138,
    "zh": "十一月，乙丑，還雒陽。"
  },
  {
    "id": "s0476",
    "blockIndex": 139,
    "zh": "是歲，京師及諸郡國二十三地震，三十六大水、雨雹。"
  },
  {
    "id": "s0477",
    "blockIndex": 140,
    "zh": "category:資治通鑑"
  }
]
