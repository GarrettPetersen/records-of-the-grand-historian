[
  {
    "id": "s0001",
    "blockIndex": 0,
    "zh": "資治通鑑第044卷"
  },
  {
    "id": "s0002",
    "blockIndex": 1,
    "zh": "【漢紀三十六】起強圉協洽，盡上章涒灘，凡十四年。"
  },
  {
    "id": "s0003",
    "blockIndex": 2,
    "zh": "春，正月，南郡蠻叛；"
  },
  {
    "id": "s0004",
    "blockIndex": 2,
    "zh": "遣武威將軍劉尚討破之。"
  },
  {
    "id": "s0005",
    "blockIndex": 3,
    "zh": "夏，五月，丁卯，大司徒蔡茂薨。"
  },
  {
    "id": "s0006",
    "blockIndex": 4,
    "zh": "秋，八月，丙戌，大司空杜林薨。"
  },
  {
    "id": "s0007",
    "blockIndex": 5,
    "zh": "九月，辛未，以陳留太守王況為大司徒。"
  },
  {
    "id": "s0008",
    "blockIndex": 6,
    "zh": "冬，十月，丙申，以太僕張純為大司空。"
  },
  {
    "id": "s0009",
    "blockIndex": 7,
    "zh": "武陵蠻精夫相單程等反，遣劉尚發兵萬餘人溯沅水入武谿擊之。"
  },
  {
    "id": "s0010",
    "blockIndex": 7,
    "zh": "尚輕敵深入，蠻乘險邀之，尚一軍悉沒。"
  },
  {
    "id": "s0011",
    "blockIndex": 8,
    "zh": "初，匈奴單于輿弟右谷蠡王知牙師，以次當為左賢王，左賢王次即當為單于。"
  },
  {
    "id": "s0012",
    "blockIndex": 8,
    "zh": "單于欲傳其子，遂殺知牙師。"
  },
  {
    "id": "s0013",
    "blockIndex": 8,
    "zh": "烏珠留單于有子曰比，為右薁鞬日逐王，領南邊八部。"
  },
  {
    "id": "s0014",
    "blockIndex": 8,
    "zh": "比見知牙師死，出怨言曰：「以兄弟言之，右谷蠡王次當立；"
  },
  {
    "id": "s0015",
    "blockIndex": 8,
    "zh": "以子言之，我前單于長子，我當立。"
  },
  {
    "id": "s0016",
    "blockIndex": 8,
    "zh": "」遂內懷猜懼，庭會稀闊。"
  },
  {
    "id": "s0017",
    "blockIndex": 8,
    "zh": "單于疑之，乃遣兩骨都侯監領比所部兵。"
  },
  {
    "id": "s0018",
    "blockIndex": 8,
    "zh": "及單于蒲奴立，比益恨望，密遣漢人郭衡奉匈奴地圖，詣西河太守求內附。"
  },
  {
    "id": "s0019",
    "blockIndex": 8,
    "zh": "兩骨都侯頗覺其意，會五月龍祠，勸單于誅比。"
  },
  {
    "id": "s0020",
    "blockIndex": 8,
    "zh": "比弟漸將王在單于帳下，聞之，馳以報比。"
  },
  {
    "id": "s0021",
    "blockIndex": 8,
    "zh": "比遂聚八部兵四五萬人，待兩骨都侯還，欲殺之。"
  },
  {
    "id": "s0022",
    "blockIndex": 8,
    "zh": "骨都侯且到，知其謀，亡去。"
  },
  {
    "id": "s0023",
    "blockIndex": 8,
    "zh": "單于遣萬騎擊之，見比眾盛，不敢進而還。"
  },
  {
    "id": "s0024",
    "blockIndex": 9,
    "zh": "是歲，鬲侯朱祜薨。"
  },
  {
    "id": "s0025",
    "blockIndex": 9,
    "zh": "祜為人質直，尚儒學；"
  },
  {
    "id": "s0026",
    "blockIndex": 9,
    "zh": "為將多受降，以克定城邑為本，不存首級之功。"
  },
  {
    "id": "s0027",
    "blockIndex": 9,
    "zh": "又禁制士卒不得虜掠百姓。"
  },
  {
    "id": "s0028",
    "blockIndex": 9,
    "zh": "軍人樂放縱，多以此怨之。"
  },
  {
    "id": "s0029",
    "blockIndex": 10,
    "zh": "春，正月，乙亥，赦天下。"
  },
  {
    "id": "s0030",
    "blockIndex": 11,
    "zh": "匈奴八部大人共議立日逐王比為呼韓邪單于，款五原塞，願永為籓蔽，扦御北虜。"
  },
  {
    "id": "s0031",
    "blockIndex": 11,
    "zh": "事下公卿，議者皆以為：「天下初定，中國空虛，夷狄情偽難知，不可許。"
  },
  {
    "id": "s0032",
    "blockIndex": 11,
    "zh": "」五官中郎將耿國獨以為：「宜如孝宣故事，受之。"
  },
  {
    "id": "s0033",
    "blockIndex": 11,
    "zh": "令東扞鮮卑，北拒匈奴，率厲四夷，完復邊郡。"
  },
  {
    "id": "s0034",
    "blockIndex": 11,
    "zh": "」帝從之。"
  },
  {
    "id": "s0035",
    "blockIndex": 12,
    "zh": "秋，七月，武陵蠻寇臨沅。"
  },
  {
    "id": "s0036",
    "blockIndex": 12,
    "zh": "遣謁者李嵩、中山太守馬成討之，不克。"
  },
  {
    "id": "s0037",
    "blockIndex": 12,
    "zh": "馬援請行，帝愍其老，未許，援曰：「臣尚能被甲上馬。"
  },
  {
    "id": "s0038",
    "blockIndex": 12,
    "zh": "」帝令試之。"
  },
  {
    "id": "s0039",
    "blockIndex": 12,
    "zh": "援據鞍顧眄，以示可用，帝笑曰：「矍鑠哉是翁！"
  },
  {
    "id": "s0040",
    "blockIndex": 12,
    "zh": "」遂遣授率中郎將馬武、耿舒等將四萬餘人，征五溪。"
  },
  {
    "id": "s0041",
    "blockIndex": 12,
    "zh": "援謂友人杜愔曰：「吾受厚恩，年迫日索，常恐不得死國事。"
  },
  {
    "id": "s0042",
    "blockIndex": 12,
    "zh": "今獲所願，甘心瞑目，但畏長者家兒或在左右，或與從事，殊難得調，介介獨惡是耳！"
  },
  {
    "id": "s0044",
    "blockIndex": 13,
    "zh": "冬，十月，匈奴日逐王比自立為南單于，遣使詣闕奉籓稱臣。"
  },
  {
    "id": "s0045",
    "blockIndex": 13,
    "zh": "上以問朗陵侯臧宮。"
  },
  {
    "id": "s0046",
    "blockIndex": 13,
    "zh": "宮曰：「匈奴饑疫分爭，臣願得五千騎以立功。"
  },
  {
    "id": "s0047",
    "blockIndex": 13,
    "zh": "」帝笑曰：「常勝之家，難與慮敵，吾方自思之。"
  },
  {
    "id": "s0049",
    "blockIndex": 14,
    "zh": "春，正月，遼東徼外貊人寇邊，太守祭肜招降之。"
  },
  {
    "id": "s0050",
    "blockIndex": 14,
    "zh": "肜又以財利撫納鮮卑大都護偏何，使招致異種，駱驛款塞。"
  },
  {
    "id": "s0051",
    "blockIndex": 14,
    "zh": "肜曰：「審欲立功，當歸擊匈奴，斬送頭首，乃信耳。"
  },
  {
    "id": "s0052",
    "blockIndex": 14,
    "zh": "」偏何等即擊匈奴，斬首二千餘級，持頭詣郡。"
  },
  {
    "id": "s0053",
    "blockIndex": 14,
    "zh": "其後歲歲相攻，輒送首級，受賞賜。"
  },
  {
    "id": "s0054",
    "blockIndex": 14,
    "zh": "自是匈奴衰弱，邊無寇警，鮮卑、烏桓並入朝貢。"
  },
  {
    "id": "s0055",
    "blockIndex": 14,
    "zh": "肜為人質厚重毅，撫夷狄以恩信，故皆畏而愛之，得其死力。"
  },
  {
    "id": "s0056",
    "blockIndex": 15,
    "zh": "南單于遣其弟左賢王莫將兵萬餘人擊北單于弟薁□建左賢王，生獲之；"
  },
  {
    "id": "s0057",
    "blockIndex": 15,
    "zh": "北單于震怖，卻地千餘里。"
  },
  {
    "id": "s0058",
    "blockIndex": 15,
    "zh": "北部薁□建骨都侯與右骨都侯率眾三萬餘人歸南單于。"
  },
  {
    "id": "s0059",
    "blockIndex": 15,
    "zh": "三月，南單于復遣使詣闕貢獻，求使者監護，遣侍子，修舊約。"
  },
  {
    "id": "s0060",
    "blockIndex": 16,
    "zh": "戊申晦，日有食之。"
  },
  {
    "id": "s0061",
    "blockIndex": 16,
    "zh": "馬援軍至臨鄉，擊破蠻兵，斬獲二千餘人。"
  },
  {
    "id": "s0062",
    "blockIndex": 17,
    "zh": "初，援嘗有疾，虎賁中郎將梁松來候之，獨拜床下，援不答。"
  },
  {
    "id": "s0063",
    "blockIndex": 17,
    "zh": "鬆去後，諸子問曰：「梁伯孫，帝婿，貴重朝庭，公卿已下莫不憚之，大人奈何獨不為禮？"
  },
  {
    "id": "s0064",
    "blockIndex": 17,
    "zh": "」援曰：「我乃松父友也，雖貴，何得失其序乎！"
  },
  {
    "id": "s0066",
    "blockIndex": 18,
    "zh": "援兄子嚴、敦並喜譏議，通輕俠，援前在交趾，還書誡之曰：「吾欲汝曹聞人過失，如聞父母之名，耳可得聞，口不可得言也。"
  },
  {
    "id": "s0067",
    "blockIndex": 18,
    "zh": "好論議人長短，妄是非政法，此吾所大惡也，寧死，不願聞子孫有此行也。"
  },
  {
    "id": "s0068",
    "blockIndex": 18,
    "zh": "龍伯高敦厚周慎，口無擇言，謙約節儉，廉公有威，吾愛之重之，願汝曹效之。"
  },
  {
    "id": "s0069",
    "blockIndex": 18,
    "zh": "杜季良豪俠好義，憂人之憂，樂人之樂，父喪致客，數郡畢至，吾愛之重之，不願汝曹效也。"
  },
  {
    "id": "s0070",
    "blockIndex": 18,
    "zh": "效伯高不得，猶為謹敕之士，所謂『刻鵠不成尚類鶩』者也；"
  },
  {
    "id": "s0071",
    "blockIndex": 18,
    "zh": "效季良不得，陷為天下輕薄子，所謂『畫虎不成反類狗』者也。"
  },
  {
    "id": "s0072",
    "blockIndex": 18,
    "zh": "」伯高者，山都長龍述也，季良者，越騎司馬杜保也，皆京兆人。"
  },
  {
    "id": "s0073",
    "blockIndex": 18,
    "zh": "會保仇人上書，訟「保為行浮薄，亂群惑眾，伏波將軍萬望還書以誡兄子，而梁松、竇固與之交結，將扇其輕偽，敗亂諸夏。"
  },
  {
    "id": "s0074",
    "blockIndex": 18,
    "zh": "」書奏，帝召責松、固，以訟書及援誡書示之，松、固叩頭流血，而得不罪。"
  },
  {
    "id": "s0075",
    "blockIndex": 18,
    "zh": "詔免保官，擢拜龍述為零陵太守。"
  },
  {
    "id": "s0076",
    "blockIndex": 18,
    "zh": "松由是恨援。"
  },
  {
    "id": "s0077",
    "blockIndex": 19,
    "zh": "及援討武陵蠻，軍次下雋，有兩道可入：從壺頭則路近而水險，從充則塗夷而運遠。"
  },
  {
    "id": "s0078",
    "blockIndex": 19,
    "zh": "耿舒欲從充道，援以為棄日費糧，不如進壺頭，扼其喉咽，充賊自破。"
  },
  {
    "id": "s0079",
    "blockIndex": 19,
    "zh": "以事上之，帝從援策。"
  },
  {
    "id": "s0080",
    "blockIndex": 19,
    "zh": "進營壺頭，賊乘高守隘，水疾，船不得上。"
  },
  {
    "id": "s0081",
    "blockIndex": 19,
    "zh": "會暑甚，士卒多疫死，援亦中病，乃穿岸為室以避炎氣。"
  },
  {
    "id": "s0082",
    "blockIndex": 19,
    "zh": "賊每升險鼓噪，援輒曳足以觀之，左右哀其壯意，莫不為之流涕。"
  },
  {
    "id": "s0083",
    "blockIndex": 19,
    "zh": "耿舒與兄好畤侯弇書曰：「前舒上書當先擊充，糧雖難運而兵馬得用，軍人數萬，爭欲先奮。"
  },
  {
    "id": "s0084",
    "blockIndex": 19,
    "zh": "今壺頭竟不得進，大眾怫郁行死，誠可痛惜！"
  },
  {
    "id": "s0085",
    "blockIndex": 19,
    "zh": "前到臨鄉，賊無故自致，若夜擊之，即可殄滅。"
  },
  {
    "id": "s0086",
    "blockIndex": 19,
    "zh": "伏波類西域賈胡，到一處輒止，以是失利。"
  },
  {
    "id": "s0087",
    "blockIndex": 19,
    "zh": "今果疾疫，皆如舒言。"
  },
  {
    "id": "s0088",
    "blockIndex": 19,
    "zh": "」弇得書奏之，帝乃使梁松乘驛責問援，因代監軍。"
  },
  {
    "id": "s0089",
    "blockIndex": 19,
    "zh": "會援卒，松因是構陷援。"
  },
  {
    "id": "s0090",
    "blockIndex": 19,
    "zh": "帝大怒，追收援新息侯印綬。"
  },
  {
    "id": "s0091",
    "blockIndex": 19,
    "zh": "初，援在交趾，常餌薏苡實，能輕身，勝障氣，軍還，載之一車。"
  },
  {
    "id": "s0092",
    "blockIndex": 19,
    "zh": "及卒後，有上書譖之者，以為前所載還皆明珠文犀。"
  },
  {
    "id": "s0093",
    "blockIndex": 19,
    "zh": "帝益怒。"
  },
  {
    "id": "s0094",
    "blockIndex": 19,
    "zh": "援妻孥惶懼，不敢以喪還舊塋，稿葬城西，賓客故人，莫敢吊會。"
  },
  {
    "id": "s0095",
    "blockIndex": 19,
    "zh": "嚴與援妻子草索相連，詣闕請罪。"
  },
  {
    "id": "s0096",
    "blockIndex": 19,
    "zh": "帝乃出松書以示之，方知所坐，上書訴冤，前後六上，辭甚哀切。"
  },
  {
    "id": "s0097",
    "blockIndex": 19,
    "zh": "前雲陽令扶風朱勃詣闕上書曰：「竊見故伏波將軍馬援，拔自西州，欽慕聖義，聞關險難，觸冒萬死，經營隴、冀，謀如湧泉，勢如轉規，兵動有功，師進輒克。"
  },
  {
    "id": "s0098",
    "blockIndex": 19,
    "zh": "誅鋤先零，飛矢貫脛，出征交趾，與妻子生訣。"
  },
  {
    "id": "s0099",
    "blockIndex": 19,
    "zh": "間復南討，立陷臨鄉，師已有業，未竟而死。"
  },
  {
    "id": "s0100",
    "blockIndex": 19,
    "zh": "吏士雖疫，援不獨存。"
  },
  {
    "id": "s0101",
    "blockIndex": 19,
    "zh": "夫戰或以久而立功，或以速而致敗，深入未必為得，不進未必為非，人情豈樂久屯絕地不生歸哉！"
  },
  {
    "id": "s0102",
    "blockIndex": 19,
    "zh": "惟援得事朝廷二十二年，北出塞漠，南度江海，觸冒害氣，僵死軍事，名滅爵絕，國土不傳，海內不知其過，眾遮未聞其毀，家屬杜門，葬不歸墓，怨隙並興，宗親怖心栗，死者不能自列，生者莫為之訟，臣竊傷之！"
  },
  {
    "id": "s0103",
    "blockIndex": 19,
    "zh": "夫明主□農於用賞，約於用刑，高祖嘗與陳平金四萬斤以間楚軍，不問出入所為，豈復疑以錢谷間哉！"
  },
  {
    "id": "s0104",
    "blockIndex": 19,
    "zh": "願下公卿，平援功罪，宜絕宜續，以厭海內之望。"
  },
  {
    "id": "s0105",
    "blockIndex": 19,
    "zh": "」帝意稍解。"
  },
  {
    "id": "s0106",
    "blockIndex": 20,
    "zh": "初，勃年十二，能誦《詩》、《書》，常候援兄況，辭言嫻雅，援裁知書，見之自失。"
  },
  {
    "id": "s0107",
    "blockIndex": 20,
    "zh": "況知其意，乃自酌酒慰援曰：「朱勃小器速成，智盡此耳，卒當從汝稟學，勿畏也。"
  },
  {
    "id": "s0108",
    "blockIndex": 20,
    "zh": "」勃未二十，右扶風清試守渭城宰。"
  },
  {
    "id": "s0109",
    "blockIndex": 20,
    "zh": "及援為將軍封侯，而勃位不過縣令。"
  },
  {
    "id": "s0110",
    "blockIndex": 20,
    "zh": "援後雖貴，常待以舊恩而卑侮之，勃愈身自親。"
  },
  {
    "id": "s0111",
    "blockIndex": 20,
    "zh": "及援遇讒，唯勃能終焉。"
  },
  {
    "id": "s0112",
    "blockIndex": 21,
    "zh": "謁者南陽宗均監援軍，援既卒，軍士疫死者太半，蠻亦饑困。"
  },
  {
    "id": "s0113",
    "blockIndex": 21,
    "zh": "均乃與諸將議曰：「今道遠士病，不可以戰，欲權承製降之，何如？"
  },
  {
    "id": "s0114",
    "blockIndex": 21,
    "zh": "」諸將皆伏地莫敢應。"
  },
  {
    "id": "s0115",
    "blockIndex": 21,
    "zh": "均曰：「夫忠臣出竟，有可以安國家，專之可也。"
  },
  {
    "id": "s0116",
    "blockIndex": 21,
    "zh": "」乃矯制調伏波司馬呂種守沅陵長，命種奉詔書入虜營，告以恩信，因勒兵隨其後。"
  },
  {
    "id": "s0117",
    "blockIndex": 21,
    "zh": "蠻夷震怖，冬十月，共斬其大帥而降。"
  },
  {
    "id": "s0118",
    "blockIndex": 21,
    "zh": "於是均入賊營，散其眾，遣歸本郡，為置長吏而還，群蠻遂平。"
  },
  {
    "id": "s0119",
    "blockIndex": 21,
    "zh": "均未至，先自劾矯制之罪。"
  },
  {
    "id": "s0120",
    "blockIndex": 21,
    "zh": "上嘉其功，迎，賜以金帛，令過家上塚。"
  },
  {
    "id": "s0121",
    "blockIndex": 22,
    "zh": "是歲，遼西烏桓大人郝旦等率眾內屬，詔封烏桓渠帥為侯、王、君長者八十一人，使居塞內，佈於緣邊諸郡，令招來種人，給其衣食，遂為漢偵候，助擊匈奴、鮮卑。"
  },
  {
    "id": "s0122",
    "blockIndex": 22,
    "zh": "時司徒掾班彪上言：「烏桓天性輕黠，好為寇賊，若久放縱而無總領者，必復掠居人，但委主降掾吏，恐非所能制。"
  },
  {
    "id": "s0123",
    "blockIndex": 22,
    "zh": "臣愚以為宜復置烏桓校尉，誠有益於附集，省國家之邊慮。"
  },
  {
    "id": "s0124",
    "blockIndex": 22,
    "zh": "」帝從之，於是始復置校尉於上谷寧城，開營府，並領鮮卑賞賜、質子，歲時互市焉。"
  },
  {
    "id": "s0125",
    "blockIndex": 23,
    "zh": "正月，詔增百官奉，其千石已上，減於西京舊制，六百石已下，增於舊秩。"
  },
  {
    "id": "s0126",
    "blockIndex": 24,
    "zh": "初作壽陵。"
  },
  {
    "id": "s0127",
    "blockIndex": 24,
    "zh": "帝曰：「古者帝王之葬，皆陶人、瓦器、木車、茅馬，使後世之人不知其處。"
  },
  {
    "id": "s0128",
    "blockIndex": 24,
    "zh": "太宗識終始之義，景帝能述遵孝道，遭天下反覆，而霸陵獨完受其福，豈不美哉！"
  },
  {
    "id": "s0129",
    "blockIndex": 24,
    "zh": "今所制地不過二三頃，無為山陵陂池，裁令流水而已。"
  },
  {
    "id": "s0130",
    "blockIndex": 24,
    "zh": "使迭興之後，與丘隴同體。"
  },
  {
    "id": "s0131",
    "blockIndex": 24,
    "zh": "」詔遣中郎將段郴、副校尉王郁使南匈奴，立其庭，去五原西部塞八十里。"
  },
  {
    "id": "s0132",
    "blockIndex": 24,
    "zh": "使者令單于伏拜受詔，單于顧望有頃，乃伏稱臣。"
  },
  {
    "id": "s0133",
    "blockIndex": 24,
    "zh": "拜訖，令譯曉使者曰：「單于新立，誠慚於左右，願使者眾中無相屈折也。"
  },
  {
    "id": "s0134",
    "blockIndex": 24,
    "zh": "」詔聽南單于入居雲中，始置使匈奴中郎將，將兵衛護之。"
  },
  {
    "id": "s0135",
    "blockIndex": 25,
    "zh": "夏，南單于所獲北虜薁□建左賢王，將其眾及南部五骨都侯合三萬餘人畔歸，去北庭三百餘里，自立為單于。"
  },
  {
    "id": "s0136",
    "blockIndex": 25,
    "zh": "月餘，日更相攻擊，五骨都侯皆死，左賢王自殺，諸骨都侯子各擁兵自守。"
  },
  {
    "id": "s0137",
    "blockIndex": 25,
    "zh": "秋，南單于遣子入侍。"
  },
  {
    "id": "s0138",
    "blockIndex": 25,
    "zh": "詔賜單于冠帶、璽綬、車馬、金帛、甲兵、什器。"
  },
  {
    "id": "s0139",
    "blockIndex": 25,
    "zh": "又轉河東米□二萬五千斛，牛羊三萬六千頭以贍給之。"
  },
  {
    "id": "s0140",
    "blockIndex": 25,
    "zh": "令中郎將將弛刑五十人，隨單于所處，參辭訟，察動靜。"
  },
  {
    "id": "s0141",
    "blockIndex": 25,
    "zh": "單于歲盡輒遣奉奏，送侍子入朝，漢遣謁者送前侍子還單于庭，賜單于及閼氏、左、右賢王以下繒彩合萬匹，歲以為常。"
  },
  {
    "id": "s0142",
    "blockIndex": 25,
    "zh": "於是雲中、五原、朔方、北地、定襄、雁門、上谷、代八郡民歸於本土。"
  },
  {
    "id": "s0143",
    "blockIndex": 25,
    "zh": "遣謁者分將弛刑，補治城郭，發遣邊民在中國者布還諸縣，皆賜以裝錢，轉給糧食。"
  },
  {
    "id": "s0144",
    "blockIndex": 25,
    "zh": "時城郭丘墟，掃地更為，上乃悔前徙之。"
  },
  {
    "id": "s0145",
    "blockIndex": 26,
    "zh": "冬，南匈奴五骨都侯子復將其眾三千人歸南部，北單于使騎追擊，悉獲其眾。"
  },
  {
    "id": "s0146",
    "blockIndex": 26,
    "zh": "南單于遣兵拒之，逆戰不利，於是復詔單于徙居西河美稷，因使段郴、王郁留西河擁護之，令西河長史歲將騎二千、弛刑五百人助中郎將衛護單于，冬屯夏罷，自後以為常。"
  },
  {
    "id": "s0147",
    "blockIndex": 26,
    "zh": "南單于既居西河，亦列置諸部王，助漢扞戍北地、朔方、五原、雲中、定襄、雁門、代郡，皆領部眾，為郡縣偵邏耳目。"
  },
  {
    "id": "s0148",
    "blockIndex": 26,
    "zh": "北單于惶恐，頗還所略漢民以示善意，鈔兵每到南部下，還過亭候，輒謝曰：「自擊亡虜薁□建日逐耳，非敢犯漢民也。"
  },
  {
    "id": "s0150",
    "blockIndex": 27,
    "zh": "夏，四月，戊午，大司徒王況薨。"
  },
  {
    "id": "s0151",
    "blockIndex": 28,
    "zh": "五月，丁丑，詔司徒、司空並去「大」名，改大司馬為太尉。"
  },
  {
    "id": "s0152",
    "blockIndex": 28,
    "zh": "驃騎大將軍行大司馬劉隆即日罷，以太僕趙熹為太尉，大司農馮勤為司徒。"
  },
  {
    "id": "s0153",
    "blockIndex": 29,
    "zh": "北匈奴遣使詣武威求和親，帝召公卿廷議，不決。"
  },
  {
    "id": "s0154",
    "blockIndex": 29,
    "zh": "皇太子言曰：「南單于新附，北虜懼於見伐，故傾耳而聽，爭欲歸義耳。"
  },
  {
    "id": "s0155",
    "blockIndex": 29,
    "zh": "今未能出兵而反交通北虜，臣恐南單于將有二心，北虜降者且不復來矣。"
  },
  {
    "id": "s0156",
    "blockIndex": 29,
    "zh": "」帝然之，告武威太守勿受其使。"
  },
  {
    "id": "s0157",
    "blockIndex": 30,
    "zh": "朗陵侯臧宮、揚虛侯馬武上書曰：「匈奴貪利，無有禮信，窮則稽首，安則侵盜。"
  },
  {
    "id": "s0158",
    "blockIndex": 30,
    "zh": "虜今人畜疫死，旱蝗赤地，疲睏乏力，不當中國一郡，萬里死命，縣在陛下。"
  },
  {
    "id": "s0159",
    "blockIndex": 30,
    "zh": "福不再來，時或易失，豈宜固守文德而墮武事乎！"
  },
  {
    "id": "s0160",
    "blockIndex": 30,
    "zh": "今命將臨塞，厚縣購賞，喻告高句驪、烏桓、鮮卑攻其左，發河西四郡、天水、隴西羌、胡擊其右，如此，北虜之滅，不過數年。"
  },
  {
    "id": "s0161",
    "blockIndex": 30,
    "zh": "臣恐陛下仁恩不忍，謀臣狐疑，令萬世刻石之功不立於聖世！"
  },
  {
    "id": "s0162",
    "blockIndex": 30,
    "zh": "」詔報曰：「《黃石公記》曰：『柔能制剛，弱能制強。"
  },
  {
    "id": "s0163",
    "blockIndex": 30,
    "zh": "捨近謀遠者，勞而無功；"
  },
  {
    "id": "s0164",
    "blockIndex": 30,
    "zh": "捨遠謀近者，逸而有終。"
  },
  {
    "id": "s0165",
    "blockIndex": 30,
    "zh": "故曰：務廣地者荒，務廣德者強，有其有者安，貪人有者殘。"
  },
  {
    "id": "s0166",
    "blockIndex": 30,
    "zh": "殘滅之政，雖成必敗。"
  },
  {
    "id": "s0167",
    "blockIndex": 30,
    "zh": "』今國無善政，災變不息，百姓驚惶，人不自保，而復欲遠事邊外乎！"
  },
  {
    "id": "s0168",
    "blockIndex": 30,
    "zh": "孔子曰：『吾恐季孫之憂不在顓臾。"
  },
  {
    "id": "s0169",
    "blockIndex": 30,
    "zh": "』且北狄尚強，而屯田警備，傳聞之事，恆多失實。"
  },
  {
    "id": "s0170",
    "blockIndex": 30,
    "zh": "誠能舉下下之半以滅大寇，豈非至願！"
  },
  {
    "id": "s0171",
    "blockIndex": 30,
    "zh": "苟非其時，不如息民。"
  },
  {
    "id": "s0172",
    "blockIndex": 30,
    "zh": "」自是諸將莫敢復言兵事者。"
  },
  {
    "id": "s0173",
    "blockIndex": 31,
    "zh": "上問趙熹以久長之計，熹請遣諸王就國。"
  },
  {
    "id": "s0174",
    "blockIndex": 31,
    "zh": "冬，上始遣魯王興、齊王石就國。"
  },
  {
    "id": "s0175",
    "blockIndex": 31,
    "zh": "是歲，帝舅壽張恭侯樊宏薨。"
  },
  {
    "id": "s0176",
    "blockIndex": 31,
    "zh": "宏為人謙柔畏慎，每當朝會，輒迎期先到，俯伏待事；"
  },
  {
    "id": "s0177",
    "blockIndex": 31,
    "zh": "所上便宜，手自書寫，毀削草本；"
  },
  {
    "id": "s0178",
    "blockIndex": 31,
    "zh": "公朝訪逮，不敢眾對。"
  },
  {
    "id": "s0179",
    "blockIndex": 31,
    "zh": "宗族染其化，未嘗犯法。"
  },
  {
    "id": "s0180",
    "blockIndex": 31,
    "zh": "帝甚重之。"
  },
  {
    "id": "s0181",
    "blockIndex": 31,
    "zh": "及病困，遺令薄葬，一無所用。"
  },
  {
    "id": "s0182",
    "blockIndex": 31,
    "zh": "以為棺柩一藏，不宜復見，如有腐敗，傷孝子之心，使與夫人同墳異藏。"
  },
  {
    "id": "s0183",
    "blockIndex": 31,
    "zh": "帝善其令，以書示百官，因曰：「今不順壽張侯意，無以彰其德；"
  },
  {
    "id": "s0184",
    "blockIndex": 31,
    "zh": "且吾萬歲之後，欲以為式。"
  },
  {
    "id": "s0186",
    "blockIndex": 32,
    "zh": "春，正月，己巳，徙魯王興為北海王；"
  },
  {
    "id": "s0187",
    "blockIndex": 32,
    "zh": "以魯益東海。"
  },
  {
    "id": "s0188",
    "blockIndex": 32,
    "zh": "帝以東海王強去就有禮，故優以大封，食二十九縣，賜虎賁、旄頭，設鐘虡之樂，擬於乘輿。"
  },
  {
    "id": "s0189",
    "blockIndex": 33,
    "zh": "夏，六月，丁卯，沛太后郭后薨。"
  },
  {
    "id": "s0190",
    "blockIndex": 34,
    "zh": "初，馬援兄子婿王磐，平阿侯仁之子也。"
  },
  {
    "id": "s0191",
    "blockIndex": 34,
    "zh": "王莽敗，磐擁富貲為遊俠，有名江、淮間。"
  },
  {
    "id": "s0192",
    "blockIndex": 34,
    "zh": "後游京師，與諸貴戚友善，援謂姊子曹訓曰：「王氏，廢姓也，子石當屏居自守，而反游京師長者，用氣自行，多所陵折，其敗必也。"
  },
  {
    "id": "s0193",
    "blockIndex": 34,
    "zh": "」後歲餘，磐坐事死；"
  },
  {
    "id": "s0194",
    "blockIndex": 34,
    "zh": "磐子肅復出入王侯邸第。"
  },
  {
    "id": "s0195",
    "blockIndex": 34,
    "zh": "時禁罔尚疏，諸王皆在京師，競修名譽，招游士。"
  },
  {
    "id": "s0196",
    "blockIndex": 34,
    "zh": "馬援謂司馬呂種曰：「建武之元，名為天下重開，自今以往，海內日當安耳。"
  },
  {
    "id": "s0197",
    "blockIndex": 34,
    "zh": "但憂國家諸子並壯而舊防未立，若多通賓客，則大獄起矣。"
  },
  {
    "id": "s0198",
    "blockIndex": 34,
    "zh": "卿曹戒慎之！"
  },
  {
    "id": "s0199",
    "blockIndex": 34,
    "zh": "」至是，有上書告肅等受誅之家，為諸王賓客，慮因事生亂。"
  },
  {
    "id": "s0200",
    "blockIndex": 34,
    "zh": "會更始之子壽光侯鯉得幸於沛王，怨劉盆子，結客殺故式侯恭。"
  },
  {
    "id": "s0201",
    "blockIndex": 34,
    "zh": "帝怒，沛王坐系詔獄，三日乃得出。"
  },
  {
    "id": "s0202",
    "blockIndex": 34,
    "zh": "因詔郡縣收捕諸王賓客，更相牽引，死者以千數；"
  },
  {
    "id": "s0203",
    "blockIndex": 34,
    "zh": "呂種亦與其禍，臨命歎曰：「馬將軍誠神人也！"
  },
  {
    "id": "s0205",
    "blockIndex": 35,
    "zh": "秋，八月，戊寅，東海王強、沛王輔、楚王英、濟南王康、淮陽王延始就國。"
  },
  {
    "id": "s0206",
    "blockIndex": 36,
    "zh": "上大會群臣，問：「誰可傅太子者？"
  },
  {
    "id": "s0207",
    "blockIndex": 36,
    "zh": "」群臣承望上意，皆言太子舅執金吾原鹿侯陰識可。"
  },
  {
    "id": "s0208",
    "blockIndex": 36,
    "zh": "博士張佚正色曰：「今陛下立太子，為陰氏乎，為天下乎？"
  },
  {
    "id": "s0209",
    "blockIndex": 36,
    "zh": "即為陰氏，則陰侯可；"
  },
  {
    "id": "s0210",
    "blockIndex": 36,
    "zh": "為天下，則固宜用天下之賢才！"
  },
  {
    "id": "s0211",
    "blockIndex": 36,
    "zh": "」帝稱善，曰：「欲置傅者，以輔太子也；"
  },
  {
    "id": "s0212",
    "blockIndex": 36,
    "zh": "今博士不難正朕，況太子乎！"
  },
  {
    "id": "s0213",
    "blockIndex": 36,
    "zh": "」即拜佚為太子太傅，以博士桓榮為少傅，賜以輜車、乘馬。"
  },
  {
    "id": "s0214",
    "blockIndex": 36,
    "zh": "榮大會諸生，陳其車馬、印綬，曰：「今日所蒙，稽古之力也，可不勉哉！"
  },
  {
    "id": "s0216",
    "blockIndex": 37,
    "zh": "北匈奴遣使貢馬及裘，更乞和親，並請音樂，又求率西域諸國胡客俱獻見。"
  },
  {
    "id": "s0217",
    "blockIndex": 37,
    "zh": "帝下三府議酬答之宜，司徒掾班彪曰：「臣聞孝宣皇帝敕邊守尉曰：『匈奴大國，多變詐，交接得其情，則卻敵折衝；"
  },
  {
    "id": "s0218",
    "blockIndex": 37,
    "zh": "應對入其數，則反為輕欺。"
  },
  {
    "id": "s0219",
    "blockIndex": 37,
    "zh": "』今北匈奴見南單于來附，懼謀其國，故數乞和親，又遠驅牛馬與漢合市，重遣名王，多所貢獻，斯皆外示富強以相欺誕也。"
  },
  {
    "id": "s0220",
    "blockIndex": 37,
    "zh": "臣見其獻益重，知其國益虛；"
  },
  {
    "id": "s0221",
    "blockIndex": 37,
    "zh": "歸親愈數，為懼愈多。"
  },
  {
    "id": "s0222",
    "blockIndex": 37,
    "zh": "然今既未獲助南，則亦不宜絕北，羈縻之義，禮無不答。"
  },
  {
    "id": "s0223",
    "blockIndex": 37,
    "zh": "謂可頗加賞賜，略與所獻相當，報答之辭，令必有適。"
  },
  {
    "id": "s0224",
    "blockIndex": 37,
    "zh": "今立稿草並上，曰：『單于不忘漢恩，追念先祖舊約，欲修和親以輔身安國，計議甚高，為單于嘉之！"
  },
  {
    "id": "s0225",
    "blockIndex": 37,
    "zh": "往者匈奴數有乖亂，呼韓邪、郅支自相仇戾，自絕皇澤，而呼韓附親，忠孝彌著。"
  },
  {
    "id": "s0226",
    "blockIndex": 37,
    "zh": "及漢滅郅支，遂保國傳嗣，子孫相繼。"
  },
  {
    "id": "s0227",
    "blockIndex": 37,
    "zh": "今南單于攜眾向南，款塞歸命，自以呼韓嫡長，次第當立，而侵奪失職，猜疑相背，數請兵將，歸掃北庭，策謀紛紜，無所不至。"
  },
  {
    "id": "s0228",
    "blockIndex": 37,
    "zh": "惟念斯言不可獨聽，又以北單于比年貢獻，欲修和親，故拒而未許，將以成單于忠孝之義。"
  },
  {
    "id": "s0229",
    "blockIndex": 37,
    "zh": "漢秉威信，總率萬國，日月所照，皆為臣妾，殊俗百蠻，義無親疏，服順者褒賞，畔逆者誅罰，善惡之效，呼韓、郅支是也。"
  },
  {
    "id": "s0230",
    "blockIndex": 37,
    "zh": "今單于欲修和親，款誠已達，何嫌而欲率西域諸國俱來獻見！"
  },
  {
    "id": "s0231",
    "blockIndex": 37,
    "zh": "西域國屬匈奴與屬漢何異！"
  },
  {
    "id": "s0232",
    "blockIndex": 37,
    "zh": "單于數連兵亂，國內虛耗，貢物裁以通禮，何必獻馬裘！"
  },
  {
    "id": "s0233",
    "blockIndex": 37,
    "zh": "今繼雜繒五百匹，弓鞬韣丸一，矢四發，遺單于；"
  },
  {
    "id": "s0234",
    "blockIndex": 37,
    "zh": "又賜獻馬左骨都侯、右谷蠡王雜繒各四百匹，斬馬劍各一。"
  },
  {
    "id": "s0235",
    "blockIndex": 37,
    "zh": "單于前言「先帝時所賜呼韓邪竽、瑟、空侯皆敗，願復裁賜。"
  },
  {
    "id": "s0236",
    "blockIndex": 37,
    "zh": "」念單于國尚未安，方厲武節，以戰攻為務，竽瑟之用，不如良弓利劍，故未以繼。"
  },
  {
    "id": "s0237",
    "blockIndex": 37,
    "zh": "朕不愛小物，於單于便宜所欲，遣驛以聞。"
  },
  {
    "id": "s0238",
    "blockIndex": 37,
    "zh": "』」聞悉納從之。"
  },
  {
    "id": "s0239",
    "blockIndex": 38,
    "zh": "春，二月，丁巳朔，日有食之。"
  },
  {
    "id": "s0240",
    "blockIndex": 39,
    "zh": "春，二月，車駕東巡。"
  },
  {
    "id": "s0241",
    "blockIndex": 39,
    "zh": "群臣上言：「即位三十年，宜封禪泰山。"
  },
  {
    "id": "s0242",
    "blockIndex": 39,
    "zh": "」詔曰：「即位三十年，百姓怨氣滿腹，『吾誰欺，欺天乎！"
  },
  {
    "id": "s0243",
    "blockIndex": 39,
    "zh": "』『曾謂泰山不如林放乎！"
  },
  {
    "id": "s0244",
    "blockIndex": 39,
    "zh": "』何事污七十二代之編錄！"
  },
  {
    "id": "s0245",
    "blockIndex": 39,
    "zh": "若郡縣遠遣吏上壽，盛稱虛美，必髡，令屯田。"
  },
  {
    "id": "s0246",
    "blockIndex": 39,
    "zh": "」於是群臣不敢復言。"
  },
  {
    "id": "s0247",
    "blockIndex": 40,
    "zh": "甲子，上幸魯濟南；"
  },
  {
    "id": "s0248",
    "blockIndex": 40,
    "zh": "閏月，癸丑，還宮。"
  },
  {
    "id": "s0249",
    "blockIndex": 41,
    "zh": "有星孛於紫宮。"
  },
  {
    "id": "s0250",
    "blockIndex": 42,
    "zh": "夏，四月，戊子，徙左翊王焉為中山王。"
  },
  {
    "id": "s0251",
    "blockIndex": 43,
    "zh": "五月，大水。"
  },
  {
    "id": "s0252",
    "blockIndex": 44,
    "zh": "秋，七月，丁酉，上行幸魯；"
  },
  {
    "id": "s0253",
    "blockIndex": 44,
    "zh": "冬，十一月，丁酉，還宮。"
  },
  {
    "id": "s0254",
    "blockIndex": 45,
    "zh": "膠東剛侯賈復薨。"
  },
  {
    "id": "s0255",
    "blockIndex": 45,
    "zh": "復從征伐，未嘗喪敗，數與諸將潰圍解急，身被十二創。"
  },
  {
    "id": "s0256",
    "blockIndex": 45,
    "zh": "帝以復敢深入，希令遠征，而壯其勇節，常自從之，故復光方面之勳。"
  },
  {
    "id": "s0257",
    "blockIndex": 45,
    "zh": "諸將每論功伐，復未嘗有言，帝輒曰：「賈君之功，我自知之。"
  },
  {
    "id": "s0259",
    "blockIndex": 46,
    "zh": "夏，五月，大水。"
  },
  {
    "id": "s0260",
    "blockIndex": 47,
    "zh": "癸酉晦，日有食之。"
  },
  {
    "id": "s0261",
    "blockIndex": 48,
    "zh": "蝗。"
  },
  {
    "id": "s0262",
    "blockIndex": 48,
    "zh": "京兆掾第五倫領長安市，公平廉介，市無奸枉。"
  },
  {
    "id": "s0263",
    "blockIndex": 48,
    "zh": "每讀詔書，常歎息曰：「此聖主也，一見決矣。"
  },
  {
    "id": "s0264",
    "blockIndex": 48,
    "zh": "」等輩笑之曰：「爾說將尚不能下，安能動萬乘乎！"
  },
  {
    "id": "s0265",
    "blockIndex": 48,
    "zh": "」倫曰：「未遇知己，道不同故耳。"
  },
  {
    "id": "s0266",
    "blockIndex": 48,
    "zh": "」後舉孝廉，補淮陽王醫工長。"
  },
  {
    "id": "s0267",
    "blockIndex": 49,
    "zh": "春，正月，淮陽王入朝，倫隨官屬得會見。"
  },
  {
    "id": "s0268",
    "blockIndex": 49,
    "zh": "帝問以政事，倫因此酬對，帝大悅；"
  },
  {
    "id": "s0269",
    "blockIndex": 49,
    "zh": "明日，復特召入，與語至夕。"
  },
  {
    "id": "s0270",
    "blockIndex": 49,
    "zh": "帝謂倫曰：「聞卿為吏，篣婦公，不過從兄飯，寧有之邪？"
  },
  {
    "id": "s0271",
    "blockIndex": 49,
    "zh": "」對曰：「臣三娶妻，皆無父。"
  },
  {
    "id": "s0272",
    "blockIndex": 49,
    "zh": "少遭饑亂，實不敢妄過人食。"
  },
  {
    "id": "s0273",
    "blockIndex": 49,
    "zh": "眾人以臣愚蔽，故生是語耳。"
  },
  {
    "id": "s0274",
    "blockIndex": 49,
    "zh": "」帝大笑。"
  },
  {
    "id": "s0275",
    "blockIndex": 49,
    "zh": "以倫為扶夷長，未到官，追拜會稽太守；"
  },
  {
    "id": "s0276",
    "blockIndex": 49,
    "zh": "為政清而有惠，百姓愛之。"
  },
  {
    "id": "s0277",
    "blockIndex": 50,
    "zh": "上讀《河圖會昌符》曰；"
  },
  {
    "id": "s0278",
    "blockIndex": 50,
    "zh": "「赤劉之九，會命岱宗。"
  },
  {
    "id": "s0279",
    "blockIndex": 50,
    "zh": "」上感此文，乃詔虎賁中郎將梁松等按索《河》、《雒》讖文，言九世當封禪者凡三十六事。"
  },
  {
    "id": "s0280",
    "blockIndex": 50,
    "zh": "於是張純等復奏請封禪，上乃許焉。"
  },
  {
    "id": "s0281",
    "blockIndex": 50,
    "zh": "詔有司求元封故事，當用方石再累，玉檢、金泥。"
  },
  {
    "id": "s0282",
    "blockIndex": 50,
    "zh": "上以石功難就，欲因孝武故封石，置玉牒其中。"
  },
  {
    "id": "s0283",
    "blockIndex": 50,
    "zh": "梁松爭以為不可，乃命石工取完青石，無必五色。"
  },
  {
    "id": "s0284",
    "blockIndex": 50,
    "zh": "丁卯，車駕東巡。"
  },
  {
    "id": "s0285",
    "blockIndex": 50,
    "zh": "二月，己卯，幸魯，進幸泰山。"
  },
  {
    "id": "s0286",
    "blockIndex": 50,
    "zh": "辛卯，晨，燎，祭天於泰山下南方，群神皆從，用樂如南郊。"
  },
  {
    "id": "s0287",
    "blockIndex": 50,
    "zh": "事畢，至食時，天子御輦登山，日中後，到山上，更衣。"
  },
  {
    "id": "s0288",
    "blockIndex": 50,
    "zh": "晡時，升壇北面，尚書令奉玉牒檢，天子以寸二分璽親封之，訖，太常命騶騎二千餘人發壇上方石，尚書令藏玉牒已，復石覆訖，尚書令以五寸印封石檢。"
  },
  {
    "id": "s0289",
    "blockIndex": 50,
    "zh": "事畢，天子再拜。"
  },
  {
    "id": "s0290",
    "blockIndex": 50,
    "zh": "群臣稱萬歲，乃復道下。"
  },
  {
    "id": "s0291",
    "blockIndex": 50,
    "zh": "夜半後，上乃到山下，百官明旦乃訖。"
  },
  {
    "id": "s0292",
    "blockIndex": 50,
    "zh": "甲午，禪祭地於梁陰，以高後配，山川群神從，如元始中北郊故事。"
  },
  {
    "id": "s0293",
    "blockIndex": 51,
    "zh": "三月，戊辰，司空張純薨。"
  },
  {
    "id": "s0294",
    "blockIndex": 52,
    "zh": "夏，四月，癸酉，車駕還宮；"
  },
  {
    "id": "s0295",
    "blockIndex": 52,
    "zh": "己卯，赦天下，改元。"
  },
  {
    "id": "s0296",
    "blockIndex": 53,
    "zh": "上行幸長安；"
  },
  {
    "id": "s0297",
    "blockIndex": 53,
    "zh": "五月，乙丑，還宮。"
  },
  {
    "id": "s0298",
    "blockIndex": 54,
    "zh": "六月，辛卯，以太僕馮魴為司空。"
  },
  {
    "id": "s0299",
    "blockIndex": 55,
    "zh": "乙未，司徒馮勤薨。"
  },
  {
    "id": "s0300",
    "blockIndex": 56,
    "zh": "京師醴泉湧出，又有赤草生於水崖，郡國頻上甘露。"
  },
  {
    "id": "s0301",
    "blockIndex": 56,
    "zh": "群臣奏言：「靈物仍降，宜令太史撰集，以傳來世。"
  },
  {
    "id": "s0302",
    "blockIndex": 56,
    "zh": "」帝不納。"
  },
  {
    "id": "s0303",
    "blockIndex": 56,
    "zh": "常自謙無德，每郡國所上，輒抑而不當，故史官罕得記焉。"
  },
  {
    "id": "s0304",
    "blockIndex": 57,
    "zh": "秋，郡國三蝗。"
  },
  {
    "id": "s0305",
    "blockIndex": 58,
    "zh": "冬，十月，辛未，以司隸校尉東萊李言斤為司徒。"
  },
  {
    "id": "s0306",
    "blockIndex": 59,
    "zh": "甲申，使司空告祠高廟，上薄太后尊號曰高皇后，配食地祇。"
  },
  {
    "id": "s0307",
    "blockIndex": 59,
    "zh": "遷呂太后廟主於園，四時上祭。"
  },
  {
    "id": "s0308",
    "blockIndex": 59,
    "zh": "十一月，甲子晦，日有食之。"
  },
  {
    "id": "s0309",
    "blockIndex": 60,
    "zh": "是歲，起明堂、靈台、辟雍，宣佈圖讖於天下。"
  },
  {
    "id": "s0310",
    "blockIndex": 60,
    "zh": "初，上以《赤伏符》即帝位，由是信用讖文，多以決定嫌疑。"
  },
  {
    "id": "s0311",
    "blockIndex": 60,
    "zh": "給事中桓譚上疏諫曰：「凡人情忽於見事而貴於異聞。"
  },
  {
    "id": "s0312",
    "blockIndex": 60,
    "zh": "觀先王之所記述，鹹以仁義正道為本，非有奇怪虛誕之事。"
  },
  {
    "id": "s0313",
    "blockIndex": 60,
    "zh": "蓋天道性命，聖人所難言也，自子貢以下，不得而聞，況後世淺儒，能通之乎！"
  },
  {
    "id": "s0314",
    "blockIndex": 60,
    "zh": "今諸巧慧小才、伎數之人，增益圖書，矯稱讖記，以欺惑貪邪，詿誤人主，焉可不抑遠之哉！"
  },
  {
    "id": "s0315",
    "blockIndex": 60,
    "zh": "臣譚伏聞陛下窮折方士黃白之術，甚為明矣；"
  },
  {
    "id": "s0316",
    "blockIndex": 60,
    "zh": "而乃欲聽納讖記，又何誤也！"
  },
  {
    "id": "s0317",
    "blockIndex": 60,
    "zh": "其事雖有時合，譬猶卜數只偶之類。"
  },
  {
    "id": "s0318",
    "blockIndex": 60,
    "zh": "陛下宜垂明聽，發聖意，屏君小之曲說，述《五經》之正義。"
  },
  {
    "id": "s0319",
    "blockIndex": 60,
    "zh": "」疏奏，帝不悅。"
  },
  {
    "id": "s0320",
    "blockIndex": 60,
    "zh": "會議靈台所處，帝謂譚曰：「吾以讖決之，何如？"
  },
  {
    "id": "s0321",
    "blockIndex": 60,
    "zh": "」譚默然，良久曰：「臣不讀讖。"
  },
  {
    "id": "s0322",
    "blockIndex": 60,
    "zh": "」帝問其故，譚復極言讖之非經。"
  },
  {
    "id": "s0323",
    "blockIndex": 60,
    "zh": "帝大怒曰：「桓譚非聖無法，將下，斬之！"
  },
  {
    "id": "s0324",
    "blockIndex": 60,
    "zh": "」譚叩頭流血，良久，乃得解。"
  },
  {
    "id": "s0325",
    "blockIndex": 60,
    "zh": "出為六安郡丞，道病卒。"
  },
  {
    "id": "s0326",
    "blockIndex": 61,
    "zh": "══范曄論曰：桓譚以不善讖流亡，鄭興以遜辭僅免；"
  },
  {
    "id": "s0327",
    "blockIndex": 61,
    "zh": "賈逵能附會文致，最差貴顯；"
  },
  {
    "id": "s0328",
    "blockIndex": 61,
    "zh": "世主以此論學，悲哉！"
  },
  {
    "id": "s0329",
    "blockIndex": 62,
    "zh": "逵，扶風人也。"
  },
  {
    "id": "s0330",
    "blockIndex": 63,
    "zh": "南單于比死，弟左賢王莫立，為丘浮尤鞮單于。"
  },
  {
    "id": "s0331",
    "blockIndex": 63,
    "zh": "帝遣使繼璽書拜授璽綬，賜以衣冠及繒彩，是後遂以為常。"
  },
  {
    "id": "s0332",
    "blockIndex": 64,
    "zh": "春，正月，辛未，初立北郊，祀后土。"
  },
  {
    "id": "s0333",
    "blockIndex": 65,
    "zh": "二月，戊戌，帝崩於南宮前殿，年六十二。"
  },
  {
    "id": "s0334",
    "blockIndex": 65,
    "zh": "帝每旦視朝，日昃乃罷，數引公卿、郎將講論經理，夜分乃寐。"
  },
  {
    "id": "s0335",
    "blockIndex": 65,
    "zh": "皇太子見帝勤勞不怠，承間諫曰：「陛下有禹、湯之明，而失黃、老養性之福，願頤愛精神，優遊自寧。"
  },
  {
    "id": "s0336",
    "blockIndex": 65,
    "zh": "」帝曰：「我自樂此，不為疲也！"
  },
  {
    "id": "s0337",
    "blockIndex": 65,
    "zh": "」雖以征伐濟大業，及天下既定，乃退功臣而進文吏，明慎政體，總攬權綱，量時度力，舉無過事，故能恢復前烈，身致太平。"
  },
  {
    "id": "s0338",
    "blockIndex": 66,
    "zh": "太尉趙熹典喪事。"
  },
  {
    "id": "s0339",
    "blockIndex": 66,
    "zh": "時經王莽之亂，舊典不存，皇太子與諸王雜止同席，籓國官屬出入宮省，與百僚無別。"
  },
  {
    "id": "s0340",
    "blockIndex": 66,
    "zh": "熹正色，橫劍殿階，扶下諸王以明尊卑；"
  },
  {
    "id": "s0341",
    "blockIndex": 66,
    "zh": "奏遣謁者將護官屬分止它縣，諸王並令就邸，唯得朝晡入臨；"
  },
  {
    "id": "s0342",
    "blockIndex": 66,
    "zh": "整禮儀，嚴門衛，內外肅然。"
  },
  {
    "id": "s0343",
    "blockIndex": 67,
    "zh": "太子即皇帝位，尊皇后曰皇太后。"
  },
  {
    "id": "s0344",
    "blockIndex": 68,
    "zh": "山陽王荊哭臨不哀，而作飛書，令蒼頭詐稱大鴻臚郭況書與東海王強，言其無罪被廢，及郭后黜辱，勸令東歸舉兵以取天下，且曰：「高祖起亭長，陛下興白水，何況於王，陛下長子、故副主哉！"
  },
  {
    "id": "s0345",
    "blockIndex": 68,
    "zh": "當為秋霜，無為檻羊。"
  },
  {
    "id": "s0346",
    "blockIndex": 68,
    "zh": "人主崩亡，閭閻之伍尚為盜賊，欲有所望，何況王邪！"
  },
  {
    "id": "s0347",
    "blockIndex": 68,
    "zh": "」強得書惶怖，即執其使，封書上之。"
  },
  {
    "id": "s0348",
    "blockIndex": 68,
    "zh": "明帝以荊母弟，秘其事，遣荊出止河南宮。"
  },
  {
    "id": "s0349",
    "blockIndex": 69,
    "zh": "三月，丁卯，葬光武皇帝於原陵。"
  },
  {
    "id": "s0350",
    "blockIndex": 70,
    "zh": "夏，四月，丙辰，詔曰：「方今上無天子，下無方伯，若涉淵水而無舟楫。"
  },
  {
    "id": "s0351",
    "blockIndex": 70,
    "zh": "夫萬乘至重而壯者慮輕，實賴有德左右小子。"
  },
  {
    "id": "s0352",
    "blockIndex": 70,
    "zh": "高密侯禹，元功之首；"
  },
  {
    "id": "s0353",
    "blockIndex": 70,
    "zh": "東平王蒼，寬博有謀。"
  },
  {
    "id": "s0354",
    "blockIndex": 70,
    "zh": "有以禹為太傅，蒼為驃騎將軍。"
  },
  {
    "id": "s0355",
    "blockIndex": 70,
    "zh": "」蒼懇辭，帝不許。"
  },
  {
    "id": "s0356",
    "blockIndex": 70,
    "zh": "又詔驃騎將軍置長史、掾史員四十人，位在三公上。"
  },
  {
    "id": "s0357",
    "blockIndex": 70,
    "zh": "蒼嘗薦西曹掾齊國吳良，帝曰：「薦賢助國，宰相之職也。"
  },
  {
    "id": "s0358",
    "blockIndex": 70,
    "zh": "蕭何舉韓信，設壇而拜，不復考試，今以良為議郎。"
  },
  {
    "id": "s0360",
    "blockIndex": 71,
    "zh": "初，燒當羌豪滇良擊破先零，奪居其地；"
  },
  {
    "id": "s0361",
    "blockIndex": 71,
    "zh": "滇良卒，子滇吾立，附落轉盛。"
  },
  {
    "id": "s0362",
    "blockIndex": 71,
    "zh": "秋，滇吾與弟滇岸率眾寇隴西，敗太守劉盱於允街，於是守寨諸羌皆叛。"
  },
  {
    "id": "s0363",
    "blockIndex": 71,
    "zh": "詔謁者張鴻領諸郡兵擊之，戰於允吾，鴻軍敗沒。"
  },
  {
    "id": "s0364",
    "blockIndex": 71,
    "zh": "冬，十一月，復遣中郎將竇固監捕虜將軍馬武第二將軍、四萬人討之。"
  },
  {
    "id": "s0365",
    "blockIndex": 72,
    "zh": "是歲，南單于莫死，弟汗立，為伊伐於慮鞮單于。"
  },
  {
    "id": "s0366",
    "blockIndex": 73,
    "zh": "顯宗孝明皇帝上"
  },
  {
    "id": "s0367",
    "blockIndex": 74,
    "zh": "春，正月，帝率公卿已下朝於原陵，如元會儀。"
  },
  {
    "id": "s0368",
    "blockIndex": 74,
    "zh": "乘輿拜神坐，退，坐東廂；"
  },
  {
    "id": "s0369",
    "blockIndex": 74,
    "zh": "侍衛官皆在神坐後，太官上食，太常奏樂；"
  },
  {
    "id": "s0370",
    "blockIndex": 74,
    "zh": "郡國上計吏以次前，當神軒佔其郡谷價及民所疾苦。"
  },
  {
    "id": "s0371",
    "blockIndex": 74,
    "zh": "是後遂以為常。"
  },
  {
    "id": "s0372",
    "blockIndex": 75,
    "zh": "夏，五月，高密元侯鄧禹薨。"
  },
  {
    "id": "s0373",
    "blockIndex": 76,
    "zh": "東海恭王強病，上遣使者太醫乘驛視疾，駱驛不絕。"
  },
  {
    "id": "s0374",
    "blockIndex": 76,
    "zh": "詔沛王輔、濟南王康、淮陽王延詣魯省疾。"
  },
  {
    "id": "s0375",
    "blockIndex": 76,
    "zh": "戊寅，強薨，臨終，上疏謝恩，言：「身既夭命，孤弱復為皇太后、陛下憂慮，誠悲誠慚！"
  },
  {
    "id": "s0376",
    "blockIndex": 76,
    "zh": "息政，小人也，猥當襲臣後，必非所以全利之也，願還東海郡。"
  },
  {
    "id": "s0377",
    "blockIndex": 76,
    "zh": "今天下新罹大憂，惟陛下加供養皇太后，數進御餐。"
  },
  {
    "id": "s0378",
    "blockIndex": 76,
    "zh": "臣強困劣，言不能盡意，願並謝諸王，不意永不復相見也！"
  },
  {
    "id": "s0379",
    "blockIndex": 76,
    "zh": "」帝覽書悲慟，從太后出幸津門亭發哀，使大司空持節護喪事，贈送以殊禮，詔楚王英、趙王栩、北海王興及京師親戚皆會葬。"
  },
  {
    "id": "s0380",
    "blockIndex": 76,
    "zh": "帝追惟強深執謙儉，不欲厚葬以違其意，於是特詔：「遺送之物，務從約省，衣足斂形，茅車瓦器，物減於制，以彰王卓爾獨行之志。"
  },
  {
    "id": "s0381",
    "blockIndex": 76,
    "zh": "」將作大匠留起陵廟。"
  },
  {
    "id": "s0382",
    "blockIndex": 77,
    "zh": "秋，七月，馬武等擊燒當羌，大破之，餘皆降散。"
  },
  {
    "id": "s0383",
    "blockIndex": 78,
    "zh": "山陽王荊私迎能為星者，與謀議，冀天下有變。"
  },
  {
    "id": "s0384",
    "blockIndex": 78,
    "zh": "帝聞之，徙封荊廣陵王，遣之國。"
  },
  {
    "id": "s0385",
    "blockIndex": 78,
    "zh": "遼東太守祭肜使偏何討赤山烏桓，大破之，斬其魁帥。"
  },
  {
    "id": "s0386",
    "blockIndex": 78,
    "zh": "塞外震讋，西自武威，東盡玄菟，皆來內附，野無風塵，乃悉罷緣邊屯兵。"
  },
  {
    "id": "s0387",
    "blockIndex": 79,
    "zh": "東平王蒼以為中興三十餘年，四方無虞，宜修禮樂，乃與公卿共議定南北郊冠冕、車服制度及光武廟登歌、八俏舞數，上之。"
  },
  {
    "id": "s0388",
    "blockIndex": 80,
    "zh": "好畦愍侯耿弇薨。"
  },
  {
    "id": "s0389",
    "blockIndex": 81,
    "zh": "春，正月，辛未，宗祀光琥皇帝於明堂，帝及公卿列侯，始服冠冕、玉珮以行事。"
  },
  {
    "id": "s0390",
    "blockIndex": 81,
    "zh": "禮畢，登靈台，望雲物。"
  },
  {
    "id": "s0391",
    "blockIndex": 81,
    "zh": "赦天下。"
  },
  {
    "id": "s0392",
    "blockIndex": 82,
    "zh": "三月，臨辟雍，初行大射禮。"
  },
  {
    "id": "s0393",
    "blockIndex": 83,
    "zh": "冬，十月，壬子，上幸辟雍，初行養老禮；"
  },
  {
    "id": "s0394",
    "blockIndex": 83,
    "zh": "以李躬為三老，桓榮為五更。"
  },
  {
    "id": "s0395",
    "blockIndex": 83,
    "zh": "三老服都紵大袍，冠進賢，扶玉杖；"
  },
  {
    "id": "s0396",
    "blockIndex": 83,
    "zh": "五更亦如之，不杖。"
  },
  {
    "id": "s0397",
    "blockIndex": 83,
    "zh": "乘輿到壁雍禮殿，御坐東廂，遣使者安車迎三老、五更於太學講堂，天子迎於門屏，交禮；"
  },
  {
    "id": "s0398",
    "blockIndex": 83,
    "zh": "道自阼階，三老升自賓階；"
  },
  {
    "id": "s0399",
    "blockIndex": 83,
    "zh": "至階，天子揖如禮。"
  },
  {
    "id": "s0400",
    "blockIndex": 83,
    "zh": "三老升，東面，三公設幾，九卿正履，天子親袒割牲，執醬而饋，執爵而酳，祝鯁在前，祝饐在後。"
  },
  {
    "id": "s0401",
    "blockIndex": 83,
    "zh": "五更南面，三公進供，禮亦如之。"
  },
  {
    "id": "s0402",
    "blockIndex": 83,
    "zh": "禮畢，引桓榮及弟子升堂，上自為下說，諸儒執經問難於前，冠帶搢紳之人圜橋門而觀聽者，蓋億萬計。"
  },
  {
    "id": "s0403",
    "blockIndex": 83,
    "zh": "於是下詔賜榮爵關內侯；"
  },
  {
    "id": "s0404",
    "blockIndex": 83,
    "zh": "三老、五更皆以二千石祿養終厥身。"
  },
  {
    "id": "s0405",
    "blockIndex": 83,
    "zh": "賜天下三老酒，人一石，肉四十斤。"
  },
  {
    "id": "s0406",
    "blockIndex": 83,
    "zh": "上自為太子，受《尚書》於桓榮，及即帝位，猶尊榮以師禮。"
  },
  {
    "id": "s0407",
    "blockIndex": 83,
    "zh": "嘗幸太常府，令榮坐東面，設幾杖，會百官及榮門生數百人，上親自執業；"
  },
  {
    "id": "s0408",
    "blockIndex": 83,
    "zh": "諸生或避位發難，上謙曰：「太師在是。"
  },
  {
    "id": "s0409",
    "blockIndex": 83,
    "zh": "」既罷，悉以太官供具賜太常家。"
  },
  {
    "id": "s0410",
    "blockIndex": 83,
    "zh": "榮每疾病，帝輒遣使者存問，太官、太醫相望於道。"
  },
  {
    "id": "s0411",
    "blockIndex": 83,
    "zh": "及篤，上疏謝恩，讓還爵士。"
  },
  {
    "id": "s0412",
    "blockIndex": 83,
    "zh": "帝幸其家問起居，入街，下車，擁經而前，撫榮垂涕，賜以床茵、帷帳、刀劍、衣被，良久乃去。"
  },
  {
    "id": "s0413",
    "blockIndex": 83,
    "zh": "自是諸侯、將軍、大夫問疾者，不敢復乘車到門，皆拜床下。"
  },
  {
    "id": "s0414",
    "blockIndex": 83,
    "zh": "榮卒，帝親自變服臨喪送葬，賜塚塋於首山之陽。"
  },
  {
    "id": "s0415",
    "blockIndex": 83,
    "zh": "子郁當嗣，讓其兄子泛；"
  },
  {
    "id": "s0416",
    "blockIndex": 83,
    "zh": "帝不許，郁乃受封，而悉以租入與之。"
  },
  {
    "id": "s0417",
    "blockIndex": 83,
    "zh": "帝以郁為侍中。"
  },
  {
    "id": "s0418",
    "blockIndex": 84,
    "zh": "上以中山王焉，郭太后少子，太后尤愛之，故獨留京師，至是始與諸王俱就國，賜以虎賁、官騎，恩寵尤厚，獨得往來京師。"
  },
  {
    "id": "s0419",
    "blockIndex": 84,
    "zh": "帝禮待陰、郭，每事必均，數受賞賜，恩寵俱渥。"
  },
  {
    "id": "s0420",
    "blockIndex": 85,
    "zh": "甲子，上行幸長安。"
  },
  {
    "id": "s0421",
    "blockIndex": 85,
    "zh": "十一月，甲申，遣使者以中牢祠蕭何、霍光。"
  },
  {
    "id": "s0422",
    "blockIndex": 85,
    "zh": "帝過，式其墓。"
  },
  {
    "id": "s0423",
    "blockIndex": 85,
    "zh": "進幸河東；"
  },
  {
    "id": "s0424",
    "blockIndex": 85,
    "zh": "癸卯，還宮。"
  },
  {
    "id": "s0425",
    "blockIndex": 86,
    "zh": "十二月，護羌校尉竇林坐欺罔及臧罪，下獄死。"
  },
  {
    "id": "s0426",
    "blockIndex": 86,
    "zh": "林者，融之從兄子也。"
  },
  {
    "id": "s0427",
    "blockIndex": 86,
    "zh": "於是竇氏一公、兩侯、三公主、四二千石相與並時，自祖及孫，官府邸第相望京邑，於親戚功臣中莫與為比。"
  },
  {
    "id": "s0428",
    "blockIndex": 86,
    "zh": "及林誅，帝數干詔切責融，融惶恐乞骸骨，詔令歸第養病。"
  },
  {
    "id": "s0429",
    "blockIndex": 87,
    "zh": "是歲，初迎氣於五郊。"
  },
  {
    "id": "s0430",
    "blockIndex": 88,
    "zh": "新陽侯陰就子豐尚酈邑公主。"
  },
  {
    "id": "s0431",
    "blockIndex": 88,
    "zh": "公主驕妒，豐殺之，被誅，父母皆自殺。"
  },
  {
    "id": "s0432",
    "blockIndex": 89,
    "zh": "南單于汗死，單于比之子適立，為□盆僮屍逐侯鞮單于。"
  },
  {
    "id": "s0433",
    "blockIndex": 90,
    "zh": "春，二月，甲寅，太尉趙、司徒李言斤免。"
  },
  {
    "id": "s0434",
    "blockIndex": 91,
    "zh": "丙辰，以左馮翊郭丹為司徒。"
  },
  {
    "id": "s0435",
    "blockIndex": 92,
    "zh": "己未，以南陽太守虞延為太尉。"
  },
  {
    "id": "s0436",
    "blockIndex": 93,
    "zh": "甲子，立貴人馬氏為皇后，皇子炟為太子。"
  },
  {
    "id": "s0437",
    "blockIndex": 93,
    "zh": "後，援之女也，光武時，以選入太子宮，能奉承陰後，傍接同列，禮則修備，上下安之，遂見寵異；"
  },
  {
    "id": "s0438",
    "blockIndex": 93,
    "zh": "及帝即位，為貴人。"
  },
  {
    "id": "s0439",
    "blockIndex": 93,
    "zh": "時後前母姊女賈氏亦以選入，生皇子炟。"
  },
  {
    "id": "s0440",
    "blockIndex": 93,
    "zh": "帝以後無子，命養之，謂曰：「人未必當自生子，但患愛養不至耳！"
  },
  {
    "id": "s0441",
    "blockIndex": 93,
    "zh": "」後於是盡心撫育，勞悴過於所生。"
  },
  {
    "id": "s0442",
    "blockIndex": 93,
    "zh": "太子亦孝性淳篤，母子慈愛，始終無纖介之間。"
  },
  {
    "id": "s0443",
    "blockIndex": 93,
    "zh": "後常以皇嗣未廣，薦達左右，若恐不及。"
  },
  {
    "id": "s0444",
    "blockIndex": 93,
    "zh": "後宮有進見者，每加慰納；"
  },
  {
    "id": "s0445",
    "blockIndex": 93,
    "zh": "若數所寵引，輒加隆遇。"
  },
  {
    "id": "s0446",
    "blockIndex": 93,
    "zh": "及有司奏立長秋宮，帝未有所言，皇太后曰：「馬貴人德冠後宮，即其人也。"
  },
  {
    "id": "s0447",
    "blockIndex": 93,
    "zh": "」後既正位宮闈，愈自謙肅，好讀書。"
  },
  {
    "id": "s0448",
    "blockIndex": 93,
    "zh": "常衣大練，裙不加緣；"
  },
  {
    "id": "s0449",
    "blockIndex": 93,
    "zh": "朔望諸姬主朝請，望見後袍衣疏粗，以為綺縠，就視，乃笑。"
  },
  {
    "id": "s0450",
    "blockIndex": 93,
    "zh": "後曰：「此繒特宜染色，故用之耳。"
  },
  {
    "id": "s0451",
    "blockIndex": 93,
    "zh": "」群臣奏事有難平者，帝數以試後，後輒分解趣理，各得其情，然未嘗以傢俬干政事。"
  },
  {
    "id": "s0452",
    "blockIndex": 93,
    "zh": "帝由是寵敬，始終無衰焉。"
  },
  {
    "id": "s0453",
    "blockIndex": 94,
    "zh": "帝思中興功臣，乃圖畫二十八將於南宮雲台，以鄧禹為首，次馬成、吳漢、王梁、賈復、陳俊、耿弇、杜茂、寇恂、傅俊、岑彭、堅金覃、馮異、王霸、朱祜、任光、祭遵、李忠、景丹、萬修、蓋延、邳肜、銚期、劉植、耿純、臧宮、馬武、劉隆，又益以王常、李通、竇融、卓茂，合三十二人。"
  },
  {
    "id": "s0454",
    "blockIndex": 94,
    "zh": "馬援以椒房之親，獨不與焉。"
  },
  {
    "id": "s0455",
    "blockIndex": 95,
    "zh": "夏，四月，辛酉，封皇子建為千乘王，羨為廣平王。"
  },
  {
    "id": "s0456",
    "blockIndex": 96,
    "zh": "六月，丁卯，有星孛於天船北。"
  },
  {
    "id": "s0457",
    "blockIndex": 97,
    "zh": "帝大起北宮。"
  },
  {
    "id": "s0458",
    "blockIndex": 97,
    "zh": "時天旱，尚書僕射會稽鐘離意詣闕，免冠，上疏曰：「昔成湯遭旱，以六事自責曰：『政不節邪？"
  },
  {
    "id": "s0459",
    "blockIndex": 97,
    "zh": "使民疾邪？"
  },
  {
    "id": "s0460",
    "blockIndex": 97,
    "zh": "宮室榮邪？"
  },
  {
    "id": "s0461",
    "blockIndex": 97,
    "zh": "女謁盛邪？"
  },
  {
    "id": "s0462",
    "blockIndex": 97,
    "zh": "苞苴行邪？"
  },
  {
    "id": "s0463",
    "blockIndex": 97,
    "zh": "讒夫昌邪？"
  },
  {
    "id": "s0464",
    "blockIndex": 97,
    "zh": "』竊見北宮大作，民失農時；"
  },
  {
    "id": "s0465",
    "blockIndex": 97,
    "zh": "自古非苦宮室小狹，但患民不安寧，宜且罷止，以應天心。"
  },
  {
    "id": "s0466",
    "blockIndex": 97,
    "zh": "」帝策詔報曰：「湯引六事，咎在一人，其冠、履，勿謝！"
  },
  {
    "id": "s0467",
    "blockIndex": 97,
    "zh": "」又敕大匠止作諸宮，減省不急。"
  },
  {
    "id": "s0468",
    "blockIndex": 97,
    "zh": "詔因謝公卿百僚，遂慶時澍雨。"
  },
  {
    "id": "s0469",
    "blockIndex": 97,
    "zh": "意薦全椒長劉平，詔征拜議郎。"
  },
  {
    "id": "s0470",
    "blockIndex": 97,
    "zh": "平在全椒，政有恩惠，民或增貲就賦，或減年從役。"
  },
  {
    "id": "s0471",
    "blockIndex": 97,
    "zh": "剌史、太守行部，獄無系囚，人自以得所，不知所問，唯班詔書而去。"
  },
  {
    "id": "s0472",
    "blockIndex": 97,
    "zh": "帝性褊察，好以耳目隱發為明，公卿大臣數被詆毀，近臣尚書以下至見提曳。"
  },
  {
    "id": "s0473",
    "blockIndex": 97,
    "zh": "常以事怒郎藥崧，以杖撞之；"
  },
  {
    "id": "s0474",
    "blockIndex": 97,
    "zh": "崧走入床下，帝怒甚，疾言曰：「郎出！"
  },
  {
    "id": "s0475",
    "blockIndex": 97,
    "zh": "」崧乃曰：「天子穆穆，諸侯皇皇，未聞人君，自起撞郎。"
  },
  {
    "id": "s0476",
    "blockIndex": 97,
    "zh": "」帝乃赦之。"
  },
  {
    "id": "s0477",
    "blockIndex": 97,
    "zh": "是時朝廷莫不悚心栗，爭為嚴切以避誅責，唯鍾離意獨敢諫爭，數封還詔書，臣下過失，輒救解之。"
  },
  {
    "id": "s0478",
    "blockIndex": 97,
    "zh": "會連有變異，上疏曰：「陛下敬畏鬼神，憂恤黎元，而天氣未和，寒暑違節者，咎在群臣不能宣化治職，而以苛刻為俗，百官無相親之心，吏民無雍雍之志，至於感逆和氣，以致天災。"
  },
  {
    "id": "s0479",
    "blockIndex": 97,
    "zh": "百姓可以德勝，難以力服，《鹿鳴》之詩必言宴樂者，以人神之心洽，然後天氣和也。"
  },
  {
    "id": "s0480",
    "blockIndex": 97,
    "zh": "願陛下垂聖德，緩刑罰，順時氣以調陰陽。"
  },
  {
    "id": "s0481",
    "blockIndex": 97,
    "zh": "」帝雖不能用，然知其至誠，終愛厚之。"
  },
  {
    "id": "s0482",
    "blockIndex": 98,
    "zh": "秋，八月，戊辰，詔改太樂官曰太予，用讖文也。"
  },
  {
    "id": "s0483",
    "blockIndex": 99,
    "zh": "壬申晦，日有食之。"
  },
  {
    "id": "s0484",
    "blockIndex": 99,
    "zh": "詔曰：「昔楚莊無災，以致戒懼，魯哀禍大，天不降譴。"
  },
  {
    "id": "s0485",
    "blockIndex": 99,
    "zh": "今之動變，倘尚可救，有司勉思厥職，以匡無德。"
  },
  {
    "id": "s0487",
    "blockIndex": 100,
    "zh": "冬，十月，甲子，車駕從皇太后幸章陵。"
  },
  {
    "id": "s0488",
    "blockIndex": 100,
    "zh": "荊州剌史郭賀，官有殊政，上賜以三公之服，黼黻，冕旒；"
  },
  {
    "id": "s0489",
    "blockIndex": 100,
    "zh": "敕行部去襜帷，使百姓見其容服，以章有德，戊辰，還自章陵。"
  },
  {
    "id": "s0490",
    "blockIndex": 101,
    "zh": "是歲，京師及郡國七大水。"
  },
  {
    "id": "s0491",
    "blockIndex": 102,
    "zh": "莎車王賢以兵威逼奪於窴、大宛、媯塞王國，使其將守之。"
  },
  {
    "id": "s0492",
    "blockIndex": 102,
    "zh": "於窴人殺其將君德，立大人休莫霸為王。"
  },
  {
    "id": "s0493",
    "blockIndex": 102,
    "zh": "賢率諸國兵數萬擊之，大為休莫霸所敗，脫身走還。"
  },
  {
    "id": "s0494",
    "blockIndex": 102,
    "zh": "休莫霸進圍莎車，中流矢死，於窴人復立其兄子廣德為王，廣德使其弟仁攻賢。"
  },
  {
    "id": "s0495",
    "blockIndex": 102,
    "zh": "廣德父先拘在莎車，賢乃歸其父，以女妻之，與之和親。"
  },
  {
    "id": "s0496",
    "blockIndex": 103,
    "zh": "category:資治通鑑"
  }
]
