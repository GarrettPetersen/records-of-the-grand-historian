[
  {
    "id": "s0001",
    "blockIndex": 0,
    "zh": "資治通鑑第033卷"
  },
  {
    "id": "s0002",
    "blockIndex": 1,
    "zh": "【漢紀二十五】起閼逢攝提格，盡旃蒙單閼，凡二年。"
  },
  {
    "id": "s0003",
    "blockIndex": 2,
    "zh": "春，正月，上行幸甘泉，郊泰畤。"
  },
  {
    "id": "s0004",
    "blockIndex": 3,
    "zh": "二月，壬子，丞相方進薨。"
  },
  {
    "id": "s0005",
    "blockIndex": 3,
    "zh": "時熒惑守心，丞相府議曹平陵李尋奏記方進，言：「災變迫切，大責日加，安得但保斥逐之戮！"
  },
  {
    "id": "s0006",
    "blockIndex": 3,
    "zh": "闔府三百餘人，唯君侯擇其中，與盡節轉凶。"
  },
  {
    "id": "s0007",
    "blockIndex": 3,
    "zh": "」方進憂之，不知所出。"
  },
  {
    "id": "s0008",
    "blockIndex": 3,
    "zh": "會郎賁麗善為星，言大臣宜當之。"
  },
  {
    "id": "s0009",
    "blockIndex": 3,
    "zh": "上乃召見方進。"
  },
  {
    "id": "s0010",
    "blockIndex": 3,
    "zh": "還歸，未及引決，上遂賜冊，責讓以政事不治，災害並臻，百姓窮困，曰：「欲退君位，尚未忍，使尚書令賜君上尊酒十石，養牛一，君審處焉！"
  },
  {
    "id": "s0011",
    "blockIndex": 3,
    "zh": "」方進即日自殺。"
  },
  {
    "id": "s0012",
    "blockIndex": 3,
    "zh": "上秘之，遣九卿冊贈印綬，賜乘輿秘器、少府供張，柱檻皆衣素。"
  },
  {
    "id": "s0013",
    "blockIndex": 3,
    "zh": "天子親臨吊者數至，禮賜異於它相故事。"
  },
  {
    "id": "s0014",
    "blockIndex": 4,
    "zh": "臣光曰：晏嬰有言：「天命不慆，不貳其命。"
  },
  {
    "id": "s0015",
    "blockIndex": 4,
    "zh": "」禍福之至，安可移乎！"
  },
  {
    "id": "s0016",
    "blockIndex": 4,
    "zh": "昔楚昭王、宋景公不忍移災於卿佐，曰：「移腹心之疾，寘諸股肱，何益也！"
  },
  {
    "id": "s0017",
    "blockIndex": 4,
    "zh": "」藉其災可移，仁君猶不肯為，況不可乎！"
  },
  {
    "id": "s0018",
    "blockIndex": 4,
    "zh": "使方進罪不至死而誅之，以當大變，是誣天也；"
  },
  {
    "id": "s0019",
    "blockIndex": 4,
    "zh": "方進有罪當刑，隱其誅而厚其葬，是誣人也；"
  },
  {
    "id": "s0020",
    "blockIndex": 4,
    "zh": "孝成欲誣天、人而卒無所益，可謂不知命矣。"
  },
  {
    "id": "s0021",
    "blockIndex": 5,
    "zh": "三月，上行幸河東，祠后土。"
  },
  {
    "id": "s0022",
    "blockIndex": 6,
    "zh": "丙戌，帝崩於未央宮。"
  },
  {
    "id": "s0023",
    "blockIndex": 7,
    "zh": "帝素強無疾病。"
  },
  {
    "id": "s0024",
    "blockIndex": 7,
    "zh": "是時，楚思王衍、梁王立來朝，明旦，當辭去，上宿供張白虎殿；"
  },
  {
    "id": "s0025",
    "blockIndex": 7,
    "zh": "又欲拜左將軍孔光為丞相，已刻侯印，書贊。"
  },
  {
    "id": "s0026",
    "blockIndex": 7,
    "zh": "昏夜，平善，鄉晨，傅绔襪欲起，因失衣，不能言，晝漏上十刻而崩，民間讙嘩，鹹歸罪趙昭儀。"
  },
  {
    "id": "s0027",
    "blockIndex": 7,
    "zh": "皇太后詔大司馬莽雜與御史、丞相、廷尉治，問皇帝起居發病狀；"
  },
  {
    "id": "s0028",
    "blockIndex": 7,
    "zh": "趙昭儀自殺。"
  },
  {
    "id": "s0029",
    "blockIndex": 8,
    "zh": "班彪贊曰：臣姑充後宮為婕妤，父子、昆弟侍帷幄，數為臣言：「成帝善修容儀，升車正立，不內顧，不疾言，不親指，臨朝淵嘿，尊嚴若神，可謂穆穆有天子之容者矣。"
  },
  {
    "id": "s0030",
    "blockIndex": 8,
    "zh": "博覽古今，容受直辭，公卿奏議可述。"
  },
  {
    "id": "s0031",
    "blockIndex": 8,
    "zh": "遭世承平，上下和睦。"
  },
  {
    "id": "s0032",
    "blockIndex": 8,
    "zh": "然湛乎酒色，趙氏亂內，外家擅朝，言之可為於邑！"
  },
  {
    "id": "s0033",
    "blockIndex": 8,
    "zh": "」建始以來，王氏始執國命，哀、平短祚，莽遂篡位，蓋其威福所由來者漸矣！"
  },
  {
    "id": "s0034",
    "blockIndex": 9,
    "zh": "是日，孔光於大行前拜受丞相、博山侯印綬。"
  },
  {
    "id": "s0035",
    "blockIndex": 10,
    "zh": "富平侯張放聞帝崩，思慕哭泣而死。"
  },
  {
    "id": "s0036",
    "blockIndex": 11,
    "zh": "荀悅論曰：放非不愛上，忠不存焉。"
  },
  {
    "id": "s0037",
    "blockIndex": 11,
    "zh": "故愛而不忠，仁之賊也！"
  },
  {
    "id": "s0038",
    "blockIndex": 12,
    "zh": "皇太后詔南、北郊長安如故。"
  },
  {
    "id": "s0039",
    "blockIndex": 13,
    "zh": "夏，四月，丙午，太子即皇帝位，謁高廟；"
  },
  {
    "id": "s0040",
    "blockIndex": 13,
    "zh": "尊皇太后曰太皇太后，皇后曰皇太后。"
  },
  {
    "id": "s0041",
    "blockIndex": 13,
    "zh": "大赦天下。"
  },
  {
    "id": "s0042",
    "blockIndex": 14,
    "zh": "哀帝初立，躬行儉約，省減諸用，政事由己出，朝廷翕然望至治焉。"
  },
  {
    "id": "s0043",
    "blockIndex": 15,
    "zh": "己卯，葬教成皇帝於延陵。"
  },
  {
    "id": "s0044",
    "blockIndex": 16,
    "zh": "太皇太后令傅太后、丁姬十日一至未央宮。"
  },
  {
    "id": "s0045",
    "blockIndex": 17,
    "zh": "有詔問丞相、大司空：「定陶共王太后宜當何居？"
  },
  {
    "id": "s0046",
    "blockIndex": 17,
    "zh": "」丞相孔光素聞傅太后為人剛暴，長於權謀，自帝在襁褓，而養長教道至於成人，帝之立又有力；"
  },
  {
    "id": "s0047",
    "blockIndex": 17,
    "zh": "光心恐傅太后與政事，不欲與帝旦夕相近，即議以為：「定陶太后宜改築宮。"
  },
  {
    "id": "s0048",
    "blockIndex": 17,
    "zh": "」大司空何武曰：「可居北宮。"
  },
  {
    "id": "s0049",
    "blockIndex": 17,
    "zh": "」上從武言。"
  },
  {
    "id": "s0050",
    "blockIndex": 17,
    "zh": "北宮有紫房復道通未央宮，傅太后果從復道朝夕至帝所，求欲稱尊號，貴寵其親屬，使上不得由直道行。"
  },
  {
    "id": "s0051",
    "blockIndex": 17,
    "zh": "高昌侯董宏希指，上書言：「秦莊襄王母本夏氏，而為華陽夫人所子，及即位後，俱稱太后。"
  },
  {
    "id": "s0052",
    "blockIndex": 17,
    "zh": "宜立定陶共王后為帝太后。"
  },
  {
    "id": "s0053",
    "blockIndex": 17,
    "zh": "」事下有司，大司馬王莽，左將軍、關內侯、領尚書事師丹劾奏宏：「知皇太后至尊之號，天下一統，而稱引亡秦以為比喻，詿誤聖朝，非所宜言，大不道！"
  },
  {
    "id": "s0054",
    "blockIndex": 17,
    "zh": "」上新立，謙讓，納用莽、丹言，免宏為庶人。"
  },
  {
    "id": "s0055",
    "blockIndex": 17,
    "zh": "傅太后大怒，要上，欲必稱尊號。"
  },
  {
    "id": "s0056",
    "blockIndex": 17,
    "zh": "上乃白太皇太后，令下詔尊定陶恭王為恭皇。"
  },
  {
    "id": "s0057",
    "blockIndex": 18,
    "zh": "五月，丙戌，立皇后傅氏，傅太后從弟晏之子也。"
  },
  {
    "id": "s0058",
    "blockIndex": 19,
    "zh": "詔曰：「《春秋》，母以子貴。"
  },
  {
    "id": "s0059",
    "blockIndex": 19,
    "zh": "宜尊定陶太后曰恭皇太后，丁姬曰恭皇后，各置左右詹事，食邑如長信宮、中宮。"
  },
  {
    "id": "s0060",
    "blockIndex": 19,
    "zh": "」追尊傅父為崇祖侯，丁父為褒德侯；"
  },
  {
    "id": "s0061",
    "blockIndex": 19,
    "zh": "封舅丁明為陽安侯，舅子滿為平周侯，皇后父晏為孔鄉侯，皇太后弟、侍中、光祿大夫趙欽為新城侯。"
  },
  {
    "id": "s0062",
    "blockIndex": 19,
    "zh": "太皇太后詔大司馬莽就第，避帝外家；"
  },
  {
    "id": "s0063",
    "blockIndex": 19,
    "zh": "莽上疏乞骸骨。"
  },
  {
    "id": "s0064",
    "blockIndex": 19,
    "zh": "帝遣尚書令詔起莽，又遣丞相孔光、大司空何武、左將軍師丹、衛尉傅喜白太皇太后曰：「皇帝聞太后詔，甚悲！"
  },
  {
    "id": "s0065",
    "blockIndex": 19,
    "zh": "大司馬即不起，皇帝即不敢聽政！"
  },
  {
    "id": "s0066",
    "blockIndex": 19,
    "zh": "」太后乃復令莽視事。"
  },
  {
    "id": "s0067",
    "blockIndex": 20,
    "zh": "成帝之世，鄭聲尤甚，黃門名倡丙強、景武之屬富顯於世，貴戚至與人主爭女樂。"
  },
  {
    "id": "s0068",
    "blockIndex": 20,
    "zh": "帝自為定陶王時疾之，又性不好音，六月，詔曰：「孔子不雲乎：『放鄭聲，鄭聲淫。"
  },
  {
    "id": "s0069",
    "blockIndex": 20,
    "zh": "』其罷樂府官；"
  },
  {
    "id": "s0070",
    "blockIndex": 20,
    "zh": "郊祭樂及古兵法武樂在《經》，非鄭、衛之樂者，條奏別屬他官。"
  },
  {
    "id": "s0071",
    "blockIndex": 20,
    "zh": "」凡所罷省過半。"
  },
  {
    "id": "s0072",
    "blockIndex": 20,
    "zh": "然百姓漸漬日久，又不制雅樂有以相變，豪富吏民湛沔自若。"
  },
  {
    "id": "s0073",
    "blockIndex": 21,
    "zh": "王莽薦中壘校尉劉歆有材行，為侍中，稍遷光祿大夫，貴幸；"
  },
  {
    "id": "s0074",
    "blockIndex": 21,
    "zh": "更名秀。"
  },
  {
    "id": "s0075",
    "blockIndex": 21,
    "zh": "上復令秀典領《五經》，卒父前業；"
  },
  {
    "id": "s0076",
    "blockIndex": 21,
    "zh": "秀於是總群書而奏其七略，有《輯略》、有《六藝略》、有《諸子略》、有《詩賦略》、有《兵書略》、有《術數略》、有《方技略》。"
  },
  {
    "id": "s0077",
    "blockIndex": 21,
    "zh": "凡書六略，三十八種，五百九十六家、萬三千二百六十九卷。"
  },
  {
    "id": "s0078",
    "blockIndex": 21,
    "zh": "其敘諸子，分為九流：曰儒，曰道，曰陰陽，曰法，曰名，曰墨，曰從橫，曰雜，曰農，以為：「九家皆起於王道既微，諸侯力政，時君世主好惡殊方，是以九家之術蜂出並作，各引一端，崇其所善，以此馳說，取合諸侯，其言雖殊，譬猶水火相滅，亦相生也；"
  },
  {
    "id": "s0079",
    "blockIndex": 21,
    "zh": "仁之與義，敬之與和，相反而皆相成也。"
  },
  {
    "id": "s0080",
    "blockIndex": 21,
    "zh": "《易》曰：『天下同歸而殊塗，一致而百慮。"
  },
  {
    "id": "s0081",
    "blockIndex": 21,
    "zh": "』今異家者推所長，窮知究慮以明其指，雖有蔽短，合其要歸，亦《六經》之支與流裔；"
  },
  {
    "id": "s0082",
    "blockIndex": 21,
    "zh": "使其人遭明王聖主，得其所折中，皆股肱之材已。"
  },
  {
    "id": "s0083",
    "blockIndex": 21,
    "zh": "仲尼有言：『禮失而求諸野。"
  },
  {
    "id": "s0084",
    "blockIndex": 21,
    "zh": "』方今去聖久遠，道術缺廢，無所更索，彼九家者，不猶愈於野乎！"
  },
  {
    "id": "s0085",
    "blockIndex": 21,
    "zh": "若能修《六藝》之術而觀此九家之言，捨短取長，則可以通萬方之略矣。"
  },
  {
    "id": "s0087",
    "blockIndex": 22,
    "zh": "河間惠王良能修獻王之行，母太后薨，服喪如禮；"
  },
  {
    "id": "s0088",
    "blockIndex": 22,
    "zh": "詔益封萬戶，以為宗室儀表。"
  },
  {
    "id": "s0089",
    "blockIndex": 23,
    "zh": "初，董仲舒說武帝，以「秦用商鞅之法，除井田，民得賣買，富者田連阡陌，貧者亡立錐之地，邑有人君之尊，裡有公侯之富，小民安得不困！"
  },
  {
    "id": "s0090",
    "blockIndex": 23,
    "zh": "古井田法雖難卒行，宜少近古，限民名田以贍不足，塞並兼之路；"
  },
  {
    "id": "s0091",
    "blockIndex": 23,
    "zh": "去奴婢，除專殺之威；"
  },
  {
    "id": "s0092",
    "blockIndex": 23,
    "zh": "薄賦斂，省繇役，以寬民力，然後可善治也！"
  },
  {
    "id": "s0093",
    "blockIndex": 23,
    "zh": "」及上即位，師丹復建言：「今累世承平，豪富吏民訾數巨萬，而貧弱愈困，宜略為限。"
  },
  {
    "id": "s0094",
    "blockIndex": 23,
    "zh": "」天子下其議，丞相光、大司空武奏請：「自諸侯王、列侯、公主名田各有限；"
  },
  {
    "id": "s0095",
    "blockIndex": 23,
    "zh": "關內侯、吏、民名田皆毋過三十頃；"
  },
  {
    "id": "s0096",
    "blockIndex": 23,
    "zh": "奴婢毋過三十人。"
  },
  {
    "id": "s0097",
    "blockIndex": 23,
    "zh": "期盡三年。"
  },
  {
    "id": "s0098",
    "blockIndex": 23,
    "zh": "犯者沒入宮。"
  },
  {
    "id": "s0099",
    "blockIndex": 23,
    "zh": "」時田宅、奴婢賈為減賤，貴戚近習皆不便也，詔書：「且須後。"
  },
  {
    "id": "s0100",
    "blockIndex": 23,
    "zh": "」遂寢不行。"
  },
  {
    "id": "s0101",
    "blockIndex": 23,
    "zh": "又詔齊三服官：「諸官織綺繡，難成、害女紅之物，皆止，無作輸。"
  },
  {
    "id": "s0102",
    "blockIndex": 23,
    "zh": "除任子令及誹謗詆欺法。"
  },
  {
    "id": "s0103",
    "blockIndex": 23,
    "zh": "掖廷宮人年三十以下，出嫁之；"
  },
  {
    "id": "s0104",
    "blockIndex": 23,
    "zh": "官奴婢五十以上，免為庶人，益吏三百石以下俸。"
  },
  {
    "id": "s0106",
    "blockIndex": 24,
    "zh": "上置酒未央宮，內者令為傅太后張幄，坐於太皇太后坐旁。"
  },
  {
    "id": "s0107",
    "blockIndex": 24,
    "zh": "大司馬莽按行，責內者令曰：「定陶太后，籓妾，何以得與至尊並！"
  },
  {
    "id": "s0108",
    "blockIndex": 24,
    "zh": "」徹去，更設坐。"
  },
  {
    "id": "s0109",
    "blockIndex": 24,
    "zh": "傅太后聞之，大怒，不肯會，重怨恚莽；"
  },
  {
    "id": "s0110",
    "blockIndex": 24,
    "zh": "莽復乞骸骨。"
  },
  {
    "id": "s0111",
    "blockIndex": 24,
    "zh": "秋，七月，丁卯，上賜莽黃金五百斤，安車駟馬，罷就第。"
  },
  {
    "id": "s0112",
    "blockIndex": 24,
    "zh": "公卿大夫多稱之者，上乃加恩寵，置中黃門，為莽家給使，十日一賜餐。"
  },
  {
    "id": "s0113",
    "blockIndex": 24,
    "zh": "又下詔益封曲陽侯根，安陽侯舜，新都侯莽，丞相光，大司空武邑戶各有差。"
  },
  {
    "id": "s0114",
    "blockIndex": 24,
    "zh": "以莽為特進、給事中、朝朔望，見禮如三公。"
  },
  {
    "id": "s0115",
    "blockIndex": 24,
    "zh": "又還紅陽侯立於京師。"
  },
  {
    "id": "s0116",
    "blockIndex": 25,
    "zh": "傅太后從弟右將軍喜，好學問，有志行。"
  },
  {
    "id": "s0117",
    "blockIndex": 25,
    "zh": "王莽既罷退，眾庶歸望於喜。"
  },
  {
    "id": "s0118",
    "blockIndex": 25,
    "zh": "初，上之官爵外親也，喜獨執謙稱疾；"
  },
  {
    "id": "s0119",
    "blockIndex": 25,
    "zh": "傅太后始與政事，數諫之；"
  },
  {
    "id": "s0120",
    "blockIndex": 25,
    "zh": "由是傅太后不欲令喜輔政。"
  },
  {
    "id": "s0121",
    "blockIndex": 25,
    "zh": "庚午，以左將軍師丹為大司馬，封高鄉亭侯；"
  },
  {
    "id": "s0122",
    "blockIndex": 25,
    "zh": "賜喜黃金百斤，上右將軍印綬，以光祿大夫養病；"
  },
  {
    "id": "s0123",
    "blockIndex": 25,
    "zh": "以光祿勳淮陽彭宣為右將軍。"
  },
  {
    "id": "s0124",
    "blockIndex": 25,
    "zh": "大司空何武、尚書令唐林皆上書言：「喜行義修潔，忠誠憂國，內輔之臣也。"
  },
  {
    "id": "s0125",
    "blockIndex": 25,
    "zh": "今以寢病一旦遣歸，眾庶失望，皆曰：『傅氏賢子，以論議不合於定陶太后，故退，』百寮莫不為國恨之。"
  },
  {
    "id": "s0126",
    "blockIndex": 25,
    "zh": "忠臣，社稷之衛。"
  },
  {
    "id": "s0127",
    "blockIndex": 25,
    "zh": "魯以季友治亂，楚以子玉輕重，魏以無忌折衝，項以范增存亡。"
  },
  {
    "id": "s0128",
    "blockIndex": 25,
    "zh": "百萬之眾，不如一賢，故秦行千金以間廉頗，漢散黃金以疏亞父。"
  },
  {
    "id": "s0129",
    "blockIndex": 25,
    "zh": "喜立於朝，陛下之光輝，傅氏之廢興也。"
  },
  {
    "id": "s0130",
    "blockIndex": 25,
    "zh": "」上亦自重之，故尋復進用焉。"
  },
  {
    "id": "s0131",
    "blockIndex": 26,
    "zh": "建平侯杜業上書詆曲陽侯王根、高陽侯薛宣、安昌侯張禹而薦朱博。"
  },
  {
    "id": "s0132",
    "blockIndex": 26,
    "zh": "帝少而聞知王氏驕盛，心不能善，以初立，故且優之。"
  },
  {
    "id": "s0133",
    "blockIndex": 26,
    "zh": "後月餘，司隸校尉解光奏：「曲陽侯，先帝山陵未成，公聘取故掖庭女樂五官殷嚴、王飛君等置酒歌舞，及根兄子成都侯況，亦聘取故掖庭貴人以為妻，皆無人臣禮，大不敬，不道！"
  },
  {
    "id": "s0134",
    "blockIndex": 26,
    "zh": "」於是天子曰：「先帝遇根、況父子，至厚也，今乃背恩忘義！"
  },
  {
    "id": "s0135",
    "blockIndex": 26,
    "zh": "」以根嘗建社稷之策，遣就國，免況為庶人，歸故郡。"
  },
  {
    "id": "s0136",
    "blockIndex": 26,
    "zh": "根及況父商所薦舉為官者皆罷。"
  },
  {
    "id": "s0137",
    "blockIndex": 27,
    "zh": "九月，庚申，地震，自京師到北邊郡國三十餘處，壞城郭，凡壓殺四百餘人。"
  },
  {
    "id": "s0138",
    "blockIndex": 27,
    "zh": "上以災異問待詔李尋，對曰：「夫日者，眾陽之長，人君之表也。"
  },
  {
    "id": "s0139",
    "blockIndex": 27,
    "zh": "君不修道，則日失其度，晻昧亡光。"
  },
  {
    "id": "s0140",
    "blockIndex": 27,
    "zh": "間者日尤不精，光明侵奪失色，邪氣珥，蜺數作。"
  },
  {
    "id": "s0141",
    "blockIndex": 27,
    "zh": "小臣不知內事，竊以日視陛下，志操衰於始初多矣。"
  },
  {
    "id": "s0142",
    "blockIndex": 27,
    "zh": "唯陛下執乾剛之德，強志守度，毋聽女謁、邪臣之態；"
  },
  {
    "id": "s0143",
    "blockIndex": 27,
    "zh": "諸保阿、乳母甘言悲辭之托，斷而勿聽。"
  },
  {
    "id": "s0144",
    "blockIndex": 27,
    "zh": "勉強大誼，絕小不忍；"
  },
  {
    "id": "s0145",
    "blockIndex": 27,
    "zh": "良有不得已，可賜以貨財，不可私以官位，誠皇天之禁也。"
  },
  {
    "id": "s0146",
    "blockIndex": 28,
    "zh": "「臣聞月者，眾陰之長，妃後、大臣、諸侯之象也。"
  },
  {
    "id": "s0147",
    "blockIndex": 28,
    "zh": "間者月數為變，此為母后與政亂朝，陰陽俱傷，兩不相便；"
  },
  {
    "id": "s0148",
    "blockIndex": 28,
    "zh": "外臣不知朝事，竊信天文，即如此，近臣已不足杖矣。"
  },
  {
    "id": "s0149",
    "blockIndex": 28,
    "zh": "唯陛下親求賢士，無強所惡，以崇社稷，尊強本朝！"
  },
  {
    "id": "s0150",
    "blockIndex": 29,
    "zh": "「臣聞五行以水為本，水為準平，王道公正修明，則百川理，落脈通；"
  },
  {
    "id": "s0151",
    "blockIndex": 29,
    "zh": "偏黨失綱，則湧溢為敗。"
  },
  {
    "id": "s0152",
    "blockIndex": 29,
    "zh": "今汝、穎漂湧，與雨水並為民害，此《詩》所謂『百川沸騰』，咎在皇甫卿士之屬。"
  },
  {
    "id": "s0153",
    "blockIndex": 29,
    "zh": "唯陛下少抑外親大臣！"
  },
  {
    "id": "s0154",
    "blockIndex": 30,
    "zh": "「臣聞地道柔靜，陰之常義也。"
  },
  {
    "id": "s0155",
    "blockIndex": 30,
    "zh": "間者關東地數震，宜務崇陽抑陰以救其咎，固志建威，閉絕私路，拔進英雋，退不任職，以強本朝！"
  },
  {
    "id": "s0156",
    "blockIndex": 30,
    "zh": "夫本強則精神折衝；"
  },
  {
    "id": "s0157",
    "blockIndex": 30,
    "zh": "本弱則招殃致凶，為邪謀所陵。"
  },
  {
    "id": "s0158",
    "blockIndex": 30,
    "zh": "聞往者淮南王作謀之時，其所難者獨有汲黯，以為公孫弘等不足言也。"
  },
  {
    "id": "s0159",
    "blockIndex": 30,
    "zh": "弘，漢之名相，於今亡比，而尚見輕，何況亡弘之屬乎！"
  },
  {
    "id": "s0160",
    "blockIndex": 30,
    "zh": "故曰朝廷亡人，則為賊亂所輕，其道自然也。"
  },
  {
    "id": "s0162",
    "blockIndex": 31,
    "zh": "騎都尉平當使領河堤，奏：「九河今皆窴滅。"
  },
  {
    "id": "s0163",
    "blockIndex": 31,
    "zh": "按經義，治水有決河深川而無堤防壅塞之文。"
  },
  {
    "id": "s0164",
    "blockIndex": 31,
    "zh": "河從魏郡以東北多溢決，水跡難以分明，四海之眾不可誣。"
  },
  {
    "id": "s0165",
    "blockIndex": 31,
    "zh": "宜博求能浚川疏河者。"
  },
  {
    "id": "s0166",
    "blockIndex": 31,
    "zh": "」上從之。"
  },
  {
    "id": "s0167",
    "blockIndex": 32,
    "zh": "待詔賈讓奏言：「治河有上、中、下策。"
  },
  {
    "id": "s0168",
    "blockIndex": 32,
    "zh": "古者立國居民，疆理土地，必遺川澤之分，度水勢所不及。"
  },
  {
    "id": "s0169",
    "blockIndex": 32,
    "zh": "大川無防，小水得入，陂障卑下，以為污澤，使秋水多得其所休息，左右游波寬緩而不迫。"
  },
  {
    "id": "s0170",
    "blockIndex": 32,
    "zh": "夫土之有川，猶人之有口也，治土而防其川，猶止兒啼而塞其口，豈不遽止，然其死可立而待也。"
  },
  {
    "id": "s0171",
    "blockIndex": 32,
    "zh": "故曰：『善為川者決之使道，善為民者宣之使言。"
  },
  {
    "id": "s0172",
    "blockIndex": 32,
    "zh": "』蓋堤防之作，近起戰國，雍防百川，各以自利。"
  },
  {
    "id": "s0173",
    "blockIndex": 32,
    "zh": "齊與趙、魏以河為竟，趙、魏瀕山，齊地卑下，作堤去河二十五里，河水東抵齊堤則西泛趙、魏；"
  },
  {
    "id": "s0174",
    "blockIndex": 32,
    "zh": "趙、魏亦為堤，去河二十五里，雖非其正，水尚有所遊蕩。"
  },
  {
    "id": "s0175",
    "blockIndex": 32,
    "zh": "時至而去，則填淤肥美，民耕田之；"
  },
  {
    "id": "s0176",
    "blockIndex": 32,
    "zh": "或久無害，稍築宮宅，遂成聚落；"
  },
  {
    "id": "s0177",
    "blockIndex": 32,
    "zh": "大水時至，漂沒，則更起堤防以自救，稍去其城郭，排水澤而居之，湛溺自其宜也。"
  },
  {
    "id": "s0178",
    "blockIndex": 32,
    "zh": "今堤防，狹者去水數百步，遠者數里，於故大堤之內復有數重，民居其間，此皆前世所排也。"
  },
  {
    "id": "s0179",
    "blockIndex": 32,
    "zh": "河從河內黎陽至魏郡昭陽，東西互有石堤，激水使還，百餘里間，河再西三東，迫厄如此，不得安息。"
  },
  {
    "id": "s0180",
    "blockIndex": 32,
    "zh": "今行上策，徙冀州之民當水沖者，決黎陽遮害亭，放河使北入海；"
  },
  {
    "id": "s0181",
    "blockIndex": 32,
    "zh": "河西薄大山，東薄金堤，勢不能遠氾濫，期月自定。"
  },
  {
    "id": "s0182",
    "blockIndex": 32,
    "zh": "難者將曰：『若如此，敗壞城郭、田廬、塚墓以萬數，百姓怨恨。"
  },
  {
    "id": "s0183",
    "blockIndex": 32,
    "zh": "』昔大禹治水，山陵當路者毀之，故鑿龍門，辟伊闕，析厎柱，破碣石，墮斷天地之性，此乃人功所造，何足言也！"
  },
  {
    "id": "s0184",
    "blockIndex": 32,
    "zh": "今瀕河十郡，治堤歲費且萬萬；"
  },
  {
    "id": "s0185",
    "blockIndex": 32,
    "zh": "及其大決，所殘無數。"
  },
  {
    "id": "s0186",
    "blockIndex": 32,
    "zh": "如出數年治河之費以業所徙之民，遵古聖之法，定山川之位，使神人各處其所而不相奸；"
  },
  {
    "id": "s0187",
    "blockIndex": 32,
    "zh": "且以大漢方制萬里，豈其與水爭咫尺之地哉！"
  },
  {
    "id": "s0188",
    "blockIndex": 32,
    "zh": "此功一立，河定民安，千載無患，故謂之上策。"
  },
  {
    "id": "s0189",
    "blockIndex": 32,
    "zh": "若乃多穿漕渠於冀州地，使民得以溉田，分殺水怒，雖非聖人法，然也救敗術也。"
  },
  {
    "id": "s0190",
    "blockIndex": 32,
    "zh": "可從淇口以東為石堤，多張水門。"
  },
  {
    "id": "s0191",
    "blockIndex": 32,
    "zh": "恐議者疑河大川難禁制，滎陽漕渠足以卜之。"
  },
  {
    "id": "s0192",
    "blockIndex": 32,
    "zh": "冀州渠首盡，當仰此水門，諸渠皆往往股引取之：旱則開東方下水門，溉冀州；"
  },
  {
    "id": "s0193",
    "blockIndex": 32,
    "zh": "水則開西方高門，分河流，民田適治，河堤亦成。"
  },
  {
    "id": "s0194",
    "blockIndex": 32,
    "zh": "此誠富國安民、興利除害，支數百歲，故謂之中策。"
  },
  {
    "id": "s0195",
    "blockIndex": 32,
    "zh": "若乃繕完故堤，增卑倍薄，勞費無已，數逢其害，此最下策也。"
  },
  {
    "id": "s0197",
    "blockIndex": 33,
    "zh": "孔光、何武奏：「迭毀之次當以時定，請與群臣雜議。"
  },
  {
    "id": "s0198",
    "blockIndex": 33,
    "zh": "」於是光祿勳彭宣等五十三人皆以為：「孝武皇帝雖有功烈，親盡宜毀。"
  },
  {
    "id": "s0199",
    "blockIndex": 33,
    "zh": "」太僕王舜、中壘校尉劉歆議曰：「《禮》，天子七廟。"
  },
  {
    "id": "s0200",
    "blockIndex": 33,
    "zh": "七者其正法數，可常數者也。"
  },
  {
    "id": "s0201",
    "blockIndex": 33,
    "zh": "宗不在此數中，宗變也。"
  },
  {
    "id": "s0202",
    "blockIndex": 33,
    "zh": "苟有功德則宗之，不可預為設數。"
  },
  {
    "id": "s0203",
    "blockIndex": 33,
    "zh": "臣愚以為孝武皇帝功烈如彼，孝宣皇帝崇立之如此，不宜毀。"
  },
  {
    "id": "s0204",
    "blockIndex": 33,
    "zh": "」上覽其議，制曰：「太僕舜、中壘校尉歆議可。"
  },
  {
    "id": "s0206",
    "blockIndex": 34,
    "zh": "何武後母在蜀郡，遣吏歸迎；"
  },
  {
    "id": "s0207",
    "blockIndex": 34,
    "zh": "會成帝崩，吏恐道路有盜賊，後母留止。"
  },
  {
    "id": "s0208",
    "blockIndex": 34,
    "zh": "左右或譏武事親不篤，帝亦欲改易大臣，冬，十月，策免武，以列侯歸國。"
  },
  {
    "id": "s0209",
    "blockIndex": 34,
    "zh": "癸酉，以師丹為大司空。"
  },
  {
    "id": "s0210",
    "blockIndex": 34,
    "zh": "丹見上多所匡改成帝之政，乃上書言：「古者諒暗不言，聽於塚宰，三年無改於父之道。"
  },
  {
    "id": "s0211",
    "blockIndex": 34,
    "zh": "前大行屍柩在堂，而官爵臣等以及親屬，赫然皆貴寵，封舅為陽安侯，皇后尊號未定，豫封父為孔鄉侯；"
  },
  {
    "id": "s0212",
    "blockIndex": 34,
    "zh": "出侍中王邑、射聲校尉王邯等。"
  },
  {
    "id": "s0213",
    "blockIndex": 34,
    "zh": "詔書比下，變動政事，卒暴無漸。"
  },
  {
    "id": "s0214",
    "blockIndex": 34,
    "zh": "臣縱不能明陳大義，復曾不能牢讓爵位，相隨空受封侯，增益陛下之過。"
  },
  {
    "id": "s0215",
    "blockIndex": 34,
    "zh": "間者郡國多地動水出，流殺人民，日月不明，五星失行，此皆舉錯失中，號令不定，法度失理，陰陽溷濁之應也。"
  },
  {
    "id": "s0216",
    "blockIndex": 35,
    "zh": "「臣伏惟人情無子，年雖六七十，猶博取而廣求。"
  },
  {
    "id": "s0217",
    "blockIndex": 35,
    "zh": "孝成皇帝深見天命，燭知至德，以壯年克己，立陛下為嗣。"
  },
  {
    "id": "s0218",
    "blockIndex": 35,
    "zh": "先帝暴棄天下，而陛下繼體，四海安寧，百姓不懼，此先帝聖德，當合天人之功也。"
  },
  {
    "id": "s0219",
    "blockIndex": 35,
    "zh": "臣聞『天威不違顏咫尺』，願陛下深思先帝所以建立陛下之意，且克己躬行，以觀群下之從化。"
  },
  {
    "id": "s0220",
    "blockIndex": 35,
    "zh": "天下者，陛下之家也，胏附何患不富貴，不宜倉卒若是，其不久長矣！"
  },
  {
    "id": "s0221",
    "blockIndex": 35,
    "zh": "」丹書數十上，多切直之言。"
  },
  {
    "id": "s0222",
    "blockIndex": 36,
    "zh": "傅太后從弟子遷在左右，尤傾邪，上惡之，免官，遣歸故郡。"
  },
  {
    "id": "s0223",
    "blockIndex": 36,
    "zh": "傅太后怒；"
  },
  {
    "id": "s0224",
    "blockIndex": 36,
    "zh": "上不得已，復留遷。"
  },
  {
    "id": "s0225",
    "blockIndex": 36,
    "zh": "丞相光與大司空丹奏言：「詔書前後相反，天下疑惑，無所取信。"
  },
  {
    "id": "s0226",
    "blockIndex": 36,
    "zh": "臣請歸遷故郡，以銷奸黨。"
  },
  {
    "id": "s0227",
    "blockIndex": 36,
    "zh": "」卒不得遣，復為侍中，其逼於傅太后，皆此類也。"
  },
  {
    "id": "s0228",
    "blockIndex": 37,
    "zh": "議郎耿育上書冤訟陳湯曰：「甘延壽、陳湯，為聖漢揚鉤深致遠之威，雪國家累年之恥，討絕域不羈之君，系萬里難制之虜，豈有比哉！"
  },
  {
    "id": "s0229",
    "blockIndex": 37,
    "zh": "先帝嘉之，仍下明詔，宣著其功，改年垂歷，傳之無窮。"
  },
  {
    "id": "s0230",
    "blockIndex": 37,
    "zh": "應是，南郡獻白虎，邊垂無警備。"
  },
  {
    "id": "s0231",
    "blockIndex": 37,
    "zh": "會先帝寢疾，然猶垂竟不忘，數使尚書責問丞相，趣立其功；"
  },
  {
    "id": "s0232",
    "blockIndex": 37,
    "zh": "獨丞相匡衡排而不予，封延壽、湯數百戶，此功臣戰士所以失望也。"
  },
  {
    "id": "s0233",
    "blockIndex": 37,
    "zh": "孝成皇帝承建業之基，乘征伐之威，兵革不動，國家無事，而大臣傾邪，欲專主威，排妒有功，使湯塊然被冤拘囚，不能自明，卒以無罪老棄。"
  },
  {
    "id": "s0234",
    "blockIndex": 37,
    "zh": "敦煌正當西域通道，令威名折衝之臣，旋踵及身，復為郅支遺虜所笑，誠可悲也！"
  },
  {
    "id": "s0235",
    "blockIndex": 37,
    "zh": "至今奉使外蠻者，未嘗不陳郅支之誅以揚漢國之盛。"
  },
  {
    "id": "s0236",
    "blockIndex": 37,
    "zh": "夫援人之功以懼敵，棄人之身以快讒，豈不痛哉！"
  },
  {
    "id": "s0237",
    "blockIndex": 37,
    "zh": "且安不忘危，盛必慮衰，今國家素無文帝累年節儉富饒之畜，又無武帝薦延梟俊禽敵之臣，獨有一陳湯耳！"
  },
  {
    "id": "s0238",
    "blockIndex": 37,
    "zh": "假使異世不及陛下，尚望國家追錄其功，封表其墓，以勸後進也。"
  },
  {
    "id": "s0239",
    "blockIndex": 37,
    "zh": "湯幸得身當聖世，功曾未久，反聽邪臣鞭逐斥遠，使亡逃分竄，死無處所。"
  },
  {
    "id": "s0240",
    "blockIndex": 37,
    "zh": "遠覽之士，莫不計度，以為湯功累世不可及，而湯過人情所有，湯尚如此，雖復破絕筋骨，暴露形骸，猶複製於脣舌，為嫉妒之臣所繫虜耳。"
  },
  {
    "id": "s0241",
    "blockIndex": 37,
    "zh": "此臣所以為國家尤戚戚也。"
  },
  {
    "id": "s0242",
    "blockIndex": 37,
    "zh": "」書奏，天子還湯，卒於長安。"
  },
  {
    "id": "s0243",
    "blockIndex": 38,
    "zh": "孝哀皇帝上"
  },
  {
    "id": "s0244",
    "blockIndex": 39,
    "zh": "春，正月，隕石於北地十六。"
  },
  {
    "id": "s0245",
    "blockIndex": 40,
    "zh": "赦天下。"
  },
  {
    "id": "s0246",
    "blockIndex": 41,
    "zh": "司隸校尉解光奏言：「臣聞許美人及故中宮史曹宮皆御幸孝成皇帝，產子。"
  },
  {
    "id": "s0247",
    "blockIndex": 41,
    "zh": "子隱不見。"
  },
  {
    "id": "s0248",
    "blockIndex": 41,
    "zh": "臣遣吏驗問，皆得其狀：元延元年，宮有身；"
  },
  {
    "id": "s0249",
    "blockIndex": 41,
    "zh": "其十月，宮乳掖庭牛官令捨。"
  },
  {
    "id": "s0250",
    "blockIndex": 41,
    "zh": "中黃門田客持詔記與掖庭獄丞籍武，令收置暴室獄，『毋問兒男、女，誰兒也！"
  },
  {
    "id": "s0251",
    "blockIndex": 41,
    "zh": "』宮曰：『善臧我兒胞，丞知是何等兒也！"
  },
  {
    "id": "s0252",
    "blockIndex": 41,
    "zh": "』後三日，客持詔記與武，問：『兒死未？"
  },
  {
    "id": "s0253",
    "blockIndex": 41,
    "zh": "』武對：『未死。"
  },
  {
    "id": "s0254",
    "blockIndex": 41,
    "zh": "』客曰：『上與昭儀大怒，奈何不殺！"
  },
  {
    "id": "s0255",
    "blockIndex": 41,
    "zh": "』武叩頭啼曰：『不殺兒，自知當死；"
  },
  {
    "id": "s0256",
    "blockIndex": 41,
    "zh": "殺之，亦死！"
  },
  {
    "id": "s0257",
    "blockIndex": 41,
    "zh": "』即因客奏封事曰：『陛下未有繼嗣，子無貴賤，唯留意！"
  },
  {
    "id": "s0258",
    "blockIndex": 41,
    "zh": "』奏入，客復特詔記取兒，付中黃門王舜。"
  },
  {
    "id": "s0259",
    "blockIndex": 41,
    "zh": "舜受詔，內兒殿中，為擇乳母，告『善養兒，且有賞，毋令漏洩！"
  },
  {
    "id": "s0260",
    "blockIndex": 41,
    "zh": "』舜擇官婢張棄為乳母。"
  },
  {
    "id": "s0261",
    "blockIndex": 41,
    "zh": "後三日，客復持詔記並藥以飲宮。"
  },
  {
    "id": "s0262",
    "blockIndex": 41,
    "zh": "宮曰：『果也欲姊弟擅天下！"
  },
  {
    "id": "s0263",
    "blockIndex": 41,
    "zh": "我兒，男也，額上有壯發，類孝元皇帝。"
  },
  {
    "id": "s0264",
    "blockIndex": 41,
    "zh": "今兒安在？"
  },
  {
    "id": "s0265",
    "blockIndex": 41,
    "zh": "危殺之矣！"
  },
  {
    "id": "s0266",
    "blockIndex": 41,
    "zh": "奈何令長信得聞之？"
  },
  {
    "id": "s0267",
    "blockIndex": 41,
    "zh": "』遂飲藥死。"
  },
  {
    "id": "s0268",
    "blockIndex": 41,
    "zh": "棄所養兒十一日，宮長李南以詔書取兒去，不知所置。"
  },
  {
    "id": "s0269",
    "blockIndex": 41,
    "zh": "許美人元延二年懷子，十一月乳。"
  },
  {
    "id": "s0270",
    "blockIndex": 41,
    "zh": "昭儀謂成帝曰：『常紿我言從中宮來。"
  },
  {
    "id": "s0271",
    "blockIndex": 41,
    "zh": "即從中宮來，許美人兒何從生中！"
  },
  {
    "id": "s0272",
    "blockIndex": 41,
    "zh": "許氏竟當復立邪！"
  },
  {
    "id": "s0273",
    "blockIndex": 41,
    "zh": "』懟，以手自搗，以頭擊壁戶柱，從床上自投地，啼泣不肯食，曰：『今當安置我，我欲歸耳！"
  },
  {
    "id": "s0274",
    "blockIndex": 41,
    "zh": "』帝曰：『今故告之，反怒為，殊不可曉也！"
  },
  {
    "id": "s0275",
    "blockIndex": 41,
    "zh": "』帝亦不食。"
  },
  {
    "id": "s0276",
    "blockIndex": 41,
    "zh": "昭儀曰：『陛下自知是，不食何為！"
  },
  {
    "id": "s0277",
    "blockIndex": 41,
    "zh": "陛下嘗自言：「約不負女！"
  },
  {
    "id": "s0278",
    "blockIndex": 41,
    "zh": "」今美人有子，竟負約，謂何？"
  },
  {
    "id": "s0279",
    "blockIndex": 41,
    "zh": "』帝曰：『約以趙氏，故不立許氏，使天下無出趙氏上者，毋憂也！"
  },
  {
    "id": "s0280",
    "blockIndex": 41,
    "zh": "』後詔使中黃門靳嚴從許美人取兒去，盛以葦篋，置飾室簾南去。"
  },
  {
    "id": "s0281",
    "blockIndex": 41,
    "zh": "帝與昭儀坐，使御者於客子解篋緘，未已，帝使客子及御者皆出，自閉戶，獨與昭儀在。"
  },
  {
    "id": "s0282",
    "blockIndex": 41,
    "zh": "須臾開戶，呼客子使緘封篋，及詔記令中黃門吳恭持以與籍武曰：『告武，篋中有死兒，埋屏處，勿令人知！"
  },
  {
    "id": "s0283",
    "blockIndex": 41,
    "zh": "』武穿獄樓垣下為坎，埋其中。"
  },
  {
    "id": "s0284",
    "blockIndex": 41,
    "zh": "其它飲藥傷墮者無數事，皆在四月丙辰赦令前。"
  },
  {
    "id": "s0285",
    "blockIndex": 41,
    "zh": "臣謹案：永光三年，男子忠等發長陵傅夫人塚。"
  },
  {
    "id": "s0286",
    "blockIndex": 41,
    "zh": "事更大赦，孝元皇帝下詔曰：『此朕所不當得赦也。"
  },
  {
    "id": "s0287",
    "blockIndex": 41,
    "zh": "』窮治，盡伏辜。"
  },
  {
    "id": "s0288",
    "blockIndex": 41,
    "zh": "天下以為當。"
  },
  {
    "id": "s0289",
    "blockIndex": 41,
    "zh": "趙昭儀傾亂聖朝，親滅繼嗣，親屬當伏天誅。"
  },
  {
    "id": "s0290",
    "blockIndex": 41,
    "zh": "而同產親屬皆在尊貴之位，迫近帷幄，群下寒心，請事窮竟！"
  },
  {
    "id": "s0291",
    "blockIndex": 41,
    "zh": "」丞相以下議正法，帝於是免新成侯趙欽、欽兄子成陽侯訢皆為庶人，將家屬徙遼西郡。"
  },
  {
    "id": "s0292",
    "blockIndex": 42,
    "zh": "議郎耿育上疏言：「臣聞繼嗣失統，廢適立庶，聖人法禁，古今至戒。"
  },
  {
    "id": "s0293",
    "blockIndex": 42,
    "zh": "然太伯見歷知適，逡循固讓，委身吳、粵，權變所設，不計常法，致位王季，以崇聖嗣，卒有天下，子孫承業七八百載，功冠三王，道德最備，是以尊號追及太王。"
  },
  {
    "id": "s0294",
    "blockIndex": 42,
    "zh": "故世必有非常之變，然後乃有非常之謀。"
  },
  {
    "id": "s0295",
    "blockIndex": 42,
    "zh": "孝成皇帝自知繼嗣不以時立，念雖末有皇子，萬歲之後未能持國，權柄之重，制於女主，女主驕盛則耆欲無極，少主幼弱則大臣不使，世無周公抱負之輔，恐危社稷，傾亂天下。"
  },
  {
    "id": "s0296",
    "blockIndex": 42,
    "zh": "知陛下有賢聖通明之德，仁孝子愛之恩，懷獨見之明，內斷於身，故廢後宮就館之漸，絕微嗣禍亂之根，乃欲致位陛下以安宗廟。"
  },
  {
    "id": "s0297",
    "blockIndex": 42,
    "zh": "愚臣既不能深援安危，定金匱之計，又不知推演聖德，述先帝之志，乃反覆校省內，暴露私燕，誣污先帝傾惑之過，成結寵妾□石媢之誅，甚失賢聖遠見之明，逆負先帝憂國之意！"
  },
  {
    "id": "s0298",
    "blockIndex": 42,
    "zh": "夫論大德不拘俗，立大功不合眾，此乃孝成皇帝至思所以萬萬於眾臣，陛下聖德盛茂所以符合於皇天也，豈當世庸庸斗筲之臣所能及哉！"
  },
  {
    "id": "s0299",
    "blockIndex": 42,
    "zh": "且褒廣將順君父之美，匡救銷滅既往之過，古今通義也。"
  },
  {
    "id": "s0300",
    "blockIndex": 42,
    "zh": "事不當時固爭，防禍於未然，各隨指阿從以求容媚；"
  },
  {
    "id": "s0301",
    "blockIndex": 42,
    "zh": "晏駕之後，尊號已定，萬事已訖，乃探追不及之事，訐揚幽昧之過，此臣所深痛也！"
  },
  {
    "id": "s0302",
    "blockIndex": 42,
    "zh": "願下有司議，即如臣言，宜宣佈天下，使鹹曉知先帝聖意所起。"
  },
  {
    "id": "s0303",
    "blockIndex": 42,
    "zh": "不然，空使謗議上及山陵，下流後世，遠聞百蠻，近布海內，甚非先帝托後之意也。"
  },
  {
    "id": "s0304",
    "blockIndex": 42,
    "zh": "蓋孝子，善述父之志，善成人之事，唯陛下省察！"
  },
  {
    "id": "s0305",
    "blockIndex": 42,
    "zh": "」帝亦以為太子頗得趙太后力，遂不竟其事。"
  },
  {
    "id": "s0306",
    "blockIndex": 42,
    "zh": "傅太后恩趙太后，趙太后亦歸心，故太皇太后及王氏皆怨之。"
  },
  {
    "id": "s0307",
    "blockIndex": 43,
    "zh": "丁酉，光祿大夫傅喜為大司馬，封高武侯。"
  },
  {
    "id": "s0308",
    "blockIndex": 44,
    "zh": "秋，九月，甲辰，隕石於虞二。"
  },
  {
    "id": "s0309",
    "blockIndex": 44,
    "zh": "郎中令泠褒、黃門郎段猶等復奏言：「定陶共皇太后、共皇后，皆不宜復引定陶籓國之名，以冠大號；"
  },
  {
    "id": "s0310",
    "blockIndex": 44,
    "zh": "車馬、衣服宜皆稱皇之意，置吏二千石以下，各供厥職；"
  },
  {
    "id": "s0311",
    "blockIndex": 44,
    "zh": "又宜為共皇立廟京師。"
  },
  {
    "id": "s0312",
    "blockIndex": 44,
    "zh": "」上復下其議，群下多順指言：「母以子貴，宜立尊號以厚孝道。"
  },
  {
    "id": "s0313",
    "blockIndex": 44,
    "zh": "」唯丞相光、大司馬喜、大司空丹以為不可。"
  },
  {
    "id": "s0314",
    "blockIndex": 44,
    "zh": "丹曰：「聖王制禮，取法於天地。"
  },
  {
    "id": "s0315",
    "blockIndex": 44,
    "zh": "尊卑者，所以正天地之位，不可亂也。"
  },
  {
    "id": "s0316",
    "blockIndex": 44,
    "zh": "今定陶共皇太后、共皇后以『定陶共』為號者，母從子，妻從夫之義也。"
  },
  {
    "id": "s0317",
    "blockIndex": 44,
    "zh": "欲立官置吏，車服與太皇太后並，非所以明『尊無二上』之義也。"
  },
  {
    "id": "s0318",
    "blockIndex": 44,
    "zh": "定陶共皇號謚已前定，義不得復改。"
  },
  {
    "id": "s0319",
    "blockIndex": 44,
    "zh": "禮：『父為士，子為天子，祭以天子，其屍服以士服』，子無爵父之義，尊父母也。"
  },
  {
    "id": "s0320",
    "blockIndex": 44,
    "zh": "為人後者為之子，故為所後服斬衰三年，而降其父母期，明尊本祖而重正統也。"
  },
  {
    "id": "s0321",
    "blockIndex": 44,
    "zh": "孝成皇帝聖恩深遠，故為共王立後，奉承祭祀，令共皇長為一國太祖，萬世不毀，恩義已備。"
  },
  {
    "id": "s0322",
    "blockIndex": 44,
    "zh": "陛下既繼體先帝，持重大宗，承宗廟、天地、社稷之祀，義不可復奉定陶共皇祭入其廟。"
  },
  {
    "id": "s0323",
    "blockIndex": 44,
    "zh": "今欲立廟於京師，而使臣下祭之，是無主也。"
  },
  {
    "id": "s0324",
    "blockIndex": 44,
    "zh": "又，親盡當毀。"
  },
  {
    "id": "s0325",
    "blockIndex": 44,
    "zh": "空去一國太祖不墮之祀，而就無主當毀不正之禮，非所以尊厚共皇也。"
  },
  {
    "id": "s0326",
    "blockIndex": 44,
    "zh": "」丹由是浸不合上意。"
  },
  {
    "id": "s0327",
    "blockIndex": 45,
    "zh": "會有上書言：「古者以龜、貝為貨，今以錢易之，民以故貧，宜可改幣。"
  },
  {
    "id": "s0328",
    "blockIndex": 45,
    "zh": "」上以問丹，丹對言可改。"
  },
  {
    "id": "s0329",
    "blockIndex": 45,
    "zh": "章下有司議，皆以為行錢以來久，難卒變易。"
  },
  {
    "id": "s0330",
    "blockIndex": 45,
    "zh": "丹老人，忘其前語，復從公卿議。"
  },
  {
    "id": "s0331",
    "blockIndex": 45,
    "zh": "又丹使吏書奏，吏私寫其草。"
  },
  {
    "id": "s0332",
    "blockIndex": 45,
    "zh": "丁、傅子弟聞之，使人上書告「丹上封事，行道人遍持其書。"
  },
  {
    "id": "s0333",
    "blockIndex": 45,
    "zh": "」上以問將軍、中朝臣，皆對曰：「忠臣不顯諫。"
  },
  {
    "id": "s0334",
    "blockIndex": 45,
    "zh": "大臣奏事，不宜漏洩，宜不廷尉治。"
  },
  {
    "id": "s0335",
    "blockIndex": 45,
    "zh": "」事下廷尉，劾丹大不敬，事未決，給事中、博士申鹹、炔欽上書言：「丹經行無比，自近世大臣能若丹者少。"
  },
  {
    "id": "s0336",
    "blockIndex": 45,
    "zh": "發憤懣，奏封事，不及深思遠慮，使主簿書，漏洩之過不在丹，以此貶黜，恐不厭眾心。"
  },
  {
    "id": "s0337",
    "blockIndex": 45,
    "zh": "」上貶鹹、欽秩各二等。"
  },
  {
    "id": "s0338",
    "blockIndex": 45,
    "zh": "遂策免丹曰：「朕惟君位尊任重，懷諼迷國，進退違命，反覆異言，甚為君恥之！"
  },
  {
    "id": "s0339",
    "blockIndex": 45,
    "zh": "以君嘗托傅位，未忍考於理，其上大司空、高樂侯印綬，罷歸！"
  },
  {
    "id": "s0341",
    "blockIndex": 46,
    "zh": "尚書令唐林上疏曰：「竊見免大司空丹策書，泰深痛切！"
  },
  {
    "id": "s0342",
    "blockIndex": 46,
    "zh": "君子作文，為賢者諱。"
  },
  {
    "id": "s0343",
    "blockIndex": 46,
    "zh": "丹，經為世儒宗，德為國黃耇，親傅聖躬，位在三公；"
  },
  {
    "id": "s0344",
    "blockIndex": 46,
    "zh": "所坐者微，海內未見其大過。"
  },
  {
    "id": "s0345",
    "blockIndex": 46,
    "zh": "事既以往，免爵太重；"
  },
  {
    "id": "s0346",
    "blockIndex": 46,
    "zh": "京師識者鹹以為宜復丹爵邑，使奉朝請。"
  },
  {
    "id": "s0347",
    "blockIndex": 46,
    "zh": "唯陛下裁覽眾心，有以尉復師傅之臣！"
  },
  {
    "id": "s0348",
    "blockIndex": 46,
    "zh": "」上從林言，下詔，賜丹爵關內侯。"
  },
  {
    "id": "s0349",
    "blockIndex": 47,
    "zh": "上用杜業之言，召見朱博，起家復為光祿大夫；"
  },
  {
    "id": "s0350",
    "blockIndex": 47,
    "zh": "遷京兆尹。"
  },
  {
    "id": "s0351",
    "blockIndex": 47,
    "zh": "冬，十月，壬午，以博為大司空。"
  },
  {
    "id": "s0352",
    "blockIndex": 48,
    "zh": "中山王箕子，幼有眚病，祖母馮太后自養視，數禱祠解。"
  },
  {
    "id": "s0353",
    "blockIndex": 48,
    "zh": "上遣中郎謁者張由將醫治之。"
  },
  {
    "id": "s0354",
    "blockIndex": 48,
    "zh": "由素有狂易病，病發，怒去，西歸長安。"
  },
  {
    "id": "s0355",
    "blockIndex": 48,
    "zh": "尚書簿責由擅去狀，由恐，因誣言中山太后祝詛上及傅太后。"
  },
  {
    "id": "s0356",
    "blockIndex": 48,
    "zh": "傅太后與馮太后並事元帝，追怨之，因是遣御史丁玄案驗；"
  },
  {
    "id": "s0357",
    "blockIndex": 48,
    "zh": "數十日，無所得。"
  },
  {
    "id": "s0358",
    "blockIndex": 48,
    "zh": "更使中謁者令史立治之；"
  },
  {
    "id": "s0359",
    "blockIndex": 48,
    "zh": "立受傅太后指，冀得封侯，治馮太后女弟習及弟婦君之，死者數十人，誣奏云：「祝詛，謀殺上，立中山王。"
  },
  {
    "id": "s0360",
    "blockIndex": 48,
    "zh": "」責問馮太后，無服辭。"
  },
  {
    "id": "s0361",
    "blockIndex": 48,
    "zh": "立曰：「熊之上殿何其勇，今何怯也！"
  },
  {
    "id": "s0362",
    "blockIndex": 48,
    "zh": "」太后還謂左右：「此乃中語，前世事，吏何用知之？"
  },
  {
    "id": "s0363",
    "blockIndex": 48,
    "zh": "欲陷我效也！"
  },
  {
    "id": "s0364",
    "blockIndex": 48,
    "zh": "」乃飲藥自殺。"
  },
  {
    "id": "s0365",
    "blockIndex": 48,
    "zh": "宜鄉侯參、君之、習夫及子當相坐者，或自殺，或伏法，凡死者十七人。"
  },
  {
    "id": "s0366",
    "blockIndex": 48,
    "zh": "眾莫不憐之。"
  },
  {
    "id": "s0367",
    "blockIndex": 49,
    "zh": "司隸孫寶奏請覆治馮氏獄，傅太后大怒曰：「帝置司隸，主使察我！"
  },
  {
    "id": "s0368",
    "blockIndex": 49,
    "zh": "馮氏反事明白，故欲擿抉以揚我惡，我當坐之！"
  },
  {
    "id": "s0369",
    "blockIndex": 49,
    "zh": "」上乃順指，下寶獄。"
  },
  {
    "id": "s0370",
    "blockIndex": 49,
    "zh": "尚書僕射唐林爭之，上以林朋黨比周，左遷敦煌魚澤障候。"
  },
  {
    "id": "s0371",
    "blockIndex": 49,
    "zh": "大司馬傅喜、光祿大夫龔勝固爭，上為言太后，出寶，復官。"
  },
  {
    "id": "s0372",
    "blockIndex": 49,
    "zh": "張由以先告，賜爵關內侯；"
  },
  {
    "id": "s0373",
    "blockIndex": 49,
    "zh": "史立遷中太僕。"
  },
  {
    "id": "s0374",
    "blockIndex": 50,
    "zh": "category:資治通鑑"
  }
]
