[
  {
    "id": "s0001",
    "blockIndex": 0,
    "zh": "起閼逢困敦，盡著雍困敦，凡二十五年。"
  },
  {
    "id": "s0002",
    "blockIndex": 1,
    "zh": "1楚懷王亡歸。"
  },
  {
    "id": "s0003",
    "blockIndex": 1,
    "zh": "秦人覺之，遮楚道。"
  },
  {
    "id": "s0004",
    "blockIndex": 1,
    "zh": "懷王從間道走趙。"
  },
  {
    "id": "s0005",
    "blockIndex": 1,
    "zh": "趙主父在代，趙人不敢受。"
  },
  {
    "id": "s0006",
    "blockIndex": 1,
    "zh": "懷王將走魏，秦人追及之，以歸。"
  },
  {
    "id": "s0007",
    "blockIndex": 2,
    "zh": "1楚懷王發病，薨於秦，秦人歸其喪。"
  },
  {
    "id": "s0008",
    "blockIndex": 2,
    "zh": "楚人皆憐之，如悲親戚。"
  },
  {
    "id": "s0009",
    "blockIndex": 2,
    "zh": "諸侯由是不直秦。"
  },
  {
    "id": "s0010",
    "blockIndex": 3,
    "zh": "2齊、韓、魏、趙、宋同擊秦，至鹽氏而還。"
  },
  {
    "id": "s0011",
    "blockIndex": 3,
    "zh": "秦與韓武遂、與魏封陵以和。"
  },
  {
    "id": "s0012",
    "blockIndex": 4,
    "zh": "3趙主父行新地，遂出代；"
  },
  {
    "id": "s0013",
    "blockIndex": 4,
    "zh": "西遇樓煩王於西河而致其兵。"
  },
  {
    "id": "s0014",
    "blockIndex": 5,
    "zh": "4魏襄王薨，子昭王〔遫〕立<ref>子昭王〔遫〕立據《史記·魏世家》索隱引《世本》補。"
  },
  {
    "id": "s0015",
    "blockIndex": 5,
    "zh": "</ref>。"
  },
  {
    "id": "s0016",
    "blockIndex": 6,
    "zh": "5韓襄王薨，子釐王咎立。"
  },
  {
    "id": "s0017",
    "blockIndex": 7,
    "zh": "1秦尉錯伐魏襄城。"
  },
  {
    "id": "s0018",
    "blockIndex": 8,
    "zh": "2趙主父與齊、燕共滅中山，遷其王於膚施。"
  },
  {
    "id": "s0019",
    "blockIndex": 8,
    "zh": "歸，行賞，大赦，置酒，酺五日。"
  },
  {
    "id": "s0020",
    "blockIndex": 9,
    "zh": "3趙主父封其長子章於代，號曰安陽君。"
  },
  {
    "id": "s0021",
    "blockIndex": 10,
    "zh": "安陽君素侈，心不服其弟。"
  },
  {
    "id": "s0022",
    "blockIndex": 10,
    "zh": "主父使田不禮相之。"
  },
  {
    "id": "s0023",
    "blockIndex": 10,
    "zh": "李兌謂肥義曰：「公子章強壯而志驕，黨眾而欲大，田不禮忍殺而驕，二人相得，必有陰謀。"
  },
  {
    "id": "s0024",
    "blockIndex": 10,
    "zh": "夫小人有欲，輕慮淺謀，徒見其利，不顧其害，難必不久矣。"
  },
  {
    "id": "s0025",
    "blockIndex": 10,
    "zh": "子任重而勢大，亂之所始而禍之所集也。"
  },
  {
    "id": "s0026",
    "blockIndex": 10,
    "zh": "子奚不稱疾毋出而傳政於公子成，毋為禍梯，不亦可乎！"
  },
  {
    "id": "s0027",
    "blockIndex": 10,
    "zh": "」肥義曰：「昔者主父以王屬義也，曰：『毋變而度，毋易而慮，堅守一心，以歿而世。"
  },
  {
    "id": "s0028",
    "blockIndex": 10,
    "zh": "』義再拜受命而籍之。"
  },
  {
    "id": "s0029",
    "blockIndex": 10,
    "zh": "今畏不禮之難而忘吾籍，變孰大焉！"
  },
  {
    "id": "s0030",
    "blockIndex": 10,
    "zh": "諺曰：『死者復生，生者不愧。"
  },
  {
    "id": "s0031",
    "blockIndex": 10,
    "zh": "』吾欲全吾言，安得全吾身乎！"
  },
  {
    "id": "s0032",
    "blockIndex": 10,
    "zh": "子則有賜而忠我矣。"
  },
  {
    "id": "s0033",
    "blockIndex": 10,
    "zh": "雖然，吾言已在前矣，終不敢失！"
  },
  {
    "id": "s0034",
    "blockIndex": 10,
    "zh": "」李兌曰：「諾。"
  },
  {
    "id": "s0035",
    "blockIndex": 10,
    "zh": "子勉之矣！"
  },
  {
    "id": "s0036",
    "blockIndex": 10,
    "zh": "吾見子已今年耳。"
  },
  {
    "id": "s0037",
    "blockIndex": 10,
    "zh": "」涕泣而出。"
  },
  {
    "id": "s0038",
    "blockIndex": 11,
    "zh": "李兌數見公子成以備田不禮。"
  },
  {
    "id": "s0039",
    "blockIndex": 11,
    "zh": "肥義謂信期曰：「公子章與田不禮聲善而實惡，內得主而外為暴，矯令以擅一旦之命，不難為也。"
  },
  {
    "id": "s0040",
    "blockIndex": 11,
    "zh": "今吾憂之，夜而忘寐，饑而忘食，盜出入不可以不備<ref>盜出入不可以不備章校「十二行本無『以』字；"
  },
  {
    "id": "s0041",
    "blockIndex": 11,
    "zh": "乙十一行本同。"
  },
  {
    "id": "s0042",
    "blockIndex": 11,
    "zh": "」《史記·趙世家》同，但不刪亦可。"
  },
  {
    "id": "s0043",
    "blockIndex": 11,
    "zh": "</ref>。"
  },
  {
    "id": "s0044",
    "blockIndex": 11,
    "zh": "自今以來，有召王者必見吾面，我將以身先之。"
  },
  {
    "id": "s0045",
    "blockIndex": 11,
    "zh": "無故而後王可入也。"
  },
  {
    "id": "s0046",
    "blockIndex": 11,
    "zh": "」信期曰：「善。"
  },
  {
    "id": "s0048",
    "blockIndex": 12,
    "zh": "主父使惠文王朝群臣而自從旁窺之，見其長子累然也，反北面為臣。"
  },
  {
    "id": "s0049",
    "blockIndex": 12,
    "zh": "詘於其弟，心憐之，於是乃欲分趙而王公子章於代，計未決而輟。"
  },
  {
    "id": "s0050",
    "blockIndex": 12,
    "zh": "主父及王游沙丘，異宮，公子章、田不禮以其徒作亂，詐以主父令召王。"
  },
  {
    "id": "s0051",
    "blockIndex": 12,
    "zh": "肥義先入，殺之。"
  },
  {
    "id": "s0052",
    "blockIndex": 12,
    "zh": "高信即與王戰。"
  },
  {
    "id": "s0053",
    "blockIndex": 12,
    "zh": "公子成與李兌自國至，乃起四邑之兵入距難，殺公子章及田不禮，滅其黨。"
  },
  {
    "id": "s0054",
    "blockIndex": 12,
    "zh": "公子成為相，號安平君；"
  },
  {
    "id": "s0055",
    "blockIndex": 12,
    "zh": "李兌為司寇。"
  },
  {
    "id": "s0056",
    "blockIndex": 12,
    "zh": "是時惠文王少，成、兌專政。"
  },
  {
    "id": "s0057",
    "blockIndex": 13,
    "zh": "公子章之敗也，往走主父，主父開之。"
  },
  {
    "id": "s0058",
    "blockIndex": 13,
    "zh": "成、兌因圍主父〔宮〕<ref>成兌因圍主父〔宮〕章校「十二行本『父』下有『宮』字；"
  },
  {
    "id": "s0059",
    "blockIndex": 13,
    "zh": "乙十一行本同；"
  },
  {
    "id": "s0060",
    "blockIndex": 13,
    "zh": "孔本同；"
  },
  {
    "id": "s0061",
    "blockIndex": 13,
    "zh": "張校同；"
  },
  {
    "id": "s0062",
    "blockIndex": 13,
    "zh": "退齋校同。"
  },
  {
    "id": "s0063",
    "blockIndex": 13,
    "zh": "」《史記·趙世家》同，據補。"
  },
  {
    "id": "s0064",
    "blockIndex": 13,
    "zh": "</ref>。"
  },
  {
    "id": "s0065",
    "blockIndex": 13,
    "zh": "公子章死，成、兌謀曰：「以章故，圍主父；"
  },
  {
    "id": "s0066",
    "blockIndex": 13,
    "zh": "即解兵，吾屬夷矣！"
  },
  {
    "id": "s0067",
    "blockIndex": 13,
    "zh": "」乃遂圍之，令：「宮中人後出者夷！"
  },
  {
    "id": "s0068",
    "blockIndex": 13,
    "zh": "」宮中人悉出。"
  },
  {
    "id": "s0069",
    "blockIndex": 13,
    "zh": "主父欲出不得，又不得食，探雀鷇而食之。"
  },
  {
    "id": "s0070",
    "blockIndex": 13,
    "zh": "三月餘，餓死沙丘宮。"
  },
  {
    "id": "s0071",
    "blockIndex": 13,
    "zh": "主父定死，乃發喪赴諸侯。"
  },
  {
    "id": "s0072",
    "blockIndex": 13,
    "zh": "主父初以長子章為太子，後得吳娃，愛之，為不出者數歲。"
  },
  {
    "id": "s0073",
    "blockIndex": 13,
    "zh": "生子何，乃廢太子章而立之。"
  },
  {
    "id": "s0074",
    "blockIndex": 13,
    "zh": "吳娃死，愛馳；"
  },
  {
    "id": "s0075",
    "blockIndex": 13,
    "zh": "憐故太子，欲兩王之，猶豫未決，故亂起。"
  },
  {
    "id": "s0076",
    "blockIndex": 14,
    "zh": "4秦樓緩免相，魏冉代之。"
  },
  {
    "id": "s0077",
    "blockIndex": 15,
    "zh": "1秦敗魏師于解。"
  },
  {
    "id": "s0078",
    "blockIndex": 16,
    "zh": "1韓公孫喜、魏人伐秦。"
  },
  {
    "id": "s0079",
    "blockIndex": 16,
    "zh": "穰侯薦左更白起於秦王以代向壽將兵，敗魏師、韓師於伊闕，斬首二十四萬級，虜公孫喜，拔五城。"
  },
  {
    "id": "s0080",
    "blockIndex": 16,
    "zh": "秦王以白起為國尉。"
  },
  {
    "id": "s0081",
    "blockIndex": 17,
    "zh": "2秦王遺楚王書曰：「楚倍秦，秦且率諸侯伐楚，願王之飭士卒，得一樂戰！"
  },
  {
    "id": "s0082",
    "blockIndex": 17,
    "zh": "」楚王患之，乃復與秦和親。"
  },
  {
    "id": "s0083",
    "blockIndex": 18,
    "zh": "1楚襄王迎婦於秦。"
  },
  {
    "id": "s0084",
    "blockIndex": 19,
    "zh": "::臣光曰：甚哉秦之無道也，殺其父而劫其子；"
  },
  {
    "id": "s0085",
    "blockIndex": 19,
    "zh": "楚之不競也，忍其父而婚其仇！"
  },
  {
    "id": "s0086",
    "blockIndex": 19,
    "zh": "嗚呼！"
  },
  {
    "id": "s0087",
    "blockIndex": 19,
    "zh": "楚之君誠得其道，臣誠得其人，秦雖強，烏得陵之哉！"
  },
  {
    "id": "s0088",
    "blockIndex": 19,
    "zh": "善乎荀卿論之曰：「夫道，善用之則百里之地可以獨立，不善用之則楚六千里而為仇人役。"
  },
  {
    "id": "s0089",
    "blockIndex": 19,
    "zh": "」故人主不務得道而廣有其勢，是其所以危也。"
  },
  {
    "id": "s0090",
    "blockIndex": 20,
    "zh": "2秦魏冉謝病免，以客卿燭壽為丞相。"
  },
  {
    "id": "s0091",
    "blockIndex": 21,
    "zh": "1秦伐韓，拔宛。"
  },
  {
    "id": "s0092",
    "blockIndex": 22,
    "zh": "2秦燭壽免。"
  },
  {
    "id": "s0093",
    "blockIndex": 22,
    "zh": "魏冉復為丞相，封於穰與陶，謂之穰侯。"
  },
  {
    "id": "s0094",
    "blockIndex": 22,
    "zh": "又封公子市於宛，公子悝於鄧。"
  },
  {
    "id": "s0095",
    "blockIndex": 23,
    "zh": "1魏入河東地四百里、韓入武遂地二百里于秦。"
  },
  {
    "id": "s0096",
    "blockIndex": 24,
    "zh": "2魏芒卯始以詐見重。"
  },
  {
    "id": "s0097",
    "blockIndex": 25,
    "zh": "1秦大良造白起、客卿錯伐魏，至軹，取城大小六十一。"
  },
  {
    "id": "s0098",
    "blockIndex": 26,
    "zh": "1冬，十月，秦王稱西帝，遣使立齊王為東帝，欲約與共伐趙。"
  },
  {
    "id": "s0099",
    "blockIndex": 26,
    "zh": "蘇代自燕來，齊王曰：「秦使魏冉致帝，子以為何如？"
  },
  {
    "id": "s0100",
    "blockIndex": 26,
    "zh": "」對曰：「願王受之而勿稱也。"
  },
  {
    "id": "s0101",
    "blockIndex": 26,
    "zh": "秦稱之，天下安之，王乃稱之，無後也。"
  },
  {
    "id": "s0102",
    "blockIndex": 26,
    "zh": "秦稱之，天下惡之，王因勿稱，以收天下，此大資也。"
  },
  {
    "id": "s0103",
    "blockIndex": 26,
    "zh": "且伐趙孰與伐桀宋利？"
  },
  {
    "id": "s0104",
    "blockIndex": 26,
    "zh": "今王不如釋帝以收天下之望，發兵以伐桀宋，宋舉則楚、趙、梁、衛皆懼矣。"
  },
  {
    "id": "s0105",
    "blockIndex": 26,
    "zh": "是我以名尊秦而令天下憎之，所謂以卑為尊也。"
  },
  {
    "id": "s0106",
    "blockIndex": 26,
    "zh": "」齊王從之，稱帝二日而復歸之。"
  },
  {
    "id": "s0107",
    "blockIndex": 26,
    "zh": "十二月，呂禮自齊入秦，秦王亦去帝復稱王。"
  },
  {
    "id": "s0108",
    "blockIndex": 27,
    "zh": "2秦攻趙，拔杜陽。"
  },
  {
    "id": "s0109",
    "blockIndex": 28,
    "zh": "1秦攻〔魏〕("
  },
  {
    "id": "s0110",
    "blockIndex": 28,
    "zh": "趙)"
  },
  {
    "id": "s0111",
    "blockIndex": 28,
    "zh": "，拔新垣、曲陽<ref>秦攻〔魏〕("
  },
  {
    "id": "s0112",
    "blockIndex": 28,
    "zh": "趙)"
  },
  {
    "id": "s0113",
    "blockIndex": 28,
    "zh": "拔新垣曲陽章校「十二行本『趙』作『魏』；"
  },
  {
    "id": "s0114",
    "blockIndex": 28,
    "zh": "乙十一行本同；"
  },
  {
    "id": "s0115",
    "blockIndex": 28,
    "zh": "孔本同；"
  },
  {
    "id": "s0116",
    "blockIndex": 28,
    "zh": "張校同。"
  },
  {
    "id": "s0117",
    "blockIndex": 28,
    "zh": "」《史記·趙世家》同，據改。"
  },
  {
    "id": "s0118",
    "blockIndex": 28,
    "zh": "案：新垣、曲陽皆魏地，非趙地。"
  },
  {
    "id": "s0119",
    "blockIndex": 28,
    "zh": "</ref>。"
  },
  {
    "id": "s0120",
    "blockIndex": 29,
    "zh": "1秦司馬錯擊魏河內。"
  },
  {
    "id": "s0121",
    "blockIndex": 29,
    "zh": "魏獻安邑以和，秦出其人歸之魏。"
  },
  {
    "id": "s0122",
    "blockIndex": 30,
    "zh": "2秦敗韓師于夏山。"
  },
  {
    "id": "s0123",
    "blockIndex": 31,
    "zh": "3宋有雀生𪄟於城之陬。"
  },
  {
    "id": "s0124",
    "blockIndex": 31,
    "zh": "史占之，曰：「吉。"
  },
  {
    "id": "s0125",
    "blockIndex": 31,
    "zh": "小而生巨，必霸天下。"
  },
  {
    "id": "s0126",
    "blockIndex": 31,
    "zh": "」宋康王喜，起兵滅滕；"
  },
  {
    "id": "s0127",
    "blockIndex": 31,
    "zh": "伐薛；"
  },
  {
    "id": "s0128",
    "blockIndex": 31,
    "zh": "東敗齊，取五城；"
  },
  {
    "id": "s0129",
    "blockIndex": 31,
    "zh": "南敗楚，取地三百里，西敗魏軍。"
  },
  {
    "id": "s0130",
    "blockIndex": 31,
    "zh": "與齊、魏為敵國，乃愈自信其霸。"
  },
  {
    "id": "s0131",
    "blockIndex": 31,
    "zh": "欲霸之亟成，故射天笞地，斬社稷而焚滅之，以示威服鬼神。"
  },
  {
    "id": "s0132",
    "blockIndex": 31,
    "zh": "為長夜之飲於室中，室中人呼萬歲，則堂上之人應之，堂下之人又應之，門外之人又應之，以至於國中，無敢不呼萬歲者。"
  },
  {
    "id": "s0133",
    "blockIndex": 31,
    "zh": "天下之人謂之「桀宋」。"
  },
  {
    "id": "s0134",
    "blockIndex": 31,
    "zh": "齊湣王起兵伐之，民散，城不守。"
  },
  {
    "id": "s0135",
    "blockIndex": 31,
    "zh": "宋王奔魏，死於溫。"
  },
  {
    "id": "s0136",
    "blockIndex": 32,
    "zh": "1秦王會楚王於宛，會趙王於中陽。"
  },
  {
    "id": "s0137",
    "blockIndex": 33,
    "zh": "2秦蒙武擊齊，拔九城。"
  },
  {
    "id": "s0138",
    "blockIndex": 34,
    "zh": "3齊湣王既滅宋而驕，乃南侵楚，西侵三晉，欲并二周，為天子。"
  },
  {
    "id": "s0139",
    "blockIndex": 34,
    "zh": "狐咺正議，斫之檀衢，陳舉直言，殺之東閭。"
  },
  {
    "id": "s0140",
    "blockIndex": 35,
    "zh": "燕昭王日夜撫循其人，益為富實，乃與樂毅謀伐齊。"
  },
  {
    "id": "s0141",
    "blockIndex": 35,
    "zh": "樂毅曰：「齊，霸國之餘業也。"
  },
  {
    "id": "s0142",
    "blockIndex": 35,
    "zh": "地大人眾，未易獨攻也。"
  },
  {
    "id": "s0143",
    "blockIndex": 35,
    "zh": "王必欲伐之。"
  },
  {
    "id": "s0144",
    "blockIndex": 35,
    "zh": "莫如約趙及楚、魏。"
  },
  {
    "id": "s0145",
    "blockIndex": 35,
    "zh": "」於是使樂毅約趙，別使使者連楚、魏，且令趙啖秦以伐齊之利。"
  },
  {
    "id": "s0146",
    "blockIndex": 35,
    "zh": "諸侯害齊王之驕暴，皆爭合謀與燕伐齊。"
  },
  {
    "id": "s0147",
    "blockIndex": 36,
    "zh": "1燕王悉起兵，以樂毅為上將軍。"
  },
  {
    "id": "s0148",
    "blockIndex": 36,
    "zh": "秦尉斯離帥師與三晉之師會之。"
  },
  {
    "id": "s0149",
    "blockIndex": 36,
    "zh": "趙王以相國印授樂毅，樂毅並將秦、魏、韓、趙之兵以伐齊。"
  },
  {
    "id": "s0150",
    "blockIndex": 36,
    "zh": "齊湣王悉國中之眾以拒之，戰於濟西，齊師大敗。"
  },
  {
    "id": "s0151",
    "blockIndex": 36,
    "zh": "樂毅還秦、韓之師，分魏師以略宋地，部趙師以收河間，身率燕師，長驅逐北。"
  },
  {
    "id": "s0152",
    "blockIndex": 36,
    "zh": "劇辛曰：「齊大而燕小，賴諸侯之助以破其軍，宜及時攻取其邊城以自益，此長久之利也。"
  },
  {
    "id": "s0153",
    "blockIndex": 36,
    "zh": "今過而不攻，以深入為名，無損於齊，無益於燕，而結深怨，後必悔之。"
  },
  {
    "id": "s0154",
    "blockIndex": 36,
    "zh": "」樂毅曰：「齊王伐功矜能，謀不逮下，廢黜賢良，信任諂諛，政令戾虐，百姓怨懟。"
  },
  {
    "id": "s0155",
    "blockIndex": 36,
    "zh": "今軍皆破亡，若因而乘之，其民必叛，禍亂內作，則齊可圖也。"
  },
  {
    "id": "s0156",
    "blockIndex": 36,
    "zh": "若不遂乘之，待彼悔前之非，改過恤下而撫其民，則難慮也。"
  },
  {
    "id": "s0157",
    "blockIndex": 36,
    "zh": "」遂進軍深入。"
  },
  {
    "id": "s0158",
    "blockIndex": 36,
    "zh": "齊人果大亂失度，湣王出走。"
  },
  {
    "id": "s0159",
    "blockIndex": 36,
    "zh": "樂毅入臨淄，取寶物、祭器，輸之於燕。"
  },
  {
    "id": "s0160",
    "blockIndex": 36,
    "zh": "燕王親至濟上勞軍，行賞饗士，封樂毅為昌國君，遂使留徇齊城之未下者。"
  },
  {
    "id": "s0161",
    "blockIndex": 37,
    "zh": "齊王出亡之衛，衛君辟宮舍之，稱臣而共具。"
  },
  {
    "id": "s0162",
    "blockIndex": 37,
    "zh": "齊王不遜，衛人侵之。"
  },
  {
    "id": "s0163",
    "blockIndex": 37,
    "zh": "齊王去奔鄒、魯，有驕色，鄒、魯弗內，遂走莒。"
  },
  {
    "id": "s0164",
    "blockIndex": 37,
    "zh": "楚使淖齒將兵救齊，因為齊相。"
  },
  {
    "id": "s0165",
    "blockIndex": 37,
    "zh": "淖齒欲與燕分齊地，乃執湣王而數之曰：「千乘、博昌之間，方數百里，雨血沾衣，王知之乎？"
  },
  {
    "id": "s0166",
    "blockIndex": 37,
    "zh": "」曰：「知之。"
  },
  {
    "id": "s0167",
    "blockIndex": 37,
    "zh": "」「贏、博之間，地坼及泉，王知之乎？"
  },
  {
    "id": "s0168",
    "blockIndex": 37,
    "zh": "」曰：「知之。"
  },
  {
    "id": "s0169",
    "blockIndex": 37,
    "zh": "」「有人當闕而哭者，求之不得，去則聞其聲，王知之乎？"
  },
  {
    "id": "s0170",
    "blockIndex": 37,
    "zh": "」曰：「知之。"
  },
  {
    "id": "s0171",
    "blockIndex": 37,
    "zh": "」淖齒曰：「天雨血沾衣者，天以告也；"
  },
  {
    "id": "s0172",
    "blockIndex": 37,
    "zh": "地坼及泉者，地以告也；"
  },
  {
    "id": "s0173",
    "blockIndex": 37,
    "zh": "有人當闕而哭者，人以告也。"
  },
  {
    "id": "s0174",
    "blockIndex": 37,
    "zh": "天、地、人皆告矣，而王不知誡焉，何得無誅！"
  },
  {
    "id": "s0175",
    "blockIndex": 37,
    "zh": "」遂弒王於鼓里。"
  },
  {
    "id": "s0176",
    "blockIndex": 38,
    "zh": "荀子論之曰：國者，天下之利勢也。"
  },
  {
    "id": "s0177",
    "blockIndex": 38,
    "zh": "得道以持之，則大安也，大榮也，積美之源也。"
  },
  {
    "id": "s0178",
    "blockIndex": 38,
    "zh": "不得道以持之，則大危也，大累也，有之不如無之。"
  },
  {
    "id": "s0179",
    "blockIndex": 38,
    "zh": "及其綦也，索為匹夫，不可得也。"
  },
  {
    "id": "s0180",
    "blockIndex": 38,
    "zh": "齊湣、宋獻是也。"
  },
  {
    "id": "s0181",
    "blockIndex": 38,
    "zh": "故用國者義立而王，信立而霸，權謀立而亡。"
  },
  {
    "id": "s0182",
    "blockIndex": 39,
    "zh": "挈國以呼禮義也，而無以害之。"
  },
  {
    "id": "s0183",
    "blockIndex": 39,
    "zh": "行一不義，殺一無罪，而得天下，仁者不為也。"
  },
  {
    "id": "s0184",
    "blockIndex": 39,
    "zh": "擽然扶持心國，且若是其固也。"
  },
  {
    "id": "s0185",
    "blockIndex": 39,
    "zh": "之所與為之者之人，則舉義士也；"
  },
  {
    "id": "s0186",
    "blockIndex": 39,
    "zh": "之所以為布陳於國家刑法者，則舉義法也；"
  },
  {
    "id": "s0187",
    "blockIndex": 39,
    "zh": "主之所極然，帥群臣而首向之者，則舉義志也。"
  },
  {
    "id": "s0188",
    "blockIndex": 39,
    "zh": "如是，則下仰上以義矣，是〔綦〕("
  },
  {
    "id": "s0189",
    "blockIndex": 39,
    "zh": "基)"
  },
  {
    "id": "s0190",
    "blockIndex": 39,
    "zh": "定也<ref>是〔綦〕("
  },
  {
    "id": "s0191",
    "blockIndex": 39,
    "zh": "基)"
  },
  {
    "id": "s0192",
    "blockIndex": 39,
    "zh": "定也據《荀子·王霸篇》改，下同。"
  },
  {
    "id": "s0193",
    "blockIndex": 39,
    "zh": "「綦」，極也。"
  },
  {
    "id": "s0194",
    "blockIndex": 39,
    "zh": "</ref>。"
  },
  {
    "id": "s0195",
    "blockIndex": 39,
    "zh": "〔綦〕("
  },
  {
    "id": "s0196",
    "blockIndex": 39,
    "zh": "基)"
  },
  {
    "id": "s0197",
    "blockIndex": 39,
    "zh": "定而國定，國定而天下定。"
  },
  {
    "id": "s0198",
    "blockIndex": 39,
    "zh": "故曰：以國濟義，一日而白，湯、武是也。"
  },
  {
    "id": "s0199",
    "blockIndex": 39,
    "zh": "是所謂義立而王也。"
  },
  {
    "id": "s0200",
    "blockIndex": 40,
    "zh": "德雖未至也，義雖未濟也，然而天下之理略奏矣，刑賞已諾信乎天下矣，臣下曉然皆知其可要也。"
  },
  {
    "id": "s0201",
    "blockIndex": 40,
    "zh": "政令已陳，雖睹利敗，不欺其民；"
  },
  {
    "id": "s0202",
    "blockIndex": 40,
    "zh": "約結已定，雖睹利敗，不欺其與。"
  },
  {
    "id": "s0203",
    "blockIndex": 40,
    "zh": "如是，則兵勁城固，敵國畏之；"
  },
  {
    "id": "s0204",
    "blockIndex": 40,
    "zh": "國一綦明，與國信之。"
  },
  {
    "id": "s0205",
    "blockIndex": 40,
    "zh": "雖在僻陋之國，威動天下，五伯是也。"
  },
  {
    "id": "s0206",
    "blockIndex": 40,
    "zh": "是所謂信立而而霸也。"
  },
  {
    "id": "s0207",
    "blockIndex": 41,
    "zh": "挈國以呼功利，不務張其義，齊其信，唯利之求；"
  },
  {
    "id": "s0208",
    "blockIndex": 41,
    "zh": "內則不憚詐其民而求小利焉，外則不憚詐其與而求大利焉。"
  },
  {
    "id": "s0209",
    "blockIndex": 41,
    "zh": "內不修正其所以有，然常欲人之有，如是，則臣下百姓莫不以詐心待其上矣。"
  },
  {
    "id": "s0210",
    "blockIndex": 41,
    "zh": "上詐其下，下詐其上，則是上下析也。"
  },
  {
    "id": "s0211",
    "blockIndex": 41,
    "zh": "如是，則敵國輕之，與國疑之，權謀日行而國不免危削，綦之而亡，齊湣、薛公是也。"
  },
  {
    "id": "s0212",
    "blockIndex": 41,
    "zh": "故用強齊，非以修禮義也，非以本政教也，非以一天下也，綿綿常以結引馳外為務。"
  },
  {
    "id": "s0213",
    "blockIndex": 41,
    "zh": "故強，南足以破楚，西足以詘秦，北足以敗燕，中足以舉宋。"
  },
  {
    "id": "s0214",
    "blockIndex": 41,
    "zh": "及以燕、趙起而攻之，若振槁然，而身死國亡，為天下大戮，後世言惡則必稽焉。"
  },
  {
    "id": "s0215",
    "blockIndex": 41,
    "zh": "是無他故焉，唯其不由禮義而由權謀也。"
  },
  {
    "id": "s0216",
    "blockIndex": 42,
    "zh": "三者，明主之所謹擇也，仁人之所務白也。"
  },
  {
    "id": "s0217",
    "blockIndex": 42,
    "zh": "善擇者制人，不善擇者人制之。"
  },
  {
    "id": "s0218",
    "blockIndex": 43,
    "zh": "2樂毅聞〔畫〕("
  },
  {
    "id": "s0219",
    "blockIndex": 43,
    "zh": "晝)"
  },
  {
    "id": "s0220",
    "blockIndex": 43,
    "zh": "邑人王蠋賢<ref>樂毅聞〔畫〕("
  },
  {
    "id": "s0221",
    "blockIndex": 43,
    "zh": "晝)"
  },
  {
    "id": "s0222",
    "blockIndex": 43,
    "zh": "邑人王蠋賢章校「十二行本『晝』作『畫』；"
  },
  {
    "id": "s0223",
    "blockIndex": 43,
    "zh": "乙十一行本同；"
  },
  {
    "id": "s0224",
    "blockIndex": 43,
    "zh": "孔本同；"
  },
  {
    "id": "s0225",
    "blockIndex": 43,
    "zh": "下均同。"
  },
  {
    "id": "s0226",
    "blockIndex": 43,
    "zh": "」據改。"
  },
  {
    "id": "s0227",
    "blockIndex": 43,
    "zh": "</ref>，令軍中環〔畫〕("
  },
  {
    "id": "s0228",
    "blockIndex": 43,
    "zh": "晝)"
  },
  {
    "id": "s0229",
    "blockIndex": 43,
    "zh": "邑三十里無入。"
  },
  {
    "id": "s0230",
    "blockIndex": 43,
    "zh": "使人請蠋，蠋謝不往。"
  },
  {
    "id": "s0231",
    "blockIndex": 43,
    "zh": "燕人曰：「不來，吾且屠〔畫〕("
  },
  {
    "id": "s0232",
    "blockIndex": 43,
    "zh": "晝)"
  },
  {
    "id": "s0233",
    "blockIndex": 43,
    "zh": "邑！"
  },
  {
    "id": "s0234",
    "blockIndex": 43,
    "zh": "」蠋曰：「忠臣不事二君，烈女不更二夫。"
  },
  {
    "id": "s0235",
    "blockIndex": 43,
    "zh": "〔齊王不用吾諫，故退而耕於野〕<ref>〔齊王不用吾諫，故退而耕於野〕章校「十二行本『夫』下有『齊王不用吾諫故退而耕於野』十二字；"
  },
  {
    "id": "s0236",
    "blockIndex": 43,
    "zh": "乙十一行本同；"
  },
  {
    "id": "s0237",
    "blockIndex": 43,
    "zh": "孔本同；"
  },
  {
    "id": "s0238",
    "blockIndex": 43,
    "zh": "張校同；"
  },
  {
    "id": "s0239",
    "blockIndex": 43,
    "zh": "退齋校同。"
  },
  {
    "id": "s0240",
    "blockIndex": 43,
    "zh": "」據補。"
  },
  {
    "id": "s0241",
    "blockIndex": 43,
    "zh": "</ref>。"
  },
  {
    "id": "s0242",
    "blockIndex": 43,
    "zh": "國破君亡，吾不能存，而又欲劫之以兵，吾與其不義而生，不若死！"
  },
  {
    "id": "s0243",
    "blockIndex": 43,
    "zh": "」遂經其頸於樹枝，自奮絕脰而死。"
  },
  {
    "id": "s0244",
    "blockIndex": 43,
    "zh": "燕師乘勝長驅，齊城皆望風奔潰。"
  },
  {
    "id": "s0245",
    "blockIndex": 43,
    "zh": "樂毅修整燕軍，禁止侵掠，求齊之逸民，顯而禮之。"
  },
  {
    "id": "s0246",
    "blockIndex": 43,
    "zh": "寬其賦斂，除其暴令，修其舊政<ref>修其舊政章校「孔本『政』作『制』。"
  },
  {
    "id": "s0247",
    "blockIndex": 43,
    "zh": "」案：二字均可。"
  },
  {
    "id": "s0248",
    "blockIndex": 43,
    "zh": "</ref>，齊民喜悅。"
  },
  {
    "id": "s0249",
    "blockIndex": 43,
    "zh": "乃遣左軍渡膠東、東萊；"
  },
  {
    "id": "s0250",
    "blockIndex": 43,
    "zh": "前軍循太山以東至海，略琅邪；"
  },
  {
    "id": "s0251",
    "blockIndex": 43,
    "zh": "右軍循河、濟，屯阿、鄄以連魏師；"
  },
  {
    "id": "s0252",
    "blockIndex": 43,
    "zh": "後軍旁北海以撫千乘；"
  },
  {
    "id": "s0253",
    "blockIndex": 43,
    "zh": "中軍據臨淄而鎮齊都。"
  },
  {
    "id": "s0254",
    "blockIndex": 43,
    "zh": "祀桓公、管仲於郊，表賢者之閭，封王蠋之墓。"
  },
  {
    "id": "s0255",
    "blockIndex": 43,
    "zh": "齊人食邑於燕者二十餘君，有爵位於薊者百有餘人。"
  },
  {
    "id": "s0256",
    "blockIndex": 43,
    "zh": "六月之間，下齊七十餘城，皆為郡縣。"
  },
  {
    "id": "s0257",
    "blockIndex": 44,
    "zh": "3秦王、魏王、韓王會于京師。"
  },
  {
    "id": "s0258",
    "blockIndex": 45,
    "zh": "1秦、趙會于穰。"
  },
  {
    "id": "s0259",
    "blockIndex": 45,
    "zh": "秦拔魏安城，兵至大梁而還。"
  },
  {
    "id": "s0260",
    "blockIndex": 46,
    "zh": "2齊淖齒之亂，湣王子法章變名姓為莒太史敫家傭。"
  },
  {
    "id": "s0261",
    "blockIndex": 46,
    "zh": "太史敫女奇法章狀貌，以為非常人，憐而常竊衣食之，因與私通。"
  },
  {
    "id": "s0262",
    "blockIndex": 46,
    "zh": "王孫賈從湣王，失王之處，其母曰：「汝朝出而晚來，則吾倚門而望；"
  },
  {
    "id": "s0263",
    "blockIndex": 46,
    "zh": "汝暮出而不還，則吾倚閭而望。"
  },
  {
    "id": "s0264",
    "blockIndex": 46,
    "zh": "汝今事王，王走，汝不知其處，汝尚何歸焉！"
  },
  {
    "id": "s0265",
    "blockIndex": 46,
    "zh": "」王孫賈乃入市中呼曰：「淖齒亂齊國，殺湣王。"
  },
  {
    "id": "s0266",
    "blockIndex": 46,
    "zh": "欲與我誅之者袒右！"
  },
  {
    "id": "s0267",
    "blockIndex": 46,
    "zh": "」市人從者四百人，與攻淖齒，殺之。"
  },
  {
    "id": "s0268",
    "blockIndex": 46,
    "zh": "於是齊亡臣相與求湣王子，欲立之。"
  },
  {
    "id": "s0269",
    "blockIndex": 46,
    "zh": "法章懼其誅己，久之乃敢自言，遂立以為齊王，保莒城以拒燕，佈告國中曰：「王已立在莒矣！"
  },
  {
    "id": "s0271",
    "blockIndex": 47,
    "zh": "3趙王得楚和氏璧，秦昭王欲之，請易以十五城。"
  },
  {
    "id": "s0272",
    "blockIndex": 47,
    "zh": "趙王欲勿與，畏秦強，欲與之，恐見欺。"
  },
  {
    "id": "s0273",
    "blockIndex": 47,
    "zh": "以問藺相如，對曰：「秦以城求璧而王不許，曲在我矣；"
  },
  {
    "id": "s0274",
    "blockIndex": 47,
    "zh": "我與之璧而秦不與我城，則曲在秦。"
  },
  {
    "id": "s0275",
    "blockIndex": 47,
    "zh": "均之二策，寧許以負秦。"
  },
  {
    "id": "s0276",
    "blockIndex": 47,
    "zh": "臣願奉璧而往；"
  },
  {
    "id": "s0277",
    "blockIndex": 47,
    "zh": "使秦城不入，臣請完璧而歸之。"
  },
  {
    "id": "s0278",
    "blockIndex": 47,
    "zh": "」趙王遣之。"
  },
  {
    "id": "s0279",
    "blockIndex": 47,
    "zh": "相如至秦，秦王無意償趙城。"
  },
  {
    "id": "s0280",
    "blockIndex": 47,
    "zh": "相如乃以詐紿秦王，復取璧，遣從者懷之，間行歸趙，而以身待命於秦。"
  },
  {
    "id": "s0281",
    "blockIndex": 47,
    "zh": "秦王以為賢而弗誅，禮而歸之。"
  },
  {
    "id": "s0282",
    "blockIndex": 47,
    "zh": "趙王以相如為上大夫。"
  },
  {
    "id": "s0283",
    "blockIndex": 48,
    "zh": "4衛嗣君薨，子懷君立。"
  },
  {
    "id": "s0284",
    "blockIndex": 48,
    "zh": "嗣君好察微隱，縣令有發褥而席敝者，嗣君聞之，乃賜之席。"
  },
  {
    "id": "s0285",
    "blockIndex": 48,
    "zh": "令大驚，以君為神。"
  },
  {
    "id": "s0286",
    "blockIndex": 48,
    "zh": "又使人過關市，賂之以金，既而召關市，問有客過與汝金，汝回遣之，關市大恐。"
  },
  {
    "id": "s0287",
    "blockIndex": 48,
    "zh": "又愛洩姬，重如耳，而恐其因愛重以壅己也，乃貴薄疑以敵如耳，尊魏妃以偶泄姬，曰：「以是相參也。"
  },
  {
    "id": "s0289",
    "blockIndex": 49,
    "zh": "荀子論之曰：成侯、嗣君，聚斂計數之君也，未及取民也。"
  },
  {
    "id": "s0290",
    "blockIndex": 49,
    "zh": "子產，取民者也，未及為政也。"
  },
  {
    "id": "s0291",
    "blockIndex": 49,
    "zh": "管仲，為政者也，未及修禮也。"
  },
  {
    "id": "s0292",
    "blockIndex": 49,
    "zh": "故修禮者王，為政者強，取民者安，聚斂者亡。"
  },
  {
    "id": "s0293",
    "blockIndex": 50,
    "zh": "1秦伐趙，拔兩城。"
  },
  {
    "id": "s0294",
    "blockIndex": 51,
    "zh": "1秦伐趙，拔石城。"
  },
  {
    "id": "s0295",
    "blockIndex": 52,
    "zh": "2秦穰侯復為丞相。"
  },
  {
    "id": "s0296",
    "blockIndex": 53,
    "zh": "3楚欲與齊、韓共伐秦，因欲圖周。"
  },
  {
    "id": "s0297",
    "blockIndex": 53,
    "zh": "王使東周武公謂楚令尹昭子曰：「周不可圖也。"
  },
  {
    "id": "s0298",
    "blockIndex": 53,
    "zh": "」昭子曰：「乃圖周，則無之；"
  },
  {
    "id": "s0299",
    "blockIndex": 53,
    "zh": "雖然，何不可圖？"
  },
  {
    "id": "s0300",
    "blockIndex": 53,
    "zh": "」武公曰：「西周之地，絕長補短，不過百里。"
  },
  {
    "id": "s0301",
    "blockIndex": 53,
    "zh": "名為天下共主，裂其地不足以肥國，得其眾不足以勁兵。"
  },
  {
    "id": "s0302",
    "blockIndex": 53,
    "zh": "雖然，攻之者名為弒君。"
  },
  {
    "id": "s0303",
    "blockIndex": 53,
    "zh": "然而猶有欲攻之者，見祭器在焉故也。"
  },
  {
    "id": "s0304",
    "blockIndex": 53,
    "zh": "夫虎肉臊而兵利身，人猶攻之；"
  },
  {
    "id": "s0305",
    "blockIndex": 53,
    "zh": "若使澤中之麋蒙虎之皮，人之攻之也必萬倍矣。"
  },
  {
    "id": "s0306",
    "blockIndex": 53,
    "zh": "裂楚之地，足以肥國；"
  },
  {
    "id": "s0307",
    "blockIndex": 53,
    "zh": "詘楚之名，足以尊〔主〕("
  },
  {
    "id": "s0308",
    "blockIndex": 53,
    "zh": "王)"
  },
  {
    "id": "s0309",
    "blockIndex": 53,
    "zh": "<ref>足以尊〔主〕("
  },
  {
    "id": "s0310",
    "blockIndex": 53,
    "zh": "王)"
  },
  {
    "id": "s0311",
    "blockIndex": 53,
    "zh": "章校「十二行本『王』作『主』；"
  },
  {
    "id": "s0312",
    "blockIndex": 53,
    "zh": "乙十一行本同；"
  },
  {
    "id": "s0313",
    "blockIndex": 53,
    "zh": "孔本同；"
  },
  {
    "id": "s0314",
    "blockIndex": 53,
    "zh": "退齋校同。"
  },
  {
    "id": "s0315",
    "blockIndex": 53,
    "zh": "」據改。"
  },
  {
    "id": "s0316",
    "blockIndex": 53,
    "zh": "</ref>。"
  },
  {
    "id": "s0317",
    "blockIndex": 53,
    "zh": "今子欲誅殘天下之共主，居三代之傳器，器南，則兵至矣。"
  },
  {
    "id": "s0318",
    "blockIndex": 53,
    "zh": "」於是楚計輟不行。"
  },
  {
    "id": "s0319",
    "blockIndex": 54,
    "zh": "1秦白起敗趙軍，斬首二萬，取代光狼城。"
  },
  {
    "id": "s0320",
    "blockIndex": 54,
    "zh": "又使司馬錯發隴西兵，因蜀攻楚黔中，拔之。"
  },
  {
    "id": "s0321",
    "blockIndex": 54,
    "zh": "楚獻漢北及上庸地。"
  },
  {
    "id": "s0322",
    "blockIndex": 55,
    "zh": "1秦白起伐楚，取鄢、鄧、西陵。"
  },
  {
    "id": "s0323",
    "blockIndex": 56,
    "zh": "2秦王使使者告趙王，願為好會於河外澠池。"
  },
  {
    "id": "s0324",
    "blockIndex": 56,
    "zh": "趙王欲毋行，廉頗、藺相如計曰：「王不行，示趙弱且怯也。"
  },
  {
    "id": "s0325",
    "blockIndex": 56,
    "zh": "」趙王遂行，相如從。"
  },
  {
    "id": "s0326",
    "blockIndex": 56,
    "zh": "廉頗送至境，與王訣曰：「王行，度道里會遇之禮畢，還，不過三十日。"
  },
  {
    "id": "s0327",
    "blockIndex": 56,
    "zh": "三十日不還，則請立太子，以絕秦望。"
  },
  {
    "id": "s0328",
    "blockIndex": 56,
    "zh": "」王許之。"
  },
  {
    "id": "s0329",
    "blockIndex": 57,
    "zh": "會于澠池。"
  },
  {
    "id": "s0330",
    "blockIndex": 57,
    "zh": "〔秦〕王與趙王飲<ref>〔秦〕王與趙王飲據胡注補。"
  },
  {
    "id": "s0331",
    "blockIndex": 57,
    "zh": "</ref>，酒酣，秦王請趙王鼓瑟，趙王鼓之。"
  },
  {
    "id": "s0332",
    "blockIndex": 57,
    "zh": "藺相如復請秦王擊缶，秦王不肯。"
  },
  {
    "id": "s0333",
    "blockIndex": 57,
    "zh": "相如曰：「五步之內，臣請得以頸血濺大王矣！"
  },
  {
    "id": "s0334",
    "blockIndex": 57,
    "zh": "」左右欲刃相如，相如張目叱之，左右皆靡。"
  },
  {
    "id": "s0335",
    "blockIndex": 57,
    "zh": "王不懌，為一擊缶。"
  },
  {
    "id": "s0336",
    "blockIndex": 57,
    "zh": "罷酒，秦終不能有加於趙。"
  },
  {
    "id": "s0337",
    "blockIndex": 57,
    "zh": "趙人亦盛為之備，秦不敢動。"
  },
  {
    "id": "s0338",
    "blockIndex": 58,
    "zh": "趙王歸國，以藺相如為上卿，位在廉頗之右。"
  },
  {
    "id": "s0339",
    "blockIndex": 58,
    "zh": "廉頗曰：「我為趙將，有攻城野戰之功。"
  },
  {
    "id": "s0340",
    "blockIndex": 58,
    "zh": "藺相如素賤人，徒以口舌而位居我上。"
  },
  {
    "id": "s0341",
    "blockIndex": 58,
    "zh": "吾羞，不忍為之下！"
  },
  {
    "id": "s0342",
    "blockIndex": 58,
    "zh": "」宣言曰：「我見相如，必辱之！"
  },
  {
    "id": "s0343",
    "blockIndex": 58,
    "zh": "」相如聞之，不肯與會；"
  },
  {
    "id": "s0344",
    "blockIndex": 58,
    "zh": "每朝，常稱病，不欲爭列。"
  },
  {
    "id": "s0345",
    "blockIndex": 58,
    "zh": "出而望見，輒引車避匿。"
  },
  {
    "id": "s0346",
    "blockIndex": 58,
    "zh": "其舍人皆以為恥。"
  },
  {
    "id": "s0347",
    "blockIndex": 58,
    "zh": "相如曰：「子視廉將軍孰與秦王？"
  },
  {
    "id": "s0348",
    "blockIndex": 58,
    "zh": "」曰：「不若。"
  },
  {
    "id": "s0349",
    "blockIndex": 58,
    "zh": "」相如曰：「夫以秦王之威而相如廷叱之，辱其群臣。"
  },
  {
    "id": "s0350",
    "blockIndex": 58,
    "zh": "相如雖駑，獨畏廉將軍哉！"
  },
  {
    "id": "s0351",
    "blockIndex": 58,
    "zh": "顧吾念之，強秦〔之〕所以不敢加兵於趙者<ref>強秦〔之〕所以不敢加兵於趙者章校「十二行本『所』上有『之』字；"
  },
  {
    "id": "s0352",
    "blockIndex": 58,
    "zh": "乙十一行本同；"
  },
  {
    "id": "s0353",
    "blockIndex": 58,
    "zh": "孔本同。"
  },
  {
    "id": "s0354",
    "blockIndex": 58,
    "zh": "」《史記·廉頗藺相如列傳》有，據補。"
  },
  {
    "id": "s0355",
    "blockIndex": 58,
    "zh": "</ref>，徒以吾兩人在也。"
  },
  {
    "id": "s0356",
    "blockIndex": 58,
    "zh": "今兩虎共斗，其勢不俱生。"
  },
  {
    "id": "s0357",
    "blockIndex": 58,
    "zh": "吾所以為此者，先國家之急而後私仇也。"
  },
  {
    "id": "s0358",
    "blockIndex": 58,
    "zh": "」廉頗聞之，肉袒負荊至門射罪，遂為刎頸之交。"
  },
  {
    "id": "s0359",
    "blockIndex": 59,
    "zh": "3初，燕人攻安平，臨淄市掾田單在安平，使其宗人皆以鐵籠傅車槥。"
  },
  {
    "id": "s0360",
    "blockIndex": 59,
    "zh": "及城潰，人爭門而出，皆以轊折車敗，為燕所禽；"
  },
  {
    "id": "s0361",
    "blockIndex": 59,
    "zh": "獨田單宗人以鐵籠得免，遂奔即墨。"
  },
  {
    "id": "s0362",
    "blockIndex": 59,
    "zh": "是時齊地皆屬燕，獨莒、即墨未下，樂毅及並右軍、前軍以圍莒，左軍、後軍圍即墨。"
  },
  {
    "id": "s0363",
    "blockIndex": 59,
    "zh": "即墨大夫出戰而死。"
  },
  {
    "id": "s0364",
    "blockIndex": 59,
    "zh": "即墨人曰：「安平之戰，田單宗人以鐵籠得全，是多智習兵。"
  },
  {
    "id": "s0365",
    "blockIndex": 59,
    "zh": "」因共立以為將以拒燕。"
  },
  {
    "id": "s0366",
    "blockIndex": 59,
    "zh": "樂毅圍二邑，期年不克，及令解圍，各去城九里而為壘，令曰：「城中民出者勿獲，困者賑之，使即舊業，以鎮新民。"
  },
  {
    "id": "s0367",
    "blockIndex": 59,
    "zh": "」三年而猶未下。"
  },
  {
    "id": "s0368",
    "blockIndex": 59,
    "zh": "或讒之於燕昭王曰：「樂毅智謀過人，伐齊，呼吸之間剋七十餘城。"
  },
  {
    "id": "s0369",
    "blockIndex": 59,
    "zh": "今不下者兩城耳，非其力不能拔，所以三年不攻者，欲久仗兵威以服齊人，南面而王耳。"
  },
  {
    "id": "s0370",
    "blockIndex": 59,
    "zh": "今齊人已服，所以未發者，以其妻子在燕故也。"
  },
  {
    "id": "s0371",
    "blockIndex": 59,
    "zh": "且齊多美女，又將忘其妻子。"
  },
  {
    "id": "s0372",
    "blockIndex": 59,
    "zh": "願王圖之！"
  },
  {
    "id": "s0373",
    "blockIndex": 59,
    "zh": "」昭王於是置酒大會，引言者而讓之曰：「先王舉國以禮賢者，非貪土地以遺子孫也。"
  },
  {
    "id": "s0374",
    "blockIndex": 59,
    "zh": "遭所傳德薄，不能堪命，國人不順。"
  },
  {
    "id": "s0375",
    "blockIndex": 59,
    "zh": "齊為無道，乘孤國之亂以害先王。"
  },
  {
    "id": "s0376",
    "blockIndex": 59,
    "zh": "寡人統位，痛之入骨，故廣延群臣，外招賓客，以求報仇。"
  },
  {
    "id": "s0377",
    "blockIndex": 59,
    "zh": "其有成功者，尚欲與之同共燕國。"
  },
  {
    "id": "s0378",
    "blockIndex": 59,
    "zh": "今樂君親為寡人破齊，夷其宗廟，報塞先仇，齊國固樂君所有，非燕之所得也。"
  },
  {
    "id": "s0379",
    "blockIndex": 59,
    "zh": "樂君若能有齊，與燕並為列國，結歡同好，以抗諸侯之難，燕國之福，寡人之願也。"
  },
  {
    "id": "s0380",
    "blockIndex": 59,
    "zh": "汝何敢言若此！"
  },
  {
    "id": "s0381",
    "blockIndex": 59,
    "zh": "」乃斬之。"
  },
  {
    "id": "s0382",
    "blockIndex": 59,
    "zh": "賜樂毅妻以後服，賜其子以公子之服；"
  },
  {
    "id": "s0383",
    "blockIndex": 59,
    "zh": "輅車乘馬，後屬百兩，遣國相奉而致之樂毅，立樂毅為齊王。"
  },
  {
    "id": "s0384",
    "blockIndex": 59,
    "zh": "樂毅惶恐不受，拜書，以死自誓。"
  },
  {
    "id": "s0385",
    "blockIndex": 59,
    "zh": "由是齊人服其義，諸侯畏其信，莫敢復有謀者。"
  },
  {
    "id": "s0386",
    "blockIndex": 60,
    "zh": "頃之，昭王薨，惠王立。"
  },
  {
    "id": "s0387",
    "blockIndex": 60,
    "zh": "惠王自為太子時，嘗不快於樂毅。"
  },
  {
    "id": "s0388",
    "blockIndex": 60,
    "zh": "田單聞之，乃縱反間於燕，宣言曰：「齊王已死，城之不拔者二耳。"
  },
  {
    "id": "s0389",
    "blockIndex": 60,
    "zh": "樂毅與燕新王有隙，畏誅而不敢歸，以伐齊為名，實欲連兵南面王齊。"
  },
  {
    "id": "s0390",
    "blockIndex": 60,
    "zh": "齊人未附，故且緩攻即墨以待其事。"
  },
  {
    "id": "s0391",
    "blockIndex": 60,
    "zh": "齊人所懼，唯恐他將之來，即墨殘矣。"
  },
  {
    "id": "s0392",
    "blockIndex": 60,
    "zh": "」燕王固已疑樂毅，得齊反間，乃使騎劫代將而召樂毅。"
  },
  {
    "id": "s0393",
    "blockIndex": 60,
    "zh": "樂毅知王不善代之，遂奔趙。"
  },
  {
    "id": "s0394",
    "blockIndex": 60,
    "zh": "燕將士由是憤惋不和。"
  },
  {
    "id": "s0395",
    "blockIndex": 61,
    "zh": "田單令城中人，食必祭其先祖於庭，飛鳥皆翔舞而下城中。"
  },
  {
    "id": "s0396",
    "blockIndex": 61,
    "zh": "燕人怪之，田單因宣言曰：「當有神師下教我。"
  },
  {
    "id": "s0397",
    "blockIndex": 61,
    "zh": "」有一卒曰：「臣可以為師乎？"
  },
  {
    "id": "s0398",
    "blockIndex": 61,
    "zh": "」因反走。"
  },
  {
    "id": "s0399",
    "blockIndex": 61,
    "zh": "田單起引還，坐東鄉，師事之。"
  },
  {
    "id": "s0400",
    "blockIndex": 61,
    "zh": "卒曰：「臣欺君。"
  },
  {
    "id": "s0401",
    "blockIndex": 61,
    "zh": "」田單曰：「子勿言也。"
  },
  {
    "id": "s0402",
    "blockIndex": 61,
    "zh": "」因師之，每出約束，必稱神師。"
  },
  {
    "id": "s0403",
    "blockIndex": 61,
    "zh": "乃宣言曰：「吾唯懼燕軍之劓所得齊卒，置之前行，即墨敗矣！"
  },
  {
    "id": "s0404",
    "blockIndex": 61,
    "zh": "」燕人聞之，如其言。"
  },
  {
    "id": "s0405",
    "blockIndex": 61,
    "zh": "城中見降者盡劓，皆怒，堅守，唯恐見得。"
  },
  {
    "id": "s0406",
    "blockIndex": 61,
    "zh": "單又縱反間，言：「吾懼燕人掘吾城外塚墓，可為寒心！"
  },
  {
    "id": "s0407",
    "blockIndex": 61,
    "zh": "」燕軍盡掘塚墓，燒死人。"
  },
  {
    "id": "s0408",
    "blockIndex": 61,
    "zh": "齊人從城上望見，皆涕泣，共欲出戰，怒自十倍。"
  },
  {
    "id": "s0409",
    "blockIndex": 61,
    "zh": "田單知士卒之可用，乃身操版、鍤，與士卒分功；"
  },
  {
    "id": "s0410",
    "blockIndex": 61,
    "zh": "妻妾編於行伍之間；"
  },
  {
    "id": "s0411",
    "blockIndex": 61,
    "zh": "盡散飲食饗士。"
  },
  {
    "id": "s0412",
    "blockIndex": 61,
    "zh": "令甲卒皆伏，使老、弱、女子乘城，遣使約降於燕，燕軍皆呼萬歲。"
  },
  {
    "id": "s0413",
    "blockIndex": 61,
    "zh": "田單又收民金得千鎰，令即墨富豪遺燕將，曰：「即降，願無虜掠吾族家。"
  },
  {
    "id": "s0414",
    "blockIndex": 61,
    "zh": "」燕將大喜，許之。"
  },
  {
    "id": "s0415",
    "blockIndex": 61,
    "zh": "燕軍益懈。"
  },
  {
    "id": "s0416",
    "blockIndex": 61,
    "zh": "田單乃收城中，得牛千餘，為絳繒衣，畫以五采龍文，束兵刃於其角，而灌脂束葦於其尾，燒其端，鑿城數十穴，夜縱牛，壯士五千〔人〕隨其後<ref>壯士五千〔人〕隨其後據《史記·田單列傳》補。"
  },
  {
    "id": "s0417",
    "blockIndex": 61,
    "zh": "</ref>。"
  },
  {
    "id": "s0418",
    "blockIndex": 61,
    "zh": "牛尾熱，怒而奔燕軍。"
  },
  {
    "id": "s0419",
    "blockIndex": 61,
    "zh": "燕軍大驚，視牛皆龍文，所觸盡死傷。"
  },
  {
    "id": "s0420",
    "blockIndex": 61,
    "zh": "而城中鼓噪從之，老弱皆擊銅器為聲，聲動天地。"
  },
  {
    "id": "s0421",
    "blockIndex": 61,
    "zh": "燕軍大駭，敗走。"
  },
  {
    "id": "s0422",
    "blockIndex": 61,
    "zh": "齊人殺騎劫，追亡逐北，所過城邑皆叛燕，復為齊。"
  },
  {
    "id": "s0423",
    "blockIndex": 61,
    "zh": "田單兵日益多，乘勝，燕日敗亡，走至河上，而齊七十餘城皆復焉。"
  },
  {
    "id": "s0424",
    "blockIndex": 61,
    "zh": "乃迎襄王於莒。"
  },
  {
    "id": "s0425",
    "blockIndex": 61,
    "zh": "入臨淄，封田單為安平君。"
  },
  {
    "id": "s0426",
    "blockIndex": 62,
    "zh": "齊王以太史敫之女為後，生太子建。"
  },
  {
    "id": "s0427",
    "blockIndex": 62,
    "zh": "太史敫曰：「女不取媒，因自嫁，非吾種也，汙吾世！"
  },
  {
    "id": "s0428",
    "blockIndex": 62,
    "zh": "」終身不見君王后，君王后亦不以不見故失人子之禮。"
  },
  {
    "id": "s0429",
    "blockIndex": 63,
    "zh": "趙王封樂毅於觀津，尊寵之，以警動於燕、齊。"
  },
  {
    "id": "s0430",
    "blockIndex": 63,
    "zh": "燕惠王乃使人讓樂毅，且謝之曰：「將軍過聽，以與寡人有隙，遂捐燕歸趙。"
  },
  {
    "id": "s0431",
    "blockIndex": 63,
    "zh": "將軍自為計則可矣，而亦何以報先王這所以遇將軍之意乎？"
  },
  {
    "id": "s0432",
    "blockIndex": 63,
    "zh": "」樂毅報書曰：「昔伍子胥說聽於闔閭而吳遠跡至郢；"
  },
  {
    "id": "s0433",
    "blockIndex": 63,
    "zh": "夫差弗是也，賜之鴟夷而浮之江。"
  },
  {
    "id": "s0434",
    "blockIndex": 63,
    "zh": "吳王不寤先論之可以立功，故沈子胥而不悔；"
  },
  {
    "id": "s0435",
    "blockIndex": 63,
    "zh": "子胥不蚤見主之不同量，是以至於入江而不化。"
  },
  {
    "id": "s0436",
    "blockIndex": 63,
    "zh": "夫免自立功以明先王之跡，臣之上計也。"
  },
  {
    "id": "s0437",
    "blockIndex": 63,
    "zh": "離毀辱之誹謗，墮先王之名，臣之所大恐也。"
  },
  {
    "id": "s0438",
    "blockIndex": 63,
    "zh": "臨不測之罪，以幸為利，義之所不敢出也。"
  },
  {
    "id": "s0439",
    "blockIndex": 63,
    "zh": "臣聞古之君子，交絕不出惡聲，忠臣去國，不潔其名。"
  },
  {
    "id": "s0440",
    "blockIndex": 63,
    "zh": "臣雖不佞，數奉教於君子矣。"
  },
  {
    "id": "s0441",
    "blockIndex": 63,
    "zh": "唯君王之留意焉！"
  },
  {
    "id": "s0442",
    "blockIndex": 63,
    "zh": "」於是燕王復以樂毅子閒為昌國君，而樂毅往來復通燕，卒於趙，號曰望諸君。"
  },
  {
    "id": "s0443",
    "blockIndex": 64,
    "zh": "田單相齊，過淄水，有老人涉淄而寒，出水不能行。"
  },
  {
    "id": "s0444",
    "blockIndex": 64,
    "zh": "田單解其裘而衣之。"
  },
  {
    "id": "s0445",
    "blockIndex": 64,
    "zh": "襄王惡之，曰：「田單之施於人，將〔欲〕以取我國乎<ref>將〔欲〕以取我國乎據《史記·田單列傳》補。"
  },
  {
    "id": "s0446",
    "blockIndex": 64,
    "zh": "</ref>？"
  },
  {
    "id": "s0447",
    "blockIndex": 64,
    "zh": "不早圖，恐後之變也。"
  },
  {
    "id": "s0448",
    "blockIndex": 64,
    "zh": "」左右顧無人，巖下有貫珠者，襄王呼而問之曰：「汝聞吾言乎？"
  },
  {
    "id": "s0449",
    "blockIndex": 64,
    "zh": "」對曰：「聞之。"
  },
  {
    "id": "s0450",
    "blockIndex": 64,
    "zh": "」王曰：「汝以為何如？"
  },
  {
    "id": "s0451",
    "blockIndex": 64,
    "zh": "」對曰：「王不如因以為己善。"
  },
  {
    "id": "s0452",
    "blockIndex": 64,
    "zh": "王嘉單之善，下令曰：『寡人憂民之飢也，單收而食之；"
  },
  {
    "id": "s0453",
    "blockIndex": 64,
    "zh": "寡人憂民之寒也，單解裘而衣之；"
  },
  {
    "id": "s0454",
    "blockIndex": 64,
    "zh": "寡人憂勞百姓，而單亦憂〔之〕<ref>而單亦憂〔之〕據《史記·田單列傳》補。"
  },
  {
    "id": "s0455",
    "blockIndex": 64,
    "zh": "</ref>，稱寡人之意。"
  },
  {
    "id": "s0456",
    "blockIndex": 64,
    "zh": "』單有是善而王嘉之，單之善亦王之善也。"
  },
  {
    "id": "s0457",
    "blockIndex": 64,
    "zh": "」王曰：「善。"
  },
  {
    "id": "s0458",
    "blockIndex": 64,
    "zh": "」乃賜單牛酒。"
  },
  {
    "id": "s0459",
    "blockIndex": 64,
    "zh": "後數日，貫珠者復見王曰：「王朝日宜召田單而揖之於庭，口勞之。"
  },
  {
    "id": "s0460",
    "blockIndex": 64,
    "zh": "乃布令求百姓之饑寒者，收穀之。"
  },
  {
    "id": "s0461",
    "blockIndex": 64,
    "zh": "」乃使人聽於閭里，聞大夫之相與語者曰：「田單之愛人，嗟，乃王之教也！"
  },
  {
    "id": "s0463",
    "blockIndex": 65,
    "zh": "田單任貂勃於王。"
  },
  {
    "id": "s0464",
    "blockIndex": 65,
    "zh": "王有所幸臣九人，欲傷安平君，相與語於王曰：「燕之伐齊之時，楚王使將軍將萬人而佐齊。"
  },
  {
    "id": "s0465",
    "blockIndex": 65,
    "zh": "今國已定而社稷已安矣，何不使使者謝於楚王？"
  },
  {
    "id": "s0466",
    "blockIndex": 65,
    "zh": "」王曰：「左右孰可？"
  },
  {
    "id": "s0467",
    "blockIndex": 65,
    "zh": "」九人之屬曰：「貂勃可。"
  },
  {
    "id": "s0468",
    "blockIndex": 65,
    "zh": "」貂勃使楚，楚王受而觴之，數月不反。"
  },
  {
    "id": "s0469",
    "blockIndex": 65,
    "zh": "九人之屬相與語〔於王〕曰<ref>九人之屬相與語〔於王〕曰據《史記·田單列傳》補。"
  },
  {
    "id": "s0470",
    "blockIndex": 65,
    "zh": "</ref>：「夫一人之身而牽留萬乘者，豈不以據勢也哉！"
  },
  {
    "id": "s0471",
    "blockIndex": 65,
    "zh": "且安平君之與王也，君臣無異而上下無別。"
  },
  {
    "id": "s0472",
    "blockIndex": 65,
    "zh": "且其志欲為不善，內撫百姓，外懷戎翟，禮天下之賢士，其志欲有為〔也〕，願王察之<ref>其志欲有為〔也〕願王察之章校「十二行本『為』下有『也』字，『王』下有『之』字；"
  },
  {
    "id": "s0473",
    "blockIndex": 65,
    "zh": "乙十一行本同；"
  },
  {
    "id": "s0474",
    "blockIndex": 65,
    "zh": "孔本同；"
  },
  {
    "id": "s0475",
    "blockIndex": 65,
    "zh": "退齋校云：『為』下有『也』字。"
  },
  {
    "id": "s0476",
    "blockIndex": 65,
    "zh": "」今據補「也」，「之」字不補亦通。"
  },
  {
    "id": "s0477",
    "blockIndex": 65,
    "zh": "</ref>！"
  },
  {
    "id": "s0478",
    "blockIndex": 65,
    "zh": "」異日，王曰：「召相單而來！"
  },
  {
    "id": "s0479",
    "blockIndex": 65,
    "zh": "」田單免冠、徒跣、肉袒而進，退而請死罪，五日而王曰：「子無罪於寡人。"
  },
  {
    "id": "s0480",
    "blockIndex": 65,
    "zh": "子為子之臣禮，吾為吾之王禮而已矣。"
  },
  {
    "id": "s0481",
    "blockIndex": 65,
    "zh": "」貂勃從楚來，王賜之酒。"
  },
  {
    "id": "s0482",
    "blockIndex": 65,
    "zh": "酒酣，王曰：「召相單而來！"
  },
  {
    "id": "s0483",
    "blockIndex": 65,
    "zh": "」貂勃避席稽首曰：「王上者孰與周文王？"
  },
  {
    "id": "s0484",
    "blockIndex": 65,
    "zh": "」王曰：「吾不若也。"
  },
  {
    "id": "s0485",
    "blockIndex": 65,
    "zh": "」貂勃曰：「然，臣固知王不若也。"
  },
  {
    "id": "s0486",
    "blockIndex": 65,
    "zh": "下者孰與齊桓公？"
  },
  {
    "id": "s0487",
    "blockIndex": 65,
    "zh": "」王曰：「吾不若也。"
  },
  {
    "id": "s0488",
    "blockIndex": 65,
    "zh": "」貂勃曰：「然，臣固知王不若也。"
  },
  {
    "id": "s0489",
    "blockIndex": 65,
    "zh": "然則周文王得呂尚以為太公，齊桓公得管夷吾以為仲父，今王得安平君而獨曰『單』，安得此亡國之言乎！"
  },
  {
    "id": "s0490",
    "blockIndex": 65,
    "zh": "且自天地之辟，民人之始，為人臣之功者，誰有厚於安平君者哉？"
  },
  {
    "id": "s0491",
    "blockIndex": 65,
    "zh": "王不能守王之社稷，燕人興師而襲齊，王走而之城陽之山中，安平君以惴惴即墨三里之城，五里之郭，敝卒七千人，禽其司馬而反千里之齊，安平君之功也。"
  },
  {
    "id": "s0492",
    "blockIndex": 65,
    "zh": "當是之時，舍城陽而自王，天下莫之能止。"
  },
  {
    "id": "s0493",
    "blockIndex": 65,
    "zh": "然而計之於道，歸之於義，以為不可，故棧道木閣而迎王與后於城陽山中，王乃得反，子臨百姓。"
  },
  {
    "id": "s0494",
    "blockIndex": 65,
    "zh": "今國已定，民已安矣，王乃曰『單』，嬰兒之計不為此也。"
  },
  {
    "id": "s0495",
    "blockIndex": 65,
    "zh": "王亟殺此九子者以謝安平君，不然，國其危矣！"
  },
  {
    "id": "s0496",
    "blockIndex": 65,
    "zh": "」乃殺九子而逐其家，益封安平君以夜邑萬戶<ref>益封安平君以夜邑萬戶「夜邑」，《戰國策》作「掖邑」，班固《漢書》有掖縣，蓋是此地。"
  },
  {
    "id": "s0497",
    "blockIndex": 65,
    "zh": "</ref>。"
  },
  {
    "id": "s0498",
    "blockIndex": 66,
    "zh": "田單將攻狄，往見魯仲連。"
  },
  {
    "id": "s0499",
    "blockIndex": 66,
    "zh": "魯仲連曰：「將軍攻狄，不能下也。"
  },
  {
    "id": "s0500",
    "blockIndex": 66,
    "zh": "」田單曰：「臣以即墨破亡餘卒破萬乘之燕，復齊之墟，今攻狄而不下，何也？"
  },
  {
    "id": "s0501",
    "blockIndex": 66,
    "zh": "」上車弗謝而去，遂攻狄，三月不克。"
  },
  {
    "id": "s0502",
    "blockIndex": 66,
    "zh": "齊小兒謠曰：「大冠若箕，修劍拄頤。"
  },
  {
    "id": "s0503",
    "blockIndex": 66,
    "zh": "攻狄不能下，壘枯骨成丘。"
  },
  {
    "id": "s0504",
    "blockIndex": 66,
    "zh": "」田單乃懼，問魯仲連曰：「先生謂單不能下狄，請問其說。"
  },
  {
    "id": "s0505",
    "blockIndex": 66,
    "zh": "」魯仲連曰：「將軍之在即墨，坐則織蕢，立則仗鍤，為士卒倡曰：『無可往矣！"
  },
  {
    "id": "s0506",
    "blockIndex": 66,
    "zh": "宗廟亡矣！"
  },
  {
    "id": "s0507",
    "blockIndex": 66,
    "zh": "今日尚矣！"
  },
  {
    "id": "s0508",
    "blockIndex": 66,
    "zh": "歸於何黨矣！"
  },
  {
    "id": "s0509",
    "blockIndex": 66,
    "zh": "』當此之時，將軍有死之心，士卒先無之氣，聞君言莫不揮泣奮臂而欲戰，此所以破燕也。"
  },
  {
    "id": "s0510",
    "blockIndex": 66,
    "zh": "當今將軍東有夜邑之奉，西有淄上之娛，黃金橫帶而騁乎淄、澠之間，有生之樂，無死之心，所以不勝也。"
  },
  {
    "id": "s0511",
    "blockIndex": 66,
    "zh": "」田單曰：「單之有心，先生志之矣。"
  },
  {
    "id": "s0512",
    "blockIndex": 66,
    "zh": "」明日，乃厲氣循城，立於矢石之所，援袍鼓之。"
  },
  {
    "id": "s0513",
    "blockIndex": 66,
    "zh": "狄人乃下。"
  },
  {
    "id": "s0514",
    "blockIndex": 67,
    "zh": "初，齊湣王既滅宋，欲去孟嘗君。"
  },
  {
    "id": "s0515",
    "blockIndex": 67,
    "zh": "孟嘗君奔魏，魏昭王以為相，與諸侯共伐破齊。"
  },
  {
    "id": "s0516",
    "blockIndex": 67,
    "zh": "湣王死，襄王復國，而孟嘗君中立為諸侯，無所屬。"
  },
  {
    "id": "s0517",
    "blockIndex": 67,
    "zh": "襄王新立，畏孟嘗君，與之連和。"
  },
  {
    "id": "s0518",
    "blockIndex": 67,
    "zh": "孟嘗君卒，諸子爭立，而齊、魏共滅薛，孟嘗君絕嗣。"
  },
  {
    "id": "s0519",
    "blockIndex": 68,
    "zh": "2〔魯緡公薨，子頃公讎立〕<ref>〔魯緡公薨子頃公讎立〕舊文本繫於赧王四十一年，據近人考証移入此年。"
  },
  {
    "id": "s0520",
    "blockIndex": 68,
    "zh": "並據赧王四十八年條改「湣」為「緡」。"
  },
  {
    "id": "s0521",
    "blockIndex": 68,
    "zh": "</ref>。"
  },
  {
    "id": "s0522",
    "blockIndex": 69,
    "zh": "1秦大良造白起伐楚，拔郢，燒夷陵。"
  },
  {
    "id": "s0523",
    "blockIndex": 69,
    "zh": "楚襄王兵散，遂不復戰，東北徙都於陳。"
  },
  {
    "id": "s0524",
    "blockIndex": 69,
    "zh": "秦以郢為南郡，封白起為武安君。"
  },
  {
    "id": "s0525",
    "blockIndex": 70,
    "zh": "1秦武安君定巫、黔中，初置黔中郡。"
  },
  {
    "id": "s0526",
    "blockIndex": 71,
    "zh": "2魏昭王薨，子安釐王〔圉〕立<ref>子安釐王〔圉〕立據《史記·魏世家》索隱引《世本》補。"
  },
  {
    "id": "s0527",
    "blockIndex": 71,
    "zh": "</ref>。"
  },
  {
    "id": "s0528",
    "blockIndex": 72,
    "zh": "1秦武安君伐魏，拔兩城。"
  },
  {
    "id": "s0529",
    "blockIndex": 73,
    "zh": "2楚王收東地兵，得十餘萬，復西取江南十五邑。"
  },
  {
    "id": "s0530",
    "blockIndex": 74,
    "zh": "3魏安釐王封其弟無忌為信陵君。"
  },
  {
    "id": "s0531",
    "blockIndex": 75,
    "zh": "秦相國穰侯伐魏。"
  },
  {
    "id": "s0532",
    "blockIndex": 75,
    "zh": "韓暴鳶救魏，穰侯大破之，斬首四萬。"
  },
  {
    "id": "s0533",
    "blockIndex": 75,
    "zh": "暴鳶走啟封。"
  },
  {
    "id": "s0534",
    "blockIndex": 75,
    "zh": "魏納八城以和。"
  },
  {
    "id": "s0535",
    "blockIndex": 75,
    "zh": "穰侯復伐魏，走芒卯，入北宅。"
  },
  {
    "id": "s0536",
    "blockIndex": 75,
    "zh": "〔遂圍大梁〕<ref>〔遂圍大梁〕章校「十二行本『魏』上有『遂圍大梁』四字；"
  },
  {
    "id": "s0537",
    "blockIndex": 75,
    "zh": "乙十一行本同；"
  },
  {
    "id": "s0538",
    "blockIndex": 75,
    "zh": "孔本同；"
  },
  {
    "id": "s0539",
    "blockIndex": 75,
    "zh": "退齋校同。"
  },
  {
    "id": "s0540",
    "blockIndex": 75,
    "zh": "」據補。"
  },
  {
    "id": "s0541",
    "blockIndex": 75,
    "zh": "</ref>，魏人割溫以和。"
  },
  {
    "id": "s0542",
    "blockIndex": 76,
    "zh": "1魏復與齊合從。"
  },
  {
    "id": "s0543",
    "blockIndex": 76,
    "zh": "秦穰侯伐魏，拔四城，斬首四萬。"
  },
  {
    "id": "s0544",
    "blockIndex": 77,
    "zh": "1趙人、魏人伐韓華陽。"
  },
  {
    "id": "s0545",
    "blockIndex": 77,
    "zh": "韓人告急於秦，秦王弗救。"
  },
  {
    "id": "s0546",
    "blockIndex": 77,
    "zh": "韓相國謂陳筮曰：「事急矣！"
  },
  {
    "id": "s0547",
    "blockIndex": 77,
    "zh": "願公雖病，為一宿之行。"
  },
  {
    "id": "s0548",
    "blockIndex": 77,
    "zh": "」陳筮如秦，見穰侯。"
  },
  {
    "id": "s0549",
    "blockIndex": 77,
    "zh": "穰侯曰：「事急乎？"
  },
  {
    "id": "s0550",
    "blockIndex": 77,
    "zh": "故使公來。"
  },
  {
    "id": "s0551",
    "blockIndex": 77,
    "zh": "」陳筮曰：「未急也。"
  },
  {
    "id": "s0552",
    "blockIndex": 77,
    "zh": "」穰侯怒曰：「何也？"
  },
  {
    "id": "s0553",
    "blockIndex": 77,
    "zh": "」陳筮曰：「彼韓急則將變而他從；"
  },
  {
    "id": "s0554",
    "blockIndex": 77,
    "zh": "以未急，故復來耳。"
  },
  {
    "id": "s0555",
    "blockIndex": 77,
    "zh": "」穰侯曰：「請發兵矣。"
  },
  {
    "id": "s0556",
    "blockIndex": 77,
    "zh": "」乃與武安君及客卿胡陽救韓，八日而至，敗魏軍於華陽之下，走芒卯，虜三將，斬首十三萬。"
  },
  {
    "id": "s0557",
    "blockIndex": 77,
    "zh": "武安君又與趙將賈偃戰，沈其卒二萬人於河。"
  },
  {
    "id": "s0558",
    "blockIndex": 77,
    "zh": "魏段干子請割南陽予秦以和。"
  },
  {
    "id": "s0559",
    "blockIndex": 77,
    "zh": "蘇代謂魏王曰：「欲璽者，段干子也；"
  },
  {
    "id": "s0560",
    "blockIndex": 77,
    "zh": "欲地者，秦也。"
  },
  {
    "id": "s0561",
    "blockIndex": 77,
    "zh": "今王使欲地者制璽，欲璽者制地，魏地盡矣！"
  },
  {
    "id": "s0562",
    "blockIndex": 77,
    "zh": "夫以地事秦，猶抱薪救火，薪不盡，火不滅。"
  },
  {
    "id": "s0563",
    "blockIndex": 77,
    "zh": "」王曰：「是則然也。"
  },
  {
    "id": "s0564",
    "blockIndex": 77,
    "zh": "雖然，事始已行，不可更矣！"
  },
  {
    "id": "s0565",
    "blockIndex": 77,
    "zh": "」對曰：「夫博之所以貴梟者，便則食，不便則止。"
  },
  {
    "id": "s0566",
    "blockIndex": 77,
    "zh": "今何王之用智不如用梟也？"
  },
  {
    "id": "s0567",
    "blockIndex": 77,
    "zh": "」魏王不聽，卒以南陽為和，實修武。"
  },
  {
    "id": "s0568",
    "blockIndex": 78,
    "zh": "2韓釐王薨，子桓惠王立。"
  },
  {
    "id": "s0569",
    "blockIndex": 79,
    "zh": "3韓、魏既服於秦，秦王將使武安君與韓、魏伐楚，未行，而楚使者黃歇至，聞之，畏秦乘勝一舉而滅楚也，乃上書曰：「臣聞物至則反，冬、夏是也；"
  },
  {
    "id": "s0570",
    "blockIndex": 79,
    "zh": "致至則危，累棋是也。"
  },
  {
    "id": "s0571",
    "blockIndex": 79,
    "zh": "今大國之地，遍天下有其二垂，此從生民已來，萬乘之地未嘗有也。"
  },
  {
    "id": "s0572",
    "blockIndex": 79,
    "zh": "先王三世不忘接地於齊，以絕從親之要。"
  },
  {
    "id": "s0573",
    "blockIndex": 79,
    "zh": "今王使盛橋守事於韓，盛橋以其地入秦，是王不用甲，不信威，而得百里之地，王可謂能矣！"
  },
  {
    "id": "s0574",
    "blockIndex": 79,
    "zh": "王又舉甲而攻魏，杜大樑之門，舉河內，拔燕、酸棗、虛、桃，入邢，魏之兵雲翔而不敢救，王之功亦多矣！"
  },
  {
    "id": "s0575",
    "blockIndex": 79,
    "zh": "王休甲息眾，二年而後復之，又並蒲、衍、首、垣以臨仁、平丘，黃、濟陽嬰城而魏氏服。"
  },
  {
    "id": "s0576",
    "blockIndex": 79,
    "zh": "王又割濮磨之北，注齊、秦之要，絕楚、趙之脊，天下五合六聚而不敢救，王之威亦單矣！"
  },
  {
    "id": "s0577",
    "blockIndex": 79,
    "zh": "王若能保功守威，絀攻取之心，而肥仁義之地，使無後患，三王不足四，五伯不足六也！"
  },
  {
    "id": "s0578",
    "blockIndex": 79,
    "zh": "王若負人徒之眾，仗兵革之強，乘毀魏之威，而欲以力臣天下之主，臣恐其有後患也。"
  },
  {
    "id": "s0579",
    "blockIndex": 79,
    "zh": "《詩》曰：『靡不有初，鮮克有終。"
  },
  {
    "id": "s0580",
    "blockIndex": 79,
    "zh": "』《易》曰：『狐涉水，濡其尾。"
  },
  {
    "id": "s0581",
    "blockIndex": 79,
    "zh": "』此言始之易，終之難也。"
  },
  {
    "id": "s0582",
    "blockIndex": 79,
    "zh": "昔吳之信越也，從而伐齊，既勝齊人於艾陵，還為越禽於三江之浦。"
  },
  {
    "id": "s0583",
    "blockIndex": 79,
    "zh": "智氏之信韓、魏也，從而伐趙，攻晉陽城，勝有日矣，韓、魏叛之，殺智伯瑤於鑿台之下。"
  },
  {
    "id": "s0584",
    "blockIndex": 79,
    "zh": "今王妒楚之不毀，而忘毀楚之強韓、魏也，臣為王慮而不取也。"
  },
  {
    "id": "s0585",
    "blockIndex": 79,
    "zh": "夫楚國，援也；"
  },
  {
    "id": "s0586",
    "blockIndex": 79,
    "zh": "鄰國，敵也。"
  },
  {
    "id": "s0587",
    "blockIndex": 79,
    "zh": "今王信韓、魏之善王，此正吳之信越也，臣恐韓、魏卑辭除患而實欲欺大國也。"
  },
  {
    "id": "s0588",
    "blockIndex": 79,
    "zh": "何則？"
  },
  {
    "id": "s0589",
    "blockIndex": 79,
    "zh": "王無重世之德於韓、魏而有累世之怨焉。"
  },
  {
    "id": "s0590",
    "blockIndex": 79,
    "zh": "夫韓、魏父子兄弟接踵而死於秦〔者〕將十世矣<ref>夫韓魏父子兄弟接踵而死於秦〔者〕將十世矣章校「十二行本『秦』下有『者』字；"
  },
  {
    "id": "s0591",
    "blockIndex": 79,
    "zh": "乙十一行本同；"
  },
  {
    "id": "s0592",
    "blockIndex": 79,
    "zh": "孔本同。"
  },
  {
    "id": "s0593",
    "blockIndex": 79,
    "zh": "」據補。"
  },
  {
    "id": "s0594",
    "blockIndex": 79,
    "zh": "</ref>，故韓、魏之不亡，秦社稷之憂也。"
  },
  {
    "id": "s0595",
    "blockIndex": 79,
    "zh": "今王資之與攻楚，不亦過乎！"
  },
  {
    "id": "s0596",
    "blockIndex": 79,
    "zh": "且攻楚將惡出兵？"
  },
  {
    "id": "s0597",
    "blockIndex": 79,
    "zh": "王將借路於仇讎之韓、魏乎？"
  },
  {
    "id": "s0598",
    "blockIndex": 79,
    "zh": "兵出之日而王憂其不反也。"
  },
  {
    "id": "s0599",
    "blockIndex": 79,
    "zh": "王若不借路於仇讎之韓、魏，必攻隨水右壤，此皆廣川、大水、山林、溪谷，不食之地。"
  },
  {
    "id": "s0600",
    "blockIndex": 79,
    "zh": "是王有毀楚之名而無得地之實也。"
  },
  {
    "id": "s0601",
    "blockIndex": 79,
    "zh": "且王攻楚之日，四國必悉起兵以應王。"
  },
  {
    "id": "s0602",
    "blockIndex": 79,
    "zh": "秦、楚之兵構而不離；"
  },
  {
    "id": "s0603",
    "blockIndex": 79,
    "zh": "魏氏將出而攻留、方輿、銍、湖陵、碭、蕭、相，故宋必盡；"
  },
  {
    "id": "s0604",
    "blockIndex": 79,
    "zh": "齊人南面攻楚，泗上必舉。"
  },
  {
    "id": "s0605",
    "blockIndex": 79,
    "zh": "此皆平原四達膏腴之地。"
  },
  {
    "id": "s0606",
    "blockIndex": 79,
    "zh": "如此，則天下之國莫強於齊、魏矣。"
  },
  {
    "id": "s0607",
    "blockIndex": 79,
    "zh": "臣為王慮，莫若善楚。"
  },
  {
    "id": "s0608",
    "blockIndex": 79,
    "zh": "秦、楚合而為一以臨韓，韓必斂手而朝；"
  },
  {
    "id": "s0609",
    "blockIndex": 79,
    "zh": "王施以東山之險，帶以曲河之利，韓必為關內之侯。"
  },
  {
    "id": "s0610",
    "blockIndex": 79,
    "zh": "若是而王以十萬戍鄭，梁氏寒心，許、鄢陵嬰城而上蔡、召陵不往來也。"
  },
  {
    "id": "s0611",
    "blockIndex": 79,
    "zh": "如此，魏亦關內侯矣。"
  },
  {
    "id": "s0612",
    "blockIndex": 79,
    "zh": "王壹善楚而關內兩萬乘之主注地於齊，齊右壤可拱手而取也。"
  },
  {
    "id": "s0613",
    "blockIndex": 79,
    "zh": "王之地一經兩海，要約天下，是燕、趙無齊、楚，齊、楚無燕、趙也。"
  },
  {
    "id": "s0614",
    "blockIndex": 79,
    "zh": "然後危動燕、趙，直搖齊、楚，此四國者不待痛而服矣。"
  },
  {
    "id": "s0615",
    "blockIndex": 79,
    "zh": "」王從之，止武安君而謝韓、魏，使黃歇歸，約親於楚。"
  },
  {
    "id": "s0616",
    "blockIndex": 80,
    "zh": "<divclass=\"references-small\"><references/></div>"
  },
  {
    "id": "s0617",
    "blockIndex": 81,
    "zh": "周"
  }
]
