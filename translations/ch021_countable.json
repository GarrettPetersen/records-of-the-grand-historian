[
  {
    "id": "s0001",
    "blockIndex": 0,
    "zh": "起玄黓涒灘，盡玄黓敦牂，凡十一年。"
  },
  {
    "id": "s0002",
    "blockIndex": 1,
    "zh": "1冬，十月，上行幸雍，祠五畤；"
  },
  {
    "id": "s0003",
    "blockIndex": 1,
    "zh": "還，祝祠泰一，以拜德星。"
  },
  {
    "id": "s0004",
    "blockIndex": 1,
    "zh": "----2春，正月，公孫卿言：「見神人東萊山，若-{云}-欲見天子。"
  },
  {
    "id": "s0005",
    "blockIndex": 1,
    "zh": "」天子於是幸緱氏城，拜卿為中大夫，遂至東萊，宿留之，數日，無所見，見大人跡-{云}-。"
  },
  {
    "id": "s0006",
    "blockIndex": 1,
    "zh": "復遣方士求神怪，采芝藥，以千數。"
  },
  {
    "id": "s0007",
    "blockIndex": 1,
    "zh": "時歲旱，天子既出無名，乃禱萬里沙。"
  },
  {
    "id": "s0008",
    "blockIndex": 1,
    "zh": "夏，四月，還，過祠泰山。"
  },
  {
    "id": "s0009",
    "blockIndex": 1,
    "zh": "----3初，河決瓠子，後二十餘歲不復塞，梁、楚之地尤被其害。"
  },
  {
    "id": "s0010",
    "blockIndex": 1,
    "zh": "是歲，上使汲仁、郭昌二卿發卒數萬人塞瓠子河決。"
  },
  {
    "id": "s0011",
    "blockIndex": 1,
    "zh": "天子自泰山還，自臨決河，沈白馬、玉璧於河，令群臣、從官自將軍以下皆負薪，卒填決河。"
  },
  {
    "id": "s0012",
    "blockIndex": 1,
    "zh": "築宮其上，名曰宣防宮。"
  },
  {
    "id": "s0013",
    "blockIndex": 1,
    "zh": "導河北行二渠，復禹舊跡，而梁、楚之地復寧，無水災。"
  },
  {
    "id": "s0014",
    "blockIndex": 1,
    "zh": "----4上還長安。"
  },
  {
    "id": "s0015",
    "blockIndex": 1,
    "zh": "----5初令越巫祠上帝、百鬼，而用雞卜。"
  },
  {
    "id": "s0016",
    "blockIndex": 1,
    "zh": "----6公孫卿言仙人好樓居，於是上令長安作蜚廉、桂觀，甘泉作益壽、延壽觀，使卿持節設具而候神人。"
  },
  {
    "id": "s0017",
    "blockIndex": 1,
    "zh": "又作通天莖台，置祠具其下。"
  },
  {
    "id": "s0018",
    "blockIndex": 1,
    "zh": "更置甘泉前殿，益廣諸宮室。"
  },
  {
    "id": "s0019",
    "blockIndex": 1,
    "zh": "----7初，全燕之世，嘗略屬真番、朝鮮，為置吏，築障塞。"
  },
  {
    "id": "s0020",
    "blockIndex": 1,
    "zh": "秦滅燕，屬遼東外徼。"
  },
  {
    "id": "s0021",
    "blockIndex": 1,
    "zh": "漢興，為其遠難守，復修遼東故塞，至浿水為界，屬燕。"
  },
  {
    "id": "s0022",
    "blockIndex": 1,
    "zh": "燕王盧綰反，入匈奴。"
  },
  {
    "id": "s0023",
    "blockIndex": 1,
    "zh": "燕人衛滿亡命，聚黨千餘人，椎髻、蠻夷服而東走出塞，渡浿水，居秦故空地上下障，稍役屬真番、朝鮮蠻夷及燕亡命者，王之，都王險。"
  },
  {
    "id": "s0024",
    "blockIndex": 1,
    "zh": "會孝惠、高-{后}-時，天下初定，遼東太守即約：滿為外臣，保塞外蠻夷，無使盜邊；"
  },
  {
    "id": "s0025",
    "blockIndex": 1,
    "zh": "諸蠻夷君欲入見天子，勿得禁止。"
  },
  {
    "id": "s0026",
    "blockIndex": 1,
    "zh": "以故滿得以兵威財物侵降其旁小邑，真番、臨屯皆來服屬，方數千里。"
  },
  {
    "id": "s0027",
    "blockIndex": 1,
    "zh": "傳子至孫右渠，所誘漢亡人滋多，又未嘗入見，辰國欲上書見天子，又雍閼不通。"
  },
  {
    "id": "s0028",
    "blockIndex": 1,
    "zh": "是歲，漢使涉何誘諭，右渠終不肯奉詔。"
  },
  {
    "id": "s0029",
    "blockIndex": 1,
    "zh": "何去至界上，臨浿水，使御刺殺送何者朝鮮裨王長，即渡，馳入塞，遂歸報天子曰：「殺朝鮮將。"
  },
  {
    "id": "s0030",
    "blockIndex": 1,
    "zh": "」上為其名美，即不詰，拜何為遼東東部都尉。"
  },
  {
    "id": "s0031",
    "blockIndex": 1,
    "zh": "朝鮮怨何，發兵襲攻殺何。"
  },
  {
    "id": "s0032",
    "blockIndex": 1,
    "zh": "----8六月，甘泉房中產芝九莖，上為之赦天下。"
  },
  {
    "id": "s0033",
    "blockIndex": 1,
    "zh": "----9上以旱為憂，公孫卿曰：「黃帝時，封則天旱，乾封三年。"
  },
  {
    "id": "s0034",
    "blockIndex": 1,
    "zh": "」上乃下詔曰：「天旱，意乾封乎！"
  },
  {
    "id": "s0035",
    "blockIndex": 1,
    "zh": "」----10秋，作明堂於汶上。"
  },
  {
    "id": "s0036",
    "blockIndex": 1,
    "zh": "----11上募天下死罪為兵，遣樓船將軍楊僕從齊浮渤海，左將軍荀彘出遼東，以討朝鮮。"
  },
  {
    "id": "s0037",
    "blockIndex": 1,
    "zh": "----12初，上使-{王然于}-以越破及誅南夷兵威喻滇王入朝。"
  },
  {
    "id": "s0038",
    "blockIndex": 1,
    "zh": "滇王者，其眾數萬人，其旁東北有勞深、靡莫，皆同姓相杖，未肯聽。"
  },
  {
    "id": "s0039",
    "blockIndex": 1,
    "zh": "勞深、靡莫數侵犯使者吏卒。"
  },
  {
    "id": "s0040",
    "blockIndex": 1,
    "zh": "於是上遣將軍郭昌、中郎將衛廣發巴、蜀兵擊滅勞深、靡莫，以兵臨滇。"
  },
  {
    "id": "s0041",
    "blockIndex": 1,
    "zh": "滇王舉國降，請置吏入朝，於是以為益州郡，賜滇王王印，復長其民。"
  },
  {
    "id": "s0042",
    "blockIndex": 2,
    "zh": "是時，漢滅兩越，平西南夷，置初郡十七，且以其故俗治，毋賦稅。"
  },
  {
    "id": "s0043",
    "blockIndex": 2,
    "zh": "南陽、漢中以往郡，各以地比，給初郡吏卒奉食、幣物、傳車、馬被具。"
  },
  {
    "id": "s0044",
    "blockIndex": 2,
    "zh": "而初郡時時小反，殺吏，漢發南方吏卒往誅之，間歲萬餘人，費皆仰給大農。"
  },
  {
    "id": "s0045",
    "blockIndex": 2,
    "zh": "大農以均輸、調鹽鐵助賦，故能贍之。"
  },
  {
    "id": "s0046",
    "blockIndex": 2,
    "zh": "然兵所過，縣為以訾給毋乏而已，不也言擅賦法矣。"
  },
  {
    "id": "s0047",
    "blockIndex": 2,
    "zh": "----13是歲，以御史中丞南陽杜周為廷尉。"
  },
  {
    "id": "s0048",
    "blockIndex": 2,
    "zh": "周外寬，內深次骨，其治大放張湯。"
  },
  {
    "id": "s0049",
    "blockIndex": 2,
    "zh": "時詔獄益多，二千石系者，新故相因，不減百餘人；"
  },
  {
    "id": "s0050",
    "blockIndex": 2,
    "zh": "廷尉一歲至千餘章，章大者連逮證案數百，小者數十人；"
  },
  {
    "id": "s0051",
    "blockIndex": 2,
    "zh": "遠者數千、近者數百里會獄。"
  },
  {
    "id": "s0052",
    "blockIndex": 2,
    "zh": "廷尉及中都官詔獄逮至六七萬人，吏所增加，十萬餘人。"
  },
  {
    "id": "s0054",
    "blockIndex": 3,
    "zh": "1冬，十二月，雷；"
  },
  {
    "id": "s0055",
    "blockIndex": 3,
    "zh": "雨雹，大如馬頭。"
  },
  {
    "id": "s0056",
    "blockIndex": 3,
    "zh": "----2上遣將軍趙破奴擊車師。"
  },
  {
    "id": "s0057",
    "blockIndex": 3,
    "zh": "破奴與輕騎七百餘先至，虜樓蘭王，遂破車師，因舉兵威以困烏孫、大宛之屬。"
  },
  {
    "id": "s0058",
    "blockIndex": 3,
    "zh": "春，正月，甲申，封破奴為浞野侯。"
  },
  {
    "id": "s0059",
    "blockIndex": 3,
    "zh": "王恢佐破奴擊樓蘭，封恢為浩侯。"
  },
  {
    "id": "s0060",
    "blockIndex": 3,
    "zh": "於是酒泉列亭障至玉門矣。"
  },
  {
    "id": "s0061",
    "blockIndex": 3,
    "zh": "----3初作角抵戲、魚龍曼延之屬。"
  },
  {
    "id": "s0062",
    "blockIndex": 3,
    "zh": "----4漢兵入朝鮮境，朝鮮王右渠發兵距險。"
  },
  {
    "id": "s0063",
    "blockIndex": 3,
    "zh": "樓船將軍將齊兵七千人先至王險。"
  },
  {
    "id": "s0064",
    "blockIndex": 3,
    "zh": "右渠城守，窺知樓船軍少，即出城擊樓船；"
  },
  {
    "id": "s0065",
    "blockIndex": 3,
    "zh": "樓船軍敗散，遁山中十餘日，稍求退散卒，復聚。"
  },
  {
    "id": "s0066",
    "blockIndex": 3,
    "zh": "左將軍擊朝鮮浿水西軍，未能破。"
  },
  {
    "id": "s0067",
    "blockIndex": 3,
    "zh": "天子為兩將未有利，乃使衛山因兵威往諭右渠。"
  },
  {
    "id": "s0068",
    "blockIndex": 3,
    "zh": "右渠見使者，頓首謝：「願降，恐兩將詐殺臣，今見信節，請復降。"
  },
  {
    "id": "s0069",
    "blockIndex": 3,
    "zh": "」遣太子入謝，獻馬五千匹，及饋軍糧；"
  },
  {
    "id": "s0070",
    "blockIndex": 3,
    "zh": "人眾萬餘，持兵方渡浿水。"
  },
  {
    "id": "s0071",
    "blockIndex": 3,
    "zh": "使者及左將軍疑其為變，謂太子：「已服降，宜令人毋持兵。"
  },
  {
    "id": "s0072",
    "blockIndex": 3,
    "zh": "」太子亦疑使者、左將軍詐殺之，遂不渡浿水，復引歸。"
  },
  {
    "id": "s0073",
    "blockIndex": 3,
    "zh": "山還報天子，天子誅山。"
  },
  {
    "id": "s0074",
    "blockIndex": 4,
    "zh": "左將軍破浿水上軍，乃前至城下，圍其西北，樓船亦往會，居城南。"
  },
  {
    "id": "s0075",
    "blockIndex": 4,
    "zh": "右渠遂堅守城，數月未能下。"
  },
  {
    "id": "s0076",
    "blockIndex": 4,
    "zh": "左將軍所將燕、代卒多勁悍，樓船將齊卒已嘗敗亡困辱，卒皆恐，將心慚，其圍右渠，常持和節。"
  },
  {
    "id": "s0077",
    "blockIndex": 4,
    "zh": "左將軍急擊之，朝鮮大臣乃陰間使人私約降樓船，往來言尚未肯決。"
  },
  {
    "id": "s0078",
    "blockIndex": 4,
    "zh": "左將軍數與樓船期戰，樓船欲就其約，不會。"
  },
  {
    "id": "s0079",
    "blockIndex": 4,
    "zh": "左將軍亦使人求間隙降下朝鮮，朝鮮不肯，心附樓船，以故兩將不相能。"
  },
  {
    "id": "s0080",
    "blockIndex": 4,
    "zh": "左將軍心意樓船前有失軍罪，今與朝鮮私善，而又不降，疑其有反計，未敢發。"
  },
  {
    "id": "s0081",
    "blockIndex": 5,
    "zh": "天子以兩將圍城乖異，兵久不決，使濟南太守公孫遂往正之，有便宜得以從事。"
  },
  {
    "id": "s0082",
    "blockIndex": 5,
    "zh": "遂至，左將軍曰：「朝鮮當下，久之不下者，樓船數期不會。"
  },
  {
    "id": "s0083",
    "blockIndex": 5,
    "zh": "」具以素所意告，曰：「今如此不取，恐為大害。"
  },
  {
    "id": "s0084",
    "blockIndex": 5,
    "zh": "」遂亦以為然，乃以節召樓船將軍入左將軍營計事，即命左將軍麾下執樓船將軍，并其軍。"
  },
  {
    "id": "s0085",
    "blockIndex": 5,
    "zh": "以報天子，天子誅遂。"
  },
  {
    "id": "s0086",
    "blockIndex": 6,
    "zh": "左將軍已并兩軍，即急擊朝鮮。"
  },
  {
    "id": "s0087",
    "blockIndex": 6,
    "zh": "朝鮮相路人、相韓陰、尼谿相參、將軍王唊相與謀曰：「始欲降樓船，樓船今執，獨左將軍並將，戰益急，恐不能與戰；"
  },
  {
    "id": "s0088",
    "blockIndex": 6,
    "zh": "王又不肯降。"
  },
  {
    "id": "s0089",
    "blockIndex": 6,
    "zh": "」陰、唊、路人皆亡降漢，路人道死。"
  },
  {
    "id": "s0090",
    "blockIndex": 6,
    "zh": "夏，尼谿參使人殺朝鮮王右渠來降。"
  },
  {
    "id": "s0091",
    "blockIndex": 6,
    "zh": "王險城未下，故右渠之大臣成己又反，復攻吏。"
  },
  {
    "id": "s0092",
    "blockIndex": 6,
    "zh": "左將軍使右渠子長、降相路人之子最告諭其民。"
  },
  {
    "id": "s0093",
    "blockIndex": 6,
    "zh": "誅成己。"
  },
  {
    "id": "s0094",
    "blockIndex": 6,
    "zh": "以故遂定朝鮮，為樂浪、臨屯、玄菟、真番四郡。"
  },
  {
    "id": "s0095",
    "blockIndex": 6,
    "zh": "封參為澅清侯，陰為萩苴侯，唊為平州侯，長為幾侯，最以父死頗有功，為涅陽侯。"
  },
  {
    "id": "s0096",
    "blockIndex": 7,
    "zh": "左將軍徵至，坐爭功相嫉乖計，棄市。"
  },
  {
    "id": "s0097",
    "blockIndex": 7,
    "zh": "樓船將軍亦坐兵至列口，當待左將軍，擅先縱，失亡多，當誅，贖為庶人。"
  },
  {
    "id": "s0098",
    "blockIndex": 8,
    "zh": ":班固曰：玄菟、樂浪，本箕子所封。"
  },
  {
    "id": "s0099",
    "blockIndex": 8,
    "zh": "昔箕子居朝鮮，教其民以禮義，田蠶織作，為民設禁八條，相殺，以當時償殺；"
  },
  {
    "id": "s0100",
    "blockIndex": 8,
    "zh": "相傷，以穀償；"
  },
  {
    "id": "s0101",
    "blockIndex": 8,
    "zh": "相盜者，男沒入為其家奴，女為婢；"
  },
  {
    "id": "s0102",
    "blockIndex": 8,
    "zh": "欲自贖者人五十萬，雖免為民，俗猶羞之，嫁娶無所售。"
  },
  {
    "id": "s0103",
    "blockIndex": 8,
    "zh": "是以其民終不相盜，無門戶之閉，婦人貞信不淫辟。"
  },
  {
    "id": "s0104",
    "blockIndex": 8,
    "zh": "其田野飲食以籩豆，都邑頗放效吏，往往以杯器食。"
  },
  {
    "id": "s0105",
    "blockIndex": 8,
    "zh": "郡初取吏於遼東，吏見民無閉臧，及賈人往者，夜則為盜，俗稍益薄，今於犯禁浸多，至六十餘條。"
  },
  {
    "id": "s0106",
    "blockIndex": 8,
    "zh": "可貴哉，仁賢之化也！"
  },
  {
    "id": "s0107",
    "blockIndex": 8,
    "zh": "然東夷天性柔順，異於三方之外。"
  },
  {
    "id": "s0108",
    "blockIndex": 8,
    "zh": "故孔子悼道不行，設浮桴於海，欲居九夷，有以也夫！"
  },
  {
    "id": "s0109",
    "blockIndex": 8,
    "zh": "----5秋，七月，膠西於王端薨。"
  },
  {
    "id": "s0110",
    "blockIndex": 8,
    "zh": "----6武都氐反，分徙酒泉。"
  },
  {
    "id": "s0112",
    "blockIndex": 9,
    "zh": "1冬，十月，上行幸雍，祠五畤。"
  },
  {
    "id": "s0113",
    "blockIndex": 9,
    "zh": "通回中道，遂北出蕭關。"
  },
  {
    "id": "s0114",
    "blockIndex": 9,
    "zh": "歷獨鹿、鳴澤，自代而還，幸河東。"
  },
  {
    "id": "s0115",
    "blockIndex": 9,
    "zh": "春，三月，祠后土，赦汾陰、夏陽、中都死罪以下。"
  },
  {
    "id": "s0116",
    "blockIndex": 9,
    "zh": "----2夏，大旱。"
  },
  {
    "id": "s0117",
    "blockIndex": 9,
    "zh": "----3匈奴自衛、霍度幕以來，希復為寇，遠徙北方，休養士馬，習射獵，數使使於漢，好辭甘言求請和親。"
  },
  {
    "id": "s0118",
    "blockIndex": 9,
    "zh": "漢使北地人王烏等窺匈奴，烏從其俗，去節入穹廬，單于愛之，佯許甘言，為遣其太子入漢為質。"
  },
  {
    "id": "s0119",
    "blockIndex": 9,
    "zh": "漢使楊信於匈奴，信不肯從其俗，單于曰：「故約漢嘗遣翁主，給繒絮食物有品，以和親，而匈奴亦不擾邊。"
  },
  {
    "id": "s0120",
    "blockIndex": 9,
    "zh": "今乃欲反古，令吾太子為質，無幾矣。"
  },
  {
    "id": "s0121",
    "blockIndex": 9,
    "zh": "」信既歸，漢又使王烏往，而單于復諂以甘言，欲多得漢財物，紿謂王烏曰：「吾欲入漢見天子面，相約為兄弟。"
  },
  {
    "id": "s0122",
    "blockIndex": 9,
    "zh": "」王烏歸報漢，漢為單于築邸於長安。"
  },
  {
    "id": "s0123",
    "blockIndex": 9,
    "zh": "匈奴曰：「非得漢貴人使，吾不與誠語。"
  },
  {
    "id": "s0124",
    "blockIndex": 9,
    "zh": "」匈奴使其貴人至漢，病，漢予藥，欲愈之，不幸而死。"
  },
  {
    "id": "s0125",
    "blockIndex": 9,
    "zh": "漢使路充國佩二千石印綬往使，因送其喪，厚葬直數千金，曰：「此漢貴人也。"
  },
  {
    "id": "s0126",
    "blockIndex": 9,
    "zh": "」單于以為漢殺吾貴使者，乃留路充國不歸。"
  },
  {
    "id": "s0127",
    "blockIndex": 9,
    "zh": "諸所言者，單于特空紿王烏，殊無意入漢及遣太子。"
  },
  {
    "id": "s0128",
    "blockIndex": 9,
    "zh": "於是匈奴數使奇兵侵犯漢邊。"
  },
  {
    "id": "s0129",
    "blockIndex": 9,
    "zh": "乃拜郭昌為拔胡將軍，及浞野侯屯朔方以東，備胡。"
  },
  {
    "id": "s0131",
    "blockIndex": 10,
    "zh": "1冬，上南巡狩，至於盛唐，望祀虞舜於九疑。"
  },
  {
    "id": "s0132",
    "blockIndex": 10,
    "zh": "登灊天柱山，自尋陽浮江，親射蛟江中，獲之。"
  },
  {
    "id": "s0133",
    "blockIndex": 10,
    "zh": "舳艫千里，薄樅陽而出，遂北至琅邪，並海，所過禮祠其名山大川。"
  },
  {
    "id": "s0134",
    "blockIndex": 10,
    "zh": "春，三月，還至太山，增封。"
  },
  {
    "id": "s0135",
    "blockIndex": 10,
    "zh": "甲子，始祀上帝於明堂，配以高祖，因朝諸侯王、列侯，受郡、國計。"
  },
  {
    "id": "s0136",
    "blockIndex": 10,
    "zh": "夏，四月，赦天下，所幸縣毋出今年租賦。"
  },
  {
    "id": "s0137",
    "blockIndex": 10,
    "zh": "還，幸甘泉，郊泰畤。"
  },
  {
    "id": "s0138",
    "blockIndex": 10,
    "zh": "----2長平烈侯衛青薨。"
  },
  {
    "id": "s0139",
    "blockIndex": 10,
    "zh": "起塚，像廬山。"
  },
  {
    "id": "s0140",
    "blockIndex": 10,
    "zh": "----3上既攘卻胡、越，開地斥境，乃置交趾、朔方之州，及冀、幽、并、兗、徐、青、揚、荊、豫、益、涼等州，凡十三部，皆置刺史焉。"
  },
  {
    "id": "s0141",
    "blockIndex": 10,
    "zh": "----4上以名臣文武欲盡，乃下詔曰：「蓋有非常之功，必待非常之人。"
  },
  {
    "id": "s0142",
    "blockIndex": 10,
    "zh": "故馬或奔踶而致千里，士或有負俗之累而立功名。"
  },
  {
    "id": "s0143",
    "blockIndex": 10,
    "zh": "夫泛駕之馬，跅弛之士，亦在御之而已。"
  },
  {
    "id": "s0144",
    "blockIndex": 10,
    "zh": "其令州、郡察吏、民有茂才、異等可為將、相及使絕國者。"
  },
  {
    "id": "s0145",
    "blockIndex": 10,
    "zh": "」----1冬，上行幸回中。"
  },
  {
    "id": "s0146",
    "blockIndex": 10,
    "zh": "----2春，作首山宮。"
  },
  {
    "id": "s0147",
    "blockIndex": 10,
    "zh": "----3三月，行幸河東，祠-{后土}-，赦汾陰殊死以下。"
  },
  {
    "id": "s0148",
    "blockIndex": 10,
    "zh": "----4漢既通西南夷，開五郡，欲地接以前通大夏，歲遣使十餘輩出此初郡，皆閉昆明，為所殺，奪幣物。"
  },
  {
    "id": "s0149",
    "blockIndex": 10,
    "zh": "於是天子赦京師亡命，令從軍，遣拔胡將軍郭昌將以擊之，斬首數十萬。"
  },
  {
    "id": "s0150",
    "blockIndex": 10,
    "zh": "後復遣使，竟不得通。"
  },
  {
    "id": "s0151",
    "blockIndex": 10,
    "zh": "----5秋，大旱，蝗。"
  },
  {
    "id": "s0152",
    "blockIndex": 10,
    "zh": "----6烏孫使者見漢廣大，歸報其國，其國乃益重漢。"
  },
  {
    "id": "s0153",
    "blockIndex": 10,
    "zh": "匈奴聞烏孫與漢通，怒，欲擊之。"
  },
  {
    "id": "s0154",
    "blockIndex": 10,
    "zh": "又其旁大宛、月氏之屬皆事漢，烏孫於是恐，使使願得尚漢公主，為昆弟。"
  },
  {
    "id": "s0155",
    "blockIndex": 10,
    "zh": "天子與群臣議，許之。"
  },
  {
    "id": "s0156",
    "blockIndex": 10,
    "zh": "烏孫以千匹馬往聘漢女。"
  },
  {
    "id": "s0157",
    "blockIndex": 10,
    "zh": "漢以江都王建女細君為公主，往妻烏孫，贈送甚盛；"
  },
  {
    "id": "s0158",
    "blockIndex": 10,
    "zh": "烏孫王昆莫以為右夫人。"
  },
  {
    "id": "s0159",
    "blockIndex": 10,
    "zh": "匈奴亦遣女妻昆莫，以為左夫人。"
  },
  {
    "id": "s0160",
    "blockIndex": 10,
    "zh": "公主自治宮室居，歲時一再與昆莫會，置酒飲食。"
  },
  {
    "id": "s0161",
    "blockIndex": 10,
    "zh": "昆莫年老，言語不通，公主悲愁思歸，天子聞而憐之，間歲遣使者以帷帳錦繡給遺焉。"
  },
  {
    "id": "s0162",
    "blockIndex": 10,
    "zh": "昆莫曰：「我老。"
  },
  {
    "id": "s0163",
    "blockIndex": 10,
    "zh": "」欲使其孫岑娶尚公主。"
  },
  {
    "id": "s0164",
    "blockIndex": 10,
    "zh": "公主不聽，上書言狀。"
  },
  {
    "id": "s0165",
    "blockIndex": 10,
    "zh": "天子報曰：「從其國俗，欲與烏孫共滅胡。"
  },
  {
    "id": "s0166",
    "blockIndex": 10,
    "zh": "」岑娶遂妻公主。"
  },
  {
    "id": "s0167",
    "blockIndex": 10,
    "zh": "昆莫死，岑娶代立，為昆彌。"
  },
  {
    "id": "s0168",
    "blockIndex": 11,
    "zh": "是時，漢使西逾蔥嶺，抵安息。"
  },
  {
    "id": "s0169",
    "blockIndex": 11,
    "zh": "安息發使，以大鳥卵及黎軒善眩人獻於漢，及諸小國驩潛、大益、車姑師、扜冞、蘇䪥之屬，皆隨漢使獻見天子，天子大悅。"
  },
  {
    "id": "s0170",
    "blockIndex": 11,
    "zh": "西國使更來更去，天子每巡狩海上，悉從外國客，大都、多人則過之，散財帛以賞賜，厚具以饒給之，以覽示漢富厚焉。"
  },
  {
    "id": "s0171",
    "blockIndex": 11,
    "zh": "大角抵，出奇戲、諸怪物，多聚觀者。"
  },
  {
    "id": "s0172",
    "blockIndex": 11,
    "zh": "行賞賜，酒池肉林，令外國客遍觀名倉庫府藏之積，見漢之廣大，傾駭之。"
  },
  {
    "id": "s0173",
    "blockIndex": 11,
    "zh": "大宛左右多蒲萄，可以為酒；"
  },
  {
    "id": "s0174",
    "blockIndex": 11,
    "zh": "多苜蓿，天馬嗜之；"
  },
  {
    "id": "s0175",
    "blockIndex": 11,
    "zh": "漢使采其實以來，天子種之於離宮別觀旁，極望。"
  },
  {
    "id": "s0176",
    "blockIndex": 11,
    "zh": "然西域以近匈奴，常畏匈奴使，待之過於漢使焉。"
  },
  {
    "id": "s0177",
    "blockIndex": 11,
    "zh": "----7是歲，匈奴烏維單于死，子烏師廬立，年少，號「兒單于」。"
  },
  {
    "id": "s0178",
    "blockIndex": 11,
    "zh": "自此之後，單于益西北徙，左方兵直雲中，右方直酒泉、敦煌郡。"
  },
  {
    "id": "s0179",
    "blockIndex": 12,
    "zh": "1冬，十月，上行幸泰山。"
  },
  {
    "id": "s0180",
    "blockIndex": 12,
    "zh": "十一月，甲子朔旦，冬至，祠上帝於明堂。"
  },
  {
    "id": "s0181",
    "blockIndex": 12,
    "zh": "東至海上，考入海及方士求神者莫驗；"
  },
  {
    "id": "s0182",
    "blockIndex": 12,
    "zh": "然益遣，冀遇之。"
  },
  {
    "id": "s0183",
    "blockIndex": 12,
    "zh": "----2乙酉，柏梁台災。"
  },
  {
    "id": "s0184",
    "blockIndex": 12,
    "zh": "----3十二月，甲午朔，上親禪-{高里}-，祠-{后土}-，臨勃海，將以望祀蓬萊之屬，冀至殊廷焉。"
  },
  {
    "id": "s0185",
    "blockIndex": 12,
    "zh": "春，上還，以柏梁災，故朝諸侯，受計於甘泉。"
  },
  {
    "id": "s0186",
    "blockIndex": 12,
    "zh": "甘泉作諸侯邸。"
  },
  {
    "id": "s0187",
    "blockIndex": 13,
    "zh": "越人勇之曰：「越俗，有火災復起屋，必以大，用勝服之。"
  },
  {
    "id": "s0188",
    "blockIndex": 13,
    "zh": "」於是作建章宮，度為千門萬戶。"
  },
  {
    "id": "s0189",
    "blockIndex": 13,
    "zh": "其東則鳳闕，高二十餘丈；"
  },
  {
    "id": "s0190",
    "blockIndex": 13,
    "zh": "其西則唐中，數十里虎圈；"
  },
  {
    "id": "s0191",
    "blockIndex": 13,
    "zh": "其北治大池，漸台高二十餘丈，命曰太液池，中有蓬萊、方丈、瀛洲、壺梁，象海中神山、龜魚之屬；"
  },
  {
    "id": "s0192",
    "blockIndex": 13,
    "zh": "其南有玉堂、璧門、大鳥之屬。"
  },
  {
    "id": "s0193",
    "blockIndex": 13,
    "zh": "立神明台、井幹樓，度五十丈，輦道相屬焉。"
  },
  {
    "id": "s0194",
    "blockIndex": 13,
    "zh": "----4大中大夫公孫卿、壺遂、太史令司馬遷等言：「曆紀壞廢，宜改正朔。"
  },
  {
    "id": "s0195",
    "blockIndex": 13,
    "zh": "」上詔兒寬與博士賜等共議，以為宜用夏正。"
  },
  {
    "id": "s0196",
    "blockIndex": 13,
    "zh": "夏，五月，詔卿、遂、遷等共造漢《太初曆》，以正月為歲首，色上黃，數用五，定官名，協音律，定宗廟百官之儀，以為典常，垂之後世-{云}-。"
  },
  {
    "id": "s0197",
    "blockIndex": 13,
    "zh": "----5匈奴兒單于好殺伐，國人不安；"
  },
  {
    "id": "s0198",
    "blockIndex": 13,
    "zh": "又有天災，畜多死。"
  },
  {
    "id": "s0199",
    "blockIndex": 13,
    "zh": "左大都尉使人間告漢曰：「我欲殺單于降漢，漢遠，即兵來迎我，我即發。"
  },
  {
    "id": "s0200",
    "blockIndex": 13,
    "zh": "」上乃遣因杅將軍公孫敖築塞外受降城以應之。"
  },
  {
    "id": "s0201",
    "blockIndex": 13,
    "zh": "----6秋，八月，上行幸安定。"
  },
  {
    "id": "s0202",
    "blockIndex": 13,
    "zh": "----7漢使入西域者言：「宛有善馬，在貳師城，匿不肯與漢使。"
  },
  {
    "id": "s0203",
    "blockIndex": 13,
    "zh": "」天子使壯士車令等持千金及金馬以請之。"
  },
  {
    "id": "s0204",
    "blockIndex": 13,
    "zh": "宛王與其群臣謀曰：「漢去我遠，而鹽水中數敗，出其北有胡寇，出其南乏水草，又且往往而絕邑，乏食者多，漢使數百人為輩來，而常乏食，死者過半，是安能致大軍乎！"
  },
  {
    "id": "s0205",
    "blockIndex": 13,
    "zh": "無奈我何。"
  },
  {
    "id": "s0206",
    "blockIndex": 13,
    "zh": "貳師馬，宛寶馬也。"
  },
  {
    "id": "s0207",
    "blockIndex": 13,
    "zh": "」遂不肯予漢使。"
  },
  {
    "id": "s0208",
    "blockIndex": 13,
    "zh": "漢使怒，妄言，椎金馬而去。"
  },
  {
    "id": "s0209",
    "blockIndex": 13,
    "zh": "宛貴人怒曰：「漢使至輕我！"
  },
  {
    "id": "s0210",
    "blockIndex": 13,
    "zh": "」遣漢使去，令其東邊郁成王遮攻，殺漢使，取其財物。"
  },
  {
    "id": "s0211",
    "blockIndex": 14,
    "zh": "於是天子大怒。"
  },
  {
    "id": "s0212",
    "blockIndex": 14,
    "zh": "諸嘗使宛姚定漢等言：「宛兵弱，誠以漢兵不過三千人，強弩射之，可盡虜矣。"
  },
  {
    "id": "s0213",
    "blockIndex": 14,
    "zh": "」天子嘗使浞野侯以七百騎虜樓蘭王，以定漢等言為然；"
  },
  {
    "id": "s0214",
    "blockIndex": 14,
    "zh": "而欲侯寵姬李氏，乃拜李夫人兄廣利為貳師將軍，發屬國六千騎及郡國惡少年數萬人，以往伐宛。"
  },
  {
    "id": "s0215",
    "blockIndex": 14,
    "zh": "期至貳師城取善馬，故號貳師將軍。"
  },
  {
    "id": "s0216",
    "blockIndex": 14,
    "zh": "趙始成為軍正，故浩侯王恢使導軍，而李哆為校尉，制軍事。"
  },
  {
    "id": "s0217",
    "blockIndex": 15,
    "zh": ":臣光曰：武帝欲侯寵姬李氏，而使廣利將兵伐宛，其意以為非有功不侯，不欲負高帝之約也。"
  },
  {
    "id": "s0218",
    "blockIndex": 15,
    "zh": "夫軍旅大事，國之安危、民之死生系焉。"
  },
  {
    "id": "s0219",
    "blockIndex": 15,
    "zh": "苟為不擇賢愚而授之，欲徼幸咫尺之功，藉以為名而私其所愛，不若無功而侯之為愈也。"
  },
  {
    "id": "s0220",
    "blockIndex": 15,
    "zh": "然則武帝有見於封國，無見於置將；"
  },
  {
    "id": "s0221",
    "blockIndex": 15,
    "zh": "謂之能守先帝之約，臣曰過矣。"
  },
  {
    "id": "s0222",
    "blockIndex": 15,
    "zh": "----8中尉王溫舒坐為奸利，罪當族，自殺；"
  },
  {
    "id": "s0223",
    "blockIndex": 15,
    "zh": "時兩弟及兩婚家亦各自坐佗罪而族。"
  },
  {
    "id": "s0224",
    "blockIndex": 15,
    "zh": "光祿勳徐自為曰：「悲夫！"
  },
  {
    "id": "s0225",
    "blockIndex": 15,
    "zh": "古有三族，而王溫舒罪至同時而五族乎！"
  },
  {
    "id": "s0226",
    "blockIndex": 15,
    "zh": "」----9關東蝗大起，飛西至敦煌。"
  },
  {
    "id": "s0228",
    "blockIndex": 16,
    "zh": "1春，正月，戊申，牧丘恬侯石慶薨。"
  },
  {
    "id": "s0229",
    "blockIndex": 16,
    "zh": "----2閏月，丁丑，以太僕公孫賀為丞相，封葛繹侯。"
  },
  {
    "id": "s0230",
    "blockIndex": 16,
    "zh": "時朝廷多事，督責大臣，自公孫弘後，丞相比坐事死。"
  },
  {
    "id": "s0231",
    "blockIndex": 16,
    "zh": "石慶雖以謹得終，然數被譴。"
  },
  {
    "id": "s0232",
    "blockIndex": 16,
    "zh": "賀引拜為丞相，不受印綬，頓首涕泣不肯起。"
  },
  {
    "id": "s0233",
    "blockIndex": 16,
    "zh": "上乃起去，賀不得已，拜，出曰：「我從是殆矣！"
  },
  {
    "id": "s0234",
    "blockIndex": 16,
    "zh": "」----3三月，上行幸河東，祠-{后土}-。"
  },
  {
    "id": "s0235",
    "blockIndex": 16,
    "zh": "----4夏，五月，籍吏民馬補車騎馬。"
  },
  {
    "id": "s0236",
    "blockIndex": 16,
    "zh": "----5秋，蝗。"
  },
  {
    "id": "s0237",
    "blockIndex": 16,
    "zh": "----6貳師將軍之西也，既過鹽水，當道小國各城守，不肯給食，攻之不能下。"
  },
  {
    "id": "s0238",
    "blockIndex": 16,
    "zh": "下者得食，不下者數日則去。"
  },
  {
    "id": "s0239",
    "blockIndex": 16,
    "zh": "比至郁成，士至者不過數千，皆饑罷。"
  },
  {
    "id": "s0240",
    "blockIndex": 16,
    "zh": "攻郁成，郁成大破之，所殺傷甚眾。"
  },
  {
    "id": "s0241",
    "blockIndex": 16,
    "zh": "貳師將軍與李哆、趙始成等計：「至郁成尚不能舉，況至其王都乎！"
  },
  {
    "id": "s0242",
    "blockIndex": 16,
    "zh": "」引兵而還。"
  },
  {
    "id": "s0243",
    "blockIndex": 16,
    "zh": "至敦煌，士不過什一二，使使上書言：「道遠乏食，且士卒不患戰而患饑，人少，不足以拔宛。"
  },
  {
    "id": "s0244",
    "blockIndex": 16,
    "zh": "願且罷兵，益發而復往。"
  },
  {
    "id": "s0245",
    "blockIndex": 16,
    "zh": "」天子聞之，大怒，使使遮玉門曰：「軍有敢入者，輒斬之！"
  },
  {
    "id": "s0246",
    "blockIndex": 16,
    "zh": "」貳師恐，因留敦煌。"
  },
  {
    "id": "s0247",
    "blockIndex": 16,
    "zh": "----7上猶以受降城去匈奴遠，遣浚稽將軍趙破奴將二萬餘騎出朔方西北二千餘里，期至浚稽山而還。"
  },
  {
    "id": "s0248",
    "blockIndex": 16,
    "zh": "浞野侯既至期，左大都尉欲發而覺，單于誅之，發左方兵擊浞野侯。"
  },
  {
    "id": "s0249",
    "blockIndex": 16,
    "zh": "浞野侯行捕首虜，得數千人，還，未至受降城四百里，匈奴兵八萬騎圍之。"
  },
  {
    "id": "s0250",
    "blockIndex": 16,
    "zh": "浞野侯夜自出求水，匈奴間捕生得浞野侯，因急擊其軍，軍吏畏亡將而誅，莫相勸歸者，軍遂沒於匈奴。"
  },
  {
    "id": "s0251",
    "blockIndex": 16,
    "zh": "兒單于大喜，因遣奇兵攻受降城，不能下，乃寇入邊而去。"
  },
  {
    "id": "s0252",
    "blockIndex": 16,
    "zh": "----8冬，十二月，兒寬卒。"
  },
  {
    "id": "s0254",
    "blockIndex": 17,
    "zh": "1春，正月，膠東太守延廣為御史大夫。"
  },
  {
    "id": "s0255",
    "blockIndex": 17,
    "zh": "----2上東巡海上，考神仙之屬皆無驗，令祠官禮東泰山。"
  },
  {
    "id": "s0256",
    "blockIndex": 17,
    "zh": "夏，四月，還，修封泰山，禪石閭。"
  },
  {
    "id": "s0257",
    "blockIndex": 17,
    "zh": "----3匈奴兒單于死，子年少，匈奴立其季父右賢王呴犁湖為單于。"
  },
  {
    "id": "s0258",
    "blockIndex": 17,
    "zh": "----4上遣光祿勳徐自為出五原塞數百里，遠者千餘里，築城、障、列亭，西北至廬朐，而使游擊將軍韓說、長平侯衛伉屯其旁；"
  },
  {
    "id": "s0259",
    "blockIndex": 17,
    "zh": "使強弩都尉路博德築居延澤上。"
  },
  {
    "id": "s0260",
    "blockIndex": 17,
    "zh": "秋，匈奴大入定襄、雲中，殺略數千人，敗數二千石而去，行破壞光祿所築城、列亭、障；"
  },
  {
    "id": "s0261",
    "blockIndex": 17,
    "zh": "又使右賢王入酒泉、張掖，略數千人。"
  },
  {
    "id": "s0262",
    "blockIndex": 17,
    "zh": "會軍正任文擊救，盡復失所得而去。"
  },
  {
    "id": "s0263",
    "blockIndex": 17,
    "zh": "----5是歲，睢陽侯張昌坐為太常乏祠，國除。"
  },
  {
    "id": "s0264",
    "blockIndex": 18,
    "zh": "初，高祖封功臣為列侯百四十有三人。"
  },
  {
    "id": "s0265",
    "blockIndex": 18,
    "zh": "時兵革之餘，大城、名都民人散亡，戶口可得而數，裁什二三。"
  },
  {
    "id": "s0266",
    "blockIndex": 18,
    "zh": "大侯不過萬家，小者五六百戶。"
  },
  {
    "id": "s0267",
    "blockIndex": 18,
    "zh": "其封爵之誓曰：「使黃河如帶，泰山若厲，國以永存，爰及苗裔。"
  },
  {
    "id": "s0268",
    "blockIndex": 18,
    "zh": "」申以丹書之信，重以白馬之盟。"
  },
  {
    "id": "s0269",
    "blockIndex": 18,
    "zh": "及-{高后}-時，盡差第列侯位次，藏諸宗廟，副在有司。"
  },
  {
    "id": "s0270",
    "blockIndex": 18,
    "zh": "逮文、景，四五世間，流民既歸，戶口亦息，列侯大者至三四萬戶，小國自倍，富厚如之。"
  },
  {
    "id": "s0271",
    "blockIndex": 18,
    "zh": "子孫驕逸，多抵法禁，隕身失國，至是見侯裁四人，罔亦少密焉。"
  },
  {
    "id": "s0272",
    "blockIndex": 18,
    "zh": "----6漢既亡浞野之兵，公卿議者皆願罷宛軍，專力攻胡。"
  },
  {
    "id": "s0273",
    "blockIndex": 18,
    "zh": "天子業出兵誅宛，宛小國而不能下，則大夏之屬漸輕漢，而宛善馬絕不來，烏孫、輪台易苦漢使，為外國笑，乃案言伐宛尤不便者鄧光等。"
  },
  {
    "id": "s0274",
    "blockIndex": 18,
    "zh": "赦囚徒，發惡少年及邊騎，歲餘而出敦煌者六萬人，負私從者不與，牛十萬，馬三萬匹，驢、橐駝以萬數，繼糧、兵弩甚設。"
  },
  {
    "id": "s0275",
    "blockIndex": 18,
    "zh": "天下騷動，轉相奉伐宛五十餘校尉。"
  },
  {
    "id": "s0276",
    "blockIndex": 18,
    "zh": "宛城中無井，汲城外流水，於是遣水工徙其城下水，空以穴其城。"
  },
  {
    "id": "s0277",
    "blockIndex": 18,
    "zh": "益發戍甲卒十八萬酒泉、張掖北，置居延、休屠屯兵以衛酒泉，而發天下吏有罪者、亡命者及贅婿、賈人、故有市籍、父母大父母有市籍者凡七科，適為兵；"
  },
  {
    "id": "s0278",
    "blockIndex": 18,
    "zh": "及載糒給貳師，轉車人徒相連屬；"
  },
  {
    "id": "s0279",
    "blockIndex": 18,
    "zh": "而拜習馬者二人為執、驅馬校尉，備破宛擇取其善馬-{云}-。"
  },
  {
    "id": "s0280",
    "blockIndex": 19,
    "zh": "於是貳師後復行，兵多，所至小國莫不迎，出食給軍。"
  },
  {
    "id": "s0281",
    "blockIndex": 19,
    "zh": "至輪台，輪台不下。"
  },
  {
    "id": "s0282",
    "blockIndex": 19,
    "zh": "攻數日，屠之。"
  },
  {
    "id": "s0283",
    "blockIndex": 19,
    "zh": "自此而西，平行至宛城，兵到者三萬。"
  },
  {
    "id": "s0284",
    "blockIndex": 19,
    "zh": "宛兵迎擊漢兵，漢兵射敗之，宛兵走入，保其城。"
  },
  {
    "id": "s0285",
    "blockIndex": 19,
    "zh": "貳師欲攻郁成城，恐留行而令宛益生詐，乃先至宛，決其水原移之，則宛固已憂困，圍其城，攻之四十餘日。"
  },
  {
    "id": "s0286",
    "blockIndex": 19,
    "zh": "宛貴人謀曰：「王毋寡匿善馬，殺漢使，今殺王而出善馬，漢兵宜解；"
  },
  {
    "id": "s0287",
    "blockIndex": 19,
    "zh": "即不解，乃力戰而死，未晚也。"
  },
  {
    "id": "s0288",
    "blockIndex": 19,
    "zh": "」宛貴人皆以為然，共殺王。"
  },
  {
    "id": "s0289",
    "blockIndex": 19,
    "zh": "其外城壞，虜宛貴人勇將煎靡。"
  },
  {
    "id": "s0290",
    "blockIndex": 19,
    "zh": "宛大恐，走入城中，持王毋寡頭，遣人使貳師，約曰：「漢無攻我，我盡出善馬恣所取，而給漢軍食。"
  },
  {
    "id": "s0291",
    "blockIndex": 19,
    "zh": "即不聽我，我盡殺善馬，康居之救又且至，至，我居內，康居居外，與漢軍戰。"
  },
  {
    "id": "s0292",
    "blockIndex": 19,
    "zh": "孰計之，何從？"
  },
  {
    "id": "s0293",
    "blockIndex": 19,
    "zh": "」是時，康居候視漢兵尚盛，不敢進。"
  },
  {
    "id": "s0294",
    "blockIndex": 19,
    "zh": "貳師聞宛城中新得漢人，知穿井，而其內食尚多，計以為「來誅首惡者毋寡，毋寡頭已至，如此不許則堅守，而康居候漢兵罷來救宛，破漢兵必矣」，乃許宛之約。"
  },
  {
    "id": "s0295",
    "blockIndex": 19,
    "zh": "宛乃出其馬，令漢自擇之，而多出食食漢軍。"
  },
  {
    "id": "s0296",
    "blockIndex": 19,
    "zh": "漢軍取其善馬數十匹，中馬以下牝牡三千餘匹，而立宛貴人之故時遇漢善者名昧蔡為宛王，與盟而罷兵。"
  },
  {
    "id": "s0297",
    "blockIndex": 20,
    "zh": "初，貳師起敦煌西，分為數軍，從南、北道。"
  },
  {
    "id": "s0298",
    "blockIndex": 20,
    "zh": "校尉王申生將千餘人別至郁成，郁成王擊滅之，數人脫亡，走貳師。"
  },
  {
    "id": "s0299",
    "blockIndex": 20,
    "zh": "貳師令搜粟都尉上官桀往攻郁成，郁成王亡走康居，桀追至康居。"
  },
  {
    "id": "s0300",
    "blockIndex": 20,
    "zh": "康居聞漢已破宛，出郁成王與桀，桀令四騎士縛守詣貳師。"
  },
  {
    "id": "s0301",
    "blockIndex": 20,
    "zh": "上邽騎士趙弟恐失郁成王，拔劍擊斬其首，追及貳師。"
  },
  {
    "id": "s0303",
    "blockIndex": 21,
    "zh": "1春，貳師將軍來至京師。"
  },
  {
    "id": "s0304",
    "blockIndex": 21,
    "zh": "貳師所過小國聞宛破，皆使其子弟從入貢獻，見天子，因為質焉。"
  },
  {
    "id": "s0305",
    "blockIndex": 21,
    "zh": "軍還，入馬千餘匹。"
  },
  {
    "id": "s0306",
    "blockIndex": 21,
    "zh": "後行，軍非乏食，戰死不甚多，而將吏貪，不愛卒，侵牟之，以此物故者眾。"
  },
  {
    "id": "s0307",
    "blockIndex": 21,
    "zh": "天子為萬里而伐，不錄其過，乃下詔封李廣利為海西侯，封趙弟為新畤侯，以上官桀為少府，軍官吏為九卿者三人，諸侯相、郡守、二千石百餘人，千石以下千餘人，奮行者官過其望，以謫過行，皆黜其勞，士卒賜直四萬錢。"
  },
  {
    "id": "s0308",
    "blockIndex": 22,
    "zh": "匈奴聞貳師征大宛，欲遮之，貳師兵盛，不敢當，即遣騎因樓蘭候漢使後過者，欲絕勿通。"
  },
  {
    "id": "s0309",
    "blockIndex": 22,
    "zh": "時漢軍正任文將兵屯玉門關，捕得生口，知狀以聞。"
  },
  {
    "id": "s0310",
    "blockIndex": 22,
    "zh": "上詔文便道引兵捕樓蘭王，將詣闕簿責。"
  },
  {
    "id": "s0311",
    "blockIndex": 22,
    "zh": "王對曰：「小國在大國間，不兩屬無以自安，願徙國入居漢地。"
  },
  {
    "id": "s0312",
    "blockIndex": 22,
    "zh": "」上直其言，遣歸國，亦因使候司匈奴，匈奴自是不甚親信樓蘭。"
  },
  {
    "id": "s0313",
    "blockIndex": 23,
    "zh": "自大宛破後，西域震懼，漢使入西域者益得職。"
  },
  {
    "id": "s0314",
    "blockIndex": 23,
    "zh": "於是自敦煌西至鹽澤往往起亭，而輪台、渠犁皆有田卒數百人，置使者、校尉領護，以給使外國者。"
  },
  {
    "id": "s0315",
    "blockIndex": 24,
    "zh": "後歲餘，宛貴人以為昧蔡善諛，使我國遇屠，乃相與殺昧蔡，立毋寡昆弟蟬封為宛王，而遣其子入侍於漢。"
  },
  {
    "id": "s0316",
    "blockIndex": 24,
    "zh": "漢因使使賂賜，以鎮撫之。"
  },
  {
    "id": "s0317",
    "blockIndex": 24,
    "zh": "蟬封與漢約，歲獻天馬二匹。"
  },
  {
    "id": "s0318",
    "blockIndex": 24,
    "zh": "----2秋，起明光宮。"
  },
  {
    "id": "s0319",
    "blockIndex": 24,
    "zh": "----3冬，上行幸回中。"
  },
  {
    "id": "s0320",
    "blockIndex": 24,
    "zh": "----4匈奴呴犁湖單于死，匈奴立其弟左大都尉且鞮侯為單于。"
  },
  {
    "id": "s0321",
    "blockIndex": 24,
    "zh": "天子欲因伐宛之威遂困胡，乃下詔曰：「高皇帝遺朕平城之憂，-{高后}-時，單于書絕悖逆。"
  },
  {
    "id": "s0322",
    "blockIndex": 24,
    "zh": "昔齊襄公復九世之讎，《春秋》大之。"
  },
  {
    "id": "s0323",
    "blockIndex": 24,
    "zh": "」且鞮侯單于初立，恐漢襲之，乃曰：「我兒子，安敢望漢天子！"
  },
  {
    "id": "s0324",
    "blockIndex": 24,
    "zh": "漢天子，我丈人行也。"
  },
  {
    "id": "s0325",
    "blockIndex": 24,
    "zh": "」因盡歸漢使之不降者路充國等，使使來獻。"
  },
  {
    "id": "s0327",
    "blockIndex": 25,
    "zh": "1春，正月，上行幸甘泉，郊泰畤。"
  },
  {
    "id": "s0328",
    "blockIndex": 25,
    "zh": "三月，行幸河東，祠-{后土}-。"
  },
  {
    "id": "s0329",
    "blockIndex": 25,
    "zh": "----2上嘉匈奴單于之義，遣中郎將蘇武送匈奴使留在漢者，因厚賂單于，答其善意。"
  },
  {
    "id": "s0330",
    "blockIndex": 25,
    "zh": "武與副中郎將張勝與假吏常惠等俱。"
  },
  {
    "id": "s0331",
    "blockIndex": 25,
    "zh": "既至匈奴，置幣遣單于。"
  },
  {
    "id": "s0332",
    "blockIndex": 25,
    "zh": "單于益驕，非漢所望也。"
  },
  {
    "id": "s0333",
    "blockIndex": 26,
    "zh": "會緱王與長水虞常等及衛律所將降者，陰相與謀劫單于母閼氏歸漢。"
  },
  {
    "id": "s0334",
    "blockIndex": 26,
    "zh": "衛律者，父故長水胡人，律善協律都尉李延年，延年薦言律使於匈奴，使還，聞延年家收，遂亡降匈奴。"
  },
  {
    "id": "s0335",
    "blockIndex": 26,
    "zh": "單于愛之，與謀國事，立為丁靈王。"
  },
  {
    "id": "s0336",
    "blockIndex": 26,
    "zh": "虞常在漢時素與副張勝相知，私候勝曰：「聞漢天子甚怨衛律，常能為漢伏弩射殺之。"
  },
  {
    "id": "s0337",
    "blockIndex": 26,
    "zh": "吾母、弟在漢，幸蒙其賞賜。"
  },
  {
    "id": "s0338",
    "blockIndex": 26,
    "zh": "」張勝許之，以貨物與常。"
  },
  {
    "id": "s0339",
    "blockIndex": 26,
    "zh": "後月餘，單于出獵，獨閼氏、子弟在，虞常等七十餘人欲發，其一人夜亡告之。"
  },
  {
    "id": "s0340",
    "blockIndex": 26,
    "zh": "單于子弟發兵與戰，緱王等皆死，虞常生得。"
  },
  {
    "id": "s0341",
    "blockIndex": 27,
    "zh": "單于使衛律治其事。"
  },
  {
    "id": "s0342",
    "blockIndex": 27,
    "zh": "張勝聞之，恐前語發，以狀語武。"
  },
  {
    "id": "s0343",
    "blockIndex": 27,
    "zh": "武曰：「事如此，此必及我，見犯乃死，重負國。"
  },
  {
    "id": "s0344",
    "blockIndex": 27,
    "zh": "」欲自殺。"
  },
  {
    "id": "s0345",
    "blockIndex": 27,
    "zh": "勝、惠共止之。"
  },
  {
    "id": "s0346",
    "blockIndex": 27,
    "zh": "虞常果引張勝。"
  },
  {
    "id": "s0347",
    "blockIndex": 27,
    "zh": "單于怒，召諸貴人議，欲殺漢使者。"
  },
  {
    "id": "s0348",
    "blockIndex": 27,
    "zh": "左伊秩訾曰：「即謀單于，何以復加！"
  },
  {
    "id": "s0349",
    "blockIndex": 27,
    "zh": "宜皆降之。"
  },
  {
    "id": "s0350",
    "blockIndex": 27,
    "zh": "」單于使衛律召武受辭。"
  },
  {
    "id": "s0351",
    "blockIndex": 27,
    "zh": "武謂惠等：「屈節辱命，雖生，何面目以歸漢！"
  },
  {
    "id": "s0352",
    "blockIndex": 27,
    "zh": "」引佩刀自刺。"
  },
  {
    "id": "s0353",
    "blockIndex": 27,
    "zh": "衛律驚，自抱持武，馳召醫，鑿地為坎，置熅火，覆武其上，蹈其背以出血。"
  },
  {
    "id": "s0354",
    "blockIndex": 27,
    "zh": "武氣絕，半日復息。"
  },
  {
    "id": "s0355",
    "blockIndex": 27,
    "zh": "惠等哭，輿歸營。"
  },
  {
    "id": "s0356",
    "blockIndex": 27,
    "zh": "單于壯其節，朝夕遣人候問武，而收系張勝。"
  },
  {
    "id": "s0357",
    "blockIndex": 28,
    "zh": "武益愈，單于使使曉武，欲降之，會論虞常，欲因此時降武；"
  },
  {
    "id": "s0358",
    "blockIndex": 28,
    "zh": "劍斬虞常已，律曰：「漢使張勝謀殺單于近臣，當死，單于募降者赦罪。"
  },
  {
    "id": "s0359",
    "blockIndex": 28,
    "zh": "」舉劍欲擊之，勝請降。"
  },
  {
    "id": "s0360",
    "blockIndex": 28,
    "zh": "律謂武曰：「副有罪，當相坐。"
  },
  {
    "id": "s0361",
    "blockIndex": 28,
    "zh": "」武曰：「本無謀，又非親屬，何謂相坐！"
  },
  {
    "id": "s0362",
    "blockIndex": 28,
    "zh": "」復舉劍擬之，武不動。"
  },
  {
    "id": "s0363",
    "blockIndex": 28,
    "zh": "律曰：「蘇君，律前負漢歸匈奴，幸蒙大恩賜號稱王，擁眾數萬，馬畜彌山，富貴如此！"
  },
  {
    "id": "s0364",
    "blockIndex": 28,
    "zh": "蘇君今日降，明日復然；"
  },
  {
    "id": "s0365",
    "blockIndex": 28,
    "zh": "空以身膏草野，誰復知之！"
  },
  {
    "id": "s0366",
    "blockIndex": 28,
    "zh": "」武不應。"
  },
  {
    "id": "s0367",
    "blockIndex": 28,
    "zh": "律曰：「君因我降，與君為兄弟；"
  },
  {
    "id": "s0368",
    "blockIndex": 28,
    "zh": "今不聽吾計，後雖欲復見我，尚可得乎！"
  },
  {
    "id": "s0369",
    "blockIndex": 28,
    "zh": "」武罵律曰：「汝為人臣子，不顧恩義，畔主背親，為降虜於蠻夷，何以汝為見！"
  },
  {
    "id": "s0370",
    "blockIndex": 28,
    "zh": "且單于信汝，使決人死生，不平心持正，反欲鬥兩主，觀禍敗。"
  },
  {
    "id": "s0371",
    "blockIndex": 28,
    "zh": "南越殺漢使者，屠為九郡；"
  },
  {
    "id": "s0372",
    "blockIndex": 28,
    "zh": "宛王殺漢使者，頭懸北闕；"
  },
  {
    "id": "s0373",
    "blockIndex": 28,
    "zh": "朝鮮殺漢使者，即時誅滅；"
  },
  {
    "id": "s0374",
    "blockIndex": 28,
    "zh": "獨匈奴未耳。"
  },
  {
    "id": "s0375",
    "blockIndex": 28,
    "zh": "若知我不降明，欲令兩國相攻，匈奴之禍從我始矣。"
  },
  {
    "id": "s0376",
    "blockIndex": 28,
    "zh": "」律知武終不可脅，白單于，單于愈益欲降之。"
  },
  {
    "id": "s0377",
    "blockIndex": 28,
    "zh": "乃幽武置大窖中，絕不飲食；"
  },
  {
    "id": "s0378",
    "blockIndex": 28,
    "zh": "天雨雪，武臥，嚙雪與旃毛並咽之，數日不死。"
  },
  {
    "id": "s0379",
    "blockIndex": 28,
    "zh": "匈奴以為神，乃徙武北海上無人處，使牧羝，曰：「羝乳乃得歸。"
  },
  {
    "id": "s0380",
    "blockIndex": 28,
    "zh": "」別其官屬常惠等，各置他所。"
  },
  {
    "id": "s0381",
    "blockIndex": 28,
    "zh": "----3天雨白牦。"
  },
  {
    "id": "s0382",
    "blockIndex": 28,
    "zh": "----4夏，大旱。"
  },
  {
    "id": "s0383",
    "blockIndex": 28,
    "zh": "----5五月，赦天下。"
  },
  {
    "id": "s0384",
    "blockIndex": 28,
    "zh": "----6發謫戍屯五原。"
  },
  {
    "id": "s0385",
    "blockIndex": 28,
    "zh": "----7浞野侯趙破奴自匈奴亡歸。"
  },
  {
    "id": "s0386",
    "blockIndex": 28,
    "zh": "----8是歲，濟南太守王卿為御史大夫。"
  },
  {
    "id": "s0388",
    "blockIndex": 29,
    "zh": "1春，上行幸東海。"
  },
  {
    "id": "s0389",
    "blockIndex": 29,
    "zh": "還，幸回中。"
  },
  {
    "id": "s0390",
    "blockIndex": 29,
    "zh": "----2夏，五月，遣貳師將軍廣利以三萬騎出酒泉，擊右賢王於天山，得胡首虜萬餘級而還。"
  },
  {
    "id": "s0391",
    "blockIndex": 29,
    "zh": "匈奴大圍貳師將軍，漢軍乏食數日，死傷者多。"
  },
  {
    "id": "s0392",
    "blockIndex": 29,
    "zh": "假司馬隴西趙充國與士百餘人潰圍陷陳，貳師引兵隨之，遂得解。"
  },
  {
    "id": "s0393",
    "blockIndex": 29,
    "zh": "漢兵物故什六七，充國身被二十餘創。"
  },
  {
    "id": "s0394",
    "blockIndex": 29,
    "zh": "貳師奏狀，詔征充國詣行在所，帝親見，視其創，嗟歎之，拜為中郎。"
  },
  {
    "id": "s0395",
    "blockIndex": 30,
    "zh": "漢復使因杅將軍敖出西河，與強弩都尉路博德會涿塗山，無所得。"
  },
  {
    "id": "s0396",
    "blockIndex": 31,
    "zh": "初，李廣有孫陵，為侍中，善騎射，愛人下士。"
  },
  {
    "id": "s0397",
    "blockIndex": 31,
    "zh": "帝以為有廣之風，拜騎都尉，使將丹陽、楚人五千人，教射酒泉、張掖以備胡。"
  },
  {
    "id": "s0398",
    "blockIndex": 31,
    "zh": "及貳師擊匈奴，上詔陵，欲使為貳師將輜重，陵叩頭自請曰：「臣所將屯邊者，皆荊楚勇士奇材劍客也，力扼虎，射命中，願得自當一隊，到-{蘭于}-山南以分單于兵，毋令專向貳師軍。"
  },
  {
    "id": "s0399",
    "blockIndex": 31,
    "zh": "」上曰：「將惡相屬邪！"
  },
  {
    "id": "s0400",
    "blockIndex": 31,
    "zh": "吾發軍多，無騎予女。"
  },
  {
    "id": "s0401",
    "blockIndex": 31,
    "zh": "」陵對：「無所事騎，臣願以少擊眾，步兵五千人涉單于庭。"
  },
  {
    "id": "s0402",
    "blockIndex": 31,
    "zh": "」上壯而許之。"
  },
  {
    "id": "s0403",
    "blockIndex": 31,
    "zh": "因詔路博德將兵半道迎陵軍。"
  },
  {
    "id": "s0404",
    "blockIndex": 31,
    "zh": "博德亦羞為陵後距，奏言：「方秋，匈奴馬肥，未可與戰，願留陵至春俱出。"
  },
  {
    "id": "s0405",
    "blockIndex": 31,
    "zh": "」上怒，疑陵悔不欲出而教博德上書，乃詔博德引兵擊匈奴於西河。"
  },
  {
    "id": "s0406",
    "blockIndex": 31,
    "zh": "詔陵以九月發，出遮虜障，至東浚稽山南龍勒水上，徘徊觀虜，即亡所見，還，抵受降城休士。"
  },
  {
    "id": "s0407",
    "blockIndex": 31,
    "zh": "陵於是將其步卒五千人，出居延，北行三十日，至浚稽山止營，舉圖所過山川地形，使麾下騎陳步樂還以聞。"
  },
  {
    "id": "s0408",
    "blockIndex": 31,
    "zh": "步樂召見，道陵將率得士死力，上甚悅，拜步樂為郎。"
  },
  {
    "id": "s0409",
    "blockIndex": 32,
    "zh": "陵至浚稽山，與單于相值，騎可三萬圍陵軍，軍居兩山間，以大車為營。"
  },
  {
    "id": "s0410",
    "blockIndex": 32,
    "zh": "陵引士出營外為陳，前行持戟、盾，後行持弓、弩。"
  },
  {
    "id": "s0411",
    "blockIndex": 32,
    "zh": "虜見漢軍少，直前就營。"
  },
  {
    "id": "s0412",
    "blockIndex": 32,
    "zh": "陵搏戰攻之，千弩俱發，應弦而倒。"
  },
  {
    "id": "s0413",
    "blockIndex": 32,
    "zh": "虜還走上山，漢軍追擊殺數千人。"
  },
  {
    "id": "s0414",
    "blockIndex": 32,
    "zh": "單于大驚，召左、右地兵八萬餘騎攻陵。"
  },
  {
    "id": "s0415",
    "blockIndex": 32,
    "zh": "陵且戰且引南行，數日，抵山谷中，連戰，士卒中矢傷，三創者載輦。"
  },
  {
    "id": "s0416",
    "blockIndex": 32,
    "zh": "兩創者將車，一創者持兵戰，復斬首三千餘級。"
  },
  {
    "id": "s0417",
    "blockIndex": 32,
    "zh": "引兵東南，循故龍城道行四五日，抵大澤葭葦中，虜從上風縱火，陵亦令軍中縱火以自救。"
  },
  {
    "id": "s0418",
    "blockIndex": 32,
    "zh": "南行至山下，單于在南山上，使其子將騎擊陵。"
  },
  {
    "id": "s0419",
    "blockIndex": 32,
    "zh": "陵軍步鬥樹木間，復殺數千人，因發連弩射單于，單于下走。"
  },
  {
    "id": "s0420",
    "blockIndex": 32,
    "zh": "是日捕得虜，言「單于曰：『此漢精兵，擊之不能下，日夜引吾南近塞，得無有伏兵乎？"
  },
  {
    "id": "s0421",
    "blockIndex": 32,
    "zh": "』諸當戶君長皆言：『單于自將數萬騎擊漢數千人不能滅，後無以復使邊臣，令漢益輕匈奴。"
  },
  {
    "id": "s0422",
    "blockIndex": 32,
    "zh": "復力戰山谷間，尚四五十里，得平地，不能破，乃還。"
  },
  {
    "id": "s0424",
    "blockIndex": 33,
    "zh": "是時陵軍益急，匈奴騎多，戰一日數十合，復傷殺虜二千餘人。"
  },
  {
    "id": "s0425",
    "blockIndex": 33,
    "zh": "虜不利，欲去，會陵軍候管敢為校尉所辱，亡降匈奴，具言：「陵軍無後救，射矢且盡，獨將軍麾下及校尉成安侯韓延年各八百人為前行，以黃與白為幟。"
  },
  {
    "id": "s0426",
    "blockIndex": 33,
    "zh": "當使精騎射之，即破矣。"
  },
  {
    "id": "s0427",
    "blockIndex": 33,
    "zh": "」單于得敢大喜，使騎並攻漢軍，疾呼曰：「李陵、韓延年趣降！"
  },
  {
    "id": "s0428",
    "blockIndex": 33,
    "zh": "」遂遮道急攻陵。"
  },
  {
    "id": "s0429",
    "blockIndex": 33,
    "zh": "陵居谷中，虜在山上，四面射，矢如雨下。"
  },
  {
    "id": "s0430",
    "blockIndex": 33,
    "zh": "漢軍南行，未至鞮汗山，一日五十萬矢皆盡，即棄車去。"
  },
  {
    "id": "s0431",
    "blockIndex": 33,
    "zh": "士尚三千餘人，徒斬車輻而持之，軍吏持尺刀，抵山，入狹谷，單于遮其後，乘隅下壘石，士卒多死，不得行。"
  },
  {
    "id": "s0432",
    "blockIndex": 33,
    "zh": "昏後，陵便衣獨步出營，止左右：「毋隨，丈夫一取單于耳！"
  },
  {
    "id": "s0433",
    "blockIndex": 33,
    "zh": "」良久，陵還，太息曰：「兵敗，死矣！"
  },
  {
    "id": "s0434",
    "blockIndex": 33,
    "zh": "」於是盡斬旌旗，及珍寶埋地中，陵歎曰：「復得數十矢，足以脫矣。"
  },
  {
    "id": "s0435",
    "blockIndex": 33,
    "zh": "今無兵復戰，天明，坐受縛矣。"
  },
  {
    "id": "s0436",
    "blockIndex": 33,
    "zh": "各鳥獸散，猶有得脫歸報天子者。"
  },
  {
    "id": "s0437",
    "blockIndex": 33,
    "zh": "」令軍士人持二升糒，一片冰，期至遮障者相待。"
  },
  {
    "id": "s0438",
    "blockIndex": 33,
    "zh": "夜半時，擊鼓起士，鼓不鳴。"
  },
  {
    "id": "s0439",
    "blockIndex": 33,
    "zh": "陵與韓延年俱上馬，壯士從者十餘人，虜騎數千追之，韓延年戰死。"
  },
  {
    "id": "s0440",
    "blockIndex": 33,
    "zh": "陵曰：「無面目報陛下！"
  },
  {
    "id": "s0441",
    "blockIndex": 33,
    "zh": "」遂降。"
  },
  {
    "id": "s0442",
    "blockIndex": 33,
    "zh": "軍人分散，脫至塞者四百餘人。"
  },
  {
    "id": "s0443",
    "blockIndex": 34,
    "zh": "陵敗處去塞百餘里，邊塞以聞。"
  },
  {
    "id": "s0444",
    "blockIndex": 34,
    "zh": "上欲陵死戰；"
  },
  {
    "id": "s0445",
    "blockIndex": 34,
    "zh": "後聞陵降，上怒甚，責問陳步樂，步樂自殺。"
  },
  {
    "id": "s0446",
    "blockIndex": 34,
    "zh": "群臣皆罪陵，上以問太史令司馬遷，遷盛言：「陵事親孝，與士信，常奮不顧身以徇國家之急，其素所畜積也，有國士之風。"
  },
  {
    "id": "s0447",
    "blockIndex": 34,
    "zh": "今舉事一不幸，全軀保妻子之臣隨而媒糵其短，誠可痛也！"
  },
  {
    "id": "s0448",
    "blockIndex": 34,
    "zh": "且陵提步卒不滿五千，深蹂戎馬之地，抑數萬之師，虜救死扶傷不暇，悉舉引弓之民共攻圍之，轉鬥千里，矢盡道窮，士張空弮，冒白刃，北首爭死敵，得人之死力，雖古名將不過也。"
  },
  {
    "id": "s0449",
    "blockIndex": 34,
    "zh": "身雖陷敗，然其所摧敗亦足暴於天下。"
  },
  {
    "id": "s0450",
    "blockIndex": 34,
    "zh": "彼之不死，宜欲得當以報漢也。"
  },
  {
    "id": "s0451",
    "blockIndex": 34,
    "zh": "」上以遷為誣罔，欲沮貳師，為陵遊說，下遷腐刑。"
  },
  {
    "id": "s0452",
    "blockIndex": 35,
    "zh": "久之，上悔陵無救，曰：「陵當發出塞，乃詔強弩都尉令迎軍；"
  },
  {
    "id": "s0453",
    "blockIndex": 35,
    "zh": "坐預詔之，得令老將生奸詐。"
  },
  {
    "id": "s0454",
    "blockIndex": 35,
    "zh": "」乃遣使勞賜陵餘軍得脫者。"
  },
  {
    "id": "s0455",
    "blockIndex": 35,
    "zh": "----3上以法制御下，好尊用酷吏，而郡、國二千石為治者大抵多酷暴，吏民益輕犯法；"
  },
  {
    "id": "s0456",
    "blockIndex": 35,
    "zh": "東方盜賊滋起，大群至數千人，攻城邑，取庫兵，釋死罪，縛辱郡太守、都尉，殺二千石；"
  },
  {
    "id": "s0457",
    "blockIndex": 35,
    "zh": "小群以百數掠鹵鄉里者，不可勝數，道路不通。"
  },
  {
    "id": "s0458",
    "blockIndex": 35,
    "zh": "上始使御史中丞、丞相長史督之，弗能禁；"
  },
  {
    "id": "s0459",
    "blockIndex": 35,
    "zh": "乃使光祿大夫范昆及故九卿張德等衣繡衣，持節、虎符，發兵以興擊。"
  },
  {
    "id": "s0460",
    "blockIndex": 35,
    "zh": "斬首大部或至萬餘級，及以法誅通行、飲食當連坐者，諸郡甚者數千人。"
  },
  {
    "id": "s0461",
    "blockIndex": 35,
    "zh": "數歲，乃頗得其渠率，散卒失亡復聚黨阻山川者往往而群居，無可奈何。"
  },
  {
    "id": "s0462",
    "blockIndex": 35,
    "zh": "於是作《沈命法》，曰：「群盜起，不發覺，發覺而捕弗滿品者，二千石以下至小吏，主者皆死。"
  },
  {
    "id": "s0463",
    "blockIndex": 35,
    "zh": "」其後小吏畏誅，雖有盜不敢發，恐不能得，坐課累府，府亦使其不言。"
  },
  {
    "id": "s0464",
    "blockIndex": 35,
    "zh": "故盜賊多，上下相為匿，以文辭避法焉。"
  },
  {
    "id": "s0465",
    "blockIndex": 36,
    "zh": "是時，暴勝之為直指使者，所誅殺二千石以下尤多，威振州郡。"
  },
  {
    "id": "s0466",
    "blockIndex": 36,
    "zh": "至勃海，聞郡人雋不疑賢，請與相見。"
  },
  {
    "id": "s0467",
    "blockIndex": 36,
    "zh": "不疑容貌尊嚴，衣冠甚偉，勝之躧履起迎，登堂坐定，不疑據地曰：「竊伏海瀕，聞暴公子舊矣，今乃承顏接辭。"
  },
  {
    "id": "s0468",
    "blockIndex": 36,
    "zh": "凡為吏，太剛則折，太柔則廢，威行，施之以恩，然後樹功揚名，永終天祿。"
  },
  {
    "id": "s0469",
    "blockIndex": 36,
    "zh": "」勝之深納其戒；"
  },
  {
    "id": "s0470",
    "blockIndex": 36,
    "zh": "及還，表薦不疑，上召拜不疑為青州刺史。"
  },
  {
    "id": "s0471",
    "blockIndex": 36,
    "zh": "濟南王賀亦為繡衣御史，逐捕魏郡群盜，多所縱捨，以奉使不稱免，歎曰：「吾聞活千人，子孫有封，吾所活者萬餘人，後世其興乎！"
  },
  {
    "id": "s0472",
    "blockIndex": 36,
    "zh": "」----4是歲，以匈奴降者介和王成娩為開陵侯，將樓蘭國兵擊車師；"
  },
  {
    "id": "s0473",
    "blockIndex": 36,
    "zh": "匈奴遣右賢王將數萬騎救之，漢兵不利，引去。"
  },
  {
    "id": "s0474",
    "blockIndex": 37,
    "zh": "category:資治通鑑"
  }
]
