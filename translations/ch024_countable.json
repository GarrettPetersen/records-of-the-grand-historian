[
  {
    "id": "s0001",
    "blockIndex": 0,
    "zh": "起強圉協洽，盡昭陽赤奮若，凡七年。"
  },
  {
    "id": "s0002",
    "blockIndex": 1,
    "zh": "1春，二月，詔減口賦錢什三。"
  },
  {
    "id": "s0003",
    "blockIndex": 1,
    "zh": "----2夏，四月，癸未，帝崩於未央宮；"
  },
  {
    "id": "s0004",
    "blockIndex": 1,
    "zh": "無嗣。"
  },
  {
    "id": "s0005",
    "blockIndex": 1,
    "zh": "時武帝子獨有廣陵王胥，大將軍光與群臣議所立，咸持廣陵王。"
  },
  {
    "id": "s0006",
    "blockIndex": 1,
    "zh": "王本以行失道，先帝所不用；"
  },
  {
    "id": "s0007",
    "blockIndex": 1,
    "zh": "光內不自安。"
  },
  {
    "id": "s0008",
    "blockIndex": 1,
    "zh": "朗有上書言：「周太王廢太伯立王季，文王捨伯邑考立武王，唯在所宜，雖廢長立少可也。"
  },
  {
    "id": "s0009",
    "blockIndex": 1,
    "zh": "廣陵王不可以承宗廟。"
  },
  {
    "id": "s0010",
    "blockIndex": 1,
    "zh": "」言合光意。"
  },
  {
    "id": "s0011",
    "blockIndex": 1,
    "zh": "光以其書示丞相敞等，擢郎為九江太守。"
  },
  {
    "id": "s0012",
    "blockIndex": 1,
    "zh": "即日承皇后詔，遣行大鴻臚事少府樂成、宗正德、光祿大夫吉、中郎將利漢，迎昌邑王賀，乘七乘傳詣長安邸。"
  },
  {
    "id": "s0013",
    "blockIndex": 1,
    "zh": "光又白皇后，徒右將軍安世為車騎將軍。"
  },
  {
    "id": "s0014",
    "blockIndex": 2,
    "zh": "賀，昌邑哀王之子也，在國素狂縱，動作無節。"
  },
  {
    "id": "s0015",
    "blockIndex": 2,
    "zh": "武帝之喪，賀遊獵不止。"
  },
  {
    "id": "s0016",
    "blockIndex": 2,
    "zh": "嘗遊方與，不半日馳二百里。"
  },
  {
    "id": "s0017",
    "blockIndex": 2,
    "zh": "中尉琅邪王吉上疏諫曰：「大王不好書術而樂逸游，馮式撙銜，馳騁不止，口倦虖叱吒，手苦於棰轡，身勞虖車輿，朝則冒霧露，晝則被塵埃，夏則為大暑之所暴炙，冬則為風寒之所匽薄，數以耎脆之玉體犯勤勞之煩毒，非所以全壽命之宗也，又非所以進仁義之隆也。"
  },
  {
    "id": "s0018",
    "blockIndex": 2,
    "zh": "夫廣廈之下，細旃之上，明師居前，勤誦在後，上論唐、虞之際，下及殷、周之盛，考仁聖之風，習治國之道，訢訢焉發憤忘食，日新厥德，其樂豈銜橛之間哉！"
  },
  {
    "id": "s0019",
    "blockIndex": 2,
    "zh": "休則俛仰屈伸以利形，進退步趨以實下，吸新吐故以練臧，專意積精以適神，於以養生，豈不長哉！"
  },
  {
    "id": "s0020",
    "blockIndex": 2,
    "zh": "大王誠留意如此，則心有堯、舜之志，體有喬、松之壽，美聲廣譽，登而上聞，則福祿其臻而社稷安矣。"
  },
  {
    "id": "s0021",
    "blockIndex": 2,
    "zh": "皇帝仁聖，至今思慕未怠，於宮館、囿池、戈獵之樂未有所幸，大王宜夙夜念此以承聖意。"
  },
  {
    "id": "s0022",
    "blockIndex": 2,
    "zh": "諸侯骨肉，莫親大王，大王於屬則子也，於位則臣也，一身而二任之責加焉。"
  },
  {
    "id": "s0023",
    "blockIndex": 2,
    "zh": "恩愛行義，孅介有不具者，於以上聞，非饗國之福也。"
  },
  {
    "id": "s0024",
    "blockIndex": 2,
    "zh": "」王乃下令曰：「寡人造行不能無惰，中尉其忠，數輔吾過。"
  },
  {
    "id": "s0025",
    "blockIndex": 2,
    "zh": "」使謁者千秋賜中尉牛肉五百斤，酒五石，脯五束。"
  },
  {
    "id": "s0026",
    "blockIndex": 2,
    "zh": "其後復放縱自若。"
  },
  {
    "id": "s0027",
    "blockIndex": 3,
    "zh": "郎中令山陽龔遂，忠厚剛毅，有大節，內諫爭於王，外責傅相，引經義，陳禍福，至於涕泣，蹇蹇亡已，面刺王過。"
  },
  {
    "id": "s0028",
    "blockIndex": 3,
    "zh": "王至掩耳起走，曰：「郎中令善愧人！"
  },
  {
    "id": "s0029",
    "blockIndex": 3,
    "zh": "」王嘗久與騶奴、宰人遊戲飲食，賞賜無度，遂入見王，涕泣膝行，左右侍御皆出涕。"
  },
  {
    "id": "s0030",
    "blockIndex": 3,
    "zh": "王曰：「郎中令何為哭？"
  },
  {
    "id": "s0031",
    "blockIndex": 3,
    "zh": "」遂曰：「臣痛社稷危也！"
  },
  {
    "id": "s0032",
    "blockIndex": 3,
    "zh": "願賜清閒，竭愚！"
  },
  {
    "id": "s0033",
    "blockIndex": 3,
    "zh": "」王辟左右。"
  },
  {
    "id": "s0034",
    "blockIndex": 3,
    "zh": "遂曰：「大王知膠西王所以為無道亡乎？"
  },
  {
    "id": "s0035",
    "blockIndex": 3,
    "zh": "」王曰：「不知也。"
  },
  {
    "id": "s0036",
    "blockIndex": 3,
    "zh": "」曰：「臣聞膠西王有諛臣侯得，王所為擬於桀、紂也，得以為堯、舜也。"
  },
  {
    "id": "s0037",
    "blockIndex": 3,
    "zh": "王說其諂諛，常與寢處，唯得所言，以至於是。"
  },
  {
    "id": "s0038",
    "blockIndex": 3,
    "zh": "今大王親近群小，漸漬邪惡所習，存亡之機，不可不慎也！"
  },
  {
    "id": "s0039",
    "blockIndex": 3,
    "zh": "臣請選郎通經有行義者與王起成，坐則誦《詩》、《書》，立則習禮容，宜有益。"
  },
  {
    "id": "s0040",
    "blockIndex": 3,
    "zh": "」王許之。"
  },
  {
    "id": "s0041",
    "blockIndex": 3,
    "zh": "遂乃選郎中張安等十人侍王。"
  },
  {
    "id": "s0042",
    "blockIndex": 3,
    "zh": "居數日，王皆逐去安等。"
  },
  {
    "id": "s0043",
    "blockIndex": 4,
    "zh": "王嘗見大白犬，頸以下似人，冠方山冠而無尾，以問龔遂，遂曰：「此天戒，言在側者盡冠狗也，去之則存，不去則亡矣。"
  },
  {
    "id": "s0044",
    "blockIndex": 4,
    "zh": "」後又聞人聲曰：「熊！"
  },
  {
    "id": "s0045",
    "blockIndex": 4,
    "zh": "」視而見大熊，左右莫見，以問遂，遂曰：「熊，山野之獸，而來入宮室，王獨見之，此天戒大王，恐宮室將空，危亡象也。"
  },
  {
    "id": "s0046",
    "blockIndex": 4,
    "zh": "」王仰天而歎曰：「不祥何為數來！"
  },
  {
    "id": "s0047",
    "blockIndex": 4,
    "zh": "」遂叩頭曰：「臣不敢隱忠，數言危亡之戒；"
  },
  {
    "id": "s0048",
    "blockIndex": 4,
    "zh": "大王不說。"
  },
  {
    "id": "s0049",
    "blockIndex": 4,
    "zh": "夫國之存亡，豈在臣言哉！"
  },
  {
    "id": "s0050",
    "blockIndex": 4,
    "zh": "願王內自揆度。"
  },
  {
    "id": "s0051",
    "blockIndex": 4,
    "zh": "大王誦《詩》三百五篇，人事浹，王道備。"
  },
  {
    "id": "s0052",
    "blockIndex": 4,
    "zh": "王之所行，中《詩》一篇何等也？"
  },
  {
    "id": "s0053",
    "blockIndex": 4,
    "zh": "大王位於諸侯王，行污於庶人，以存難，以亡易，宜深察之！"
  },
  {
    "id": "s0054",
    "blockIndex": 4,
    "zh": "」後又血污王坐席，王問遂；"
  },
  {
    "id": "s0055",
    "blockIndex": 4,
    "zh": "遂叫然號曰：「宮空不久，妖祥數至。"
  },
  {
    "id": "s0056",
    "blockIndex": 4,
    "zh": "血者，陰憂象也，宜畏慎自省！"
  },
  {
    "id": "s0057",
    "blockIndex": 4,
    "zh": "」王終不改節。"
  },
  {
    "id": "s0058",
    "blockIndex": 5,
    "zh": "及徵書至，夜漏未盡一刻，以火發書。"
  },
  {
    "id": "s0059",
    "blockIndex": 5,
    "zh": "其日中，王發；"
  },
  {
    "id": "s0060",
    "blockIndex": 5,
    "zh": "晡時，至定陶，行百三十五里，侍從者馬死相望於道。"
  },
  {
    "id": "s0061",
    "blockIndex": 5,
    "zh": "王吉奏書戒王曰：「臣聞高宗諒闇，三年不言。"
  },
  {
    "id": "s0062",
    "blockIndex": 5,
    "zh": "今大王以喪事徵，宜日夜哭泣悲哀而已，慎毋有所發！"
  },
  {
    "id": "s0063",
    "blockIndex": 5,
    "zh": "大將軍仁愛、勇智、忠信之德，天下莫不聞；"
  },
  {
    "id": "s0064",
    "blockIndex": 5,
    "zh": "事孝武皇帝二十餘年，未嘗有過。"
  },
  {
    "id": "s0065",
    "blockIndex": 5,
    "zh": "先帝棄群臣，屬以天下，寄幼孤焉。"
  },
  {
    "id": "s0066",
    "blockIndex": 5,
    "zh": "大將軍抱持幼君襁褓之中，布政施教，海內晏然，雖周公、伊尹無以加也。"
  },
  {
    "id": "s0067",
    "blockIndex": 5,
    "zh": "今帝崩無嗣，大將軍惟思可以奉宗廟者，攀援而立大王，其仁厚豈有量哉！"
  },
  {
    "id": "s0068",
    "blockIndex": 5,
    "zh": "臣願大王事之，敬之，政事壹聽之，大王垂拱南面而已。"
  },
  {
    "id": "s0069",
    "blockIndex": 5,
    "zh": "願留意，常以為念！"
  },
  {
    "id": "s0071",
    "blockIndex": 6,
    "zh": "王至濟陽，求長鳴雞，道買積竹杖。"
  },
  {
    "id": "s0072",
    "blockIndex": 6,
    "zh": "過弘農，使大奴善以衣車載女子。"
  },
  {
    "id": "s0073",
    "blockIndex": 6,
    "zh": "至湖，使者以讓相安樂。"
  },
  {
    "id": "s0074",
    "blockIndex": 6,
    "zh": "安樂告龔遂，遂入問王，王曰：「無有。"
  },
  {
    "id": "s0075",
    "blockIndex": 6,
    "zh": "」遂曰：「即無有，何愛一善以毀行義！"
  },
  {
    "id": "s0076",
    "blockIndex": 6,
    "zh": "請收屬吏，以湔灑大王。"
  },
  {
    "id": "s0077",
    "blockIndex": 6,
    "zh": "」即捽善屬衛士長行法。"
  },
  {
    "id": "s0078",
    "blockIndex": 7,
    "zh": "王到霸上，大鴻臚郊迎，騶奉乘輿車。"
  },
  {
    "id": "s0079",
    "blockIndex": 7,
    "zh": "王使壽成御，郎中令遂參乘。"
  },
  {
    "id": "s0080",
    "blockIndex": 7,
    "zh": "且至廣明、東都門，遂曰：「禮，奔喪望見國都哭。"
  },
  {
    "id": "s0081",
    "blockIndex": 7,
    "zh": "此長安東郭門也。"
  },
  {
    "id": "s0082",
    "blockIndex": 7,
    "zh": "」王曰：「我嗌痛，不能哭。"
  },
  {
    "id": "s0083",
    "blockIndex": 7,
    "zh": "」至城門，遂復言，王曰：「城門與郭門等耳。"
  },
  {
    "id": "s0084",
    "blockIndex": 7,
    "zh": "」且至未央宮東闕，遂曰：「昌邑帳在是闕外馳道北，未至帳所，有南北行道，馬足未至數步；"
  },
  {
    "id": "s0085",
    "blockIndex": 7,
    "zh": "大王宜下車，鄉闕西面伏哭，盡哀止。"
  },
  {
    "id": "s0086",
    "blockIndex": 7,
    "zh": "」王曰：「諾。"
  },
  {
    "id": "s0087",
    "blockIndex": 7,
    "zh": "」到，哭如儀。"
  },
  {
    "id": "s0088",
    "blockIndex": 7,
    "zh": "六月，丙寅，王受皇帝璽綬，襲尊號，尊皇后曰皇太后。"
  },
  {
    "id": "s0089",
    "blockIndex": 7,
    "zh": "----3壬申，葬孝昭皇帝於平陵。"
  },
  {
    "id": "s0090",
    "blockIndex": 7,
    "zh": "----4昌邑王既立，淫戲無度。"
  },
  {
    "id": "s0091",
    "blockIndex": 7,
    "zh": "昌邑官屬皆徵至長安，往往超擢拜官。"
  },
  {
    "id": "s0092",
    "blockIndex": 7,
    "zh": "相安樂遷長樂衛尉。"
  },
  {
    "id": "s0093",
    "blockIndex": 7,
    "zh": "龔遂見安樂，流涕謂曰：「王立為天子，日益驕溢，諫之不復聽。"
  },
  {
    "id": "s0094",
    "blockIndex": 7,
    "zh": "今哀痛未盡，日與近臣飲酒作樂，鬥虎豹，召皮軒車九旒，驅馳東西，所為悖道。"
  },
  {
    "id": "s0095",
    "blockIndex": 7,
    "zh": "古制寬，大臣有隱退；"
  },
  {
    "id": "s0096",
    "blockIndex": 7,
    "zh": "今去不得，陽狂恐知，身死為世戮，奈何？"
  },
  {
    "id": "s0097",
    "blockIndex": 7,
    "zh": "君，陛下故相，宜極諫爭。"
  },
  {
    "id": "s0099",
    "blockIndex": 8,
    "zh": "王夢青蠅之矢積西階東，可五六石，以屋版瓦覆之，以問遂，遂曰：「陛下之《詩》不雲乎：『營營青蠅，止於籓。"
  },
  {
    "id": "s0100",
    "blockIndex": 8,
    "zh": "愷悌君子，毋信讒言。"
  },
  {
    "id": "s0101",
    "blockIndex": 8,
    "zh": "』陛下左側讒人眾多，如是青蠅惡矣。"
  },
  {
    "id": "s0102",
    "blockIndex": 8,
    "zh": "宜進先帝大臣子孫，親近以為左右。"
  },
  {
    "id": "s0103",
    "blockIndex": 8,
    "zh": "如不忍昌邑故人，信用讒諛，必有凶咎。"
  },
  {
    "id": "s0104",
    "blockIndex": 8,
    "zh": "願詭禍為福，皆放逐之！"
  },
  {
    "id": "s0105",
    "blockIndex": 8,
    "zh": "臣當先逐矣。"
  },
  {
    "id": "s0106",
    "blockIndex": 8,
    "zh": "」王不聽。"
  },
  {
    "id": "s0107",
    "blockIndex": 9,
    "zh": "太僕丞河東張敞上書諫，曰：「孝昭皇帝蚤崩無嗣，大臣憂懼，選賢聖承宗廟，東迎之日，唯恐屬車之行遲。"
  },
  {
    "id": "s0108",
    "blockIndex": 9,
    "zh": "今天子以盛年初即位，天下莫不拭目傾耳，觀化聽風。"
  },
  {
    "id": "s0109",
    "blockIndex": 9,
    "zh": "國輔大臣未褒，而昌邑小輩先遷，此過之大者也。"
  },
  {
    "id": "s0110",
    "blockIndex": 9,
    "zh": "」王不聽。"
  },
  {
    "id": "s0111",
    "blockIndex": 10,
    "zh": "大將軍光憂懣，獨以問所親故吏大司農田延年。"
  },
  {
    "id": "s0112",
    "blockIndex": 10,
    "zh": "延年曰：「將軍為國柱石，審此人不可，何不建白太后，更選賢而立之？"
  },
  {
    "id": "s0113",
    "blockIndex": 10,
    "zh": "」光曰：「今欲如是，於古嘗有此不？"
  },
  {
    "id": "s0114",
    "blockIndex": 10,
    "zh": "」延年曰：「伊尹相殷，廢太甲以安宗廟，後世稱其忠。"
  },
  {
    "id": "s0115",
    "blockIndex": 10,
    "zh": "將軍若能行此，亦漢之伊尹也。"
  },
  {
    "id": "s0116",
    "blockIndex": 10,
    "zh": "」光乃引延年給事中，陰與車騎將軍張安世圖計。"
  },
  {
    "id": "s0117",
    "blockIndex": 11,
    "zh": "王出遊，光祿大夫魯國夏侯勝當乘輿前諫曰：「天久陰而不雨，臣下有謀上者。"
  },
  {
    "id": "s0118",
    "blockIndex": 11,
    "zh": "陛下出，欲何之？"
  },
  {
    "id": "s0119",
    "blockIndex": 11,
    "zh": "」王怒，謂勝為示夭言，縛以屬吏。"
  },
  {
    "id": "s0120",
    "blockIndex": 11,
    "zh": "吏白霍光，光不舉法。"
  },
  {
    "id": "s0121",
    "blockIndex": 11,
    "zh": "光讓安世，以為洩語。"
  },
  {
    "id": "s0122",
    "blockIndex": 11,
    "zh": "安世實不言；"
  },
  {
    "id": "s0123",
    "blockIndex": 11,
    "zh": "乃召問勝。"
  },
  {
    "id": "s0124",
    "blockIndex": 11,
    "zh": "勝對言：「在《鴻範傳》曰：『皇之不極，厥罰常陰，時則有下人伐上者。"
  },
  {
    "id": "s0125",
    "blockIndex": 11,
    "zh": "』惡察察言，故云『臣下有謀』。"
  },
  {
    "id": "s0126",
    "blockIndex": 11,
    "zh": "」光、安世大驚，以此益重經術士。"
  },
  {
    "id": "s0127",
    "blockIndex": 11,
    "zh": "侍中傅嘉數進諫，王亦縛嘉繫獄。"
  },
  {
    "id": "s0128",
    "blockIndex": 12,
    "zh": "光、安世既定議，乃使田延年報丞相楊敞。"
  },
  {
    "id": "s0129",
    "blockIndex": 12,
    "zh": "敞驚懼，不知所言，汗出洽背，徒唯唯而已。"
  },
  {
    "id": "s0130",
    "blockIndex": 12,
    "zh": "延年起，至更衣，敞夫人遽從東廂謂敞曰：「此國大事，今大將軍議已定，使九卿來報君侯，君侯不疾應，與大將軍同心，猶與無決，先事誅矣！"
  },
  {
    "id": "s0131",
    "blockIndex": 12,
    "zh": "」延年從更衣還，敞夫人與延年參語許諾：「請奉大將軍教令！"
  },
  {
    "id": "s0133",
    "blockIndex": 13,
    "zh": "癸巳，光召丞相、御史、將軍、列侯、中二千石、大夫、博士會議未央宮。"
  },
  {
    "id": "s0134",
    "blockIndex": 13,
    "zh": "光曰：「昌邑王行昏亂，恐危社稷，如何？"
  },
  {
    "id": "s0135",
    "blockIndex": 13,
    "zh": "」群臣皆驚鄂失色，莫敢發言，但唯唯而已。"
  },
  {
    "id": "s0136",
    "blockIndex": 13,
    "zh": "田延年前，離席按劍曰：「先帝屬將軍以幼孤，寄將軍以天下，以將軍忠賢，能安劉氏也。"
  },
  {
    "id": "s0137",
    "blockIndex": 13,
    "zh": "今群下鼎沸，社稷將傾；"
  },
  {
    "id": "s0138",
    "blockIndex": 13,
    "zh": "且漢之傳謚常為『孝』者，以長有天下，令宗廟血食也。"
  },
  {
    "id": "s0139",
    "blockIndex": 13,
    "zh": "如漢家絕祀，將軍雖死，何面目見先帝於地下乎？"
  },
  {
    "id": "s0140",
    "blockIndex": 13,
    "zh": "今日之議，不得旋踵，群臣後應者，臣請劍斬之！"
  },
  {
    "id": "s0141",
    "blockIndex": 13,
    "zh": "」光謝曰：「九卿責光是也！"
  },
  {
    "id": "s0142",
    "blockIndex": 13,
    "zh": "天下匈匈不安，光當受難。"
  },
  {
    "id": "s0143",
    "blockIndex": 13,
    "zh": "」於是議者皆叩頭曰：「萬姓之命，在於將軍，唯大將軍令！"
  },
  {
    "id": "s0145",
    "blockIndex": 14,
    "zh": "光即與群臣俱見，白太后，具陳昌邑王不可以承宗廟狀。"
  },
  {
    "id": "s0146",
    "blockIndex": 14,
    "zh": "皇太后乃車駕幸未央承明殿，詔諸禁門毋內昌邑群臣。"
  },
  {
    "id": "s0147",
    "blockIndex": 14,
    "zh": "王入朝太后還，乘輦欲歸溫室。"
  },
  {
    "id": "s0148",
    "blockIndex": 14,
    "zh": "中黃門宦者各持門扇，王入，門閉，昌邑群臣不得入。"
  },
  {
    "id": "s0149",
    "blockIndex": 14,
    "zh": "王曰：「何為？"
  },
  {
    "id": "s0150",
    "blockIndex": 14,
    "zh": "」大將軍跪曰：「有皇太后詔，毋內昌邑群臣！"
  },
  {
    "id": "s0151",
    "blockIndex": 14,
    "zh": "」王曰：「徐之，何乃驚人如是！"
  },
  {
    "id": "s0152",
    "blockIndex": 14,
    "zh": "」光使盡驅出昌邑群臣，置金馬門外。"
  },
  {
    "id": "s0153",
    "blockIndex": 14,
    "zh": "車騎將軍安世將羽林騎，收縛二百餘人，皆送廷尉詔獄。"
  },
  {
    "id": "s0154",
    "blockIndex": 14,
    "zh": "令故昭帝侍中中臣侍守王。"
  },
  {
    "id": "s0155",
    "blockIndex": 14,
    "zh": "光敕左右：「謹宿衛！"
  },
  {
    "id": "s0156",
    "blockIndex": 14,
    "zh": "卒有物故自裁，令我負天下，有殺主名。"
  },
  {
    "id": "s0157",
    "blockIndex": 14,
    "zh": "」王尚未自知當廢，謂左右：「我故群臣從官安得罪，而大將軍盡系之乎！"
  },
  {
    "id": "s0159",
    "blockIndex": 15,
    "zh": "頃之，有太后詔召王。"
  },
  {
    "id": "s0160",
    "blockIndex": 15,
    "zh": "王聞召，意恐，乃曰：「我安得罪而召我哉！"
  },
  {
    "id": "s0161",
    "blockIndex": 15,
    "zh": "」太后被珠襦，盛服坐武帳中，侍御數百人皆持兵，期門武士陛戟陳列殿下，群臣以次上殿，召昌邑王伏前聽詔。"
  },
  {
    "id": "s0162",
    "blockIndex": 15,
    "zh": "光與群臣連名奏王，尚書令讀奏曰：「丞相臣敞等昧死言皇太后陛下：孝昭皇帝早棄天下，遣使徵昌邑王典喪，服斬衰，無悲哀之心，廢禮誼，居道上不素食，使從官略女子載衣車，內所居傳捨。"
  },
  {
    "id": "s0163",
    "blockIndex": 15,
    "zh": "始至謁見，立為皇太子，常私買雞豚以食。"
  },
  {
    "id": "s0164",
    "blockIndex": 15,
    "zh": "受皇帝信璽、行璽大行前，就次，發璽不封。"
  },
  {
    "id": "s0165",
    "blockIndex": 15,
    "zh": "從官更持節引內昌邑從官、騶宰、官奴二百餘人，常與居禁闥內敖戲。"
  },
  {
    "id": "s0166",
    "blockIndex": 15,
    "zh": "為書曰：『皇帝問侍中君卿：使中御府令高昌奉黃金千斤，賜君卿取十妻。"
  },
  {
    "id": "s0167",
    "blockIndex": 15,
    "zh": "』大行在前殿，發樂府樂器，引內昌邑樂人擊鼓，歌吹，作俳倡；"
  },
  {
    "id": "s0168",
    "blockIndex": 15,
    "zh": "召內泰壹、宗廟樂人，悉奏眾樂。"
  },
  {
    "id": "s0169",
    "blockIndex": 15,
    "zh": "駕法駕驅馳北宮、桂宮，弄彘鬥虎。"
  },
  {
    "id": "s0170",
    "blockIndex": 15,
    "zh": "召皇太后御小馬車，使官奴騎乘，遊戲掖庭中。"
  },
  {
    "id": "s0171",
    "blockIndex": 15,
    "zh": "與孝昭皇帝宮人蒙等淫亂，詔掖庭令：『敢洩言，要斬！"
  },
  {
    "id": "s0172",
    "blockIndex": 15,
    "zh": "』……」太后曰：「止！"
  },
  {
    "id": "s0173",
    "blockIndex": 15,
    "zh": "為人臣子，當悖亂如是邪！"
  },
  {
    "id": "s0174",
    "blockIndex": 15,
    "zh": "」王離席伏。"
  },
  {
    "id": "s0175",
    "blockIndex": 15,
    "zh": "尚書令復讀曰：「……取諸侯王、列侯、二千石綬及墨綬、黃綬以並佩昌邑郎官者免奴。"
  },
  {
    "id": "s0176",
    "blockIndex": 15,
    "zh": "發御府金錢、刀劍、玉器、采繒，賞賜所與遊戲者。"
  },
  {
    "id": "s0177",
    "blockIndex": 15,
    "zh": "與從官、官奴夜飲，湛沔於酒。"
  },
  {
    "id": "s0178",
    "blockIndex": 15,
    "zh": "獨夜設九賓溫室，延見姊夫昌邑關內侯。"
  },
  {
    "id": "s0179",
    "blockIndex": 15,
    "zh": "祖宗廟祠未舉，為璽書，使使者持節以三太牢祠昌邑哀王園廟，稱『嗣子皇帝』。"
  },
  {
    "id": "s0180",
    "blockIndex": 15,
    "zh": "受璽以來二十七日，使者旁午，持節詔諸官署徵發凡一千一百二十七事。"
  },
  {
    "id": "s0181",
    "blockIndex": 15,
    "zh": "荒淫迷惑，失帝王禮誼，亂漢制度。"
  },
  {
    "id": "s0182",
    "blockIndex": 15,
    "zh": "臣敞等數進諫，不變更，日以益甚。"
  },
  {
    "id": "s0183",
    "blockIndex": 15,
    "zh": "恐危社稷，天下不安。"
  },
  {
    "id": "s0184",
    "blockIndex": 15,
    "zh": "臣敞等謹與博士議，皆曰：『今陛下嗣孝昭皇帝後，行淫辟不軌。"
  },
  {
    "id": "s0185",
    "blockIndex": 15,
    "zh": "「五辟之屬，莫大不孝。"
  },
  {
    "id": "s0186",
    "blockIndex": 15,
    "zh": "」周襄王不能事母，《春秋》曰：「天王出居於鄭，」由不孝出之，絕之於天下也。"
  },
  {
    "id": "s0187",
    "blockIndex": 15,
    "zh": "宗廟重於君，陛下不可以承天序，奉祖宗廟，子萬姓，當廢！"
  },
  {
    "id": "s0188",
    "blockIndex": 15,
    "zh": "』臣請有司以一太牢具告祠高廟。"
  },
  {
    "id": "s0189",
    "blockIndex": 15,
    "zh": "」皇太后詔曰：「可。"
  },
  {
    "id": "s0190",
    "blockIndex": 15,
    "zh": "」光令王起，拜受詔，王曰：「聞『天下有爭臣七人，雖亡道不失天下。"
  },
  {
    "id": "s0191",
    "blockIndex": 15,
    "zh": "』」光曰：「皇太后詔廢，安得稱天子！"
  },
  {
    "id": "s0192",
    "blockIndex": 15,
    "zh": "」乃即持其手，解脫其璽組，奉上太后，扶王下殿，出金馬門，群臣隨送。"
  },
  {
    "id": "s0193",
    "blockIndex": 15,
    "zh": "王西面拜曰：「愚戇，不任漢事！"
  },
  {
    "id": "s0194",
    "blockIndex": 15,
    "zh": "」起，就乘輿副車，大將軍光送至昌邑邸。"
  },
  {
    "id": "s0195",
    "blockIndex": 15,
    "zh": "光謝曰：「王行自絕於天，臣寧負王，不敢負社稷！"
  },
  {
    "id": "s0196",
    "blockIndex": 15,
    "zh": "願王自愛，臣長不復左右。"
  },
  {
    "id": "s0197",
    "blockIndex": 15,
    "zh": "」光涕泣而去。"
  },
  {
    "id": "s0198",
    "blockIndex": 16,
    "zh": "群臣奏言：「古者廢放之人，屏於遠方，不及以政。"
  },
  {
    "id": "s0199",
    "blockIndex": 16,
    "zh": "請徙王賀漢中房陵縣。"
  },
  {
    "id": "s0200",
    "blockIndex": 16,
    "zh": "」太后詔歸賀昌邑，賜湯沐邑二千戶，故王家財物皆與賀；"
  },
  {
    "id": "s0201",
    "blockIndex": 16,
    "zh": "及哀王女四人，各賜湯沐邑千戶；"
  },
  {
    "id": "s0202",
    "blockIndex": 16,
    "zh": "國除，為山陽郡。"
  },
  {
    "id": "s0203",
    "blockIndex": 17,
    "zh": "昌邑群臣坐在國時不舉奏王罪過，令漢朝不聞知，又不能輔道，陷王大惡，皆下獄，誅殺二百餘人。"
  },
  {
    "id": "s0204",
    "blockIndex": 17,
    "zh": "唯中尉吉、郎中令遂以忠直數諫正，得減死，髡為城旦。"
  },
  {
    "id": "s0205",
    "blockIndex": 17,
    "zh": "師王式繫獄當死，治事使者責問曰：「師何以無諫書？"
  },
  {
    "id": "s0206",
    "blockIndex": 17,
    "zh": "」式對曰：「臣以《詩》三百五篇朝夕授王，至於忠臣、孝子之篇，未嘗不為王反覆誦之也。"
  },
  {
    "id": "s0207",
    "blockIndex": 17,
    "zh": "至於危亡失道之君，未嘗不流涕為王深陳之也。"
  },
  {
    "id": "s0208",
    "blockIndex": 17,
    "zh": "臣以三百五篇諫，是以無諫書。"
  },
  {
    "id": "s0209",
    "blockIndex": 17,
    "zh": "」使者以聞，亦得減死論。"
  },
  {
    "id": "s0210",
    "blockIndex": 18,
    "zh": "霍光以群臣奏事東宮，太后省政，宜知經術，白令夏侯勝用《尚書》授太后，遷勝長信少府，賜爵關內侯。"
  },
  {
    "id": "s0211",
    "blockIndex": 18,
    "zh": "----5初，衛太子納魯國史良娣，生子進，號史皇孫。"
  },
  {
    "id": "s0212",
    "blockIndex": 18,
    "zh": "皇孫納涿郡王夫人，生子病已，號皇曾孫。"
  },
  {
    "id": "s0213",
    "blockIndex": 18,
    "zh": "皇曾孫生數月，遭巫蠱事，太子三男、一女及諸妻、妾皆遇害，獨皇曾孫在，亦坐收系郡邸獄。"
  },
  {
    "id": "s0214",
    "blockIndex": 18,
    "zh": "故廷尉監魯國丙吉受詔治巫蠱獄，吉心知太子無事實，重哀皇曾孫無辜，擇謹厚女徒謂城胡組、淮陽郭徵卿，令乳養曾孫，置閒燥處。"
  },
  {
    "id": "s0215",
    "blockIndex": 18,
    "zh": "吉日再省視。"
  },
  {
    "id": "s0216",
    "blockIndex": 19,
    "zh": "巫蠱事連歲不決，武帝疾，來往長楊、五柞宮，望氣者言長安獄中有天子氣，於是武帝遣使者分條中都官，詔獄繫者，無輕重，一切皆殺之。"
  },
  {
    "id": "s0217",
    "blockIndex": 19,
    "zh": "內謁者令郭穰夜到郡邸獄，吉閉門拒使者不納，曰：「皇曾孫在。"
  },
  {
    "id": "s0218",
    "blockIndex": 19,
    "zh": "他人無辜死者猶不可，況親曾孫乎！"
  },
  {
    "id": "s0219",
    "blockIndex": 19,
    "zh": "」相守至天明，不得入。"
  },
  {
    "id": "s0220",
    "blockIndex": 19,
    "zh": "穰還，以聞，因劾奏吉。"
  },
  {
    "id": "s0221",
    "blockIndex": 19,
    "zh": "武帝亦寤，曰：「天使之也。"
  },
  {
    "id": "s0222",
    "blockIndex": 19,
    "zh": "」因赦天下。"
  },
  {
    "id": "s0223",
    "blockIndex": 19,
    "zh": "郡邸獄繫者，獨賴吉得生。"
  },
  {
    "id": "s0224",
    "blockIndex": 20,
    "zh": "既而吉謂守丞誰如：「皇孫不當在官。"
  },
  {
    "id": "s0225",
    "blockIndex": 20,
    "zh": "」使誰如移書京兆尹，遣與胡組俱送；"
  },
  {
    "id": "s0226",
    "blockIndex": 20,
    "zh": "京兆尹不受，復還。"
  },
  {
    "id": "s0227",
    "blockIndex": 20,
    "zh": "及組日滿當去，皇孫思慕，吉以私錢雇組令留，與郭徵卿並養，養月，乃遣組去。"
  },
  {
    "id": "s0228",
    "blockIndex": 20,
    "zh": "後少內嗇夫白吉曰：「食皇孫無詔令。"
  },
  {
    "id": "s0229",
    "blockIndex": 20,
    "zh": "」時吉得食米、肉，月月以給皇曾孫。"
  },
  {
    "id": "s0230",
    "blockIndex": 20,
    "zh": "曾孫病，幾不全者數焉，吉數敕保養乳母加致醫藥，視遇甚有恩惠。"
  },
  {
    "id": "s0231",
    "blockIndex": 20,
    "zh": "吉聞史良娣有母貞君及兄恭，乃載皇曾孫以付之。"
  },
  {
    "id": "s0232",
    "blockIndex": 20,
    "zh": "貞君年老，見孫孤，甚哀之，自養視焉。"
  },
  {
    "id": "s0233",
    "blockIndex": 21,
    "zh": "後有詔掖庭養視，上屬籍宗正。"
  },
  {
    "id": "s0234",
    "blockIndex": 21,
    "zh": "時掖庭令張賀，嘗事戾太子，思顧舊恩，哀曾孫，奉養甚謹，以私錢供給，教書。"
  },
  {
    "id": "s0235",
    "blockIndex": 21,
    "zh": "既壯，賀欲以女孫妻之。"
  },
  {
    "id": "s0236",
    "blockIndex": 21,
    "zh": "是時昭帝始冠，長八尺二寸。"
  },
  {
    "id": "s0237",
    "blockIndex": 21,
    "zh": "賀弟安世為右將軍，輔政，聞賀稱譽皇曾孫，欲妻以女，怒曰：「曾孫乃衛太子後也，幸得以庶人衣食縣官足矣，勿復言予女事！"
  },
  {
    "id": "s0238",
    "blockIndex": 21,
    "zh": "」於是賀止。"
  },
  {
    "id": "s0239",
    "blockIndex": 21,
    "zh": "時暴室嗇夫許廣漢有女，賀乃置酒請廣漢，酒酣，為言：「曾孫體近，下乃關內侯，可妻也。"
  },
  {
    "id": "s0240",
    "blockIndex": 21,
    "zh": "」廣漢許諾。"
  },
  {
    "id": "s0241",
    "blockIndex": 21,
    "zh": "明日，嫗聞之，怒。"
  },
  {
    "id": "s0242",
    "blockIndex": 21,
    "zh": "廣漢重令人為介，遂與曾孫。"
  },
  {
    "id": "s0243",
    "blockIndex": 21,
    "zh": "賀以家財聘之。"
  },
  {
    "id": "s0244",
    "blockIndex": 21,
    "zh": "曾孫因依倚廣漢兄弟及祖母家史氏，受《詩》於東海澓中翁，高材好學；"
  },
  {
    "id": "s0245",
    "blockIndex": 21,
    "zh": "然亦喜遊俠，鬥雞走狗，以是俱知-{閭里}-奸邪，吏治得失。"
  },
  {
    "id": "s0246",
    "blockIndex": 21,
    "zh": "數上下諸陵，周遍三輔，嘗困於蓮勺鹵中，尤樂杜、鄠之間，率常在下杜。"
  },
  {
    "id": "s0247",
    "blockIndex": 21,
    "zh": "時會朝請，舍長安尚冠-{里}-。"
  },
  {
    "id": "s0248",
    "blockIndex": 22,
    "zh": "及昌邑王廢，霍光與張安世諸大臣議所立，未定。"
  },
  {
    "id": "s0249",
    "blockIndex": 22,
    "zh": "丙吉奏記光曰：「將軍事孝武皇帝，受襁褓之屬，任天下之寄。"
  },
  {
    "id": "s0250",
    "blockIndex": 22,
    "zh": "孝昭皇帝早崩亡嗣，海內憂懼，欲亟聞嗣主。"
  },
  {
    "id": "s0251",
    "blockIndex": 22,
    "zh": "發喪之日，以大誼立後，所立非其人，復以大誼廢之；"
  },
  {
    "id": "s0252",
    "blockIndex": 22,
    "zh": "天下莫不服焉。"
  },
  {
    "id": "s0253",
    "blockIndex": 22,
    "zh": "方今社稷、宗廟、群生之命在將軍之壹舉，竊伏聽於眾庶，察其所言諸侯、宗室在列位者，未有所聞於民間也。"
  },
  {
    "id": "s0254",
    "blockIndex": 22,
    "zh": "而遺詔所養武帝曾孫名病已在掖庭、外家者，吉前使居郡邸時，見其幼少；"
  },
  {
    "id": "s0255",
    "blockIndex": 22,
    "zh": "至今十八九矣，通經術，有美材，行安而節和。"
  },
  {
    "id": "s0256",
    "blockIndex": 22,
    "zh": "願將軍詳大義，參以蓍龜豈宜，褒顯先使入侍，令天下昭然知之，然後決定大策，天下幸甚！"
  },
  {
    "id": "s0257",
    "blockIndex": 22,
    "zh": "」杜延年亦知曾孫德美，勸光、安世立焉。"
  },
  {
    "id": "s0258",
    "blockIndex": 23,
    "zh": "秋，七月，光坐庭中，會丞相以下議定所立，遂復與丞相敞等上奏曰：「孝武皇帝曾孫病已，年十八，師受《詩》、《論語》、《孝經》，躬行節儉，慈仁愛人，可以嗣孝昭皇帝後，奉承祖宗廟，子萬姓。"
  },
  {
    "id": "s0259",
    "blockIndex": 23,
    "zh": "臣昧死以聞！"
  },
  {
    "id": "s0260",
    "blockIndex": 23,
    "zh": "」皇太后詔曰：「可。"
  },
  {
    "id": "s0261",
    "blockIndex": 23,
    "zh": "」光遣宗正德至曾孫家尚冠-{里}-，洗沐，賜御衣；"
  },
  {
    "id": "s0262",
    "blockIndex": 23,
    "zh": "太僕以軨獵車迎曾孫，就齋宗正府。"
  },
  {
    "id": "s0263",
    "blockIndex": 23,
    "zh": "庚申，入未央宮，見皇太后，封為陽武侯。"
  },
  {
    "id": "s0264",
    "blockIndex": 23,
    "zh": "已而群臣奏上璽綬，即皇帝位，謁高廟；"
  },
  {
    "id": "s0265",
    "blockIndex": 23,
    "zh": "尊皇太后為太皇太后。"
  },
  {
    "id": "s0266",
    "blockIndex": 24,
    "zh": "侍御史嚴延年劾奏「大將軍光擅廢立主，無人臣禮，不道。"
  },
  {
    "id": "s0267",
    "blockIndex": 24,
    "zh": "」奏雖寢，然朝廷肅然敬憚之。"
  },
  {
    "id": "s0268",
    "blockIndex": 24,
    "zh": "----6八月，己巳，安平敬侯楊敞薨。"
  },
  {
    "id": "s0269",
    "blockIndex": 24,
    "zh": "----7九月，大赦天下。"
  },
  {
    "id": "s0270",
    "blockIndex": 24,
    "zh": "----8戊寅，蔡義為丞相。"
  },
  {
    "id": "s0271",
    "blockIndex": 24,
    "zh": "----9初，許廣漢女適皇曾孫，一歲，生子奭。"
  },
  {
    "id": "s0272",
    "blockIndex": 24,
    "zh": "數月，曾孫立為帝，許氏為倢伃。"
  },
  {
    "id": "s0273",
    "blockIndex": 24,
    "zh": "是時霍將軍有小女與皇太后親，公卿議更立皇后，皆心擬霍將軍女，亦未有言。"
  },
  {
    "id": "s0274",
    "blockIndex": 24,
    "zh": "上乃詔求微時故劍。"
  },
  {
    "id": "s0275",
    "blockIndex": 24,
    "zh": "大臣知指，白立許倢伃為皇后。"
  },
  {
    "id": "s0276",
    "blockIndex": 24,
    "zh": "十一月，壬子，立皇后許氏。"
  },
  {
    "id": "s0277",
    "blockIndex": 24,
    "zh": "霍光以-{后}-父廣漢刑人，不宜君國；"
  },
  {
    "id": "s0278",
    "blockIndex": 24,
    "zh": "歲餘，乃封為昌成君。"
  },
  {
    "id": "s0279",
    "blockIndex": 24,
    "zh": "----10太皇太后歸長樂宮。"
  },
  {
    "id": "s0280",
    "blockIndex": 24,
    "zh": "長樂宮初置屯衛。"
  },
  {
    "id": "s0282",
    "blockIndex": 25,
    "zh": "1春，詔有司論定策安宗廟功。"
  },
  {
    "id": "s0283",
    "blockIndex": 25,
    "zh": "大將軍光益封萬七千戶，與故所食凡二萬戶。"
  },
  {
    "id": "s0284",
    "blockIndex": 25,
    "zh": "車騎將軍富平侯安世以下益封者十人，封侯者五人，賜爵關內侯者八人。"
  },
  {
    "id": "s0285",
    "blockIndex": 25,
    "zh": "----2大將軍光稽首歸政，上謙讓不受；"
  },
  {
    "id": "s0286",
    "blockIndex": 25,
    "zh": "諸事皆先關白光，然後奏御。"
  },
  {
    "id": "s0287",
    "blockIndex": 25,
    "zh": "自昭帝時，光子禹及兄孫雲皆為中郎將，雲弟山奉車都尉、侍中、領胡、越兵，光兩女婿為東、西宮衛尉，昆弟、諸婿、外孫皆奉朝請，為諸曹、大夫、騎都尉、給事中，黨親連體，根據於朝廷。"
  },
  {
    "id": "s0288",
    "blockIndex": 25,
    "zh": "及昌邑王廢，光權益重，每朝見，上虛己斂容，禮下之已甚。"
  },
  {
    "id": "s0289",
    "blockIndex": 25,
    "zh": "----3夏，四月，庚午，地震。"
  },
  {
    "id": "s0290",
    "blockIndex": 25,
    "zh": "----4五月，鳳皇集膠東、千乘。"
  },
  {
    "id": "s0291",
    "blockIndex": 25,
    "zh": "赦天下，勿收田租賦。"
  },
  {
    "id": "s0292",
    "blockIndex": 25,
    "zh": "----5六月，詔曰：「故皇太子在湖，未有號謚，歲時祠；"
  },
  {
    "id": "s0293",
    "blockIndex": 25,
    "zh": "其議謚，置園邑。"
  },
  {
    "id": "s0294",
    "blockIndex": 25,
    "zh": "」有司奏請：「禮，為人後者，為之子也；"
  },
  {
    "id": "s0295",
    "blockIndex": 25,
    "zh": "故降其父母，不得祭，尊祖之義也。"
  },
  {
    "id": "s0296",
    "blockIndex": 25,
    "zh": "陛下為孝昭帝後，承祖宗之祀，愚以為親謚宜曰悼，母曰-{悼后}-；"
  },
  {
    "id": "s0297",
    "blockIndex": 25,
    "zh": "故皇太子謚曰戾，史良娣曰戾夫人。"
  },
  {
    "id": "s0298",
    "blockIndex": 25,
    "zh": "」皆改葬焉。"
  },
  {
    "id": "s0299",
    "blockIndex": 25,
    "zh": "----6秋，七月，詔立燕剌王太子建為廣陽王；"
  },
  {
    "id": "s0300",
    "blockIndex": 25,
    "zh": "立廣陵王胥少子弘為高密王。"
  },
  {
    "id": "s0301",
    "blockIndex": 25,
    "zh": "----7初，上官桀與霍光爭權，光既誅桀，遂遵武帝法度，以刑罰痛繩群下，由是俗吏皆尚嚴酷以為能；"
  },
  {
    "id": "s0302",
    "blockIndex": 25,
    "zh": "而河南太守丞淮陽黃霸獨用寬和為名。"
  },
  {
    "id": "s0303",
    "blockIndex": 25,
    "zh": "上在民間時，知百姓苦吏急也，聞霸持法平，乃召以為廷尉正；"
  },
  {
    "id": "s0304",
    "blockIndex": 25,
    "zh": "數決疑獄，庭中稱平。"
  },
  {
    "id": "s0306",
    "blockIndex": 26,
    "zh": "1春，大司農田延年有罪自殺。"
  },
  {
    "id": "s0307",
    "blockIndex": 26,
    "zh": "昭帝之喪，大司農僦民車，延年詐增僦直，盜取錢三千萬，為怨家所告。"
  },
  {
    "id": "s0308",
    "blockIndex": 26,
    "zh": "霍將軍召問延年，欲為道地。"
  },
  {
    "id": "s0309",
    "blockIndex": 26,
    "zh": "延年抵曰：「無有是事！"
  },
  {
    "id": "s0310",
    "blockIndex": 26,
    "zh": "」光曰：「即無事，當窮竟！"
  },
  {
    "id": "s0311",
    "blockIndex": 26,
    "zh": "」御史大夫田廣明謂太僕杜延年曰：「《春秋》之義，以功覆過。"
  },
  {
    "id": "s0312",
    "blockIndex": 26,
    "zh": "當廢昌邑王時，非田子賓之言，大事不成。"
  },
  {
    "id": "s0313",
    "blockIndex": 26,
    "zh": "今縣官出三千萬自乞之，何哉？"
  },
  {
    "id": "s0314",
    "blockIndex": 26,
    "zh": "願以愚言白大將軍。"
  },
  {
    "id": "s0315",
    "blockIndex": 26,
    "zh": "」延年言之大將軍，大將軍曰：「誠然，實勇士也！"
  },
  {
    "id": "s0316",
    "blockIndex": 26,
    "zh": "當發大議時，震動朝廷，」光因舉手自撫心曰：「使我至今病悸。"
  },
  {
    "id": "s0317",
    "blockIndex": 26,
    "zh": "謝田大夫曉大司農，通往就獄，得公議之。"
  },
  {
    "id": "s0318",
    "blockIndex": 26,
    "zh": "」田大夫使人語延年。"
  },
  {
    "id": "s0319",
    "blockIndex": 26,
    "zh": "延年曰：「幸縣官寬我耳，何面目入牢獄，使眾人指笑我，卒徒唾吾背乎？"
  },
  {
    "id": "s0320",
    "blockIndex": 26,
    "zh": "」即閉閣獨居齋舍，偏袒，持刀東西步。"
  },
  {
    "id": "s0321",
    "blockIndex": 26,
    "zh": "數日，使者召延年詣廷尉。"
  },
  {
    "id": "s0322",
    "blockIndex": 26,
    "zh": "聞鼓聲，自刎死。"
  },
  {
    "id": "s0323",
    "blockIndex": 26,
    "zh": "----2夏，五月，詔曰：「孝武皇帝躬仁誼，勵威武，功德茂盛，而廟樂未稱，聯甚悼焉。"
  },
  {
    "id": "s0324",
    "blockIndex": 26,
    "zh": "其與列侯、二千石、博士議。"
  },
  {
    "id": "s0325",
    "blockIndex": 26,
    "zh": "」於是群臣大議庭中，皆曰：「宜如詔書。"
  },
  {
    "id": "s0326",
    "blockIndex": 26,
    "zh": "」長信少府夏侯勝獨曰：「武帝雖有攘四夷、廣土境之功，然多殺士眾，竭民財力，奢泰無度，天下虛耗，百姓流離，物故者半，蝗蟲大起，赤地數千里，或人民相食，畜積至今未復；"
  },
  {
    "id": "s0327",
    "blockIndex": 26,
    "zh": "無德澤於民，不宜為立廟樂。"
  },
  {
    "id": "s0328",
    "blockIndex": 26,
    "zh": "」公卿共難勝曰：「此詔書也。"
  },
  {
    "id": "s0329",
    "blockIndex": 26,
    "zh": "」勝曰：「詔書不可用也。"
  },
  {
    "id": "s0330",
    "blockIndex": 26,
    "zh": "人臣之誼，宜直言正論，非苟阿意順指。"
  },
  {
    "id": "s0331",
    "blockIndex": 26,
    "zh": "議已出口，雖死不悔！"
  },
  {
    "id": "s0332",
    "blockIndex": 26,
    "zh": "」於是丞相、御史劾奏勝非議詔書，毀先帝，不道；"
  },
  {
    "id": "s0333",
    "blockIndex": 26,
    "zh": "及丞相長史黃霸阿縱勝，不舉劾；"
  },
  {
    "id": "s0334",
    "blockIndex": 26,
    "zh": "俱下獄。"
  },
  {
    "id": "s0335",
    "blockIndex": 26,
    "zh": "有司遂請尊孝武帝廟為世宗廟，奏《盛德》、《文始五行》之舞。"
  },
  {
    "id": "s0336",
    "blockIndex": 26,
    "zh": "武帝巡狩所幸郡國皆立廟，如高祖、太宗焉。"
  },
  {
    "id": "s0337",
    "blockIndex": 26,
    "zh": "夏侯勝、黃霸既久繫，霸欲從勝受《尚書》，勝辭以罪死。"
  },
  {
    "id": "s0338",
    "blockIndex": 26,
    "zh": "霸曰：「朝聞道，夕死可矣。"
  },
  {
    "id": "s0339",
    "blockIndex": 26,
    "zh": "」勝賢其言，遂授之。"
  },
  {
    "id": "s0340",
    "blockIndex": 26,
    "zh": "繫再更冬，講論不怠。"
  },
  {
    "id": "s0341",
    "blockIndex": 26,
    "zh": "----3初，烏孫公主死，漢復以楚王戊之孫解憂為公主，妻岑娶。"
  },
  {
    "id": "s0342",
    "blockIndex": 26,
    "zh": "岑娶胡婦子泥靡尚小，岑娶且死，以國與季父大祿子翁歸靡，曰：「泥靡大，以國歸之。"
  },
  {
    "id": "s0343",
    "blockIndex": 26,
    "zh": "」翁歸靡既立，號肥王，復尚楚主，生三男、兩女。"
  },
  {
    "id": "s0344",
    "blockIndex": 26,
    "zh": "長男曰元貴靡，次曰萬年，次曰大樂。"
  },
  {
    "id": "s0345",
    "blockIndex": 26,
    "zh": "昭帝時，公主上書言：「匈奴與車師共侵烏孫，唯天子幸救之。"
  },
  {
    "id": "s0346",
    "blockIndex": 26,
    "zh": "」漢養士馬，議擊匈奴。"
  },
  {
    "id": "s0347",
    "blockIndex": 26,
    "zh": "會昭帝崩，上遣光祿大夫常惠使烏孫。"
  },
  {
    "id": "s0348",
    "blockIndex": 26,
    "zh": "烏孫公主及昆彌皆遣使上書，言：「匈奴復連發大兵，侵擊烏孫。"
  },
  {
    "id": "s0349",
    "blockIndex": 26,
    "zh": "使使謂烏孫，『趣持公主來！"
  },
  {
    "id": "s0350",
    "blockIndex": 26,
    "zh": "』欲隔絕漢。"
  },
  {
    "id": "s0351",
    "blockIndex": 26,
    "zh": "昆彌願發國精兵五萬騎，盡力擊匈奴。"
  },
  {
    "id": "s0352",
    "blockIndex": 26,
    "zh": "唯天子出兵以救公主、昆彌！"
  },
  {
    "id": "s0353",
    "blockIndex": 26,
    "zh": "」先是匈奴數侵漢邊，漢亦欲討之。"
  },
  {
    "id": "s0354",
    "blockIndex": 26,
    "zh": "秋，大發兵，遣御史大夫田廣明為祁連將軍，四萬餘騎，出西河；"
  },
  {
    "id": "s0355",
    "blockIndex": 26,
    "zh": "度遼將軍范明友三萬餘騎，出張掖；"
  },
  {
    "id": "s0356",
    "blockIndex": 26,
    "zh": "前將軍韓增三萬餘騎，出雲中；"
  },
  {
    "id": "s0357",
    "blockIndex": 26,
    "zh": "後將軍趙充國為蒲類將軍，三萬餘騎，出酒泉；"
  },
  {
    "id": "s0358",
    "blockIndex": 26,
    "zh": "雲中太守田順為虎牙將軍，三萬餘騎，出五原；"
  },
  {
    "id": "s0359",
    "blockIndex": 26,
    "zh": "期以出塞各二千餘里。"
  },
  {
    "id": "s0360",
    "blockIndex": 26,
    "zh": "以常惠為校尉，持節護烏孫兵共擊匈奴。"
  },
  {
    "id": "s0362",
    "blockIndex": 27,
    "zh": "1春，正月，癸亥，恭哀許皇后崩。"
  },
  {
    "id": "s0363",
    "blockIndex": 27,
    "zh": "時霍光夫人顯欲貴其小女成君，道無從。"
  },
  {
    "id": "s0364",
    "blockIndex": 27,
    "zh": "會-{許后}-當娠，病，女醫-{淳于衍}-者，霍氏所愛，嘗入宮侍皇后疾。"
  },
  {
    "id": "s0365",
    "blockIndex": 27,
    "zh": "衍夫賞為掖庭戶衛，謂衍：「可過辭霍夫人，行為我求安池監。"
  },
  {
    "id": "s0366",
    "blockIndex": 27,
    "zh": "」衍如言報顯，顯因生心，辟左右，謂衍曰：「少夫幸報我以事，我亦欲報少夫，可乎？"
  },
  {
    "id": "s0367",
    "blockIndex": 27,
    "zh": "」衍曰：「夫人所言，何等不可者！"
  },
  {
    "id": "s0368",
    "blockIndex": 27,
    "zh": "」顯曰：「將軍素愛小女成君，欲奇貴之，願以累少夫。"
  },
  {
    "id": "s0369",
    "blockIndex": 27,
    "zh": "」衍曰：「何謂邪？"
  },
  {
    "id": "s0370",
    "blockIndex": 27,
    "zh": "」顯曰：「婦人免乳，大故，十死一生。"
  },
  {
    "id": "s0371",
    "blockIndex": 27,
    "zh": "今皇后當免身，可因投毒藥去也，成君即為皇后矣。"
  },
  {
    "id": "s0372",
    "blockIndex": 27,
    "zh": "如蒙力，事成，富貴與少夫共之。"
  },
  {
    "id": "s0373",
    "blockIndex": 27,
    "zh": "」衍曰：「藥雜治，常先嘗，安可？"
  },
  {
    "id": "s0374",
    "blockIndex": 27,
    "zh": "」顯曰：「在少夫為之耳。"
  },
  {
    "id": "s0375",
    "blockIndex": 27,
    "zh": "將軍領天下，誰敢言者！"
  },
  {
    "id": "s0376",
    "blockIndex": 27,
    "zh": "緩急相護，但恐少夫無意耳。"
  },
  {
    "id": "s0377",
    "blockIndex": 27,
    "zh": "」衍良久曰：「願盡力！"
  },
  {
    "id": "s0378",
    "blockIndex": 27,
    "zh": "」即搗附子，賫入長定宮。"
  },
  {
    "id": "s0379",
    "blockIndex": 27,
    "zh": "皇后免身後，衍取附子併合太醫大丸以飲皇后，有頃，曰：「我頭岑岑也，藥中得無有毒？"
  },
  {
    "id": "s0380",
    "blockIndex": 27,
    "zh": "」對曰：「無有。"
  },
  {
    "id": "s0381",
    "blockIndex": 27,
    "zh": "」遂加煩懣，崩。"
  },
  {
    "id": "s0382",
    "blockIndex": 27,
    "zh": "衍出，過見顯，相勞問，亦未敢重謝衍。"
  },
  {
    "id": "s0383",
    "blockIndex": 27,
    "zh": "後人有上書告諸醫侍疾無狀者，皆收繫詔獄，劾不道。"
  },
  {
    "id": "s0384",
    "blockIndex": 27,
    "zh": "顯恐急，即以狀具語光，因曰：「既失計為之，無令吏急衍！"
  },
  {
    "id": "s0385",
    "blockIndex": 27,
    "zh": "」光大驚，欲自發舉，不忍，猶與。"
  },
  {
    "id": "s0386",
    "blockIndex": 27,
    "zh": "會奏上，光署衍勿論。"
  },
  {
    "id": "s0387",
    "blockIndex": 27,
    "zh": "顯因勸光內其女入宮。"
  },
  {
    "id": "s0388",
    "blockIndex": 27,
    "zh": "----2戊辰，五將軍發長安。"
  },
  {
    "id": "s0389",
    "blockIndex": 27,
    "zh": "匈奴聞漢兵大出，老弱奔走，驅畜產遠遁逃，是以五將少所得。"
  },
  {
    "id": "s0390",
    "blockIndex": 27,
    "zh": "夏，五月，軍罷。"
  },
  {
    "id": "s0391",
    "blockIndex": 27,
    "zh": "度遼將軍出塞千二百餘里，至蒲離候水，斬首、捕虜七百餘級；"
  },
  {
    "id": "s0392",
    "blockIndex": 27,
    "zh": "前將軍出塞千二百餘里，至烏員，斬首、捕虜百餘級；"
  },
  {
    "id": "s0393",
    "blockIndex": 27,
    "zh": "蒲類將軍出塞千八百餘里，西至候山，斬首、捕虜，得單于使者蒲陰王以下三百餘級。"
  },
  {
    "id": "s0394",
    "blockIndex": 27,
    "zh": "聞虜已引去，皆不至期還。"
  },
  {
    "id": "s0395",
    "blockIndex": 27,
    "zh": "天子薄其過，寬而不罪。"
  },
  {
    "id": "s0396",
    "blockIndex": 27,
    "zh": "祁連將軍出塞千六百里，至雞秩山，斬首、捕虜十九級。"
  },
  {
    "id": "s0397",
    "blockIndex": 27,
    "zh": "逢漢使匈奴還者冉弘等，言雞秩山西有虜眾，祁連即戒弘，使言無虜，欲還兵。"
  },
  {
    "id": "s0398",
    "blockIndex": 27,
    "zh": "御史屬公孫益壽諫，以為主可。"
  },
  {
    "id": "s0399",
    "blockIndex": 27,
    "zh": "祁連不聽，遂引兵還。"
  },
  {
    "id": "s0400",
    "blockIndex": 27,
    "zh": "虎牙將軍出塞八百餘里，至丹餘吾水上，即止兵不進，斬首、捕虜千九百餘級，引兵還。"
  },
  {
    "id": "s0401",
    "blockIndex": 27,
    "zh": "上以虎牙將軍不至期，詐增鹵獲，而祁連知虜在前，逗遛不進，皆下吏，自殺。"
  },
  {
    "id": "s0402",
    "blockIndex": 27,
    "zh": "擢公孫益壽為侍御史。"
  },
  {
    "id": "s0403",
    "blockIndex": 28,
    "zh": "烏孫昆彌自將五萬騎與校尉常惠從西方入，至右谷蠡王庭，獲單于父行及嫂、居次、名王、犁汙都尉、千長、騎將以下四萬級，馬、牛、羊、驢、橐佗七十餘萬頭。"
  },
  {
    "id": "s0404",
    "blockIndex": 28,
    "zh": "烏孫皆自取所虜獲。"
  },
  {
    "id": "s0405",
    "blockIndex": 28,
    "zh": "上以五將皆無功，獨惠奉使克獲，封惠為長羅侯。"
  },
  {
    "id": "s0406",
    "blockIndex": 28,
    "zh": "然匈奴民眾傷而去者及畜產遠移死亡，不可勝數。"
  },
  {
    "id": "s0407",
    "blockIndex": 28,
    "zh": "於是匈奴遂衰耗，怨烏孫。"
  },
  {
    "id": "s0408",
    "blockIndex": 29,
    "zh": "上復遣常惠持金幣還賜烏孫貴人有功者。"
  },
  {
    "id": "s0409",
    "blockIndex": 29,
    "zh": "惠因奏請龜茲國嘗殺校尉賴丹，未伏誅，請便道擊之。"
  },
  {
    "id": "s0410",
    "blockIndex": 29,
    "zh": "帝不許。"
  },
  {
    "id": "s0411",
    "blockIndex": 29,
    "zh": "大將軍霍光風惠以便宜從事。"
  },
  {
    "id": "s0412",
    "blockIndex": 29,
    "zh": "惠與吏士五百人俱至烏孫，還，過，發西國兵二萬人，令副使發龜茲東國二萬人，烏孫兵七千人，從三面攻龜茲。"
  },
  {
    "id": "s0413",
    "blockIndex": 29,
    "zh": "兵未合，先遣人責其王以前殺漢使狀。"
  },
  {
    "id": "s0414",
    "blockIndex": 29,
    "zh": "王謝曰：「乃我先王時為貴人姑翼所誤耳，我無罪。"
  },
  {
    "id": "s0415",
    "blockIndex": 29,
    "zh": "」惠曰：「即如此，縛姑翼來，吾置王。"
  },
  {
    "id": "s0416",
    "blockIndex": 29,
    "zh": "」王執姑翼詣惠，惠斬之而還。"
  },
  {
    "id": "s0417",
    "blockIndex": 29,
    "zh": "----3大旱。"
  },
  {
    "id": "s0418",
    "blockIndex": 29,
    "zh": "----4六月，己丑，陽平節侯蔡義薨。"
  },
  {
    "id": "s0419",
    "blockIndex": 29,
    "zh": "----5甲辰，長信少府韋賢為丞相。"
  },
  {
    "id": "s0420",
    "blockIndex": 29,
    "zh": "----6大司農魏相為御史大夫。"
  },
  {
    "id": "s0421",
    "blockIndex": 29,
    "zh": "----7冬，匈奴單于自將數萬騎擊烏孫，頗得老弱。"
  },
  {
    "id": "s0422",
    "blockIndex": 29,
    "zh": "欲還，會天大雨雪，一日深丈餘，人民、畜產凍死，還者不能什一。"
  },
  {
    "id": "s0423",
    "blockIndex": 29,
    "zh": "於是丁令乘弱攻其北，烏桓入其東，烏孫擊其西，凡三國所殺數萬級，馬數萬匹，牛羊甚眾；"
  },
  {
    "id": "s0424",
    "blockIndex": 29,
    "zh": "又重以餓死，人民死者什三，畜產什五。"
  },
  {
    "id": "s0425",
    "blockIndex": 29,
    "zh": "匈奴大虛弱，諸國羈屬者皆瓦解，攻盜不能理。"
  },
  {
    "id": "s0426",
    "blockIndex": 29,
    "zh": "其後漢出三千餘騎為三道，並入匈奴，捕虜得數千人還；"
  },
  {
    "id": "s0427",
    "blockIndex": 29,
    "zh": "匈奴終不敢取當，滋欲鄉和親，而邊境少事矣。"
  },
  {
    "id": "s0428",
    "blockIndex": 29,
    "zh": "----8是歲，穎川太守趙廣漢為京兆尹。"
  },
  {
    "id": "s0429",
    "blockIndex": 29,
    "zh": "穎川俗，豪桀相朋黨。"
  },
  {
    "id": "s0430",
    "blockIndex": 29,
    "zh": "廣漢為缿筒，受吏民投書，使相告訐，於是更相怨咎，奸黨散落，盜賊不敢發。"
  },
  {
    "id": "s0431",
    "blockIndex": 29,
    "zh": "匈奴降者言匈奴中皆聞廣漢名，由是入為京兆尹。"
  },
  {
    "id": "s0432",
    "blockIndex": 29,
    "zh": "廣漢遇吏，殷勤甚備，事推功善，歸之於下，行之發於至誠，吏咸願為用，僵仆無所避。"
  },
  {
    "id": "s0433",
    "blockIndex": 29,
    "zh": "廣漢聰明，皆知其能之所宜，盡力與否；"
  },
  {
    "id": "s0434",
    "blockIndex": 29,
    "zh": "其或負者。"
  },
  {
    "id": "s0435",
    "blockIndex": 29,
    "zh": "輒收捕之，無所逃；"
  },
  {
    "id": "s0436",
    "blockIndex": 29,
    "zh": "案之，罪立具，即時伏辜。"
  },
  {
    "id": "s0437",
    "blockIndex": 29,
    "zh": "尤善為鉤距以得事情，-{閭里}-銖兩之奸皆知之。"
  },
  {
    "id": "s0438",
    "blockIndex": 29,
    "zh": "長安少年數人會窮-{里}-空舍，謀共劫人；"
  },
  {
    "id": "s0439",
    "blockIndex": 29,
    "zh": "坐語未訖，廣漢使吏捕治，具服。"
  },
  {
    "id": "s0440",
    "blockIndex": 29,
    "zh": "其發奸擿伏如神。"
  },
  {
    "id": "s0441",
    "blockIndex": 29,
    "zh": "京兆政清，吏民稱之不容口。"
  },
  {
    "id": "s0442",
    "blockIndex": 29,
    "zh": "長老傳以為自漢興，治京兆者莫能及。"
  },
  {
    "id": "s0444",
    "blockIndex": 30,
    "zh": "1春，三月，乙卯，立霍光女為皇后，赦天下。"
  },
  {
    "id": "s0445",
    "blockIndex": 30,
    "zh": "初，-{許后}-起微賤，登至尊日淺，從官車服甚節儉。"
  },
  {
    "id": "s0446",
    "blockIndex": 30,
    "zh": "及-{霍后}-立，輿駕、侍從益盛，賞賜官屬以千萬計，與-{許后}-時縣絕矣。"
  },
  {
    "id": "s0447",
    "blockIndex": 30,
    "zh": "----2夏，四月，壬寅，郡國四十九同日地震，或山崩，壞城郭、室屋，殺六千餘人。"
  },
  {
    "id": "s0448",
    "blockIndex": 30,
    "zh": "北海、琅邪壞祖宗廟。"
  },
  {
    "id": "s0449",
    "blockIndex": 30,
    "zh": "詔丞相、御史與列侯、中二千石博問經學之士，有以應變，毋有所諱。"
  },
  {
    "id": "s0450",
    "blockIndex": 30,
    "zh": "令三輔、太常、內郡國舉賢良方正各一人。"
  },
  {
    "id": "s0451",
    "blockIndex": 30,
    "zh": "大赦天下。"
  },
  {
    "id": "s0452",
    "blockIndex": 30,
    "zh": "上素服，避正殿五日。"
  },
  {
    "id": "s0453",
    "blockIndex": 30,
    "zh": "釋夏侯勝、黃霸，以勝為諫大夫、給事中，霸為揚州刺史。"
  },
  {
    "id": "s0454",
    "blockIndex": 31,
    "zh": "勝為人，質樸守正，簡易無威儀，或時謂上為君，誤相字於前；"
  },
  {
    "id": "s0455",
    "blockIndex": 31,
    "zh": "上亦以是親信之。"
  },
  {
    "id": "s0456",
    "blockIndex": 31,
    "zh": "嘗見，出道上語，上聞而讓勝，勝曰：「陛下所言善，臣故揚之。"
  },
  {
    "id": "s0457",
    "blockIndex": 31,
    "zh": "堯言佈於天下，至今見誦。"
  },
  {
    "id": "s0458",
    "blockIndex": 31,
    "zh": "臣以為可傳，故傳耳。"
  },
  {
    "id": "s0459",
    "blockIndex": 31,
    "zh": "」朝廷每有大議，上知勝素直，謂曰：「先生建正言，無懲前事！"
  },
  {
    "id": "s0460",
    "blockIndex": 31,
    "zh": "」勝復為長信少府，後遷太子太傅。"
  },
  {
    "id": "s0461",
    "blockIndex": 31,
    "zh": "年九十卒，太后賜錢二百萬，為勝素服五日，以報師傅之恩。"
  },
  {
    "id": "s0462",
    "blockIndex": 31,
    "zh": "儒者以為榮。"
  },
  {
    "id": "s0463",
    "blockIndex": 31,
    "zh": "----3五月，鳳皇集北海安丘、-{淳于}-。"
  },
  {
    "id": "s0464",
    "blockIndex": 31,
    "zh": "----4廣川王去坐殺其師及姬妾十餘人，或銷鉛錫灌口中，或支解，並毒藥煮之，令糜盡，廢徙上庸；"
  },
  {
    "id": "s0465",
    "blockIndex": 31,
    "zh": "自殺。"
  },
  {
    "id": "s0467",
    "blockIndex": 32,
    "zh": "1春，正月，有星孛於西方。"
  },
  {
    "id": "s0468",
    "blockIndex": 32,
    "zh": "----2楚王延壽以廣陵王胥，武帝子，天下有變，必得立，陰附肋之，為其後母弟趙何齊取廣陵王女為妻，因使何齊奉書遺廣陵王曰：「願長耳目，毋後人有天下！"
  },
  {
    "id": "s0469",
    "blockIndex": 32,
    "zh": "」何齊父長年上書告之，事下有司考驗，辭服。"
  },
  {
    "id": "s0470",
    "blockIndex": 32,
    "zh": "冬，十一月，延壽自殺。"
  },
  {
    "id": "s0471",
    "blockIndex": 32,
    "zh": "胥勿治。"
  },
  {
    "id": "s0472",
    "blockIndex": 32,
    "zh": "----3十二月，癸亥晦，日有食之。"
  },
  {
    "id": "s0473",
    "blockIndex": 32,
    "zh": "----4是歲，-{于定國}-為廷尉。"
  },
  {
    "id": "s0474",
    "blockIndex": 32,
    "zh": "定國決疑平法，務在哀鰥寡，罪疑從輕，加審慎之心。"
  },
  {
    "id": "s0475",
    "blockIndex": 32,
    "zh": "朝廷稱之曰：「張釋之為廷尉，天下無冤民。"
  },
  {
    "id": "s0476",
    "blockIndex": 32,
    "zh": "-{于定國}-為廷尉，民自以不冤。"
  },
  {
    "id": "s0478",
    "blockIndex": 33,
    "zh": "1春，霍光病篤。"
  },
  {
    "id": "s0479",
    "blockIndex": 33,
    "zh": "車駕自臨問，上為之涕泣。"
  },
  {
    "id": "s0480",
    "blockIndex": 33,
    "zh": "光上書謝恩，願分國邑三千戶以封兄孫奉車都尉山為列侯，奉兄去病祀。"
  },
  {
    "id": "s0481",
    "blockIndex": 33,
    "zh": "即日，拜光子禹為右將軍。"
  },
  {
    "id": "s0482",
    "blockIndex": 33,
    "zh": "三月，庚午，光薨。"
  },
  {
    "id": "s0483",
    "blockIndex": 33,
    "zh": "上及皇太后親臨光喪，中二千石治塚，賜梓宮、葬具皆如乘輿制度，謚曰宣成侯。"
  },
  {
    "id": "s0484",
    "blockIndex": 33,
    "zh": "發三河卒穿覆土，置園邑三百家，長、丞奉守；"
  },
  {
    "id": "s0485",
    "blockIndex": 33,
    "zh": "下詔復其後世，疇其爵邑，世世無有所與。"
  },
  {
    "id": "s0486",
    "blockIndex": 34,
    "zh": "御史大夫魏相上封事曰：「國家新失大將軍，宜顯明功臣以填籓國，毋空大位，以塞爭權。"
  },
  {
    "id": "s0487",
    "blockIndex": 34,
    "zh": "宜以車騎將軍安世為大將軍，毋令領光祿勳事；"
  },
  {
    "id": "s0488",
    "blockIndex": 34,
    "zh": "以其子延壽為光祿勳。"
  },
  {
    "id": "s0489",
    "blockIndex": 34,
    "zh": "」上亦欲用之。"
  },
  {
    "id": "s0490",
    "blockIndex": 34,
    "zh": "夏，四月，戊申，以安世為大司馬、車騎將軍，領尚書事。"
  },
  {
    "id": "s0491",
    "blockIndex": 34,
    "zh": "----2鳳皇集魯，群鳥從之。"
  },
  {
    "id": "s0492",
    "blockIndex": 34,
    "zh": "大赦天下。"
  },
  {
    "id": "s0493",
    "blockIndex": 34,
    "zh": "----3上思報大將軍德，乃封光兄孫山為樂平侯，使以奉車都尉領尚書事。"
  },
  {
    "id": "s0494",
    "blockIndex": 34,
    "zh": "魏相因昌成君許廣漢奏封事，言：「《春秋》譏世卿，惡宋三世為大夫及魯季孫之專權，皆危亂國家。"
  },
  {
    "id": "s0495",
    "blockIndex": 34,
    "zh": "自後元以來，祿去王室，政由冢宰。"
  },
  {
    "id": "s0496",
    "blockIndex": 34,
    "zh": "今光死，子復為右將軍，兄子秉樞機，昆弟、諸婿據權勢，在兵官，光夫人顯及諸女皆通籍長信宮，或夜詔門出入，驕奢放縱，恐寢不制，宜有以損奪其權，破散陰謀，以固萬世之基，全功臣之世。"
  },
  {
    "id": "s0497",
    "blockIndex": 34,
    "zh": "」又故事：諸上書者皆為二封，署其一曰「副」，領尚書者先發副封，所言不善，屏去不奏。"
  },
  {
    "id": "s0498",
    "blockIndex": 34,
    "zh": "相復因許伯白去副封以防壅蔽。"
  },
  {
    "id": "s0499",
    "blockIndex": 34,
    "zh": "帝善之，詔相給事中，皆從其議。"
  },
  {
    "id": "s0500",
    "blockIndex": 34,
    "zh": "----4帝興於閭閻，知民事之艱難。"
  },
  {
    "id": "s0501",
    "blockIndex": 34,
    "zh": "霍光既薨，始親政事，厲精為治，五日一聽事。"
  },
  {
    "id": "s0502",
    "blockIndex": 34,
    "zh": "自丞相以下各奉職奏事，敷奏其言，考試功能。"
  },
  {
    "id": "s0503",
    "blockIndex": 34,
    "zh": "侍中、尚書功勞當遷及有異善，厚加賞賜，至於子孫，終不改易。"
  },
  {
    "id": "s0504",
    "blockIndex": 34,
    "zh": "樞機周密，品式備具，上下相安，莫有苟且之意。"
  },
  {
    "id": "s0505",
    "blockIndex": 34,
    "zh": "及拜刺史、守、相，輒親見問，觀其所由，退而考察所行以質其言，有名實不相應，必知其所必然。"
  },
  {
    "id": "s0506",
    "blockIndex": 34,
    "zh": "常稱曰：「庶民所以安其-{田里}-而亡歎息愁恨之心者，政平訟理也。"
  },
  {
    "id": "s0507",
    "blockIndex": 34,
    "zh": "與我共此者，其唯良二千石乎！"
  },
  {
    "id": "s0508",
    "blockIndex": 34,
    "zh": "」以為太守，吏民之本，數變易則下不安；"
  },
  {
    "id": "s0509",
    "blockIndex": 34,
    "zh": "民知其將久，不可欺罔，乃服從其教化。"
  },
  {
    "id": "s0510",
    "blockIndex": 34,
    "zh": "故二千石有治理效，輒以璽書勉厲，增秩，賜金，或爵至關內侯；"
  },
  {
    "id": "s0511",
    "blockIndex": 34,
    "zh": "公卿缺，則選諸所表，以次用之。"
  },
  {
    "id": "s0512",
    "blockIndex": 34,
    "zh": "是以漢世良吏，於是為盛，稱中興焉。"
  },
  {
    "id": "s0513",
    "blockIndex": 34,
    "zh": "----5匈奴壺衍鞮單于死，弟左賢王立為虛閭權渠單于，以右大將女為大閼氏，而黜前單于所幸顓渠閼氏。"
  },
  {
    "id": "s0514",
    "blockIndex": 34,
    "zh": "顓渠閼氏父左大且渠怨望。"
  },
  {
    "id": "s0515",
    "blockIndex": 34,
    "zh": "是時漢以匈奴不能為邊寇，罷塞外諸城以休百姓。"
  },
  {
    "id": "s0516",
    "blockIndex": 34,
    "zh": "單于聞之，喜，召貴人謀，欲與漢和親。"
  },
  {
    "id": "s0517",
    "blockIndex": 34,
    "zh": "左大且渠心害其事，曰：「前漢使來，兵隨其後。"
  },
  {
    "id": "s0518",
    "blockIndex": 34,
    "zh": "今亦效漢發兵，先使使者入。"
  },
  {
    "id": "s0519",
    "blockIndex": 34,
    "zh": "」乃自請與呼盧訾王各將萬騎，南旁塞獵，相逢俱入。"
  },
  {
    "id": "s0520",
    "blockIndex": 34,
    "zh": "行未到，會三騎亡降漢，言匈奴欲為寇。"
  },
  {
    "id": "s0521",
    "blockIndex": 34,
    "zh": "於是天子詔發邊騎屯要害處，使大將軍軍監治眾等四人將五千騎，分三隊，出塞各數百里，捕得虜各數十人而還。"
  },
  {
    "id": "s0522",
    "blockIndex": 34,
    "zh": "時匈奴亡其三騎，不敢入，即引去。"
  },
  {
    "id": "s0523",
    "blockIndex": 34,
    "zh": "是歲，匈奴饑，人民、畜產死者什六七，又發兩屯各萬騎以備漢。"
  },
  {
    "id": "s0524",
    "blockIndex": 34,
    "zh": "其秋，匈奴前所得西嗕居左地者，其君長以下數千人皆驅畜產行，與甌脫戰，所殺傷甚眾，遂南降漢。"
  },
  {
    "id": "s0525",
    "blockIndex": 34,
    "zh": "----category:資治通鑑"
  }
]
