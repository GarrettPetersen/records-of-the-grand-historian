[
  {
    "id": "s0001",
    "blockIndex": 0,
    "zh": "資治通鑑 第160卷卷第一百六十"
  },
  {
    "id": "s0002",
    "blockIndex": 1,
    "zh": "【梁紀十六】　強圉單閼，一年。"
  },
  {
    "id": "s0003",
    "blockIndex": 2,
    "zh": "高祖武皇帝十六太清元年（"
  },
  {
    "id": "s0003",
    "blockIndex": 2,
    "zh": "丁卯，公元五四七年）"
  },
  {
    "id": "s0005",
    "blockIndex": 3,
    "zh": "春，正月朔，日有食之，不盡如鉤。"
  },
  {
    "id": "s0006",
    "blockIndex": 4,
    "zh": "壬寅，荊州刺史廬陵威王續卒。"
  },
  {
    "id": "s0006",
    "blockIndex": 4,
    "zh": "以湘東王繹為都督荊、雍等九州諸軍事、荊州刺史。"
  },
  {
    "id": "s0006",
    "blockIndex": 4,
    "zh": "續素貪婪，臨終，有啟遣中錄事參軍謝宣融獻金銀器千餘件，上方知其富，因問宣融曰：「王之金盡此乎？"
  },
  {
    "id": "s0006",
    "blockIndex": 4,
    "zh": "」宣融曰：「此之謂多，安可加也！"
  },
  {
    "id": "s0006",
    "blockIndex": 4,
    "zh": "大王之過如日月之食，欲令陛下知之，故終而不隱。"
  },
  {
    "id": "s0006",
    "blockIndex": 4,
    "zh": "」上意乃解。"
  },
  {
    "id": "s0012",
    "blockIndex": 5,
    "zh": "初，湘東王繹為荊州刺史，有微過，續代之，以狀聞，自此二王不通書問。"
  },
  {
    "id": "s0012",
    "blockIndex": 5,
    "zh": "繹聞其死，入閣而躍，屜為之破。"
  },
  {
    "id": "s0014",
    "blockIndex": 6,
    "zh": "丙午，東魏勃海獻武王歡卒。"
  },
  {
    "id": "s0014",
    "blockIndex": 6,
    "zh": "歡性深密，終日儼然，人不能測，機權之際，變化若神。"
  },
  {
    "id": "s0014",
    "blockIndex": 6,
    "zh": "制馭軍旅，法令嚴肅。"
  },
  {
    "id": "s0014",
    "blockIndex": 6,
    "zh": "聽斷明察，不可欺犯。"
  },
  {
    "id": "s0014",
    "blockIndex": 6,
    "zh": "擢人受任，在於得才，苟其所堪，無問廝養；"
  },
  {
    "id": "s0014",
    "blockIndex": 6,
    "zh": "有虛聲無實者，皆不任用。"
  },
  {
    "id": "s0014",
    "blockIndex": 6,
    "zh": "雅尚儉素，刀劍鞍勒無金玉之飾。"
  },
  {
    "id": "s0014",
    "blockIndex": 6,
    "zh": "少能劇飲，自當大任，不過三爵。"
  },
  {
    "id": "s0014",
    "blockIndex": 6,
    "zh": "知人好士，全護勳舊；"
  },
  {
    "id": "s0014",
    "blockIndex": 6,
    "zh": "每獲敵國盡節之臣，多不之罪。"
  },
  {
    "id": "s0014",
    "blockIndex": 6,
    "zh": "由是文武樂為之用。"
  },
  {
    "id": "s0014",
    "blockIndex": 6,
    "zh": "世子澄秘不發喪，唯行台左丞陳元康知之。"
  },
  {
    "id": "s0026",
    "blockIndex": 7,
    "zh": "侯景自念已與高氏有隙，內不自安。"
  },
  {
    "id": "s0026",
    "blockIndex": 7,
    "zh": "辛亥，據河南叛，歸於魏，穎州刺史司馬世雲以城應之。"
  },
  {
    "id": "s0026",
    "blockIndex": 7,
    "zh": "景誘執豫州刺史高元成、襄州刺史李密、廣州刺史懷朔暴顯等。"
  },
  {
    "id": "s0026",
    "blockIndex": 7,
    "zh": "遣軍士二百人載仗，暮入西兗州，欲襲取之。"
  },
  {
    "id": "s0026",
    "blockIndex": 7,
    "zh": "刺史邢子才覺之，掩捕，盡獲之。"
  },
  {
    "id": "s0026",
    "blockIndex": 7,
    "zh": "因散檄東方諸州，各為之備，由是景不能取。"
  },
  {
    "id": "s0032",
    "blockIndex": 8,
    "zh": "諸將皆以為景之叛由崔暹，澄不得已，欲殺暹以謝景。"
  },
  {
    "id": "s0032",
    "blockIndex": 8,
    "zh": "陳元康諫曰：「今雖四海未清，綱紀已定；"
  },
  {
    "id": "s0032",
    "blockIndex": 8,
    "zh": "若以數將在外，苟悅其心，枉殺無辜，虧廢刑典，豈直上負天神，何以下安黎庶！"
  },
  {
    "id": "s0032",
    "blockIndex": 8,
    "zh": "晁錯前事，願公慎之。"
  },
  {
    "id": "s0032",
    "blockIndex": 8,
    "zh": "」澄乃止，遣司空韓軌督諸軍討景。"
  },
  {
    "id": "s0037",
    "blockIndex": 9,
    "zh": "辛酉，上祀南郊，大赦；"
  },
  {
    "id": "s0037",
    "blockIndex": 9,
    "zh": "甲子，祀明堂。"
  },
  {
    "id": "s0039",
    "blockIndex": 10,
    "zh": "二月，魏詔：「自今應宮刑者，直沒官，勿刑。"
  },
  {
    "id": "s0041",
    "blockIndex": 11,
    "zh": "魏以開府儀同三司若於惠為司空，侯景為太傅、河南大行台、上谷公。"
  },
  {
    "id": "s0042",
    "blockIndex": 12,
    "zh": "庚辰，景又遣其行台郎中丁和來，上表言：「臣與高澄有隙，請舉函谷以東，瑕丘以西，豫、廣、穎、荊、襄、兗、南兗、濟、東豫、洛、陽、北荊、北揚等十三州內附，惟青、徐數州，僅須折簡。"
  },
  {
    "id": "s0042",
    "blockIndex": 12,
    "zh": "且黃河以南，皆臣所職，易同反掌。"
  },
  {
    "id": "s0042",
    "blockIndex": 12,
    "zh": "若齊、宋一平，徐事燕、趙。"
  },
  {
    "id": "s0042",
    "blockIndex": 12,
    "zh": "」上召群臣廷議。"
  },
  {
    "id": "s0042",
    "blockIndex": 12,
    "zh": "尚書僕射謝舉等皆曰：「頃歲與魏通和，邊境無事，今納其叛臣，竊謂非宜。"
  },
  {
    "id": "s0042",
    "blockIndex": 12,
    "zh": "」上曰：「雖然，得景則塞北可清；"
  },
  {
    "id": "s0042",
    "blockIndex": 12,
    "zh": "機會難得，豈宜膠柱！"
  },
  {
    "id": "s0050",
    "blockIndex": 13,
    "zh": "是歲，正月，乙卯，上夢中原牧守皆以地來降，舉朝稱慶。"
  },
  {
    "id": "s0050",
    "blockIndex": 13,
    "zh": "旦，見中書舍人朱異，告之，旦曰：「吾為人少夢，若有夢，必實。"
  },
  {
    "id": "s0050",
    "blockIndex": 13,
    "zh": "」異曰：「此乃宇內混壹之兆也。"
  },
  {
    "id": "s0050",
    "blockIndex": 13,
    "zh": "」及丁和至，稱景定計以正月乙卯，上愈神之。"
  },
  {
    "id": "s0050",
    "blockIndex": 13,
    "zh": "然意猶未決，嘗獨言：「我國家如金甌，無一傷缺，今忽受景地，詎是事宜？"
  },
  {
    "id": "s0050",
    "blockIndex": 13,
    "zh": "脫致紛紜，悔之何及？"
  },
  {
    "id": "s0050",
    "blockIndex": 13,
    "zh": "」朱異揣知上意，對曰：「聖明御宇，南北歸仰，正以事無機會，未達其心。"
  },
  {
    "id": "s0050",
    "blockIndex": 13,
    "zh": "今侯景分魏土之半以來，自非天誘其衷，人讚其謀，何以至此！"
  },
  {
    "id": "s0050",
    "blockIndex": 13,
    "zh": "若拒而不內，恐絕後來之望。"
  },
  {
    "id": "s0050",
    "blockIndex": 13,
    "zh": "此誠易見，願陛下無疑。"
  },
  {
    "id": "s0050",
    "blockIndex": 13,
    "zh": "」上乃定議納景。"
  },
  {
    "id": "s0050",
    "blockIndex": 13,
    "zh": "壬午，以景為大將軍，封河南王，都督河南北諸軍事、大行台，承製如鄧禹故事。"
  },
  {
    "id": "s0050",
    "blockIndex": 13,
    "zh": "平西咨議參軍周弘正，善占候，前此謂人曰：「國家數年後當有兵起。"
  },
  {
    "id": "s0050",
    "blockIndex": 13,
    "zh": "」及聞納景，曰：「亂階在此矣！"
  },
  {
    "id": "s0065",
    "blockIndex": 14,
    "zh": "丁亥，上耕藉田。"
  },
  {
    "id": "s0066",
    "blockIndex": 15,
    "zh": "三月，庚子，上幸同泰寺，捨身如大通故事。"
  },
  {
    "id": "s0067",
    "blockIndex": 16,
    "zh": "甲辰，遣司州刺史羊鴉仁督兗州刺史桓和、仁州刺史湛海珍等，將兵三萬趣懸瓠，運糧食應接侯景。"
  },
  {
    "id": "s0068",
    "blockIndex": 17,
    "zh": "魏大赦。"
  },
  {
    "id": "s0068",
    "blockIndex": 17,
    "zh": "東魏高澄慮諸州有變，乃自出巡撫。"
  },
  {
    "id": "s0068",
    "blockIndex": 17,
    "zh": "留段韶守晉陽，委以軍事；"
  },
  {
    "id": "s0068",
    "blockIndex": 17,
    "zh": "以丞相功曹趙彥深為大行台都官郎中。"
  },
  {
    "id": "s0068",
    "blockIndex": 17,
    "zh": "使陳元康豫作丞相歡條教數十紙付韶及彥深，在後以次行之。"
  },
  {
    "id": "s0068",
    "blockIndex": 17,
    "zh": "臨發，握彥深手泣曰：「以母、弟相托，幸明此心！"
  },
  {
    "id": "s0068",
    "blockIndex": 17,
    "zh": "」夏，四月，壬申，澄入朝於鄴。"
  },
  {
    "id": "s0068",
    "blockIndex": 17,
    "zh": "東魏主與之宴，澄起舞，識者知其不終。"
  },
  {
    "id": "s0076",
    "blockIndex": 18,
    "zh": "丙子，群臣奉贖。"
  },
  {
    "id": "s0076",
    "blockIndex": 18,
    "zh": "丁亥，上還宮，大赦，改元，如大通故事。"
  },
  {
    "id": "s0078",
    "blockIndex": 19,
    "zh": "甲午，東魏遣兼散騎常侍李系來聘。"
  },
  {
    "id": "s0078",
    "blockIndex": 19,
    "zh": "系，繪之弟也。"
  },
  {
    "id": "s0080",
    "blockIndex": 20,
    "zh": "五月，丁酉朔，東魏大赦。"
  },
  {
    "id": "s0081",
    "blockIndex": 21,
    "zh": "戊戌，東魏以襄城王旭為太尉。"
  },
  {
    "id": "s0081",
    "blockIndex": 21,
    "zh": "高澄遣武衛將軍元柱等將數萬眾晝夜兼行以襲侯景，遇景於穎川北，柱等大敗。"
  },
  {
    "id": "s0081",
    "blockIndex": 21,
    "zh": "景以羊鴉仁等軍猶未至，乃退保穎川。"
  },
  {
    "id": "s0084",
    "blockIndex": 22,
    "zh": "甲辰，東魏以開府儀同三司庫狄干為太師，錄尚書事孫騰為太傅，汾州刺史賀拔仁為太保，司徒高隆之錄尚書事，司空韓軌為司徒，青州刺史尉景為大司馬，領軍將軍可朱渾道元為司空，僕射高洋為尚書令、領中書監，徐州刺史慕容紹宗為尚書左僕射，高陽王斌為右僕射。"
  },
  {
    "id": "s0084",
    "blockIndex": 22,
    "zh": "戊午，尉景卒。"
  },
  {
    "id": "s0086",
    "blockIndex": 23,
    "zh": "韓軌等圍侯景於穎川。"
  },
  {
    "id": "s0086",
    "blockIndex": 23,
    "zh": "景懼，割東荊、北兗州、魯陽、長社四城賂魏以求救。"
  },
  {
    "id": "s0086",
    "blockIndex": 23,
    "zh": "尚書左僕射於謹曰：「景少習兵，奸詐難測，不如厚其爵位以觀其變，未可遣兵也。"
  },
  {
    "id": "s0086",
    "blockIndex": 23,
    "zh": "」荊州刺史王思政以為：「若不因機進取，後悔無及。"
  },
  {
    "id": "s0086",
    "blockIndex": 23,
    "zh": "」即以荊州步騎萬餘從魯陽關向陽翟。"
  },
  {
    "id": "s0086",
    "blockIndex": 23,
    "zh": "丞相泰聞之，加景大將軍兼尚書令，遣太尉李弼、儀同三司趙貴將兵一萬赴穎川。"
  },
  {
    "id": "s0092",
    "blockIndex": 24,
    "zh": "景恐上責之，遣中兵參軍柳□開奉啟於上，以為：「王旅未接，死亡交急，遂求援關中，自救目前。"
  },
  {
    "id": "s0092",
    "blockIndex": 24,
    "zh": "臣既不安於高氏，豈見容於宇文！"
  },
  {
    "id": "s0092",
    "blockIndex": 24,
    "zh": "但螫手解腕，事不得已，本圖為國，願不賜咎！"
  },
  {
    "id": "s0092",
    "blockIndex": 24,
    "zh": "臣獲其力，不容即棄，今以四州之地為餌敵之資，已令宇文遣人入守。"
  },
  {
    "id": "s0092",
    "blockIndex": 24,
    "zh": "自豫州以東，齊海以西，悉臣控壓；"
  },
  {
    "id": "s0092",
    "blockIndex": 24,
    "zh": "見有之地，盡歸聖朝，懸瓠、項城、徐州、南兗，事須迎納。"
  },
  {
    "id": "s0092",
    "blockIndex": 24,
    "zh": "願陛下速敕境上，各置重兵，與臣影響，不使差互！"
  },
  {
    "id": "s0092",
    "blockIndex": 24,
    "zh": "」上報之曰：「大夫出境，尚有所專；"
  },
  {
    "id": "s0092",
    "blockIndex": 24,
    "zh": "況始創奇謀，將建大業，理須適事而行，隨方以應。"
  },
  {
    "id": "s0092",
    "blockIndex": 24,
    "zh": "卿誠心有本，何假詞費！"
  },
  {
    "id": "s0103",
    "blockIndex": 25,
    "zh": "魏以開府儀同三司獨孤信為大司馬。"
  },
  {
    "id": "s0104",
    "blockIndex": 26,
    "zh": "六月，戊辰，以鄱陽王范為征北將軍，總督漢北征討諸軍事，擊穰城。"
  },
  {
    "id": "s0105",
    "blockIndex": 27,
    "zh": "東魏韓軌等圍穎川，聞魏李弼、趙貴等將至，己巳，引兵還鄴。"
  },
  {
    "id": "s0105",
    "blockIndex": 27,
    "zh": "侯景欲因會執弼與貴，奪其軍；"
  },
  {
    "id": "s0105",
    "blockIndex": 27,
    "zh": "貴疑之，不往。"
  },
  {
    "id": "s0105",
    "blockIndex": 27,
    "zh": "貴欲誘景入營而執之，弼止之。"
  },
  {
    "id": "s0105",
    "blockIndex": 27,
    "zh": "羊鴉仁遣長史鄧鴻將兵至汝水，弼引兵還長安。"
  },
  {
    "id": "s0105",
    "blockIndex": 27,
    "zh": "王思政入據穎川。"
  },
  {
    "id": "s0105",
    "blockIndex": 27,
    "zh": "景陽稱略地，引軍出屯懸瓠。"
  },
  {
    "id": "s0112",
    "blockIndex": 28,
    "zh": "景復乞兵於魏，丞相泰使同軌防主韋法保及都督賀蘭願德等將兵助之。"
  },
  {
    "id": "s0112",
    "blockIndex": 28,
    "zh": "大行台左丞藍田王悅言於泰曰：「侯景之於高歡，始敦鄉黨之情，終定君臣之契，任居上將，位重台司；"
  },
  {
    "id": "s0112",
    "blockIndex": 28,
    "zh": "今歡始死，景遽外叛，蓋所圖甚大，終不為人下故也。"
  },
  {
    "id": "s0112",
    "blockIndex": 28,
    "zh": "且彼能背德於高氏，豈肯盡節於朝廷！"
  },
  {
    "id": "s0112",
    "blockIndex": 28,
    "zh": "今益之以勢，援之以兵，竊恐朝廷貽笑將來也。"
  },
  {
    "id": "s0112",
    "blockIndex": 28,
    "zh": "」泰乃召景入朝。"
  },
  {
    "id": "s0118",
    "blockIndex": 29,
    "zh": "景陰謀叛魏，事計未成，厚撫韋法保等，冀為己用，外示親密無猜間，每往來諸軍間，侍從至少，魏軍中名將，皆身自造詣。"
  },
  {
    "id": "s0118",
    "blockIndex": 29,
    "zh": "同軌防長史裴寬謂法保曰：「侯景狡詐，必不肯入關，欲托款於公，恐未可信。"
  },
  {
    "id": "s0118",
    "blockIndex": 29,
    "zh": "若伏兵斬之，此亦一時之功也。"
  },
  {
    "id": "s0118",
    "blockIndex": 29,
    "zh": "如其不爾，即應深為之防，不得信其誑誘，自貽後悔。"
  },
  {
    "id": "s0118",
    "blockIndex": 29,
    "zh": "」法保深然之，不敢圖景，但自為備而已；"
  },
  {
    "id": "s0118",
    "blockIndex": 29,
    "zh": "尋辭還所鎮。"
  },
  {
    "id": "s0118",
    "blockIndex": 29,
    "zh": "王思政亦覺其詐，密召賀蘭願德等還，分佈諸軍，據景七州、十二鎮。"
  },
  {
    "id": "s0118",
    "blockIndex": 29,
    "zh": "景果辭不入朝，遺丞相泰書曰：「吾恥與高澄雁行，安能比肩大弟！"
  },
  {
    "id": "s0118",
    "blockIndex": 29,
    "zh": "」泰乃遣行台郎中趙士憲悉召前後所遣諸軍援景者。"
  },
  {
    "id": "s0118",
    "blockIndex": 29,
    "zh": "景遂決意來降。"
  },
  {
    "id": "s0118",
    "blockIndex": 29,
    "zh": "魏將任約以所部千餘人降於景。"
  },
  {
    "id": "s0129",
    "blockIndex": 30,
    "zh": "泰以所授景使持節、太傅、大將軍、兼尚書令、河南大行台、都督河南諸軍事回授王思政，思政並讓不受；"
  },
  {
    "id": "s0129",
    "blockIndex": 30,
    "zh": "頻使敦諭，唯受都督河南諸軍事。"
  },
  {
    "id": "s0131",
    "blockIndex": 31,
    "zh": "高澄將如晉陽，以弟洋為京畿大都督，留守於鄴，使黃門侍郎高德政佐之。"
  },
  {
    "id": "s0131",
    "blockIndex": 31,
    "zh": "德政，顥之子也。"
  },
  {
    "id": "s0131",
    "blockIndex": 31,
    "zh": "丁丑，澄還晉陽，始發喪。"
  },
  {
    "id": "s0134",
    "blockIndex": 32,
    "zh": "秋，七月，魏長樂武烈公若於惠卒。"
  },
  {
    "id": "s0135",
    "blockIndex": 33,
    "zh": "丁酉，東魏主為丞相歡舉哀，服緦縗，凶禮依漢霍光故事，贈相國、齊王，備九錫殊禮。"
  },
  {
    "id": "s0135",
    "blockIndex": 33,
    "zh": "戊戌，以高澄為使持節、大丞相、都督中外諸軍、錄尚書事、大行台、勃海王；"
  },
  {
    "id": "s0135",
    "blockIndex": 33,
    "zh": "澄啟辭爵位。"
  },
  {
    "id": "s0135",
    "blockIndex": 33,
    "zh": "壬寅，詔太原公洋攝理軍國，遣中使敦諭澄。"
  },
  {
    "id": "s0139",
    "blockIndex": 34,
    "zh": "庚申，羊鴉仁入懸瓠城。"
  },
  {
    "id": "s0139",
    "blockIndex": 34,
    "zh": "甲子，詔更以懸瓠為豫州，壽春為南豫州，改合肥為合州。"
  },
  {
    "id": "s0139",
    "blockIndex": 34,
    "zh": "以鴉仁為司、豫二州刺史，鎮縣瓠；"
  },
  {
    "id": "s0139",
    "blockIndex": 34,
    "zh": "西陽太守羊思達為殷州刺史，鎮項城。"
  },
  {
    "id": "s0143",
    "blockIndex": 35,
    "zh": "八月，乙丑，下詔大舉伐東魏。"
  },
  {
    "id": "s0143",
    "blockIndex": 35,
    "zh": "遣南豫州刺史貞陽侯淵明、南兗州刺史南康王會理分督諸將。"
  },
  {
    "id": "s0143",
    "blockIndex": 35,
    "zh": "淵明，懿之子；"
  },
  {
    "id": "s0143",
    "blockIndex": 35,
    "zh": "會理，績之子也。"
  },
  {
    "id": "s0143",
    "blockIndex": 35,
    "zh": "始，上欲以鄱陽王范為元帥；"
  },
  {
    "id": "s0143",
    "blockIndex": 35,
    "zh": "朱異取急在外，聞之，遽入曰：「鄱陽雄豪蓋世，得人死力，然所至殘暴，非弔民之材。"
  },
  {
    "id": "s0143",
    "blockIndex": 35,
    "zh": "且陛下昔登北顧亭以望，謂江右有反氣，骨肉為戎首。"
  },
  {
    "id": "s0143",
    "blockIndex": 35,
    "zh": "今日之事，尤宜詳擇。"
  },
  {
    "id": "s0143",
    "blockIndex": 35,
    "zh": "」上默然，曰：「會理何如？"
  },
  {
    "id": "s0143",
    "blockIndex": 35,
    "zh": "」對曰：「陛下得之矣。"
  },
  {
    "id": "s0143",
    "blockIndex": 35,
    "zh": "」會理懦而無謀，所乘襻輿，施板屋，冠以牛皮。"
  },
  {
    "id": "s0143",
    "blockIndex": 35,
    "zh": "上聞，不悅。"
  },
  {
    "id": "s0143",
    "blockIndex": 35,
    "zh": "貞陽侯淵明時鎮壽陽，屢請行，上許之。"
  },
  {
    "id": "s0143",
    "blockIndex": 35,
    "zh": "會理自以皇孫，復為都督，自淵明已下，殆不對接。"
  },
  {
    "id": "s0143",
    "blockIndex": 35,
    "zh": "淵明與諸將密告朱異，追會理還，遂以淵明為都督。"
  },
  {
    "id": "s0158",
    "blockIndex": 36,
    "zh": "辛未，高澄入朝於鄴，固辭大丞相；"
  },
  {
    "id": "s0158",
    "blockIndex": 36,
    "zh": "詔為大將軍如故，餘如前命。"
  },
  {
    "id": "s0160",
    "blockIndex": 37,
    "zh": "甲申，虛葬齊獻武王於漳水之西；"
  },
  {
    "id": "s0160",
    "blockIndex": 37,
    "zh": "潛鑿成安鼓山石窟佛頂之旁為穴，納其柩而塞之，殺其群匠。"
  },
  {
    "id": "s0160",
    "blockIndex": 37,
    "zh": "及齊之亡也，一匠之子知之，發石取金而逃。"
  },
  {
    "id": "s0160",
    "blockIndex": 37,
    "zh": "戊子，武州刺史蕭弄璋攻東魏磧泉、呂梁二戍，拔之。"
  },
  {
    "id": "s0164",
    "blockIndex": 38,
    "zh": "或告東魏大將軍澄云：「侯景有北歸之志。"
  },
  {
    "id": "s0164",
    "blockIndex": 38,
    "zh": "」會景將蔡道遵北歸，言「景頗知悔過」。"
  },
  {
    "id": "s0164",
    "blockIndex": 38,
    "zh": "景母及妻子皆在鄴，澄乃以書諭之，語以闔門無恙，若還，許以豫州刺史終其身，還其寵妻、愛子，所部文武，更不追攝。"
  },
  {
    "id": "s0164",
    "blockIndex": 38,
    "zh": "景使王偉復書曰：「今已引二邦，揚旌北討，熊豹齊奮，克復中原，幸自取之，何勞恩賜！"
  },
  {
    "id": "s0164",
    "blockIndex": 38,
    "zh": "昔王陵附漢，母在不歸，太上囚楚，乞羹自若，矧伊妻子，而可介意！"
  },
  {
    "id": "s0164",
    "blockIndex": 38,
    "zh": "脫謂誅之有益，欲止不能，殺之無損，徒復坑戮，家累在君，何關僕也！"
  },
  {
    "id": "s0171",
    "blockIndex": 39,
    "zh": "戊子，詔以景錄行台尚書事。"
  },
  {
    "id": "s0172",
    "blockIndex": 40,
    "zh": "東魏靜帝，美容儀，旅力過人，能挾石師子逾宮牆，射無不中；"
  },
  {
    "id": "s0172",
    "blockIndex": 40,
    "zh": "好文學，從容沉雅。"
  },
  {
    "id": "s0172",
    "blockIndex": 40,
    "zh": "時人以為有孝文風烈，大將軍澄深忌之。"
  },
  {
    "id": "s0175",
    "blockIndex": 41,
    "zh": "始，獻武王自病逐君之丑，事靜帝禮甚恭，事無大小必以聞，可否聽旨。"
  },
  {
    "id": "s0175",
    "blockIndex": 41,
    "zh": "每侍宴，俯伏上壽；"
  },
  {
    "id": "s0175",
    "blockIndex": 41,
    "zh": "帝設法會，乘輦行香，歡執香爐步從，鞠躬屏氣，承望顏色，故其下奉帝莫敢不恭。"
  },
  {
    "id": "s0178",
    "blockIndex": 42,
    "zh": "及澄當國，倨慢頓甚，使中書黃門郎崔季舒察帝動靜，小大皆令季舒知之。"
  },
  {
    "id": "s0178",
    "blockIndex": 42,
    "zh": "澄與季舒書曰：「癡人比復何似？"
  },
  {
    "id": "s0178",
    "blockIndex": 42,
    "zh": "癡勢小差未？"
  },
  {
    "id": "s0178",
    "blockIndex": 42,
    "zh": "宜用心檢校。"
  },
  {
    "id": "s0178",
    "blockIndex": 42,
    "zh": "」帝嘗獵於鄴東，馳逐如飛，監衛都督烏那羅受工伐從後呼曰：「天子勿走馬，大將軍嗔！"
  },
  {
    "id": "s0178",
    "blockIndex": 42,
    "zh": "」澄嘗侍飲酒，舉大觴屬帝曰：「臣澄勸陛下酒。"
  },
  {
    "id": "s0178",
    "blockIndex": 42,
    "zh": "」帝不勝忿，曰：「自古無不亡之國，朕亦何用此生為！"
  },
  {
    "id": "s0178",
    "blockIndex": 42,
    "zh": "」澄怒曰：「朕，朕，狗腳朕！"
  },
  {
    "id": "s0178",
    "blockIndex": 42,
    "zh": "」使崔季舒毆帝三拳，奮衣而出。"
  },
  {
    "id": "s0178",
    "blockIndex": 42,
    "zh": "明日，澄使季舒入勞帝。"
  },
  {
    "id": "s0178",
    "blockIndex": 42,
    "zh": "帝亦謝焉，賜季舒絹百匹。"
  },
  {
    "id": "s0189",
    "blockIndex": 43,
    "zh": "帝不堪憂辱，詠謝靈運詩曰：「韓亡子房奮，秦帝魯連恥。"
  },
  {
    "id": "s0189",
    "blockIndex": 43,
    "zh": "本自江海人，忠義動君子。"
  },
  {
    "id": "s0189",
    "blockIndex": 43,
    "zh": "」常侍、侍講穎川荀濟知帝意，乃與祠部郎中元瑾、長秋卿劉思逸、華山王大器、淮南王宣洪、濟北王徽等謀誅澄。"
  },
  {
    "id": "s0189",
    "blockIndex": 43,
    "zh": "大器，鷙之子也。"
  },
  {
    "id": "s0189",
    "blockIndex": 43,
    "zh": "帝謬為敕問濟曰：「欲以何日開講？"
  },
  {
    "id": "s0189",
    "blockIndex": 43,
    "zh": "」乃詐於宮中作土山，開地道向北城。"
  },
  {
    "id": "s0189",
    "blockIndex": 43,
    "zh": "至千秋門，門者覺地下響，以告澄。"
  },
  {
    "id": "s0189",
    "blockIndex": 43,
    "zh": "澄勒兵入宮，見帝，不拜而坐，曰：「陛下何意反？"
  },
  {
    "id": "s0189",
    "blockIndex": 43,
    "zh": "臣父子功存社稷，何負陛下邪！"
  },
  {
    "id": "s0189",
    "blockIndex": 43,
    "zh": "此必左右妃嬪輩所為。"
  },
  {
    "id": "s0189",
    "blockIndex": 43,
    "zh": "」欲殺胡夫人及李嬪。"
  },
  {
    "id": "s0189",
    "blockIndex": 43,
    "zh": "帝正色曰：「自古唯聞臣反君，不聞君反臣。"
  },
  {
    "id": "s0189",
    "blockIndex": 43,
    "zh": "王自欲反，何乃責我！"
  },
  {
    "id": "s0189",
    "blockIndex": 43,
    "zh": "我殺王則社稷安，不殺則滅亡無日，我身且不暇惜，況於妃嬪！"
  },
  {
    "id": "s0189",
    "blockIndex": 43,
    "zh": "必欲弒逆，緩速在王！"
  },
  {
    "id": "s0189",
    "blockIndex": 43,
    "zh": "」澄乃下床叩頭，大啼謝罪。"
  },
  {
    "id": "s0189",
    "blockIndex": 43,
    "zh": "於是酣飲，夜久乃出。"
  },
  {
    "id": "s0189",
    "blockIndex": 43,
    "zh": "居三日，幽帝於含章堂。"
  },
  {
    "id": "s0189",
    "blockIndex": 43,
    "zh": "壬辰，烹濟等於市。"
  },
  {
    "id": "s0208",
    "blockIndex": 44,
    "zh": "初，濟少居江東，博學能文。"
  },
  {
    "id": "s0208",
    "blockIndex": 44,
    "zh": "與上有布衣之舊，知上有大志，然負氣不服，常謂人曰：「會於盾鼻上磨墨檄之。"
  },
  {
    "id": "s0208",
    "blockIndex": 44,
    "zh": "」上甚不平。"
  },
  {
    "id": "s0208",
    "blockIndex": 44,
    "zh": "及即位，或薦之於上，上曰：「人雖有才，亂俗好反，不可用也。"
  },
  {
    "id": "s0208",
    "blockIndex": 44,
    "zh": "」濟上書諫上崇信佛法、為塔寺奢費，上大怒，欲集朝眾斬之；"
  },
  {
    "id": "s0208",
    "blockIndex": 44,
    "zh": "朱異密告之，濟逃奔東魏。"
  },
  {
    "id": "s0208",
    "blockIndex": 44,
    "zh": "澄為中書監，欲用濟為侍讀，獻武王曰：「我愛濟，欲全之，故不用濟。"
  },
  {
    "id": "s0208",
    "blockIndex": 44,
    "zh": "濟入宮，必敗。"
  },
  {
    "id": "s0208",
    "blockIndex": 44,
    "zh": "」澄固請，乃許之。"
  },
  {
    "id": "s0208",
    "blockIndex": 44,
    "zh": "及敗，侍中楊遵彥謂之曰：「衰暮何苦復爾？"
  },
  {
    "id": "s0208",
    "blockIndex": 44,
    "zh": "」濟曰：「壯氣在耳！"
  },
  {
    "id": "s0208",
    "blockIndex": 44,
    "zh": "」因下辨曰：「自傷年紀摧頹，功名不立，故欲挾天子，誅權臣。"
  },
  {
    "id": "s0208",
    "blockIndex": 44,
    "zh": "」澄欲宥其死，親問之曰：「荀公何意反？"
  },
  {
    "id": "s0208",
    "blockIndex": 44,
    "zh": "」濟曰：「奉詔誅高澄，何謂反！"
  },
  {
    "id": "s0208",
    "blockIndex": 44,
    "zh": "」有司以濟老病，鹿車載詣東市，並焚之。"
  },
  {
    "id": "s0223",
    "blockIndex": 45,
    "zh": "澄疑咨議溫子升知瑾等謀，方使之作獻武王碑，既成，餓於晉陽獄，食弊襦而死。"
  },
  {
    "id": "s0223",
    "blockIndex": 45,
    "zh": "棄屍路隅，沒其家口，太尉長史宋游道收葬之。"
  },
  {
    "id": "s0223",
    "blockIndex": 45,
    "zh": "澄謂游道曰：「吾近書與京師諸貴，論及朝士，以卿僻於朋黨，將為一病。"
  },
  {
    "id": "s0223",
    "blockIndex": 45,
    "zh": "今乃知卿真是重故舊、尚節義之人，天下人代卿怖者，是不知吾心也。"
  },
  {
    "id": "s0223",
    "blockIndex": 45,
    "zh": "」九月，辛丑，澄還晉陽。"
  },
  {
    "id": "s0228",
    "blockIndex": 46,
    "zh": "上命蕭淵明堰泗水於寒山以灌彭城，俟得彭城，乃進軍與侯景掎角。"
  },
  {
    "id": "s0228",
    "blockIndex": 46,
    "zh": "癸卯，淵明軍於寒山，去彭城十八里，斷流立堰。"
  },
  {
    "id": "s0228",
    "blockIndex": 46,
    "zh": "侍中羊侃監作堰，再旬而成。"
  },
  {
    "id": "s0228",
    "blockIndex": 46,
    "zh": "東魏徐州刺史太原王則嬰城固守，侃勸淵明乘水攻彭城，不從。"
  },
  {
    "id": "s0228",
    "blockIndex": 46,
    "zh": "諸將與淵明議軍事，淵明不能對，但云「臨時制宜」。"
  },
  {
    "id": "s0233",
    "blockIndex": 47,
    "zh": "冬，十一月，魏丞相泰從魏主狩於歧陽。"
  },
  {
    "id": "s0234",
    "blockIndex": 48,
    "zh": "東魏大將軍澄使大都督高岳救彭城，欲以金門郡公潘樂為副。"
  },
  {
    "id": "s0234",
    "blockIndex": 48,
    "zh": "陳元康曰：「樂緩於機變，不如慕容紹宗；"
  },
  {
    "id": "s0234",
    "blockIndex": 48,
    "zh": "且先王之命也。"
  },
  {
    "id": "s0234",
    "blockIndex": 48,
    "zh": "公但推赤心於斯人，景不足憂也。"
  },
  {
    "id": "s0234",
    "blockIndex": 48,
    "zh": "」時紹宗在外，澄欲召見之，恐其驚叛；"
  },
  {
    "id": "s0234",
    "blockIndex": 48,
    "zh": "元康曰：「紹宗知元康特蒙顧待，新使人來餉金；"
  },
  {
    "id": "s0234",
    "blockIndex": 48,
    "zh": "元康欲安其意，受之而厚答其書，保無異也。"
  },
  {
    "id": "s0234",
    "blockIndex": 48,
    "zh": "」乙酉，以紹宗為東南道行台，與岳、樂偕行。"
  },
  {
    "id": "s0234",
    "blockIndex": 48,
    "zh": "初，景聞韓軌來，曰：「啖豬腸兒何能為！"
  },
  {
    "id": "s0234",
    "blockIndex": 48,
    "zh": "」聞高岳來，曰：「兵精人凡。"
  },
  {
    "id": "s0234",
    "blockIndex": 48,
    "zh": "」諸將無不為所輕者。"
  },
  {
    "id": "s0234",
    "blockIndex": 48,
    "zh": "及聞紹宗來，叩鞍有懼色，曰：「誰教鮮卑兒解遣紹宗來！"
  },
  {
    "id": "s0234",
    "blockIndex": 48,
    "zh": "若然，高王定未死邪？"
  },
  {
    "id": "s0248",
    "blockIndex": 49,
    "zh": "澄以廷尉卿杜弼為軍司，攝行台左丞，臨發，問以政事之要、可為戒者，使錄一二條。"
  },
  {
    "id": "s0248",
    "blockIndex": 49,
    "zh": "弼請口陳之，曰：「天下大務，莫過賞罰。"
  },
  {
    "id": "s0248",
    "blockIndex": 49,
    "zh": "賞一人使天下之人喜，罰一人使天下之人懼，苟二事不失，自然盡美。"
  },
  {
    "id": "s0248",
    "blockIndex": 49,
    "zh": "」澄大悅，曰：「言雖不多，於理甚要。"
  },
  {
    "id": "s0253",
    "blockIndex": 50,
    "zh": "紹宗帥眾十萬據橐駝峴。"
  },
  {
    "id": "s0253",
    "blockIndex": 50,
    "zh": "羊侃勸貞陽侯淵明乘其遠來擊之，不從，旦日，又勸出戰，亦不從；"
  },
  {
    "id": "s0253",
    "blockIndex": 50,
    "zh": "侃乃帥所領出屯堰上。"
  },
  {
    "id": "s0256",
    "blockIndex": 51,
    "zh": "丙午，紹宗至城下，引步騎萬人攻潼州刺史郭鳳營，矢下如雨。"
  },
  {
    "id": "s0256",
    "blockIndex": 51,
    "zh": "淵明醉，不能起，命諸將救之，皆不敢出。"
  },
  {
    "id": "s0256",
    "blockIndex": 51,
    "zh": "北兗州刺史胡貴孫謂譙州刺史趙伯超曰：「吾屬將兵而來，本欲何為，今遇敵而不戰乎？"
  },
  {
    "id": "s0256",
    "blockIndex": 51,
    "zh": "」伯超不能對。"
  },
  {
    "id": "s0256",
    "blockIndex": 51,
    "zh": "貴孫獨帥麾下與東魏戰，斬首二百級。"
  },
  {
    "id": "s0256",
    "blockIndex": 51,
    "zh": "伯超擁眾數千不敢救，謂其下曰：「虜盛如此，與戰必敗，不如全軍早歸，可以免罪。"
  },
  {
    "id": "s0256",
    "blockIndex": 51,
    "zh": "」皆曰：「善！"
  },
  {
    "id": "s0256",
    "blockIndex": 51,
    "zh": "」遂遁還。"
  },
  {
    "id": "s0264",
    "blockIndex": 52,
    "zh": "初，侯景常戒梁人曰：「逐北勿過二里。"
  },
  {
    "id": "s0264",
    "blockIndex": 52,
    "zh": "」紹宗將戰，以梁人輕悍，恐其眾不能支，一一引將卒謂之曰：「我當陽退，誤吳兒使前，爾擊其背。"
  },
  {
    "id": "s0264",
    "blockIndex": 52,
    "zh": "」東魏兵實敗走，梁人不用景言，乘勝深入。"
  },
  {
    "id": "s0264",
    "blockIndex": 52,
    "zh": "魏將卒以紹宗之言為信，爭共掩擊之，梁兵大敗，貞陽侯淵明及胡貴孫、趙伯超等皆為東魏所虜，失亡士卒數萬人。"
  },
  {
    "id": "s0264",
    "blockIndex": 52,
    "zh": "羊侃結陳徐還。"
  },
  {
    "id": "s0269",
    "blockIndex": 53,
    "zh": "上方晝寢，宦者張僧胤白朱異啟事，上駭之，遽起升輿，至文德殿閣。"
  },
  {
    "id": "s0269",
    "blockIndex": 53,
    "zh": "異曰：「寒山失律。"
  },
  {
    "id": "s0269",
    "blockIndex": 53,
    "zh": "」上聞之，恍然將墜床。"
  },
  {
    "id": "s0269",
    "blockIndex": 53,
    "zh": "僧胤扶而就坐，乃歎曰：「吾得無復為晉家乎！"
  },
  {
    "id": "s0274",
    "blockIndex": 54,
    "zh": "郭鳳退保潼州，慕容紹宗進圍之。"
  },
  {
    "id": "s0274",
    "blockIndex": 54,
    "zh": "十二月，甲子朔，鳳棄城走。"
  },
  {
    "id": "s0276",
    "blockIndex": 55,
    "zh": "東魏使軍司杜弼作檄移梁朝曰：「皇家垂統，光配彼天，唯彼吳、越，獨阻聲教。"
  },
  {
    "id": "s0276",
    "blockIndex": 55,
    "zh": "元首懷止戈之心，上宰薄兵車之命，遂解縶南冠，喻以好睦。"
  },
  {
    "id": "s0276",
    "blockIndex": 55,
    "zh": "雖嘉謀長算，爰自我始，罷戰息民，彼獲其利。"
  },
  {
    "id": "s0276",
    "blockIndex": 55,
    "zh": "侯景豎子，自生猜貳，遠托關、隴，依憑奸偽，逆主定君臣之分，偽相結兄弟之親，豈曰無恩，終成難養，俄而易慮，親尋干戈。"
  },
  {
    "id": "s0276",
    "blockIndex": 55,
    "zh": "釁暴惡盈，側首無托，以金陵逋逃之藪，江南流寓之地，甘辭卑禮，進孰圖身，詭言浮說，抑可知矣。"
  },
  {
    "id": "s0276",
    "blockIndex": 55,
    "zh": "而偽朝大小，幸災忘義，主荒於上，臣蔽於下，連結奸惡，斷絕鄰好，徵兵保境，縱盜侵國。"
  },
  {
    "id": "s0276",
    "blockIndex": 55,
    "zh": "蓋物無定方，事無定勢，或乘利而受害，或因得而更失。"
  },
  {
    "id": "s0276",
    "blockIndex": 55,
    "zh": "是以吳侵齊境，遂得句踐之師，趙納韓地，終有長平之役。"
  },
  {
    "id": "s0276",
    "blockIndex": 55,
    "zh": "矧乃鞭撻疲民，侵軼徐部，築壘擁川，捨舟徼利。"
  },
  {
    "id": "s0276",
    "blockIndex": 55,
    "zh": "是以援枹秉麾之將，拔距投石之士，含怒作色，如赴私仇。"
  },
  {
    "id": "s0276",
    "blockIndex": 55,
    "zh": "彼連營擁眾，依山傍水，舉螳□良之斧，被蛣蜣之甲，當窮轍以待輪，坐積薪而候燎。"
  },
  {
    "id": "s0276",
    "blockIndex": 55,
    "zh": "及鋒刃暫交，埃塵且接，已亡戟棄戈，土崩瓦解，掬指舟中，衿甲鼓下，同宗異姓，縲紲相望。"
  },
  {
    "id": "s0276",
    "blockIndex": 55,
    "zh": "曲直既殊，強弱不等，獲一人而失一國，見黃雀而忘深阱，智者所不為，仁者所不向。"
  },
  {
    "id": "s0276",
    "blockIndex": 55,
    "zh": "誠既往之難逮，猶將來之可追。"
  },
  {
    "id": "s0276",
    "blockIndex": 55,
    "zh": "侯景以鄙俚之夫，遭風雲之會，位班三事，邑啟萬家，揣身量分，久當止足。"
  },
  {
    "id": "s0276",
    "blockIndex": 55,
    "zh": "而周章向背，離披不已，夫豈徒然，意亦可見。"
  },
  {
    "id": "s0276",
    "blockIndex": 55,
    "zh": "彼乃授之以利器，誨之以慢藏，使其勢得容奸，時堪乘便。"
  },
  {
    "id": "s0276",
    "blockIndex": 55,
    "zh": "今見南風不競，天亡有征，老賊奸謀，將復作矣。"
  },
  {
    "id": "s0276",
    "blockIndex": 55,
    "zh": "然推堅強者難為功，摧枯朽者易為力。"
  },
  {
    "id": "s0276",
    "blockIndex": 55,
    "zh": "計其雖非孫、吳猛將，燕、趙精兵，猶是久涉行陳，曾習軍旅，豈同剽輕之師，不比危脆之眾。"
  },
  {
    "id": "s0276",
    "blockIndex": 55,
    "zh": "拒此則作氣不足，攻彼則為勢有餘，終恐尾大於身，踵粗於股，倔強不掉，狼戾難馴。"
  },
  {
    "id": "s0276",
    "blockIndex": 55,
    "zh": "呼之則反速而釁小，不征則叛遲而禍大。"
  },
  {
    "id": "s0276",
    "blockIndex": 55,
    "zh": "會應遙望廷尉，不肯為臣，自據淮南，亦欲稱帝。"
  },
  {
    "id": "s0276",
    "blockIndex": 55,
    "zh": "但恐楚國亡猿，禍延林木，城門失火，殃及池魚。"
  },
  {
    "id": "s0276",
    "blockIndex": 55,
    "zh": "橫使江、淮士子，荊、揚人物，死亡矢石之下，夭折霧露之中。"
  },
  {
    "id": "s0276",
    "blockIndex": 55,
    "zh": "彼梁主，操行無聞，輕險有素，射雀論功，盪舟稱力，年既老矣，耄又及之，政散民流，禮崩樂壞。"
  },
  {
    "id": "s0276",
    "blockIndex": 55,
    "zh": "加以用捨乖方，廢立失所，矯情動俗，飾智驚愚，毒螫滿懷，妄敦戒業，躁競盈胸，謬治清淨。"
  },
  {
    "id": "s0276",
    "blockIndex": 55,
    "zh": "災異降於上，怨讟興於下，人人厭苦，家家思亂，履霜有漸，堅冰且至。"
  },
  {
    "id": "s0276",
    "blockIndex": 55,
    "zh": "傳險躁之風俗，任輕薄之子孫。"
  },
  {
    "id": "s0276",
    "blockIndex": 55,
    "zh": "朋黨路開，兵權在外。"
  },
  {
    "id": "s0276",
    "blockIndex": 55,
    "zh": "必將禍生骨肉，釁起腹心，強弩沖城，長戈指闕；"
  },
  {
    "id": "s0276",
    "blockIndex": 55,
    "zh": "徒探雀鷇，無救府藏之虛，空請熊蹯，詎延晷刻之命。"
  },
  {
    "id": "s0276",
    "blockIndex": 55,
    "zh": "外崩中潰，今實其時。"
  },
  {
    "id": "s0276",
    "blockIndex": 55,
    "zh": "鷸蚌相持，我乘其弊。"
  },
  {
    "id": "s0276",
    "blockIndex": 55,
    "zh": "方使駿騎追風，精甲輝日，四七並列，百萬為群，以轉石之形，為破竹之勢。"
  },
  {
    "id": "s0276",
    "blockIndex": 55,
    "zh": "當使鐘山渡江，青蓋入洛，荊棘生於建業之宮，糜鹿游於姑蘇之館。"
  },
  {
    "id": "s0276",
    "blockIndex": 55,
    "zh": "但恐革車之所□藺轢，劍騎之所蹂踐，杞梓於焉傾折，竹箭以此摧殘。"
  },
  {
    "id": "s0276",
    "blockIndex": 55,
    "zh": "若吳之王孫，蜀之公子，歸款軍門，委命下吏，當即授客卿之秩，特加驃騎之號。"
  },
  {
    "id": "s0276",
    "blockIndex": 55,
    "zh": "凡百君子，勉求多福。"
  },
  {
    "id": "s0276",
    "blockIndex": 55,
    "zh": "」其後梁室禍敗，皆如弼言。"
  },
  {
    "id": "s0316",
    "blockIndex": 56,
    "zh": "侯景圍譙城，不下。"
  },
  {
    "id": "s0316",
    "blockIndex": 56,
    "zh": "退攻城父，拔之。"
  },
  {
    "id": "s0316",
    "blockIndex": 56,
    "zh": "壬申，遣其行台左丞王偉等詣建康說上曰：「鄴中文武合謀，召臣共討高澄。"
  },
  {
    "id": "s0316",
    "blockIndex": 56,
    "zh": "事洩，澄幽元善見於金墉，殺諸元六十餘人。"
  },
  {
    "id": "s0316",
    "blockIndex": 56,
    "zh": "河北物情，俱念其主，請立元氏一人以從人望，如此，則陛下有繼絕之名，臣景有立功之效。"
  },
  {
    "id": "s0316",
    "blockIndex": 56,
    "zh": "河之南北，為聖朝之邾、莒；"
  },
  {
    "id": "s0316",
    "blockIndex": 56,
    "zh": "國之男女，為大梁之臣妾。"
  },
  {
    "id": "s0316",
    "blockIndex": 56,
    "zh": "」上以為然，乙亥，下詔以太子舍人元貞為咸陽王，資以兵力，使還北主魏，須渡江，許即位，儀衛以乘輿之副給之。"
  },
  {
    "id": "s0316",
    "blockIndex": 56,
    "zh": "貞，樹之子也。"
  },
  {
    "id": "s0325",
    "blockIndex": 57,
    "zh": "蕭淵明至鄴，東魏主升閶闔門受俘，讓而釋之，送於晉陽，大將軍澄待之甚厚。"
  },
  {
    "id": "s0326",
    "blockIndex": 58,
    "zh": "慕容紹宗引軍擊侯景，景輜重數千兩，馬數千匹，士卒四萬人，退保渦陽。"
  },
  {
    "id": "s0326",
    "blockIndex": 58,
    "zh": "紹宗士卒十萬，旗甲耀日，鳴鼓長驅而進。"
  },
  {
    "id": "s0326",
    "blockIndex": 58,
    "zh": "景使謂之曰：「公等為欲送客，為欲定雌雄邪？"
  },
  {
    "id": "s0326",
    "blockIndex": 58,
    "zh": "」紹宗曰：「欲與公決勝負。"
  },
  {
    "id": "s0326",
    "blockIndex": 58,
    "zh": "」遂順風布陳。"
  },
  {
    "id": "s0326",
    "blockIndex": 58,
    "zh": "景閉壘，俟風止乃出。"
  },
  {
    "id": "s0326",
    "blockIndex": 58,
    "zh": "紹宗曰：「侯景多詭計，好乘人背。"
  },
  {
    "id": "s0326",
    "blockIndex": 58,
    "zh": "」使備之，果如其言。"
  },
  {
    "id": "s0326",
    "blockIndex": 58,
    "zh": "景命戰士皆被短甲，執短刀，入東魏陳，但低視，斫人脛馬足。"
  },
  {
    "id": "s0326",
    "blockIndex": 58,
    "zh": "東魏兵遂敗，紹宗墜馬，儀同三司劉豐生被傷，顯州刺史張遵業為景所擒。"
  },
  {
    "id": "s0336",
    "blockIndex": 59,
    "zh": "紹宗、豐生俱奔譙城，裨將斛律光、張恃顯尤之，紹宗曰：「吾戰多矣，未見如景之難克者也。"
  },
  {
    "id": "s0336",
    "blockIndex": 59,
    "zh": "君輩試犯之！"
  },
  {
    "id": "s0336",
    "blockIndex": 59,
    "zh": "」光等被甲將出，紹宗戒之曰：「勿渡渦水。"
  },
  {
    "id": "s0336",
    "blockIndex": 59,
    "zh": "」二人軍於水北，光輕騎射之。"
  },
  {
    "id": "s0336",
    "blockIndex": 59,
    "zh": "景臨渦水謂光曰：「爾求勳而來，我懼死而去。"
  },
  {
    "id": "s0336",
    "blockIndex": 59,
    "zh": "我，汝之父友，何為射我？"
  },
  {
    "id": "s0336",
    "blockIndex": 59,
    "zh": "汝豈自解不渡水南？"
  },
  {
    "id": "s0336",
    "blockIndex": 59,
    "zh": "慕容紹宗教汝也！"
  },
  {
    "id": "s0336",
    "blockIndex": 59,
    "zh": "」光無以應。"
  },
  {
    "id": "s0336",
    "blockIndex": 59,
    "zh": "景使其徒田遷射光馬，洞胸；"
  },
  {
    "id": "s0336",
    "blockIndex": 59,
    "zh": "光易馬隱樹，又中之，退入於軍。"
  },
  {
    "id": "s0336",
    "blockIndex": 59,
    "zh": "景擒恃顯，既而捨之。"
  },
  {
    "id": "s0336",
    "blockIndex": 59,
    "zh": "光走入譙城，紹宗曰：「今定何如，而尤我也！"
  },
  {
    "id": "s0336",
    "blockIndex": 59,
    "zh": "」光，金之子也。"
  },
  {
    "id": "s0350",
    "blockIndex": 60,
    "zh": "開府儀同三司段韶夾渦而軍，潛於上風縱火，景帥騎入水，出而卻走，草濕，火不復然。"
  },
  {
    "id": "s0350",
    "blockIndex": 60,
    "zh": "魏岐州久經喪亂，刺史鄭穆初到，有戶三千，穆撫循安集，數年之間，至四萬餘戶，考績為諸州之最；"
  },
  {
    "id": "s0350",
    "blockIndex": 60,
    "zh": "丞相泰擢穆為京兆尹。"
  },
  {
    "id": "s0353",
    "blockIndex": 61,
    "zh": "侯景與東魏慕容紹宗相持數月，景食盡，司馬世雲降於紹宗。"
  },
  {
    "id": "s0354",
    "blockIndex": 62,
    "zh": "category:資治通鑑"
  }
]
