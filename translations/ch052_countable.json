[
  {
    "id": "s0001",
    "blockIndex": 0,
    "zh": "資治通鑑 第052卷"
  },
  {
    "id": "s0002",
    "blockIndex": 1,
    "zh": "【漢紀四十四】　起閼逢閹茂，盡旃蒙作噩，凡十二年。"
  },
  {
    "id": "s0003",
    "blockIndex": 2,
    "zh": "夏，四月，車師後部司馬率後王加特奴等，掩擊北匈奴於閶吾陸谷，大破之；"
  },
  {
    "id": "s0003",
    "blockIndex": 2,
    "zh": "獲單于母。"
  },
  {
    "id": "s0005",
    "blockIndex": 3,
    "zh": "五月，戊戌，詔以春夏連旱，赦天下。"
  },
  {
    "id": "s0005",
    "blockIndex": 3,
    "zh": "上親自露坐德陽殿東廂請雨。"
  },
  {
    "id": "s0005",
    "blockIndex": 3,
    "zh": "以尚書周舉才學優深，特加策問。"
  },
  {
    "id": "s0005",
    "blockIndex": 3,
    "zh": "舉對曰：「臣聞陰陽閉隔，則二氣否塞。"
  },
  {
    "id": "s0005",
    "blockIndex": 3,
    "zh": "陛下廢文帝、光武之法，而循亡秦奢移之欲，內積怨女，外有曠夫。"
  },
  {
    "id": "s0005",
    "blockIndex": 3,
    "zh": "自枯旱以來，彌歷年歲，未聞陛下改過之效，徒勞至尊暴露風塵，誠無益也。"
  },
  {
    "id": "s0005",
    "blockIndex": 3,
    "zh": "陛下但務其華，不尋其實，猶緣木希魚，卻行求前。"
  },
  {
    "id": "s0005",
    "blockIndex": 3,
    "zh": "誠宜推信革政，崇道變惑，出後宮不御之女，除太官重膳之費。"
  },
  {
    "id": "s0005",
    "blockIndex": 3,
    "zh": "《易‧傳》曰：『陽惑天不旋日。"
  },
  {
    "id": "s0005",
    "blockIndex": 3,
    "zh": "』惟陛下留神裁察！"
  },
  {
    "id": "s0005",
    "blockIndex": 3,
    "zh": "」帝復召舉面問得失，舉對以「宜慎官人，去貪污，遠佞邪。"
  },
  {
    "id": "s0005",
    "blockIndex": 3,
    "zh": "」帝曰：「官貪污、佞邪者為誰乎？"
  },
  {
    "id": "s0005",
    "blockIndex": 3,
    "zh": "」對曰：「臣從下州超備機密，不足以別群臣。"
  },
  {
    "id": "s0005",
    "blockIndex": 3,
    "zh": "然公卿大臣數有直言者，忠貞也；"
  },
  {
    "id": "s0005",
    "blockIndex": 3,
    "zh": "阿諛苟容者，佞邪也。"
  },
  {
    "id": "s0021",
    "blockIndex": 4,
    "zh": "太史令張衡亦上疏言：「前年京師地震土裂。"
  },
  {
    "id": "s0021",
    "blockIndex": 4,
    "zh": "裂者，威分；"
  },
  {
    "id": "s0021",
    "blockIndex": 4,
    "zh": "震者，民擾也。"
  },
  {
    "id": "s0021",
    "blockIndex": 4,
    "zh": "竊懼聖思厭倦，制不專己，恩不忍割，與眾共威。"
  },
  {
    "id": "s0021",
    "blockIndex": 4,
    "zh": "威不可分，德不可共。"
  },
  {
    "id": "s0021",
    "blockIndex": 4,
    "zh": "願陛下思惟所以稽古率舊，勿使刑德八柄不由天子，然後神望允塞，災消不至矣。"
  },
  {
    "id": "s0021",
    "blockIndex": 4,
    "zh": "」衡又以中興之後，儒者爭學《圖緯》，上疏言：「《春秋元命包》有公輸班與墨翟，事見戰國；"
  },
  {
    "id": "s0021",
    "blockIndex": 4,
    "zh": "又言別有益州，益州之置在於漢世。"
  },
  {
    "id": "s0021",
    "blockIndex": 4,
    "zh": "又劉向父子領校秘書，閱定九流，亦無《讖錄》。"
  },
  {
    "id": "s0021",
    "blockIndex": 4,
    "zh": "則知《圖讖》成於哀、平之際，皆虛偽之徒以要世取資，欺罔較然，莫之糾禁。"
  },
  {
    "id": "s0021",
    "blockIndex": 4,
    "zh": "且律歷、卦候、九宮、風角，數有征效，世莫肯學，而競稱不佔之書，譬猶畫工惡圖犬馬而好作鬼魅，誠以實事難形而虛偽不窮也！"
  },
  {
    "id": "s0021",
    "blockIndex": 4,
    "zh": "宜收藏《圖讖》，一禁絕之，則朱紫無所眩，典籍無瑕玷矣！"
  },
  {
    "id": "s0034",
    "blockIndex": 5,
    "zh": "秋，七月，鐘羌良封等復寇隴西、漢陽。"
  },
  {
    "id": "s0034",
    "blockIndex": 5,
    "zh": "詔拜前校尉馬賢為謁者，鎮撫諸種。"
  },
  {
    "id": "s0034",
    "blockIndex": 5,
    "zh": "冬，十月，護羌校尉馬續遣兵擊良封，破之。"
  },
  {
    "id": "s0037",
    "blockIndex": 6,
    "zh": "十一月，壬寅，司徒劉崎、司空孔扶免，用國舉之言也。"
  },
  {
    "id": "s0037",
    "blockIndex": 6,
    "zh": "乙己，以大司農黃尚為司徒，光祿勳河東王卓為司空。"
  },
  {
    "id": "s0039",
    "blockIndex": 7,
    "zh": "耿貴人數為耿氏請，帝乃紹封耿寶子箕為牟平侯。"
  },
  {
    "id": "s0040",
    "blockIndex": 8,
    "zh": "春，北匈奴呼衍王侵車師後部。"
  },
  {
    "id": "s0040",
    "blockIndex": 8,
    "zh": "帝令敦煌太守發兵救之，不利。"
  },
  {
    "id": "s0042",
    "blockIndex": 9,
    "zh": "二月，丙子，初聽中官得以養子襲爵。"
  },
  {
    "id": "s0042",
    "blockIndex": 9,
    "zh": "初，帝之復位，宦官之力也，由是有寵，參與政事。"
  },
  {
    "id": "s0042",
    "blockIndex": 9,
    "zh": "御史張綱上書曰：「竊尋文、明二帝，德化尤盛，中官常侍，不過兩人，近幸賞賜，裁滿數金，惜費重民，故家給人足。"
  },
  {
    "id": "s0042",
    "blockIndex": 9,
    "zh": "而頃者以來，無功小人，皆有官爵，非愛民重器、承天順道者也。"
  },
  {
    "id": "s0042",
    "blockIndex": 9,
    "zh": "」書奏，不省。"
  },
  {
    "id": "s0042",
    "blockIndex": 9,
    "zh": "綱，皓之子也。"
  },
  {
    "id": "s0048",
    "blockIndex": 10,
    "zh": "旱。"
  },
  {
    "id": "s0049",
    "blockIndex": 11,
    "zh": "謁者馬賢擊鐘羌，大破之。"
  },
  {
    "id": "s0050",
    "blockIndex": 12,
    "zh": "夏，四月，甲子，太尉施延免。"
  },
  {
    "id": "s0050",
    "blockIndex": 12,
    "zh": "戊寅，以執金吾梁商為大將軍，故太尉寵參為太尉。"
  },
  {
    "id": "s0050",
    "blockIndex": 12,
    "zh": "商稱疾不起且一年，帝使太常桓焉奉策就第即拜，商乃詣闕受命。"
  },
  {
    "id": "s0050",
    "blockIndex": 12,
    "zh": "商少通經傳，謙恭好士，辟漢陽巨覽、上黨陳龜為掾屬，李固為從事中郎，楊倫為長史。"
  },
  {
    "id": "s0050",
    "blockIndex": 12,
    "zh": "李固以商柔和自守，不能有所整裁，乃奏記於商曰：「數年以來，災怪屢見。"
  },
  {
    "id": "s0050",
    "blockIndex": 12,
    "zh": "孔子曰：『智者見變思形，愚者睹怪諱名。"
  },
  {
    "id": "s0050",
    "blockIndex": 12,
    "zh": "』天道無親，可為祗畏。"
  },
  {
    "id": "s0050",
    "blockIndex": 12,
    "zh": "誠令王綱一整，道行忠立，明公踵伯成之高，全不朽之譽，豈與此外戚凡輩耽榮好位者同日而論哉！"
  },
  {
    "id": "s0050",
    "blockIndex": 12,
    "zh": "」商不能用。"
  },
  {
    "id": "s0059",
    "blockIndex": 13,
    "zh": "秋，閏八月，丁亥朔，日有食之。"
  },
  {
    "id": "s0060",
    "blockIndex": 14,
    "zh": "冬，十月，烏桓寇雲中，度遼將軍耿曄追擊，不利。"
  },
  {
    "id": "s0060",
    "blockIndex": 14,
    "zh": "十一月，烏桓圍曄於蘭池城；"
  },
  {
    "id": "s0060",
    "blockIndex": 14,
    "zh": "發兵數千人救之，烏桓乃退。"
  },
  {
    "id": "s0063",
    "blockIndex": 15,
    "zh": "十二月，甲寅，京師地震。"
  },
  {
    "id": "s0064",
    "blockIndex": 16,
    "zh": "春，正月，己巳，改元，赦天下。"
  },
  {
    "id": "s0065",
    "blockIndex": 17,
    "zh": "冬，十月，丁亥，承福殿火。"
  },
  {
    "id": "s0066",
    "blockIndex": 18,
    "zh": "十一月，丙子，太尉寵參罷。"
  },
  {
    "id": "s0067",
    "blockIndex": 19,
    "zh": "十二月，像林蠻夷反。"
  },
  {
    "id": "s0068",
    "blockIndex": 20,
    "zh": "乙巳，以前司空王龔為太尉。"
  },
  {
    "id": "s0069",
    "blockIndex": 21,
    "zh": "龔疾宦官專權，上書極言其狀。"
  },
  {
    "id": "s0069",
    "blockIndex": 21,
    "zh": "諸黃門使客誣奏龔罪；"
  },
  {
    "id": "s0069",
    "blockIndex": 21,
    "zh": "上命龔亟自實。"
  },
  {
    "id": "s0069",
    "blockIndex": 21,
    "zh": "李固奏記於梁商曰：「王公以堅貞之操，橫為讒佞所構，眾人聞知，莫不歎栗。"
  },
  {
    "id": "s0069",
    "blockIndex": 21,
    "zh": "夫三公尊重，無詣理訴冤之義，纖微感概，輒引分決，是以舊典不有大罪，不至重問。"
  },
  {
    "id": "s0069",
    "blockIndex": 21,
    "zh": "王公卒有它變，則朝廷獲害賢之名，群臣無救護之節矣！"
  },
  {
    "id": "s0069",
    "blockIndex": 21,
    "zh": "語曰：『善人在患，饑不及餐。"
  },
  {
    "id": "s0069",
    "blockIndex": 21,
    "zh": "』斯其時也！"
  },
  {
    "id": "s0069",
    "blockIndex": 21,
    "zh": "」商即言之於帝，事乃得釋。"
  },
  {
    "id": "s0078",
    "blockIndex": 22,
    "zh": "是歲，以執金吾梁冀為河南尹。"
  },
  {
    "id": "s0078",
    "blockIndex": 22,
    "zh": "冀性嗜酒，逸游自恣，居職多縱暴非法。"
  },
  {
    "id": "s0078",
    "blockIndex": 22,
    "zh": "父商所親客雒陽令呂放以告商，商以讓冀。"
  },
  {
    "id": "s0078",
    "blockIndex": 22,
    "zh": "冀遣人於道刺殺放，而恐商知之，乃推疑放之怨仇，請以放弟禹為雒陽令，使捕之；"
  },
  {
    "id": "s0078",
    "blockIndex": 22,
    "zh": "盡滅其宗、親、賓客百餘人。"
  },
  {
    "id": "s0083",
    "blockIndex": 23,
    "zh": "武陵太守上書，以蠻夷率服，可比漢人，增其租賦。"
  },
  {
    "id": "s0083",
    "blockIndex": 23,
    "zh": "議者皆以為可。"
  },
  {
    "id": "s0083",
    "blockIndex": 23,
    "zh": "尚書令虞詡曰：「自古聖王，不臣異俗。"
  },
  {
    "id": "s0083",
    "blockIndex": 23,
    "zh": "先帝舊典，貢稅多少，所由來久矣；"
  },
  {
    "id": "s0083",
    "blockIndex": 23,
    "zh": "今猥增之，必有怨叛。"
  },
  {
    "id": "s0083",
    "blockIndex": 23,
    "zh": "計其所得，不償所費，必有後悔。"
  },
  {
    "id": "s0083",
    "blockIndex": 23,
    "zh": "」帝不從。"
  },
  {
    "id": "s0083",
    "blockIndex": 23,
    "zh": "澧中、漊中蠻果爭貢布非舊約，遂殺鄉吏，舉種反。"
  },
  {
    "id": "s0091",
    "blockIndex": 24,
    "zh": "春，武陵蠻二萬人圍充城，八千人寇夷道。"
  },
  {
    "id": "s0092",
    "blockIndex": 25,
    "zh": "二月，廣漢屬國都尉擊破白馬羌。"
  },
  {
    "id": "s0093",
    "blockIndex": 26,
    "zh": "帝遣武陵太守李進擊叛蠻，破平之。"
  },
  {
    "id": "s0093",
    "blockIndex": 26,
    "zh": "進乃簡選良吏，撫循蠻夷，郡境遂安。"
  },
  {
    "id": "s0095",
    "blockIndex": 27,
    "zh": "三月，乙卯，司空王卓薨。"
  },
  {
    "id": "s0095",
    "blockIndex": 27,
    "zh": "丁丑，以光祿勳郭虔為司空。"
  },
  {
    "id": "s0097",
    "blockIndex": 28,
    "zh": "夏，四月，丙申，京師地震。"
  },
  {
    "id": "s0098",
    "blockIndex": 29,
    "zh": "五月，癸丑，山陽君宋娥坐構奸誣罔，收印綬，歸裡捨。"
  },
  {
    "id": "s0098",
    "blockIndex": 29,
    "zh": "黃龍、楊佗、孟叔、李建、張賢、史泛、王道、李元、李剛等九侯坐與宋娥更相賂遺，求高官增邑，並遣就國，減租四分之一。"
  },
  {
    "id": "s0100",
    "blockIndex": 30,
    "zh": "像林蠻區憐等攻縣寺，殺長吏。"
  },
  {
    "id": "s0100",
    "blockIndex": 30,
    "zh": "交趾刺史樊演發交趾、九真兵萬餘人救之；"
  },
  {
    "id": "s0100",
    "blockIndex": 30,
    "zh": "兵士憚遠役，秋，七月，二郡兵反，攻其府。"
  },
  {
    "id": "s0100",
    "blockIndex": 30,
    "zh": "府雖擊破反者，而蠻勢轉盛。"
  },
  {
    "id": "s0104",
    "blockIndex": 31,
    "zh": "冬，十月，甲申，上行幸長安。"
  },
  {
    "id": "s0104",
    "blockIndex": 31,
    "zh": "扶風田弱薦同郡法真博通內外學，隱居不仕，宜就加袞職。"
  },
  {
    "id": "s0104",
    "blockIndex": 31,
    "zh": "帝虛心欲致之，前後四征，終不屈。"
  },
  {
    "id": "s0104",
    "blockIndex": 31,
    "zh": "友人郭正稱之曰：「法真名可得聞，身難得而見。"
  },
  {
    "id": "s0104",
    "blockIndex": 31,
    "zh": "逃名而名我隨，避名而名我追，可謂百世之師者矣！"
  },
  {
    "id": "s0104",
    "blockIndex": 31,
    "zh": "」真，雄之子也。"
  },
  {
    "id": "s0110",
    "blockIndex": 32,
    "zh": "丁卯，京師地震。"
  },
  {
    "id": "s0111",
    "blockIndex": 33,
    "zh": "太尉王龔以中常侍張昉等專弄國權，欲奏誅之。"
  },
  {
    "id": "s0111",
    "blockIndex": 33,
    "zh": "宗親有以楊震行事諫之者，龔乃止。"
  },
  {
    "id": "s0113",
    "blockIndex": 34,
    "zh": "十二月，乙亥，上還自長安。"
  },
  {
    "id": "s0114",
    "blockIndex": 35,
    "zh": "春，二月，乙亥，京師及金城、隴西地震，二郡山崩。"
  },
  {
    "id": "s0115",
    "blockIndex": 36,
    "zh": "夏，閏四月，己酉，京師地震。"
  },
  {
    "id": "s0116",
    "blockIndex": 37,
    "zh": "五月，吳郡丞羊珍反，攻郡府；"
  },
  {
    "id": "s0116",
    "blockIndex": 37,
    "zh": "太守王衡破斬之。"
  },
  {
    "id": "s0118",
    "blockIndex": 38,
    "zh": "侍御史賈昌與州郡並力討區憐等，不克，為所攻圍；"
  },
  {
    "id": "s0118",
    "blockIndex": 38,
    "zh": "歲餘，兵谷不繼。"
  },
  {
    "id": "s0118",
    "blockIndex": 38,
    "zh": "帝召公卿百官及四府掾屬問以方略；"
  },
  {
    "id": "s0118",
    "blockIndex": 38,
    "zh": "皆議遣大將，發荊、揚、兗、豫四萬人赴之。"
  },
  {
    "id": "s0118",
    "blockIndex": 38,
    "zh": "李固駁曰：「若荊、揚無事，發之可也。"
  },
  {
    "id": "s0118",
    "blockIndex": 38,
    "zh": "今二州盜賊磐結不散，武陵、南郡蠻夷未輯，長沙、桂陽數被征發，如復擾動，必更生患，其不可一也。"
  },
  {
    "id": "s0118",
    "blockIndex": 38,
    "zh": "又，兗、豫之人卒被征發，遠赴萬里，無有還期，詔書迫促，必致叛亡，其不可二也。"
  },
  {
    "id": "s0118",
    "blockIndex": 38,
    "zh": "南州水土溫暑，加有瘴氣，致死亡者十必四五，其不可三也。"
  },
  {
    "id": "s0118",
    "blockIndex": 38,
    "zh": "遠涉萬里，士卒疲勞，比至嶺南，不復堪鬥，其不可四也。"
  },
  {
    "id": "s0118",
    "blockIndex": 38,
    "zh": "軍行三十里為程，而去日南九千餘里，三百日乃到，計人稟五升，用米六十萬斛，不計將吏驢馬之食，但負甲自致，費便若此，其不可五也。"
  },
  {
    "id": "s0118",
    "blockIndex": 38,
    "zh": "設軍所在，死亡必眾，既不足禦敵，當復更發，此為刻割心腹以補四支，其不可六也。"
  },
  {
    "id": "s0118",
    "blockIndex": 38,
    "zh": "九真、日南相去千里，發其吏民猶尚不堪，何況乃苦四州之卒以赴萬里之艱哉！"
  },
  {
    "id": "s0118",
    "blockIndex": 38,
    "zh": "其不可七也。"
  },
  {
    "id": "s0118",
    "blockIndex": 38,
    "zh": "前中郎將尹就討益州叛羌，益州諺曰：『虜來尚可，尹來殺我。"
  },
  {
    "id": "s0118",
    "blockIndex": 38,
    "zh": "』後就征還，以兵付刺史張喬；"
  },
  {
    "id": "s0118",
    "blockIndex": 38,
    "zh": "喬因其將吏，旬月之間破殄寇虜。"
  },
  {
    "id": "s0118",
    "blockIndex": 38,
    "zh": "此發將無益之效，州郡可任之驗也。"
  },
  {
    "id": "s0118",
    "blockIndex": 38,
    "zh": "宜更選有勇略仁惠任將帥者，以為刺史、太守，悉使共住交趾。"
  },
  {
    "id": "s0118",
    "blockIndex": 38,
    "zh": "今日南兵單無谷，守既不足，戰又不能，可一切徙其吏民，北依交趾，事靜之後，乃命歸本；"
  },
  {
    "id": "s0118",
    "blockIndex": 38,
    "zh": "還募蠻夷使自相攻，轉輸金帛以為其資；"
  },
  {
    "id": "s0118",
    "blockIndex": 38,
    "zh": "有能反間致頭首者，許以封侯裂土之賞。"
  },
  {
    "id": "s0118",
    "blockIndex": 38,
    "zh": "故并州刺史長沙祝良，性多勇決，又南陽張喬，前在益州有破虜之功，皆可任用。"
  },
  {
    "id": "s0118",
    "blockIndex": 38,
    "zh": "昔太宗就加魏尚為雲中守，哀帝即拜龔捨為泰山守；"
  },
  {
    "id": "s0118",
    "blockIndex": 38,
    "zh": "宜即拜良等，便道之官。"
  },
  {
    "id": "s0118",
    "blockIndex": 38,
    "zh": "」四府悉從固議，即拜祝良為九真太守，張喬為交趾刺史。"
  },
  {
    "id": "s0118",
    "blockIndex": 38,
    "zh": "喬至，開示慰誘，並皆降散。"
  },
  {
    "id": "s0118",
    "blockIndex": 38,
    "zh": "良到九真，單車入賊中，設方略，招以威信，降者數萬人，皆為良築起府寺。"
  },
  {
    "id": "s0118",
    "blockIndex": 38,
    "zh": "由是嶺外復平。"
  },
  {
    "id": "s0146",
    "blockIndex": 39,
    "zh": "秋，八月，己未，司徒黃尚免。"
  },
  {
    "id": "s0146",
    "blockIndex": 39,
    "zh": "九月，己酉，以光祿勳長沙劉壽為司徒。"
  },
  {
    "id": "s0146",
    "blockIndex": 39,
    "zh": "丙戌，令大將軍、三公舉剛毅、武猛、謀謨任將帥者各二人，特進、卿、校尉各一人。"
  },
  {
    "id": "s0146",
    "blockIndex": 39,
    "zh": "初，尚書令左雄薦冀州刺史周舉為尚書。"
  },
  {
    "id": "s0146",
    "blockIndex": 39,
    "zh": "既而雄為司隸校尉，舉故冀州刺史馮直任將帥。"
  },
  {
    "id": "s0146",
    "blockIndex": 39,
    "zh": "直嘗坐臧受罪，舉以此劾奏雄。"
  },
  {
    "id": "s0146",
    "blockIndex": 39,
    "zh": "雄曰：「詔書使我選武猛，不使我選清高。"
  },
  {
    "id": "s0146",
    "blockIndex": 39,
    "zh": "」舉曰：「詔書使君選武猛，不使君選貪污也。"
  },
  {
    "id": "s0146",
    "blockIndex": 39,
    "zh": "」雄曰：「進君，適所以自伐也。"
  },
  {
    "id": "s0146",
    "blockIndex": 39,
    "zh": "」舉曰：「昔趙宣子任韓厥為司馬，厥以軍法戮宣子僕，宣子謂諸大夫曰：『可賀我矣！"
  },
  {
    "id": "s0146",
    "blockIndex": 39,
    "zh": "吾選厥也任其事。"
  },
  {
    "id": "s0146",
    "blockIndex": 39,
    "zh": "』今君不以舉之不才誤升諸朝，不敢阿君以為君羞；"
  },
  {
    "id": "s0146",
    "blockIndex": 39,
    "zh": "不寤君之意與宣子殊也。"
  },
  {
    "id": "s0146",
    "blockIndex": 39,
    "zh": "」雄悅，謝曰：「吾嘗事馮直之父，又與直善；"
  },
  {
    "id": "s0146",
    "blockIndex": 39,
    "zh": "今宣光以此奏吾，是吾之過也！"
  },
  {
    "id": "s0146",
    "blockIndex": 39,
    "zh": "」天下益以此賢之。"
  },
  {
    "id": "s0146",
    "blockIndex": 39,
    "zh": "是時，宦官競賣恩勢，唯大長秋良賀清儉退厚。"
  },
  {
    "id": "s0146",
    "blockIndex": 39,
    "zh": "及詔舉武猛，賀獨無所薦。"
  },
  {
    "id": "s0146",
    "blockIndex": 39,
    "zh": "帝問其故，對曰：「臣生自草茅，長於宮掖，既無知人之明，又未嘗交加士類。"
  },
  {
    "id": "s0146",
    "blockIndex": 39,
    "zh": "昔衛鞅因景監以見，有識知其不終。"
  },
  {
    "id": "s0146",
    "blockIndex": 39,
    "zh": "今得臣舉者，匪榮伊辱，是以不敢！"
  },
  {
    "id": "s0146",
    "blockIndex": 39,
    "zh": "」帝由是賞之。"
  },
  {
    "id": "s0168",
    "blockIndex": 40,
    "zh": "冬，十月，燒當羌那離等三千餘騎寇金城，校尉馬賢擊破之。"
  },
  {
    "id": "s0169",
    "blockIndex": 41,
    "zh": "十二月，戊戌朔，日有食之。"
  },
  {
    "id": "s0170",
    "blockIndex": 42,
    "zh": "大將軍商以小黃門南陽曹節等用事於中，遣子冀、不疑與為交友；"
  },
  {
    "id": "s0170",
    "blockIndex": 42,
    "zh": "而宦言忌其寵，反欲陷之。"
  },
  {
    "id": "s0170",
    "blockIndex": 42,
    "zh": "中常侍張逵、蘧政、楊定等與左右連謀，共譖商及中常侍曹騰、孟賁，云：「欲征諸王子，圖議廢立，請收商等案罪。"
  },
  {
    "id": "s0170",
    "blockIndex": 42,
    "zh": "」帝曰：「大將軍父子，我所親，騰、賁，我所愛，必無是，但汝曹共妒之耳。"
  },
  {
    "id": "s0170",
    "blockIndex": 42,
    "zh": "」逵等知言不用，懼迫，遂出，矯詔收縛騰、賁於省中。"
  },
  {
    "id": "s0170",
    "blockIndex": 42,
    "zh": "帝聞，震怒，敕宦者李歙急呼騰、賁釋之；"
  },
  {
    "id": "s0170",
    "blockIndex": 42,
    "zh": "收逵等下獄。"
  },
  {
    "id": "s0177",
    "blockIndex": 43,
    "zh": "春，正月，庚辰，逵等伏誅。"
  },
  {
    "id": "s0177",
    "blockIndex": 43,
    "zh": "事連弘農太守張鳳、安平相楊皓，皆坐死。"
  },
  {
    "id": "s0177",
    "blockIndex": 43,
    "zh": "辭所連染，延及在位大臣。"
  },
  {
    "id": "s0177",
    "blockIndex": 43,
    "zh": "商懼多侵枉，乃上疏曰：「《春秋》之義，功在元帥，罪止首惡。"
  },
  {
    "id": "s0177",
    "blockIndex": 43,
    "zh": "大獄一起，無辜者眾，死囚久系，纖微成大，非所以順迎和氣，平政成化也。"
  },
  {
    "id": "s0177",
    "blockIndex": 43,
    "zh": "宜早訖章，以止逮捕之煩。"
  },
  {
    "id": "s0177",
    "blockIndex": 43,
    "zh": "」帝納之，罪止坐者。"
  },
  {
    "id": "s0177",
    "blockIndex": 43,
    "zh": "二月，帝以商少子虎賁中郎將不疑為步兵校尉。"
  },
  {
    "id": "s0177",
    "blockIndex": 43,
    "zh": "商上書辭曰：「不疑童孺，猥處成人之位。"
  },
  {
    "id": "s0177",
    "blockIndex": 43,
    "zh": "昔晏平仲辭鄁殿以守其富，公儀休不受魚飧以定其位。"
  },
  {
    "id": "s0177",
    "blockIndex": 43,
    "zh": "臣雖不才，亦願固福祿於聖世！"
  },
  {
    "id": "s0177",
    "blockIndex": 43,
    "zh": "」上乃以不疑為侍中、奉車都尉。"
  },
  {
    "id": "s0189",
    "blockIndex": 44,
    "zh": "三月，乙亥，京師地震。"
  },
  {
    "id": "s0190",
    "blockIndex": 45,
    "zh": "燒當羌那離等復反；"
  },
  {
    "id": "s0190",
    "blockIndex": 45,
    "zh": "夏，四月，癸卯，護羌校尉馬賢討斬之，獲首虜千二百餘級。"
  },
  {
    "id": "s0192",
    "blockIndex": 46,
    "zh": "戊午，赦天下。"
  },
  {
    "id": "s0193",
    "blockIndex": 47,
    "zh": "五月，戊胡，封故濟北惠王壽子安為濟北王。"
  },
  {
    "id": "s0194",
    "blockIndex": 48,
    "zh": "秋，八月，太原旱。"
  },
  {
    "id": "s0195",
    "blockIndex": 49,
    "zh": "春，二月，戊申，京師地震。"
  },
  {
    "id": "s0196",
    "blockIndex": 50,
    "zh": "南匈奴句龍王吾斯、車紐等反，寇西河；"
  },
  {
    "id": "s0196",
    "blockIndex": 50,
    "zh": "招誘右賢王合兵圍美稷，殺朔方、代郡長吏。"
  },
  {
    "id": "s0196",
    "blockIndex": 50,
    "zh": "夏，五月，度遼將軍馬續與中郎將梁並等發邊兵及羌、胡合二萬餘人掩擊，破之。"
  },
  {
    "id": "s0196",
    "blockIndex": 50,
    "zh": "吾斯等復更屯聚，攻沒城邑。"
  },
  {
    "id": "s0196",
    "blockIndex": 50,
    "zh": "天子遣使責讓單于；"
  },
  {
    "id": "s0196",
    "blockIndex": 50,
    "zh": "單于本不預謀，乃脫帽避帳，詣並謝罪。"
  },
  {
    "id": "s0196",
    "blockIndex": 50,
    "zh": "並以病徵，五原太守陳龜代為中郎將。"
  },
  {
    "id": "s0196",
    "blockIndex": 50,
    "zh": "龜以單于不能制下，逼迫單于及其弟左賢王皆令自殺。"
  },
  {
    "id": "s0196",
    "blockIndex": 50,
    "zh": "龜又欲徙單于近親於內郡，而降者遂更狐疑。"
  },
  {
    "id": "s0196",
    "blockIndex": 50,
    "zh": "龜坐下獄，免。"
  },
  {
    "id": "s0206",
    "blockIndex": 51,
    "zh": "大將軍商上表曰：「匈奴寇畔，自知罪極。"
  },
  {
    "id": "s0206",
    "blockIndex": 51,
    "zh": "窮鳥困獸，皆知救死，況種類繁熾，不可單盡。"
  },
  {
    "id": "s0206",
    "blockIndex": 51,
    "zh": "今轉運日增，三軍疲苦，虛內給外，非中國之利。"
  },
  {
    "id": "s0206",
    "blockIndex": 51,
    "zh": "度遼將軍馬續，素有謀謨，且典邊日久，深曉兵要；"
  },
  {
    "id": "s0206",
    "blockIndex": 51,
    "zh": "每得續書，與臣策合。"
  },
  {
    "id": "s0206",
    "blockIndex": 51,
    "zh": "宜令續深溝高壁，以恩信招降，宣示購賞，明為期約。"
  },
  {
    "id": "s0206",
    "blockIndex": 51,
    "zh": "如此，則丑類可服，國家無事矣。"
  },
  {
    "id": "s0206",
    "blockIndex": 51,
    "zh": "」帝從之，乃詔續招降畔虜。"
  },
  {
    "id": "s0206",
    "blockIndex": 51,
    "zh": "商又移書續等曰：「中國安寧，忘戰日久。"
  },
  {
    "id": "s0206",
    "blockIndex": 51,
    "zh": "良騎野合，交鋒接矢，決勝當時，戎狄之所長而中國之所短也；"
  },
  {
    "id": "s0206",
    "blockIndex": 51,
    "zh": "強弩乘城，堅營固守，以待其衰，中國之所長而戎狄之所短也。"
  },
  {
    "id": "s0206",
    "blockIndex": 51,
    "zh": "宜務先所長以觀其變，設購開賞，宣示反悔，勿貪小功以亂大謀。"
  },
  {
    "id": "s0206",
    "blockIndex": 51,
    "zh": "」於是右賢王部抑鞮等萬三千口皆詣續降。"
  },
  {
    "id": "s0219",
    "blockIndex": 52,
    "zh": "己丑晦，日有食之。"
  },
  {
    "id": "s0220",
    "blockIndex": 53,
    "zh": "初，那離等既平，朝廷以來機為并州刺史，劉秉為涼州刺史。"
  },
  {
    "id": "s0220",
    "blockIndex": 53,
    "zh": "機等天性虐刻，多所擾發；"
  },
  {
    "id": "s0220",
    "blockIndex": 53,
    "zh": "且凍、傅難種羌遂反，攻金城，與雜種羌、胡大寇三輔，殺害長吏。"
  },
  {
    "id": "s0220",
    "blockIndex": 53,
    "zh": "機、秉並坐征。"
  },
  {
    "id": "s0220",
    "blockIndex": 53,
    "zh": "於是拜馬賢為征西將軍，以騎都尉耿叔為副，將左右羽林五校士及諸州郡兵十萬人屯漢陽。"
  },
  {
    "id": "s0225",
    "blockIndex": 54,
    "zh": "九月，令扶風、漢陽築隴道塢三百所，置屯兵。"
  },
  {
    "id": "s0226",
    "blockIndex": 55,
    "zh": "辛未，太尉王龔以老病罷。"
  },
  {
    "id": "s0227",
    "blockIndex": 56,
    "zh": "且凍羌寇武都，燒隴關。"
  },
  {
    "id": "s0228",
    "blockIndex": 57,
    "zh": "壬午，以太常桓焉為太尉。"
  },
  {
    "id": "s0229",
    "blockIndex": 58,
    "zh": "匈奴句龍王吾斯等立車紐為單于，東引烏桓，西收羌、胡等數萬人攻破京兆虎牙營，殺上郡都尉及軍司馬，遂寇掠並、涼、幽、冀四州。"
  },
  {
    "id": "s0229",
    "blockIndex": 58,
    "zh": "乃徙西河治離石，上郡治夏陽，朔方治五原。"
  },
  {
    "id": "s0229",
    "blockIndex": 58,
    "zh": "十二月，遣使匈奴中郎將張耽將幽州、烏桓諸郡營兵擊車紐等，戰於馬邑，斬首三千級，獲生口甚眾。"
  },
  {
    "id": "s0229",
    "blockIndex": 58,
    "zh": "車紐乞降，而吾斯猶率其部曲與烏桓寇鈔。"
  },
  {
    "id": "s0233",
    "blockIndex": 59,
    "zh": "初，上命馬賢討西羌，大將軍商以為賢老，不如太中大夫宋漢；"
  },
  {
    "id": "s0233",
    "blockIndex": 59,
    "zh": "帝不從。"
  },
  {
    "id": "s0233",
    "blockIndex": 59,
    "zh": "漢，由之子也。"
  },
  {
    "id": "s0233",
    "blockIndex": 59,
    "zh": "賢到軍，稽留不進。"
  },
  {
    "id": "s0233",
    "blockIndex": 59,
    "zh": "武都太守馬融上疏曰：「今雜種諸羌轉相鈔盜，宜及其未並，亟遣深入，破其支黨；"
  },
  {
    "id": "s0233",
    "blockIndex": 59,
    "zh": "而馬賢等處處留滯。"
  },
  {
    "id": "s0233",
    "blockIndex": 59,
    "zh": "羌、胡百里望塵，千里聽聲，今逃匿避回，漏出其後，則必侵寇三輔，為民大害。"
  },
  {
    "id": "s0233",
    "blockIndex": 59,
    "zh": "臣願請賢所不可，用關東兵五千，裁假部隊之號，盡力率厲，埋根、行首以先吏士；"
  },
  {
    "id": "s0233",
    "blockIndex": 59,
    "zh": "三旬之中，必克破之。"
  },
  {
    "id": "s0233",
    "blockIndex": 59,
    "zh": "臣又聞吳起為將，暑不張蓋，寒不披裘；"
  },
  {
    "id": "s0233",
    "blockIndex": 59,
    "zh": "今賢野次垂幕，珍餚雜遝，兒子侍妾，事與古反。"
  },
  {
    "id": "s0233",
    "blockIndex": 59,
    "zh": "臣懼賢等專守一城，言攻於西而羌出於東，且其將士將不堪命，必有高克潰叛之變也。"
  },
  {
    "id": "s0233",
    "blockIndex": 59,
    "zh": "」安定人皇甫規亦見賢不恤軍事，審其必敗，上書言狀。"
  },
  {
    "id": "s0233",
    "blockIndex": 59,
    "zh": "朝廷皆不從。"
  },
  {
    "id": "s0247",
    "blockIndex": 60,
    "zh": "春，正月，丙子，征西將軍馬賢與且凍羌戰於射姑山，賢軍敗；"
  },
  {
    "id": "s0247",
    "blockIndex": 60,
    "zh": "賢及二子皆沒，東、西羌遂大合。"
  },
  {
    "id": "s0247",
    "blockIndex": 60,
    "zh": "閏月，鞏唐羌寇隴西，遂及三輔，燒園陵，殺掠吏民。"
  },
  {
    "id": "s0250",
    "blockIndex": 61,
    "zh": "二月，丁巳，有星孛於營室。"
  },
  {
    "id": "s0251",
    "blockIndex": 62,
    "zh": "三月，上巳，大將軍商大會賓客，宴於雒水；"
  },
  {
    "id": "s0251",
    "blockIndex": 62,
    "zh": "酒闌，繼以《韭露之歌》。"
  },
  {
    "id": "s0251",
    "blockIndex": 62,
    "zh": "從事中郎周舉聞之，歎曰：「此所謂哀樂失時，非其所也，殃將及乎！"
  },
  {
    "id": "s0255",
    "blockIndex": 63,
    "zh": "武都太守趙沖追擊鞏唐羌，斬首四百餘級，降二千餘人。"
  },
  {
    "id": "s0255",
    "blockIndex": 63,
    "zh": "詔沖督河西四郡兵為節度。"
  },
  {
    "id": "s0257",
    "blockIndex": 64,
    "zh": "安定上計掾皇甫規上疏曰：「臣比年以來，數陳便宜：羌戎未動，策其將反；"
  },
  {
    "id": "s0257",
    "blockIndex": 64,
    "zh": "馬賢始出，知其必敗。"
  },
  {
    "id": "s0257",
    "blockIndex": 64,
    "zh": "誤中之言，在可考校。"
  },
  {
    "id": "s0257",
    "blockIndex": 64,
    "zh": "臣每惟賢等擁眾四年，未有成功，縣師之費，且百億計，出於平民，回入奸吏。"
  },
  {
    "id": "s0257",
    "blockIndex": 64,
    "zh": "故江湖之人，群為盜賊，青、徐荒饑，襁負流散。"
  },
  {
    "id": "s0257",
    "blockIndex": 64,
    "zh": "夫羌戎潰叛，不由承平，皆因邊將失於綏御，乘常守安則加侵暴，苟競小利則致大害，微勝則虛張首級，軍敗則隱匿不言。"
  },
  {
    "id": "s0257",
    "blockIndex": 64,
    "zh": "軍士勞怨，困於猾吏，進不得快戰以徼功，退不得溫飽以全命，餓死溝渠，暴骨中原；"
  },
  {
    "id": "s0257",
    "blockIndex": 64,
    "zh": "徒見王師之出，不聞振旅之聲。"
  },
  {
    "id": "s0257",
    "blockIndex": 64,
    "zh": "酋豪泣血，驚懼生變，是以安不能久，叛則經年，臣所以搏手扣心而增歎者也！"
  },
  {
    "id": "s0257",
    "blockIndex": 64,
    "zh": "願假臣兩營、二郡屯列坐食之兵五千，出其不意，與趙沖共相首尾。"
  },
  {
    "id": "s0257",
    "blockIndex": 64,
    "zh": "土地山谷，臣所曉習；"
  },
  {
    "id": "s0257",
    "blockIndex": 64,
    "zh": "兵勢巧便，臣已更之；"
  },
  {
    "id": "s0257",
    "blockIndex": 64,
    "zh": "可不煩方寸之印，尺帛之賜，高可以滌患，下可以納降。"
  },
  {
    "id": "s0257",
    "blockIndex": 64,
    "zh": "若謂臣年少、官輕，不足用者，凡諸敗將，非官爵之不高，年齒之不邁。"
  },
  {
    "id": "s0257",
    "blockIndex": 64,
    "zh": "臣不勝至誠，沒死自陳！"
  },
  {
    "id": "s0257",
    "blockIndex": 64,
    "zh": "」帝不能用。"
  },
  {
    "id": "s0273",
    "blockIndex": 65,
    "zh": "庚子，司空郭虔免。"
  },
  {
    "id": "s0273",
    "blockIndex": 65,
    "zh": "丙午，以太僕趙戒為司空。"
  },
  {
    "id": "s0275",
    "blockIndex": 66,
    "zh": "夏，使匈奴中郎將張耽、度遼將軍馬續率鮮卑到谷城，擊烏桓於通天山，大破之。"
  },
  {
    "id": "s0276",
    "blockIndex": 67,
    "zh": "鞏唐羌寇北地。"
  },
  {
    "id": "s0276",
    "blockIndex": 67,
    "zh": "北地太守賈福與趙衝擊之，不利。"
  },
  {
    "id": "s0278",
    "blockIndex": 68,
    "zh": "秋，八月，乘氏忠侯梁商病篤，敕子冀等曰：「吾生無以輔益朝廷，死何可耗費帑藏！"
  },
  {
    "id": "s0278",
    "blockIndex": 68,
    "zh": "衣衾、飯含、玉匣、珠貝之屬，何益朽骨！"
  },
  {
    "id": "s0278",
    "blockIndex": 68,
    "zh": "百僚勞擾，紛華道路，只增塵垢耳。"
  },
  {
    "id": "s0278",
    "blockIndex": 68,
    "zh": "宜皆辭之。"
  },
  {
    "id": "s0278",
    "blockIndex": 68,
    "zh": "」丙辰，薨；"
  },
  {
    "id": "s0278",
    "blockIndex": 68,
    "zh": "帝親臨喪。"
  },
  {
    "id": "s0278",
    "blockIndex": 68,
    "zh": "諸子欲從其誨，朝廷不聽，賜以東園秘器、銀鏤、黃腸、玉匣。"
  },
  {
    "id": "s0278",
    "blockIndex": 68,
    "zh": "及葬，賜輕車、介士，中宮親送。"
  },
  {
    "id": "s0278",
    "blockIndex": 68,
    "zh": "帝至宣陽亭，瞻望車騎。"
  },
  {
    "id": "s0278",
    "blockIndex": 68,
    "zh": "壬戌，以河南尹、乘氏侯梁冀為大將軍，冀弟侍中不疑為河南伊。"
  },
  {
    "id": "s0288",
    "blockIndex": 69,
    "zh": "臣光曰：成帝不能選任賢俊，委政舅家，可謂暗矣；"
  },
  {
    "id": "s0288",
    "blockIndex": 69,
    "zh": "猶知王立之不材，棄而不用。"
  },
  {
    "id": "s0288",
    "blockIndex": 69,
    "zh": "順帝援大柄，授之後族，梁冀頑嚚凶暴，著於平昔，而使之繼父之位，終於悖逆，蕩覆漢室；"
  },
  {
    "id": "s0288",
    "blockIndex": 69,
    "zh": "校於成帝，暗又甚焉！"
  },
  {
    "id": "s0292",
    "blockIndex": 70,
    "zh": "初，梁商病篤，帝親臨幸，問以遺言。"
  },
  {
    "id": "s0292",
    "blockIndex": 70,
    "zh": "對曰：「臣從事中郎周舉，清高忠正，可重任也。"
  },
  {
    "id": "s0292",
    "blockIndex": 70,
    "zh": "」由是拜舉諫議大夫。"
  },
  {
    "id": "s0295",
    "blockIndex": 71,
    "zh": "九月，諸羌寇武威。"
  },
  {
    "id": "s0296",
    "blockIndex": 72,
    "zh": "辛亥晦，日有食之。"
  },
  {
    "id": "s0297",
    "blockIndex": 73,
    "zh": "冬，十月，癸丑，以羌寇充斥，涼部震恐，復徙安定居扶風，北地居馮翊。"
  },
  {
    "id": "s0297",
    "blockIndex": 73,
    "zh": "十一月，庚子，以執金吾張喬行車騎將軍事，將兵萬五千人屯三輔。"
  },
  {
    "id": "s0299",
    "blockIndex": 74,
    "zh": "荊州盜賊起，彌年不定；"
  },
  {
    "id": "s0299",
    "blockIndex": 74,
    "zh": "以大將軍從事中郎李固為荊州刺史。"
  },
  {
    "id": "s0299",
    "blockIndex": 74,
    "zh": "固到，遣吏勞問境內，赦寇盜前釁，與之更始。"
  },
  {
    "id": "s0299",
    "blockIndex": 74,
    "zh": "於是賊帥夏密等率其魁黨六百餘人自縛歸首，固皆原之，遣還，使自相招集，開示威法；"
  },
  {
    "id": "s0299",
    "blockIndex": 74,
    "zh": "半歲間，餘類悉降，州內清平。"
  },
  {
    "id": "s0299",
    "blockIndex": 74,
    "zh": "奏南陽太守高賜等臧穢；"
  },
  {
    "id": "s0299",
    "blockIndex": 74,
    "zh": "賜等重賂大將軍梁冀，冀為之千里移檄，而固持之愈急，冀遂徙固為泰山太守。"
  },
  {
    "id": "s0299",
    "blockIndex": 74,
    "zh": "時泰山盜賊屯聚歷年，郡兵常千人追討，不能制；"
  },
  {
    "id": "s0299",
    "blockIndex": 74,
    "zh": "固到，悉罷遣歸農，但選留任戰者百餘人，以恩信招誘之。"
  },
  {
    "id": "s0299",
    "blockIndex": 74,
    "zh": "未滿歲，賊皆弭散。"
  },
  {
    "id": "s0309",
    "blockIndex": 75,
    "zh": "春，正月，癸巳，赦天下，改元。"
  },
  {
    "id": "s0310",
    "blockIndex": 76,
    "zh": "秋，八月，南匈奴句龍吾斯與薁鞬、台耆等復反，寇掠並部。"
  },
  {
    "id": "s0311",
    "blockIndex": 77,
    "zh": "丁卯，遺侍中河內杜喬、周舉、守光祿大夫周栩、馮羨、魏郡欒巴、張綱、郭遵、劉班分行州郡，表賢良，顯忠勤；"
  },
  {
    "id": "s0311",
    "blockIndex": 77,
    "zh": "其貪污有罪者，刺史、二千石驛馬上之，墨綬以下便輒收舉。"
  },
  {
    "id": "s0311",
    "blockIndex": 77,
    "zh": "喬等受命之部，張綱獨埋其車輪於雒陽都亭，曰：「豺狼當路，安問狐狸！"
  },
  {
    "id": "s0311",
    "blockIndex": 77,
    "zh": "」遂劾奏：「大將軍冀、河南尹不疑，以外戚蒙恩，居阿衡之任，而專肆貪叨，縱恣無極，多樹諂諛以害忠良，誠天威所不赦，大辟所宜加也。"
  },
  {
    "id": "s0311",
    "blockIndex": 77,
    "zh": "謹條其無君之心十五事，斯皆臣子所切齒者也。"
  },
  {
    "id": "s0311",
    "blockIndex": 77,
    "zh": "」書御，京師震竦。"
  },
  {
    "id": "s0311",
    "blockIndex": 77,
    "zh": "時皇后寵方盛，諸梁姻族滿朝，帝雖知綱言直，不能用也。"
  },
  {
    "id": "s0311",
    "blockIndex": 77,
    "zh": "杜喬至冶金兗州，表奏泰山太守李固政為天下第一，上征固為將作大匠。"
  },
  {
    "id": "s0311",
    "blockIndex": 77,
    "zh": "八使所劾奏，多梁冀及宦者親黨；"
  },
  {
    "id": "s0311",
    "blockIndex": 77,
    "zh": "互為請救，事皆寢遏。"
  },
  {
    "id": "s0311",
    "blockIndex": 77,
    "zh": "侍御史河南種暠疾之，復行案舉。"
  },
  {
    "id": "s0311",
    "blockIndex": 77,
    "zh": "廷尉吳雄、將作大匠李固亦上言：「八使所糾，宜急誅罰。"
  },
  {
    "id": "s0311",
    "blockIndex": 77,
    "zh": "」帝乃更下八使奏章，令考正其罪。"
  },
  {
    "id": "s0324",
    "blockIndex": 78,
    "zh": "梁冀恨張綱，思有以中傷之。"
  },
  {
    "id": "s0324",
    "blockIndex": 78,
    "zh": "時廣陵賊張嬰寇亂揚、徐間積十餘年，二千石不能制，冀乃以綱為廣陵太守。"
  },
  {
    "id": "s0324",
    "blockIndex": 78,
    "zh": "前太守率多求兵馬，綱獨請單車之職。"
  },
  {
    "id": "s0324",
    "blockIndex": 78,
    "zh": "既到，逕詣嬰壘門；"
  },
  {
    "id": "s0324",
    "blockIndex": 78,
    "zh": "嬰大驚，遽走閉壘。"
  },
  {
    "id": "s0324",
    "blockIndex": 78,
    "zh": "綱於門外罷遣吏兵，獨留所親者十餘人，以書喻嬰，請與相見。"
  },
  {
    "id": "s0324",
    "blockIndex": 78,
    "zh": "嬰見綱至誠，乃出拜謁。"
  },
  {
    "id": "s0324",
    "blockIndex": 78,
    "zh": "綱延置上坐，譬之曰：「前後二千石多肆貪暴，故致公等懷憤相聚。"
  },
  {
    "id": "s0324",
    "blockIndex": 78,
    "zh": "二千石信有罪矣，然為之者又非義也。"
  },
  {
    "id": "s0324",
    "blockIndex": 78,
    "zh": "今主上仁聖，欲以文德服叛，故遣太守來，思以爵祿相榮，不願以刑罰相加，今誠轉禍為福之時也。"
  },
  {
    "id": "s0324",
    "blockIndex": 78,
    "zh": "若聞義不服，天子赫然震怒，荊、揚、兗、豫大兵雲合，身首橫分，血嗣俱絕。"
  },
  {
    "id": "s0324",
    "blockIndex": 78,
    "zh": "二者利害，公其深計之！"
  },
  {
    "id": "s0324",
    "blockIndex": 78,
    "zh": "」嬰聞，泣下曰：「荒裔愚民，不能自通朝廷，不堪侵枉，遂復相聚偷生，若魚游釜中，知其不可久，且以喘息須臾間耳！"
  },
  {
    "id": "s0324",
    "blockIndex": 78,
    "zh": "今聞明府之言，乃嬰等更生之辰也！"
  },
  {
    "id": "s0324",
    "blockIndex": 78,
    "zh": "」乃辭還營。"
  },
  {
    "id": "s0324",
    "blockIndex": 78,
    "zh": "明日，將所部萬餘人與妻子面縛歸降。"
  },
  {
    "id": "s0324",
    "blockIndex": 78,
    "zh": "綱單車入嬰壘，大會，置酒為樂，散遣部眾，任從所之；"
  },
  {
    "id": "s0324",
    "blockIndex": 78,
    "zh": "親為卜居宅、相田疇；"
  },
  {
    "id": "s0324",
    "blockIndex": 78,
    "zh": "子弟欲為吏者，皆引召之。"
  },
  {
    "id": "s0324",
    "blockIndex": 78,
    "zh": "人情悅服，南州晏然。"
  },
  {
    "id": "s0324",
    "blockIndex": 78,
    "zh": "朝廷論功當封，梁冀遏之。"
  },
  {
    "id": "s0324",
    "blockIndex": 78,
    "zh": "在郡一歲，卒；"
  },
  {
    "id": "s0324",
    "blockIndex": 78,
    "zh": "張嬰等五百餘人為之制服行喪，送到犍為，負土成墳。"
  },
  {
    "id": "s0324",
    "blockIndex": 78,
    "zh": "詔拜其子續為郎中，賜錢百萬。"
  },
  {
    "id": "s0348",
    "blockIndex": 79,
    "zh": "是時，二千石長吏有能政者，有雒陽令渤海任峻、冀州刺史京兆蘇章、膠東相陳留吳祐。"
  },
  {
    "id": "s0348",
    "blockIndex": 79,
    "zh": "雒陽令自王渙之後，皆不稱職。"
  },
  {
    "id": "s0348",
    "blockIndex": 79,
    "zh": "峻能選用文武吏，各盡其用，發奸不旋踵，民間不畏吏，其威禁猛於渙，而文理政教不如也。"
  },
  {
    "id": "s0348",
    "blockIndex": 79,
    "zh": "章為冀州刺史，有故人為清河太守，章行部，欲案其奸臧，乃主太守為設酒餚，陳平生之好甚歡。"
  },
  {
    "id": "s0348",
    "blockIndex": 79,
    "zh": "太守喜曰：「人皆有一天，我獨有二天！"
  },
  {
    "id": "s0348",
    "blockIndex": 79,
    "zh": "」章曰：「今夕蘇孺文與故人飲者，私恩也；"
  },
  {
    "id": "s0348",
    "blockIndex": 79,
    "zh": "明日冀州刺史案事者，公法也。"
  },
  {
    "id": "s0348",
    "blockIndex": 79,
    "zh": "」遂舉正其罪，州境肅然。"
  },
  {
    "id": "s0348",
    "blockIndex": 79,
    "zh": "後以摧折權豪忤旨，坐免。"
  },
  {
    "id": "s0348",
    "blockIndex": 79,
    "zh": "時天下日敝，民多愁苦，論者日夜稱章，朝廷遂不能復用也。"
  },
  {
    "id": "s0348",
    "blockIndex": 79,
    "zh": "祐為膠東相，政崇仁簡，民不忍欺。"
  },
  {
    "id": "s0348",
    "blockIndex": 79,
    "zh": "嗇夫孫性，私賦民錢，市衣以進其父，父得而怒曰：「有君如是，何忍欺之！"
  },
  {
    "id": "s0348",
    "blockIndex": 79,
    "zh": "」促歸伏罪。"
  },
  {
    "id": "s0348",
    "blockIndex": 79,
    "zh": "性慚懼詣閣，持衣自首。"
  },
  {
    "id": "s0348",
    "blockIndex": 79,
    "zh": "祐屏左右問其故，性具談父言。"
  },
  {
    "id": "s0348",
    "blockIndex": 79,
    "zh": "祐曰：「掾以親故受污穢之名，所謂『觀過斯知仁矣。"
  },
  {
    "id": "s0348",
    "blockIndex": 79,
    "zh": "』」使歸謝其父，還以衣遺之。"
  },
  {
    "id": "s0365",
    "blockIndex": 80,
    "zh": "冬，十月，辛未，太尉桓焉、司徒劉壽免。"
  },
  {
    "id": "s0366",
    "blockIndex": 81,
    "zh": "罕羌邑落五千餘戶詣趙沖降，唯燒何種據參絲未下。"
  },
  {
    "id": "s0366",
    "blockIndex": 81,
    "zh": "甲戌，罷張喬軍屯。"
  },
  {
    "id": "s0368",
    "blockIndex": 82,
    "zh": "十一月，壬午，以司隸校尉下邳趙峻為太尉，大司農胡廣為司徒。"
  },
  {
    "id": "s0369",
    "blockIndex": 83,
    "zh": "夏，四月，庚戌，護羌校尉趙沖與漢陽太守張貢擊燒當羌於參絲，破之。"
  },
  {
    "id": "s0370",
    "blockIndex": 84,
    "zh": "六月，丙寅，立南匈奴守義王兜樓儲為呼蘭若屍逐就單于。"
  },
  {
    "id": "s0370",
    "blockIndex": 84,
    "zh": "時兜樓儲在京師，上親臨軒授璽綬，引上殿，賜車馬、器服、金帛甚厚。"
  },
  {
    "id": "s0370",
    "blockIndex": 84,
    "zh": "詔太常、大鴻臚與諸國侍子於廣陽城門外祖會，饗賜、作樂、角抵、百戲。"
  },
  {
    "id": "s0373",
    "blockIndex": 85,
    "zh": "冬，閏十月，趙衝擊燒當羌於阿陽，破之。"
  },
  {
    "id": "s0374",
    "blockIndex": 86,
    "zh": "十一月，使匈奴中郎將扶風馬寔遣人刺殺句龍吾斯。"
  },
  {
    "id": "s0375",
    "blockIndex": 87,
    "zh": "涼州自九月以來，地百八十震，山谷坼裂，壞敗城寺，民壓死者甚眾。"
  },
  {
    "id": "s0376",
    "blockIndex": 88,
    "zh": "尚書令黃瓊以前左雄所上孝廉之選，專用儒學、文吏，於取士之義猶有所遺，乃奏增孝悌及能從政者為四科；"
  },
  {
    "id": "s0376",
    "blockIndex": 88,
    "zh": "帝從之。"
  },
  {
    "id": "s0378",
    "blockIndex": 89,
    "zh": "春，護羌從事馬玄為諸羌所誘，將羌眾亡出塞，領護羌校尉衛琚追擊玄等，斬首八百餘級。"
  },
  {
    "id": "s0378",
    "blockIndex": 89,
    "zh": "趙沖復追叛羌到建威鸇陰河；"
  },
  {
    "id": "s0378",
    "blockIndex": 89,
    "zh": "軍度竟，所將降胡六百餘人叛走；"
  },
  {
    "id": "s0378",
    "blockIndex": 89,
    "zh": "衝將數百人追之，遇羌伏後，與戰而歿。"
  },
  {
    "id": "s0378",
    "blockIndex": 89,
    "zh": "沖雖死，而前後多所斬獲，羌由是衰耗。"
  },
  {
    "id": "s0378",
    "blockIndex": 89,
    "zh": "詔封沖子為義陽亭侯。"
  },
  {
    "id": "s0384",
    "blockIndex": 90,
    "zh": "夏，四月，使匈奴中郎將馬寔擊南匈奴左部，破之。"
  },
  {
    "id": "s0384",
    "blockIndex": 90,
    "zh": "於是胡、羌、烏桓悉詣寔降。"
  },
  {
    "id": "s0386",
    "blockIndex": 91,
    "zh": "辛巳，立皇子炳為太子，改元，赦天下。"
  },
  {
    "id": "s0386",
    "blockIndex": 91,
    "zh": "太子居承光宮，帝使侍御史種暠監其家。"
  },
  {
    "id": "s0386",
    "blockIndex": 91,
    "zh": "中常侍高梵從中單駕出迎太子，時太傅杜喬等疑不欲從而未決，暠乃手劍當車曰：「太子，國之儲副，人命所繫。"
  },
  {
    "id": "s0386",
    "blockIndex": 91,
    "zh": "今常侍來，無詔信，何以知非奸邪？"
  },
  {
    "id": "s0386",
    "blockIndex": 91,
    "zh": "今日有死而已！"
  },
  {
    "id": "s0386",
    "blockIndex": 91,
    "zh": "」梵辭屈，不敢對，馳還奏之。"
  },
  {
    "id": "s0386",
    "blockIndex": 91,
    "zh": "詔報，太子乃得去。"
  },
  {
    "id": "s0386",
    "blockIndex": 91,
    "zh": "喬退而歎息，愧暠臨事不惑；"
  },
  {
    "id": "s0386",
    "blockIndex": 91,
    "zh": "帝亦嘉其持重，稱善者良久。"
  },
  {
    "id": "s0395",
    "blockIndex": 92,
    "zh": "揚、徐盜賊群起，盤互連歲。"
  },
  {
    "id": "s0395",
    "blockIndex": 92,
    "zh": "秋，八月，九江范容、周生等寇掠城邑，屯據歷陽，為江、淮巨患；"
  },
  {
    "id": "s0395",
    "blockIndex": 92,
    "zh": "遣御史中丞馮緄督州兵討之。"
  },
  {
    "id": "s0398",
    "blockIndex": 93,
    "zh": "庚午，帝崩於玉堂前殿。"
  },
  {
    "id": "s0398",
    "blockIndex": 93,
    "zh": "太子即皇帝位，年二歲。"
  },
  {
    "id": "s0398",
    "blockIndex": 93,
    "zh": "尊皇后曰皇太后。"
  },
  {
    "id": "s0398",
    "blockIndex": 93,
    "zh": "太后臨朝。"
  },
  {
    "id": "s0402",
    "blockIndex": 94,
    "zh": "丁丑，以太尉趙峻為太傅，大司農李固為太尉，參錄尚書事。"
  },
  {
    "id": "s0403",
    "blockIndex": 95,
    "zh": "九月，丙午，葬孝順皇帝於憲陵，廟曰敬宗。"
  },
  {
    "id": "s0404",
    "blockIndex": 96,
    "zh": "是日，京師及太原、雁門地震。"
  },
  {
    "id": "s0405",
    "blockIndex": 97,
    "zh": "庚戌，詔舉賢良方正之士，策問之。"
  },
  {
    "id": "s0405",
    "blockIndex": 97,
    "zh": "皇甫規對曰：「伏惟孝順皇帝初勤王政，紀綱四方，幾以獲安；"
  },
  {
    "id": "s0405",
    "blockIndex": 97,
    "zh": "後遭奸偽，威分近習，受賂賣爵，賓客交錯，天下擾擾，從亂如歸，官民並竭，上下窮虛。"
  },
  {
    "id": "s0405",
    "blockIndex": 97,
    "zh": "陛下體兼乾坤，聰哲純茂，攝政之初，拔用忠貞，其餘維綱，多所改正，遠近翕然望見太平，而災異不息，寇賊縱橫，殆以奸臣權重之所致也。"
  },
  {
    "id": "s0405",
    "blockIndex": 97,
    "zh": "其常侍尤無狀者，宜亟黜遣，披掃凶黨，收入財賄，以塞痛怨，以答天誡。"
  },
  {
    "id": "s0405",
    "blockIndex": 97,
    "zh": "大將軍冀、河南尹不疑，亦宜增修謙節，輔以儒術，省去游娛不急之務，割減廬第無益之飾。"
  },
  {
    "id": "s0405",
    "blockIndex": 97,
    "zh": "夫君者，舟也；"
  },
  {
    "id": "s0405",
    "blockIndex": 97,
    "zh": "民者，水也；"
  },
  {
    "id": "s0405",
    "blockIndex": 97,
    "zh": "群臣，乘舟者也；"
  },
  {
    "id": "s0405",
    "blockIndex": 97,
    "zh": "將軍兄弟，操楫者也。"
  },
  {
    "id": "s0405",
    "blockIndex": 97,
    "zh": "若能平志畢力，以度元元，所謂福也。"
  },
  {
    "id": "s0405",
    "blockIndex": 97,
    "zh": "如其怠弛，將淪波濤，可不慎乎！"
  },
  {
    "id": "s0405",
    "blockIndex": 97,
    "zh": "夫德不稱祿，猶鑿墉之趾以益其高，豈量力審功，安固之道哉！"
  },
  {
    "id": "s0405",
    "blockIndex": 97,
    "zh": "凡諸宿猾、酒徒、戲客，皆宜貶斥，以懲不軌。"
  },
  {
    "id": "s0405",
    "blockIndex": 97,
    "zh": "令冀等深思得賢之福，失人之累。"
  },
  {
    "id": "s0405",
    "blockIndex": 97,
    "zh": "」梁冀忿之，以規為下第，拜郎中；"
  },
  {
    "id": "s0405",
    "blockIndex": 97,
    "zh": "托疾，免歸，州郡承冀旨，幾陷死者再三，遂沉廢於家，積十餘年。"
  },
  {
    "id": "s0422",
    "blockIndex": 98,
    "zh": "揚州刺史尹耀、九江太守鄧顯討范容等於歷陽，敗歿。"
  },
  {
    "id": "s0423",
    "blockIndex": 99,
    "zh": "冬，十月，日南蠻夷復反，攻燒縣邑。"
  },
  {
    "id": "s0423",
    "blockIndex": 99,
    "zh": "交趾刺史九江夏方招誘降之。"
  },
  {
    "id": "s0425",
    "blockIndex": 100,
    "zh": "十一月，九江盜賊徐鳳、馬勉等攻燒城邑；"
  },
  {
    "id": "s0425",
    "blockIndex": 100,
    "zh": "鳳稱無上將軍，勉稱皇帝，築營於當塗山中，建年號，置百官。"
  },
  {
    "id": "s0427",
    "blockIndex": 101,
    "zh": "十二月，九江賊黃虎等攻合肥。"
  },
  {
    "id": "s0428",
    "blockIndex": 102,
    "zh": "是歲，群盜發憲陵。"
  },
  {
    "id": "s0429",
    "blockIndex": 103,
    "zh": "漢孝皇帝"
  },
  {
    "id": "s0430",
    "blockIndex": 104,
    "zh": "春，正月，戊戌，帝崩於玉堂前殿。"
  },
  {
    "id": "s0430",
    "blockIndex": 104,
    "zh": "梁太后以揚、徐盜賊方盛，欲須所征諸王侯到乃發喪。"
  },
  {
    "id": "s0430",
    "blockIndex": 104,
    "zh": "太尉李固曰：「帝雖幼少，猶天下之父。"
  },
  {
    "id": "s0430",
    "blockIndex": 104,
    "zh": "今日崩亡，人神感動，豈有人子反共掩匿乎！"
  },
  {
    "id": "s0430",
    "blockIndex": 104,
    "zh": "昔秦皇沙丘之謀及近日北鄉之事，皆秘不發喪，此天下大忌，不可之甚者也！"
  },
  {
    "id": "s0430",
    "blockIndex": 104,
    "zh": "」太后從之，即暮發喪。"
  },
  {
    "id": "s0430",
    "blockIndex": 104,
    "zh": "征清河王蒜及渤海孝王鴻之子纘皆至京師。"
  },
  {
    "id": "s0430",
    "blockIndex": 104,
    "zh": "蒜父曰清河恭王延平；"
  },
  {
    "id": "s0430",
    "blockIndex": 104,
    "zh": "延平及鴻皆樂安夷王寵之子，千乘貞王伉之孫也。"
  },
  {
    "id": "s0430",
    "blockIndex": 104,
    "zh": "清河王為人嚴重，動止有法度，公卿皆歸心焉。"
  },
  {
    "id": "s0430",
    "blockIndex": 104,
    "zh": "李固謂大將軍冀曰：「今當立帝，宜擇長年，高明有德，任親政事者，願將軍審詳大計，察周、霍之立文、宣，戒鄧、閻之利幼弱！"
  },
  {
    "id": "s0430",
    "blockIndex": 104,
    "zh": "」冀不從，與太后定策禁中。"
  },
  {
    "id": "s0430",
    "blockIndex": 104,
    "zh": "丙辰，冀持節以王青蓋車迎纘入南宮。"
  },
  {
    "id": "s0430",
    "blockIndex": 104,
    "zh": "丁巳，封為建平侯。"
  },
  {
    "id": "s0430",
    "blockIndex": 104,
    "zh": "其日，即皇帝位，年八歲。"
  },
  {
    "id": "s0430",
    "blockIndex": 104,
    "zh": "蒜罷歸國。"
  },
  {
    "id": "s0446",
    "blockIndex": 105,
    "zh": "將卜山陵，李固曰：「今處處寇賊，軍興費廣，新創憲陵，賦發非一。"
  },
  {
    "id": "s0446",
    "blockIndex": 105,
    "zh": "帝尚幼小，可起陵於憲陵塋內，依康陵制度。"
  },
  {
    "id": "s0446",
    "blockIndex": 105,
    "zh": "」太后從之。"
  },
  {
    "id": "s0446",
    "blockIndex": 105,
    "zh": "己未，葬孝沖皇帝於懷陵。"
  },
  {
    "id": "s0450",
    "blockIndex": 106,
    "zh": "太后委政宰輔，李固所言，太后多從之，黃門宦官為惡者一皆斥遣，天下鹹望治平。"
  },
  {
    "id": "s0450",
    "blockIndex": 106,
    "zh": "而梁冀深忌疾之。"
  },
  {
    "id": "s0450",
    "blockIndex": 106,
    "zh": "初，順帝時所除官多不以次；"
  },
  {
    "id": "s0450",
    "blockIndex": 106,
    "zh": "及固在事，奏免百餘人。"
  },
  {
    "id": "s0450",
    "blockIndex": 106,
    "zh": "此等既怨，又希望冀旨，遂共作飛章誣奏固曰：「太尉李固，因公假私，依正行邪，離間近戚，自隆支黨。"
  },
  {
    "id": "s0450",
    "blockIndex": 106,
    "zh": "大行在殯，路人掩涕，固獨胡粉飾貌，搔頭弄姿，槃旋偃仰，從容治步，曾無慘怛傷悴之心。"
  },
  {
    "id": "s0450",
    "blockIndex": 106,
    "zh": "山陵未成，違矯舊政，善則稱己，過則歸君；"
  },
  {
    "id": "s0450",
    "blockIndex": 106,
    "zh": "斥逐近臣，不得侍送。"
  },
  {
    "id": "s0450",
    "blockIndex": 106,
    "zh": "作威作福，莫固之甚矣！"
  },
  {
    "id": "s0450",
    "blockIndex": 106,
    "zh": "夫子罪莫大於累父，臣惡莫深於毀君，固之過釁，事合誅辟。"
  },
  {
    "id": "s0450",
    "blockIndex": 106,
    "zh": "」書奏，冀以白太后，使下其書；"
  },
  {
    "id": "s0450",
    "blockIndex": 106,
    "zh": "太后不聽。"
  },
  {
    "id": "s0462",
    "blockIndex": 107,
    "zh": "廣陵賊張嬰復聚眾數千人反，據廣陵。"
  },
  {
    "id": "s0463",
    "blockIndex": 108,
    "zh": "二月，乙酉，赦天下。"
  },
  {
    "id": "s0464",
    "blockIndex": 109,
    "zh": "西羌叛亂積年，費用八十餘億。"
  },
  {
    "id": "s0464",
    "blockIndex": 109,
    "zh": "諸將多斷盜牢稟，私自潤入，皆以珍寶貨賂左右。"
  },
  {
    "id": "s0464",
    "blockIndex": 109,
    "zh": "上下放縱，不恤軍事，士卒不得其死者，白骨相望於野。"
  },
  {
    "id": "s0464",
    "blockIndex": 109,
    "zh": "左馮翊梁並以恩信招誘叛羌；"
  },
  {
    "id": "s0464",
    "blockIndex": 109,
    "zh": "離湳、狐奴等五萬餘戶皆詣並降，隴右復平。"
  },
  {
    "id": "s0469",
    "blockIndex": 110,
    "zh": "太后以徐、揚盜賊益熾，博求將帥。"
  },
  {
    "id": "s0469",
    "blockIndex": 110,
    "zh": "三公舉涿令北海滕撫有文武才；"
  },
  {
    "id": "s0469",
    "blockIndex": 110,
    "zh": "詔拜撫九江都尉，與中郎將趙序助馮緄，合州郡兵數萬人共討之。"
  },
  {
    "id": "s0469",
    "blockIndex": 110,
    "zh": "又廣開賞募，錢、邑各有差。"
  },
  {
    "id": "s0469",
    "blockIndex": 110,
    "zh": "又議遣太尉李固，未及行。"
  },
  {
    "id": "s0469",
    "blockIndex": 110,
    "zh": "三月，撫等進擊眾賊，大破之，斬馬勉、范容、周生等千五百級。"
  },
  {
    "id": "s0469",
    "blockIndex": 110,
    "zh": "徐鳳以餘眾燒東城縣。"
  },
  {
    "id": "s0469",
    "blockIndex": 110,
    "zh": "夏，五月，下邳人謝安應募，率其宗親設伏擊鳳，斬之。"
  },
  {
    "id": "s0469",
    "blockIndex": 110,
    "zh": "封安為平鄉侯。"
  },
  {
    "id": "s0469",
    "blockIndex": 110,
    "zh": "拜滕撫中郎將，督揚、徐二州事。"
  },
  {
    "id": "s0479",
    "blockIndex": 111,
    "zh": "丙辰，詔曰：「孝殤皇帝即位逾年，君臣禮成。"
  },
  {
    "id": "s0479",
    "blockIndex": 111,
    "zh": "孝安皇帝承襲統業，而前世遂令恭陵在康陵之上，先後相逾，失其次序。"
  },
  {
    "id": "s0479",
    "blockIndex": 111,
    "zh": "今其正之！"
  },
  {
    "id": "s0483",
    "blockIndex": 112,
    "zh": "六月，鮮卑寇代郡。"
  },
  {
    "id": "s0484",
    "blockIndex": 113,
    "zh": "秋，廬江盜賊攻尋陽，又攻盱台。"
  },
  {
    "id": "s0484",
    "blockIndex": 113,
    "zh": "滕撫遣司馬王章擊破之。"
  },
  {
    "id": "s0486",
    "blockIndex": 114,
    "zh": "九月，庚戌，太傅趙峻薨。"
  },
  {
    "id": "s0487",
    "blockIndex": 115,
    "zh": "滕撫進擊張嬰；"
  },
  {
    "id": "s0487",
    "blockIndex": 115,
    "zh": "冬，十一月，丙午，破嬰，斬獲千餘人。"
  },
  {
    "id": "s0487",
    "blockIndex": 115,
    "zh": "丁未，中郎將趙序坐畏懦、詐增首級，棄市。"
  },
  {
    "id": "s0490",
    "blockIndex": 116,
    "zh": "歷陽賊華孟自稱黑帝，攻殺九江太守楊岑。"
  },
  {
    "id": "s0490",
    "blockIndex": 116,
    "zh": "滕撫進擊，破之，斬孟等三千八百級，虜獲七百餘人。"
  },
  {
    "id": "s0490",
    "blockIndex": 116,
    "zh": "於是東南悉平，振旅而還。"
  },
  {
    "id": "s0490",
    "blockIndex": 116,
    "zh": "以撫為左馮翊。"
  },
  {
    "id": "s0494",
    "blockIndex": 117,
    "zh": "永昌太守劉君世，鑄黃金為文蛇，以獻大將軍冀；"
  },
  {
    "id": "s0494",
    "blockIndex": 117,
    "zh": "益州刺史種暠糾發逮捕，馳傳上言。"
  },
  {
    "id": "s0494",
    "blockIndex": 117,
    "zh": "冀由是恨暠。"
  },
  {
    "id": "s0494",
    "blockIndex": 117,
    "zh": "會巴郡人服直聚黨數百人，自稱天王，暠與太守應承討捕，不克，吏民多被傷害；"
  },
  {
    "id": "s0494",
    "blockIndex": 117,
    "zh": "冀因此陷之，傳逮暠、承。"
  },
  {
    "id": "s0494",
    "blockIndex": 117,
    "zh": "李固上疏曰：「臣伏聞討捕所傷，本非暠、承之意，實由縣吏懼法畏罪，迫逐深苦，致此不詳。"
  },
  {
    "id": "s0494",
    "blockIndex": 117,
    "zh": "比盜賊群起，處處未絕。"
  },
  {
    "id": "s0494",
    "blockIndex": 117,
    "zh": "暠、承以首舉大奸而相隨受罪，臣恐沮傷州縣糾發之意，更共飾匿，莫復盡心！"
  },
  {
    "id": "s0494",
    "blockIndex": 117,
    "zh": "」太后省奏，乃赦暠、承罪，免官而已。"
  },
  {
    "id": "s0494",
    "blockIndex": 117,
    "zh": "金蛇輸司農，冀從大司農杜喬借觀之，喬不肯與；"
  },
  {
    "id": "s0494",
    "blockIndex": 117,
    "zh": "冀小女死，令公卿會喪，喬獨不往，冀由是銜之。"
  },
  {
    "id": "s0505",
    "blockIndex": 118,
    "zh": "category:資治通鑑"
  }
]
