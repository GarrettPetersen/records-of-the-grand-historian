[
  {
    "id": "s0001",
    "blockIndex": 0,
    "zh": "資治通鑑第031卷"
  },
  {
    "id": "s0002",
    "blockIndex": 1,
    "zh": "【漢紀二十三】起屠維大淵獻，盡強圉協洽，凡九年。"
  },
  {
    "id": "s0003",
    "blockIndex": 2,
    "zh": "春，三月，壬戌，隕石東郡八。"
  },
  {
    "id": "s0004",
    "blockIndex": 3,
    "zh": "夏，六月，穎川鐵官徙申屠聖等百八十人殺長吏，盜庫兵，自稱將軍，經歷九郡。"
  },
  {
    "id": "s0005",
    "blockIndex": 3,
    "zh": "遣丞相長史、御史中丞逐捕，以軍興從事，皆伏辜。"
  },
  {
    "id": "s0006",
    "blockIndex": 4,
    "zh": "秋，王鳳疾，天子數自臨問，親執其手涕泣曰：「將軍病，如有不可言，平阿侯譚次將軍矣！"
  },
  {
    "id": "s0007",
    "blockIndex": 4,
    "zh": "」鳳頓首泣曰：「譚等雖與臣至親，行皆奢僭，無以率導百姓，不如御史大夫音謹敕，臣敢以死保之！"
  },
  {
    "id": "s0008",
    "blockIndex": 4,
    "zh": "」及鳳且死，上疏謝上，復固薦音自代，言譚等五人必不可用；"
  },
  {
    "id": "s0009",
    "blockIndex": 4,
    "zh": "天子然之。"
  },
  {
    "id": "s0010",
    "blockIndex": 4,
    "zh": "初，譚倨，不肯事鳳，而音敬鳳，卑恭如子，故鳳薦之。"
  },
  {
    "id": "s0011",
    "blockIndex": 4,
    "zh": "八月，丁巳，鳳薨。"
  },
  {
    "id": "s0012",
    "blockIndex": 4,
    "zh": "九月，甲子，以王音為大司馬、車騎將軍，而王譚位特進，領城門兵。"
  },
  {
    "id": "s0013",
    "blockIndex": 4,
    "zh": "安定太守谷永以譚失職，勸譚辭讓，不受城門職；"
  },
  {
    "id": "s0014",
    "blockIndex": 4,
    "zh": "由是譚、音相與不平。"
  },
  {
    "id": "s0015",
    "blockIndex": 5,
    "zh": "冬，十一月，丁卯，光祿勳於永為御史大夫。"
  },
  {
    "id": "s0016",
    "blockIndex": 5,
    "zh": "永，定國之子也。"
  },
  {
    "id": "s0017",
    "blockIndex": 6,
    "zh": "春，二月，赦天下。"
  },
  {
    "id": "s0018",
    "blockIndex": 7,
    "zh": "夏，四月，雨雪。"
  },
  {
    "id": "s0019",
    "blockIndex": 8,
    "zh": "秋，九月，壬申，東平思王宇薨。"
  },
  {
    "id": "s0020",
    "blockIndex": 9,
    "zh": "少府王駿為京兆尹。"
  },
  {
    "id": "s0021",
    "blockIndex": 9,
    "zh": "駿，吉之子也。"
  },
  {
    "id": "s0022",
    "blockIndex": 9,
    "zh": "先是，京兆有趙廣漢、張敞、王尊、王章、王駿，皆有能名，故京師稱曰：「前有趙、張，後有三王。"
  },
  {
    "id": "s0024",
    "blockIndex": 10,
    "zh": "閏月，壬戌，於永卒。"
  },
  {
    "id": "s0025",
    "blockIndex": 11,
    "zh": "烏孫小昆彌烏就屠死，子拊離代立；"
  },
  {
    "id": "s0026",
    "blockIndex": 11,
    "zh": "為弟日貳所殺。"
  },
  {
    "id": "s0027",
    "blockIndex": 11,
    "zh": "漢遣使者立拊離子安日為小昆彌。"
  },
  {
    "id": "s0028",
    "blockIndex": 11,
    "zh": "日貳亡阻康居；"
  },
  {
    "id": "s0029",
    "blockIndex": 11,
    "zh": "安日使貴人姑莫匿等三人詐亡從日貳，刺殺之。"
  },
  {
    "id": "s0030",
    "blockIndex": 11,
    "zh": "於是西域諸國上書，願復得前都護段會宗；"
  },
  {
    "id": "s0031",
    "blockIndex": 11,
    "zh": "上從之。"
  },
  {
    "id": "s0032",
    "blockIndex": 11,
    "zh": "城郭諸國聞之，皆翕然親附。"
  },
  {
    "id": "s0033",
    "blockIndex": 12,
    "zh": "谷永奏言：「聖王不以名譽加於實效；"
  },
  {
    "id": "s0034",
    "blockIndex": 12,
    "zh": "御史大夫任重職大，少府宣達於從政，唯陛下留神考察！"
  },
  {
    "id": "s0035",
    "blockIndex": 12,
    "zh": "」上然之。"
  },
  {
    "id": "s0036",
    "blockIndex": 13,
    "zh": "春，正月，癸巳，以薛宣為御史大夫。"
  },
  {
    "id": "s0037",
    "blockIndex": 14,
    "zh": "二月，壬午，上行幸初陵，赦作徒；"
  },
  {
    "id": "s0038",
    "blockIndex": 14,
    "zh": "以新豐戲鄉為昌陵縣，奉初陵。"
  },
  {
    "id": "s0039",
    "blockIndex": 15,
    "zh": "上始為微行，從期門郎或私奴十餘人，或乘小車，或皆騎，出入市裡郊野，遠至旁縣甘泉、長楊、五柞，鬥雞、走馬，常自稱富平侯家人。"
  },
  {
    "id": "s0040",
    "blockIndex": 15,
    "zh": "富平侯者，張安世四世孫放也。"
  },
  {
    "id": "s0041",
    "blockIndex": 15,
    "zh": "放父臨，尚敬武公主，生放，放為侍中、中郎將，娶許皇后女弟，當時寵幸無比，故假稱之。"
  },
  {
    "id": "s0042",
    "blockIndex": 16,
    "zh": "三月，庚戌，張禹以老病罷，以列侯朝朔、望，位特進，見禮如丞相，賞賜前後數千萬。"
  },
  {
    "id": "s0043",
    "blockIndex": 17,
    "zh": "夏，四月，庚辰，薛宣為丞相，封高陽侯；"
  },
  {
    "id": "s0044",
    "blockIndex": 17,
    "zh": "京兆尹王駿為御史大夫。"
  },
  {
    "id": "s0045",
    "blockIndex": 18,
    "zh": "王音既以從舅越親用事，小心親職。"
  },
  {
    "id": "s0046",
    "blockIndex": 18,
    "zh": "上以音自御史大夫入為將軍，不獲宰相之封，六月，乙巳，封音為安陽侯。"
  },
  {
    "id": "s0047",
    "blockIndex": 19,
    "zh": "冬，黃龍見真定。"
  },
  {
    "id": "s0048",
    "blockIndex": 20,
    "zh": "是歲，匈奴復株累單于死，弟且糜胥立，為搜諧若鞮單于；"
  },
  {
    "id": "s0049",
    "blockIndex": 20,
    "zh": "遣子左祝都韓王呴留斯侯入侍，以且莫車為左賢王。"
  },
  {
    "id": "s0050",
    "blockIndex": 21,
    "zh": "春，上行幸雲陽、甘泉。"
  },
  {
    "id": "s0051",
    "blockIndex": 22,
    "zh": "三月，博士行大射禮。"
  },
  {
    "id": "s0052",
    "blockIndex": 22,
    "zh": "有飛雉集於庭，歷階登堂而雊；"
  },
  {
    "id": "s0053",
    "blockIndex": 22,
    "zh": "後雉又集太常、宗正、丞相、御史大夫、車騎將軍之府，又集未央宮承明殿屋上。"
  },
  {
    "id": "s0054",
    "blockIndex": 22,
    "zh": "車騎將軍音、待詔寵等上言：「天地之氣，以類相應；"
  },
  {
    "id": "s0055",
    "blockIndex": 22,
    "zh": "譴告人君，甚微而著。"
  },
  {
    "id": "s0056",
    "blockIndex": 22,
    "zh": "雉者聽察，先聞雷聲，故《月令》以紀氣。"
  },
  {
    "id": "s0057",
    "blockIndex": 22,
    "zh": "《經》載高宗雊雉之異，以明轉禍為福之驗。"
  },
  {
    "id": "s0058",
    "blockIndex": 22,
    "zh": "今雉以博士行禮之日大眾聚會，飛集於庭，歷階登堂，萬眾睢睢，驚怪連日，逕歷三公之府，太常、宗正典宗廟骨肉之官，然後入宮，其宿留告曉人，具備深切；"
  },
  {
    "id": "s0059",
    "blockIndex": 22,
    "zh": "雖人道相戒，何以過是！"
  },
  {
    "id": "s0060",
    "blockIndex": 22,
    "zh": "」後帝使中常侍晁閎詔音曰：「聞捕得雉，毛羽頗摧折，類拘執者，得無人為之？"
  },
  {
    "id": "s0061",
    "blockIndex": 22,
    "zh": "」音復對曰：「陛下安得亡國之語！"
  },
  {
    "id": "s0062",
    "blockIndex": 22,
    "zh": "不知誰主為佞諂之計，誣亂聖德如此者！"
  },
  {
    "id": "s0063",
    "blockIndex": 22,
    "zh": "左右阿諛甚眾，不待臣音復諂而足。"
  },
  {
    "id": "s0064",
    "blockIndex": 22,
    "zh": "公卿以下，保位自守，莫有正言。"
  },
  {
    "id": "s0065",
    "blockIndex": 22,
    "zh": "如令陛下覺寤，懼大禍且至身，深責臣下，繩以聖法，臣音當先誅，豈有以自解哉！"
  },
  {
    "id": "s0066",
    "blockIndex": 22,
    "zh": "今即位十五年，繼嗣不立，日日駕車而出，失行流聞；"
  },
  {
    "id": "s0067",
    "blockIndex": 22,
    "zh": "海內傳之，甚於京師。"
  },
  {
    "id": "s0068",
    "blockIndex": 22,
    "zh": "外有微行之害，內有疾病之憂，皇天數見災異，欲人變更，終已不改。"
  },
  {
    "id": "s0069",
    "blockIndex": 22,
    "zh": "天尚不能感動陛下，臣子何望！"
  },
  {
    "id": "s0070",
    "blockIndex": 22,
    "zh": "獨有極言待死，命在朝暮而已。"
  },
  {
    "id": "s0071",
    "blockIndex": 22,
    "zh": "如有不然，老母安得處所，尚何皇太后之有！"
  },
  {
    "id": "s0072",
    "blockIndex": 22,
    "zh": "高祖天下當以誰屬乎！"
  },
  {
    "id": "s0073",
    "blockIndex": 22,
    "zh": "宜謀於賢智，克己復禮，以求天意，繼嗣可立，災變尚可銷也。"
  },
  {
    "id": "s0075",
    "blockIndex": 23,
    "zh": "初，元帝儉約，渭陵不復徙民起邑；"
  },
  {
    "id": "s0076",
    "blockIndex": 23,
    "zh": "帝起初陵，數年後，樂霸陵曲亭南，更營之。"
  },
  {
    "id": "s0077",
    "blockIndex": 23,
    "zh": "將作大匠解萬年使陳湯為奏，請為初陵徙民起邑，欲自以為功，求重賞。"
  },
  {
    "id": "s0078",
    "blockIndex": 23,
    "zh": "湯因自請先徙，冀得美田宅。"
  },
  {
    "id": "s0079",
    "blockIndex": 23,
    "zh": "上從其言，果起昌陵邑。"
  },
  {
    "id": "s0080",
    "blockIndex": 24,
    "zh": "夏，徙郡國豪桀貲五百萬以上五千戶於昌陵。"
  },
  {
    "id": "s0081",
    "blockIndex": 25,
    "zh": "五月，癸未，隕石於杜郵三。"
  },
  {
    "id": "s0082",
    "blockIndex": 26,
    "zh": "六月，立中山憲王孫雲客為廣德王。"
  },
  {
    "id": "s0083",
    "blockIndex": 27,
    "zh": "是歲，城陽哀王雲薨；"
  },
  {
    "id": "s0084",
    "blockIndex": 27,
    "zh": "無子，國除。"
  },
  {
    "id": "s0085",
    "blockIndex": 28,
    "zh": "夏，四月，赦天下。"
  },
  {
    "id": "s0086",
    "blockIndex": 29,
    "zh": "大旱。"
  },
  {
    "id": "s0087",
    "blockIndex": 30,
    "zh": "王氏五侯爭以奢侈相尚。"
  },
  {
    "id": "s0088",
    "blockIndex": 30,
    "zh": "成都侯商嘗病，欲避暑，從上借明光宮。"
  },
  {
    "id": "s0089",
    "blockIndex": 30,
    "zh": "後又穿長安城，引內灃水，注第中大陂以行船，立羽蓋，張周帷，楫棹越歌。"
  },
  {
    "id": "s0090",
    "blockIndex": 30,
    "zh": "上幸商第，見穿城引水，意恨，內銜之，未言；"
  },
  {
    "id": "s0091",
    "blockIndex": 30,
    "zh": "後微行出，過曲陽侯第，又見園中土山、漸台，像白虎殿。"
  },
  {
    "id": "s0092",
    "blockIndex": 30,
    "zh": "於是上怒，以讓車騎將軍音。"
  },
  {
    "id": "s0093",
    "blockIndex": 30,
    "zh": "商、根兄弟欲自黥、劓以謝太后。"
  },
  {
    "id": "s0094",
    "blockIndex": 30,
    "zh": "上聞之，大怒，乃使尚書責問司隸校尉、京兆尹，知成都侯商等奢僭不軌，藏匿奸猾，皆阿縱，不舉奏正法；"
  },
  {
    "id": "s0095",
    "blockIndex": 30,
    "zh": "二人頓首省戶下。"
  },
  {
    "id": "s0096",
    "blockIndex": 30,
    "zh": "又賜車騎將軍音策書曰：「外家何甘樂禍敗！"
  },
  {
    "id": "s0097",
    "blockIndex": 30,
    "zh": "而欲自黥、劓，相戮辱於太后前，傷慈母之心，以危亂國家！"
  },
  {
    "id": "s0098",
    "blockIndex": 30,
    "zh": "外家宗族強，上一身浸弱日久，今將一施之，君其召諸侯，令待府捨！"
  },
  {
    "id": "s0099",
    "blockIndex": 30,
    "zh": "」是日，詔尚書奏文帝時誅將軍薄昭故事。"
  },
  {
    "id": "s0100",
    "blockIndex": 30,
    "zh": "車騎將軍音藉稿請罪，商、立、根皆負斧質謝，良久乃已。"
  },
  {
    "id": "s0101",
    "blockIndex": 30,
    "zh": "上特欲恐之，實無意誅也。"
  },
  {
    "id": "s0102",
    "blockIndex": 31,
    "zh": "秋，八月，乙卯，孝景廟北闕災。"
  },
  {
    "id": "s0103",
    "blockIndex": 32,
    "zh": "初，許皇后與班婕妤皆有寵於上。"
  },
  {
    "id": "s0104",
    "blockIndex": 32,
    "zh": "上嘗游後庭，欲與婕妤同輦載，婕妤辭曰：「觀古圖畫，賢聖之君皆有名臣在側，三代末主乃有嬖妾。"
  },
  {
    "id": "s0105",
    "blockIndex": 32,
    "zh": "今欲同輦，得無近似之乎！"
  },
  {
    "id": "s0106",
    "blockIndex": 32,
    "zh": "」上善其言而止。"
  },
  {
    "id": "s0107",
    "blockIndex": 32,
    "zh": "太后聞之，喜曰：「古有樊姬，今有班婕妤！"
  },
  {
    "id": "s0108",
    "blockIndex": 32,
    "zh": "」班婕妤進侍者李平得幸，亦為婕妤，賜姓曰衛。"
  },
  {
    "id": "s0109",
    "blockIndex": 32,
    "zh": "其後，上微行過陽阿主家，悅歌舞者趙飛燕，召入宮，大幸；"
  },
  {
    "id": "s0110",
    "blockIndex": 32,
    "zh": "有女弟，復召入，姿性尤醲粹，左右見之，皆嘖嘖嗟賞。"
  },
  {
    "id": "s0111",
    "blockIndex": 32,
    "zh": "有宣帝時披香博士淖方成在帝后，唾曰：「此禍水也，滅火必矣！"
  },
  {
    "id": "s0112",
    "blockIndex": 32,
    "zh": "」姊、弟俱為婕妤，貴傾後宮。"
  },
  {
    "id": "s0113",
    "blockIndex": 32,
    "zh": "許皇后、班婕妤皆失寵。"
  },
  {
    "id": "s0114",
    "blockIndex": 32,
    "zh": "於是趙飛燕譖告許皇后、班婕妤挾媚道，祝詛後宮，詈及主上。"
  },
  {
    "id": "s0115",
    "blockIndex": 32,
    "zh": "冬，十一月，甲寅，許後廢處昭台宮，後姊謁等皆誅死，親屬歸故郡。"
  },
  {
    "id": "s0116",
    "blockIndex": 32,
    "zh": "考問班婕妤，婕妤對曰：「妾聞『死生有命，富貴在天。"
  },
  {
    "id": "s0117",
    "blockIndex": 32,
    "zh": "』修正尚未蒙福，為邪欲以何望！"
  },
  {
    "id": "s0118",
    "blockIndex": 32,
    "zh": "使鬼神有知，不受不臣之訴；"
  },
  {
    "id": "s0119",
    "blockIndex": 32,
    "zh": "如其無知，訴之何益！"
  },
  {
    "id": "s0120",
    "blockIndex": 32,
    "zh": "故不為也。"
  },
  {
    "id": "s0121",
    "blockIndex": 32,
    "zh": "」上善其對，赦之，賜黃金百斤。"
  },
  {
    "id": "s0122",
    "blockIndex": 32,
    "zh": "趙氏姊、弟驕妒，婕妤恐久見危，乃求共養太后於長信宮。"
  },
  {
    "id": "s0123",
    "blockIndex": 32,
    "zh": "上許焉。"
  },
  {
    "id": "s0124",
    "blockIndex": 33,
    "zh": "廣漢男子鄭躬等六十餘人攻官寺，篡囚徒，盜庫兵；"
  },
  {
    "id": "s0125",
    "blockIndex": 33,
    "zh": "自稱山君。"
  },
  {
    "id": "s0126",
    "blockIndex": 34,
    "zh": "秋，勃海、清河、信都河水湓溢，灌縣、邑三十一，敗官亭、民捨四萬餘所。"
  },
  {
    "id": "s0127",
    "blockIndex": 34,
    "zh": "平陵李尋等奏言：「議者常欲求索九河故跡而穿之。"
  },
  {
    "id": "s0128",
    "blockIndex": 34,
    "zh": "今因其自決，可且勿塞，以觀水勢；"
  },
  {
    "id": "s0129",
    "blockIndex": 34,
    "zh": "河欲居之，當稍自成川，跳出沙土。"
  },
  {
    "id": "s0130",
    "blockIndex": 34,
    "zh": "然後順天心而圖之，必有成功，而用財力寡。"
  },
  {
    "id": "s0131",
    "blockIndex": 34,
    "zh": "」於是遂止不塞。"
  },
  {
    "id": "s0132",
    "blockIndex": 34,
    "zh": "朝臣數言百姓可哀，上遣使者處業振贍之。"
  },
  {
    "id": "s0133",
    "blockIndex": 35,
    "zh": "廣漢鄭躬等黨與浸廣，犯歷四縣，眾且萬人；"
  },
  {
    "id": "s0134",
    "blockIndex": 35,
    "zh": "州郡不能制。"
  },
  {
    "id": "s0135",
    "blockIndex": 35,
    "zh": "冬，以河東都尉趙護為廣漢太守，發郡中及蜀郡合三萬人擊之，或相捕斬除罪；"
  },
  {
    "id": "s0136",
    "blockIndex": 35,
    "zh": "旬月平。"
  },
  {
    "id": "s0137",
    "blockIndex": 35,
    "zh": "遷護為執金吾，賜黃金百斤。"
  },
  {
    "id": "s0138",
    "blockIndex": 36,
    "zh": "是歲，平阿安侯王譚薨。"
  },
  {
    "id": "s0139",
    "blockIndex": 36,
    "zh": "上悔廢譚使不輔政而薨也，乃復成都侯商以特進領城門兵，置幕府，得舉吏如將軍。"
  },
  {
    "id": "s0140",
    "blockIndex": 36,
    "zh": "魏郡杜鄴時為郎，素善車騎將軍音，見音前與平阿侯有隙，即說音曰：「夫戚而不見殊，孰能無怨！"
  },
  {
    "id": "s0141",
    "blockIndex": 36,
    "zh": "昔秦伯有千乘之國而不能容其母弟，《春秋》譏焉。"
  },
  {
    "id": "s0142",
    "blockIndex": 36,
    "zh": "周、召則不然，忠以相輔，義以相匡，同己之親，等己之尊，不以聖德獨兼國寵，又不為長專受榮任，分職於陝，並為弼疑，故內無感恨之隙，外無侵侮之羞，俱享天祐，兩荷高名者，蓋以此也。"
  },
  {
    "id": "s0143",
    "blockIndex": 36,
    "zh": "竊見成都侯以特進領城門兵，復有詔得舉吏如五府，此明詔所欲寵也。"
  },
  {
    "id": "s0144",
    "blockIndex": 36,
    "zh": "將軍宜承順聖意，加異往時，每事凡議，必與及之。"
  },
  {
    "id": "s0145",
    "blockIndex": 36,
    "zh": "發於至誠，則孰不說諭！"
  },
  {
    "id": "s0146",
    "blockIndex": 36,
    "zh": "」音甚嘉其言，由是與成都侯商親密。"
  },
  {
    "id": "s0147",
    "blockIndex": 36,
    "zh": "二人皆重鄴。"
  },
  {
    "id": "s0148",
    "blockIndex": 37,
    "zh": "春，正月，癸丑，太官凌室火。"
  },
  {
    "id": "s0149",
    "blockIndex": 37,
    "zh": "戊午，戾後園南闕火。"
  },
  {
    "id": "s0150",
    "blockIndex": 38,
    "zh": "上欲立趙婕妤為皇后，皇太后嫌其所出微甚，難之。"
  },
  {
    "id": "s0151",
    "blockIndex": 38,
    "zh": "太后姊子淳于長為侍中，數往來通語東宮；"
  },
  {
    "id": "s0152",
    "blockIndex": 38,
    "zh": "歲餘，乃得太后指，許之。"
  },
  {
    "id": "s0153",
    "blockIndex": 38,
    "zh": "夏，四月，乙亥，上先封婕妤父臨為成陽侯。"
  },
  {
    "id": "s0154",
    "blockIndex": 38,
    "zh": "諫大夫河間劉輔上書，言：「昔武王、周公，承順天地以饗魚、鳥之瑞，然猶君臣示氐懼，動色相戒。"
  },
  {
    "id": "s0155",
    "blockIndex": 38,
    "zh": "況於季世，不蒙繼嗣之福，屢受威怒之異者虖！"
  },
  {
    "id": "s0156",
    "blockIndex": 38,
    "zh": "雖夙夜自責，改過易行，畏天命，念祖業，妙選有德之世，考卜窈窕之女，以承宗廟，順神祇心，塞天下望，子孫之祥猶恐晚暮！"
  },
  {
    "id": "s0157",
    "blockIndex": 38,
    "zh": "今乃觸情縱欲，傾於卑賤之女，欲以母天下，不畏於天，不愧於人，惑莫大焉！"
  },
  {
    "id": "s0158",
    "blockIndex": 38,
    "zh": "裡語曰：『腐木不可以為柱；"
  },
  {
    "id": "s0159",
    "blockIndex": 38,
    "zh": "人婢不可以為主。"
  },
  {
    "id": "s0160",
    "blockIndex": 38,
    "zh": "』天人之所不予，必有禍而無福，市道皆共知之，朝廷莫肯壹言。"
  },
  {
    "id": "s0161",
    "blockIndex": 38,
    "zh": "臣竊傷心，不敢不盡死！"
  },
  {
    "id": "s0162",
    "blockIndex": 38,
    "zh": "」書奏，上使侍御史收縛輔，繫掖庭秘獄，群臣莫知其故。"
  },
  {
    "id": "s0163",
    "blockIndex": 38,
    "zh": "於是左將軍辛慶忌、右將軍廉褒、光祿勳琅邪師丹、太中大夫谷永俱上書曰：「竊見劉輔前以縣令求見，擢為諫大夫，此其言必有卓詭切至當聖心者，故得拔至於此；"
  },
  {
    "id": "s0164",
    "blockIndex": 38,
    "zh": "旬月之間，收下秘獄。"
  },
  {
    "id": "s0165",
    "blockIndex": 38,
    "zh": "臣等愚以為輔幸得托公族之親，在諫臣之列，新從下土來，未知朝廷體，獨觸忌諱，不足深過。"
  },
  {
    "id": "s0166",
    "blockIndex": 38,
    "zh": "小罪宜隱忍而已，如有大惡，宜暴治理官，與眾共之。"
  },
  {
    "id": "s0167",
    "blockIndex": 38,
    "zh": "今天心未豫，災異屢降，水旱迭臻，方當隆寬廣問，褒直盡下之時也，而行慘急之誅於諫爭之臣，震驚群下，失忠直心。"
  },
  {
    "id": "s0168",
    "blockIndex": 38,
    "zh": "假令輔不坐直言，所坐不著，天下不可戶曉。"
  },
  {
    "id": "s0169",
    "blockIndex": 38,
    "zh": "同姓近臣，本以言顯，其於治親養忠之義，誠不宜幽囚於掖庭獄。"
  },
  {
    "id": "s0170",
    "blockIndex": 38,
    "zh": "公卿以下，見陛下進用輔亟而折傷之暴，人有懼心，精銳銷耎，莫敢盡節正言，非所以昭有虞之聽，廣德美之風！"
  },
  {
    "id": "s0171",
    "blockIndex": 38,
    "zh": "臣等竊深傷之，惟陛下留神省察！"
  },
  {
    "id": "s0172",
    "blockIndex": 38,
    "zh": "」上乃徙繫輔共工獄，減死罪一等，論為鬼薪。"
  },
  {
    "id": "s0173",
    "blockIndex": 39,
    "zh": "初，太后兄弟八人，獨弟曼早死，不侯；"
  },
  {
    "id": "s0174",
    "blockIndex": 39,
    "zh": "太后憐之。"
  },
  {
    "id": "s0175",
    "blockIndex": 39,
    "zh": "曼寡婦渠供養東宮，子莽幼孤，不及等比，其群兄弟皆將軍、五侯子，乘時侈靡，以輿馬聲色佚游相高。"
  },
  {
    "id": "s0176",
    "blockIndex": 39,
    "zh": "莽因折節為恭儉，勤身博學，被服如儒生；"
  },
  {
    "id": "s0177",
    "blockIndex": 39,
    "zh": "事母及寡嫂，養孤兄子，行甚敕備；"
  },
  {
    "id": "s0178",
    "blockIndex": 39,
    "zh": "又外交英俊，內事諸父，曲有禮意。"
  },
  {
    "id": "s0179",
    "blockIndex": 39,
    "zh": "大將軍鳳病，莽侍疾，親嘗藥，亂首垢面，不解衣帶連月。"
  },
  {
    "id": "s0180",
    "blockIndex": 39,
    "zh": "鳳且死，以托太后及帝，拜為黃門郎，遷射聲校尉。"
  },
  {
    "id": "s0181",
    "blockIndex": 39,
    "zh": "久之，叔父成都侯商上書，願分戶邑以封莽。"
  },
  {
    "id": "s0182",
    "blockIndex": 39,
    "zh": "長樂少府戴崇、侍中金涉、中郎陳湯等皆當世名士，咸為莽言，上由是賢莽，太后又數以為言。"
  },
  {
    "id": "s0183",
    "blockIndex": 39,
    "zh": "五月，乙未，封莽為新都侯，遷騎都尉、光祿大夫、侍中。"
  },
  {
    "id": "s0184",
    "blockIndex": 39,
    "zh": "宿衛謹敕，爵位益尊，節操愈謙，散輿馬、衣裘振施賓客，家無所餘；"
  },
  {
    "id": "s0185",
    "blockIndex": 39,
    "zh": "收贍名士，交結將、相、卿、大夫甚眾。"
  },
  {
    "id": "s0186",
    "blockIndex": 39,
    "zh": "故在位更推薦之，游者為之談說，虛譽隆洽，傾其諸父矣。"
  },
  {
    "id": "s0187",
    "blockIndex": 39,
    "zh": "敢為激發之行，處之不漸恧。"
  },
  {
    "id": "s0188",
    "blockIndex": 39,
    "zh": "嘗私買侍婢，昆弟或頗聞知，莽因曰：「後將軍朱子元無子，莽聞此兒種宜子，為買之」。"
  },
  {
    "id": "s0189",
    "blockIndex": 39,
    "zh": "即日以婢奉朱博。"
  },
  {
    "id": "s0190",
    "blockIndex": 39,
    "zh": "其匿情求名如此！"
  },
  {
    "id": "s0191",
    "blockIndex": 40,
    "zh": "六月，丙寅，立皇后趙氏，大赦天下。"
  },
  {
    "id": "s0192",
    "blockIndex": 40,
    "zh": "皇后既立，寵少衰。"
  },
  {
    "id": "s0193",
    "blockIndex": 40,
    "zh": "而其女弟絕幸，為昭儀，居昭陽捨，其中庭彤朱而殿上髹漆；"
  },
  {
    "id": "s0194",
    "blockIndex": 40,
    "zh": "切皆銅沓，黃金塗；"
  },
  {
    "id": "s0195",
    "blockIndex": 40,
    "zh": "白玉階；"
  },
  {
    "id": "s0196",
    "blockIndex": 40,
    "zh": "壁帶往往為黃金釭，函藍田璧、明珠、翠羽飾之。"
  },
  {
    "id": "s0197",
    "blockIndex": 40,
    "zh": "自後宮未嘗有焉。"
  },
  {
    "id": "s0198",
    "blockIndex": 40,
    "zh": "趙後居別館，多通侍郎、宮奴多子者。"
  },
  {
    "id": "s0199",
    "blockIndex": 40,
    "zh": "昭儀嘗謂帝曰：「妾姊性剛，有如為人構陷，則趙氏無種矣！"
  },
  {
    "id": "s0200",
    "blockIndex": 40,
    "zh": "」因泣下心妻惻。"
  },
  {
    "id": "s0201",
    "blockIndex": 40,
    "zh": "帝信之，有白後奸狀者，帝輒殺之。"
  },
  {
    "id": "s0202",
    "blockIndex": 40,
    "zh": "由是後公為淫恣，無敢言者，然卒無子。"
  },
  {
    "id": "s0203",
    "blockIndex": 41,
    "zh": "光祿大夫劉向以為王教由內及外，自近者始，於是採取《詩》、《書》所載賢妃、貞婦興國顯家及孽、嬖亂亡者，序次為《列女傳》，凡八篇，及采傳記行事，著《新序》、《說苑》，凡五十篇，奏之，數上疏言得失，陳法戒。"
  },
  {
    "id": "s0204",
    "blockIndex": 41,
    "zh": "書數十上，以助觀覽，補遺闕。"
  },
  {
    "id": "s0205",
    "blockIndex": 41,
    "zh": "上雖不能盡用，然內嘉其言，常嗟歎之。"
  },
  {
    "id": "s0206",
    "blockIndex": 42,
    "zh": "昌陵制度奢泰，久而不成。"
  },
  {
    "id": "s0207",
    "blockIndex": 42,
    "zh": "劉向上疏曰：「臣聞王者必通三統，明天命所授者博，非獨一姓也。"
  },
  {
    "id": "s0208",
    "blockIndex": 42,
    "zh": "自古及今，未有不亡之國。"
  },
  {
    "id": "s0209",
    "blockIndex": 42,
    "zh": "孝文皇帝嘗美石槨之固，張釋之曰：『使其中有可欲，雖錮南山猶有隙。"
  },
  {
    "id": "s0210",
    "blockIndex": 42,
    "zh": "』夫死者無終極，而國家有廢興，故釋之之言為無窮計也。"
  },
  {
    "id": "s0211",
    "blockIndex": 42,
    "zh": "孝文寤焉，遂薄葬。"
  },
  {
    "id": "s0212",
    "blockIndex": 42,
    "zh": "棺槨之作，自黃帝始。"
  },
  {
    "id": "s0213",
    "blockIndex": 42,
    "zh": "黃帝、堯、舜、禹、湯、文、武、周公，丘□皆小，葬具甚微；"
  },
  {
    "id": "s0214",
    "blockIndex": 42,
    "zh": "其賢臣孝子亦承命順意而薄葬之。"
  },
  {
    "id": "s0215",
    "blockIndex": 42,
    "zh": "此誠奉安君父忠孝之至也。"
  },
  {
    "id": "s0216",
    "blockIndex": 42,
    "zh": "孔子葬母於防，墳四尺。"
  },
  {
    "id": "s0217",
    "blockIndex": 42,
    "zh": "延陵季子葬其子，封墳掩坎，其高可隱。"
  },
  {
    "id": "s0218",
    "blockIndex": 42,
    "zh": "故仲尼孝子而延陵慈父，舜、禹忠臣，周公弟弟，其葬君、親、骨肉皆微薄矣。"
  },
  {
    "id": "s0219",
    "blockIndex": 42,
    "zh": "非苟為儉，誠便於體也。"
  },
  {
    "id": "s0220",
    "blockIndex": 42,
    "zh": "秦始皇帝葬於驪山之阿，下錮三泉，上崇山墳，水銀為江、海，黃金為鳧、雁，珍寶之臧，機械之變，棺槨之麗，宮館之盛，不可勝原。"
  },
  {
    "id": "s0221",
    "blockIndex": 42,
    "zh": "天下苦其役而反之，驪山之作未成，而周章百萬之師至其下矣。"
  },
  {
    "id": "s0222",
    "blockIndex": 42,
    "zh": "項籍燔其宮室、營宇，牧兒持火照求亡羊，失火燒其臧槨。"
  },
  {
    "id": "s0223",
    "blockIndex": 42,
    "zh": "自古至今，葬未有盛如始皇者也。"
  },
  {
    "id": "s0224",
    "blockIndex": 42,
    "zh": "數年之間，外被項籍之災，內離牧豎之禍，豈不哀哉！"
  },
  {
    "id": "s0225",
    "blockIndex": 42,
    "zh": "是故德彌厚者葬彌薄，知愈深者葬愈微。"
  },
  {
    "id": "s0226",
    "blockIndex": 42,
    "zh": "無德寡知，其葬愈厚。"
  },
  {
    "id": "s0227",
    "blockIndex": 42,
    "zh": "丘隴彌高，宮廟甚麗，發掘必速。"
  },
  {
    "id": "s0228",
    "blockIndex": 42,
    "zh": "由是觀之，明暗之效，葬之吉凶，昭然可見矣。"
  },
  {
    "id": "s0229",
    "blockIndex": 42,
    "zh": "陛下即位，躬親節儉，始營初陵，其制約小，天下莫不稱賢明；"
  },
  {
    "id": "s0230",
    "blockIndex": 42,
    "zh": "及徙昌陵，增卑為高，積土為山，發民墳墓，積以萬數，營起邑居，期日迫卒，功費大萬百餘，死者恨於下，生者愁於上，臣甚愍焉！"
  },
  {
    "id": "s0231",
    "blockIndex": 42,
    "zh": "以死者為有知，發人之墓，其害多矣；"
  },
  {
    "id": "s0232",
    "blockIndex": 42,
    "zh": "若其無知，又安用大！"
  },
  {
    "id": "s0233",
    "blockIndex": 42,
    "zh": "謀之賢知則不說，以示眾庶則苦之，若苟以說愚夫淫侈之人，又何為哉！"
  },
  {
    "id": "s0234",
    "blockIndex": 42,
    "zh": "唯陛下上覽明聖之制以為則，下觀亡秦之禍以為戒，初陵之模，宜從公卿大臣之議，以息眾庶！"
  },
  {
    "id": "s0235",
    "blockIndex": 42,
    "zh": "」上感其言。"
  },
  {
    "id": "s0236",
    "blockIndex": 43,
    "zh": "初，解萬年自詭昌陵三年可成，卒不能就；"
  },
  {
    "id": "s0237",
    "blockIndex": 43,
    "zh": "群臣多言其不便者。"
  },
  {
    "id": "s0238",
    "blockIndex": 43,
    "zh": "下有司議，皆曰：「昌陵因卑為高，度便房猶在平地上；"
  },
  {
    "id": "s0239",
    "blockIndex": 43,
    "zh": "客土之中，不保幽冥之靈，淺外不固。"
  },
  {
    "id": "s0240",
    "blockIndex": 43,
    "zh": "卒徒工庸以巨萬數，至然脂火夜作，取土東山，且與谷同賈，作治數年，天下遍被其勞。"
  },
  {
    "id": "s0241",
    "blockIndex": 43,
    "zh": "故陵因天性，據真土，處勢高敞，旁近祖考，前又已有十年功緒，宜還復故陵，勿徙民，便！"
  },
  {
    "id": "s0242",
    "blockIndex": 43,
    "zh": "」秋，七月，詔曰：「朕執德不固，謀不盡下，過聽將作大匠萬年言『昌陵三年可成』，作治五年，中陵、司馬殿門內尚未加功。"
  },
  {
    "id": "s0243",
    "blockIndex": 43,
    "zh": "天下虛耗，百姓罷勞，客土疏惡，終不可成，朕惟其難，怛然傷心。"
  },
  {
    "id": "s0244",
    "blockIndex": 43,
    "zh": "夫『過而不改，是謂過矣』。"
  },
  {
    "id": "s0245",
    "blockIndex": 43,
    "zh": "其罷昌陵，及故陵勿徙吏民，令天下毋有動搖之心。"
  },
  {
    "id": "s0247",
    "blockIndex": 44,
    "zh": "初，酇侯蕭何之子孫嗣為侯者，無子及有罪，凡五絕祀。"
  },
  {
    "id": "s0248",
    "blockIndex": 44,
    "zh": "高後、文帝、景帝、武帝、宣帝思何之功，輒以其支庶紹封。"
  },
  {
    "id": "s0249",
    "blockIndex": 44,
    "zh": "是歲，何七世孫酇侯獲坐使奴殺人，減死，完為城旦。"
  },
  {
    "id": "s0250",
    "blockIndex": 44,
    "zh": "先是，上詔有司訪求漢初功臣之後，久未省錄。"
  },
  {
    "id": "s0251",
    "blockIndex": 44,
    "zh": "杜業說上曰：「唐、虞、三代皆封建諸侯，以成太平之美，是以燕、齊之祀與周並傳，子繼弟及，歷載不墮。"
  },
  {
    "id": "s0252",
    "blockIndex": 44,
    "zh": "豈無刑辟、繇祖之竭力，故支庶賴焉。"
  },
  {
    "id": "s0253",
    "blockIndex": 44,
    "zh": "跡漢功臣，亦皆割符世爵，受山河之誓；"
  },
  {
    "id": "s0254",
    "blockIndex": 44,
    "zh": "百餘年間，而襲封者盡，朽骨孤於墓，苗裔流於道，生為愍隸，死為轉屍。"
  },
  {
    "id": "s0255",
    "blockIndex": 44,
    "zh": "以往況今，甚可悲傷。"
  },
  {
    "id": "s0256",
    "blockIndex": 44,
    "zh": "聖朝憐閔，詔求其後，四方忻忻，靡不歸心。"
  },
  {
    "id": "s0257",
    "blockIndex": 44,
    "zh": "出入數年而不省察，恐議者不思大義，徒設虛言，則厚德掩息，吝簡布章，非所以示化勸後也。"
  },
  {
    "id": "s0258",
    "blockIndex": 44,
    "zh": "雖難盡繼，宜從尤功。"
  },
  {
    "id": "s0259",
    "blockIndex": 44,
    "zh": "」上納其言。"
  },
  {
    "id": "s0260",
    "blockIndex": 44,
    "zh": "癸卯，封蕭何六世孫南□長喜為酇侯。"
  },
  {
    "id": "s0261",
    "blockIndex": 45,
    "zh": "立城陽哀王弟俚為王。"
  },
  {
    "id": "s0262",
    "blockIndex": 46,
    "zh": "八月，丁丑，太皇太后王氏崩。"
  },
  {
    "id": "s0263",
    "blockIndex": 47,
    "zh": "九月，黑龍見東萊。"
  },
  {
    "id": "s0264",
    "blockIndex": 48,
    "zh": "丁巳晦，日有食之。"
  },
  {
    "id": "s0265",
    "blockIndex": 49,
    "zh": "是歲，以南陽太守陳咸為少府，侍中淳于長為水衡都尉。"
  },
  {
    "id": "s0266",
    "blockIndex": 50,
    "zh": "春，正月，己丑，安陽敬侯王音薨。"
  },
  {
    "id": "s0267",
    "blockIndex": 50,
    "zh": "王氏唯音為修整，數諫正，有忠直節。"
  },
  {
    "id": "s0268",
    "blockIndex": 51,
    "zh": "二月，癸未夜，星隕如雨，繹繹，未至地滅。"
  },
  {
    "id": "s0269",
    "blockIndex": 52,
    "zh": "乙酉晦，日有食之。"
  },
  {
    "id": "s0270",
    "blockIndex": 53,
    "zh": "三月，丁酉，以成都侯王商為大司馬、衛將軍；"
  },
  {
    "id": "s0271",
    "blockIndex": 53,
    "zh": "紅陽侯王立位特進，領城門兵。"
  },
  {
    "id": "s0272",
    "blockIndex": 54,
    "zh": "京兆尹翟方進為御史大夫。"
  },
  {
    "id": "s0273",
    "blockIndex": 55,
    "zh": "谷永為涼州刺史，奏事京師，訖，當之部，上使尚書問永，受所欲言。"
  },
  {
    "id": "s0274",
    "blockIndex": 55,
    "zh": "永對曰：「臣聞王天下、有國家者，患在上有危亡之事而危亡之言不得上聞。"
  },
  {
    "id": "s0275",
    "blockIndex": 55,
    "zh": "如使危亡之言輒上聞，則商、周不易姓而迭興，三正不變改而更用。"
  },
  {
    "id": "s0276",
    "blockIndex": 55,
    "zh": "夏、商之將亡也，行道之人皆知之。"
  },
  {
    "id": "s0277",
    "blockIndex": 55,
    "zh": "晏然自以若天有日，莫能危，是故惡日廣而不自知，大命傾而不自寤。"
  },
  {
    "id": "s0278",
    "blockIndex": 55,
    "zh": "《易》曰：『危者有其安者也，亡者保其存者也。"
  },
  {
    "id": "s0279",
    "blockIndex": 55,
    "zh": "』陛下誠垂寬明之聽，無忌諱之誅，使芻蕘之臣得盡所聞於前，群臣之上願，社稷之長福也！"
  },
  {
    "id": "s0280",
    "blockIndex": 55,
    "zh": "元年，九月，黑龍見；"
  },
  {
    "id": "s0281",
    "blockIndex": 55,
    "zh": "其晦，日有食之。"
  },
  {
    "id": "s0282",
    "blockIndex": 55,
    "zh": "今年二月己未夜，星隕；"
  },
  {
    "id": "s0283",
    "blockIndex": 55,
    "zh": "乙酉，日有食之。"
  },
  {
    "id": "s0284",
    "blockIndex": 55,
    "zh": "六月之間，大異四發，二二而同月。"
  },
  {
    "id": "s0285",
    "blockIndex": 55,
    "zh": "三代之末，春秋之亂，未嘗有也。"
  },
  {
    "id": "s0286",
    "blockIndex": 55,
    "zh": "臣聞三代所以隕社稷、喪宗廟者，皆由婦人與群惡沉湎於酒；"
  },
  {
    "id": "s0287",
    "blockIndex": 55,
    "zh": "秦所以二世十六年而亡者，養生泰奢，奉終泰厚也。"
  },
  {
    "id": "s0288",
    "blockIndex": 55,
    "zh": "二者，陛下兼而有之，臣請略陳其效。"
  },
  {
    "id": "s0289",
    "blockIndex": 56,
    "zh": "「建始、河平之際，許、班之貴，傾動前朝，熏灼四方，女寵至極，不可上矣；"
  },
  {
    "id": "s0290",
    "blockIndex": 56,
    "zh": "今之後起，什倍於前。"
  },
  {
    "id": "s0291",
    "blockIndex": 56,
    "zh": "廢先帝法度，聽用其言，官秩不當，縱釋王誅，驕其親屬，假之威權，從橫亂政，刺舉之吏莫敢奉憲。"
  },
  {
    "id": "s0292",
    "blockIndex": 56,
    "zh": "又以掖庭獄大為亂阱，榜棰憯於砲烙，絕滅人命，主為趙、李報德復怨。"
  },
  {
    "id": "s0293",
    "blockIndex": 56,
    "zh": "反除白罪，建治正吏，多繫無辜，掠立迫恐，至為人起責，分利受謝，生入死出者，不可勝數。"
  },
  {
    "id": "s0294",
    "blockIndex": 56,
    "zh": "是以日食再既，以昭其辜。"
  },
  {
    "id": "s0295",
    "blockIndex": 57,
    "zh": "「王者必先自絕，然後天絕之。"
  },
  {
    "id": "s0296",
    "blockIndex": 57,
    "zh": "今陛下棄萬乘之至貴，樂家人之賤事，厭高美之尊號，好匹夫之卑字，崇聚僄輕無義小人以為私客，數離深宮之固，挺身晨夜，與群小相隨，烏集雜會，飲醉吏民之家，亂服共坐，流湎媟嫚，溷淆無別，黽勉遁樂，晝夜在路，典門戶、奉宿衛之臣執干戈而守空宮，公卿百僚不知陛下所在，積數年矣。"
  },
  {
    "id": "s0297",
    "blockIndex": 58,
    "zh": "「王者以民為基，民以財為本，財竭則下畔，下畔則上亡。"
  },
  {
    "id": "s0298",
    "blockIndex": 58,
    "zh": "是以明王愛養基本，不敢窮極，使民如承大祭。"
  },
  {
    "id": "s0299",
    "blockIndex": 58,
    "zh": "今陛下輕奪民財，不愛民力，聽邪臣之計，去高敞初陵，改作昌陵，役百乾溪，費擬驪山，靡敝天下，五年不成而後反故。"
  },
  {
    "id": "s0300",
    "blockIndex": 58,
    "zh": "百姓愁恨感天，饑饉仍臻，流散冗食，餧死於道，以百萬數。"
  },
  {
    "id": "s0301",
    "blockIndex": 58,
    "zh": "公家無一年之畜，百姓無旬日之儲，上下俱匱，無以相救。"
  },
  {
    "id": "s0302",
    "blockIndex": 58,
    "zh": "《詩》云：『殷鑒不遠，在夏后之世。"
  },
  {
    "id": "s0303",
    "blockIndex": 58,
    "zh": "』願陛下追觀夏、商、周、秦所以失之，以鏡考己行，有不合者，臣當伏妄言之誅！"
  },
  {
    "id": "s0304",
    "blockIndex": 59,
    "zh": "「漢興九世，百九十餘載，繼體之主七，皆承天順道，遵先祖法度，或以中興，或以治安；"
  },
  {
    "id": "s0305",
    "blockIndex": 59,
    "zh": "至於陛下，獨違道縱欲，輕身妄行，當盛壯之隆，無繼嗣之福，有危亡之憂，積失君道，不合天意，亦以多矣。"
  },
  {
    "id": "s0306",
    "blockIndex": 59,
    "zh": "為人後嗣，守人功業如此，豈不負哉！"
  },
  {
    "id": "s0307",
    "blockIndex": 59,
    "zh": "方今社稷、宗廟禍福、安危之機在於陛下，陛下誠肯昭然遠寤，專心反道，舊愆畢改，新德既章，則赫赫大異庶幾可銷，天命去就庶幾可復，社稷、宗廟庶幾可保！"
  },
  {
    "id": "s0308",
    "blockIndex": 59,
    "zh": "唯陛下留神反覆，熟省臣言！"
  },
  {
    "id": "s0310",
    "blockIndex": 60,
    "zh": "帝性寬，好文辭，而溺於燕樂，皆皇太后與諸舅夙夜所常憂；"
  },
  {
    "id": "s0311",
    "blockIndex": 60,
    "zh": "至親難數言，故推永等使因天變而切諫，勸上納用之。"
  },
  {
    "id": "s0312",
    "blockIndex": 60,
    "zh": "永自知有內應，展意無所依違，每言事輒見答禮。"
  },
  {
    "id": "s0313",
    "blockIndex": 60,
    "zh": "至上此對，上大怒。"
  },
  {
    "id": "s0314",
    "blockIndex": 60,
    "zh": "衛將軍商密擿永令發去。"
  },
  {
    "id": "s0315",
    "blockIndex": 60,
    "zh": "上使侍御史收永，敕過交道廄者勿追；"
  },
  {
    "id": "s0316",
    "blockIndex": 60,
    "zh": "御史不及永，還。"
  },
  {
    "id": "s0317",
    "blockIndex": 60,
    "zh": "上意亦解，自悔。"
  },
  {
    "id": "s0318",
    "blockIndex": 61,
    "zh": "上嘗與張放及趙、李諸侍中共宴飲禁中，皆引滿舉白，談笑大噱。"
  },
  {
    "id": "s0319",
    "blockIndex": 61,
    "zh": "時乘輿幄坐張畫屏風，畫紂醉踞妲己，作長夜之樂。"
  },
  {
    "id": "s0320",
    "blockIndex": 61,
    "zh": "侍中、光祿大夫班伯久疾新起，上顧指畫而問伯曰：「紂為無道，至於是虖？"
  },
  {
    "id": "s0321",
    "blockIndex": 61,
    "zh": "」對曰：「《書》云：『乃用婦人之言』，何有踞肆於朝！"
  },
  {
    "id": "s0322",
    "blockIndex": 61,
    "zh": "所謂眾惡歸之，不如是之甚者也！"
  },
  {
    "id": "s0323",
    "blockIndex": 61,
    "zh": "」上曰：「苟不若此，此圖何戒？"
  },
  {
    "id": "s0324",
    "blockIndex": 61,
    "zh": "」對曰：「『沉湎於酒』，微子所以告去也。"
  },
  {
    "id": "s0325",
    "blockIndex": 61,
    "zh": "『式號式呼』，《大雅》所以流連也。"
  },
  {
    "id": "s0326",
    "blockIndex": 61,
    "zh": "《詩》、《書》淫亂之戒，其原皆在於酒！"
  },
  {
    "id": "s0327",
    "blockIndex": 61,
    "zh": "」上乃喟然歎曰：「吾久不見班生，今日復聞讜言！"
  },
  {
    "id": "s0328",
    "blockIndex": 61,
    "zh": "」放等不懌，稍自引起更衣，因罷出。"
  },
  {
    "id": "s0329",
    "blockIndex": 61,
    "zh": "時長信庭林表適使來，聞見之。"
  },
  {
    "id": "s0330",
    "blockIndex": 61,
    "zh": "後上朝東宮，太后泣曰：「帝間顏色瘦黑。"
  },
  {
    "id": "s0331",
    "blockIndex": 61,
    "zh": "班侍中本大將軍所舉，宜寵異之；"
  },
  {
    "id": "s0332",
    "blockIndex": 61,
    "zh": "益求其比，以輔聖德！"
  },
  {
    "id": "s0333",
    "blockIndex": 61,
    "zh": "宜遣富平侯且就國！"
  },
  {
    "id": "s0334",
    "blockIndex": 61,
    "zh": "」上曰：「諾。"
  },
  {
    "id": "s0335",
    "blockIndex": 61,
    "zh": "」上諸舅聞之，以風丞相、御史，求放過失。"
  },
  {
    "id": "s0336",
    "blockIndex": 61,
    "zh": "於是丞相宣、御史大夫方進奏「放驕蹇縱恣，奢淫不制，拒閉使者，賊傷無辜，從者支屬並乘權勢，為暴虐，請免放就國。"
  },
  {
    "id": "s0337",
    "blockIndex": 61,
    "zh": "」上不得已，左遷放為北地都尉。"
  },
  {
    "id": "s0338",
    "blockIndex": 61,
    "zh": "其後比年數有災變，故放久不得還。"
  },
  {
    "id": "s0339",
    "blockIndex": 61,
    "zh": "璽書勞問不絕。"
  },
  {
    "id": "s0340",
    "blockIndex": 61,
    "zh": "敬武公主有疾，詔徽放歸第視母疾。"
  },
  {
    "id": "s0341",
    "blockIndex": 61,
    "zh": "數月，主有瘳，後復出放為河東都尉。"
  },
  {
    "id": "s0342",
    "blockIndex": 61,
    "zh": "上雖愛放，然上迫太后，下用大臣，故常涕泣而遣之。"
  },
  {
    "id": "s0343",
    "blockIndex": 62,
    "zh": "邛成太后之崩也，喪事倉卒，吏賦斂以趨辦，上聞之，以過丞相、御史。"
  },
  {
    "id": "s0344",
    "blockIndex": 62,
    "zh": "冬，十一月，己丑，冊免丞相宣為庶人，御史大夫方進左遷執金吾。"
  },
  {
    "id": "s0345",
    "blockIndex": 62,
    "zh": "二十餘日，丞相官缺，群臣多舉方進者；"
  },
  {
    "id": "s0346",
    "blockIndex": 62,
    "zh": "上亦器其能，十一月，壬子，擢方進為丞相，封高陵侯。"
  },
  {
    "id": "s0347",
    "blockIndex": 62,
    "zh": "以諸吏、散騎、光祿勳孔光為御史大夫。"
  },
  {
    "id": "s0348",
    "blockIndex": 62,
    "zh": "方進以經術進，其為吏，用法刻深，好任勢立威；"
  },
  {
    "id": "s0349",
    "blockIndex": 62,
    "zh": "有所忌惡，峻文深詆，中傷甚多。"
  },
  {
    "id": "s0350",
    "blockIndex": 62,
    "zh": "有言其挾私詆欺不專平者，上以方進所舉應科，不以為非也。"
  },
  {
    "id": "s0351",
    "blockIndex": 62,
    "zh": "光，褒成君霸之少子也，領尚書，典樞機十餘年，守法度，修故事，上有所問，據經法，以心所安而對，不希指苟合；"
  },
  {
    "id": "s0352",
    "blockIndex": 62,
    "zh": "如或不從，不敢強諫爭，以是久而安。"
  },
  {
    "id": "s0353",
    "blockIndex": 62,
    "zh": "時有所言，輒削草蒿，以為章主之過以奸忠直，人臣大罪也。"
  },
  {
    "id": "s0354",
    "blockIndex": 62,
    "zh": "有所薦舉，唯恐其人之聞知。"
  },
  {
    "id": "s0355",
    "blockIndex": 62,
    "zh": "沐日歸休，兄弟妻子燕語，終不及朝省政事。"
  },
  {
    "id": "s0356",
    "blockIndex": 62,
    "zh": "或問光：「溫室省中樹，皆何木也？"
  },
  {
    "id": "s0357",
    "blockIndex": 62,
    "zh": "」光嘿不應，更答以它語，其不洩如是。"
  },
  {
    "id": "s0358",
    "blockIndex": 63,
    "zh": "上行幸雍，祠五畤。"
  },
  {
    "id": "s0359",
    "blockIndex": 64,
    "zh": "衛將軍王商惡陳湯，奏「湯妄言昌陵且復發徙；"
  },
  {
    "id": "s0360",
    "blockIndex": 64,
    "zh": "又言黑龍冬出，微行數出之應。"
  },
  {
    "id": "s0361",
    "blockIndex": 64,
    "zh": "」廷尉奏「湯非所宣言，大不敬。"
  },
  {
    "id": "s0362",
    "blockIndex": 64,
    "zh": "」詔以湯有功，免為庶人，徙邊。"
  },
  {
    "id": "s0363",
    "blockIndex": 65,
    "zh": "上以趙後之立也，淳于長有力焉，故德之，乃追顯其前白罷昌陵之功，下公卿，議封長。"
  },
  {
    "id": "s0364",
    "blockIndex": 65,
    "zh": "光祿勳平當以為：「長雖有善言，不應封爵之科。"
  },
  {
    "id": "s0365",
    "blockIndex": 65,
    "zh": "」當坐左遷巨鹿太守。"
  },
  {
    "id": "s0366",
    "blockIndex": 65,
    "zh": "上遂下詔，以常侍閎，侍中、衛尉長首建至策，賜長、閎爵關內侯。"
  },
  {
    "id": "s0367",
    "blockIndex": 65,
    "zh": "將作大匠萬年佞邪不忠，毒流眾庶，與陳湯俱徒敦煌。"
  },
  {
    "id": "s0368",
    "blockIndex": 66,
    "zh": "初，少府陳咸，衛尉逢信，官簿皆在翟方進之右；"
  },
  {
    "id": "s0369",
    "blockIndex": 66,
    "zh": "方進晚進，為京兆尹，與咸厚善。"
  },
  {
    "id": "s0370",
    "blockIndex": 66,
    "zh": "及御史大夫缺，三人皆名卿，俱在選中，而方進得之。"
  },
  {
    "id": "s0371",
    "blockIndex": 66,
    "zh": "會丞相薛宣得罪，與方進相連，上使五二千石雜問丞相、御史，咸詰責方進，冀得其處，方進心恨。"
  },
  {
    "id": "s0372",
    "blockIndex": 66,
    "zh": "陳湯素以材能得幸於王鳳及王音，咸、信皆與湯善，湯數稱之於鳳、音所，以此得為九卿。"
  },
  {
    "id": "s0373",
    "blockIndex": 66,
    "zh": "及王商黜逐湯，方進因奏「咸、信附會湯以求薦舉，苟得無恥。"
  },
  {
    "id": "s0374",
    "blockIndex": 66,
    "zh": "」皆免官。"
  },
  {
    "id": "s0375",
    "blockIndex": 67,
    "zh": "是歲，琅邪太守朱博為左馮翊。"
  },
  {
    "id": "s0376",
    "blockIndex": 67,
    "zh": "博治郡，常令屬縣各用其豪桀以為大吏，文、武從宜。"
  },
  {
    "id": "s0377",
    "blockIndex": 67,
    "zh": "縣有劇賊及它非常，博輒移書以詭責之，其盡力有效，必加厚賞；"
  },
  {
    "id": "s0378",
    "blockIndex": 67,
    "zh": "懷詐不稱，誅罰輒行。"
  },
  {
    "id": "s0379",
    "blockIndex": 67,
    "zh": "以是豪強懾服，事無不集。"
  },
  {
    "id": "s0380",
    "blockIndex": 68,
    "zh": "春，正月，己卯晦，日有食之。"
  },
  {
    "id": "s0381",
    "blockIndex": 69,
    "zh": "初，帝用匡衡議，罷甘泉泰畤，其日，大風壞甘泉竹宮，折拔畤中樹木十圍以上百餘。"
  },
  {
    "id": "s0382",
    "blockIndex": 69,
    "zh": "帝異之，以問劉向，對曰：「家人尚不欲絕種祠，況於國之神寶舊畤！"
  },
  {
    "id": "s0383",
    "blockIndex": 69,
    "zh": "且甘泉、汾陰及雍五畤始立，皆有神示氐感應，然後營之，非苟而已也。"
  },
  {
    "id": "s0384",
    "blockIndex": 69,
    "zh": "武、宣之世奉此三神，禮敬敕備，神光尤著。"
  },
  {
    "id": "s0385",
    "blockIndex": 69,
    "zh": "祖宗所立神祇舊位，誠未易動。"
  },
  {
    "id": "s0386",
    "blockIndex": 69,
    "zh": "前始納貢禹之議，後人相因，多所動搖。"
  },
  {
    "id": "s0387",
    "blockIndex": 69,
    "zh": "《易大傳》曰：『誣神者殃及三世。"
  },
  {
    "id": "s0388",
    "blockIndex": 69,
    "zh": "』恐其咎不獨止禹等！"
  },
  {
    "id": "s0389",
    "blockIndex": 69,
    "zh": "」上意恨之，又以久無繼嗣，冬，十月，庚辰，上白太后，令詔有司復甘泉泰畤、汾陰后土如故，及雍五畤、陳寶祠、長安及郡國祠著明者，皆復之。"
  },
  {
    "id": "s0390",
    "blockIndex": 70,
    "zh": "是時，上以無繼嗣，頗好鬼神、方術之屬，上書言祭祀方術得待詔者甚眾，祠祭費用頗多。"
  },
  {
    "id": "s0391",
    "blockIndex": 70,
    "zh": "谷永說上曰：「臣聞明於天地之性，不可惑以神怪；"
  },
  {
    "id": "s0392",
    "blockIndex": 70,
    "zh": "知萬物之情，不可罔以非類。"
  },
  {
    "id": "s0393",
    "blockIndex": 70,
    "zh": "諸背仁義之正道，不遵《五經》之法言，而盛稱奇怪鬼神，廣崇祭祀之方，求報無福之祠，及言世有仙人，服食不終之藥，遙興輕舉、黃治變化之術者，皆奸人惑眾，挾左道，懷詐偽，以欺罔世主。"
  },
  {
    "id": "s0394",
    "blockIndex": 70,
    "zh": "聽其言，洋洋滿耳，若將可遇，求之，蕩蕩如繫風捕景，終不可得。"
  },
  {
    "id": "s0395",
    "blockIndex": 70,
    "zh": "是以明王距而不聽，聖人絕而不語。"
  },
  {
    "id": "s0396",
    "blockIndex": 70,
    "zh": "昔秦始皇使徐福發男女入海求神采藥，因逃不還，天下怨恨。"
  },
  {
    "id": "s0397",
    "blockIndex": 70,
    "zh": "漢興，新垣平、齊人少翁、公孫卿、欒大等皆以術窮詐得，誅夷伏辜。"
  },
  {
    "id": "s0398",
    "blockIndex": 70,
    "zh": "唯陛下距絕此類，毋令奸人有以窺朝者！"
  },
  {
    "id": "s0399",
    "blockIndex": 70,
    "zh": "」上善其言。"
  },
  {
    "id": "s0400",
    "blockIndex": 71,
    "zh": "十一月，尉氏男子樊並等十三人謀反，殺陳留太守，劫略吏民，自稱將軍；"
  },
  {
    "id": "s0401",
    "blockIndex": 71,
    "zh": "徒李潭、稱忠、鍾祖、訾順共殺並，以聞，皆封為侯。"
  },
  {
    "id": "s0402",
    "blockIndex": 72,
    "zh": "十二月，山陽鐵官徙蘇令等二百二十八人攻殺長吏，盜庫兵，自稱將軍；"
  },
  {
    "id": "s0403",
    "blockIndex": 72,
    "zh": "經郡國十九，殺東郡太守及汝南都尉。"
  },
  {
    "id": "s0404",
    "blockIndex": 72,
    "zh": "汝南太守嚴訢捕斬令等。"
  },
  {
    "id": "s0405",
    "blockIndex": 72,
    "zh": "遷訢為大司農。"
  },
  {
    "id": "s0406",
    "blockIndex": 72,
    "zh": "故南昌尉九江梅福上書曰：「昔高祖納善若不及，從諫如轉圜，聽言不求其能，舉功不考其素，陳平起於亡命而為謀主，韓信拔於行陳而建上將；"
  },
  {
    "id": "s0407",
    "blockIndex": 72,
    "zh": "故天下之士雲合歸漢，爭進奇異，知者竭其策，愚者盡其慮，勇士極其節，怯夫勉其死。"
  },
  {
    "id": "s0408",
    "blockIndex": 72,
    "zh": "合天下之知，並天下之威，是以舉秦如鴻毛，取楚若拾遺，此高祖所以無敵於天下也。"
  },
  {
    "id": "s0409",
    "blockIndex": 72,
    "zh": "孝武皇帝好忠諫，說至言，出爵不待廉、茂，慶賜不須顯功，是以天下布衣各厲志竭精以赴闕廷，自衒鬻者不可勝數，漢家得賢，於此為盛。"
  },
  {
    "id": "s0410",
    "blockIndex": 72,
    "zh": "使孝武皇帝聽用其計，昇平可致，於是積屍暴骨，快心胡、越，故淮南王安緣間而起；"
  },
  {
    "id": "s0411",
    "blockIndex": 72,
    "zh": "所以計慮不成而謀議洩者，以眾賢聚於本朝，故其大臣勢陵，不敢和從也。"
  },
  {
    "id": "s0412",
    "blockIndex": 72,
    "zh": "方今布衣乃窺國家之隙，見間而起者，蜀郡是也。"
  },
  {
    "id": "s0413",
    "blockIndex": 72,
    "zh": "及山陽亡徒蘇令之群，蹈藉名都、大郡，求黨與，索隨和，而亡逃匿之意，此皆輕量大臣，無所畏忌，國家之權輕，故匹夫欲與上爭衡也。"
  },
  {
    "id": "s0414",
    "blockIndex": 72,
    "zh": "士者，國之重器。"
  },
  {
    "id": "s0415",
    "blockIndex": 72,
    "zh": "得士則重，失士則輕。"
  },
  {
    "id": "s0416",
    "blockIndex": 72,
    "zh": "《詩》云：『濟濟多士，文王以寧。"
  },
  {
    "id": "s0417",
    "blockIndex": 72,
    "zh": "』廟堂之議，非草茅所言也。"
  },
  {
    "id": "s0418",
    "blockIndex": 72,
    "zh": "臣誠恐身塗野草，屍並卒伍，故數上書求見，輒報罷。"
  },
  {
    "id": "s0419",
    "blockIndex": 72,
    "zh": "臣聞齊桓之時，有以九九見者，桓公不逆，欲以致大也。"
  },
  {
    "id": "s0420",
    "blockIndex": 72,
    "zh": "今臣所言，非特九九也，陛下距臣者三矣，此天下士所以不至也。"
  },
  {
    "id": "s0421",
    "blockIndex": 72,
    "zh": "昔秦武王好力，任鄙叩關自鬻；"
  },
  {
    "id": "s0422",
    "blockIndex": 72,
    "zh": "繆公行伯，由余歸德。"
  },
  {
    "id": "s0423",
    "blockIndex": 72,
    "zh": "今欲致天下之士，民有上書求見者，輒使詣尚書問其所言，言可採取者，秩以升斗之祿，賜以一束之帛，若此，則天下之士，發憤懣，吐忠言，嘉謀日聞於上，天下條貫，國家表裡，爛然可睹矣。"
  },
  {
    "id": "s0424",
    "blockIndex": 72,
    "zh": "夫以四海之廣，士民之數，能言之類至眾多也；"
  },
  {
    "id": "s0425",
    "blockIndex": 72,
    "zh": "然其俊桀指世陳政，言成文章，質之先聖而不繆，施之當世合時務，若此者亦無幾人。"
  },
  {
    "id": "s0426",
    "blockIndex": 72,
    "zh": "故爵祿束帛者，天下之砥石，高祖所以厲世摩鈍也。"
  },
  {
    "id": "s0427",
    "blockIndex": 72,
    "zh": "孔子曰：『工欲善其事，必先利其器。"
  },
  {
    "id": "s0428",
    "blockIndex": 72,
    "zh": "』至秦則不然，張誹謗之罔以為漢驅除，倒持泰阿，授楚其柄。"
  },
  {
    "id": "s0429",
    "blockIndex": 72,
    "zh": "故誠能勿失其柄，天下雖有不順，莫敢觸其鋒，此孝武皇帝所以闢地建功，為漢世宗也。"
  },
  {
    "id": "s0430",
    "blockIndex": 73,
    "zh": "「今陛下既不納天下之言，又加戮焉。"
  },
  {
    "id": "s0431",
    "blockIndex": 73,
    "zh": "夫鳶鵲遭害，則仁鳥增逝，愚者蒙戮，則智士深退。"
  },
  {
    "id": "s0432",
    "blockIndex": 73,
    "zh": "間者愚民上疏，多觸不急之法，或下廷尉而死者眾。"
  },
  {
    "id": "s0433",
    "blockIndex": 73,
    "zh": "自陽朔以來，天下以言為諱，朝廷尤甚，群臣皆承順上指，莫有執正。"
  },
  {
    "id": "s0434",
    "blockIndex": 73,
    "zh": "何以明其然也？"
  },
  {
    "id": "s0435",
    "blockIndex": 73,
    "zh": "取民所上書，陛下之所善，試下之廷尉，廷尉必曰『非所宜言，大不敬，』以此卜之，一矣。"
  },
  {
    "id": "s0436",
    "blockIndex": 73,
    "zh": "故京兆尹王章，資質忠直，敢面引廷爭，孝元皇帝擢之，以厲具臣而矯曲朝；"
  },
  {
    "id": "s0437",
    "blockIndex": 73,
    "zh": "及至陛下，戮及妻子。"
  },
  {
    "id": "s0438",
    "blockIndex": 73,
    "zh": "且惡惡止其身，王章非有反畔之辜而殃及室家，折直士之節，結諫臣之舌。"
  },
  {
    "id": "s0439",
    "blockIndex": 73,
    "zh": "群臣皆知其非，然不敢爭，天下以言為戒，最國家之大患也！"
  },
  {
    "id": "s0440",
    "blockIndex": 73,
    "zh": "願陛下循高祖之軌，杜亡秦之路，除不急之法，下無諱之詔，博覽兼聽，謀及疏賤，令深者不隱，遠者不塞，所謂『闢四門，明四目』也。"
  },
  {
    "id": "s0441",
    "blockIndex": 73,
    "zh": "往者不可及，來者猶可追。"
  },
  {
    "id": "s0442",
    "blockIndex": 73,
    "zh": "方今君命犯而主威奪，外戚之權，日以益隆。"
  },
  {
    "id": "s0443",
    "blockIndex": 73,
    "zh": "陛下不見其形，願察其景！"
  },
  {
    "id": "s0444",
    "blockIndex": 73,
    "zh": "建始以來，日食、地震，以率言之，三倍春秋，水災亡與比數，陰盛陽微，金鐵為飛，此何景也？"
  },
  {
    "id": "s0445",
    "blockIndex": 73,
    "zh": "漢興以來，社稷三危：呂，霍，上官；"
  },
  {
    "id": "s0446",
    "blockIndex": 73,
    "zh": "皆母后之家也。"
  },
  {
    "id": "s0447",
    "blockIndex": 73,
    "zh": "親親之道，全之為右，當與之賢師良傅，教以忠孝之道。"
  },
  {
    "id": "s0448",
    "blockIndex": 73,
    "zh": "今乃尊寵其位，授以魁柄，使之驕逆，至於夷滅，此失親親之大者也。"
  },
  {
    "id": "s0449",
    "blockIndex": 73,
    "zh": "自霍光之賢，不能為子孫慮，故權臣易世則危。"
  },
  {
    "id": "s0450",
    "blockIndex": 73,
    "zh": "《書》曰：『毋若火，始庸庸。"
  },
  {
    "id": "s0451",
    "blockIndex": 73,
    "zh": "』勢陵於君，權隆於主，然後防之，亦無及已！"
  },
  {
    "id": "s0452",
    "blockIndex": 73,
    "zh": "」上不納。"
  },
  {
    "id": "s0453",
    "blockIndex": 74,
    "zh": "category:資治通鑑"
  }
]
