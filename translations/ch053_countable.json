[
  {
    "id": "s0001",
    "blockIndex": 0,
    "zh": "資治通鑑 第053卷"
  },
  {
    "id": "s0002",
    "blockIndex": 1,
    "zh": "【漢紀四十五】　起柔兆閹茂，盡柔兆涒灘，凡十一年。"
  },
  {
    "id": "s0003",
    "blockIndex": 2,
    "zh": "夏，四月，庚辰，令郡、國舉明經詣太學，自大將軍以下皆遣子受業；"
  },
  {
    "id": "s0003",
    "blockIndex": 2,
    "zh": "歲滿課試，拜官有差。"
  },
  {
    "id": "s0003",
    "blockIndex": 2,
    "zh": "又千石、六百石、四府掾屬、三署郎、四姓小侯先能通經者，各令隨家法，其高第者上名牒，當以次賞進。"
  },
  {
    "id": "s0003",
    "blockIndex": 2,
    "zh": "自是遊學增盛，至三萬餘生。"
  },
  {
    "id": "s0007",
    "blockIndex": 3,
    "zh": "五月，庚寅，徙樂安王鴻為渤海王。"
  },
  {
    "id": "s0008",
    "blockIndex": 4,
    "zh": "海水溢，漂沒民居。"
  },
  {
    "id": "s0009",
    "blockIndex": 5,
    "zh": "六月，丁巳，赦天下。"
  },
  {
    "id": "s0010",
    "blockIndex": 6,
    "zh": "帝少而聰慧，嘗因朝會，目梁冀曰：「此跋扈將軍也！"
  },
  {
    "id": "s0010",
    "blockIndex": 6,
    "zh": "」冀聞，深惡之。"
  },
  {
    "id": "s0010",
    "blockIndex": 6,
    "zh": "閏月，甲申，冀使左右置毒於煮餅以進之。"
  },
  {
    "id": "s0010",
    "blockIndex": 6,
    "zh": "帝若煩甚，使促召太尉李固。"
  },
  {
    "id": "s0010",
    "blockIndex": 6,
    "zh": "固入前，問帝得患所由；"
  },
  {
    "id": "s0010",
    "blockIndex": 6,
    "zh": "帝尚能言，曰：「食煮餅。"
  },
  {
    "id": "s0010",
    "blockIndex": 6,
    "zh": "今腹中悶，得水尚可活。"
  },
  {
    "id": "s0010",
    "blockIndex": 6,
    "zh": "」時冀亦在側，曰：「恐吐，不可飲水。"
  },
  {
    "id": "s0010",
    "blockIndex": 6,
    "zh": "」語未絕而崩。"
  },
  {
    "id": "s0010",
    "blockIndex": 6,
    "zh": "固伏屍號哭，推舉侍醫。"
  },
  {
    "id": "s0010",
    "blockIndex": 6,
    "zh": "冀慮其事洩，大惡之。"
  },
  {
    "id": "s0021",
    "blockIndex": 7,
    "zh": "將議立嗣，固與司徒胡廣、司空趙戒先與冀書曰：「天下不幸，頻年之間，國祚三絕。"
  },
  {
    "id": "s0021",
    "blockIndex": 7,
    "zh": "今當立帝，天下重器，誠知太后垂心，將軍勞慮，詳擇其人，務存聖明。"
  },
  {
    "id": "s0021",
    "blockIndex": 7,
    "zh": "然愚情眷眷，竊獨有懷。"
  },
  {
    "id": "s0021",
    "blockIndex": 7,
    "zh": "遠尋先世廢立舊儀，近見國家踐祚前事，未嘗不詢訪公卿，廣求群議，令上應天心，下合眾望。"
  },
  {
    "id": "s0021",
    "blockIndex": 7,
    "zh": "《傳》曰：『以天下與人易，為天下得人難。"
  },
  {
    "id": "s0021",
    "blockIndex": 7,
    "zh": "』昔昌邑之立，昏亂日滋；"
  },
  {
    "id": "s0021",
    "blockIndex": 7,
    "zh": "霍光憂愧發憤，悔之折骨。"
  },
  {
    "id": "s0021",
    "blockIndex": 7,
    "zh": "自非博陸忠勇，延年奮發，大漢之祀，幾將傾矣。"
  },
  {
    "id": "s0021",
    "blockIndex": 7,
    "zh": "至憂至重，可不熟慮！"
  },
  {
    "id": "s0021",
    "blockIndex": 7,
    "zh": "悠悠萬事，唯此為大；"
  },
  {
    "id": "s0021",
    "blockIndex": 7,
    "zh": "國之興衰，在此一舉。"
  },
  {
    "id": "s0021",
    "blockIndex": 7,
    "zh": "」冀得書，乃召三公、中二千石、列侯，大議所立。"
  },
  {
    "id": "s0021",
    "blockIndex": 7,
    "zh": "固、廣、戒及大鴻臚杜喬皆以為清河王蒜明德著聞，又屬最尊親，宜立為嗣，朝臣莫不歸心。"
  },
  {
    "id": "s0021",
    "blockIndex": 7,
    "zh": "而中常侍曹騰嘗謁蒜，蒜不為禮，宦者由此惡之。"
  },
  {
    "id": "s0021",
    "blockIndex": 7,
    "zh": "初，平原王冀既貶歸河間，其父請分蠡吾縣以侯之；"
  },
  {
    "id": "s0021",
    "blockIndex": 7,
    "zh": "順帝許之。"
  },
  {
    "id": "s0021",
    "blockIndex": 7,
    "zh": "翼卒，子志嗣；"
  },
  {
    "id": "s0021",
    "blockIndex": 7,
    "zh": "梁太后欲以女弟妻志，征到夏門亭。"
  },
  {
    "id": "s0021",
    "blockIndex": 7,
    "zh": "會帝崩，梁冀欲立志。"
  },
  {
    "id": "s0021",
    "blockIndex": 7,
    "zh": "眾論既異，憤憤不得意，而未有以相奪。"
  },
  {
    "id": "s0021",
    "blockIndex": 7,
    "zh": "曹騰等聞之，夜往說冀曰：「將軍累世有椒房之親，東攝萬機，賓客縱橫，多有過差。"
  },
  {
    "id": "s0021",
    "blockIndex": 7,
    "zh": "清河王嚴明，若果立，則將軍受禍不久矣！"
  },
  {
    "id": "s0021",
    "blockIndex": 7,
    "zh": "不如立蠡吾侯，富貴可長保也。"
  },
  {
    "id": "s0021",
    "blockIndex": 7,
    "zh": "」冀然其言，明日，重會公卿，冀意氣凶凶，言辭激切，自胡廣、趙戒以下莫不懾憚，皆曰：「惟大將軍令！"
  },
  {
    "id": "s0021",
    "blockIndex": 7,
    "zh": "」獨李固、杜喬堅守本議。"
  },
  {
    "id": "s0021",
    "blockIndex": 7,
    "zh": "冀厲聲曰：「罷會！"
  },
  {
    "id": "s0021",
    "blockIndex": 7,
    "zh": "」固猶望眾心可立，復以書勸冀，冀愈激怒。"
  },
  {
    "id": "s0021",
    "blockIndex": 7,
    "zh": "丁亥，冀說太后，先策免固。"
  },
  {
    "id": "s0021",
    "blockIndex": 7,
    "zh": "戊子，以司徒胡廣為太尉；"
  },
  {
    "id": "s0021",
    "blockIndex": 7,
    "zh": "司空趙戒為司徒，與大將軍冀參錄尚書事；"
  },
  {
    "id": "s0021",
    "blockIndex": 7,
    "zh": "太僕袁湯為司空。"
  },
  {
    "id": "s0021",
    "blockIndex": 7,
    "zh": "湯，安之孫也。"
  },
  {
    "id": "s0021",
    "blockIndex": 7,
    "zh": "庚寅，使大將軍冀持節以王青蓋車迎蠡吾侯志入南宮；"
  },
  {
    "id": "s0021",
    "blockIndex": 7,
    "zh": "其日，即皇帝位，時年十五。"
  },
  {
    "id": "s0021",
    "blockIndex": 7,
    "zh": "太后猶臨朝政。"
  },
  {
    "id": "s0056",
    "blockIndex": 8,
    "zh": "秋，七月，乙卯，葬孝質皇帝於靜陵。"
  },
  {
    "id": "s0057",
    "blockIndex": 9,
    "zh": "大將軍掾朱穆奏記勸戒梁冀曰：「明年丁亥之歲，刑德合於乾位，《易經》龍戰之會，陽道將勝，陰道將負。"
  },
  {
    "id": "s0057",
    "blockIndex": 9,
    "zh": "願將軍專心公朝，割除私慾，廣求賢能，斥遠佞惡，為皇帝置師傅，得小心忠篤敦禮之士，將軍與之俱入，參勸講援，師賢法古，此猶倚南山、坐平原也，誰能傾之！"
  },
  {
    "id": "s0057",
    "blockIndex": 9,
    "zh": "議郎大夫之位，本以式序儒術高行之士，今多非其人，九卿之中亦有乖其任者，惟將軍察焉！"
  },
  {
    "id": "s0057",
    "blockIndex": 9,
    "zh": "」又薦種暠、欒巴等，冀不能用。"
  },
  {
    "id": "s0057",
    "blockIndex": 9,
    "zh": "穆，暉之孫也。"
  },
  {
    "id": "s0062",
    "blockIndex": 10,
    "zh": "九月，戊戌，追尊河間孝王為孝穆皇，夫人趙氏曰孝穆後，廟曰清廟，陵曰樂成陵；"
  },
  {
    "id": "s0062",
    "blockIndex": 10,
    "zh": "蠡吾先侯曰孝崇皇，廟曰烈廟，陵曰博陵；"
  },
  {
    "id": "s0062",
    "blockIndex": 10,
    "zh": "皆置令、丞、使司徒持節奉策書璽綬，祠以太牢。"
  },
  {
    "id": "s0065",
    "blockIndex": 11,
    "zh": "冬，十月，甲午，尊帝母匽氏為博園貴人。"
  },
  {
    "id": "s0066",
    "blockIndex": 12,
    "zh": "滕撫性方直，不交權勢，為宦官所惡；"
  },
  {
    "id": "s0066",
    "blockIndex": 12,
    "zh": "論討賊功當封，太尉胡廣承旨奏黜之；"
  },
  {
    "id": "s0066",
    "blockIndex": 12,
    "zh": "卒於家。"
  },
  {
    "id": "s0069",
    "blockIndex": 13,
    "zh": "孝桓皇帝上之上"
  },
  {
    "id": "s0070",
    "blockIndex": 14,
    "zh": "春，正月，辛亥朔，日有食之。"
  },
  {
    "id": "s0071",
    "blockIndex": 15,
    "zh": "戊午，赦天下。"
  },
  {
    "id": "s0072",
    "blockIndex": 16,
    "zh": "三月，龍見譙。"
  },
  {
    "id": "s0073",
    "blockIndex": 17,
    "zh": "夏，四月，庚寅，京師地震。"
  },
  {
    "id": "s0074",
    "blockIndex": 18,
    "zh": "立阜陵王代兄勃遒亭侯便為阜陵王。"
  },
  {
    "id": "s0075",
    "blockIndex": 19,
    "zh": "六月，太尉胡廣罷。"
  },
  {
    "id": "s0075",
    "blockIndex": 19,
    "zh": "光祿勳杜喬為太尉。"
  },
  {
    "id": "s0075",
    "blockIndex": 19,
    "zh": "自李固之廢，內外喪氣，群臣側足而立，唯喬正色無所回橈，由是朝野皆倚望焉。"
  },
  {
    "id": "s0078",
    "blockIndex": 20,
    "zh": "秋，七月，渤海孝王鴻薨，無子；"
  },
  {
    "id": "s0078",
    "blockIndex": 20,
    "zh": "太后立帝弟蠡吾侯悝為渤海王，以奉鴻祀。"
  },
  {
    "id": "s0080",
    "blockIndex": 21,
    "zh": "詔以定策功，益封梁冀萬三千戶，封冀弟不疑為穎陽侯，蒙為西平侯，冀子胤為襄邑侯，胡廣為安樂侯，趙戒為廚亭侯，袁湯為安國侯。"
  },
  {
    "id": "s0080",
    "blockIndex": 21,
    "zh": "又封中常侍劉廣等皆為列侯。"
  },
  {
    "id": "s0080",
    "blockIndex": 21,
    "zh": "杜喬諫曰：「古之明君，皆以用賢、賞罰為務。"
  },
  {
    "id": "s0080",
    "blockIndex": 21,
    "zh": "失國之主，其朝豈無貞干之臣，典誥之篇哉？"
  },
  {
    "id": "s0080",
    "blockIndex": 21,
    "zh": "患得賢不用其謀，韜書不施其教，聞善不信其義，聽讒不審其理也。"
  },
  {
    "id": "s0080",
    "blockIndex": 21,
    "zh": "陛下自籓臣即位，天人屬心，不急忠賢之禮而先左右之封，梁氏一門，宦者微孽，並帶無功之紱，裂勞臣之土，其為乖濫，胡可勝言！"
  },
  {
    "id": "s0080",
    "blockIndex": 21,
    "zh": "夫有功不賞，為善失其望；"
  },
  {
    "id": "s0080",
    "blockIndex": 21,
    "zh": "奸回不詰，為惡肆其凶。"
  },
  {
    "id": "s0080",
    "blockIndex": 21,
    "zh": "故陳資斧而人靡畏，班爵位而物無勸。"
  },
  {
    "id": "s0080",
    "blockIndex": 21,
    "zh": "苟遂斯道，豈伊傷政為亂而已，喪身亡國，可不慎哉！"
  },
  {
    "id": "s0080",
    "blockIndex": 21,
    "zh": "」書奏，不省。"
  },
  {
    "id": "s0091",
    "blockIndex": 22,
    "zh": "八月，乙未，立皇后梁氏。"
  },
  {
    "id": "s0091",
    "blockIndex": 22,
    "zh": "梁冀欲以厚禮迎之，杜喬據執舊典不聽。"
  },
  {
    "id": "s0091",
    "blockIndex": 22,
    "zh": "冀屬喬舉汜宮為尚書，喬以宮為臧罪，不用。"
  },
  {
    "id": "s0091",
    "blockIndex": 22,
    "zh": "由是日忤於冀。"
  },
  {
    "id": "s0091",
    "blockIndex": 22,
    "zh": "九月，丁卯，京師地震。"
  },
  {
    "id": "s0091",
    "blockIndex": 22,
    "zh": "喬以災異策免。"
  },
  {
    "id": "s0091",
    "blockIndex": 22,
    "zh": "冬，十月，以司徒趙戒為太尉，司空袁湯為司徒，前太尉胡廣為司空。"
  },
  {
    "id": "s0098",
    "blockIndex": 23,
    "zh": "宦者唐衡、左心官共譖杜喬於帝曰：「陛下前當即位，喬與李固抗議，以為不堪奉漢宗祀。"
  },
  {
    "id": "s0098",
    "blockIndex": 23,
    "zh": "」帝亦怨之。"
  },
  {
    "id": "s0098",
    "blockIndex": 23,
    "zh": "十一月，清河劉文與南郡妖賊劉鮪交通，妄言：清河王當統天下，欲共立蒜。"
  },
  {
    "id": "s0098",
    "blockIndex": 23,
    "zh": "事覺，文等遂劫清河相謝暠曰：「當立王為天子，以暠為公。"
  },
  {
    "id": "s0098",
    "blockIndex": 23,
    "zh": "」暠罵之，文刺殺暠。"
  },
  {
    "id": "s0098",
    "blockIndex": 23,
    "zh": "於是捕文、鮪，誅之。"
  },
  {
    "id": "s0098",
    "blockIndex": 23,
    "zh": "有司劾奏蒜；"
  },
  {
    "id": "s0098",
    "blockIndex": 23,
    "zh": "坐貶爵為尉氏侯，徙桂陽，自殺。"
  },
  {
    "id": "s0098",
    "blockIndex": 23,
    "zh": "梁冀因誣李固、杜喬，雲與文、鮪等交通，請逮按罪；"
  },
  {
    "id": "s0098",
    "blockIndex": 23,
    "zh": "太后素知喬忠，不許。"
  },
  {
    "id": "s0098",
    "blockIndex": 23,
    "zh": "冀遂收固下獄；"
  },
  {
    "id": "s0098",
    "blockIndex": 23,
    "zh": "門生渤海王調貫械上書，證固之枉，河內趙承等數十人亦要鈇鍎詣闕通訴；"
  },
  {
    "id": "s0098",
    "blockIndex": 23,
    "zh": "太后詔赦之。"
  },
  {
    "id": "s0098",
    "blockIndex": 23,
    "zh": "及出獄，京師市裡皆稱萬歲。"
  },
  {
    "id": "s0098",
    "blockIndex": 23,
    "zh": "冀聞之，大驚，畏固名德終為己害，乃更據奏前事。"
  },
  {
    "id": "s0098",
    "blockIndex": 23,
    "zh": "大將軍長史吳祐傷固之枉，與冀爭之。"
  },
  {
    "id": "s0098",
    "blockIndex": 23,
    "zh": "冀怒，不從。"
  },
  {
    "id": "s0098",
    "blockIndex": 23,
    "zh": "從事中郎馬融主為冀作章表，融時在坐，祐謂融曰：「李公之罪，成於卿手。"
  },
  {
    "id": "s0098",
    "blockIndex": 23,
    "zh": "李公若誅，卿何面目視天下人！"
  },
  {
    "id": "s0098",
    "blockIndex": 23,
    "zh": "」冀怒，起，入室；"
  },
  {
    "id": "s0098",
    "blockIndex": 23,
    "zh": "祐亦徑去。"
  },
  {
    "id": "s0098",
    "blockIndex": 23,
    "zh": "固遂死於獄中；"
  },
  {
    "id": "s0098",
    "blockIndex": 23,
    "zh": "臨命，與胡廣、趙戒書曰：「固受國厚恩，是以竭其股肱，不顧死亡，志欲扶持王室，比隆文、宣。"
  },
  {
    "id": "s0098",
    "blockIndex": 23,
    "zh": "何圖一朝梁氏迷謬，公等曲從，以吉為凶，成事為敗乎！"
  },
  {
    "id": "s0098",
    "blockIndex": 23,
    "zh": "漢家衰微，從此始矣。"
  },
  {
    "id": "s0098",
    "blockIndex": 23,
    "zh": "公等受主厚祿，顛而不扶，傾覆大事，後之良史豈有所私！"
  },
  {
    "id": "s0098",
    "blockIndex": 23,
    "zh": "固身已矣，於義得矣，夫復何言！"
  },
  {
    "id": "s0098",
    "blockIndex": 23,
    "zh": "」廣、戒得書悲慚，皆長歎流涕而已。"
  },
  {
    "id": "s0098",
    "blockIndex": 23,
    "zh": "冀使人脅杜喬曰：「早從宜，妻子可得全。"
  },
  {
    "id": "s0098",
    "blockIndex": 23,
    "zh": "」喬不肯。"
  },
  {
    "id": "s0098",
    "blockIndex": 23,
    "zh": "明日，冀遣騎至其門，不聞哭者，遂白太后收系之；"
  },
  {
    "id": "s0098",
    "blockIndex": 23,
    "zh": "亦死獄中。"
  },
  {
    "id": "s0130",
    "blockIndex": 24,
    "zh": "冀暴固、喬屍於城北四衢，令：「有敢臨者加其罪。"
  },
  {
    "id": "s0130",
    "blockIndex": 24,
    "zh": "」固弟子汝南郭亮尚未冠，左提章、鉞，右秉鈇鍎，詣厥上書，乞收固屍，不報；"
  },
  {
    "id": "s0130",
    "blockIndex": 24,
    "zh": "與南陽董班俱往臨哭，守喪不去。"
  },
  {
    "id": "s0130",
    "blockIndex": 24,
    "zh": "夏門亭長呵之曰：「卿曹何等腐生！"
  },
  {
    "id": "s0130",
    "blockIndex": 24,
    "zh": "公犯詔書，欲干試有司乎！"
  },
  {
    "id": "s0130",
    "blockIndex": 24,
    "zh": "」亮曰：「義之所動，豈知性命，何為以死相懼邪！"
  },
  {
    "id": "s0130",
    "blockIndex": 24,
    "zh": "」太后聞之，皆赦不誅。"
  },
  {
    "id": "s0130",
    "blockIndex": 24,
    "zh": "杜喬故掾陳留楊匡，號泣星行，到雒陽，著故赤幘，托為夏門亭吏，守護屍喪，積十二日；"
  },
  {
    "id": "s0130",
    "blockIndex": 24,
    "zh": "都官從事執之以聞，太后赦之。"
  },
  {
    "id": "s0130",
    "blockIndex": 24,
    "zh": "匡因詣厥上書，並乞李、杜二公骸骨，使得歸葬，太后許之。"
  },
  {
    "id": "s0130",
    "blockIndex": 24,
    "zh": "匡送喬喪還家，葬訖，行服，遂與郭亮、董班皆隱匿，終身不仕。"
  },
  {
    "id": "s0130",
    "blockIndex": 24,
    "zh": "梁冀出吳祐為河間相，祐自免歸，卒於家。"
  },
  {
    "id": "s0130",
    "blockIndex": 24,
    "zh": "冀以劉鮪之亂，思朱穆之言，於是請種暠為從事中郎，薦欒巴為議郎，舉穆高第，為侍御史。"
  },
  {
    "id": "s0143",
    "blockIndex": 25,
    "zh": "是歲，南單于兜樓儲死，伊陵屍逐就單于車兒立。"
  },
  {
    "id": "s0144",
    "blockIndex": 26,
    "zh": "春，正月，甲子，帝加元服。"
  },
  {
    "id": "s0144",
    "blockIndex": 26,
    "zh": "庚午，赦天下。"
  },
  {
    "id": "s0146",
    "blockIndex": 27,
    "zh": "三月，戊辰，帝從皇太后幸大將軍冀府。"
  },
  {
    "id": "s0147",
    "blockIndex": 28,
    "zh": "白馬羌寇廣漢屬國，殺長吏。"
  },
  {
    "id": "s0147",
    "blockIndex": 28,
    "zh": "益州刺史率板楯蠻討破之。"
  },
  {
    "id": "s0149",
    "blockIndex": 29,
    "zh": "夏，四月，丙子，封帝弟顧為平原王，奉孝崇皇祀；"
  },
  {
    "id": "s0149",
    "blockIndex": 29,
    "zh": "尊孝崇皇夫人馬氏為孝崇園貴人。"
  },
  {
    "id": "s0151",
    "blockIndex": 30,
    "zh": "五月，癸丑，北宮掖廷中德陽殿及左掖門火，車駕移幸南宮。"
  },
  {
    "id": "s0152",
    "blockIndex": 31,
    "zh": "六月，改清河為甘陵。"
  },
  {
    "id": "s0152",
    "blockIndex": 31,
    "zh": "立安平孝王得子經侯理為甘陵王。"
  },
  {
    "id": "s0152",
    "blockIndex": 31,
    "zh": "奉孝德皇祀。"
  },
  {
    "id": "s0155",
    "blockIndex": 32,
    "zh": "秋，七月，京師大水。"
  },
  {
    "id": "s0156",
    "blockIndex": 33,
    "zh": "夏，四月，丁卯晦，日有食之。"
  },
  {
    "id": "s0157",
    "blockIndex": 34,
    "zh": "秋，八月，乙丑，有星孛於天市。"
  },
  {
    "id": "s0158",
    "blockIndex": 35,
    "zh": "京師大水。"
  },
  {
    "id": "s0159",
    "blockIndex": 36,
    "zh": "九月，己卯，地震。"
  },
  {
    "id": "s0159",
    "blockIndex": 36,
    "zh": "庚寅，地又震。"
  },
  {
    "id": "s0161",
    "blockIndex": 37,
    "zh": "郡、國五山崩。"
  },
  {
    "id": "s0161",
    "blockIndex": 37,
    "zh": "冬，十月，太尉趙戒免；"
  },
  {
    "id": "s0161",
    "blockIndex": 37,
    "zh": "以司徒袁湯為太尉，大司農河內張歆為司徒。"
  },
  {
    "id": "s0164",
    "blockIndex": 38,
    "zh": "是歲，前朗陵侯相荀淑卒。"
  },
  {
    "id": "s0164",
    "blockIndex": 38,
    "zh": "淑少博學有高行，當世名賢李固、李膺皆師宗之。"
  },
  {
    "id": "s0164",
    "blockIndex": 38,
    "zh": "在朗陵、蒞事明治，稱為神君。"
  },
  {
    "id": "s0164",
    "blockIndex": 38,
    "zh": "有子八人：儉、緄、靖、燾、汪、爽、肅、專，並有名稱，時人謂之八龍。"
  },
  {
    "id": "s0164",
    "blockIndex": 38,
    "zh": "所居裡舊名西豪，穎陰令渤海苑康以為昔高陽氏有才子八人，更命其裡曰高陽裡。"
  },
  {
    "id": "s0164",
    "blockIndex": 38,
    "zh": "膺性簡亢，無所交接，唯以淑為師，以同郡陳寔為友。"
  },
  {
    "id": "s0164",
    "blockIndex": 38,
    "zh": "荀爽嘗就謁膺，因為其御；"
  },
  {
    "id": "s0164",
    "blockIndex": 38,
    "zh": "既還，喜曰：「今日乃得御李君矣！"
  },
  {
    "id": "s0164",
    "blockIndex": 38,
    "zh": "」其見慕如此。"
  },
  {
    "id": "s0164",
    "blockIndex": 38,
    "zh": "陳寔出於單微，為郡西門亭長。"
  },
  {
    "id": "s0164",
    "blockIndex": 38,
    "zh": "同郡錘皓以篤行稱，前後九辟公府，年輩遠在寔前，引與為友。"
  },
  {
    "id": "s0164",
    "blockIndex": 38,
    "zh": "皓為郡功曹，辟司徒府；"
  },
  {
    "id": "s0164",
    "blockIndex": 38,
    "zh": "臨辭，太守問：「誰可代卿者？"
  },
  {
    "id": "s0164",
    "blockIndex": 38,
    "zh": "」皓曰：「明府欲必得其人，西門亭長陳寔可。"
  },
  {
    "id": "s0164",
    "blockIndex": 38,
    "zh": "」寔聞之曰：「鐘君似不察人，不知何獨識我！"
  },
  {
    "id": "s0164",
    "blockIndex": 38,
    "zh": "」太守遂以寔為功曹。"
  },
  {
    "id": "s0164",
    "blockIndex": 38,
    "zh": "時中常侍山陽侯覽托太守高倫用吏，倫教署為文學掾，寔知非其人，懷檄請見，言曰：「此人不宜用，而侯常侍不可違，寔乞從外署，不足以塵明德。"
  },
  {
    "id": "s0164",
    "blockIndex": 38,
    "zh": "」倫從之。"
  },
  {
    "id": "s0164",
    "blockIndex": 38,
    "zh": "於是鄉論怪其非舉，寔終無所言。"
  },
  {
    "id": "s0164",
    "blockIndex": 38,
    "zh": "倫後被征為尚書，郡中士大夫送至綸氏，倫謂眾人曰：「吾前為侯常侍用吏，陳君密持教還而於外白署，比聞議者以此少之，此咎由故人畏憚強禦，陳君可謂『善則稱君，過則稱己』者也。"
  },
  {
    "id": "s0164",
    "blockIndex": 38,
    "zh": "」寔固自引愆，聞者方歎息，由是天下服其德。"
  },
  {
    "id": "s0164",
    "blockIndex": 38,
    "zh": "後為太丘長，修德清靜，百姓以安。"
  },
  {
    "id": "s0164",
    "blockIndex": 38,
    "zh": "鄰縣民歸附者，寔輒訓導譬解發遣，各令還本。"
  },
  {
    "id": "s0164",
    "blockIndex": 38,
    "zh": "司官行部，吏慮民有訟者，白欲禁之。"
  },
  {
    "id": "s0164",
    "blockIndex": 38,
    "zh": "寔曰：「訟以求直，禁之，理將何申！"
  },
  {
    "id": "s0164",
    "blockIndex": 38,
    "zh": "其勿有所拘。"
  },
  {
    "id": "s0164",
    "blockIndex": 38,
    "zh": "」司官聞而歎息曰：「陳君所言若是，豈有冤於人乎！"
  },
  {
    "id": "s0164",
    "blockIndex": 38,
    "zh": "」亦竟無訟者。"
  },
  {
    "id": "s0164",
    "blockIndex": 38,
    "zh": "以沛相賦斂違法，解印綬去；"
  },
  {
    "id": "s0164",
    "blockIndex": 38,
    "zh": "吏民追思之。"
  },
  {
    "id": "s0164",
    "blockIndex": 38,
    "zh": "鐘皓素與荀淑齊名，李膺常歎曰：「荀君清識難尚，鐘君至德可師。"
  },
  {
    "id": "s0164",
    "blockIndex": 38,
    "zh": "」皓兄子瑾母，膺之姑也。"
  },
  {
    "id": "s0164",
    "blockIndex": 38,
    "zh": "瑾好學慕古，有退讓風，與膺同年，俱有聲名。"
  },
  {
    "id": "s0164",
    "blockIndex": 38,
    "zh": "膺祖太尉修常言：「瑾似我家性，『邦有道，不廢；"
  },
  {
    "id": "s0164",
    "blockIndex": 38,
    "zh": "邦無道，免於刑戮。"
  },
  {
    "id": "s0164",
    "blockIndex": 38,
    "zh": "』」復以膺妹妻之。"
  },
  {
    "id": "s0164",
    "blockIndex": 38,
    "zh": "膺謂瑾曰：「孟子以為『人無是非之心，非人也』，弟於是何太無皁白邪！"
  },
  {
    "id": "s0164",
    "blockIndex": 38,
    "zh": "」瑾嘗以膺言白皓。"
  },
  {
    "id": "s0164",
    "blockIndex": 38,
    "zh": "皓曰：「元禮祖、父在位，諸宗並盛，故得然乎！"
  },
  {
    "id": "s0164",
    "blockIndex": 38,
    "zh": "昔國武子好招人過，以致怨惡，今豈其時邪！"
  },
  {
    "id": "s0164",
    "blockIndex": 38,
    "zh": "必欲保身全家，爾道為貴。"
  },
  {
    "id": "s0206",
    "blockIndex": 39,
    "zh": "春，正月，甲子，赦天下。"
  },
  {
    "id": "s0206",
    "blockIndex": 39,
    "zh": "改元。"
  },
  {
    "id": "s0208",
    "blockIndex": 40,
    "zh": "乙丑，太后詔歸政於帝，始罷稱制。"
  },
  {
    "id": "s0208",
    "blockIndex": 40,
    "zh": "二月，甲寅，太后梁氏崩。"
  },
  {
    "id": "s0210",
    "blockIndex": 41,
    "zh": "三月，車駕徙幸北宮。"
  },
  {
    "id": "s0211",
    "blockIndex": 42,
    "zh": "甲午，葬順烈皇后。"
  },
  {
    "id": "s0211",
    "blockIndex": 42,
    "zh": "增封大將軍冀萬戶，並前合三萬戶；"
  },
  {
    "id": "s0211",
    "blockIndex": 42,
    "zh": "封冀妻孫壽為襄城君，兼食陽翟租，歲入五千萬，加賜赤紱，比長公主。"
  },
  {
    "id": "s0211",
    "blockIndex": 42,
    "zh": "壽善為妖態以蠱惑冀，冀甚寵憚之。"
  },
  {
    "id": "s0211",
    "blockIndex": 42,
    "zh": "冀愛監奴秦宮，官至太倉令，得出入壽所，威權大震，刺史、二千石皆謁辭之。"
  },
  {
    "id": "s0211",
    "blockIndex": 42,
    "zh": "冀與壽對街為宅，殫極土木，互相誇競，金玉珍怪，充積藏室；"
  },
  {
    "id": "s0211",
    "blockIndex": 42,
    "zh": "又廣開園圃，采土築山，十里九阪，深林絕澗，有若自然，奇禽馴獸飛走其間。"
  },
  {
    "id": "s0211",
    "blockIndex": 42,
    "zh": "冀、壽共乘輦車，遊觀第內，多從倡伎，酣謳竟路。"
  },
  {
    "id": "s0211",
    "blockIndex": 42,
    "zh": "或連日繼夜以聘娛恣。"
  },
  {
    "id": "s0211",
    "blockIndex": 42,
    "zh": "客到門不得通，皆請謝門者，門者累千金。"
  },
  {
    "id": "s0211",
    "blockIndex": 42,
    "zh": "又多拓林苑，周遍近縣，起兔苑於河南城西，經亙數十里，移檄所在調發生兔，刻其毛以為識，人有犯者，罪至死刑。"
  },
  {
    "id": "s0211",
    "blockIndex": 42,
    "zh": "嘗有西域賈胡不知禁忌，誤殺一兔，轉相告言，坐死者十餘人。"
  },
  {
    "id": "s0211",
    "blockIndex": 42,
    "zh": "又起別第於城西，以納奸亡；"
  },
  {
    "id": "s0211",
    "blockIndex": 42,
    "zh": "或取良人悉為奴婢，至數千口，名曰自賣人。"
  },
  {
    "id": "s0211",
    "blockIndex": 42,
    "zh": "冀用壽言，多斥奪諸梁在位者，外以示謙讓，而實崇孫氏。"
  },
  {
    "id": "s0211",
    "blockIndex": 42,
    "zh": "孫氏宗親冒名為侍中、卿、校、郡守、長吏者十餘人，皆貪饕凶淫，各遣私客籍屬縣富人，被以它罪，閉獄掠拷，使出錢自贖，貲物少者至於死、徙。"
  },
  {
    "id": "s0211",
    "blockIndex": 42,
    "zh": "扶風人士孫奮，居富而性吝，冀以馬乘遺之，從貸錢五千萬，奮以三千萬與之。"
  },
  {
    "id": "s0211",
    "blockIndex": 42,
    "zh": "冀大怒，乃告郡縣，認奮母為其守藏婢，雲盜白珠十斛、紫金千斤以叛，遂收考奮兄弟死於獄中，悉沒貲財億七千餘萬。"
  },
  {
    "id": "s0211",
    "blockIndex": 42,
    "zh": "冀又遣客周流四方，遠至塞外，廣求異物，而使人復乘勢橫暴，妻略婦女，驅擊吏卒，所在怨毒。"
  },
  {
    "id": "s0230",
    "blockIndex": 43,
    "zh": "侍御史朱穆自以冀故吏，奏記諫曰：「明將軍地有申伯之尊，位為群公之首，一日行善，天下歸仁；"
  },
  {
    "id": "s0230",
    "blockIndex": 43,
    "zh": "終朝為惡，四海傾覆。"
  },
  {
    "id": "s0230",
    "blockIndex": 43,
    "zh": "頃者官民俱匱，加以水蟲為害，京師諸官費用增多，詔書發調，或至十倍，各言官無見財，皆當出民，手旁掠割剝，強令充足。"
  },
  {
    "id": "s0230",
    "blockIndex": 43,
    "zh": "公賦既重，私斂又深，牧守長吏多非德選，貪聚無厭，遇民如虜，或絕命於棰楚之下，或自賊於迫切之求。"
  },
  {
    "id": "s0230",
    "blockIndex": 43,
    "zh": "又掠奪百姓，皆托之尊府，遂令將軍結怨天下，吏民酸毒，道路歎嗟。"
  },
  {
    "id": "s0230",
    "blockIndex": 43,
    "zh": "昔永和之末，綱紀少弛，頗失人望，四五歲耳，而財空戶散，下有離心，馬勉之徒乘敝而起，荊、揚之間幾成大患；"
  },
  {
    "id": "s0230",
    "blockIndex": 43,
    "zh": "幸賴順烈皇后初政清靜，內外同力，僅乃討定。"
  },
  {
    "id": "s0230",
    "blockIndex": 43,
    "zh": "今百姓戚戚，困於永和，內非仁愛之心可得容忍，外非守國之計所宜久安也。"
  },
  {
    "id": "s0230",
    "blockIndex": 43,
    "zh": "夫將相大臣，均體元首，共輿而馳，同舟而濟，輿傾舟覆，患實共之。"
  },
  {
    "id": "s0230",
    "blockIndex": 43,
    "zh": "豈可以去明即昧，履危自安，主孤時困而莫之恤乎！"
  },
  {
    "id": "s0230",
    "blockIndex": 43,
    "zh": "宜時易宰守非其人者，減省第宅園池之費，拒絕郡國諸所奉送，內以自明，外解人惑；"
  },
  {
    "id": "s0230",
    "blockIndex": 43,
    "zh": "使挾奸之吏無所依托，司察之臣得盡耳目。"
  },
  {
    "id": "s0230",
    "blockIndex": 43,
    "zh": "憲度既張，遠邇清壹，則將軍身尊事顯，德燿無窮矣！"
  },
  {
    "id": "s0230",
    "blockIndex": 43,
    "zh": "」冀不納。"
  },
  {
    "id": "s0230",
    "blockIndex": 43,
    "zh": "冀雖專朝縱橫，而猶交結左右宦官，任其子弟、賓客以為州郡要職，欲以自固恩寵。"
  },
  {
    "id": "s0230",
    "blockIndex": 43,
    "zh": "穆又奏記極諫，冀終不悟，報書云：「如此，僕亦無一可邪！"
  },
  {
    "id": "s0230",
    "blockIndex": 43,
    "zh": "」然素重穆，亦不甚罪也。"
  },
  {
    "id": "s0247",
    "blockIndex": 44,
    "zh": "冀遣書詣樂安太守陳蕃，有所請托，不得通。"
  },
  {
    "id": "s0247",
    "blockIndex": 44,
    "zh": "使者詐稱它客求謁蕃；"
  },
  {
    "id": "s0247",
    "blockIndex": 44,
    "zh": "蕃怒，笞殺之。"
  },
  {
    "id": "s0247",
    "blockIndex": 44,
    "zh": "坐左轉修武令。"
  },
  {
    "id": "s0247",
    "blockIndex": 44,
    "zh": "時皇子有疾，下郡縣市珍藥，而冀遣客繼書詣京兆，並貨牛黃。"
  },
  {
    "id": "s0247",
    "blockIndex": 44,
    "zh": "京兆尹南陽延篤發書收客，曰：「大將軍椒房外家，而皇子有疾，必應陳進醫方，豈當使客千里求利乎！"
  },
  {
    "id": "s0247",
    "blockIndex": 44,
    "zh": "」遂殺之。"
  },
  {
    "id": "s0247",
    "blockIndex": 44,
    "zh": "冀慚而不得言。"
  },
  {
    "id": "s0247",
    "blockIndex": 44,
    "zh": "有司承旨求其事，篤以病免。"
  },
  {
    "id": "s0247",
    "blockIndex": 44,
    "zh": "夏，五月，庚辰，尊博園匽貴人曰孝崇後，宮曰永樂；"
  },
  {
    "id": "s0247",
    "blockIndex": 44,
    "zh": "置太僕、少府以下，皆如長樂宮故事。"
  },
  {
    "id": "s0247",
    "blockIndex": 44,
    "zh": "分巨鹿九縣為後湯沐邑。"
  },
  {
    "id": "s0259",
    "blockIndex": 45,
    "zh": "秋，七月，梓潼山崩。"
  },
  {
    "id": "s0260",
    "blockIndex": 46,
    "zh": "春，正月朔，群臣朝賀，大將軍冀帶劍入省。"
  },
  {
    "id": "s0260",
    "blockIndex": 46,
    "zh": "尚書蜀郡張陵呵叱令出，敕羽林、虎賁奪劍。"
  },
  {
    "id": "s0260",
    "blockIndex": 46,
    "zh": "冀跪謝，陵不應，即劾奏冀，請廷尉論罪。"
  },
  {
    "id": "s0260",
    "blockIndex": 46,
    "zh": "有詔，以一歲俸贖；"
  },
  {
    "id": "s0260",
    "blockIndex": 46,
    "zh": "百僚肅然。"
  },
  {
    "id": "s0260",
    "blockIndex": 46,
    "zh": "河南尹不疑嘗舉陵孝廉，乃謂陵曰：「昔舉君，適所以自罰也！"
  },
  {
    "id": "s0260",
    "blockIndex": 46,
    "zh": "」陵曰：「明府不以陵不肖，誤見擢序，今申公憲以報私恩！"
  },
  {
    "id": "s0260",
    "blockIndex": 46,
    "zh": "」不疑有愧色。"
  },
  {
    "id": "s0268",
    "blockIndex": 47,
    "zh": "癸酉，赦天下，改元。"
  },
  {
    "id": "s0269",
    "blockIndex": 48,
    "zh": "梁不疑好經書，喜待士，梁冀疾之，轉不疑為光祿勳；"
  },
  {
    "id": "s0269",
    "blockIndex": 48,
    "zh": "以其子胤為河南尹。"
  },
  {
    "id": "s0269",
    "blockIndex": 48,
    "zh": "胤年十六，客貌甚陋，不勝冠帶，道路見者莫不蚩笑。"
  },
  {
    "id": "s0269",
    "blockIndex": 48,
    "zh": "不疑自恥兄弟有隙，遂讓位歸第，與弟蒙閉門自守。"
  },
  {
    "id": "s0269",
    "blockIndex": 48,
    "zh": "冀不欲令與賓客交通，陰使人變服至門，記往來者。"
  },
  {
    "id": "s0269",
    "blockIndex": 48,
    "zh": "南郡太守馬融、江夏太守田明初除，守謁不疑；"
  },
  {
    "id": "s0269",
    "blockIndex": 48,
    "zh": "冀諷有司奏融在郡貪濁，及以它事陷明，皆髡笞徙朔方。"
  },
  {
    "id": "s0269",
    "blockIndex": 48,
    "zh": "融自刺不殊，明遂死於路。"
  },
  {
    "id": "s0277",
    "blockIndex": 49,
    "zh": "夏，四月，己丑，上微行，幸河南尹梁胤府捨。"
  },
  {
    "id": "s0277",
    "blockIndex": 49,
    "zh": "是日，大風拔樹，晝昏。"
  },
  {
    "id": "s0277",
    "blockIndex": 49,
    "zh": "尚書楊秉上疏曰：「臣聞天下言語，以災異譴告。"
  },
  {
    "id": "s0277",
    "blockIndex": 49,
    "zh": "王者至尊，出入有常，警蹕而行，靜室而止，自非郊廟之事，則鑾旗不駕。"
  },
  {
    "id": "s0277",
    "blockIndex": 49,
    "zh": "故諸侯入諸臣之家，《春秋》尚列其誡；"
  },
  {
    "id": "s0277",
    "blockIndex": 49,
    "zh": "況於以先王法服而私出槃游，降亂尊卑，等威無序，侍衛守空宮，璽紱委女妾！"
  },
  {
    "id": "s0277",
    "blockIndex": 49,
    "zh": "設有非常之變，任章之謀，上負先帝，下悔靡及！"
  },
  {
    "id": "s0277",
    "blockIndex": 49,
    "zh": "」帝不納。"
  },
  {
    "id": "s0277",
    "blockIndex": 49,
    "zh": "秉，震之子也。"
  },
  {
    "id": "s0286",
    "blockIndex": 50,
    "zh": "京師旱，任城、梁國饑，民相食。"
  },
  {
    "id": "s0287",
    "blockIndex": 51,
    "zh": "司徒張歆罷，以光祿勳吳雄為司徒。"
  },
  {
    "id": "s0288",
    "blockIndex": 52,
    "zh": "北匈奴呼銜王寇伊吾，敗伊吾司馬毛愷，攻伊吾屯城。"
  },
  {
    "id": "s0288",
    "blockIndex": 52,
    "zh": "詔敦煌太守馬達將兵救之；"
  },
  {
    "id": "s0288",
    "blockIndex": 52,
    "zh": "至蒲類海，呼衍王引去。"
  },
  {
    "id": "s0291",
    "blockIndex": 53,
    "zh": "秋，七月，武陵蠻反。"
  },
  {
    "id": "s0292",
    "blockIndex": 54,
    "zh": "冬，十月，司空胡廣致仕。"
  },
  {
    "id": "s0293",
    "blockIndex": 55,
    "zh": "十一月，辛巳，京師地震。"
  },
  {
    "id": "s0293",
    "blockIndex": 55,
    "zh": "詔百官舉獨行之士。"
  },
  {
    "id": "s0293",
    "blockIndex": 55,
    "zh": "涿郡舉崔寔，詣公車，稱病，不對策；"
  },
  {
    "id": "s0293",
    "blockIndex": 55,
    "zh": "退而論世事，名曰《政論》。"
  },
  {
    "id": "s0293",
    "blockIndex": 55,
    "zh": "其辭曰：「凡天下所以不治者，常由人主承平日久，俗漸敝而不悟，政浸衰而不改，習亂安危，怢不自睹。"
  },
  {
    "id": "s0293",
    "blockIndex": 55,
    "zh": "或荒耽耆欲，不恤萬機；"
  },
  {
    "id": "s0293",
    "blockIndex": 55,
    "zh": "或耳蔽箴誨，厭偽忽真；"
  },
  {
    "id": "s0293",
    "blockIndex": 55,
    "zh": "或猶豫歧路，莫適所以；"
  },
  {
    "id": "s0293",
    "blockIndex": 55,
    "zh": "或見信之佐，括囊守祿；"
  },
  {
    "id": "s0293",
    "blockIndex": 55,
    "zh": "或疏遠之臣，言以賤廢。"
  },
  {
    "id": "s0293",
    "blockIndex": 55,
    "zh": "是以王綱縱弛於上，智士郁伊于下。"
  },
  {
    "id": "s0293",
    "blockIndex": 55,
    "zh": "悲夫！"
  },
  {
    "id": "s0293",
    "blockIndex": 55,
    "zh": "自漢興以來，三百五十餘歲矣，政令垢玩，上下怠懈，百姓囂然，鹹復思中興之救矣！"
  },
  {
    "id": "s0293",
    "blockIndex": 55,
    "zh": "且濟時拯世之術，在於補衣定決壞，枝拄邪傾，隨形裁割，要措斯世於安寧之域而已。"
  },
  {
    "id": "s0293",
    "blockIndex": 55,
    "zh": "故聖人執權，遭時定制，步驟之差，各有雲設，不強人以不能，背急切而慕所聞也。"
  },
  {
    "id": "s0293",
    "blockIndex": 55,
    "zh": "蓋孔子對葉公以來遠，哀公以臨人，景公以節禮，非其不同，所急異務也。"
  },
  {
    "id": "s0293",
    "blockIndex": 55,
    "zh": "俗人拘文牽占，不達權制，奇偉所聞，簡忽所見，烏可與論國家之大事哉！"
  },
  {
    "id": "s0293",
    "blockIndex": 55,
    "zh": "故言事者雖合聖德，輒見掎奪。"
  },
  {
    "id": "s0293",
    "blockIndex": 55,
    "zh": "何者？"
  },
  {
    "id": "s0293",
    "blockIndex": 55,
    "zh": "其頑士暗於時權，安習所見，不知樂成，況可慮始，苟雲率由舊章而已。"
  },
  {
    "id": "s0293",
    "blockIndex": 55,
    "zh": "其達者或矜名妒能，恥策非己，舞筆奮辭以破其義。"
  },
  {
    "id": "s0293",
    "blockIndex": 55,
    "zh": "寡不勝眾，遂見擯棄，雖稷、契復存，猶將困焉。"
  },
  {
    "id": "s0293",
    "blockIndex": 55,
    "zh": "斯賢智之論所以常憤郁而不伸者也。"
  },
  {
    "id": "s0316",
    "blockIndex": 56,
    "zh": "「凡為天下者，自非上德，嚴之則治，寬之則亂。"
  },
  {
    "id": "s0316",
    "blockIndex": 56,
    "zh": "何以明其然也？"
  },
  {
    "id": "s0316",
    "blockIndex": 56,
    "zh": "近孝宣皇帝明於君人之道，審於為政之理，故嚴刑峻法，破奸軌之膽，海內清肅，天下密如，逄計見效，優於孝文。"
  },
  {
    "id": "s0316",
    "blockIndex": 56,
    "zh": "及元帝即位，多行寬政，卒以墮損，威權始奪，遂為漢室基禍之主。"
  },
  {
    "id": "s0316",
    "blockIndex": 56,
    "zh": "政道得失，於斯可鑒。"
  },
  {
    "id": "s0316",
    "blockIndex": 56,
    "zh": "昔孔子作《春秋》，褒齊桓，懿晉文，歎管仲之功，夫豈不美文、武之道哉？"
  },
  {
    "id": "s0316",
    "blockIndex": 56,
    "zh": "誠達權救敝之理也。"
  },
  {
    "id": "s0316",
    "blockIndex": 56,
    "zh": "故聖人能與世推移，而俗士苦不知變，以為結繩之約，可復治亂秦之緒；"
  },
  {
    "id": "s0316",
    "blockIndex": 56,
    "zh": "干戚之舞，足以解平城之圍。"
  },
  {
    "id": "s0316",
    "blockIndex": 56,
    "zh": "夫熊經鳥伸，雖延歷之術，非傷寒之理；"
  },
  {
    "id": "s0316",
    "blockIndex": 56,
    "zh": "呼吸吐納，雖度紀之道，非續骨之膏。"
  },
  {
    "id": "s0316",
    "blockIndex": 56,
    "zh": "蓋為國之法，有似治身，平則致養，疾則攻焉。"
  },
  {
    "id": "s0316",
    "blockIndex": 56,
    "zh": "夫刑罰者，治亂之藥石也；"
  },
  {
    "id": "s0316",
    "blockIndex": 56,
    "zh": "德教者，興平之粱肉也。"
  },
  {
    "id": "s0316",
    "blockIndex": 56,
    "zh": "夫以德教除殘，是以粱肉治疾也；"
  },
  {
    "id": "s0316",
    "blockIndex": 56,
    "zh": "以刑罰治平，是以藥石供養也。"
  },
  {
    "id": "s0316",
    "blockIndex": 56,
    "zh": "方今承百王之敝，值厄運之會，自數世以來，政多恩貸，馭委其轡。"
  },
  {
    "id": "s0316",
    "blockIndex": 56,
    "zh": "馬駘其銜，四牡橫奔，皇路險傾，方將拑勒鞬輈以救之，豈暇鳴和鑾，請節奏哉！"
  },
  {
    "id": "s0316",
    "blockIndex": 56,
    "zh": "昔文帝雖除肉刑，當斬右趾者棄市，笞者往往至死。"
  },
  {
    "id": "s0316",
    "blockIndex": 56,
    "zh": "是文帝以嚴致平，非以寬致平也。"
  },
  {
    "id": "s0316",
    "blockIndex": 56,
    "zh": "」寔，瑗之子也。"
  },
  {
    "id": "s0316",
    "blockIndex": 56,
    "zh": "山陽仲長統嘗見其書，歎曰：「凡為人主，宜寫一通，置之坐側。"
  },
  {
    "id": "s0339",
    "blockIndex": 57,
    "zh": "══臣光曰：漢家之法已嚴矣，而崔寔猶病其寬，何哉？"
  },
  {
    "id": "s0339",
    "blockIndex": 57,
    "zh": "蓋衰世之君，率多柔懦，凡愚之佐，唯知姑息，是以權幸之臣有罪不坐，豪猾之民犯法不誅；"
  },
  {
    "id": "s0339",
    "blockIndex": 57,
    "zh": "仁恩所施，止於目前；"
  },
  {
    "id": "s0339",
    "blockIndex": 57,
    "zh": "奸宄得志，紀綱不立。"
  },
  {
    "id": "s0339",
    "blockIndex": 57,
    "zh": "故崔寔之論，以矯一時之枉，非百世之通義也。"
  },
  {
    "id": "s0339",
    "blockIndex": 57,
    "zh": "孔子曰：「政寬則民慢，慢則糾之以猛；"
  },
  {
    "id": "s0339",
    "blockIndex": 57,
    "zh": "猛則民殘，殘則施之以寬。"
  },
  {
    "id": "s0339",
    "blockIndex": 57,
    "zh": "寬以濟猛，猛以濟寬，政是以和。"
  },
  {
    "id": "s0339",
    "blockIndex": 57,
    "zh": "」斯不易之常道矣。"
  },
  {
    "id": "s0348",
    "blockIndex": 58,
    "zh": "閏月，庚午，任城節王崇薨；"
  },
  {
    "id": "s0348",
    "blockIndex": 58,
    "zh": "無子，國絕。"
  },
  {
    "id": "s0350",
    "blockIndex": 59,
    "zh": "以太常黃瓊為司空。"
  },
  {
    "id": "s0351",
    "blockIndex": 60,
    "zh": "帝欲褒崇梁冀，使中朝二千石以上會議其禮。"
  },
  {
    "id": "s0351",
    "blockIndex": 60,
    "zh": "特進胡廣、太常羊浦、司隸校尉祝恬、太中大夫邊韶等咸稱冀之勳德宜比周公，錫之山川、土田、附庸。"
  },
  {
    "id": "s0351",
    "blockIndex": 60,
    "zh": "黃瓊獨曰：「冀前以親迎之勞，增邑成三千戶；"
  },
  {
    "id": "s0351",
    "blockIndex": 60,
    "zh": "又其子胤亦加封賞。"
  },
  {
    "id": "s0351",
    "blockIndex": 60,
    "zh": "今諸侯以戶邑為制，不以裡數為限，冀可比鄧禹，合食四縣。"
  },
  {
    "id": "s0351",
    "blockIndex": 60,
    "zh": "」朝廷從之。"
  },
  {
    "id": "s0351",
    "blockIndex": 60,
    "zh": "於是有司奏：「冀入朝不趨，劍履上殿，謁贊不名，禮儀比蕭何；"
  },
  {
    "id": "s0351",
    "blockIndex": 60,
    "zh": "悉以定陶、陽成餘戶增封為四縣，比鄧禹；"
  },
  {
    "id": "s0351",
    "blockIndex": 60,
    "zh": "賞賜金錢、奴婢、彩帛、車馬、衣服、甲第，比霍光；"
  },
  {
    "id": "s0351",
    "blockIndex": 60,
    "zh": "以殊元勳。"
  },
  {
    "id": "s0351",
    "blockIndex": 60,
    "zh": "每朝會，與三會絕席。"
  },
  {
    "id": "s0351",
    "blockIndex": 60,
    "zh": "十日一入，平尚書事。"
  },
  {
    "id": "s0351",
    "blockIndex": 60,
    "zh": "宣佈天下，為萬世法。"
  },
  {
    "id": "s0351",
    "blockIndex": 60,
    "zh": "」冀猶以所奏禮簿，意不悅。"
  },
  {
    "id": "s0365",
    "blockIndex": 61,
    "zh": "春，正月，西域長史王敬為於窴所殺。"
  },
  {
    "id": "s0365",
    "blockIndex": 61,
    "zh": "初，西域長史趙評在於窴，病癰死。"
  },
  {
    "id": "s0365",
    "blockIndex": 61,
    "zh": "評子迎喪，道經拘彌。"
  },
  {
    "id": "s0365",
    "blockIndex": 61,
    "zh": "拘彌王成國與於窴王建素有隙，謂評子曰：「於窴王令胡醫持毒藥著創中，故致死耳！"
  },
  {
    "id": "s0365",
    "blockIndex": 61,
    "zh": "」評子信之，還，以告敦煌太守馬達。"
  },
  {
    "id": "s0365",
    "blockIndex": 61,
    "zh": "會敬代為長史，馬達令敬隱核於窴事。"
  },
  {
    "id": "s0365",
    "blockIndex": 61,
    "zh": "敬先過拘彌，成國復說雲。"
  },
  {
    "id": "s0365",
    "blockIndex": 61,
    "zh": "「於窴國人欲以我為王；"
  },
  {
    "id": "s0365",
    "blockIndex": 61,
    "zh": "今可因此罪誅建，於窴必服矣。"
  },
  {
    "id": "s0365",
    "blockIndex": 61,
    "zh": "」敬貪立功名，前到於窴，設供具，請建而陰圖之。"
  },
  {
    "id": "s0365",
    "blockIndex": 61,
    "zh": "或以敬謀告建，建不信，曰：「我無罪，王長史何為欲殺我？"
  },
  {
    "id": "s0365",
    "blockIndex": 61,
    "zh": "」旦日，建從官屬數十人詣敬，坐定，建起行酒，敬叱左右執之。"
  },
  {
    "id": "s0365",
    "blockIndex": 61,
    "zh": "吏士並無殺建意，官屬悉得突走。"
  },
  {
    "id": "s0365",
    "blockIndex": 61,
    "zh": "時成國主簿秦牧隨敬在會，持刀出，曰：「大事已定，何為復疑！"
  },
  {
    "id": "s0365",
    "blockIndex": 61,
    "zh": "」即前斬建。"
  },
  {
    "id": "s0365",
    "blockIndex": 61,
    "zh": "於窴侯、將輸僰等遂會兵攻敬，敬持建頭上樓宣告曰：「天子使我誅建耳！"
  },
  {
    "id": "s0365",
    "blockIndex": 61,
    "zh": "」輸僰不聽，上樓斬敬，懸首於市。"
  },
  {
    "id": "s0365",
    "blockIndex": 61,
    "zh": "輸僰自立為王；"
  },
  {
    "id": "s0365",
    "blockIndex": 61,
    "zh": "國人殺之，而立建子安國。"
  },
  {
    "id": "s0365",
    "blockIndex": 61,
    "zh": "馬達聞王敬死，欲將諸郡兵出塞擊於窴；"
  },
  {
    "id": "s0365",
    "blockIndex": 61,
    "zh": "帝不聽，征達還，而以宋亮代為敦煌太守。"
  },
  {
    "id": "s0365",
    "blockIndex": 61,
    "zh": "亮到，開募於窴，令自斬輸僰；"
  },
  {
    "id": "s0365",
    "blockIndex": 61,
    "zh": "時輸僰死已經月，乃斷死人頭送敦煌而不言其狀，亮後知其詐，而竟不能討也。"
  },
  {
    "id": "s0388",
    "blockIndex": 62,
    "zh": "丙辰，京師地震。"
  },
  {
    "id": "s0389",
    "blockIndex": 63,
    "zh": "夏，四月，甲辰，孝崇皇后匽氏崩；"
  },
  {
    "id": "s0389",
    "blockIndex": 63,
    "zh": "以帝弟平原王石為喪主，斂送制度比恭懷皇后。"
  },
  {
    "id": "s0389",
    "blockIndex": 63,
    "zh": "五月，辛卯，葬於博陵。"
  },
  {
    "id": "s0392",
    "blockIndex": 64,
    "zh": "秋，七月，庚辰，日有食之。"
  },
  {
    "id": "s0393",
    "blockIndex": 65,
    "zh": "冬，十月，乙亥，京師地震。"
  },
  {
    "id": "s0394",
    "blockIndex": 66,
    "zh": "十一月，司空黃瓊免。"
  },
  {
    "id": "s0394",
    "blockIndex": 66,
    "zh": "十二月，以特進趙戒為司空。"
  },
  {
    "id": "s0396",
    "blockIndex": 67,
    "zh": "春，三月，丁亥，帝幸鴻池。"
  },
  {
    "id": "s0397",
    "blockIndex": 68,
    "zh": "夏，四月，丙申，赦天下，改元。"
  },
  {
    "id": "s0398",
    "blockIndex": 69,
    "zh": "丁酉，濟南悼王廣薨；"
  },
  {
    "id": "s0398",
    "blockIndex": 69,
    "zh": "無子，國除。"
  },
  {
    "id": "s0400",
    "blockIndex": 70,
    "zh": "秋，七月，郡、國三十二蝗，河水溢。"
  },
  {
    "id": "s0400",
    "blockIndex": 70,
    "zh": "百姓饑窮流冗者數十萬戶，冀州尤甚。"
  },
  {
    "id": "s0400",
    "blockIndex": 70,
    "zh": "詔以侍御史朱穆為冀州刺史。"
  },
  {
    "id": "s0400",
    "blockIndex": 70,
    "zh": "冀部令長聞穆濟河，解印綬去者四十餘人。"
  },
  {
    "id": "s0400",
    "blockIndex": 70,
    "zh": "及到，奏劾諸郡貪污者，有至自殺，或死獄中。"
  },
  {
    "id": "s0400",
    "blockIndex": 70,
    "zh": "宦者趙忠喪父，歸葬安平，僭為玉匣；"
  },
  {
    "id": "s0400",
    "blockIndex": 70,
    "zh": "穆下郡案驗，吏畏其嚴，遂發墓剖棺，陳屍出之。"
  },
  {
    "id": "s0400",
    "blockIndex": 70,
    "zh": "帝聞，大怒，征穆詣廷尉，輸作左校。"
  },
  {
    "id": "s0400",
    "blockIndex": 70,
    "zh": "太學書生穎川劉陶等數千人詣闕上書訟穆曰：「伏見弛刑徒朱穆，處公憂國，拜州之日，志清奸惡。"
  },
  {
    "id": "s0400",
    "blockIndex": 70,
    "zh": "誠以常侍貴寵，父兄子弟布在州郡，競為虎狼，噬食小民，故穆張理天綱，補綴漏目，羅取殘禍，以塞天意。"
  },
  {
    "id": "s0400",
    "blockIndex": 70,
    "zh": "由是內官鹹共恚疾，謗讟煩興，讒隙仍作，極其刑謫，輸作左校。"
  },
  {
    "id": "s0400",
    "blockIndex": 70,
    "zh": "天下有識，皆以穆同勤禹、稷而被共、鯀之戾，若死者有知，則唐帝怒於崇山，重華忿於蒼墓矣！"
  },
  {
    "id": "s0400",
    "blockIndex": 70,
    "zh": "當今中官近習，竊持國柄，手握王爵，口銜天憲，運賞則使餓隸富於季孫，呼吸則令伊、顏化為桀、跖；"
  },
  {
    "id": "s0400",
    "blockIndex": 70,
    "zh": "而穆獨亢然不顧身害，非惡榮而好辱，惡生而好死也，徒感王綱之不攝，懼天網之久失，故竭心懷憂，為上深計。"
  },
  {
    "id": "s0400",
    "blockIndex": 70,
    "zh": "臣願黥首系趾，代穆校作。"
  },
  {
    "id": "s0400",
    "blockIndex": 70,
    "zh": "」帝覽其奏，乃赦之。"
  },
  {
    "id": "s0416",
    "blockIndex": 71,
    "zh": "冬，十月，太尉袁湯免，以太常胡廣為太尉。"
  },
  {
    "id": "s0416",
    "blockIndex": 71,
    "zh": "司徒吳雄、司空趙戒免。"
  },
  {
    "id": "s0416",
    "blockIndex": 71,
    "zh": "以太僕黃瓊為司徒，光祿勳房植為司空。"
  },
  {
    "id": "s0419",
    "blockIndex": 72,
    "zh": "武陵蠻詹山等反，武陵太守汝南應奉招降之。"
  },
  {
    "id": "s0420",
    "blockIndex": 73,
    "zh": "車師後部王阿羅多與戊部候嚴皓不相得，忿戾而反，攻圍屯田，殺傷吏士。"
  },
  {
    "id": "s0420",
    "blockIndex": 73,
    "zh": "後部侯炭遮領餘民畔阿羅多，詣漢吏降。"
  },
  {
    "id": "s0420",
    "blockIndex": 73,
    "zh": "阿羅多迫急，從百餘騎亡入北匈奴。"
  },
  {
    "id": "s0420",
    "blockIndex": 73,
    "zh": "敦煌太守宋亮上立後部故王軍就質子卑君為王。"
  },
  {
    "id": "s0420",
    "blockIndex": 73,
    "zh": "後阿羅多復從匈奴中還，與卑君爭國，頗收其國人。"
  },
  {
    "id": "s0420",
    "blockIndex": 73,
    "zh": "戊校尉閻詳慮其招引北虜，將亂西域，乃開信告示，許復為王；"
  },
  {
    "id": "s0420",
    "blockIndex": 73,
    "zh": "阿羅多及詣詳降。"
  },
  {
    "id": "s0420",
    "blockIndex": 73,
    "zh": "於是更立阿羅多為王，將卑君還敦煌，以後部人三百帳與之。"
  },
  {
    "id": "s0428",
    "blockIndex": 74,
    "zh": "春，正月，甲午，赦天下。"
  },
  {
    "id": "s0429",
    "blockIndex": 75,
    "zh": "二月，辛丑，復聽刺史、二千石行三年喪。"
  },
  {
    "id": "s0430",
    "blockIndex": 76,
    "zh": "癸卯，京師地震。"
  },
  {
    "id": "s0431",
    "blockIndex": 77,
    "zh": "夏，蝗。"
  },
  {
    "id": "s0432",
    "blockIndex": 78,
    "zh": "東海朐山崩。"
  },
  {
    "id": "s0433",
    "blockIndex": 79,
    "zh": "乙卯，封乳母馬惠子初為列候。"
  },
  {
    "id": "s0434",
    "blockIndex": 80,
    "zh": "秋，九月，丁卯朔，日有食之。"
  },
  {
    "id": "s0435",
    "blockIndex": 81,
    "zh": "太尉胡廣免；"
  },
  {
    "id": "s0435",
    "blockIndex": 81,
    "zh": "以司徒黃瓊為太尉。"
  },
  {
    "id": "s0435",
    "blockIndex": 81,
    "zh": "閏月，以光祿勳尹頌為司徒。"
  },
  {
    "id": "s0438",
    "blockIndex": 82,
    "zh": "冬，十一月，甲辰，帝校獵上林苑，遂至函谷關。"
  },
  {
    "id": "s0439",
    "blockIndex": 83,
    "zh": "泰山、琅邪賊公孫舉、東郭竇等反，殺長吏。"
  },
  {
    "id": "s0440",
    "blockIndex": 84,
    "zh": "春，正月，戊申，赦天下，改元。"
  },
  {
    "id": "s0441",
    "blockIndex": 85,
    "zh": "二月，司隸、冀州饑，人相食。"
  },
  {
    "id": "s0442",
    "blockIndex": 86,
    "zh": "太學生劉陶上疏陳事曰：「夫天之與帝，帝之與民，猶頭之與足，相須而行也。"
  },
  {
    "id": "s0442",
    "blockIndex": 86,
    "zh": "陛下目不視鳴條之事，耳不聞檀車之聲，天災不有痛於肌膚，震食不即損於聖體，故蔑三光之謬，輕上天之怒。"
  },
  {
    "id": "s0442",
    "blockIndex": 86,
    "zh": "伏念高祖之起，始自布衣，合散扶傷，克成帝業，勤亦至矣；"
  },
  {
    "id": "s0442",
    "blockIndex": 86,
    "zh": "流福遺祚，至於陛下。"
  },
  {
    "id": "s0442",
    "blockIndex": 86,
    "zh": "陛下既不能增明烈考之軌，而忽高祖之勤，妄假利器，委授國柄，使群丑刑隸，芟刈小民，虎豹窟於鏖場，豺狼乳於春囿，貨殖者為窮冤之魂，貧餒者作饑寒之鬼，死者悲於窀穸，生者戚於朝野，是愚臣所為咨嗟長懷歎息者也！"
  },
  {
    "id": "s0442",
    "blockIndex": 86,
    "zh": "且秦之將亡，正諫者誅，諛進者賞，嘉言結於忠舌，國命出於讒口，擅閻樂於咸陽，授趙高以車府，權去己而不知，威離身而不顧。"
  },
  {
    "id": "s0442",
    "blockIndex": 86,
    "zh": "古今一揆，成敗同勢，願陛下遠覽強秦之傾，近察哀、平之變，得失昭然，禍福可見。"
  },
  {
    "id": "s0442",
    "blockIndex": 86,
    "zh": "臣又聞危非仁不扶，亂非智不救。"
  },
  {
    "id": "s0442",
    "blockIndex": 86,
    "zh": "竊見故冀州刺史南陽朱穆、前烏桓校尉臣同郡李膺，皆履正清平，貞高絕俗，斯實中興之良佐，國家之柱臣也，宜還本朝，挾輔王室。"
  },
  {
    "id": "s0442",
    "blockIndex": 86,
    "zh": "臣敢吐不時之義於諱言之朝，猶冰霜見日，必至消滅。"
  },
  {
    "id": "s0442",
    "blockIndex": 86,
    "zh": "臣始悲天下之可悲，今天下亦悲臣之愚惑也。"
  },
  {
    "id": "s0442",
    "blockIndex": 86,
    "zh": "」書奏，不省。"
  },
  {
    "id": "s0454",
    "blockIndex": 87,
    "zh": "夏，南陽大水。"
  },
  {
    "id": "s0455",
    "blockIndex": 88,
    "zh": "司空房植免；"
  },
  {
    "id": "s0455",
    "blockIndex": 88,
    "zh": "以太常韓縯為司空。"
  },
  {
    "id": "s0457",
    "blockIndex": 89,
    "zh": "巴郡、益州郡山崩。"
  },
  {
    "id": "s0458",
    "blockIndex": 90,
    "zh": "秋，南匈奴左薁鞬台耆、且渠伯德等反，寇美稷；"
  },
  {
    "id": "s0458",
    "blockIndex": 90,
    "zh": "東羌復舉種應之。"
  },
  {
    "id": "s0458",
    "blockIndex": 90,
    "zh": "安定屬國都尉敦煌張奐初到職，壁中唯有二百許人，聞之，即勒兵而出；"
  },
  {
    "id": "s0458",
    "blockIndex": 90,
    "zh": "軍吏以為力不敵，叩頭爭止之。"
  },
  {
    "id": "s0458",
    "blockIndex": 90,
    "zh": "奐不聽，遂進屯長城，收集兵士，遣將王衛招誘東羌，因據龜茲縣，使南匈奴不得交通。"
  },
  {
    "id": "s0458",
    "blockIndex": 90,
    "zh": "東羌諸豪遂相率與奐共擊薁鞬等，破之。"
  },
  {
    "id": "s0458",
    "blockIndex": 90,
    "zh": "伯德惶恐，將其眾降，郡界以寧。"
  },
  {
    "id": "s0458",
    "blockIndex": 90,
    "zh": "羌豪遺奐馬二十匹，金鐻八枚。"
  },
  {
    "id": "s0458",
    "blockIndex": 90,
    "zh": "奐於諸羌前以酒酹地曰：「使馬如羊，不以入廄；"
  },
  {
    "id": "s0458",
    "blockIndex": 90,
    "zh": "使金如粟，不以入懷。"
  },
  {
    "id": "s0458",
    "blockIndex": 90,
    "zh": "」悉以還之。"
  },
  {
    "id": "s0458",
    "blockIndex": 90,
    "zh": "前此八都尉率好財貨，為羌所患苦；"
  },
  {
    "id": "s0458",
    "blockIndex": 90,
    "zh": "及奐正身潔己，無不悅服，威化大行。"
  },
  {
    "id": "s0471",
    "blockIndex": 91,
    "zh": "春，三月，蜀郡屬國夷反。"
  },
  {
    "id": "s0472",
    "blockIndex": 92,
    "zh": "初，鮮卑檀石槐，勇健有智略，部落畏服，乃施法禁，平曲直，無敢犯者，遂推以為大人。"
  },
  {
    "id": "s0472",
    "blockIndex": 92,
    "zh": "檀石槐立庭於彈汙山、歠仇水上，去高柳北三百餘里，兵馬甚盛；"
  },
  {
    "id": "s0472",
    "blockIndex": 92,
    "zh": "東、西部大人皆歸焉。"
  },
  {
    "id": "s0472",
    "blockIndex": 92,
    "zh": "因南抄緣邊，北拒丁零，東卻夫餘，西擊烏孫，盡據匈奴故地，東西萬四千餘里。"
  },
  {
    "id": "s0472",
    "blockIndex": 92,
    "zh": "秋，七月，檀石槐寇雲中。"
  },
  {
    "id": "s0472",
    "blockIndex": 92,
    "zh": "以故烏桓校尉李膺為度遼將軍。"
  },
  {
    "id": "s0472",
    "blockIndex": 92,
    "zh": "膺到邊，羌、胡皆望風畏服，先所掠男女，悉詣塞下送還之。"
  },
  {
    "id": "s0479",
    "blockIndex": 93,
    "zh": "公孫舉、東郭竇等聚眾至三萬人，寇青、兗、徐三州，破壞郡縣。"
  },
  {
    "id": "s0479",
    "blockIndex": 93,
    "zh": "連年討之，不能克。"
  },
  {
    "id": "s0479",
    "blockIndex": 93,
    "zh": "尚書選能治劇者，以司徒掾穎川韓韶為嬴長。"
  },
  {
    "id": "s0479",
    "blockIndex": 93,
    "zh": "賊聞其賢，相戒不入嬴境。"
  },
  {
    "id": "s0479",
    "blockIndex": 93,
    "zh": "餘縣流民萬餘戶入縣界，韶開倉賑之，主者爭謂不可。"
  },
  {
    "id": "s0479",
    "blockIndex": 93,
    "zh": "韶曰：「長活溝壑之人，而以此伏罪，含笑入地矣。"
  },
  {
    "id": "s0479",
    "blockIndex": 93,
    "zh": "」太守素知韶名德，竟無所坐。"
  },
  {
    "id": "s0479",
    "blockIndex": 93,
    "zh": "韶與同郡荀淑、鐘皓、陳寔皆嘗為縣長，所至以德政稱，時人謂之「穎川四長」。"
  },
  {
    "id": "s0487",
    "blockIndex": 94,
    "zh": "初，鮮卑寇遼東，屬國都尉武威段熲率所領馳赴之。"
  },
  {
    "id": "s0487",
    "blockIndex": 94,
    "zh": "既而恐賊驚去，乃使驛騎詐繼璽書召熲，熲於道偽退，潛於還路設伏；"
  },
  {
    "id": "s0487",
    "blockIndex": 94,
    "zh": "虜以為信然，乃入追熲，熲因大縱兵，悉斬獲之。"
  },
  {
    "id": "s0487",
    "blockIndex": 94,
    "zh": "坐詐為璽書，當伏重刑；"
  },
  {
    "id": "s0487",
    "blockIndex": 94,
    "zh": "以有功，論司寇；"
  },
  {
    "id": "s0487",
    "blockIndex": 94,
    "zh": "刑竟，拜議郎。"
  },
  {
    "id": "s0487",
    "blockIndex": 94,
    "zh": "至是，詔以東方盜賊昌熾，令公卿選將帥有文武材者。"
  },
  {
    "id": "s0487",
    "blockIndex": 94,
    "zh": "司徒尹頌薦熲，拜中郎將，擊舉、竇等，大破斬之，獲首萬餘級，餘黨降散。"
  },
  {
    "id": "s0487",
    "blockIndex": 94,
    "zh": "封熲為列侯。"
  },
  {
    "id": "s0496",
    "blockIndex": 95,
    "zh": "冬，十二月，京師地震。"
  },
  {
    "id": "s0497",
    "blockIndex": 96,
    "zh": "封梁不疑子馬為穎陰侯，梁胤子桃為城父侯。"
  },
  {
    "id": "s0498",
