[
  {
    "id": "s0001",
    "blockIndex": 0,
    "zh": "資治通鑑 第163卷卷第一百六十三"
  },
  {
    "id": "s0002",
    "blockIndex": 1,
    "zh": "【梁紀十九】　上章敦牂，一年。"
  },
  {
    "id": "s0003",
    "blockIndex": 2,
    "zh": "太宗簡文皇帝上大寶元年（"
  },
  {
    "id": "s0003",
    "blockIndex": 2,
    "zh": "庚午，公元五五零年）"
  },
  {
    "id": "s0005",
    "blockIndex": 3,
    "zh": "春，正月，辛亥朔，大赦，改元。"
  },
  {
    "id": "s0006",
    "blockIndex": 4,
    "zh": "陳霸先發始興，至大庾嶺，蔡路養將二萬人軍於南野以拒之。"
  },
  {
    "id": "s0006",
    "blockIndex": 4,
    "zh": "路養妻侄蘭陵蕭摩訶，年十三，單騎出戰，無敢當者。"
  },
  {
    "id": "s0006",
    "blockIndex": 4,
    "zh": "杜僧明馬被傷，陳霸先救之，授以所乘馬。"
  },
  {
    "id": "s0006",
    "blockIndex": 4,
    "zh": "僧明上馬復戰，眾軍因而乘之。"
  },
  {
    "id": "s0006",
    "blockIndex": 4,
    "zh": "路養大敗，脫身走。"
  },
  {
    "id": "s0006",
    "blockIndex": 4,
    "zh": "霸先進軍南康，湘東王繹承製授霸先明威將軍、交州刺史。"
  },
  {
    "id": "s0012",
    "blockIndex": 5,
    "zh": "戊辰，東魏進太原公高洋位丞相、都督中外諸軍、錄尚書事、大行台、齊郡王。"
  },
  {
    "id": "s0013",
    "blockIndex": 6,
    "zh": "庚午，邵陵王綸至江夏，郢州刺史南平王恪郊迎，以州讓之，綸不受；"
  },
  {
    "id": "s0013",
    "blockIndex": 6,
    "zh": "乃推綸為假黃鉞，都督中外諸軍事，承製置百官。"
  },
  {
    "id": "s0015",
    "blockIndex": 7,
    "zh": "魏楊忠圍安陸，柳仲禮馳歸救之。"
  },
  {
    "id": "s0015",
    "blockIndex": 7,
    "zh": "諸將恐仲禮至則安陸難下，請急攻之。"
  },
  {
    "id": "s0015",
    "blockIndex": 7,
    "zh": "忠曰：「攻守勢殊，未可猝拔；"
  },
  {
    "id": "s0015",
    "blockIndex": 7,
    "zh": "若引日勞師，表裡受敵，非計也。"
  },
  {
    "id": "s0015",
    "blockIndex": 7,
    "zh": "南人多習水軍，不閒野戰，仲禮師在近路，吾出其不意，以奇兵襲之，彼怠我奮，一舉可克。"
  },
  {
    "id": "s0015",
    "blockIndex": 7,
    "zh": "克仲禮，則安陸不攻自拔，諸城可傳檄定也。"
  },
  {
    "id": "s0015",
    "blockIndex": 7,
    "zh": "」乃選騎二千，銜枚夜進，敗仲禮於崇頭，獲仲禮及其弟子禮，盡俘其眾。"
  },
  {
    "id": "s0015",
    "blockIndex": 7,
    "zh": "馬岫以安陸，別將王叔孫以竟陵，皆降於忠。"
  },
  {
    "id": "s0015",
    "blockIndex": 7,
    "zh": "於是漢東之地盡入於魏。"
  },
  {
    "id": "s0024",
    "blockIndex": 8,
    "zh": "廣陵人來嶷說前廣陵太守祖皓曰：「董紹先輕而無謀，人情不附。"
  },
  {
    "id": "s0024",
    "blockIndex": 8,
    "zh": "襲而殺之，此壯士之任耳。"
  },
  {
    "id": "s0024",
    "blockIndex": 8,
    "zh": "今欲糾帥義勇，奉戴府君。"
  },
  {
    "id": "s0024",
    "blockIndex": 8,
    "zh": "若其克捷，可立桓、文之勳；"
  },
  {
    "id": "s0024",
    "blockIndex": 8,
    "zh": "必天未悔禍，猶足為梁室忠臣。"
  },
  {
    "id": "s0024",
    "blockIndex": 8,
    "zh": "」皓曰：「此僕所願也。"
  },
  {
    "id": "s0024",
    "blockIndex": 8,
    "zh": "」乃相與糾合勇士，得百餘人。"
  },
  {
    "id": "s0024",
    "blockIndex": 8,
    "zh": "癸酉，襲廣陵，斬南兗州刺史董紹先；"
  },
  {
    "id": "s0024",
    "blockIndex": 8,
    "zh": "據城，馳檄遠近，推前太子舍人蕭勉為刺史，仍結東魏為援。"
  },
  {
    "id": "s0024",
    "blockIndex": 8,
    "zh": "皓，□恆之之子；"
  },
  {
    "id": "s0024",
    "blockIndex": 8,
    "zh": "勉，勃之兄也。"
  },
  {
    "id": "s0024",
    "blockIndex": 8,
    "zh": "乙亥，景遣郭元建帥眾奄至，皓嬰城固守。"
  },
  {
    "id": "s0036",
    "blockIndex": 9,
    "zh": "二月，魏楊忠乘勝至石城，欲進逼江陵，湘東王繹遣舍人庾恪說忠曰：「察來伐叔而魏助之，何以使天下歸心！"
  },
  {
    "id": "s0036",
    "blockIndex": 9,
    "zh": "」忠遂停湕北。"
  },
  {
    "id": "s0036",
    "blockIndex": 9,
    "zh": "繹遣舍人王孝祀等送子方略為質以求和，魏人許之。"
  },
  {
    "id": "s0036",
    "blockIndex": 9,
    "zh": "繹與忠盟曰：「魏以石城為封，梁以安陸為界，請同附庸，並送質子，貿遷有無，永敦鄰睦。"
  },
  {
    "id": "s0036",
    "blockIndex": 9,
    "zh": "」忠乃還。"
  },
  {
    "id": "s0041",
    "blockIndex": 10,
    "zh": "宕昌王梁彌定為其宗人獠甘所襲，彌定奔魏，獠甘自立。"
  },
  {
    "id": "s0041",
    "blockIndex": 10,
    "zh": "羌酋傍乞鐵□據渠株川，與渭州民鄭五丑合諸羌以叛魏。"
  },
  {
    "id": "s0041",
    "blockIndex": 10,
    "zh": "丞相泰使大將軍宇文貴、涼州刺史史寧討之，擒斬鐵□、五丑。"
  },
  {
    "id": "s0041",
    "blockIndex": 10,
    "zh": "寧別擊獠甘，破之，獠甘將百騎奔生羌鞏廉玉。"
  },
  {
    "id": "s0041",
    "blockIndex": 10,
    "zh": "寧復納彌定於宕昌，置岷州於渠株川，進擊鞏廉玉，斬獠甘，虜廉玉送長安。"
  },
  {
    "id": "s0046",
    "blockIndex": 11,
    "zh": "侯景遣任約、於慶等帥眾二萬攻諸籓。"
  },
  {
    "id": "s0047",
    "blockIndex": 12,
    "zh": "邵陵王綸欲救河東王譽，而兵糧不足，乃致書於湘東王繹曰：「天時地利，不及人和，況乎手足肱支，豈可相害！"
  },
  {
    "id": "s0047",
    "blockIndex": 12,
    "zh": "今社稷危恥，創巨痛深，唯應剖心嘗膽，泣血枕戈，其餘小忿，或宜容貰。"
  },
  {
    "id": "s0047",
    "blockIndex": 12,
    "zh": "若外難未除，家禍仍構，料今訪古，未或不亡。"
  },
  {
    "id": "s0047",
    "blockIndex": 12,
    "zh": "夫征戰之理，唯求克勝；"
  },
  {
    "id": "s0047",
    "blockIndex": 12,
    "zh": "至於骨肉之戰，愈勝愈酷，捷則非功，敗則有喪，勞兵損義，虧失多矣。"
  },
  {
    "id": "s0047",
    "blockIndex": 12,
    "zh": "侯景之軍所以未窺江外者，良為籓屏盤固，宗鎮強密。"
  },
  {
    "id": "s0047",
    "blockIndex": 12,
    "zh": "弟若陷洞庭，不戢兵刃，雍州疑迫，何以自安，必引進魏軍以求形援。"
  },
  {
    "id": "s0047",
    "blockIndex": 12,
    "zh": "弟若不安，家國去矣。"
  },
  {
    "id": "s0047",
    "blockIndex": 12,
    "zh": "必希解湘州之圍，存社稷之計。"
  },
  {
    "id": "s0047",
    "blockIndex": 12,
    "zh": "」繹復書，陳譽過惡不赦，且曰：「察引楊忠來相侵逼，頗遵談笑，用卻秦軍，曲直有在，不復自陳。"
  },
  {
    "id": "s0047",
    "blockIndex": 12,
    "zh": "臨湘旦平，暮便即路。"
  },
  {
    "id": "s0047",
    "blockIndex": 12,
    "zh": "」綸得書，投之於案，慷慨流涕曰「天下之事，一至於斯！"
  },
  {
    "id": "s0047",
    "blockIndex": 12,
    "zh": "湘州若敗，吾亡無日矣！"
  },
  {
    "id": "s0061",
    "blockIndex": 13,
    "zh": "侯景遣侯子鑒帥舟師八千，自帥徒兵一萬，攻廣陵，三日，克之，執祖皓，縛而射之，箭遍體，然後車裂以徇；"
  },
  {
    "id": "s0061",
    "blockIndex": 13,
    "zh": "城中無少長皆埋之於地，馳馬射而殺之。"
  },
  {
    "id": "s0061",
    "blockIndex": 13,
    "zh": "以子鑒為南兗州刺史，鎮廣陵。"
  },
  {
    "id": "s0061",
    "blockIndex": 13,
    "zh": "景還建康。"
  },
  {
    "id": "s0065",
    "blockIndex": 14,
    "zh": "丙戌，以安陸王大春為東揚州刺史。"
  },
  {
    "id": "s0065",
    "blockIndex": 14,
    "zh": "省吳州。"
  },
  {
    "id": "s0065",
    "blockIndex": 14,
    "zh": "乙巳，以尚書僕射王克為左僕射。"
  },
  {
    "id": "s0068",
    "blockIndex": 15,
    "zh": "庚寅，東魏以尚書令高隆之為太保。"
  },
  {
    "id": "s0068",
    "blockIndex": 15,
    "zh": "宣城內史楊白華進據安吳，侯景遣於子悅等帥眾攻之，不克。"
  },
  {
    "id": "s0070",
    "blockIndex": 16,
    "zh": "東魏行台辛術將兵入寇，圍陽平，不克。"
  },
  {
    "id": "s0071",
    "blockIndex": 17,
    "zh": "侯景納上女溧陽公主，甚愛之。"
  },
  {
    "id": "s0071",
    "blockIndex": 17,
    "zh": "三月，甲申，景請上禊宴於樂游苑，帳飲三日。"
  },
  {
    "id": "s0071",
    "blockIndex": 17,
    "zh": "上還宮，景與公主共據御床，南面並坐，群臣文武列坐侍宴。"
  },
  {
    "id": "s0074",
    "blockIndex": 18,
    "zh": "庚申，東魏進丞相洋爵為齊王。"
  },
  {
    "id": "s0075",
    "blockIndex": 19,
    "zh": "臨川內史始興王毅等擊莊鐵，鄱陽王范遣其將巴西侯瑱救之，毅等敗死。"
  },
  {
    "id": "s0076",
    "blockIndex": 20,
    "zh": "鄱陽世子嗣與任約戰於三章，約敗走；"
  },
  {
    "id": "s0076",
    "blockIndex": 20,
    "zh": "嗣因徙鎮三章，謂之安樂柵。"
  },
  {
    "id": "s0078",
    "blockIndex": 21,
    "zh": "夏，四月，庚辰朔，湘東王繹以上甲侯韶為長沙王。"
  },
  {
    "id": "s0079",
    "blockIndex": 22,
    "zh": "丙午，侯景請上幸西州，上御素輦，侍衛四百餘人，景浴鐵數千，翼衛左右。"
  },
  {
    "id": "s0079",
    "blockIndex": 22,
    "zh": "上聞絲竹，淒然泣下，命景起舞，景亦請上起舞。"
  },
  {
    "id": "s0079",
    "blockIndex": 22,
    "zh": "酒闌坐散，上抱景於床曰：「我念丞相！"
  },
  {
    "id": "s0079",
    "blockIndex": 22,
    "zh": "」景曰：「陛下如不念臣，臣何得至此！"
  },
  {
    "id": "s0079",
    "blockIndex": 22,
    "zh": "」逮夜乃罷。"
  },
  {
    "id": "s0084",
    "blockIndex": 23,
    "zh": "時江南連年旱蝗，江、揚尤甚，百姓流亡，相與入山谷、江湖，采草根、木葉、菱芡而食之，所在皆盡，死者蔽野。"
  },
  {
    "id": "s0084",
    "blockIndex": 23,
    "zh": "富室無食，皆鳥面鵠形，衣羅綺，懷金玉，俯伏床帷，待命聽終。"
  },
  {
    "id": "s0084",
    "blockIndex": 23,
    "zh": "千里絕煙，人跡罕見，白骨成聚，如丘隴焉。"
  },
  {
    "id": "s0087",
    "blockIndex": 24,
    "zh": "景性殘酷，於石頭立大碓，有犯法者搗殺之。"
  },
  {
    "id": "s0087",
    "blockIndex": 24,
    "zh": "常戒諸將曰：「破柵平城，當淨殺之，使天下知吾威名。"
  },
  {
    "id": "s0087",
    "blockIndex": 24,
    "zh": "」故諸將每戰勝，專以焚掠為事，斬刈人如草芥，以資戲笑。"
  },
  {
    "id": "s0087",
    "blockIndex": 24,
    "zh": "由是百姓雖死，終不附之。"
  },
  {
    "id": "s0087",
    "blockIndex": 24,
    "zh": "又禁人偶語，犯者刑及外族。"
  },
  {
    "id": "s0087",
    "blockIndex": 24,
    "zh": "為其將帥者，悉稱行台，來降附者，悉稱開府，其親寄隆重者曰左右廂公，勇力兼人者曰庫直都督。"
  },
  {
    "id": "s0093",
    "blockIndex": 25,
    "zh": "魏封皇子儒為燕王，公為吳王。"
  },
  {
    "id": "s0094",
    "blockIndex": 26,
    "zh": "侯景召宋子仙還京口。"
  },
  {
    "id": "s0095",
    "blockIndex": 27,
    "zh": "邵陵王綸在郢州，以聽事為正陽殿，內外齋閣，悉加題署。"
  },
  {
    "id": "s0095",
    "blockIndex": 27,
    "zh": "其部下陵暴軍府，郢州將佐莫不怨之。"
  },
  {
    "id": "s0095",
    "blockIndex": 27,
    "zh": "咨議參軍江仲舉，南平王恪之謀主也，說恪圖綸，恪驚曰：「若我殺邵陵，寧靜一鎮，荊、益兄弟必皆內喜，海內若平，則以大義責我矣。"
  },
  {
    "id": "s0095",
    "blockIndex": 27,
    "zh": "且巨逆未梟，骨肉相殘，自亡之道也。"
  },
  {
    "id": "s0095",
    "blockIndex": 27,
    "zh": "卿且息之。"
  },
  {
    "id": "s0095",
    "blockIndex": 27,
    "zh": "」仲舉不從，部分諸將，刻日將發；"
  },
  {
    "id": "s0095",
    "blockIndex": 27,
    "zh": "謀洩，綸壓殺之。"
  },
  {
    "id": "s0095",
    "blockIndex": 27,
    "zh": "恪狼狽往謝，綸曰：「群小所作，非由兄也。"
  },
  {
    "id": "s0095",
    "blockIndex": 27,
    "zh": "凶黨已斃，兄勿深憂。"
  },
  {
    "id": "s0105",
    "blockIndex": 28,
    "zh": "王僧辯急攻長沙，辛巳，克之。"
  },
  {
    "id": "s0105",
    "blockIndex": 28,
    "zh": "執河東王譽，斬之，傳首江陵，湘東王繹反其首而葬之。"
  },
  {
    "id": "s0105",
    "blockIndex": 28,
    "zh": "初，世子方等之死，臨蒸周鐵虎功最多，譽委遇甚重。"
  },
  {
    "id": "s0105",
    "blockIndex": 28,
    "zh": "僧辯得鐵虎，命烹之，呼曰：「侯景未滅，奈何殺壯士！"
  },
  {
    "id": "s0105",
    "blockIndex": 28,
    "zh": "」僧辯奇其言而釋之，還其麾下。"
  },
  {
    "id": "s0105",
    "blockIndex": 28,
    "zh": "繹以僧辯為左衛將軍，加侍中、鎮西長史。"
  },
  {
    "id": "s0111",
    "blockIndex": 29,
    "zh": "繹自去歲聞高祖之喪，以長沙未下，故匿之。"
  },
  {
    "id": "s0111",
    "blockIndex": 29,
    "zh": "壬寅，始發喪，刻檀為高祖像，置於百福殿，事之甚謹，動靜必咨焉。"
  },
  {
    "id": "s0111",
    "blockIndex": 29,
    "zh": "繹以為天子制於賊臣，不肯從大寶之號，猶稱太清四年。"
  },
  {
    "id": "s0111",
    "blockIndex": 29,
    "zh": "丙午，繹下令大舉討侯景，移檄遠近。"
  },
  {
    "id": "s0115",
    "blockIndex": 30,
    "zh": "鄱陽王范至湓城，以晉熙為晉州，遣其世子嗣為刺史，江州郡縣多輒改易。"
  },
  {
    "id": "s0115",
    "blockIndex": 30,
    "zh": "尋陽王大心，政令所行，不出一郡。"
  },
  {
    "id": "s0115",
    "blockIndex": 30,
    "zh": "大心遣兵擊莊鐵，嗣與鐵素善，請發兵救之，范遣侯瑱帥精甲五千助鐵。"
  },
  {
    "id": "s0115",
    "blockIndex": 30,
    "zh": "由是二鎮互相猜忌，無復討賊之志。"
  },
  {
    "id": "s0115",
    "blockIndex": 30,
    "zh": "大心使徐嗣徽帥眾二千，築壘稽亭以備范，市糴不通，范數萬之眾，無所得食，多餓死。"
  },
  {
    "id": "s0115",
    "blockIndex": 30,
    "zh": "范憤恚，疽發於背，五月，乙卯，卒。"
  },
  {
    "id": "s0115",
    "blockIndex": 30,
    "zh": "其眾秘不發喪，奉范弟安南侯恬為主，有眾數千人。"
  },
  {
    "id": "s0122",
    "blockIndex": 31,
    "zh": "丙辰，侯景以元思虔為東道大行台，鎮錢塘。"
  },
  {
    "id": "s0122",
    "blockIndex": 31,
    "zh": "丁巳，以侯子鑒為南兗州刺史。"
  },
  {
    "id": "s0124",
    "blockIndex": 32,
    "zh": "東魏齊王洋之為開府也，勃海高德政為管記，由是親暱，言無不盡。"
  },
  {
    "id": "s0124",
    "blockIndex": 32,
    "zh": "金紫光祿大夫丹楊徐之才、北平太守廣宗宋景業，皆善圖讖，以為太歲在午，當有革命，因德政以白洋，勸之受禪。"
  },
  {
    "id": "s0124",
    "blockIndex": 32,
    "zh": "洋以告婁太妃，太妃曰：「汝父如龍，兄如虎，猶以天位不可妄據，終身北面。"
  },
  {
    "id": "s0124",
    "blockIndex": 32,
    "zh": "汝獨何人，欲行舜、禹之事乎！"
  },
  {
    "id": "s0124",
    "blockIndex": 32,
    "zh": "」洋以告之才，之才曰：「正為不及父兄，故宜早升尊位耳。"
  },
  {
    "id": "s0124",
    "blockIndex": 32,
    "zh": "」洋鑄像卜之而成，乃使開府儀同三司段韶問肆州刺史斛律金，金來見洋，固言不可，以宋景業首陳符命，請殺之。"
  },
  {
    "id": "s0124",
    "blockIndex": 32,
    "zh": "洋與諸貴議於太妃前，太妃曰：「吾兒懦直，必無此心，高德政樂禍，教之耳。"
  },
  {
    "id": "s0124",
    "blockIndex": 32,
    "zh": "」洋以人心不壹，使高德政如鄴察公卿之意，未還；"
  },
  {
    "id": "s0124",
    "blockIndex": 32,
    "zh": "洋擁兵而東，至平都城，召諸勳貴議之，莫敢對。"
  },
  {
    "id": "s0124",
    "blockIndex": 32,
    "zh": "長史杜弼曰：「關西，國之勁敵，若受魏禪，恐彼挾天子，自稱義兵而東向，王何以待之！"
  },
  {
    "id": "s0124",
    "blockIndex": 32,
    "zh": "」徐之才曰：「今與王爭天下者，彼亦欲為王所為。"
  },
  {
    "id": "s0124",
    "blockIndex": 32,
    "zh": "縱其屈強，不過隨我稱帝耳。"
  },
  {
    "id": "s0124",
    "blockIndex": 32,
    "zh": "」弼無以應。"
  },
  {
    "id": "s0124",
    "blockIndex": 32,
    "zh": "高德政至鄴，諷公卿，莫有應者。"
  },
  {
    "id": "s0124",
    "blockIndex": 32,
    "zh": "司馬子如逆洋於遼陽，固言未可。"
  },
  {
    "id": "s0124",
    "blockIndex": 32,
    "zh": "洋欲還，倉丞李集曰：「王來為何事，而今欲還？"
  },
  {
    "id": "s0124",
    "blockIndex": 32,
    "zh": "」洋偽使於東門殺之，而別令賜絹十匹，遂還晉陽，自是居常不悅。"
  },
  {
    "id": "s0124",
    "blockIndex": 32,
    "zh": "徐之才、宋景業等日陳陰陽雜占，雲宜早受命。"
  },
  {
    "id": "s0124",
    "blockIndex": 32,
    "zh": "高德政亦敦勸不已。"
  },
  {
    "id": "s0124",
    "blockIndex": 32,
    "zh": "洋使術士李密卜之，遇《大橫》，曰：「漢文之卦也。"
  },
  {
    "id": "s0124",
    "blockIndex": 32,
    "zh": "」又使宋景業筮之，遇《乾》之《鼎》，曰：「《乾》，君也。"
  },
  {
    "id": "s0124",
    "blockIndex": 32,
    "zh": "《鼎》，五月卦也。"
  },
  {
    "id": "s0124",
    "blockIndex": 32,
    "zh": "宜以仲夏受禪。"
  },
  {
    "id": "s0124",
    "blockIndex": 32,
    "zh": "」或曰：「五月不可入官，犯之，終於其位。"
  },
  {
    "id": "s0124",
    "blockIndex": 32,
    "zh": "」景業曰：「王為天子，無復下期，豈得不終於其位乎！"
  },
  {
    "id": "s0124",
    "blockIndex": 32,
    "zh": "」洋大悅，乃發晉陽。"
  },
  {
    "id": "s0150",
    "blockIndex": 33,
    "zh": "高德政錄在鄴諸事，條進於洋，洋令左右陳山提馳驛繼事條並密書與楊愔。"
  },
  {
    "id": "s0150",
    "blockIndex": 33,
    "zh": "是月，山提至鄴，楊愔即召太常卿邢劭等議撰儀注，秘書監魏收草九錫、禪讓、勸進諸文；"
  },
  {
    "id": "s0150",
    "blockIndex": 33,
    "zh": "引魏宗室諸王入北宮，留於東齋。"
  },
  {
    "id": "s0150",
    "blockIndex": 33,
    "zh": "甲寅，東魏進洋位相國，總百揆，備九錫。"
  },
  {
    "id": "s0150",
    "blockIndex": 33,
    "zh": "洋行至前亭，所乘馬忽倒，意甚惡之。"
  },
  {
    "id": "s0150",
    "blockIndex": 33,
    "zh": "至平都城，不復肯進。"
  },
  {
    "id": "s0150",
    "blockIndex": 33,
    "zh": "高德政、徐之才苦請曰：「山提先去，恐其漏洩。"
  },
  {
    "id": "s0150",
    "blockIndex": 33,
    "zh": "」即命司馬子如、杜弼馳驛續入，觀察物情。"
  },
  {
    "id": "s0150",
    "blockIndex": 33,
    "zh": "子如等至鄴，眾人以事勢已決，無敢異言。"
  },
  {
    "id": "s0150",
    "blockIndex": 33,
    "zh": "洋至鄴，召夫繼築具集城南。"
  },
  {
    "id": "s0150",
    "blockIndex": 33,
    "zh": "高隆之請曰：「用此何為？"
  },
  {
    "id": "s0150",
    "blockIndex": 33,
    "zh": "」洋作色曰：「我自有事，君何問為！"
  },
  {
    "id": "s0150",
    "blockIndex": 33,
    "zh": "欲族滅邪！"
  },
  {
    "id": "s0150",
    "blockIndex": 33,
    "zh": "」隆之謝而退。"
  },
  {
    "id": "s0150",
    "blockIndex": 33,
    "zh": "於是作圜丘，備法物。"
  },
  {
    "id": "s0165",
    "blockIndex": 34,
    "zh": "丙辰，司空潘樂、侍中張亮、黃門郎趙彥深等求入啟事，東魏孝靜帝在昭陽殿見之。"
  },
  {
    "id": "s0165",
    "blockIndex": 34,
    "zh": "亮曰：「五行遞運，有始有終。"
  },
  {
    "id": "s0165",
    "blockIndex": 34,
    "zh": "齊王聖德欽明，萬方歸仰，願陛下遠法堯、舜。"
  },
  {
    "id": "s0165",
    "blockIndex": 34,
    "zh": "」帝斂容曰：「此事推挹已久，謹當遜避。"
  },
  {
    "id": "s0165",
    "blockIndex": 34,
    "zh": "」又曰：「若爾，須作制書。"
  },
  {
    "id": "s0165",
    "blockIndex": 34,
    "zh": "」中書郎崔劼、裴讓之曰：「制已作訖。"
  },
  {
    "id": "s0165",
    "blockIndex": 34,
    "zh": "」使侍中楊愔進之。"
  },
  {
    "id": "s0165",
    "blockIndex": 34,
    "zh": "東魏主既署，曰：「居朕何所？"
  },
  {
    "id": "s0165",
    "blockIndex": 34,
    "zh": "」愔對曰：「北城別有館宇。"
  },
  {
    "id": "s0165",
    "blockIndex": 34,
    "zh": "」乃下御坐，步就東廊，詠范蔚宗《後漢書‧贊》曰：「獻坐不辰，身播國屯，終我四百，永作虞賓。"
  },
  {
    "id": "s0165",
    "blockIndex": 34,
    "zh": "」所司請發，帝曰：「古人念遺簪弊履，朕欲與六宮別，可乎？"
  },
  {
    "id": "s0165",
    "blockIndex": 34,
    "zh": "」高隆之曰：「今日天下猶陛下之天下，況在六宮！"
  },
  {
    "id": "s0165",
    "blockIndex": 34,
    "zh": "」帝步入，與妃嬪已下別，舉宮皆哭。"
  },
  {
    "id": "s0165",
    "blockIndex": 34,
    "zh": "趙國李嬪誦陳思王詩云：「王其愛玉體，俱享黃發期。"
  },
  {
    "id": "s0165",
    "blockIndex": 34,
    "zh": "」直長趙道德以故犢車一乘候於東閣，帝登車，道德超上抱之，帝叱之曰：「朕自畏天順人，何物奴敢逼人如此！"
  },
  {
    "id": "s0165",
    "blockIndex": 34,
    "zh": "」道德猶不下。"
  },
  {
    "id": "s0165",
    "blockIndex": 34,
    "zh": "出雲龍門，王公百僚拜辭，高隆之灑泣。"
  },
  {
    "id": "s0165",
    "blockIndex": 34,
    "zh": "遂入北城，居司馬子如南宅，遣太尉彭城王韶等奉璽綬，禪位於齊。"
  },
  {
    "id": "s0183",
    "blockIndex": 35,
    "zh": "戊午，齊王即皇帝位於南郊，大赦，改元天保。"
  },
  {
    "id": "s0183",
    "blockIndex": 35,
    "zh": "自魏敬宗以來，百官絕祿，至是始復給之。"
  },
  {
    "id": "s0183",
    "blockIndex": 35,
    "zh": "己未，封東魏主為中山王，待以不臣之禮。"
  },
  {
    "id": "s0183",
    "blockIndex": 35,
    "zh": "追尊齊獻武王為獻武皇帝，廟號太祖，後改為高祖；"
  },
  {
    "id": "s0183",
    "blockIndex": 35,
    "zh": "文襄王為文襄皇帝，廟號世宗。"
  },
  {
    "id": "s0183",
    "blockIndex": 35,
    "zh": "辛酉，尊王太后婁氏為皇太后。"
  },
  {
    "id": "s0183",
    "blockIndex": 35,
    "zh": "乙丑，降魏朝封爵有差，其宣力霸朝及西、南投化者，不在降限。"
  },
  {
    "id": "s0190",
    "blockIndex": 36,
    "zh": "文成侯寧起兵於吳，有眾萬人，己巳，進攻吳郡；"
  },
  {
    "id": "s0190",
    "blockIndex": 36,
    "zh": "行吳郡事侯子榮逆擊，殺之。"
  },
  {
    "id": "s0190",
    "blockIndex": 36,
    "zh": "寧，范之弟也。"
  },
  {
    "id": "s0190",
    "blockIndex": 36,
    "zh": "子榮因縱兵大掠郡境。"
  },
  {
    "id": "s0194",
    "blockIndex": 37,
    "zh": "自晉氏度江，三吳最為富庶，貢賦商旅，皆出其地。"
  },
  {
    "id": "s0194",
    "blockIndex": 37,
    "zh": "及侯景之亂，掠金帛既盡，乃掠人而食之，或賣於北境，遺民殆盡矣。"
  },
  {
    "id": "s0196",
    "blockIndex": 38,
    "zh": "是時，唯荊、益所部尚完實，太尉、益州刺史武陵王紀移告征、鎮，使世子圓照帥兵三萬受湘東王節度。"
  },
  {
    "id": "s0196",
    "blockIndex": 38,
    "zh": "圓照軍至巴水，繹授以信州刺史，令屯白帝，未許東下。"
  },
  {
    "id": "s0198",
    "blockIndex": 39,
    "zh": "六月，辛巳，以南郡王大連行揚州事。"
  },
  {
    "id": "s0199",
    "blockIndex": 40,
    "zh": "江夏王大款、山陽王大成、宜都王大封自信安間道奔江陵。"
  },
  {
    "id": "s0200",
    "blockIndex": 41,
    "zh": "齊主封宗室高岳等十人、功臣庫狄乾等七人皆為王。"
  },
  {
    "id": "s0200",
    "blockIndex": 41,
    "zh": "癸未，封弟浚為永安王，淹為平陽王，浟為彭城王，演為常山王，渙為上黨王，淯為襄城王，湛為長廣王，湝為任城王，湜為高陽王，濟為博陵王，凝為新平王，潤為馮翊王，洽為漢陽王。"
  },
  {
    "id": "s0202",
    "blockIndex": 42,
    "zh": "鄱陽王范既卒，侯瑱依莊鐵，鐵忌之；"
  },
  {
    "id": "s0202",
    "blockIndex": 42,
    "zh": "瑱自安，丙戌，詐引鐵謀事，因殺之，自據豫章。"
  },
  {
    "id": "s0204",
    "blockIndex": 43,
    "zh": "尋陽王大心遣徐嗣徽夜襲湓城，安南侯恬、裴之橫等擊走之。"
  },
  {
    "id": "s0204",
    "blockIndex": 43,
    "zh": "齊主娶趙郡李希宗之女，生子殷及紹德；"
  },
  {
    "id": "s0204",
    "blockIndex": 43,
    "zh": "又納段韶之妹。"
  },
  {
    "id": "s0204",
    "blockIndex": 43,
    "zh": "及將建中宮，高隆之、高德政欲結勳貴之援，乃言：「漢婦人不可為天下母，宜更擇美配。"
  },
  {
    "id": "s0204",
    "blockIndex": 43,
    "zh": "」帝不從。"
  },
  {
    "id": "s0204",
    "blockIndex": 43,
    "zh": "丁亥，立李氏為皇后，以段氏為昭儀，子殷為皇太子。"
  },
  {
    "id": "s0204",
    "blockIndex": 43,
    "zh": "庚寅，以庫狄干為太宰，彭樂為太尉，潘相樂為司徒，司馬子如為司空。"
  },
  {
    "id": "s0204",
    "blockIndex": 43,
    "zh": "辛卯，以清河王岳為司州牧。"
  },
  {
    "id": "s0212",
    "blockIndex": 44,
    "zh": "侯景以羊鴉仁為五兵尚書。"
  },
  {
    "id": "s0212",
    "blockIndex": 44,
    "zh": "庚子，鴉仁出奔江西，將赴江陵，至東莞，盜疑其懷金，邀殺之。"
  },
  {
    "id": "s0214",
    "blockIndex": 45,
    "zh": "魏人欲令岳陽王察發哀嗣位，察辭，不受。"
  },
  {
    "id": "s0214",
    "blockIndex": 45,
    "zh": "丞相泰使榮權冊命察為梁王，始建台，置百官。"
  },
  {
    "id": "s0216",
    "blockIndex": 46,
    "zh": "陳霸先修崎頭古城，徙居之。"
  },
  {
    "id": "s0217",
    "blockIndex": 47,
    "zh": "初，燕昭成帝奔高麗，使其族人馮業以三百人浮海奔宋，因留新會。"
  },
  {
    "id": "s0217",
    "blockIndex": 47,
    "zh": "自業至孫融，世為羅州刺史，融子寶為高涼太守。"
  },
  {
    "id": "s0217",
    "blockIndex": 47,
    "zh": "高涼洗氏，世為蠻酋，部落十餘萬家，有女，多籌略，善用兵，諸洞皆服其信義；"
  },
  {
    "id": "s0217",
    "blockIndex": 47,
    "zh": "融聘以為寶婦。"
  },
  {
    "id": "s0217",
    "blockIndex": 47,
    "zh": "融雖累世為方伯，非其土人，號令不行；"
  },
  {
    "id": "s0217",
    "blockIndex": 47,
    "zh": "洗氏約束本宗，使從民禮，每與寶參決辭訟，首領有犯，雖親戚無所縱捨，由是馮氏始得行其政。"
  },
  {
    "id": "s0223",
    "blockIndex": 48,
    "zh": "高州刺史李遷仕據大皋口，遣使召寶，寶欲往，洗氏止之曰：「刺史無故不應召太守，必欲詐君共反耳。"
  },
  {
    "id": "s0223",
    "blockIndex": 48,
    "zh": "」寶曰：「何以知之？"
  },
  {
    "id": "s0223",
    "blockIndex": 48,
    "zh": "」洗氏曰：「刺史被召援台，乃稱有疾，鑄兵聚眾而後召君；"
  },
  {
    "id": "s0223",
    "blockIndex": 48,
    "zh": "此必欲質君以發君之兵也，願且無往以觀其變。"
  },
  {
    "id": "s0223",
    "blockIndex": 48,
    "zh": "」數日，遷仕果反，遣主帥杜平虜將兵入灨石，城魚梁以逼南康，陳霸先使周文育擊之。"
  },
  {
    "id": "s0223",
    "blockIndex": 48,
    "zh": "洗氏謂寶曰：「平虜，驍將也，今入贛石與官軍相拒，勢未得還，遷仕在州，無能為也。"
  },
  {
    "id": "s0223",
    "blockIndex": 48,
    "zh": "君若自往，必有戰鬥，宜遣使卑辭厚禮告之曰：『身未敢出，欲遣婦參。"
  },
  {
    "id": "s0223",
    "blockIndex": 48,
    "zh": "』彼聞之，必喜而無備。"
  },
  {
    "id": "s0223",
    "blockIndex": 48,
    "zh": "我將千餘人，步擔雜物，唱言輸賧，得至柵下，破之必矣。"
  },
  {
    "id": "s0223",
    "blockIndex": 48,
    "zh": "」寶從之。"
  },
  {
    "id": "s0223",
    "blockIndex": 48,
    "zh": "遷仕果不設備，洗氏襲擊，大破之，遷仕走保寧都。"
  },
  {
    "id": "s0223",
    "blockIndex": 48,
    "zh": "文育亦擊走平虜，據其城。"
  },
  {
    "id": "s0223",
    "blockIndex": 48,
    "zh": "洗氏與霸先會於灨石，還，謂寶曰：「陳都督非常人也，甚得眾心，必能平賊，君宜厚資之。"
  },
  {
    "id": "s0237",
    "blockIndex": 49,
    "zh": "湘東王繹以霸先為豫州刺史，領豫章內史。"
  },
  {
    "id": "s0238",
    "blockIndex": 50,
    "zh": "辛丑，裴之橫攻稽亭，徐嗣徽擊走之。"
  },
  {
    "id": "s0239",
    "blockIndex": 51,
    "zh": "秋，七月，辛亥，齊立世宗妃元氏為文襄皇后，宮曰靜德。"
  },
  {
    "id": "s0239",
    "blockIndex": 51,
    "zh": "又封世宗子孝琬為河間王，孝瑜為河南王。"
  },
  {
    "id": "s0239",
    "blockIndex": 51,
    "zh": "乙卯，以尚書令封隆之錄尚書事，尚書左僕射平陽王淹為尚書令。"
  },
  {
    "id": "s0242",
    "blockIndex": 52,
    "zh": "辛酉，梁王察入朝於魏。"
  },
  {
    "id": "s0243",
    "blockIndex": 53,
    "zh": "初，東魏遣儀同武威牒雲洛等迎鄱陽世子嗣，使鎮皖城。"
  },
  {
    "id": "s0243",
    "blockIndex": 53,
    "zh": "嗣未及行，任約軍至，洛等引去；"
  },
  {
    "id": "s0243",
    "blockIndex": 53,
    "zh": "嗣遂失援，出戰，敗死。"
  },
  {
    "id": "s0243",
    "blockIndex": 53,
    "zh": "約遂略地至湓城，尋陽王大心遣司馬韋質出戰而敗，帳下猶有戰士千餘人，鹹勸大心走保建州；"
  },
  {
    "id": "s0243",
    "blockIndex": 53,
    "zh": "大心不能用，戊辰，以江州降約。"
  },
  {
    "id": "s0243",
    "blockIndex": 53,
    "zh": "先是，大心使前太子洗馬韋臧鎮建昌，有甲士五千，聞尋陽不守，欲帥眾奔江陵，未發，為麾下所殺。"
  },
  {
    "id": "s0243",
    "blockIndex": 53,
    "zh": "臧，粲之子也。"
  },
  {
    "id": "s0250",
    "blockIndex": 54,
    "zh": "於慶略地至豫章，侯瑱屈，降之，慶送瑱建康。"
  },
  {
    "id": "s0250",
    "blockIndex": 54,
    "zh": "景以瑱姓，待之甚厚，留其妻子及弟為質，遣瑱慶徇蠡南諸郡，以瑱湘州刺史。"
  },
  {
    "id": "s0252",
    "blockIndex": 55,
    "zh": "初，巴山人黃法□，有勇力，侯景之亂，合徒眾保鄉里。"
  },
  {
    "id": "s0252",
    "blockIndex": 55,
    "zh": "太守賀詡下江州，命法□監郡事。"
  },
  {
    "id": "s0252",
    "blockIndex": 55,
    "zh": "法□屯新淦，於慶自豫章分兵襲新水金，法□敗之。"
  },
  {
    "id": "s0252",
    "blockIndex": 55,
    "zh": "陳霸先使周文育進軍擊慶，法□引兵會之。"
  },
  {
    "id": "s0256",
    "blockIndex": 56,
    "zh": "邵陵王綸聞任約將至，使司馬蔣思安將精兵五千襲之，約眾潰；"
  },
  {
    "id": "s0256",
    "blockIndex": 56,
    "zh": "思安不設備，約收兵襲之，思安敗走。"
  },
  {
    "id": "s0258",
    "blockIndex": 57,
    "zh": "湘東王繹改宜都為宜州，以王琳為刺史。"
  },
  {
    "id": "s0259",
    "blockIndex": 58,
    "zh": "是月，以南郡王大連為江州刺史。"
  },
  {
    "id": "s0260",
    "blockIndex": 59,
    "zh": "魏丞相泰以齊主稱帝，帥諸軍討之。"
  },
  {
    "id": "s0260",
    "blockIndex": 59,
    "zh": "以齊王郭鎮隴右，征秦州刺史宇文導為大將軍、都督二十三州諸軍事，屯咸陽，鎮關中。"
  },
  {
    "id": "s0262",
    "blockIndex": 60,
    "zh": "益州沙門孫天英帥徒數千人夜攻州城，武陵王紀與戰，斬之。"
  },
  {
    "id": "s0263",
    "blockIndex": 61,
    "zh": "邵陵王綸大修鎧仗，將討侯景。"
  },
  {
    "id": "s0263",
    "blockIndex": 61,
    "zh": "湘東王繹惡之，八月，甲午，遣左衛將軍王僧辯、信州刺史鮑泉等帥舟師一萬東趣江、郢，聲言拒任約，且雲迎邵陵王還江陵，授以湘州。"
  },
  {
    "id": "s0265",
    "blockIndex": 62,
    "zh": "齊主初立，勵精為治。"
  },
  {
    "id": "s0265",
    "blockIndex": 62,
    "zh": "趙道德以事屬黎陽太守清河房超，超不發書，棓殺其使；"
  },
  {
    "id": "s0265",
    "blockIndex": 62,
    "zh": "齊主善之，命守宰各設棓以誅屬請之使。"
  },
  {
    "id": "s0265",
    "blockIndex": 62,
    "zh": "久之，都官中郎宋軌奏曰：「若受使請賕，猶致大戮，身為枉法，何以加罪！"
  },
  {
    "id": "s0265",
    "blockIndex": 62,
    "zh": "」乃罷之。"
  },
  {
    "id": "s0270",
    "blockIndex": 63,
    "zh": "司都功曹張老上書請定齊律，詔右僕射薛琡等取魏《麟趾格》，更討論損益之。"
  },
  {
    "id": "s0271",
    "blockIndex": 64,
    "zh": "齊主簡練六坊之人，每一人必當百人，任其臨陳必死，然後取之，謂之「百保鮮卑」。"
  },
  {
    "id": "s0271",
    "blockIndex": 64,
    "zh": "又簡華人之勇力絕倫者，謂之「勇士」，以備邊要。"
  },
  {
    "id": "s0273",
    "blockIndex": 65,
    "zh": "始立九等之戶，富者稅其錢，貧者役其力。"
  },
  {
    "id": "s0274",
    "blockIndex": 66,
    "zh": "九月，丁巳，魏軍發長安。"
  },
  {
    "id": "s0275",
    "blockIndex": 67,
    "zh": "王僧辯軍至鸚鵡洲，郢州司馬劉龍虎等潛送質於僧辯，邵陵王綸聞之，遣其子威正侯礩將兵擊之，龍虎敗，奔於僧辯。"
  },
  {
    "id": "s0275",
    "blockIndex": 67,
    "zh": "綸以書責僧辯曰：「將軍前年殺人之侄，今歲伐人之兄，以此求榮，恐天下不許！"
  },
  {
    "id": "s0275",
    "blockIndex": 67,
    "zh": "」僧辯送書於湘東王繹，繹命進軍。"
  },
  {
    "id": "s0275",
    "blockIndex": 67,
    "zh": "辛酉，綸集其麾下於西園，涕泣言曰：「我本無他，志在滅賊，湘東常謂與之爭帝，遂爾見伐。"
  },
  {
    "id": "s0275",
    "blockIndex": 67,
    "zh": "今日欲守則交絕糧儲，欲戰則取笑千載，不容無事受縛，當於下流避之。"
  },
  {
    "id": "s0275",
    "blockIndex": 67,
    "zh": "」麾下壯士爭請出戰，綸不從，與礩自倉門登舟北出。"
  },
  {
    "id": "s0275",
    "blockIndex": 67,
    "zh": "僧辯入據郢州。"
  },
  {
    "id": "s0275",
    "blockIndex": 67,
    "zh": "繹以南平王恪為尚書令、開府儀同三司，世子方諸為郢州刺史，王僧辯為領軍將軍。"
  },
  {
    "id": "s0283",
    "blockIndex": 68,
    "zh": "綸遇鎮東將軍裴之高於道，之高之子畿掠其軍器，綸與左右輕舟奔武昌澗飲寺，僧法馨匿綸於巖穴之下。"
  },
  {
    "id": "s0283",
    "blockIndex": 68,
    "zh": "綸長史韋質、司馬姜律等聞綸尚存，馳往迎之，說七柵流民以求糧仗。"
  },
  {
    "id": "s0283",
    "blockIndex": 68,
    "zh": "綸出營巴水，流民八九千人附之，稍收散卒，屯於齊昌，遣使請降於齊，齊以綸為梁王。"
  },
  {
    "id": "s0286",
    "blockIndex": 69,
    "zh": "湘東王繹改封皇子大款為臨川王，大成為桂陽王，大封為汝南王。"
  },
  {
    "id": "s0287",
    "blockIndex": 70,
    "zh": "癸亥，魏軍至潼關。"
  },
  {
    "id": "s0288",
    "blockIndex": 71,
    "zh": "庚午，齊主如晉陽，命太子殷居涼風堂監國。"
  },
  {
    "id": "s0289",
    "blockIndex": 72,
    "zh": "南郡王中兵參軍張彪等起兵於若邪山，攻破浙東諸縣，有眾數萬。"
  },
  {
    "id": "s0289",
    "blockIndex": 72,
    "zh": "吳郡人陸令公等說太守南海王大臨往依之。"
  },
  {
    "id": "s0289",
    "blockIndex": 72,
    "zh": "大臨曰：「彪若成功，不資我力；"
  },
  {
    "id": "s0289",
    "blockIndex": 72,
    "zh": "如其橈敗，以我自解。"
  },
  {
    "id": "s0289",
    "blockIndex": 72,
    "zh": "不可往也。"
  },
  {
    "id": "s0295",
    "blockIndex": 73,
    "zh": "任約進寇西陽、武昌。"
  },
  {
    "id": "s0295",
    "blockIndex": 73,
    "zh": "初，寧州刺史彭城徐文盛募兵數萬人討侯景，湘東王繹以為秦州刺史，使將兵東下，與約遇於武昌。"
  },
  {
    "id": "s0295",
    "blockIndex": 73,
    "zh": "繹以廬陵王應為江州刺史，以文盛為長史行府州事，督諸將拒之。"
  },
  {
    "id": "s0295",
    "blockIndex": 73,
    "zh": "應，續之子也。"
  },
  {
    "id": "s0295",
    "blockIndex": 73,
    "zh": "邵陵王綸引齊兵未至，移營馬柵，距西陽八十里，任約聞之，遣儀同叱羅子通等將鐵騎二百襲之，綸不為備，策馬亡走。"
  },
  {
    "id": "s0295",
    "blockIndex": 73,
    "zh": "時湘東王繹亦與齊連和，故齊人觀望，不助綸。"
  },
  {
    "id": "s0295",
    "blockIndex": 73,
    "zh": "定州刺史田祖龍迎綸，綸以祖龍為繹所厚，懼為所執，復歸齊昌。"
  },
  {
    "id": "s0295",
    "blockIndex": 73,
    "zh": "行至汝南，魏所署汝南城主李素，綸之故吏也，開城納之，任約遂據西陽、武昌。"
  },
  {
    "id": "s0303",
    "blockIndex": 74,
    "zh": "裴之高帥子弟部曲千餘人至夏首，湘東王繹召之，以為新興、永守二郡太守。"
  },
  {
    "id": "s0303",
    "blockIndex": 74,
    "zh": "又以南平王恪為武州刺史，鎮武陵。"
  },
  {
    "id": "s0305",
    "blockIndex": 75,
    "zh": "初，邵陵王綸以衡陽王獻為齊州刺史，鎮齊昌；"
  },
  {
    "id": "s0305",
    "blockIndex": 75,
    "zh": "任約擊擒之，送建康，殺之。"
  },
  {
    "id": "s0305",
    "blockIndex": 75,
    "zh": "獻，暢之孫也。"
  },
  {
    "id": "s0308",
    "blockIndex": 76,
    "zh": "乙亥，進侯景位相國，封二十郡，為漢王，加殊禮。"
  },
  {
    "id": "s0309",
    "blockIndex": 77,
    "zh": "岳陽王察還襄陽。"
  },
  {
    "id": "s0310",
    "blockIndex": 78,
    "zh": "黎州民攻刺史張賁，賁棄城走。"
  },
  {
    "id": "s0310",
    "blockIndex": 78,
    "zh": "州民引氐酋北益州刺史楊法琛據黎州，命王、賈二姓詣武陵王紀請法琛為刺史。"
  },
  {
    "id": "s0310",
    "blockIndex": 78,
    "zh": "紀深責之，囚法琛質子崇顒、崇虎。"
  },
  {
    "id": "s0310",
    "blockIndex": 78,
    "zh": "冬，十月，丁丑朔，法琛遣使附魏。"
  },
  {
    "id": "s0314",
    "blockIndex": 79,
    "zh": "己卯，齊主至晉陽宮。"
  },
  {
    "id": "s0314",
    "blockIndex": 79,
    "zh": "廣武王長弼與并州刺史段韶不協，齊主將如晉陽，長弼言於帝曰：「韶擁強兵在彼，恐不知人意，豈可徑往投之！"
  },
  {
    "id": "s0314",
    "blockIndex": 79,
    "zh": "」帝不聽。"
  },
  {
    "id": "s0314",
    "blockIndex": 79,
    "zh": "既至，以長弼語告之，曰：「如君忠誠，人猶有讒，況其餘乎！"
  },
  {
    "id": "s0314",
    "blockIndex": 79,
    "zh": "」長弼，永樂之弟也。"
  },
  {
    "id": "s0314",
    "blockIndex": 79,
    "zh": "乙酉，以特進元韶為尚書左僕射，段韶為右僕射。"
  },
  {
    "id": "s0320",
    "blockIndex": 80,
    "zh": "乙未，侯景自加宇宙大將軍、都督六合諸軍事，以詔文呈上。"
  },
  {
    "id": "s0320",
    "blockIndex": 80,
    "zh": "上驚曰：「將軍乃有宇宙之號乎！"
  },
  {
    "id": "s0323",
    "blockIndex": 81,
    "zh": "立皇子大鈞為西陽王，大威為武寧王，大球為建安王，大昕為義安王，大摯為綏建王，大圜為樂梁王。"
  },
  {
    "id": "s0324",
    "blockIndex": 82,
    "zh": "齊東徐州刺史行台辛術鎮下邳。"
  },
  {
    "id": "s0324",
    "blockIndex": 82,
    "zh": "十一月，侯景征租入建康，術帥眾度淮斷之，燒其谷百萬石，遂圍陽平，景行台郭元建引兵救之。"
  },
  {
    "id": "s0324",
    "blockIndex": 82,
    "zh": "壬戌，術略三千餘家，還下邳。"
  },
  {
    "id": "s0327",
    "blockIndex": 83,
    "zh": "武陵王紀帥諸軍發成都，湘東王繹遣使以書止之曰：「蜀人勇悍，易動難安，弟可鎮之，吾自當滅賊。"
  },
  {
    "id": "s0327",
    "blockIndex": 83,
    "zh": "」又別紙云：「地擬孫、劉，各安境界；"
  },
  {
    "id": "s0327",
    "blockIndex": 83,
    "zh": "情深魯、衛，書信恆通。"
  },
  {
    "id": "s0331",
    "blockIndex": 84,
    "zh": "甲子，南平王恪帥文武拜箋推湘東王繹為相國，總百揆；"
  },
  {
    "id": "s0331",
    "blockIndex": 84,
    "zh": "繹不許。"
  },
  {
    "id": "s0333",
    "blockIndex": 85,
    "zh": "魏丞相泰自弘農為橋，濟河，至建州。"
  },
  {
    "id": "s0333",
    "blockIndex": 85,
    "zh": "丙寅，齊主自將出頓東城。"
  },
  {
    "id": "s0333",
    "blockIndex": 85,
    "zh": "泰聞其軍容嚴盛，歎曰：「高歡不死矣！"
  },
  {
    "id": "s0333",
    "blockIndex": 85,
    "zh": "」會久雨，自秋及冬，魏軍畜產多死，乃自蒲阪還。"
  },
  {
    "id": "s0333",
    "blockIndex": 85,
    "zh": "於是河南自洛陽，河北自平陽已東，皆入於齊。"
  },
  {
    "id": "s0338",
    "blockIndex": 86,
    "zh": "丁卯，徐文盛軍貝磯，任約帥水軍逆戰，文盛大破之，斬叱羅子通、趙威方，仍進軍大舉口。"
  },
  {
    "id": "s0338",
    "blockIndex": 86,
    "zh": "侯景遣宋子仙等將兵二萬助約，以約守西陽，久不能進，自出屯晉熙。"
  },
  {
    "id": "s0340",
    "blockIndex": 87,
    "zh": "南康王會理以建康空虛，與太子左衛將軍柳敬禮、西鄉侯勸、東鄉侯勉謀起兵誅王偉。"
  },
  {
    "id": "s0340",
    "blockIndex": 87,
    "zh": "安樂侯乂理出奔長蘆，集眾得千餘人。"
  },
  {
    "id": "s0340",
    "blockIndex": 87,
    "zh": "建安侯賁、中宿世子子邕知其謀，以告偉。"
  },
  {
    "id": "s0340",
    "blockIndex": 87,
    "zh": "偉收會理、敬禮、勸、勉及會理弟祁陽侯通理，俱殺之。"
  },
  {
    "id": "s0340",
    "blockIndex": 87,
    "zh": "乂理為左右所殺。"
  },
  {
    "id": "s0340",
    "blockIndex": 87,
    "zh": "錢塘褚冕，以會理故舊，捶掠千計，終無異言。"
  },
  {
    "id": "s0340",
    "blockIndex": 87,
    "zh": "會理隔壁謂之曰：「褚郎，卿豈不為我致此？"
  },
  {
    "id": "s0340",
    "blockIndex": 87,
    "zh": "卿雖忍死明我，我心實欲殺賊！"
  },
  {
    "id": "s0340",
    "blockIndex": 87,
    "zh": "」冕竟不服，景乃宥之。"
  },
  {
    "id": "s0340",
    "blockIndex": 87,
    "zh": "勸，昺之子；"
  },
  {
    "id": "s0340",
    "blockIndex": 87,
    "zh": "賁，正德之弟子；"
  },
  {
    "id": "s0340",
    "blockIndex": 87,
    "zh": "子邕，憺之孫也。"
  },
  {
    "id": "s0352",
    "blockIndex": 88,
    "zh": "帝自即位以來，景防衛甚嚴，外人莫得進見，唯武林侯諮及僕射王克、舍人殷不害，並以文弱得出入臥內，帝與之講論而已。"
  },
  {
    "id": "s0352",
    "blockIndex": 88,
    "zh": "及會理死，克、不害懼禍，稍自疏。"
  },
  {
    "id": "s0352",
    "blockIndex": 88,
    "zh": "咨獨不離帝，朝請無絕；"
  },
  {
    "id": "s0352",
    "blockIndex": 88,
    "zh": "景惡之，使其仇人刁戍刺殺咨於廣莫門外。"
  },
  {
    "id": "s0356",
    "blockIndex": 89,
    "zh": "帝之即位也，景與帝登重雲殿，禮佛為誓云：「自今君臣兩無猜貳，臣固不負陛下，陛下亦不得負臣！"
  },
  {
    "id": "s0356",
    "blockIndex": 89,
    "zh": "」及會理謀洩，景疑帝知之，故殺咨。"
  },
  {
    "id": "s0356",
    "blockIndex": 89,
    "zh": "帝自知不久，指所居殿謂殷不害曰：「龐涓當死此下。"
  },
  {
    "id": "s0360",
    "blockIndex": 90,
    "zh": "景自帥眾討楊白華於宣城，白華力屈而降，景以其北人，全之，以為左民尚書，誅其兄子彬以報來亮之怨。"
  },
  {
    "id": "s0361",
    "blockIndex": 91,
    "zh": "十二月，丙子朔，景封建安侯賁為竟陵王，中宿世子子邕為隨王，仍賜姓侯氏。"
  },
  {
    "id": "s0362",
    "blockIndex": 92,
    "zh": "辛丑，齊主還鄴。"
  },
  {
    "id": "s0363",
    "blockIndex": 93,
    "zh": "邵陵王綸在汝南，修城池，集士卒，將圖安陸。"
  },
  {
    "id": "s0363",
    "blockIndex": 93,
    "zh": "魏安州刺史馬祐以告丞相泰，泰遣楊忠將萬人救安陸。"
  },
  {
    "id": "s0365",
    "blockIndex": 94,
    "zh": "武陵王紀遣潼州刺史楊乾運、南梁州刺史譙淹合兵二萬討楊法琛，法琛發兵據劍閣以拒之。"
  },
  {
    "id": "s0366",
    "blockIndex": 95,
    "zh": "侯景還建康。"
  },
  {
    "id": "s0367",
    "blockIndex": 96,
    "zh": "初，魏敬宗以爾朱榮為柱國大將軍，位在丞相上；"
  },
  {
    "id": "s0367",
    "blockIndex": 96,
    "zh": "榮敗，此官遂廢。"
  },
  {
    "id": "s0367",
    "blockIndex": 96,
    "zh": "大統三年，文帝復以丞相泰為之。"
  },
  {
    "id": "s0367",
    "blockIndex": 96,
    "zh": "其後功參佐命，望實俱重者，亦居此官，凡八人，曰安定公宇文泰，廣陵王欣，趙郡公李弼，隴西公李虎，河內公獨孤信，南陽公趙貴，常山公於謹，彭城公侯莫陳崇，謂之八柱國。"
  },
  {
    "id": "s0367",
    "blockIndex": 96,
    "zh": "泰始籍民之才力者為府兵，身租庸調，一切蠲之，以農隙講閱戰陳，馬畜糧備，六家供之；"
  },
  {
    "id": "s0367",
    "blockIndex": 96,
    "zh": "合為百府，每府一郎將主之，分屬二十四軍。"
  },
  {
    "id": "s0367",
    "blockIndex": 96,
    "zh": "泰任總百揆，督中外諸軍；"
  },
  {
    "id": "s0367",
    "blockIndex": 96,
    "zh": "欣以宗室宿望，從容禁闥而已。"
  },
  {
    "id": "s0367",
    "blockIndex": 96,
    "zh": "餘六人各督二大將軍，凡十二大將軍，每大將軍各統開府二人，開府各領一軍。"
  },
  {
    "id": "s0367",
    "blockIndex": 96,
    "zh": "是後功臣位至柱國大將軍、開府儀同三司、儀同三司者甚眾，率為散官，無所統御，雖有繼掌其事者，聞望皆出諸公之下雲。"
  },
  {
    "id": "s0377",
    "blockIndex": 97,
    "zh": "齊主命散騎侍郎宋景業造《天保歷》，行之。"
  },
  {
    "id": "s0378",
    "blockIndex": 98,
    "zh": "category:資治通鑑"
  }
]
