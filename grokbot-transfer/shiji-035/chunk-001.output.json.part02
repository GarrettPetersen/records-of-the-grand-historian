  "translationRepairs": [
    [
      "s0002",
      "literal",
      "King Wu had ten brothers from the same mother.",
      "King Wu and his same-mother brothers were ten in all.",
      "Chinese 武王同母兄弟十人 counts King Wu among ten same-mother brothers, not as having ten brothers besides himself.",
      "high",
      "proposed"
    ],
    [
      "s0010",
      "literal",
      "Therefore, enfeoffed Shu Xian at Guan, enfeoffed Shu Du at Cai: two people assisted Zhou son Wu Geng Lu Fu, governed Yin remnant people.",
      "Therefore, enfeoffed Shu Xian at Guan, enfeoffed Shu Du at Cai: the two men assisted Wu Geng Lu Fu, son of Zhou of Shang, and governed the remnant people of Yin.",
      "紋 here is King Zhou of Shang, not the Zhou royal house; the literal rendering 'Zhou son' misidentifies the father.",
      "high",
      "proposed"
    ],
    [
      "s0018",
      "idiomatic",
      "The other son, Kang Shu, was enfeoffed as lord of Wei and became known as Kang Shu of Wei.",
      "Over the other group he enfeoffed Kang Shu as lord of Wei, who became known as Kang Shu of Wei.",
      "其一 refers to the other share of Yin remnant people, not 'the other son'; Kang Shu is King Wu's brother.",
      "high",
      "proposed"
    ]
  ],
