# Generate the two secrets independently, for example with: openssl rand -hex 32
GROKBOT_MCP_AUTH_TOKEN=replace-with-random-bearer-token
GROKBOT_MCP_CLAIM_SECRET=replace-with-different-random-signing-secret

# Fine-grained token: Contents read/write and Pull requests read/write.
GITHUB_TOKEN=replace-with-fine-grained-github-token
GITHUB_REPOSITORY=GarrettPetersen/records-of-the-grand-historian

# Keep the origin private; publish it only through Cloudflare Tunnel.
HOST=127.0.0.1
PORT=3001
GROKBOT_MCP_ALLOWED_HOSTS=mcp.example.com

# Use a dedicated clean/sparse runtime clone, never a developer worktree.
PEOPLE_REPO_ROOT=/absolute/path/to/24histories-grokbot-mcp/repo
GROKBOT_MCP_BOOTSTRAP_FILE=/absolute/path/to/24histories-grokbot-mcp/bootstrap.json

# September quality-first campaign profile.
GROKBOT_MCP_MAX_UNITS=80
GROKBOT_MCP_MAX_CANDIDATES=200
GROKBOT_MCP_MAX_WORKER_KIB=48
