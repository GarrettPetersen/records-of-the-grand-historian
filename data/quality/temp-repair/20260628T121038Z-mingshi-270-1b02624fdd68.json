      "translations": [
        {
          "index": 0,
          "zh": "泰昌時，征其兵援遼。",
          "literal": "",
          "idiomatic": "",
          "translator": "Garrett M. Petersen (2026)",
          "model": "Manual source repair"
        },
        {
          "index": 1,
          "zh": "良玉遣兄邦屏、弟民屏先以數千人往。",
          "literal": "",
          "idiomatic": "",
          "translator": "Garrett M. Petersen (2026)",
          "model": "Manual source repair"
        },
        {
          "index": 2,
          "zh": "朝命賜良玉三品服，授邦屏都司僉書，民屏守備。",
          "literal": "",
          "idiomatic": "",
          "translator": "Garrett M. Petersen (2026)",
          "model": "Manual source repair"
        },
        {
          "index": 3,
          "zh": "天啟元年，邦屏渡渾河戰死，民屏突圍出。",
          "literal": "",
          "idiomatic": "",
          "translator": "Garrett M. Petersen (2026)",
          "model": "Manual source repair"
        },
        {
          "index": 4,
          "zh": "良玉自統精卒三千赴之，所過秋毫無犯。",
          "literal": "",
          "idiomatic": "",
          "translator": "Garrett M. Petersen (2026)",
          "model": "Manual source repair"
        },
        {
          "index": 5,
          "zh": "詔加二品服，即予封誥。",
          "literal": "",
          "idiomatic": "",
          "translator": "Garrett M. Petersen (2026)",
          "model": "Manual source repair"
        },
        {
          "index": 6,
          "zh": "子祥麟授指揮使。",
          "literal": "",
          "idiomatic": "",
          "translator": "Garrett M. Petersen (2026)",
          "model": "Manual source repair"
        },
        {
          "index": 7,
          "zh": "良玉陳邦屏死狀，請優恤。",
          "literal": "",
          "idiomatic": "",
          "translator": "Garrett M. Petersen (2026)",
          "model": "Manual source repair"
        },
        {
          "index": 8,
          "zh": "因言：「臣自征播以來，所建之功，不滿讒妒口，貝錦高張，忠誠孰表。」",
          "literal": "",
          "idiomatic": "",
          "translator": "Garrett M. Petersen (2026)",
          "model": "Manual source repair"
        },
        {
          "index": 9,
          "zh": "帝優詔報之。",
          "literal": "",
          "idiomatic": "",
          "translator": "Garrett M. Petersen (2026)",
          "model": "Manual source repair"
        },
        {
          "index": 10,
          "zh": "兵部尚書張鶴鳴言：「渾河血戰，首功數千，實石砫、酉陽二土司功。",
          "literal": "",
          "idiomatic": "",
          "translator": "Garrett M. Petersen (2026)",
          "model": "Manual source repair"
        },
        {
          "index": 11,
          "zh": "邦屏既歿，良玉即遣使入都，制冬衣一千五百，分給殘卒，而身督精兵三千抵榆關。",
          "literal": "",
          "idiomatic": "",
          "translator": "Garrett M. Petersen (2026)",
          "model": "Manual source repair"
        },
        {
          "index": 12,
          "zh": "上急公家難，下復私門仇，氣甚壯。",
          "literal": "",
          "idiomatic": "",
          "translator": "Garrett M. Petersen (2026)",
          "model": "Manual source repair"
        },
        {
          "index": 13,
          "zh": "宜錄邦屏子，進民屏官。」",
          "literal": "",
          "idiomatic": "",
          "translator": "Garrett M. Petersen (2026)",
          "model": "Manual source repair"
        },
        {
          "index": 14,
          "zh": "乃贈邦屏都督僉事，錫世蔭，與陳策等合祠；",
          "literal": "",
          "idiomatic": "",
          "translator": "Garrett M. Petersen (2026)",
          "model": "Manual source repair"
        },
        {
          "index": 15,
          "zh": "民屏進都司僉書。",
          "literal": "",
          "idiomatic": "",
          "translator": "Garrett M. Petersen (2026)",
          "model": "Manual source repair"
        }
      ]
    }
  ]
}
