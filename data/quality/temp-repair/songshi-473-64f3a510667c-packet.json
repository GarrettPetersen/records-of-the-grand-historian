      "translations": [
        {
          "index": 0,
          "zh": "秦檜，字會之，江寧人。",
          "literal": "",
          "idiomatic": "",
          "translator": "Garrett M. Petersen (2026)",
          "model": "Manual source repair"
        },
        {
          "index": 1,
          "zh": "登政和五年第，補密州教授。",
          "literal": "",
          "idiomatic": "",
          "translator": "Garrett M. Petersen (2026)",
          "model": "Manual source repair"
        },
        {
          "index": 2,
          "zh": "繼中詞學兼茂科，歷太學學正。",
          "literal": "",
          "idiomatic": "",
          "translator": "Garrett M. Petersen (2026)",
          "model": "Manual source repair"
        },
        {
          "index": 3,
          "zh": "靖康元年，金兵攻汴京，遣使求三鎮，檜上兵機四事：一言金人要請無厭，乞止許燕山一路；",
          "literal": "",
          "idiomatic": "",
          "translator": "Garrett M. Petersen (2026)",
          "model": "Manual source repair"
        },
        {
          "index": 4,
          "zh": "二言金人狙詐，守禦不可緩；",
          "literal": "",
          "idiomatic": "",
          "translator": "Garrett M. Petersen (2026)",
          "model": "Manual source repair"
        },
        {
          "index": 5,
          "zh": "三乞集百官詳議，擇其當者載之誓書；",
          "literal": "",
          "idiomatic": "",
          "translator": "Garrett M. Petersen (2026)",
          "model": "Manual source repair"
        },
        {
          "index": 6,
          "zh": "四乞館金使於外，不可令入門及引上殿。",
          "literal": "",
          "idiomatic": "",
          "translator": "Garrett M. Petersen (2026)",
          "model": "Manual source repair"
        },
        {
          "index": 7,
          "zh": "不報。",
          "literal": "",
          "idiomatic": "",
          "translator": "Garrett M. Petersen (2026)",
          "model": "Manual source repair"
        },
        {
          "index": 8,
          "zh": "除職方員外郎。",
          "literal": "",
          "idiomatic": "",
          "translator": "Garrett M. Petersen (2026)",
          "model": "Manual source repair"
        },
        {
          "index": 9,
          "zh": "尋屬張邦昌為幹當公事，檜言：「是行專為割地，與臣初議矛盾，失臣本心。」",
          "literal": "",
          "idiomatic": "",
          "translator": "Garrett M. Petersen (2026)",
          "model": "Manual source repair"
        },
        {
          "index": 10,
          "zh": "三上章辭，許之。",
          "literal": "",
          "idiomatic": "",
          "translator": "Garrett M. Petersen (2026)",
          "model": "Manual source repair"
        }
      ]
    }
