      "translations": [
        {
          "index": 0,
          "zh": "白氏，蘇嗣之之母，許州人，宋尚書右丞子由五世孫婦也。",
          "literal": "",
          "idiomatic": "",
          "translator": "Garrett M. Petersen (2026)",
          "model": "Manual source repair"
        },
        {
          "index": 1,
          "zh": "初，東坡、潁濱、叔党俱葬郟城之小峨嵋山，故五世皆居許昌。",
          "literal": "",
          "idiomatic": "",
          "translator": "Garrett M. Petersen (2026)",
          "model": "Manual source repair"
        },
        {
          "index": 2,
          "zh": "白氏年二十余即寡居，服除，外家迎歸，兄嫂竊議改醮。",
          "literal": "",
          "idiomatic": "",
          "translator": "Garrett M. Petersen (2026)",
          "model": "Manual source repair"
        },
        {
          "index": 3,
          "zh": "白氏微聞之，牽車徑歸，曰：「我為蘇學士家婦，又有子，乃欲使我失身乎。」",
          "literal": "",
          "idiomatic": "",
          "translator": "Garrett M. Petersen (2026)",
          "model": "Manual source repair"
        },
        {
          "index": 4,
          "zh": "自是，外家非有大故不往也。",
          "literal": "",
          "idiomatic": "",
          "translator": "Garrett M. Petersen (2026)",
          "model": "Manual source repair"
        },
        {
          "index": 5,
          "zh": "嘗于宅東北為祭室，畫兩先生像，圖黃州、龍川故事壁間，香火嚴潔，躬自灑掃，士大夫求瞻拜者往往過其家奠之。",
          "literal": "",
          "idiomatic": "",
          "translator": "Garrett M. Petersen (2026)",
          "model": "Manual source repair"
        },
        {
          "index": 6,
          "zh": "天興元年正月庚戌，許州被兵，嗣之為汴京廂官，白拜辭兩先生前曰：「兒子往京師，老婦死無恨矣，敢以告。」",
          "literal": "",
          "idiomatic": "",
          "translator": "Garrett M. Petersen (2026)",
          "model": "Manual source repair"
        },
        {
          "index": 7,
          "zh": "即自縊於室側。",
          "literal": "",
          "idiomatic": "",
          "translator": "Garrett M. Petersen (2026)",
          "model": "Manual source repair"
        },
        {
          "index": 8,
          "zh": "家人並屋焚之。",
          "literal": "",
          "idiomatic": "",
          "translator": "Garrett M. Petersen (2026)",
          "model": "Manual source repair"
        },
        {
          "index": 9,
          "zh": "年七十餘。",
          "literal": "",
          "idiomatic": "",
          "translator": "Garrett M. Petersen (2026)",
          "model": "Manual source repair"
        },
        {
          "index": 10,
          "zh": "嗣之本名宗之，避諱改焉。",
          "literal": "",
          "idiomatic": "",
          "translator": "Garrett M. Petersen (2026)",
          "model": "Manual source repair"
        }
      ]
    }
