      "translations": [
        {
          "index": 0,
          "zh": "魯欽，長清人。",
          "literal": "",
          "idiomatic": "",
          "translator": "Garrett M. Petersen (2026)",
          "model": "Manual source repair"
        },
        {
          "index": 1,
          "zh": "萬歷中，歷山西副總兵。",
          "literal": "",
          "idiomatic": "",
          "translator": "Garrett M. Petersen (2026)",
          "model": "Manual source repair"
        },
        {
          "index": 2,
          "zh": "天啟元年遷神機營左副將。",
          "literal": "",
          "idiomatic": "",
          "translator": "Garrett M. Petersen (2026)",
          "model": "Manual source repair"
        },
        {
          "index": 3,
          "zh": "尋擢署都督僉事，充保定總兵官。",
          "literal": "",
          "idiomatic": "",
          "translator": "Garrett M. Petersen (2026)",
          "model": "Manual source repair"
        },
        {
          "index": 4,
          "zh": "奢崇明、安邦彥並反，貴州總兵張彥方在圍中，而總理杜文煥稱病。",
          "literal": "",
          "idiomatic": "",
          "translator": "Garrett M. Petersen (2026)",
          "model": "Manual source repair"
        },
        {
          "index": 5,
          "zh": "明年十月用欽代文煥，命總川、忠、湖廣漢土軍刻期解圍。",
          "literal": "",
          "idiomatic": "",
          "translator": "Garrett M. Petersen (2026)",
          "model": "Manual source repair"
        },
        {
          "index": 6,
          "zh": "未至，圍已解，欽馳赴貴陽。",
          "literal": "",
          "idiomatic": "",
          "translator": "Garrett M. Petersen (2026)",
          "model": "Manual source repair"
        },
        {
          "index": 7,
          "zh": "三年正月，巡撫王三善大敗於陸廣，群苗宋萬化、何中尉等蜂起。",
          "literal": "",
          "idiomatic": "",
          "translator": "Garrett M. Petersen (2026)",
          "model": "Manual source repair"
        },
        {
          "index": 8,
          "zh": "欽佐三善防剿，率諸將擒中尉、萬化，遂進營紅崖。",
          "literal": "",
          "idiomatic": "",
          "translator": "Garrett M. Petersen (2026)",
          "model": "Manual source repair"
        },
        {
          "index": 9,
          "zh": "紅崖者，崇明敗走處也。",
          "literal": "",
          "idiomatic": "",
          "translator": "Garrett M. Petersen (2026)",
          "model": "Manual source repair"
        },
        {
          "index": 10,
          "zh": "三善謀大舉深入，欽及總兵官馬炯、張彥方，諸道監司尹伸、嶽具仰、向日升、楊世賞各以兵從，五戰，斬首萬八千，直抵大方。",
          "literal": "",
          "idiomatic": "",
          "translator": "Garrett M. Petersen (2026)",
          "model": "Manual source repair"
        },
        {
          "index": 11,
          "zh": "四年正月，三善敗歿於內莊，欽等以殘卒還。",
          "literal": "",
          "idiomatic": "",
          "translator": "Garrett M. Petersen (2026)",
          "model": "Manual source repair"
        },
        {
          "index": 12,
          "zh": "命戴罪辦賊。",
          "literal": "",
          "idiomatic": "",
          "translator": "Garrett M. Petersen (2026)",
          "model": "Manual source repair"
        }
      ]
    }
  ]
}
