      "translations": [
        {
          "index": 0,
          "zh": "泰昌元年，遼事棘，始設山東副總兵，駐登州，以命有容。",
          "literal": "",
          "idiomatic": "",
          "translator": "Garrett M. Petersen (2026)",
          "model": "Manual source repair"
        },
        {
          "index": 1,
          "zh": "天啟改元，遼、瀋相繼覆。",
          "literal": "",
          "idiomatic": "",
          "translator": "Garrett M. Petersen (2026)",
          "model": "Manual source repair"
        },
        {
          "index": 2,
          "zh": "熊廷弼建三方布置之議，以陶朗先巡撫登、萊，而擢有容都督僉事，充總兵官，登、萊遂為重鎮。",
          "literal": "",
          "idiomatic": "",
          "translator": "Garrett M. Petersen (2026)",
          "model": "Manual source repair"
        },
        {
          "index": 3,
          "zh": "八月，毛文龍有鎮江之捷。",
          "literal": "",
          "idiomatic": "",
          "translator": "Garrett M. Petersen (2026)",
          "model": "Manual source repair"
        },
        {
          "index": 4,
          "zh": "詔有容統水師萬，偕天津水師直抵鎮江策應。",
          "literal": "",
          "idiomatic": "",
          "translator": "Garrett M. Petersen (2026)",
          "model": "Manual source repair"
        },
        {
          "index": 5,
          "zh": "有容嘆曰：「率一旅之師，當方張之敵，吾知其不克濟也。」",
          "literal": "",
          "idiomatic": "",
          "translator": "Garrett M. Petersen (2026)",
          "model": "Manual source repair"
        },
        {
          "index": 6,
          "zh": "無何，鎮江果失，水師遂不進。",
          "literal": "",
          "idiomatic": "",
          "translator": "Garrett M. Petersen (2026)",
          "model": "Manual source repair"
        },
        {
          "index": 7,
          "zh": "明年，廣寧覆，遼民走避諸島，日望登師救援。",
          "literal": "",
          "idiomatic": "",
          "translator": "Garrett M. Petersen (2026)",
          "model": "Manual source repair"
        },
        {
          "index": 8,
          "zh": "朗先下令，敢渡一人者斬。",
          "literal": "",
          "idiomatic": "",
          "translator": "Garrett M. Petersen (2026)",
          "model": "Manual source repair"
        },
        {
          "index": 9,
          "zh": "有容爭之，立命數十艘往，獲濟者數萬人。",
          "literal": "",
          "idiomatic": "",
          "translator": "Garrett M. Petersen (2026)",
          "model": "Manual source repair"
        },
        {
          "index": 10,
          "zh": "時金、復、蓋三衛俱空無人，有欲據守金州者。",
          "literal": "",
          "idiomatic": "",
          "translator": "Garrett M. Petersen (2026)",
          "model": "Manual source repair"
        },
        {
          "index": 11,
          "zh": "有容言金州孤懸海外，登州、皮島俱遠隔大洋，聲援不及，不可守。",
          "literal": "",
          "idiomatic": "",
          "translator": "Garrett M. Petersen (2026)",
          "model": "Manual source repair"
        },
        {
          "index": 12,
          "zh": "迨文龍取金州，未幾復失。",
          "literal": "",
          "idiomatic": "",
          "translator": "Garrett M. Petersen (2026)",
          "model": "Manual source repair"
        },
        {
          "index": 13,
          "zh": "四年，有容以年老乞骸骨，歸，卒。",
          "literal": "",
          "idiomatic": "",
          "translator": "Garrett M. Petersen (2026)",
          "model": "Manual source repair"
        },
        {
          "index": 14,
          "zh": "贈都督同知，賜祭葬。",
          "literal": "",
          "idiomatic": "",
          "translator": "Garrett M. Petersen (2026)",
          "model": "Manual source repair"
        }
      ]
    }
  ]
}
