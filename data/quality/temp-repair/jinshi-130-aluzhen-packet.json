      "translations": [
        {
          "index": 0,
          "zh": "阿魯真，宗室承充之女，胡裏改猛安夾谷胡山之妻。",
          "literal": "",
          "idiomatic": "",
          "translator": "Garrett M. Petersen (2026)",
          "model": "Manual source repair"
        },
        {
          "index": 1,
          "zh": "夫亡寡居，有眾千餘。",
          "literal": "",
          "idiomatic": "",
          "translator": "Garrett M. Petersen (2026)",
          "model": "Manual source repair"
        },
        {
          "index": 2,
          "zh": "興定元年，承充為上京元帥，上京行省太平執承充應蒲鮮萬奴。",
          "literal": "",
          "idiomatic": "",
          "translator": "Garrett M. Petersen (2026)",
          "model": "Manual source repair"
        },
        {
          "index": 3,
          "zh": "阿魯真治廢壘，修器械，積芻糧以自守。",
          "literal": "",
          "idiomatic": "",
          "translator": "Garrett M. Petersen (2026)",
          "model": "Manual source repair"
        },
        {
          "index": 4,
          "zh": "萬奴遣人招之，不從，乃射承充書入城，阿魯真得而碎之，曰：「此詐也。」",
          "literal": "",
          "idiomatic": "",
          "translator": "Garrett M. Petersen (2026)",
          "model": "Manual source repair"
        },
        {
          "index": 5,
          "zh": "萬奴兵急攻之，阿魯真衣男子服，與其子蒲帶督眾力戰，殺數百人，生擒十余人，萬奴兵乃解去。",
          "literal": "",
          "idiomatic": "",
          "translator": "Garrett M. Petersen (2026)",
          "model": "Manual source repair"
        },
        {
          "index": 6,
          "zh": "後複遣將擊萬奴兵，獲其將一人。",
          "literal": "",
          "idiomatic": "",
          "translator": "Garrett M. Petersen (2026)",
          "model": "Manual source repair"
        },
        {
          "index": 7,
          "zh": "詔封郡公夫人，子蒲帶視功遷賞。",
          "literal": "",
          "idiomatic": "",
          "translator": "Garrett M. Petersen (2026)",
          "model": "Manual source repair"
        },
        {
          "index": 8,
          "zh": "承充已被執，乘間謂其二子女胡、蒲速乃曰：「吾起身宿衛，致位一品，死無恨矣。",
          "literal": "",
          "idiomatic": "",
          "translator": "Garrett M. Petersen (2026)",
          "model": "Manual source repair"
        },
        {
          "index": 9,
          "zh": "若輩亦皆通顯，未嘗一日報國家，當思自處，以為後圖。」",
          "literal": "",
          "idiomatic": "",
          "translator": "Garrett M. Petersen (2026)",
          "model": "Manual source repair"
        },
        {
          "index": 10,
          "zh": "二子乃冒險自拔南走，是年四月至南京。",
          "literal": "",
          "idiomatic": "",
          "translator": "Garrett M. Petersen (2026)",
          "model": "Manual source repair"
        }
      ]
    }
  ]
