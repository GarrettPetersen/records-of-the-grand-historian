    "sourceWitnesses": [
      {
        "id": "s0016",
        "kind": "paragraph-sentence",
        "blockIndex": 1,
        "collection": "sentences",
        "itemIndex": 2,
        "zh": "鄉人趙德鈞謂明宗曰：「行周心甚謹厚，必享貴位。」",
        "en": "A fellow townsman, Zhao Dejun, told Mingzong, \"Xingzhou is deeply sincere and steady in character. He is bound to rise to great eminence.\"",
        "literal": "His fellow townsman Zhao Dejun said to Mingzong, \"Xingzhou's heart is very sincere and steady; he is sure to attain high rank.\""
      },
      {
        "id": "s0017",
        "kind": "paragraph-sentence",
        "blockIndex": 1,
        "collection": "sentences",
        "itemIndex": 3,
        "zh": "梁將劉鄩之據莘也，與太原軍對壘，旦夕轉鬥。",
        "en": "When the Liang general Liu Xun held Xin, he faced the Taiyuan army in a standoff and skirmished from morning to night.",
        "literal": "When the Liang general Liu Xun held Xin, he faced the Taiyuan army across the lines and fought day and night."
      },
      {
        "id": "s0018",
        "kind": "paragraph-sentence",
        "blockIndex": 1,
        "collection": "sentences",
        "itemIndex": 4,
        "zh": "嘗一日，兩軍成列，元行欽為敵軍追躡，劍中其面，血戰未解。",
        "en": "On one occasion, as the two armies drew up in battle order, Yuan Xingqin was chased by the enemy. A sword cut his face, and the bloody struggle went on without respite.",
        "literal": "Once, as the two armies formed their lines, Yuan Xingqin was pursued by the enemy; a sword struck his face, and the bloody fight would not end."
      },
      {
        "id": "s0019",
        "kind": "paragraph-sentence",
        "blockIndex": 1,
        "collection": "sentences",
        "itemIndex": 5,
        "zh": "行周以麾下精騎突陣解之，行欽獲免。",
        "en": "Xingzhou led his finest horsemen in a charge through the enemy formation and broke the encirclement, and Xingqin was saved.",
        "literal": "Xingzhou led his elite cavalry in a charge through the enemy lines and rescued him; Xingqin escaped."
      },
      {
        "id": "s0023",
        "kind": "paragraph-sentence",
        "blockIndex": 1,
        "collection": "sentences",
        "itemIndex": 9,
        "zh": "及兩軍屯於河上，覘知梁軍自汴入楊村寨，明宗晨至斗門，設伏將邀之，眾寡不敵，反為所乘。",
        "en": "While the two armies were encamped along the Yellow River, scouts reported that the Liang forces had entered Yangjia village from Bian. Mingzong reached Dou Gate at dawn and laid an ambush to cut them off, but his numbers were too few and he was instead caught at a disadvantage.",
        "literal": "When the two armies were encamped on the Yellow River, scouts learned that the Liang army had entered Yangjia village from Bian. Mingzong reached Dou Gate at dawn and set an ambush to intercept them, but being outnumbered he was instead taken at a disadvantage."
      },
      {
        "id": "s0192",
        "kind": "paragraph-sentence",
        "blockIndex": 15,
        "collection": "sentences",
        "itemIndex": 0,
        "zh": "張彥成，潞州潞城人也。",
        "en": "Zhang Yancheng came from Lucheng in Luzhou.",
        "literal": "Zhang Yancheng was a native of Lucheng in Luzhou."
      },
      {
        "id": "s0193",
        "kind": "paragraph-sentence",
        "blockIndex": 15,
        "collection": "sentences",
        "itemIndex": 1,
        "zh": "曾祖靜，汾州刺史。",
        "en": "His great-grandfather Jing was governor of Fenzhou.",
        "literal": "His great-grandfather Jing was governor of Fenzhou."
      },
      {
        "id": "s0194",
        "kind": "paragraph-sentence",
        "blockIndex": 15,
        "collection": "sentences",
        "itemIndex": 2,
        "zh": "祖述，澤州刺史。",
        "en": "His grandfather Shu was governor of Zezhou.",
        "literal": "His grandfather Shu was governor of Zezhou."
      },
      {
        "id": "s0195",
        "kind": "paragraph-sentence",
        "blockIndex": 15,
        "collection": "sentences",
        "itemIndex": 3,
        "zh": "父礪，昭義行軍司馬。",
        "en": "His father Li was field headquarters marshal of Zhaoyi.",
        "literal": "His father Li was field headquarters marshal of Zhaoyi."
      },
      {
        "id": "s0196",
        "kind": "paragraph-sentence",
        "blockIndex": 15,
        "collection": "sentences",
        "itemIndex": 4,
        "zh": "彥成初為並門牙將。",
        "en": "Yancheng began his career as a guard officer at the Bing Gate.",
        "literal": "Yancheng began as a guard officer at the Bing Gate."
      },
      {
        "id": "s0197",
        "kind": "paragraph-sentence",
        "blockIndex": 15,
        "collection": "sentences",
        "itemIndex": 5,
        "zh": "天成中，自秦州鹽鐵務官改鄆州都押牙。",
        "en": "During Tiancheng he moved from salt and iron commissioner at Qinzhou to chief military adjutant of Yunzhou.",
        "literal": "During Tiancheng he moved from salt and iron commissioner at Qinzhou to chief military adjutant of Yunzhou."
      },
      {
        "id": "s0198",
        "kind": "paragraph-sentence",
        "blockIndex": 15,
        "collection": "sentences",
        "itemIndex": 6,
        "zh": "漢祖鎮北門，表為行軍司馬，以隱帝娶其女，特見親愛。",
        "en": "When the ancestor of Han governed the northern gate, he recommended Yancheng as field headquarters marshal. Because the Hidden Emperor married his daughter, he was especially cherished.",
        "literal": "When the ancestor of Han governed the northern gate, he recommended Yancheng as field headquarters marshal; because the Hidden Emperor married his daughter, he was especially cherished."
      }
    ],
