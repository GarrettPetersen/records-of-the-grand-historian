      "editorialRepairs": [
        {
          "book": "jinshu",
          "chapter": "093",
          "unitId": "s0021",
          "field": "idiomatic",
          "before": "Chu Pou shrank from wielding power at court, and Wang Shu begged to be sent to the frontier; both kept their skins and their honor, and deserve mention.",
          "after": "Chu Pou shrank from wielding power at court, and Wang Yun begged to be sent to the frontier; both kept their skins and their honor, and deserve mention.",
          "sourceBasedReason": "王叔仁 is the courtesy name of Wang Yun (s0230 王蘊，字叔仁). \"Wang Shu\" wrongly names him and could be confused with Wang Shu 述 (s0223).",
          "sourceQuote": "王叔仁之固求出鎮",
          "pairedFieldChecked": "As for Chu Yeye’s fearing and avoiding court power, and Wang Shuren’s firmly seeking to go out and hold a command, by this they were able to preserve the body and keep far from harm—there is something to praise in that.",
          "repeatedUsesChecked": [
