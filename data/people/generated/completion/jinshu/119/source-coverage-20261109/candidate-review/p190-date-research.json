      "units": {
        "s0486": {
          "quote": "堅既不許萇以禪代，罵而求死，萇乃縊堅于新平佛寺中，時年四十八。",
          "sourceHash": "sha256:4df5d19f340afeb9a073b80ee9dcfb9dc7ea43efeee0dc858e4b37ed4ef09899"
        }
      }
    },
    {
      "file": "data/jinshu/116.json",
