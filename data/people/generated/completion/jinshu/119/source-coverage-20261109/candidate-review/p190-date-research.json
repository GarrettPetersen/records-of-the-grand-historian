      "units": {
        "s0254": {
          "quote": "景茂因仲襄之緒，躡苻亡之會，嘯命群豪，恢弘霸業，假容沖之銳，俯定函、秦；",
          "sourceHash": "sha256:420dc3597e1abf647915e2507de951fc35b9a382bd708e7bc89daca995dd6685"
        },
        "s0258": {
          "quote": "薦棘而陵舊主，何其不仁！",
          "sourceHash": "sha256:9ddde7225072eebbd2dba66aec262466f12de29b292430551c1f616d3b1c4f15"
        }
      }
    }
