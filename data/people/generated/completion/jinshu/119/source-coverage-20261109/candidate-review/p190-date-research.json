      "units": {
        "s0035": {
          "quote": "以升平元年僭稱大秦天王，誅生幸臣董龍、趙韶等二十餘人，赦其境內，改元曰永興。",
          "sourceHash": "sha256:40889d763e28bd5913d861a107955f8bdd9c513bf186d4a2890f9c73a160bf79"
        }
      }
    },
    {
