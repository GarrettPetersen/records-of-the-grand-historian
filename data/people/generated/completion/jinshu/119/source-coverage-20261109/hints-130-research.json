        },
        "s0416": {
          "quote": "二十一年，单于来朝，曹操因留于邺，而遣去卑归监其国焉。",
          "sourceHash": "sha256:ca30a39f1730e14f0b74280bbc9ea786d2cc5db72b39b52a2199114e14e9994c"
        }
