+  unit('s0003', '挫雷惡之鋒。', 'He broke Lei Edi’s advance.')];
+const packet = { book, chapter, units, preflight: { candidates: [] }, input: {} };
+const claim = (claimId, person, zh, evidence, kind = 'personal') => ({ id: id(claimId),
