        },
        "s0003": {
          "unit": "s0003",
          "quote": "姚泓，字元子，興之長子也。",
          "sourceHash": "sha256:f090ad8fef9e6e0346c12c1ba15b03ec7a7c660c525ce159a98d57cef7ef1c03"
        },
        "s0005": {
          "unit": "s0005",
          "quote": "久之，乃立為太子。",
          "sourceHash": "sha256:87fe5d1f983c1bf82b321d1efc4f57568c2079b2e67cfdd4976056d38d930428"
        },
        "s0006": {
          "unit": "s0006",
          "quote": "興每征伐巡遊，常留總後事。",
          "sourceHash": "sha256:2a689b767da6e11a6ad8dad457d841c4606a6cbec828f49a6749dd3afaa43871"
        },
        "s0031": {
          "unit": "s0031",
          "quote": "泓發喪，以義熙十二年僭即帝位，大赦殊死已下，改元永和，廬於諮議堂。",
          "sourceHash": "sha256:2cb29f9533dfee9bdc61ae61ab82246c4656da2266bf5dc18d9f6c7918c93a6c"
        }
      }
