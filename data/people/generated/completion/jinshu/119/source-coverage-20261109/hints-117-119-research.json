        },
        "s0027": {
          "unit": "s0027",
          "quote": "太元十九年，僭即帝位於槐里，大赦境內，改元曰皇初，遂如安定。",
          "sourceHash": "sha256:d1d06b71e7eeb56a40a60f6a3369869c86bc49634adf67291a861366c99cf8aa"
