  "sourceUnits": [
    {
      "id": "s0003",
      "kind": "paragraph-sentence",
      "blockIndex": 1,
      "collection": "sentences",
      "itemIndex": 0,
      "zh": "慕容德，字玄明，皝之少子也，母公孫氏夢日入臍中，晝寢而生德。",
      "en": "Murong De, whose courtesy name was Xuanming, was Murong Huang’s youngest son. His mother Lady Gongsun dreamed of the sun slipping into her navel, then bore him in a daytime doze.",
      "literal": "Murong De, courtesy name Xuanming, was the youngest son of Huang; his mother Lady Gongsun dreamed the sun entered her navel and, sleeping by day, gave birth to De."
    },
    {
      "id": "s0010",
      "kind": "paragraph-sentence",
      "blockIndex": 1,
      "collection": "sentences",
      "itemIndex": 7,
      "zh": "德兄垂甚壯之，因共論軍國大謀，言必切至。",
      "en": "Murong De’s elder brother Murong Chui was greatly impressed and began debating statecraft and strategy with him, and Murong De’s advice was always blunt and to the point.",
      "literal": "De’s elder brother Chui greatly admired him; therefore they together discussed great plans of army and state; his words were always incisive and to the point."
    },
    {
      "id": "s0011",
      "kind": "paragraph-sentence",
      "blockIndex": 1,
      "collection": "sentences",
      "itemIndex": 8,
      "zh": "垂謂之曰：「汝器識長進，非復吳下阿蒙也。」",
      "en": "Chui said to him: “Your capacity and insight have advanced; you are no longer Ah Meng of Wu.”",
      "literal": "Chui said to him: “Your capacity and insight have advanced; you are no longer Ah Meng of Wu.”"
    }
  ],
