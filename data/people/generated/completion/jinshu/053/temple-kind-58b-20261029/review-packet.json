      "units": [
        {
          "id": "s0101",
          "zh": "秦王天挺聖德，神武應期。",
          "translations": [
            {
              "lang": "en",
              "literal": "The Prince of Qin is heaven-endowed with sagely virtue, divine in arms and fitted to the hour.’",
              "idiomatic": "The Prince of Qin bears heaven’s sagely virtue, a warlike spirit born for the moment.",
              "translator": "Garrett M. Petersen (2026)",
              "model": "Composer 2"
            }
          ]
        },
        {
          "id": "s0102",
          "zh": "世祖之孫，王今為長。",
          "translations": [
            {
              "lang": "en",
              "literal": "He is a grandson of Emperor Shizu; you, Prince, are now the senior among us.",
              "idiomatic": "You are of Shizu’s line, and among the princes you now stand first.",
              "translator": "Garrett M. Petersen (2026)",
              "model": "Composer 2"
            }
          ]
        },
        {
          "id": "s0103",
          "zh": "凡我晉人，食土之類，龜筮克從，幽明同款。",
          "translations": [
            {
              "lang": "en",
              "literal": "All of us people of Jin who live on this soil—tortoise-shell and milfoil approve, and the spirits of light and dark are of one mind.",
              "idiomatic": "Every Jin subject dwelling on this earth finds tortoise and milfoil in accord, and both realms of the unseen give their assent.",
              "translator": "Garrett M. Petersen (2026)",
              "model": "Composer 2"
            }
          ]
        }
      ]
    },
