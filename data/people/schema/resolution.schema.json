{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://24histories.com/schema/people/resolution-v1.json",
  "title": "Person identity resolution decisions",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "batch", "decisions"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "batch": { "type": "string", "minLength": 1 },
    "authority": { "enum": ["model", "curated"] },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["decision", "localPeople", "basis", "confidence"],
        "properties": {
          "decision": { "enum": ["merge", "keep-separate", "possible-same-as", "split", "redirect"] },
          "canonicalPersonId": { "type": ["string", "null"] },
          "localPeople": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "basis": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "confidence": { "enum": ["high", "medium", "low"] },
          "notes": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  }
}
