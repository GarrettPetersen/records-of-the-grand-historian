{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://24histories.com/schema/people/extraction-packet-v1.json",
  "title": "Person extraction packet",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "book", "chapter", "source", "input", "units", "preflight", "context"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "book": { "type": "string", "pattern": "^[a-z0-9_-]+$" },
    "chapter": { "type": "string", "pattern": "^\\d{3}$" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "title"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "title": {
          "type": "object",
          "additionalProperties": false,
          "required": ["zh", "en"],
          "properties": {
            "zh": { "type": "string" },
            "en": { "type": "string" }
          }
        }
      }
    },
    "input": { "$ref": "https://24histories.com/schema/people/extraction-v1.json#/$defs/input" },
    "units": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "blockIndex", "collection", "itemIndex", "zh", "en", "literal"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "kind": { "enum": ["paragraph-sentence", "table-header-cell", "table-body-cell"] },
          "blockIndex": { "type": "integer", "minimum": 0 },
          "collection": { "enum": ["sentences", "cells"] },
          "itemIndex": { "type": "integer", "minimum": 0 },
          "zh": { "type": "string" },
          "en": { "type": "string" },
          "literal": { "type": "string" }
        }
      }
    },
    "preflight": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scannerVersion", "candidates"],
      "properties": {
        "scannerVersion": { "const": 1 },
        "candidates": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "unit", "language", "exact", "occurrence", "startCodePoint", "endCodePoint", "detectors"],
            "properties": {
              "id": { "type": "string", "pattern": "^[a-z0-9_-]+:\\d{3}:cand_[a-f0-9]{16}$" },
              "unit": { "type": "string", "minLength": 1 },
              "language": { "enum": ["zh", "en"] },
              "exact": { "type": "string", "minLength": 1 },
              "occurrence": { "type": "integer", "minimum": 0 },
              "startCodePoint": { "type": "integer", "minimum": 0 },
              "endCodePoint": { "type": "integer", "minimum": 1 },
              "detectors": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": ["kind"],
                  "properties": {
                    "kind": { "type": "string", "minLength": 1 },
                    "glossaryId": { "type": ["integer", "string"] },
                    "pinyin": { "type": ["string", "null"] },
                    "definitions": { "type": "array", "items": { "type": "string" } }
                  }
                }
              }
            }
          }
        }
      }
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["westernEraStyle", "roles", "polities", "reigns"],
      "properties": {
        "westernEraStyle": { "const": "BC_AD" },
        "roles": { "type": "array", "items": { "type": "object" } },
        "polities": { "type": "array", "items": { "type": "object" } },
        "reigns": { "type": "array", "items": { "type": "object" } }
      }
    }
  }
}
