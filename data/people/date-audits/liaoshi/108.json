      "id": "p003",
      "verdict": "research-blocked",
      "reason": "Complete source scope retains this as a research hold pending independent chronology approval.",
      "evidence": [
        {
          "unit": "s0016",
          "quote": "魏璘，不知何郡人，以卜名世，太宗得於汴。"
        }
      ]
    },
    {
      "id": "p004",
      "verdict": "research-blocked",
      "reason": "Complete source scope retains this as a research hold pending independent chronology approval.",
      "evidence": [
        {
          "unit": "s0041",
          "quote": "統和初，為大丞相韓德讓所薦，官至節度使。"
        }
      ]
    },
    {
      "id": "p005",
      "verdict": "research-blocked",
      "reason": "Complete source scope retains this as a research hold pending independent chronology approval.",
      "evidence": [
        {
          "unit": "s0049",
          "quote": "耶律乙不哥，字習撚，六院郎君古直之後。"
        }
      ]
    },
    {
      "id": "p006",
      "verdict": "research-blocked",
      "reason": "Complete source scope retains this as a research hold pending independent chronology approval.",
      "evidence": [
        {
          "unit": "s0002",
          "quote": "孔子稱「小道必有可觀」，醫卜是已。"
        }
      ]
    },
    {
      "id": "p007",
      "verdict": "research-blocked",
      "reason": "Complete source scope retains this as a research hold pending independent chronology approval.",
      "evidence": [
        {
          "unit": "s0006",
          "quote": "初，太祖破吐谷渾，一騎士棄橐反射，不中而去。"
        }
      ]
    },
    {
      "id": "p008",
      "verdict": "research-blocked",
      "reason": "Complete source scope retains this as a research hold pending independent chronology approval.",
      "evidence": [
        {
          "unit": "s0006",
          "quote": "初，太祖破吐谷渾，一騎士棄橐反射，不中而去。"
        }
      ]
    },
    {
