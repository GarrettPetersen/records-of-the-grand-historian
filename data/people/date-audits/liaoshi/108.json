      "verdict": "research-blocked",
      "reason": "Complete source scope retains this as a research hold pending independent chronology approval.",
      "evidence": [
        {
          "unit": "s0011",
          "quote": "由是進於太祖，淳欽皇后收養之。"
        }
      ]
    },
    {
      "id": "p010",
      "verdict": "research-blocked",
      "reason": "Complete source scope retains this as a research hold pending independent chronology approval.",
      "evidence": [
        {
          "unit": "s0013",
          "quote": "太宗時，以太醫給侍。"
        }
      ]
    },
    {
      "id": "p011",
      "verdict": "research-blocked",
      "reason": "Complete source scope retains this as a research hold pending independent chronology approval.",
      "evidence": [
