  "translationRepairs": [
    ["s0031","idiomatic","Totoq who follows along and arbitrarily issues relay horses shall receive 57 blows with the rod, be dismissed and reassigned elsewhere, and have the offense noted on his record;","Postal-station inspectors (toqtoγosun) who follow along and arbitrarily issue relay horses shall receive 57 blows with the rod, be dismissed and reassigned elsewhere, and have the offense noted on their record;","The statute applies a collective legal consequence to holders of the 脫脫禾孫 office, not to one named person.","high","applied"],
    ["s0031","literal","Totoq who follows along and arbitrarily issues relay horses receives 57 lashes, is dismissed and reassigned elsewhere, notation of offense;","Postal-station inspectors (toqtoγosun) who follow along and arbitrarily issue relay horses receive 57 lashes, are dismissed and reassigned elsewhere, with notation of offense;","The statute applies a collective legal consequence to holders of the 脫脫禾孫 office, not to one named person.","high","applied"],
    ["s0079","literal","All Mongol translators who can identify two or more cases of fraudulent documents receive one grade reduction in promotion.","All Mongol translators who can identify two or more cases of fraudulent documents are promoted one grade sooner.","減一資升轉 reduces the required seniority grade, accelerating promotion rather than imposing a reduction.","high","applied"],
    ["s0157","idiomatic","All Totoq who rashly assault and injure traveling envoys shall receive 47 blows with the rod, be dismissed, and have the offense noted on their record.","All postal-station inspectors (toqtoγosun) who rashly assault and injure traveling envoys shall receive 47 blows with the rod, be dismissed, and have the offense noted.","The plural legal formula 諸脫脫禾孫 identifies an officeholder class, not people named Totoq.","high","applied"]
