  "translationRepairs": [
    ["s0056","literal","Initially, Nao Chi killed Min Wang, Ju people sought Min Wang son Fa Zhang, got him Grand Historian Tao home, for person irrigated garden.","Initially, Nao Chi killed Min Wang, Ju people sought Min Wang son Fa Zhang, got him Grand Historian Jiao home, for person irrigated garden.","Chinese 太史嬓 names the Grand Historian as 嬓 (Jiao); literal Tao is a wrong reading, and the proposed Jiao matches the character and the idiomatic rendering.","high","applied"],
    ["s0057","literal","Tao daughter pitied good treated him.","Jiao daughter pitied good treated him.","Chinese 嬓女 is Jiao's daughter; literal Tao repeats the same misreading of 嬓, and Jiao is the correct name.","high","applied"],
    ["s0060","literal","Yan initially entered Qi, heard Hua yi person Wang Juan worthy, ordered army middle said 'surround Hua yi thirty li none enter', because Wang Juan reason.","Yan initially entered Qi, heard Hua yi person Wang Zhu worthy, ordered army middle said 'surround Hua yi thirty li none enter', because Wang Zhu reason.","Chinese 王蠋 is Wang Zhu; literal Juan misreads 蠋, and the proposed Zhu is the correct reading used in the idiomatic text.","high","applied"],
    ["s0061","literal","Soon after sent person told Juan said: 'Qi people much esteem your righteousness, I make you general, enfeoff you ten thousand households.'","Soon after sent person told Zhu said: 'Qi people much esteem your righteousness, I make you general, enfeoff you ten thousand households.'","The addressee in 謂蠋曰 is 蠋 (Zhu), not Juan; replacing Juan with Zhu corrects the name without changing the rest of the literal calque.","high","applied"],
    ["s0062","literal","Juan firmly declined.","Zhu firmly declined.","Subject 蠋固謝 is Zhu declining; Juan is the same misreading of 蠋 and should be Zhu.","high","applied"],
    ["s0064","literal","Wang Juan said: 'Loyal minister not serve two lords, chaste woman not change two husbands.","Wang Zhu said: 'Loyal minister not serve two lords, chaste woman not change two husbands.","Speech attribution 王蠋曰 names Wang Zhu as speaker; Wang Juan is an incorrect reading of 蠋.","high","applied"],
    ["s0070","literal","Qi perished grandees heard this, said: 'Wang Juan, commoner, righteousness not face north to Yan, moreover officials in position eating salary!'","Qi perished grandees heard this, said: 'Wang Zhu, commoner, righteousness not face north to Yan, moreover officials in position eating salary!'","The officials quote 王蠋; literal Wang Juan again misreads 蠋, and Wang Zhu is the accurate name.","high","applied"]
  ],
