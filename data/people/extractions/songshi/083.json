  "translationRepairs": [
    ["s0005","idiomatic","For the Huiyuan calendar, from the Superior Origin in the year jiazi to the third year of Shaoxi (1190), year xinhai, the accumulated count is 25,494,767 years.","For the Huiyuan calendar, from the Superior Origin in the year jiazi to the third year of Shaoxi (1192), year xinhai, the accumulated count is 25,494,767 years.","Chinese 紹熙三年 is Shaoxi year 3 (AD 1192); the parenthetical (1190) is Shaoxi 1 and must be corrected to 1192.","high","applied"],
    ["s0053","idiomatic","Huiyuan: 2,322,200.","Huiyuan: 2,322,000.","二百三十二萬二千 is 2,322,000 (232×10,000 + 2,000); 2,322,200 invents an extra 200 absent from the Chinese.","high","applied"],
    ["s0053","literal","Huiyuan: two million three hundred twenty-two thousand two hundred.","Huiyuan: two million three hundred twenty-two thousand.","二百三十二萬二千 reads “two million three hundred twenty-two thousand”; the literal’s “two hundred” is not in the Chinese.","high","applied"],
    ["s0204","idiomatic","Dusk-and-dawn remainder count: 173 and seven-eighths.","Dusk-and-dawn remainder count: 173¼.","In calendrical remainder notation 少 is the quarter fraction (¼), not seven-eighths; 一百七十三少 is therefore 173¼.","high","applied"],
    ["s0204","literal","Dusk-and-dawn remainder count: one hundred seventy-three and slightly less.","Dusk-and-dawn remainder count: one hundred seventy-three and a quarter.","少 after an integer remainder is the calendrical quarter, not “slightly less”; the literal should be “one hundred seventy-three and a quarter.”","high","applied"]
