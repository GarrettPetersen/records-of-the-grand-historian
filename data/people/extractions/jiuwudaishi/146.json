  "translationRepairs": [
    ["s0022","literal","Places that have suffered disaster or calumny and places with annual arrears are not subject to this rule.'","Places that have suffered disaster or calamity and places with annual arrears are not subject to this rule.'","Focus unit has 災沴, a compound for natural disaster or calamity; calumny is a mistranslation. Replacing it with calamity matches the Chinese and aligns with the idiomatic field's disaster wording.","high","applied"],
    ["s0050","idiomatic","Li Jilin, Prince Ji of Ji and military commissioner of Hezhong, is appointed concurrently to plan revenue and oversee the monopoly salt offices at the Anyi and Jie county pools; he shall draw up detailed regulations at once.'","Li Jilin, Prince of Ji and military commissioner of Hezhong, is appointed concurrently to plan revenue and oversee the monopoly salt offices at the Anyi and Jie county pools; he shall draw up detailed regulations at once.'","冀王 is the noble title Prince of Ji; Prince Ji of Ji wrongly treats 冀 as both a personal name and the fief. The proposed Prince of Ji is the correct English rendering and leaves the rest of the sentence intact.","high","applied"],
    ["s0050","literal","Prince Ji of Ji, Li Jilin, military commissioner of Hezhong, is appointed concurrently commissioner for planning revenue and monopoly salt commissioner of the Anyi and Jie county pools; he may at once draw up regulations, item by item.'","Prince of Ji, Li Jilin, military commissioner of Hezhong, is appointed concurrently commissioner for planning revenue and monopoly salt commissioner of the Anyi and Jie county pools; he may at once draw up regulations, item by item.'","The literal field repeats the same title error; 冀王 should be Prince of Ji, not Prince Ji of Ji. The replacement corrects only that phrasing.","high","applied"]
  ],
