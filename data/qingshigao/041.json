  "content": [
    {
      "type": "paragraph",
      "sentences": [
        {
          "id": "s0001",
          "zh": "志十六",
          "translations": []
        }
      ],
      "translations": []
    },
    {
      "type": "paragraph",
      "sentences": [
        {
          "id": "s0002",
          "zh": "災異二",
          "translations": []
        }
      ],
      "translations": []
    },
    {
      "type": "paragraph",
      "sentences": [
        {
          "id": "s0003",
          "zh": "洪範曰：「火曰炎上。",
          "translations": []
        },
        {
          "id": "s0004",
          "zh": "」火不炎上，則為咎徵。",
          "translations": []
        },
        {
          "id": "s0005",
          "zh": "凡恒燠、草異、羽蟲之孽、羊禍，其災火，赤眚、赤祥皆屬之於火。",
          "translations": []
        },
        {
          "id": "s0006",
          "zh": "順治十三年冬，莊浪燠，無雪。",
          "translations": []
        },
        {
          "id": "s0007",
          "zh": "十八年冬，龍門無雪。",
          "translations": []
        }
      ],
      "translations": []
    },
    {
      "type": "paragraph",
      "sentences": [
        {
          "id": "s0008",
          "zh": "康熙二十一年冬，西寧無雪。",
          "translations": []
        },
        {
          "id": "s0009",
          "zh": "二十七年冬，天鎮無雪。",
          "translations": []
        },
        {
          "id": "s0010",
          "zh": "三十五年冬，臨縣無雪。",
          "translations": []
        },
        {
          "id": "s0011",
          "zh": "四十一年冬，平原燠如夏。",
          "translations": []
        },
        {
          "id": "s0012",
          "zh": "四十二年冬，咸陽燠，無雪。",
          "translations": []
        },
        {
          "id": "s0013",
          "zh": "五十九年冬，浮山無雪。",
          "translations": []
        }
      ],
      "translations": []
    },
    {
      "type": "paragraph",
      "sentences": [
        {
          "id": "s0014",
          "zh": "乾隆四年冬，彭澤、元昌燠如夏，人有衣單衣者。",
          "translations": []
        },
        {
          "id": "s0015",
          "zh": "四十九年冬，菏澤無雪。",
          "translations": []
        },
        {
          "id": "s0016",
          "zh": "五十七年冬，蘇州無冰雪。",
          "translations": []
        }
      ],
      "translations": []
    },
    {
      "type": "paragraph",
      "sentences": [
        {
          "id": "s0017",
          "zh": "嘉慶三年冬，桐鄉燠。",
          "translations": []
        },
        {
          "id": "s0018",
          "zh": "十三年冬，昌黎無雪。",
          "translations": []
        },
        {
          "id": "s0019",
          "zh": "十八年冬，鄖縣無雪。",
          "translations": []
        },
        {
          "id": "s0020",
          "zh": "二十年二月，湖州大燠。",
          "translations": []
        },
        {
          "id": "s0021",
          "zh": "咸豐十年冬，皋蘭無雪。",
          "translations": []
        },
        {
          "id": "s0022",
          "zh": "同治元年冬，黃縣大燠。",
          "translations": []
        }
      ],
      "translations": []
    },
    {
      "type": "paragraph",
      "sentences": [
        {
          "id": "s0023",
          "zh": "光緒元年冬，望都、撫寧無雪。",
          "translations": []
        },
        {
          "id": "s0024",
          "zh": "十四年冬，皋蘭燠。",
          "translations": []
        }
      ],
      "translations": []
    },
    {
      "type": "paragraph",
      "sentences": [
        {
          "id": "s0025",
          "zh": "順治三年五月，丘縣雨麥。",
          "translations": []
        },
        {
          "id": "s0026",
          "zh": "六月，潮陽雨豆。",
          "translations": []
        },
        {
          "id": "s0027",
          "zh": "十一年六月，商州一蒂兩瓜，大如鬥。",
          "translations": []
        },
        {
          "id": "s0028",
          "zh": "十二年二月，渭南天雨粟，平樂天雨蕎麥。",
          "translations": []
        },
        {
          "id": "s0029",
          "zh": "三月，鳳陽、安西天雨叕麥、豌豆。",
          "translations": []
        },
        {
          "id": "s0030",
          "zh": "五月，臨潼、咸陽雨叕麥、豌豆。",
          "translations": []
        },
        {
          "id": "s0031",
          "zh": "十四年二月，婺源雨黍。",
          "translations": []
        },
        {
          "id": "s0032",
          "zh": "十五年冬，昌化竹生實。",
          "translations": []
        },
        {
          "id": "s0033",
          "zh": "十八年十月，高要竹生實。",
          "translations": []
        }
      ],
      "translations": []
    },
    {
      "type": "paragraph",
      "sentences": [
        {
          "id": "s0034",
          "zh": "康熙二年十月，阜陽雨粟，粒若蕎麥，圓小而堅，味辛，厚處盈寸。",
          "translations": []
        },
        {
          "id": "s0035",
          "zh": "三年七月，婺源大鄣山竹生實，形如麰，民采而舂食之，厥味甘。",
          "translations": []
        },
        {
          "id": "s0036",
          "zh": "二十一年三月，溫州雨豆。",
          "translations": []
        },
        {
          "id": "s0037",
          "zh": "二十二年四月，寧都天雨豆，又雨黑黍。",
          "translations": []
        },
        {
          "id": "s0038",
          "zh": "二十六年二月，合肥雨黑豆。",
          "translations": []
        },
        {
          "id": "s0039",
          "zh": "二十八年正月，含山雨小豆。",
          "translations": []
        },
        {
          "id": "s0040",
          "zh": "四十一年二月，湖南竹生實。",
          "translations": []
        },
        {
          "id": "s0041",
          "zh": "四十四年三月，葭州雨黑豆。",
          "translations": []
        },
        {
          "id": "s0042",
          "zh": "四十五年春，橫州竹生實。",
          "translations": []
        },
        {
          "id": "s0043",
          "zh": "六十年夏，安化天雨蕎麥。",
          "translations": []
        },
        {
          "id": "s0044",
          "zh": "六十一年正月，大埔竹結實。",
          "translations": []
        },
        {
          "id": "s0045",
          "zh": "十一月，岑溪枯竹開花。",
          "translations": []
        }
      ],
      "translations": []
    },
    {
      "type": "paragraph",
      "sentences": [
        {
          "id": "s0046",
          "zh": "雍正五年五月，鍾祥竹開花。",
          "translations": []
        },
        {
          "id": "s0047",
          "zh": "十月，當塗雨紅綠豆，形如小麥，無蒂。",
          "translations": []
        },
        {
          "id": "s0048",
          "zh": "十年，什邡縣雨蕎麥。",
          "translations": []
        },
        {
          "id": "s0049",
          "zh": "十一年二月，山陽、清河雨黑豆，啖之味苦。",
          "translations": []
        },
        {
          "id": "s0050",
          "zh": "十二年三月，宜昌竹結實，民采食之。",
          "translations": []
        },
        {
          "id": "s0051",
          "zh": "十三年七月，夷陵竹生實如麥，民競采食之。",
          "translations": []
        }
      ],
      "translations": []
    },
    {
      "type": "paragraph",
      "sentences": [
        {
          "id": "s0052",
          "zh": "乾隆二年二月，昌化雨豆。",
          "translations": []
        },
        {
          "id": "s0053",
          "zh": "六年十一月，成縣竹生實。",
          "translations": []
        },
        {
          "id": "s0054",
          "zh": "十八年九月，陽春竹皆結實枯死。",
          "translations": []
        },
        {
          "id": "s0055",
          "zh": "二十二年正月，永嘉東山竹結實如麥。",
          "translations": []
        },
        {
          "id": "s0056",
          "zh": "二十三年，池州雨豆。",
          "translations": []
        },
        {
          "id": "s0057",
          "zh": "二十六年，安化雨蕎麥，形似而小。",
          "translations": []
        },
        {
          "id": "s0058",
          "zh": "四十一年六月，餘姚雨小麥、黃豆。",
          "translations": []
        }
      ],
      "translations": []
    },
    {
      "type": "paragraph",
      "sentences": [
        {
          "id": "s0059",
          "zh": "嘉慶十二年春，黃陂雨豆。",
          "translations": []
        }
      ],
      "translations": []
    },
    {
      "type": "paragraph",
      "sentences": [
        {
          "id": "s0060",
          "zh": "道光二年夏，黃岩天雨菽。",
          "translations": []
        },
        {
          "id": "s0061",
          "zh": "四年十月，黃梅雨豆麥穀米。",
          "translations": []
        },
        {
          "id": "s0062",
          "zh": "十六年十二月，武寧雨豆。",
          "translations": []
        },
        {
          "id": "s0063",
          "zh": "二十年十一月，鍾祥竹開花。",
          "translations": []
        },
        {
          "id": "s0064",
          "zh": "二十五年七月，竹生米，可食。",
          "translations": []
        }
      ],
      "translations": []
    },
    {
      "type": "paragraph",
      "sentences": [
        {
          "id": "s0065",
          "zh": "咸豐元年六月，孝義廳山竹結實，人采食；",
          "translations": []
        },
        {
          "id": "s0066",
          "zh": "青浦竹生花。",
          "translations": []
        },
        {
          "id": "s0067",
          "zh": "二年十一月，太平雨豆。",
          "translations": []
        },
        {
          "id": "s0068",
          "zh": "四年二月，隨州天雨豆。",
          "translations": []
        },
        {
          "id": "s0069",
          "zh": "四月，黃岡雨黑豆，食之味苦。",
          "translations": []
        },
        {
          "id": "s0070",
          "zh": "冬，武昌縣雨黑豆。",
          "translations": []
        },
        {
          "id": "s0071",
          "zh": "五年正月初三日，孝感天雨小豆。",
          "translations": []
        },
        {
          "id": "s0072",
          "zh": "二月，又雨豆。",
          "translations": []
        },
        {
          "id": "s0073",
          "zh": "三月，武昌天雨黑豆，如槐實；",
          "translations": []
        },
        {
          "id": "s0074",
          "zh": "黃安雨豆。",
          "translations": []
        },
        {
          "id": "s0075",
          "zh": "夏，黃州、蘄水雨豆，如槐實。",
          "translations": []
        },
        {
          "id": "s0076",
          "zh": "十一月，黃岡天雨豆，如槐實；",
          "translations": []
        },
        {
          "id": "s0077",
          "zh": "歸州竹結實，人采食之。",
          "translations": []
        },
        {
          "id": "s0078",
          "zh": "六年八月，隨州雨豆。",
          "translations": []
        },
        {
          "id": "s0079",
          "zh": "八年二月，興國雨豆，色赤。",
          "translations": []
        },
        {
          "id": "s0080",
          "zh": "秋，興山竹結實。",
          "translations": []
        },
        {
          "id": "s0081",
          "zh": "九年春，麻城民間番瓜成人形。",
          "translations": []
        },
        {
          "id": "s0082",
          "zh": "十年，龍泉雨豆，色赤。",
          "translations": []
        },
        {
          "id": "s0083",
          "zh": "十一年三月，麻城雨豆。",
          "translations": []
        },
        {
          "id": "s0084",
          "zh": "十二月，溪梁雨豆，色赤。",
          "translations": []
        }
      ],
      "translations": []
    },
    {
      "type": "paragraph",
      "sentences": [
        {
          "id": "s0085",
          "zh": "同治元年八月，西寧丹噶爾廳竹開紅花；",
          "translations": []
        },
        {
          "id": "s0086",
          "zh": "灤州瓜窳剖之有血，食者立病。",
          "translations": []
        },
        {
          "id": "s0087",
          "zh": "三年正月，永豐天雨豆，五色斑爛。",
          "translations": []
        },
        {
          "id": "s0088",
          "zh": "三月，景寧、嵊縣雨豆。",
          "translations": []
        },
        {
          "id": "s0089",
          "zh": "五月，京山縣雨豆，其色黑光。",
          "translations": []
        },
        {
          "id": "s0090",
          "zh": "六年二月，棲霞雨草子如蕎麥。",
          "translations": []
        },
        {
          "id": "s0091",
          "zh": "夏，嵊縣雨豆。",
          "translations": []
        },
        {
          "id": "s0092",
          "zh": "七年，槁城生豆如人麵，五官俱備。",
          "translations": []
        },
        {
          "id": "s0093",
          "zh": "九年十月，遂昌雨穀，外黑內紅；",
          "translations": []
        },
        {
          "id": "s0094",
          "zh": "德興雨豆，內黑外白。",
          "translations": []
        },
        {
          "id": "s0095",
          "zh": "十一年三月，即墨天雨紅豆蕎麥。",
          "translations": []
        }
      ],
      "translations": []
    },
    {
      "type": "paragraph",
      "sentences": [
        {
          "id": "s0096",
          "zh": "光緒二年四月，青田雨豆。",
          "translations": []
        },
        {
          "id": "s0097",
          "zh": "九年三月，咸寧雨紅麥。",
          "translations": []
        },
        {
          "id": "s0098",
          "zh": "十年八月，孝義廳竹結實。",
          "translations": []
        },
        {
          "id": "s0099",
          "zh": "十一月，洮州山竹開花結實。",
          "translations": []
        },
        {
          "id": "s0100",
          "zh": "順治十四年，武昌鴉啣火，集人廬，輒災，一月始息。",
          "translations": []
        }
      ],
      "translations": []
    },
    {
      "type": "paragraph",
      "sentences": [
        {
          "id": "s0101",
          "zh": "康熙十六年，海豐有異鳥集林中三日，高六七尺，舒吭丈餘，啄雞鳧以食，居民奮擊之，分啖其肉，輒病死。",
          "translations": []
        }
      ],
      "translations": []
    },
    {
      "type": "paragraph",
      "sentences": [
        {
          "id": "s0102",
          "zh": "順治元年七月，商州郊外見大羊，色黃，長丈餘，百姓搏而殺之，肉重五百斤。",
          "translations": []
        },
        {
          "id": "s0103",
          "zh": "四年五月，山陰民家羊生羔，三足，前二後一。",
          "translations": []
        },
        {
          "id": "s0104",
          "zh": "五年，杭州民家羊生羔，三足。",
          "translations": []
        }
      ],
      "translations": []
    },
    {
      "type": "paragraph",
      "sentences": [
        {
          "id": "s0105",
          "zh": "康熙十二年，北山民家產一羊，一角一目，隨斃。",
          "translations": []
        },
        {
          "id": "s0106",
          "zh": "二十四年，順德羊生羔，三足，前一後二。",
          "translations": []
        }
      ],
      "translations": []
    },
    {
      "type": "paragraph",
      "sentences": [
        {
          "id": "s0107",
          "zh": "乾隆元年四月，連州山羊入城，蹄角甚巨，人逐獲之。",
          "translations": []
        },
        {
          "id": "s0108",
          "zh": "五十五年，雲夢見三足羊。",
          "translations": []
        },
        {
          "id": "s0109",
          "zh": "道光十七年八月，武進民家產羊，人首羊足，墮地即斃。",
          "translations": []
        },
        {
          "id": "s0110",
          "zh": "咸豐十年八月，江山西山白羊成群，倏不見。",
          "translations": []
        }
      ],
      "translations": []
    },
    {
      "type": "paragraph",
      "sentences": [
        {
          "id": "s0111",
          "zh": "同治三年，寧州民家羊產一羔，五角。",
          "translations": []
        }
      ],
      "translations": []
    },
    {
      "type": "paragraph",
      "sentences": [
        {
          "id": "s0112",
          "zh": "光緒九年九月，孝義廳民家羊產羔，人麵羊身。",
          "translations": []
        },
        {
          "id": "s0113",
          "zh": "二十五年，寧州民家羊產一羔，兩首。",
          "translations": []
        },
        {
          "id": "s0114",
          "zh": "二十七年三月，丹噶爾有一羊兩頭；",
          "translations": []
        },
        {
          "id": "s0115",
          "zh": "一羔三足。",
          "translations": []
        },
        {
          "id": "s0116",
          "zh": "三十三年，寧州民家羊生羔，人麵。",
          "translations": []
        }
      ],
      "translations": []
    },
    {
      "type": "paragraph",
      "sentences": [
        {
          "id": "s0117",
          "zh": "順治元年七月，西鄉文廟火。",
          "translations": []
        },
        {
          "id": "s0118",
          "zh": "六年正月初六日，無為州城門大火。",
          "translations": []
        },
        {
          "id": "s0119",
          "zh": "八年七月，嵐縣火焚民房。",
          "translations": []
        },
        {
          "id": "s0120",
          "zh": "十二年五月十八日，梧州府城外大火；",
          "translations": []
        },
        {
          "id": "s0121",
          "zh": "十二月又大火。",
          "translations": []
        },
        {
          "id": "s0122",
          "zh": "十四年十月，蘄水火。",
          "translations": []
        },
        {
          "id": "s0123",
          "zh": "十五年，連州大火。",
          "translations": []
        },
        {
          "id": "s0124",
          "zh": "十八年五月，宜昌大火，延燒民舍千餘間。",
          "translations": []
        },
        {
          "id": "s0125",
          "zh": "八月，嵊縣城中大火。",
          "translations": []
        }
      ],
      "translations": []
    },
    {
      "type": "paragraph",
      "sentences": [
        {
          "id": "s0126",
          "zh": "康熙元年五月，黃岡大火，焚民房十之八九。",
          "translations": []
        },
        {
          "id": "s0127",
          "zh": "秋，荊州大火，燒民房殆盡。",
          "translations": []
        },
        {
          "id": "s0128",
          "zh": "十月，興國火起自大西門，延燒城中，至大東門，男婦死者以千計。",
          "translations": []
        },
        {
          "id": "s0129",
          "zh": "二年二月初三日，海陽西郊火起，延燒民房千餘家。",
          "translations": []
        },
        {
          "id": "s0130",
          "zh": "七月十五日，黃岡大火，燒民舍殆盡。",
          "translations": []
        },
        {
          "id": "s0131",
          "zh": "三年四月，梧州府城外大火，焚八百餘家。",
          "translations": []
        },
        {
          "id": "s0132",
          "zh": "五月，海陽大火。",
          "translations": []
        },
        {
          "id": "s0133",
          "zh": "六月，含山鼓樓火。",
          "translations": []
        },
        {
          "id": "s0134",
          "zh": "四年正月，京山火，焚一百八十餘家。",
          "translations": []
        },
        {
          "id": "s0135",
          "zh": "十月，懷遠大火，自西城外至驛前，延燒一百五十餘家。",
          "translations": []
        },
        {
          "id": "s0136",
          "zh": "十一月，高州府城火，合浦火焚民舍。",
          "translations": []
        },
        {
          "id": "s0137",
          "zh": "十二月，廣州府城火。",
          "translations": []
        },
        {
          "id": "s0138",
          "zh": "五年正月，海陽南北二廂火起，延燒民房千餘間。",
          "translations": []
        },
        {
          "id": "s0139",
          "zh": "二月十三日，鍾祥火，毀數百家，延及府署，焚死人畜甚多；",
          "translations": []
        },
        {
          "id": "s0140",
          "zh": "二十八日，城內外又燔數百家。",
          "translations": []
        },
        {
          "id": "s0141",
          "zh": "秋，靈川北廂火起，延燒民房殆盡。",
          "translations": []
        },
        {
          "id": "s0142",
          "zh": "十二月，嚴州大火，民房盡毀，延燒城樓。",
          "translations": []
        },
        {
          "id": "s0143",
          "zh": "六年正月，海陽城外四廂火起，延燒民房千餘間，死於火者二百餘人。",
          "translations": []
        },
        {
          "id": "s0144",
          "zh": "七年三月，鄖陽府火，民舍盡毀。",
          "translations": []
        },
        {
          "id": "s0145",
          "zh": "七月，大冶西市火，延燒百餘家。",
          "translations": []
        },
        {
          "id": "s0146",
          "zh": "八月，宣化城內火，焚千餘家，次日城外又焚百餘家。",
          "translations": []
        },
        {
          "id": "s0147",
          "zh": "八年二月，海陽西北二廂火，焚民房數百間。",
          "translations": []
        },
        {
          "id": "s0148",
          "zh": "三月，鄖縣火。",
          "translations": []
        },
        {
          "id": "s0149",
          "zh": "十月，獨山州大火，仙居、黃岩二縣火。",
          "translations": []
        },
        {
          "id": "s0150",
          "zh": "九年，平樂南關火，延燒四十餘家。",
          "translations": []
        },
        {
          "id": "s0151",
          "zh": "是年十二月至次年四月，火災凡四見。",
          "translations": []
        }
      ],
      "translations": []
    },
    {
      "type": "paragraph",
      "sentences": [
        {
          "id": "s0152",
          "zh": "十年五月，錢塘大火。",
          "translations": []
        },
        {
          "id": "s0153",
          "zh": "七月，大冶西市火。",
          "translations": []
        },
        {
          "id": "s0154",
          "zh": "九月初七日，浦江太極宮大火。",
          "translations": []
        },
        {
          "id": "s0155",
          "zh": "十一年三月，縉雲大火，延燒縣署。",
          "translations": []
        },
        {
          "id": "s0156",
          "zh": "十二年九月，宣縣西門外沙市被火災四次，毀數百家。",
          "translations": []
        },
        {
          "id": "s0157",
          "zh": "十三年五月，靜樂火，毀民舍；",
          "translations": []
        },
        {
          "id": "s0158",
          "zh": "興國唐村火，焚死二百三十七人。",
          "translations": []
        },
        {
          "id": "s0159",
          "zh": "十五年七月，太平城內火，毀民房過半。",
          "translations": []
        },
        {
          "id": "s0160",
          "zh": "十八年正月初三日，望江吉水鎮火災，燔百餘家。",
          "translations": []
        },
        {
          "id": "s0161",
          "zh": "六月，順慶府治火。",
          "translations": []
        },
        {
          "id": "s0162",
          "zh": "十九年正月十五日，平陽火，毀民居過半。",
          "translations": []
        },
        {
          "id": "s0163",
          "zh": "三月初四日，海陽火，延燒百餘家，死者四十餘人。",
          "translations": []
        },
        {
          "id": "s0164",
          "zh": "七月，和平城外火，延燒百餘家。",
          "translations": []
        }
      ],
      "translations": []
    },
    {
      "type": "paragraph",
      "sentences": [
        {
          "id": "s0165",
          "zh": "二十年二月，東湖縣署火。",
          "translations": []
        },
        {
          "id": "s0166",
          "zh": "五月，蒼梧東廊火。",
          "translations": []
        },
        {
          "id": "s0167",
          "zh": "八月，濟寧州大堂火，溫州火，燎民舍五千餘間。",
          "translations": []
        },
        {
          "id": "s0168",
          "zh": "九月，永嘉城中大火，燎民舍千餘間。",
          "translations": []
        },
        {
          "id": "s0169",
          "zh": "十月，思州府火，延燒五十餘家。",
          "translations": []
        },
        {
          "id": "s0170",
          "zh": "二十一年春，濟寧州城內東偏大火，延及西隅，民舍皆盡，關壯繆侯祠亦毀，獨神像香案無恙。",
          "translations": []
        },
        {
          "id": "s0171",
          "zh": "八月，池州天火，毀田禾芋苗，葉盡生煙。",
          "translations": []
        },
        {
          "id": "s0172",
          "zh": "十月，萬載火，延燒城隍廟，連山西郊火。",
          "translations": []
        },
        {
          "id": "s0173",
          "zh": "二十二年四月，囗陽西門火。",
          "translations": []
        },
        {
          "id": "s0174",
          "zh": "二十三年七月，長寧城隍廟火。",
          "translations": []
        },
        {
          "id": "s0175",
          "zh": "冬，忠州石寶寨火。",
          "translations": []
        },
        {
          "id": "s0176",
          "zh": "二十五年四月，萬載火，延燒城隍廟；",
          "translations": []
        },
        {
          "id": "s0177",
          "zh": "六合南門火，焚市廛數百間。",
          "translations": []
        },
        {
          "id": "s0178",
          "zh": "二十六年十月初一日，平陽城樓火，燔百餘家；",
          "translations": []
        },
        {
          "id": "s0179",
          "zh": "忠州石寶寨又火。",
          "translations": []
        },
        {
          "id": "s0180",
          "zh": "二十七年八月，婺源火，延燒五十餘家。",
          "translations": []
        },
        {
          "id": "s0181",
          "zh": "十二月，合浦西橋火，郡城火。",
          "translations": []
        },
        {
          "id": "s0182",
          "zh": "二十八年九月己卯，蒼梧西關火。",
          "translations": []
        },
        {
          "id": "s0183",
          "zh": "十二月，鬆陽火。",
          "translations": []
        },
        {
          "id": "s0184",
          "zh": "二十九年七月二十八日，酆都城內大火，民居盡毀。",
          "translations": []
        }
      ],
      "translations": []
    },
    {
      "type": "paragraph",
      "sentences": [
        {
          "id": "s0185",
          "zh": "三十年十月，平樂火，延燒二百餘家；",
          "translations": []
        },
        {
          "id": "s0186",
          "zh": "獨山州大火。",
          "translations": []
        },
        {
          "id": "s0187",
          "zh": "三十一年九月，平陽城樓火。",
          "translations": []
        },
        {
          "id": "s0188",
          "zh": "三十二年夏，鎮安府署火，延燒民居數十間。",
          "translations": []
        },
        {
          "id": "s0189",
          "zh": "九月，平陽東門外火，燔數十家。",
          "translations": []
        },
        {
          "id": "s0190",
          "zh": "三十四年正月，馬平南川河下火，延燒大南門城樓。",
          "translations": []
        },
        {
          "id": "s0191",
          "zh": "三十五年七月，江夏火起自火藥庫，死者無算。",
          "translations": []
        },
        {
          "id": "s0192",
          "zh": "八月，陽高南街火。",
          "translations": []
        },
        {
          "id": "s0193",
          "zh": "三十七年二月，漢陽漢口鎮火，延燒數千家。",
          "translations": []
        }
      ],
      "translations": []
    },
    {
      "type": "paragraph",
      "sentences": [
        {
          "id": "s0194",
          "zh": "四十年九月，陽山火，延燒二百餘家。",
          "translations": []
        },
        {
          "id": "s0195",
          "zh": "四十一年二月，崖州火，傷四人。",
          "translations": []
        },
        {
          "id": "s0196",
          "zh": "四十二年七月十六日，桐鄉青鎮火，燔民舍一百七十餘家。",
          "translations": []
        },
        {
          "id": "s0197",
          "zh": "四十三年正月二十九日夜，灌陽火，焚東門外民舍殆盡。",
          "translations": []
        },
        {
          "id": "s0198",
          "zh": "四十四年三月，婺源太平坊火。",
          "translations": []
        },
        {
          "id": "s0199",
          "zh": "十一月，武寧火。",
          "translations": []
        },
        {
          "id": "s0200",
          "zh": "四十五年四月，竹溪火，官署民房俱燼。",
          "translations": []
        },
        {
          "id": "s0201",
          "zh": "四十六年正月初四日，荔浦火，初囗又火。",
          "translations": []
        },
        {
          "id": "s0202",
          "zh": "巴縣太平門大火。",
          "translations": []
        },
        {
          "id": "s0203",
          "zh": "四十八年三月，獨山州城內大火，居民無得免者。",
          "translations": []
        },
        {
          "id": "s0204",
          "zh": "四十九年八月二十五日，嘉定火，延燒七十餘家。",
          "translations": []
        }
      ],
      "translations": []
    },
    {
      "type": "paragraph",
      "sentences": [
        {
          "id": "s0205",
          "zh": "五十年正月，大埔白堠墟火，毀民舍數百家。",
          "translations": []
        },
        {
          "id": "s0206",
          "zh": "五月，萬載潭埠火，市店民房蕩然無存。",
          "translations": []
        },
        {
          "id": "s0207",
          "zh": "五十二年十一月，宣平火。",
          "translations": []
        },
        {
          "id": "s0208",
          "zh": "五十三年九月初八日，宣化沙市火，焚千餘家；",
          "translations": []
        },
        {
          "id": "s0209",
          "zh": "獨山州大火。",
          "translations": []
        },
        {
          "id": "s0210",
          "zh": "五十四年九月，江陵火，延燒二千餘家。",
          "translations": []
        },
        {
          "id": "s0211",
          "zh": "五十五年九月，江陵又火，延燒二十餘家，死十一人；",
          "translations": []
        },
        {
          "id": "s0212",
          "zh": "思州府城大火，延燒四十餘家。",
          "translations": []
        },
        {
          "id": "s0213",
          "zh": "五十六年五月初三日，丹棱縣大火，延燒數百家。",
          "translations": []
        },
        {
          "id": "s0214",
          "zh": "五十七年三月，合肥城內大火，延燒四十餘家。",
          "translations": []
        },
        {
          "id": "s0215",
          "zh": "八月初一日，鍾祥城內火，延燒城外民房數百間。",
          "translations": []
        },
        {
          "id": "s0216",
          "zh": "五十九年十月，蒼梧西門外大火。",
          "translations": []
        },
        {
          "id": "s0217",
          "zh": "六十年四月十八日，鹽山縣城火，自學宮延燒東南北三門，毀民居數千家。",
          "translations": []
        },
        {
          "id": "s0218",
          "zh": "六十一年二月，無為州小西門內火，延燒三十餘家。",
          "translations": []
        },
        {
          "id": "s0219",
          "zh": "七月，獨山州東門火。",
          "translations": []
        },
        {
          "id": "s0220",
          "zh": "冬，麗水縣火。",
          "translations": []
        }
      ],
      "translations": []
    },
    {
      "type": "paragraph",
      "sentences": [
        {
          "id": "s0221",
          "zh": "雍正二年正月，沔陽仙桃鎮大火，焚百餘家，死者甚眾。",
          "translations": []
        },
        {
          "id": "s0222",
          "zh": "七月，梧州梧城驛火。",
          "translations": []
        },
        {
          "id": "s0223",
          "zh": "十月，城內火。",
          "translations": []
        },
        {
          "id": "s0224",
          "zh": "十一月，戎墟火。",
          "translations": []
        },
        {
          "id": "s0225",
          "zh": "十二月初一日，開化城內火，延燒百餘家。",
          "translations": []
        },
        {
          "id": "s0226",
          "zh": "三年六月，梓潼縣文昌廟火。",
          "translations": []
        },
        {
          "id": "s0227",
          "zh": "七月，馬平小南門火，延燒三百餘家。",
          "translations": []
        },
        {
          "id": "s0228",
          "zh": "四年十二月初四日，平陽西門外火，燔百餘家。",
          "translations": []
        },
        {
          "id": "s0229",
          "zh": "五年十二月，北流民舍失火，延燒縣署，案牘皆盡。",
          "translations": []
        },
        {
          "id": "s0230",
          "zh": "六年正月十六日夜，蒼梧火，延燒民居一百七十餘間；",
          "translations": []
        },
        {
          "id": "s0231",
          "zh": "高州城東火。",
          "translations": []
        },
        {
          "id": "s0232",
          "zh": "十月，昆山火，焚朝陽門譙樓。",
          "translations": []
        },
        {
          "id": "s0233",
          "zh": "七年九月，蒼梧戎墟火。",
          "translations": []
        },
        {
          "id": "s0234",
          "zh": "九年正月，荊州大火。",
          "translations": []
        },
        {
          "id": "s0235",
          "zh": "十年五月初三日，阜陽西城火，延燒民舍四千六百十一間。",
          "translations": []
        },
        {
          "id": "s0236",
          "zh": "十一年七月初七日，玉屏聞空中有呼救火聲，越半月，鼓樓街災，燒民居數百家。",
          "translations": []
        },
        {
          "id": "s0237",
          "zh": "十三年冬，婺源城隍廟災。",
          "translations": []
        }
      ],
      "translations": []
    },
    {
      "type": "paragraph",
      "sentences": [
        {
          "id": "s0238",
          "zh": "乾隆元年四月，通州北郭火，延燒百餘家。",
          "translations": []
        },
        {
          "id": "s0239",
          "zh": "十一月，玉屏南門火。",
          "translations": []
        },
        {
          "id": "s0240",
          "zh": "二年二月十八日，鎮安府城火，燔數百家。",
          "translations": []
        },
        {
          "id": "s0241",
          "zh": "三月乙丑，同官明倫堂大火。",
          "translations": []
        },
        {
          "id": "s0242",
          "zh": "五月，沁州大街火。",
          "translations": []
        },
        {
          "id": "s0243",
          "zh": "九月，北流典史署火，延燒民舍。",
          "translations": []
        },
        {
          "id": "s0244",
          "zh": "三年十月初七日，潮陽南門火。",
          "translations": []
        },
        {
          "id": "s0245",
          "zh": "四年正月十七日，瑞安大火，燔百餘家。",
          "translations": []
        },
        {
          "id": "s0246",
          "zh": "四月十八日，鎮安城內火，延燒八十餘家。",
          "translations": []
        },
        {
          "id": "s0247",
          "zh": "五年二月，嵊縣火，延燒二百餘家。",
          "translations": []
        },
        {
          "id": "s0248",
          "zh": "六年正月初六日，梧州府南門外火，延燒民房三百餘家。",
          "translations": []
        },
        {
          "id": "s0249",
          "zh": "七年二月十四夜，饒平縣城火，延燒大樓房三十餘間，小屋無數。",
          "translations": []
        },
        {
          "id": "s0250",
          "zh": "八年十一月，饒平縣又火。",
          "translations": []
        },
        {
          "id": "s0251",
          "zh": "十年二月庚午，泰安縣署火，延燒百餘家。",
          "translations": []
        },
        {
          "id": "s0252",
          "zh": "十一年六月，海豐龍津橋火，延燒蓬鋪四十餘間。",
          "translations": []
        },
        {
          "id": "s0253",
          "zh": "十二年八月，化州南街火。",
          "translations": []
        },
        {
          "id": "s0254",
          "zh": "九月，豐順縣城火。",
          "translations": []
        },
        {
          "id": "s0255",
          "zh": "十一月初十日，崖州東街火，延燒七十餘家，傷二人。",
          "translations": []
        },
        {
          "id": "s0256",
          "zh": "十五年四月，泰安火。",
          "translations": []
        },
        {
          "id": "s0257",
          "zh": "十七年正月朔，漢陽糧船火，焚數十艘。",
          "translations": []
        },
        {
          "id": "s0258",
          "zh": "四月，桐鄉南柵大火，毀市廛三百餘家。",
          "translations": []
        },
        {
          "id": "s0259",
          "zh": "五月二十二日，保昌孝悌街火，延燒三十餘家。",
          "translations": []
        },
        {
          "id": "s0260",
          "zh": "十八年七月，陸川大火，燬民居。",
          "translations": []
        },
        {
          "id": "s0261",
          "zh": "十月，梧州府城外大火，傷二十餘人。",
          "translations": []
        },
        {
          "id": "s0262",
          "zh": "十九年八月，蒼梧府城外又火。",
          "translations": []
        },
        {
          "id": "s0263",
          "zh": "二十年三月，高州府城火，五月又火。",
          "translations": []
        },
        {
          "id": "s0264",
          "zh": "二十二年十月，宜昌東湖火，燔民居無數。",
          "translations": []
        },
        {
          "id": "s0265",
          "zh": "二十三年三月初一日，重慶太平門外大火。",
          "translations": []
        },
        {
          "id": "s0266",
          "zh": "四月，獨山州大火。",
          "translations": []
        },
        {
          "id": "s0267",
          "zh": "二十四年十二月初八日，惠來縣署火。",
          "translations": []
        },
        {
          "id": "s0268",
          "zh": "二十五年八月二十八日，朝天千斯門內大火。",
          "translations": []
        },
        {
          "id": "s0269",
          "zh": "二十七年十月，石門玉溪鎮火，延燒百餘家。",
          "translations": []
        },
        {
          "id": "s0270",
          "zh": "二十八年十二月初五日，慶元火，延燒五十餘家。",
          "translations": []
        },
        {
          "id": "s0271",
          "zh": "二十九年五月，沂水縣城南綢市街火，延燒數百家。",
          "translations": []
        },
        {
          "id": "s0272",
          "zh": "十月，婺源西關外居民失火，延燒數百家。",
          "translations": []
        },
        {
          "id": "s0273",
          "zh": "三十年十月，梧州府城外火。",
          "translations": []
        },
        {
          "id": "s0274",
          "zh": "三十一年十一月，蒼梧戎墟大火三次，共燒民房六百餘家。",
          "translations": []
        },
        {
          "id": "s0275",
          "zh": "三十三年正月二十八日，梧州府城外火，延燒三百餘家。",
          "translations": []
        },
        {
          "id": "s0276",
          "zh": "三十八年七月，金華府署火。",
          "translations": []
        },
        {
          "id": "s0277",
          "zh": "四十二年十二月，青田城大火。",
          "translations": []
        },
        {
          "id": "s0278",
          "zh": "四十四年十一月初四日，桐鄉大火，燔市廛四十餘家。",
          "translations": []
        },
        {
          "id": "s0279",
          "zh": "四十六年夏，陸川城南失火，延燒縣署。",
          "translations": []
        },
        {
          "id": "s0280",
          "zh": "四十七年六月，寧波府城火，毀鼓樓。",
          "translations": []
        },
        {
          "id": "s0281",
          "zh": "四十八年五月庚子，慶元火，延燒百餘家。",
          "translations": []
        },
        {
          "id": "s0282",
          "zh": "四十九年四月朔，成都大火，延燒官署民舍殆盡。",
          "translations": []
        },
        {
          "id": "s0283",
          "zh": "五十年夏，潛江城外火。",
          "translations": []
        },
        {
          "id": "s0284",
          "zh": "五十二年三月，江陵城隍廟火。",
          "translations": []
        },
        {
          "id": "s0285",
          "zh": "五十五年三月，義烏縣署火。",
          "translations": []
        },
        {
          "id": "s0286",
          "zh": "五十六年十二月，南昌火，延燒千餘家。",
          "translations": []
        }
      ],
      "translations": []
    },
    {
      "type": "paragraph",
      "sentences": [
        {
          "id": "s0287",
          "zh": "嘉慶三年二月丙子，京師乾清宮火。",
          "translations": []
        },
        {
          "id": "s0288",
          "zh": "九年七月初三日，定海城中大火，延燒二百餘家。",
          "translations": []
        },
        {
          "id": "s0289",
          "zh": "十三年五月十二夜，濟南府西門大火，延燒四百餘家。",
          "translations": []
        },
        {
          "id": "s0290",
          "zh": "十六年三月二十九日，石門城西火。",
          "translations": []
        },
        {
          "id": "s0291",
          "zh": "十七年春，齊東火，燒死數百人。",
          "translations": []
        },
        {
          "id": "s0292",
          "zh": "十八年三月，貴陽城大火。",
          "translations": []
        },
        {
          "id": "s0293",
          "zh": "二十年四月，尚山火。",
          "translations": []
        },
        {
          "id": "s0294",
          "zh": "十二月二十日，蘭州西門火藥局焚軒轅城樓民舍，死者數十人。",
          "translations": []
        },
        {
          "id": "s0295",
          "zh": "二十二年八月，黃陽火，燒民舍一百餘家。",
          "translations": []
        },
        {
          "id": "s0296",
          "zh": "二十四年閏四月，青田火，延燒二百餘家。",
          "translations": []
        },
        {
          "id": "s0297",
          "zh": "五月，青浦城火，延燒七十餘家。",
          "translations": []
        }
      ],
      "translations": []
    },
    {
      "type": "paragraph",
      "sentences": [
        {
          "id": "s0298",
          "zh": "道光二年六月十一日，大埔南門外火，延燒兩晝夜。",
          "translations": []
        },
        {
          "id": "s0299",
          "zh": "九年七月十三日，江山江郎山火，延燒兩晝夜。",
          "translations": []
        },
        {
          "id": "s0300",
          "zh": "十年八月，鉛山石塘火，延燒五百餘家；",
          "translations": []
        },
        {
          "id": "s0301",
          "zh": "次年又火。",
          "translations": []
        },
        {
          "id": "s0302",
          "zh": "十六年十二月十九日，雲和火，毀民舍八十餘家。",
          "translations": []
        },
        {
          "id": "s0303",
          "zh": "十九年正月初二日，貴陽府道德橋火，延及貢院頭門。",
          "translations": []
        },
        {
          "id": "s0304",
          "zh": "三月二十日，貴陽府學大成殿災；",
          "translations": []
        },
        {
          "id": "s0305",
          "zh": "江陵沙市大火，燔數百家。",
          "translations": []
        },
        {
          "id": "s0306",
          "zh": "四月，定海道頭港營船火。",
          "translations": []
        },
        {
          "id": "s0307",
          "zh": "二十二年十月初三日，麗水火，燔一百四十七家。",
          "translations": []
        },
        {
          "id": "s0308",
          "zh": "二十五年冬，黃岩蒼頭街火。",
          "translations": []
        },
        {
          "id": "s0309",
          "zh": "二十六年五月，貴陽火，燒民房八百餘家。",
          "translations": []
        },
        {
          "id": "s0310",
          "zh": "二十九年十二月初三日，太平城隍廟火災。",
          "translations": []
        }
      ],
      "translations": []
    },
    {
      "type": "paragraph",
      "sentences": [
        {
          "id": "s0311",
          "zh": "咸豐元年十月，太平火，燔百餘家。",
          "translations": []
        },
        {
          "id": "s0312",
          "zh": "二年八月，通州西庫火。",
          "translations": []
        },
        {
          "id": "s0313",
          "zh": "十月，武昌縣署火。",
          "translations": []
        },
        {
          "id": "s0314",
          "zh": "十一月，漢陽火。",
          "translations": []
        },
        {
          "id": "s0315",
          "zh": "六年十一月，枝江火，燔市廛八百餘家。",
          "translations": []
        },
        {
          "id": "s0316",
          "zh": "七年五月，皋蘭西關火，延燒市廛二百餘間。",
          "translations": []
        },
        {
          "id": "s0317",
          "zh": "八年秋，武昌縣左市火。",
          "translations": []
        },
        {
          "id": "s0318",
          "zh": "十年二月，青浦火，麗水火。",
          "translations": []
        }
      ],
      "translations": []
    },
    {
      "type": "paragraph",
      "sentences": [
        {
          "id": "s0319",
          "zh": "同治元年冬，黃山石路橋大火。",
          "translations": []
        },
        {
          "id": "s0320",
          "zh": "三年十月，黃岩火。",
          "translations": []
        },
        {
          "id": "s0321",
          "zh": "五年十一月，漢口火；",
          "translations": []
        },
        {
          "id": "s0322",
          "zh": "餘幹瑞洪鎮火，延燒四百餘家。",
          "translations": []
        },
        {
          "id": "s0323",
          "zh": "六年三月，江夏火藥局災，斃者以千計。",
          "translations": []
        },
        {
          "id": "s0324",
          "zh": "五月二十五日，漢陽鮑家巷火，燔船隻，傷人口甚眾。",
          "translations": []
        },
        {
          "id": "s0325",
          "zh": "七年十月，太平縣城火，燔四百餘家。",
          "translations": []
        },
        {
          "id": "s0326",
          "zh": "九年冬，黃岩火。",
          "translations": []
        },
        {
          "id": "s0327",
          "zh": "十一年四月，烏程火，延燒十餘里。",
          "translations": []
        },
        {
          "id": "s0328",
          "zh": "十三年五月，武昌縣小西門火。",
          "translations": []
        }
      ],
      "translations": []
    },
    {
      "type": "paragraph",
      "sentences": [
        {
          "id": "s0329",
          "zh": "光緒二年七月壬午，青浦城火，延燒三十餘家；",
          "translations": []
        },
        {
          "id": "s0330",
          "zh": "九月庚寅又火，東碼頭上下岸俱燼。",
          "translations": []
        },
        {
          "id": "s0331",
          "zh": "六年十一月，武昌縣北市火。",
          "translations": []
        },
        {
          "id": "s0332",
          "zh": "二十八年二月，皋蘭南街大火。",
          "translations": []
        },
        {
          "id": "s0333",
          "zh": "二十九年十月，西寧火。",
          "translations": []
        },
        {
          "id": "s0334",
          "zh": "三十一年七月，西寧大街火；",
          "translations": []
        },
        {
          "id": "s0335",
          "zh": "十一月，孔子文廟災。",
          "translations": []
        }
      ],
      "translations": []
    },
    {
      "type": "paragraph",
      "sentences": [
        {
          "id": "s0336",
          "zh": "宣統元年正月初四日，皋蘭縣災，延燒官舍六十餘間。",
          "translations": []
        },
        {
          "id": "s0337",
          "zh": "二月二十六日，蘭州省城院門南街大火，延燒房屋二百零九間。",
          "translations": []
        }
      ],
      "translations": []
    },
    {
      "type": "paragraph",
      "sentences": [
        {
          "id": "s0338",
          "zh": "順治十年二月，曹縣夜間火光遍野。",
          "translations": []
        },
        {
          "id": "s0339",
          "zh": "五月，渭南四野火災，見持炬人三尺許，眾繞火際，次日焚處拾一折簡，字數行，如人書，其語曰：「土地不寧，天降凶神三位，一收牛，一收馬，一收人。",
          "translations": []
        },
        {
          "id": "s0340",
          "zh": "」十四年十月二十七日，清豐空中起火，燒民房數百間。",
          "translations": []
        }
      ],
      "translations": []
    },
    {
      "type": "paragraph",
      "sentences": [
        {
          "id": "s0341",
          "zh": "康熙十二年三月，縉雲曉見黧麵人從空中放火，捕之不見。",
          "translations": []
        },
        {
          "id": "s0342",
          "zh": "五月，寧波仙鎮廟井中有火光上騰。",
          "translations": []
        },
        {
          "id": "s0343",
          "zh": "十四年八月十五日，海豐火光遍野。",
          "translations": []
        },
        {
          "id": "s0344",
          "zh": "二十五年二月，兩廣總督衙門兩旗竿忽白晝飛火，焚其右，焦灼過半。",
          "translations": []
        },
        {
          "id": "s0345",
          "zh": "三十一年秋，南樂空中有火，著鐵皆明，自申至亥乃止。",
          "translations": []
        },
        {
          "id": "s0346",
          "zh": "五十年二月丙寅，東平烈風中有火光。",
          "translations": []
        }
      ],
      "translations": []
    },
    {
      "type": "paragraph",
      "sentences": [
        {
          "id": "s0347",
          "zh": "乾隆十七年四月二十九日，岐山有火光，自西而東。",
          "translations": []
        },
        {
          "id": "s0348",
          "zh": "七月，芮城有火光如電。",
          "translations": []
        },
        {
          "id": "s0349",
          "zh": "二十年十一月，彭澤江心洲有穴出火，投葦輒燃，久而不息。",
          "translations": []
        },
        {
          "id": "s0350",
          "zh": "二十二年二月二日，高平有火球大如鬥，其色黃紅綠相間，就地行走，不知所終。",
          "translations": []
        },
        {
          "id": "s0351",
          "zh": "二十七年九月，臨縣空中有火光大如鬥，墜城南隅。",
          "translations": []
        },
        {
          "id": "s0352",
          "zh": "三十三年三月，即墨日夕有火球經天。",
          "translations": []
        },
        {
          "id": "s0353",
          "zh": "五十年冬，棗陽有火球如鬥，飛半裏外。",
          "translations": []
        }
      ],
      "translations": []
    },
    {
      "type": "paragraph",
      "sentences": [
        {
          "id": "s0354",
          "zh": "嘉慶九年二月十二日，滕縣城東石溝見火球飛落。",
          "translations": []
        },
        {
          "id": "s0355",
          "zh": "十二年四月，黃安有火大如球，自東而西，落於泮池。",
          "translations": []
        },
        {
          "id": "s0356",
          "zh": "十六年夏，撫寧夜遍地起火。",
          "translations": []
        }
      ],
      "translations": []
    },
    {
      "type": "paragraph",
      "sentences": [
        {
          "id": "s0357",
          "zh": "道光三年三月，蘄州、清江水中出火。",
          "translations": []
        },
        {
          "id": "s0358",
          "zh": "二十年五月，均州夜見火光。",
          "translations": []
        },
        {
          "id": "s0359",
          "zh": "二十二年十一月，鄖西地中出火。",
          "translations": []
        },
        {
          "id": "s0360",
          "zh": "二十四年七月，光化遍地綠火。",
          "translations": []
        },
        {
          "id": "s0361",
          "zh": "二十六年正月，平鄉火光遍野。",
          "translations": []
        }
      ],
      "translations": []
    },
    {
      "type": "paragraph",
      "sentences": [
        {
          "id": "s0362",
          "zh": "咸豐元年八月二十八日，隨州有天火自西南流東北，其光觸地，有聲如鼓。",
          "translations": []
        },
        {
          "id": "s0363",
          "zh": "三年正月，通州有火如星如燐，以千百計，自西南趨東北，凡四五夜始熄。",
          "translations": []
        },
        {
          "id": "s0364",
          "zh": "十年冬，肥城既昏，有火從地中起，如燐而火，色赤而青，作二流光，遍地皆燃。",
          "translations": []
        }
      ],
      "translations": []
    },
    {
      "type": "paragraph",
      "sentences": [
        {
          "id": "s0365",
          "zh": "同治二年九月，曲陽有火球自西南飛向東北，或散四方，或聚為一，其象無常。",
          "translations": []
        },
        {
          "id": "s0366",
          "zh": "四年，通渭、泰安火光西現如隕星。",
          "translations": []
        }
      ],
      "translations": []
    },
    {
      "type": "paragraph",
      "sentences": [
        {
          "id": "s0367",
          "zh": "光緒元年正月十四日，灤州五聖祠突有火光，俄而火起高矗雲霄，祠竟無恙。",
          "translations": []
        },
        {
          "id": "s0368",
          "zh": "五年冬，玉田見火球飛向東北，其聲如雷。",
          "translations": []
        },
        {
          "id": "s0369",
          "zh": "二十二年四月戊子，南樂有火光徑尺，明如月，自西南往東北，尾長丈許，忽炸為火星四散。",
          "translations": []
        },
        {
          "id": "s0370",
          "zh": "二十三年五月戊午夕，南樂有火光，圓可徑尺，飛向西南。",
          "translations": []
        },
        {
          "id": "s0371",
          "zh": "二十五年十一月乙未夜，南樂有火光流空中，其明如月。",
          "translations": []
        },
        {
          "id": "s0372",
          "zh": "二十六年七月壬戌夜，南樂有火光流空中。",
          "translations": []
        }
      ],
      "translations": []
    },
    {
      "type": "paragraph",
      "sentences": [
        {
          "id": "s0373",
          "zh": "順治三年六月初四日，鎮洋新安鎮李明家地出血。",
          "translations": []
        },
        {
          "id": "s0374",
          "zh": "初五日，俞二家地出血尤甚。",
          "translations": []
        },
        {
          "id": "s0375",
          "zh": "五年夏，嘉定見赤氣互東方。",
          "translations": []
        },
        {
          "id": "s0376",
          "zh": "七年冬，鶴王鎮鄉民見血從地湧出。",
          "translations": []
        },
        {
          "id": "s0377",
          "zh": "九年正月，東昌有赤光，聲如水鴨，往東南而沒。",
          "translations": []
        },
        {
          "id": "s0378",
          "zh": "十六年，永年南關外地中湧血，嘶嘶有聲。",
          "translations": []
        }
      ],
      "translations": []
    },
    {
      "type": "paragraph",
      "sentences": [
        {
          "id": "s0379",
          "zh": "康熙十四年四月，萊陽地湧血丈餘，氣腥，久不敢近。",
          "translations": []
        },
        {
          "id": "s0380",
          "zh": "五十九年七月十六日，榮成、萊陽有赤氣自東而起，倏如匹練，互向西北去，有聲如雷。",
          "translations": []
        },
        {
          "id": "s0381",
          "zh": "雍正七年十二月二十八日夜分，福山見紅光滿野。",
          "translations": []
        }
      ],
      "translations": []
    },
    {
      "type": "paragraph",
      "sentences": [
        {
          "id": "s0382",
          "zh": "乾隆三十五年七月二十八日，肥城有赤光自北方起，夜半漸退；",
          "translations": []
        },
        {
          "id": "s0383",
          "zh": "長山西北見赤氣彌天，中有白氣如縷間之，四更後始散。",
          "translations": []
        },
        {
          "id": "s0384",
          "zh": "二十九日夜，榮成夜見紅光燭天；",
          "translations": []
        },
        {
          "id": "s0385",
          "zh": "東光有氣如火，橫蔽西北，互數十丈，中含紅光，森如劍戟上射。",
          "translations": []
        }
      ],
      "translations": []
    },
    {
      "type": "paragraph",
      "sentences": [
        {
          "id": "s0386",
          "zh": "嘉慶九年正月，曆城天雨血。",
          "translations": []
        }
      ],
      "translations": []
    },
    {
      "type": "paragraph",
      "sentences": [
        {
          "id": "s0387",
          "zh": "道光十一年冬，太平雨血，著人衣皆赤。",
          "translations": []
        },
        {
          "id": "s0388",
          "zh": "十七年六月二十八日，嵊縣有赤光如球，高數丈，三日乃滅。",
          "translations": []
        },
        {
          "id": "s0389",
          "zh": "二十八年正月，鬆滋天雨血，以碗盛之，作桃花色。",
          "translations": []
        }
      ],
      "translations": []
    },
    {
      "type": "paragraph",
      "sentences": [
        {
          "id": "s0390",
          "zh": "咸豐三年正月十四日，西鄉雨血如注。",
          "translations": []
        },
        {
          "id": "s0391",
          "zh": "五年八月，曹縣東方有赤氣如旗杆形。",
          "translations": []
        },
        {
          "id": "s0392",
          "zh": "六年七月，武進地出血。",
          "translations": []
        },
        {
          "id": "s0393",
          "zh": "同治五年秋，崇陽雨血。",
          "translations": []
        },
        {
          "id": "s0394",
          "zh": "七年正月二十日，光化雨血。",
          "translations": []
        }
      ],
      "translations": []
    },
    {
      "type": "paragraph",
      "sentences": [
        {
          "id": "s0395",
          "zh": "光緒二年二月初四日，曹縣見紅光自天降於八里灣水中。",
          "translations": []
        },
        {
          "id": "s0396",
          "zh": "七年四月，襄陽雨血。",
          "translations": []
        }
      ],
      "translations": []
    }
  ]
}