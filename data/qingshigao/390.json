  "content": [
    {
      "type": "paragraph",
      "sentences": [
        {
          "id": "s0001",
          "zh": "賈楨，字筠堂，山東黃縣人。",
          "translations": []
        },
        {
          "id": "s0002",
          "zh": "父允升，乾隆六十年進士，由檢討歷官兵部侍郎。",
          "translations": []
        }
      ],
      "translations": []
    },
    {
      "type": "paragraph",
      "sentences": [
        {
          "id": "s0003",
          "zh": "楨，一甲二名進士，授編修。",
          "translations": []
        },
        {
          "id": "s0004",
          "zh": "十三年，大考一等，擢侍講。",
          "translations": []
        },
        {
          "id": "s0005",
          "zh": "十六年，入直上書房，授皇六子讀。",
          "translations": []
        },
        {
          "id": "s0006",
          "zh": "累擢侍講學士。",
          "translations": []
        },
        {
          "id": "s0007",
          "zh": "十九年，大考翰詹，命免試。",
          "translations": []
        },
        {
          "id": "s0008",
          "zh": "歷少詹事、內閣學士。",
          "translations": []
        },
        {
          "id": "s0009",
          "zh": "二十一年，遷工部侍郎，調戶部。",
          "translations": []
        },
        {
          "id": "s0010",
          "zh": "二十七年，連擢左都御史、禮部尚書，調吏部。",
          "translations": []
        },
        {
          "id": "s0011",
          "zh": "咸豐二年，協辦大學士。",
          "translations": []
        },
        {
          "id": "s0012",
          "zh": "三年，疏請山東籌辦團練，從之。",
          "translations": []
        },
        {
          "id": "s0013",
          "zh": "題孝和睿皇后神主禮成，加太子太保。",
          "translations": []
        },
        {
          "id": "s0014",
          "zh": "充上書房總師傅，兼管順天府尹。",
          "translations": []
        },
        {
          "id": "s0015",
          "zh": "四年，兼翰林院掌院學士。",
          "translations": []
        },
        {
          "id": "s0016",
          "zh": "順天府書吏範鶴等與戶部井田科銀庫書吏交結營私，以鈔票抵庫銀。",
          "translations": []
        },
        {
          "id": "s0017",
          "zh": "楨察舉其弊，讞定，譴失察諸官有差。",
          "translations": []
        },
        {
          "id": "s0018",
          "zh": "楨以發覺察議，拜體仁閣大學士，管理戶部。",
          "translations": []
        },
        {
          "id": "s0019",
          "zh": "五年，兼管工部，晉武英殿大學士。",
          "translations": []
        }
      ],
      "translations": []
    },
    {
      "type": "paragraph",
      "sentences": [
        {
          "id": "s0020",
          "zh": "六年，丁母憂，命暫開缺，給假六月回籍治喪，假滿來京。",
          "translations": []
        },
        {
          "id": "s0021",
          "zh": "楨疏言：「臣兄弟五人，諸昆疊故，臣幸僅存。",
          "translations": []
        },
        {
          "id": "s0022",
          "zh": "今不能為母守制，是臣母有子而如無子，臣何以為子？",
          "translations": []
        },
        {
          "id": "s0023",
          "zh": "」力求終制。",
          "translations": []
        },
        {
          "id": "s0024",
          "zh": "時御史鄒焌傑亦疏請准其開缺守制，詔允之。",
          "translations": []
        },
        {
          "id": "s0025",
          "zh": "八年，服闋，以大學士銜補吏部尚書，仍充上書房總師傅。",
          "translations": []
        },
        {
          "id": "s0026",
          "zh": "尋复授體仁閣大學士，管理兵部，兼翰林院掌院學士。",
          "translations": []
        },
        {
          "id": "s0027",
          "zh": "十年，充京城團防大臣。",
          "translations": []
        },
        {
          "id": "s0028",
          "zh": "是年秋，英法聯軍犯京師，車駕幸熱河，命楨留守，日危坐天安門，阻外軍不令入。",
          "translations": []
        },
        {
          "id": "s0029",
          "zh": "及與會議，慷慨不屈。",
          "translations": []
        },
        {
          "id": "s0030",
          "zh": "十一年，复晉武英殿大學士，以病請開缺，不許。",
          "translations": []
        }
      ],
      "translations": []
    },
    {
      "type": "paragraph",
      "sentences": [
        {
          "id": "s0031",
          "zh": "穆宗回鑾，偕大學士周祖培，尚書沈兆霖、趙光上疏曰：「我朝從無皇太后垂簾聽政之典。",
          "translations": []
        },
        {
          "id": "s0032",
          "zh": "前因御史董元醇條奏，特降諭旨甚明，臣等復有何異詞。",
          "translations": []
        },
        {
          "id": "s0033",
          "zh": "惟是權不可下移，移則日替；",
          "translations": []
        },
        {
          "id": "s0034",
          "zh": "禮不可稍渝，渝則弊生。",
          "translations": []
        },
        {
          "id": "s0035",
          "zh": "皇上沖齡踐阼，欽奉先帝遺命，派怡親王載垣等八人讚襄政務。",
          "translations": []
        },
        {
          "id": "s0036",
          "zh": "兩月以來，用人行政，皆經該王大臣擬定諭旨，每日明發，均用禦賞同道堂圖章，共見共聞，內外咸相欽奉。",
          "translations": []
        },
        {
          "id": "s0037",
          "zh": "惟臣等詳慎思之，似非久遠萬全之策，不能謂日後之決無流弊。",
          "translations": []
        },
        {
          "id": "s0038",
          "zh": "尋繹贊襄之義，乃佐助而非主持。",
          "translations": []
        },
        {
          "id": "s0039",
          "zh": "若事無鉅細，皆由該王大臣先行定議，是名為佐助而實則主持。",
          "translations": []
        },
        {
          "id": "s0040",
          "zh": "日久相沿，中外能無疑慮？",
          "translations": []
        },
        {
          "id": "s0041",
          "zh": "為今日計，正宜皇太后親操出治威權，庶臣工有所禀承，命令有所諮決，不居垂簾之虛名，而收聽政之實效。",
          "translations": []
        },
        {
          "id": "s0042",
          "zh": "準法前朝，憲章近代，不難折衷至當。",
          "translations": []
        },
        {
          "id": "s0043",
          "zh": "伏查漢和熹鄧皇后、順烈梁皇后，晉康獻褚皇后，遼睿智蕭皇后皆以太后臨朝，史冊稱美。",
          "translations": []
        },
        {
          "id": "s0044",
          "zh": "至如宋之章獻劉皇后，有今世任姒之稱，宣仁高太后有女中堯舜之譽。",
          "translations": []
        },
        {
          "id": "s0045",
          "zh": "明穆宗皇后，神宗嫡母，上尊號曰仁聖皇太后；",
          "translations": []
        },
        {
          "id": "s0046",
          "zh": "穆宗貴妃，神宗生母，上尊號曰慈聖皇太后，惟時神宗十歲，政事皆由兩宮抉擇，命大臣施行，亦未嘗居垂簾之名也。",
          "translations": []
        },
        {
          "id": "s0047",
          "zh": "我皇上天亶聰明，不數年即可親政，而此數年間，外而寇難未平，內而洋人偪處，何以拯時艱？",
          "translations": []
        },
        {
          "id": "s0048",
          "zh": "何以飭法紀？",
          "translations": []
        },
        {
          "id": "s0049",
          "zh": "端以固結人心最為緊要。",
          "translations": []
        },
        {
          "id": "s0050",
          "zh": "倘大權無所專屬，以致人心惶惑，是則大可憂者。",
          "translations": []
        },
        {
          "id": "s0051",
          "zh": "請敕下廷臣會議皇太后召見臣工禮節，及一切辦事章程，或仍循向來軍機大臣承旨舊制；",
          "translations": []
        },
        {
          "id": "s0052",
          "zh": "量為變通，條列請旨酌定，以示遵守。",
          "translations": []
        },
        {
          "id": "s0053",
          "zh": "」疏入，命廷臣集議允行。",
          "translations": []
        }
      ],
      "translations": []
    },
    {
      "type": "paragraph",
      "sentences": [
        {
          "id": "s0054",
          "zh": "周祖培，字芝台，河南商城人。",
          "translations": []
        },
        {
          "id": "s0055",
          "zh": "父鉞，嘉慶六年進士，歷官鴻臚寺少卿。",
          "translations": []
        }
      ],
      "translations": []
    },
    {
      "type": "paragraph",
      "sentences": [
        {
          "id": "s0056",
          "zh": "祖培，進士，選庶吉士，授編修。",
          "translations": []
        },
        {
          "id": "s0057",
          "zh": "五遷至侍講學士。",
          "translations": []
        },
        {
          "id": "s0058",
          "zh": "，督陝甘學政。",
          "translations": []
        },
        {
          "id": "s0059",
          "zh": "歷侍讀學士、詹事、內閣學士。",
          "translations": []
        },
        {
          "id": "s0060",
          "zh": "二十三年，擢禮部侍郎，調工部，又調刑部。",
          "translations": []
        },
        {
          "id": "s0061",
          "zh": "二十六年，偕尚書賽尚阿查勘江南江防善後事宜，校閱江蘇、安徽、江西營伍。",
          "translations": []
        },
        {
          "id": "s0062",
          "zh": "三十年，文宗即位，疏言：「我朝立政之要，用人之法，備載列聖實錄，請隨時披閱。",
          "translations": []
        },
        {
          "id": "s0063",
          "zh": "利害所關，今昔同轍，容有昔之所利不盡利於今者，未有昔之所害不為害於今者；",
          "translations": []
        },
        {
          "id": "s0064",
          "zh": "容有昔所欲除之害至今猶未盡除者，未有昔所應防之害至今轉可不防者。",
          "translations": []
        },
        {
          "id": "s0065",
          "zh": "惟皇上成法在胸，以應幾務，庶利害瞭如指掌，而興廢可決於一心。",
          "translations": []
        },
        {
          "id": "s0066",
          "zh": "並請責成大吏，力戒欺飾，考察屬吏；",
          "translations": []
        },
        {
          "id": "s0067",
          "zh": "其徇隱庇護者，經言官彈劾，即嚴懲督撫，整頓營伍，責令捕盜，勿任推諉。",
          "translations": []
        },
        {
          "id": "s0068",
          "zh": "」疏入，被嘉納，特詔飭行。",
          "translations": []
        },
        {
          "id": "s0069",
          "zh": "咸豐元年，擢刑部尚書。",
          "translations": []
        },
        {
          "id": "s0070",
          "zh": "二年，疏言：「戶部籌餉二十馀條，所議之款，緩不濟急。",
          "translations": []
        },
        {
          "id": "s0071",
          "zh": "請照道光二十一年河南河工、城工捐輸章程，變通辦理。",
          "translations": []
        },
        {
          "id": "s0072",
          "zh": "」又謂：「按戶派捐，先斂怨於民。",
          "translations": []
        },
        {
          "id": "s0073",
          "zh": "請飭各督撫確查巨富之家，勸諭激發忠愛，力圖報效。",
          "translations": []
        },
        {
          "id": "s0074",
          "zh": "」從之。",
          "translations": []
        }
      ],
      "translations": []
    },
    {
      "type": "paragraph",
      "sentences": [
        {
          "id": "s0075",
          "zh": "三年，要犯劉秋貴死於獄，承審官未得實情，祖培坐降三級調用，授左副都御史。",
          "translations": []
        },
        {
          "id": "s0076",
          "zh": "疏言：「賊匪滋事以來，屢諭各省辦團練，築寨浚壕，仿嘉慶年間堅壁清野之法，行無實效，賊竄突靡定，各州縣毫無豫備，賊至即潰。",
          "translations": []
        },
        {
          "id": "s0077",
          "zh": "請嚴飭督撫，責成賢能有司，會紳速辦；",
          "translations": []
        },
        {
          "id": "s0078",
          "zh": "有怠玩從事，反滋擾累者，予參處。",
          "translations": []
        },
        {
          "id": "s0079",
          "zh": "」從之。",
          "translations": []
        },
        {
          "id": "s0080",
          "zh": "歷工部、吏部侍郎。",
          "translations": []
        },
        {
          "id": "s0081",
          "zh": "四年，連擢左都御史、兵部尚書，兼管順天府尹。",
          "translations": []
        },
        {
          "id": "s0082",
          "zh": "六年，宣宗實錄、聖訓成，加太子太保，調吏部。",
          "translations": []
        }
      ],
      "translations": []
    },
    {
      "type": "paragraph",
      "sentences": [
        {
          "id": "s0083",
          "zh": "八年，會辦五城團防，以吏部尚書協辦大學士，兼署戶部。",
          "translations": []
        },
        {
          "id": "s0084",
          "zh": "九年，調戶部，兼署吏部。",
          "translations": []
        },
        {
          "id": "s0085",
          "zh": "京師戒嚴，疏陳團防章程六條：曰查戶口以別良莠，勸保衛以聯眾志，任官紳以專責成，協營汛以聯臂指，設水會以備不虞，增幫辦以資助理。",
          "translations": []
        },
        {
          "id": "s0086",
          "zh": "車駕幸熱河，命留京辦事，拜體仁閣大學士，管理戶部。",
          "translations": []
        },
        {
          "id": "s0087",
          "zh": "十一年，文宗崩，命總理喪儀，兼辦定陵平安峪工程。",
          "translations": []
        },
        {
          "id": "s0088",
          "zh": "及穆宗奉兩宮回鑾，祖培疏言怡親王載垣等擬定「祺祥」年號，意義重複，請更正，詔嘉其關心典禮。",
          "translations": []
        },
        {
          "id": "s0089",
          "zh": "又言近畿各處抗糧拒捕成風，由於州縣不得其人，諭各督撫秉公遴選，毋稍徇隱。",
          "translations": []
        },
        {
          "id": "s0090",
          "zh": "同治元年，調管刑部。",
          "translations": []
        },
        {
          "id": "s0091",
          "zh": "四年，山陵告成，賜花翎。",
          "translations": []
        },
        {
          "id": "s0092",
          "zh": "五年，文宗實錄、聖訓成，賜其子文龠員外郎，文令舉人。",
          "translations": []
        },
        {
          "id": "s0093",
          "zh": "六年，卒，年七十五，優恤，諡文勤。",
          "translations": []
        }
      ],
      "translations": []
    },
    {
      "type": "paragraph",
      "sentences": [
        {
          "id": "s0094",
          "zh": "朱鳳標，字桐軒，浙江蕭山人。",
          "translations": []
        },
        {
          "id": "s0095",
          "zh": "一甲二名進士，授編修。",
          "translations": []
        },
        {
          "id": "s0096",
          "zh": "十九年，大考二等，賜文綺，直上書房。",
          "translations": []
        },
        {
          "id": "s0097",
          "zh": "尋督湖北學政。",
          "translations": []
        },
        {
          "id": "s0098",
          "zh": "歷司業、侍講、​​庶子、侍講學士、侍讀學士。",
          "translations": []
        },
        {
          "id": "s0099",
          "zh": "二十五年，授皇七子讀。",
          "translations": []
        },
        {
          "id": "s0100",
          "zh": "連擢內閣學士、兵部侍郎，調戶部。",
          "translations": []
        },
        {
          "id": "s0101",
          "zh": "二十八年，命赴天津驗收漕糧。",
          "translations": []
        },
        {
          "id": "s0102",
          "zh": "尋偕大學士耆英查辦山東鹽務，疏劾歷任巡撫、運司收受程儀節壽，論譴有差。",
          "translations": []
        },
        {
          "id": "s0103",
          "zh": "又言：「山東鹽政疲敝甚於他省，若求裕課暢銷，惟除弊、緝私最為先務。",
          "translations": []
        },
        {
          "id": "s0104",
          "zh": "會議變通成法，請先課后鹽以重帑項。",
          "translations": []
        },
        {
          "id": "s0105",
          "zh": "」下部議行。",
          "translations": []
        },
        {
          "id": "s0106",
          "zh": "又查運庫出借銀七萬馀兩，責賠繳；",
          "translations": []
        },
        {
          "id": "s0107",
          "zh": "籓庫積存減平及扣還軍需行裝等款三十萬兩，撥解部庫；",
          "translations": []
        },
        {
          "id": "s0108",
          "zh": "通省倉庫正雜未完銀四十一萬兩，缺穀三十七萬石，命限八個月彌補。",
          "translations": []
        },
        {
          "id": "s0109",
          "zh": "，擢左都御史，歷署工部、刑部、戶部尚書。",
          "translations": []
        }
      ],
      "translations": []
    },
    {
      "type": "paragraph",
      "sentences": [
        {
          "id": "s0110",
          "zh": "三年，粵匪陷江寧，复陷揚州，漕督楊殿邦​​退保淮安，廷議調山西、陝西兵七千赴援。",
          "translations": []
        },
        {
          "id": "s0111",
          "zh": "鳳標與尚書文慶，侍郎全慶、王慶雲合疏，言：「淮安賊所必爭，萬一賊眾渡河，則河南、山東民情震動，撲滅愈難。",
          "translations": []
        },
        {
          "id": "s0112",
          "zh": "請命山東巡撫李僡親往淮安扼賊北竄，並請敕直隸總督迅派布政使張集馨率兵扼要駐守，以為京師屏蔽。",
          "translations": []
        },
        {
          "id": "s0113",
          "zh": "」疏入，如所請行。",
          "translations": []
        },
        {
          "id": "s0114",
          "zh": "五月，賊陷河南歸德，鳳標與大學士賈楨、尚書翁心存等條擬防剿六事，多被採擇。",
          "translations": []
        },
        {
          "id": "s0115",
          "zh": "未幾，悍賊林鳳祥等竄畿輔，复偕楨、心存等奏陳預籌守城事宜。",
          "translations": []
        },
        {
          "id": "s0116",
          "zh": "疏入，報聞。",
          "translations": []
        },
        {
          "id": "s0117",
          "zh": "四年，授刑部尚書。",
          "translations": []
        },
        {
          "id": "s0118",
          "zh": "六年，宣宗實錄、聖訓告成，加太子少保。",
          "translations": []
        },
        {
          "id": "s0119",
          "zh": "尋調兵部，復調戶部。",
          "translations": []
        }
      ],
      "translations": []
    },
    {
      "type": "paragraph",
      "sentences": [
        {
          "id": "s0120",
          "zh": "八年，典順天鄉試，因中式舉人平齡朱墨不符，為言官論劾，興大獄，大學士柏葰論大辟，鳳標亦解任聽勘。",
          "translations": []
        },
        {
          "id": "s0121",
          "zh": "文宗原其無私，從寬坐失察革職。",
          "translations": []
        },
        {
          "id": "s0122",
          "zh": "逾數月，命以翰林院侍講學士銜，仍直上書房，授醇郡王讀如故。",
          "translations": []
        },
        {
          "id": "s0123",
          "zh": "歷大理寺少卿、通政使、左副都御史，署刑部侍郎。",
          "translations": []
        },
        {
          "id": "s0124",
          "zh": "隨扈熱河，复擢兵部尚書。",
          "translations": []
        },
        {
          "id": "s0125",
          "zh": "十一年，護送文宗梓宮回京，追錄扈從勞，加二級。",
          "translations": []
        },
        {
          "id": "s0126",
          "zh": "調吏部，充上書房總師傅。",
          "translations": []
        },
        {
          "id": "s0127",
          "zh": "，以吏部尚書協辦大學士，兼翰林院掌院學士。",
          "translations": []
        },
        {
          "id": "s0128",
          "zh": "未幾，拜體仁閣大學士，管理吏部。",
          "translations": []
        },
        {
          "id": "s0129",
          "zh": "十一年，以病乞休，命以大學士致仕，食全俸。",
          "translations": []
        },
        {
          "id": "s0130",
          "zh": "十二年，卒於家，贈太子太保，諡文端。",
          "translations": []
        },
        {
          "id": "s0131",
          "zh": "子其煊，工部郎中，官至山東布政使。",
          "translations": []
        }
      ],
      "translations": []
    },
    {
      "type": "paragraph",
      "sentences": [
        {
          "id": "s0132",
          "zh": "單懋謙，字地山，湖北襄陽人。",
          "translations": []
        },
        {
          "id": "s0133",
          "zh": "進士，選庶吉士，授編修。",
          "translations": []
        },
        {
          "id": "s0134",
          "zh": "十七年，入直南書房。",
          "translations": []
        },
        {
          "id": "s0135",
          "zh": "十九年，大考二等，以贊善升用。",
          "translations": []
        },
        {
          "id": "s0136",
          "zh": "尋授司業，遷洗馬。",
          "translations": []
        },
        {
          "id": "s0137",
          "zh": "二十年，督廣東學政，歷侍讀、庶子。",
          "translations": []
        },
        {
          "id": "s0138",
          "zh": "以病歸，父喪服闋，請終母養。",
          "translations": []
        },
        {
          "id": "s0139",
          "zh": "咸豐三年，粵匪擾湖北，懋謙方居母憂，命在籍治團練。",
          "translations": []
        },
        {
          "id": "s0140",
          "zh": "六年，回京，仍直南書房，補原官。",
          "translations": []
        },
        {
          "id": "s0141",
          "zh": "七年，督江西學政，歷侍讀學士、少詹事、內閣學士、工部侍郎，均留學政任。",
          "translations": []
        },
        {
          "id": "s0142",
          "zh": "十一年，巡撫毓科、布政使慶廉為言官論劾，命懋謙按之，疏言：「毓科非應變之才，適當賊擾，省防尤重。",
          "translations": []
        },
        {
          "id": "s0143",
          "zh": "本境兵勇不敷調遣，辦理未能悉合機宜。",
          "translations": []
        },
        {
          "id": "s0144",
          "zh": "現雖全境肅清，善後急宜妥辦，籌備浙防，接濟皖餉，大局攸關，恐未能措理裕如。",
          "translations": []
        },
        {
          "id": "s0145",
          "zh": "慶廉現未到任，無事蹟可考，未敢妄陳。",
          "translations": []
        },
        {
          "id": "s0146",
          "zh": "」疏入，報聞。",
          "translations": []
        },
        {
          "id": "s0147",
          "zh": "任滿，回京，充實錄館副總裁。",
          "translations": []
        },
        {
          "id": "s0148",
          "zh": "同治二年，調吏部，擢左都御史。",
          "translations": []
        },
        {
          "id": "s0149",
          "zh": "三年，偕大學士瑞常等進講治平寶鑑，授工部尚書。",
          "translations": []
        }
      ],
      "translations": []
    },
    {
      "type": "paragraph",
      "sentences": [
        {
          "id": "s0150",
          "zh": "四年，命赴盛京偕侍郎志和等承修太廟、昭陵工程。",
          "translations": []
        },
        {
          "id": "s0151",
          "zh": "時奉天馬賊猖獗，命懋謙就近查察，劾將軍玉明、府尹德椿，下部議處。",
          "translations": []
        },
        {
          "id": "s0152",
          "zh": "回京，疏陳馬賊難防，請籌兵餉出邊會剿，以弭盜源。",
          "translations": []
        },
        {
          "id": "s0153",
          "zh": "又請飭奉天所屬各州縣查勘市鎮鄉村應修堡寨之處，勸民作速興築，擇錄嘉慶年間龔景瀚所著堅壁清野議刊發各州縣，令遵照團練守御之法，量為辦理。",
          "translations": []
        },
        {
          "id": "s0154",
          "zh": "疏入，均得旨議行。",
          "translations": []
        },
        {
          "id": "s0155",
          "zh": "六年，管戶部三庫事務。",
          "translations": []
        },
        {
          "id": "s0156",
          "zh": "七年，調吏部。",
          "translations": []
        },
        {
          "id": "s0157",
          "zh": "十年，管國子監事務。",
          "translations": []
        },
        {
          "id": "s0158",
          "zh": "十一年，以吏部尚書協辦大學士，尋拜文淵閣大學士，兼管兵部。",
          "translations": []
        },
        {
          "id": "s0159",
          "zh": "十三年，因久病請解職回籍，允之。",
          "translations": []
        },
        {
          "id": "s0160",
          "zh": "，卒於家，詔依例賜卹，有「學問優長，持躬端謹」之褒。",
          "translations": []
        },
        {
          "id": "s0161",
          "zh": "贈太子太保，諡文恪。",
          "translations": []
        }
      ],
      "translations": []
    },
    {
      "type": "paragraph",
      "sentences": [
        {
          "id": "s0162",
          "zh": "論曰：自咸豐初軍事起，四郊多壘，廟堂旰食。",
          "translations": []
        },
        {
          "id": "s0163",
          "zh": "京師舉辦團防，閣部重臣領之，賈楨、周祖培、朱鳳標皆預其事。",
          "translations": []
        },
        {
          "id": "s0164",
          "zh": "其時用人猶循舊格，揆席多由資進。",
          "translations": []
        },
        {
          "id": "s0165",
          "zh": "至穆宗踐阼，底定東南，漢閣臣多取勳望，六官中大拜者鮮，惟單懋謙獨由正卿入閣，時以為榮遇焉。",
          "translations": []
        }
      ],
      "translations": []
    }
  ]
}