  "content": [
    {
      "type": "paragraph",
      "sentences": [
        {
          "id": "s0001",
          "zh": "列傳二百十七",
          "translations": []
        }
      ],
      "translations": []
    },
    {
      "type": "paragraph",
      "sentences": [
        {
          "id": "s0002",
          "zh": "雷正綰陶茂林曹克忠胡中和何勝必蕭慶高楊復東",
          "translations": []
        }
      ],
      "translations": []
    },
    {
      "type": "paragraph",
      "sentences": [
        {
          "id": "s0003",
          "zh": "周達武李輝武唐友耕",
          "translations": []
        }
      ],
      "translations": []
    },
    {
      "type": "paragraph",
      "sentences": [
        {
          "id": "s0004",
          "zh": "雷正綰，字偉堂，四川中江人。",
          "translations": []
        },
        {
          "id": "s0005",
          "zh": "由把總從軍湖北，積功至游擊，賜號直勇巴圖魯。",
          "translations": []
        },
        {
          "id": "s0006",
          "zh": "咸豐八年，從多隆阿援安徽石牌、潛山、太湖、桐城，諸戰皆功最，累擢副將，以總兵記名。",
          "translations": []
        },
        {
          "id": "s0007",
          "zh": "十一年，敗黃文金於蔣家山、項家河、江家河、麻子嶺，一月五捷，授陝安鎮總兵。",
          "translations": []
        },
        {
          "id": "s0008",
          "zh": "同治元年，克廬州，以提督記名。",
          "translations": []
        }
      ],
      "translations": []
    },
    {
      "type": "paragraph",
      "sentences": [
        {
          "id": "s0009",
          "zh": "從多隆阿援陝西，詔正綰先赴本任，未至，擢陝西提督，幫辦軍務，駐西安。",
          "translations": []
        },
        {
          "id": "s0010",
          "zh": "二年，多隆阿既克東路，令正綰規三原，屢破賊。",
          "translations": []
        },
        {
          "id": "s0011",
          "zh": "會解鳳翔圍，進援甘肅，連戰靈臺、鎮原，皆捷。",
          "translations": []
        },
        {
          "id": "s0012",
          "zh": "三年，破賊崇仁、新城，進逼平原。",
          "translations": []
        },
        {
          "id": "s0013",
          "zh": "會多隆阿卒於軍，都興阿繼督師甘肅，正綰仍奉命為副。",
          "translations": []
        },
        {
          "id": "s0014",
          "zh": "克平涼，斬賊首鐵酉、羽輕林，賜黃馬褂。",
          "translations": []
        },
        {
          "id": "s0015",
          "zh": "於是固原踞賊悉竄龍山鎮，追擊敗之。",
          "translations": []
        },
        {
          "id": "s0016",
          "zh": "賊回竄，又陷固原。",
          "translations": []
        },
        {
          "id": "s0017",
          "zh": "正綰疾趨蓮花城，欲襲其巢穴，遇伏，受矛傷，部下亡千餘人，裹創攻蓮花城，克之，詔嘉其勇。",
          "translations": []
        },
        {
          "id": "s0018",
          "zh": "四年春，克固原，進攻黑城子，斬賊首黑虎。",
          "translations": []
        },
        {
          "id": "s0019",
          "zh": "克官橋、李旺二堡，擒賊首木棍等。",
          "translations": []
        },
        {
          "id": "s0020",
          "zh": "乘勝薄預望城，破下馬關、半​​角城賊壘，進規靈州，分兵解安定圍。",
          "translations": []
        }
      ],
      "translations": []
    },
    {
      "type": "paragraph",
      "sentences": [
        {
          "id": "s0021",
          "zh": "七月，偕曹克忠攻金積堡，軍餉不繼，為賊所圍，飢潰。",
          "translations": []
        },
        {
          "id": "s0022",
          "zh": "正綰自劾，褫勇號、黃馬褂，黜幫辦，歸總督楊岳斌節制。",
          "translations": []
        },
        {
          "id": "s0023",
          "zh": "正綰弟總兵雷恆及副將李高啟等以主將失職，煽亂，犯涇州，正綰不能制止，憤欲自裁。",
          "translations": []
        },
        {
          "id": "s0024",
          "zh": "詔念前功，不加罪，責令整軍勦賊圖自贖。",
          "translations": []
        },
        {
          "id": "s0025",
          "zh": "命巡撫趙長齡會楊岳斌按訊，正綰縛送雷恆等置之法。",
          "translations": []
        },
        {
          "id": "s0026",
          "zh": "當事變初起，謠諑紛淆，詔斥劉蓉張皇妄奏，許正綰專摺奏事以慰之。",
          "translations": []
        },
        {
          "id": "s0027",
          "zh": "所部招集增募僅三千人。",
          "translations": []
        }
      ],
      "translations": []
    },
    {
      "type": "paragraph",
      "sentences": [
        {
          "id": "s0028",
          "zh": "五年，蘭州兵變，回匪窺伺，正綰支拄於平涼、固原之間，破賊於橫河川，克平涼，复黃馬褂、勇號。",
          "translations": []
        },
        {
          "id": "s0029",
          "zh": "六年，左宗​​棠入陝督師，正綰率軍助剿，援慶陽。",
          "translations": []
        },
        {
          "id": "s0030",
          "zh": "七年，兩破賊於長武，克黃家堡。",
          "translations": []
        },
        {
          "id": "s0031",
          "zh": "八年，會攻董志原，克之，晉號達春巴圖魯。",
          "translations": []
        },
        {
          "id": "s0032",
          "zh": "又破白彥虎於李旺堡。",
          "translations": []
        },
        {
          "id": "s0033",
          "zh": "會攻金積堡，當西路，屢克要隘，合圍。",
          "translations": []
        },
        {
          "id": "s0034",
          "zh": "及馬化隆伏誅，被優敘。",
          "translations": []
        }
      ],
      "translations": []
    },
    {
      "type": "paragraph",
      "sentences": [
        {
          "id": "s0035",
          "zh": "光緒十年，法越兵事起，命率甘軍駐鳳凰城，固邊防，事定回任。",
          "translations": []
        },
        {
          "id": "s0036",
          "zh": "兩遇萬壽慶典，加太子少保、尚書銜。",
          "translations": []
        },
        {
          "id": "s0037",
          "zh": "二十一年，循化撒回倡亂，督剿無功，革職留任。",
          "translations": []
        },
        {
          "id": "s0038",
          "zh": "二十三年，罷，卒於家，仍以前勞賜卹。",
          "translations": []
        }
      ],
      "translations": []
    },
    {
      "type": "paragraph",
      "sentences": [
        {
          "id": "s0039",
          "zh": "陶茂林，湖南長沙人。",
          "translations": []
        },
        {
          "id": "s0040",
          "zh": "以武童入湘軍，轉戰湖北、江西，積功至游擊。",
          "translations": []
        },
        {
          "id": "s0041",
          "zh": "咸豐八年，胡林翼調為楚軍營官，扼黃州，破賊霍山、舒城，克建德，擢參將。",
          "translations": []
        },
        {
          "id": "s0042",
          "zh": "十年，從多隆阿破賊於桐城掛車河，擢副將。",
          "translations": []
        },
        {
          "id": "s0043",
          "zh": "十一年，破賊施家山，擒其渠，及克安慶，賜號鍾勇巴圖魯。",
          "translations": []
        },
        {
          "id": "s0044",
          "zh": "同治元年，克廬州，先登，以總兵記名。",
          "translations": []
        }
      ],
      "translations": []
    },
    {
      "type": "paragraph",
      "sentences": [
        {
          "id": "s0045",
          "zh": "遂從多隆阿西征，破賊於武關。",
          "translations": []
        },
        {
          "id": "s0046",
          "zh": "從剿回匪，解同州圍。",
          "translations": []
        },
        {
          "id": "s0047",
          "zh": "克羌白鎮、王閣村賊巢，功皆最，授漢中鎮總兵。",
          "translations": []
        },
        {
          "id": "s0048",
          "zh": "鳳翔被圍久，茂林率三千人往援，連戰解圍，擢甘肅提督。",
          "translations": []
        },
        {
          "id": "s0049",
          "zh": "粵匪出寶雞山口，擾郿縣、盩厔，茂林要擊雨門鎮、二嶺關，迭敗之。",
          "translations": []
        },
        {
          "id": "s0050",
          "zh": "進克汧陽、隴州。",
          "translations": []
        },
        {
          "id": "s0051",
          "zh": "遂會雷正綰分道規平涼，陣斬賊首木仲沅訥三等，克之，賜黃馬褂。",
          "translations": []
        },
        {
          "id": "s0052",
          "zh": "進拔張家川賊巢，破龍山鎮、蓮花城援賊，解安定圍。",
          "translations": []
        },
        {
          "id": "s0053",
          "zh": "克金縣，破賊惠城，擒其渠黑牙古。",
          "translations": []
        },
        {
          "id": "s0054",
          "zh": "四年，克黑城賊巢，解靖遠圍。",
          "translations": []
        },
        {
          "id": "s0055",
          "zh": "進攻會寧，所部索餉譁潰五營，賊乘之，六營皆陷。",
          "translations": []
        },
        {
          "id": "s0056",
          "zh": "茂林調後路四營來援，突圍出，退駐安定。",
          "translations": []
        },
        {
          "id": "s0057",
          "zh": "巡撫劉蓉疏陳甘軍積弊，論茂林不職，茂林亦以兵潰自劾。",
          "translations": []
        },
        {
          "id": "s0058",
          "zh": "詔斥廢法營私，以致兵潰而叛，遂罷職，歸。",
          "translations": []
        }
      ],
      "translations": []
    },
    {
      "type": "paragraph",
      "sentences": [
        {
          "id": "s0059",
          "zh": "十年，貴州巡撫曾璧光調茂林赴黔協剿。",
          "translations": []
        },
        {
          "id": "s0060",
          "zh": "復新城，克安順賊巢，平古州、丹江苗，復原官。",
          "translations": []
        },
        {
          "id": "s0061",
          "zh": "光緒二年，收復下江、永從各城，破六峒賊巢，加頭品頂戴，晉號愛星阿巴圖魯。",
          "translations": []
        },
        {
          "id": "s0062",
          "zh": "十六年，署古州鎮總兵，卒於官。",
          "translations": []
        }
      ],
      "translations": []
    },
    {
      "type": "paragraph",
      "sentences": [
        {
          "id": "s0063",
          "zh": "曹克忠，直隸天津人。",
          "translations": []
        },
        {
          "id": "s0064",
          "zh": "初投效湘軍，嗣從多隆阿，積功至都司。",
          "translations": []
        },
        {
          "id": "s0065",
          "zh": "咸豐十年，令募五百人為忠字營，大破援賊於潛山、太湖，洊擢參將，賜號悍勇巴圖魯。",
          "translations": []
        },
        {
          "id": "s0066",
          "zh": "掛車河之捷，擢副將。",
          "translations": []
        },
        {
          "id": "s0067",
          "zh": "克桐城、宿松諸城，以總兵記名。",
          "translations": []
        },
        {
          "id": "s0068",
          "zh": "同治元年，克廬州。",
          "translations": []
        }
      ],
      "translations": []
    },
    {
      "type": "paragraph",
      "sentences": [
        {
          "id": "s0069",
          "zh": "後從多隆阿西征，武關、同州諸戰皆從。",
          "translations": []
        },
        {
          "id": "s0070",
          "zh": "二年，攻羌白鎮，克忠單騎往諭賊，賊請降，察其詐，潛師會攻，下之，乘勝奪王閣村，予一品封典。",
          "translations": []
        },
        {
          "id": "s0071",
          "zh": "尋率烏拉馬隊及楚勇七營屯長安、鄠縣之間。",
          "translations": []
        },
        {
          "id": "s0072",
          "zh": "光泰廟為入省要衝，賊踞之以扼糧路，克忠擊走之。",
          "translations": []
        },
        {
          "id": "s0073",
          "zh": "分隊清西路餘匪，省城始安。",
          "translations": []
        },
        {
          "id": "s0074",
          "zh": "以提督記名，授河州鎮總兵。",
          "translations": []
        },
        {
          "id": "s0075",
          "zh": "渡渭連破賊於白起營、馬家埠、白吉原，邠州平，陝回西趨。",
          "translations": []
        },
        {
          "id": "s0076",
          "zh": "三年，平麟游諸匪。",
          "translations": []
        },
        {
          "id": "s0077",
          "zh": "會援甘肅，連破賊於西河口、黑水峪，赴河州本任。",
          "translations": []
        },
        {
          "id": "s0078",
          "zh": "克秦安，解秦州圍，賜黃馬褂。",
          "translations": []
        }
      ],
      "translations": []
    },
    {
      "type": "paragraph",
      "sentences": [
        {
          "id": "s0079",
          "zh": "四年，攻蕭何城及馬定嘴，將台、隆德諸堡，悉平。",
          "translations": []
        },
        {
          "id": "s0080",
          "zh": "克海城，回匪並竄李旺堡、同心城，攻下之。",
          "translations": []
        },
        {
          "id": "s0081",
          "zh": "偕雷正綰規取金積堡，屯強家沙窩，數有斬獲。",
          "translations": []
        },
        {
          "id": "s0082",
          "zh": "輕進，為賊所包鈔，正綰軍先潰，克忠亦退。",
          "translations": []
        },
        {
          "id": "s0083",
          "zh": "因前功免罪，授甘肅提督。",
          "translations": []
        },
        {
          "id": "s0084",
          "zh": "時陶茂林、雷正綰軍相繼譁變，回氛益熾，自楊岳斌楚軍外，僅克忠一軍與之相持。",
          "translations": []
        },
        {
          "id": "s0085",
          "zh": "克忠援鞏昌，賊敗走，又毀董家堡賊巢。",
          "translations": []
        },
        {
          "id": "s0086",
          "zh": "五年，援洮州，次李岐山，回目馬芳乞降，誅其酋丁重選等而還。",
          "translations": []
        }
      ],
      "translations": []
    },
    {
      "type": "paragraph",
      "sentences": [
        {
          "id": "s0087",
          "zh": "蘭州標兵變，楊岳斌令克忠移軍鎮懾。",
          "translations": []
        },
        {
          "id": "s0088",
          "zh": "克忠至，人心稍定，然糧餉俱竭，乞病回籍。",
          "translations": []
        },
        {
          "id": "s0089",
          "zh": "十年，詔起赴陝接統淮軍，專防肅州。",
          "translations": []
        },
        {
          "id": "s0090",
          "zh": "十一年，所部有結會匪者，甘軍馬世俊騎兵亦變，降捻多叛應，克忠遣兵平之。",
          "translations": []
        },
        {
          "id": "s0091",
          "zh": "复乞病解軍事。",
          "translations": []
        },
        {
          "id": "s0092",
          "zh": "十一年，署甘肅提督，尋解職歸。",
          "translations": []
        }
      ],
      "translations": []
    },
    {
      "type": "paragraph",
      "sentences": [
        {
          "id": "s0093",
          "zh": "光緒九年，命募六營防山海關。",
          "translations": []
        },
        {
          "id": "s0094",
          "zh": "十年，授廣東水師提督。",
          "translations": []
        },
        {
          "id": "s0095",
          "zh": "十一年，病罷，食全俸。",
          "translations": []
        },
        {
          "id": "s0096",
          "zh": "二十年，命治天津團練，統津勝軍。",
          "translations": []
        },
        {
          "id": "s0097",
          "zh": "二十二年，卒，賜卹。",
          "translations": []
        }
      ],
      "translations": []
    },
    {
      "type": "paragraph",
      "sentences": [
        {
          "id": "s0098",
          "zh": "胡中和，字元廷，湖南湘鄉人。",
          "translations": []
        },
        {
          "id": "s0099",
          "zh": "咸豐初，從湘軍剿粵匪，積功擢把總。",
          "translations": []
        },
        {
          "id": "s0100",
          "zh": "六年，從蕭啟江援江西，复袁州，超擢都司，賜花翎。",
          "translations": []
        },
        {
          "id": "s0101",
          "zh": "七年，從克臨安，中砲傷，以游擊留湖南補用。",
          "translations": []
        },
        {
          "id": "s0102",
          "zh": "八年，破賊上屯渡，乘勝复撫州，擢參將。",
          "translations": []
        },
        {
          "id": "s0103",
          "zh": "九年，复南安，擢副將。",
          "translations": []
        },
        {
          "id": "s0104",
          "zh": "石達開由寶慶竄廣西，陷興安，遣黨攻桂林，自率悍賊屯大溶江。",
          "translations": []
        },
        {
          "id": "s0105",
          "zh": "中和從蕭啟江往援，大破賊於大溶江，賊竄貴州境，加總兵銜，賜號伊德克勒巴圖魯。",
          "translations": []
        },
        {
          "id": "s0106",
          "zh": "十年，蕭啟江率軍援四川，中和從之。",
          "translations": []
        },
        {
          "id": "s0107",
          "zh": "啟江卒於軍，中和偕何勝必、蕭慶高等分領其眾。",
          "translations": []
        }
      ],
      "translations": []
    },
    {
      "type": "paragraph",
      "sentences": [
        {
          "id": "s0108",
          "zh": "剿滇匪李永和於井研，連戰皆捷，賊解圍遁，以總兵記名。",
          "translations": []
        },
        {
          "id": "s0109",
          "zh": "尋授四川建昌鎮總兵。",
          "translations": []
        },
        {
          "id": "s0110",
          "zh": "十一年，永和竄踞富順牛腹渡，兩岸築堅壘，背水而陣。",
          "translations": []
        },
        {
          "id": "s0111",
          "zh": "中和選銳卒沿河設伏，自率羸師誘之，賊大出，伏發，截其歸路，俘斬無算，賊壘盡夷，進解大邑之圍，予二品封典。",
          "translations": []
        }
      ],
      "translations": []
    },
    {
      "type": "paragraph",
      "sentences": [
        {
          "id": "s0112",
          "zh": "駱秉章督師蒞蜀，檄中和偕緒軍援綿州。",
          "translations": []
        },
        {
          "id": "s0113",
          "zh": "滇匪藍朝柱在諸賊中最狡悍，圍綿州日久。",
          "translations": []
        },
        {
          "id": "s0114",
          "zh": "軍至，連破之，圍始解，又敗之西山觀。",
          "translations": []
        },
        {
          "id": "s0115",
          "zh": "朝柱竄丹棱，與李永和合攻眉州。",
          "translations": []
        },
        {
          "id": "s0116",
          "zh": "中和馳援，賊分路來撲，中和突陣，矛傷顋，血殷衣，不顧，奮擊破之，解眉州圍。",
          "translations": []
        },
        {
          "id": "s0117",
          "zh": "進攻丹棱，朝柱遁走，復其城，以提督記名。",
          "translations": []
        },
        {
          "id": "s0118",
          "zh": "同治元年，擢雲南提督。",
          "translations": []
        },
        {
          "id": "s0119",
          "zh": "李永和自眉州敗後，竄踞青神，諸軍進剿，數敗之，永和遁犍為龍場，負嵎死抗。",
          "translations": []
        },
        {
          "id": "s0120",
          "zh": "中和圍之，壘石牆，編木柵，外浚深壕，密布梅花椿。",
          "translations": []
        },
        {
          "id": "s0121",
          "zh": "賊知必死，突攻蕭慶高營，中和截擊，敗退，連戰七日。",
          "translations": []
        },
        {
          "id": "s0122",
          "zh": "賊伏不出，乃使降賊譚仁曲持書約降，期會於豬市坡，預伏兵賊巢旁。",
          "translations": []
        },
        {
          "id": "s0123",
          "zh": "永和與其黨卯得興數十騎來會，伏起分攻，焚其巢。",
          "translations": []
        },
        {
          "id": "s0124",
          "zh": "永和、得興駭奔，追擒之，降其眾五千。",
          "translations": []
        },
        {
          "id": "s0125",
          "zh": "詔嘉中和運籌決勝，生擒渠魁，賜黃馬褂。",
          "translations": []
        }
      ],
      "translations": []
    },
    {
      "type": "paragraph",
      "sentences": [
        {
          "id": "s0126",
          "zh": "石達開擾蜀邊，中和偕蕭慶高、何勝必合擊於橫江，走之。",
          "translations": []
        },
        {
          "id": "s0127",
          "zh": "二年春，達開復分路犯蜀，自率大隊數万由米糧壩渡金沙江。",
          "translations": []
        },
        {
          "id": "s0128",
          "zh": "中和督軍扼化林坪、瀘定橋，擊破之，賊走工卩部土司山中，達開旋就擒。",
          "translations": []
        },
        {
          "id": "s0129",
          "zh": "調四川提督。",
          "translations": []
        },
        {
          "id": "s0130",
          "zh": "三年，破滇匪於敘永廳。",
          "translations": []
        },
        {
          "id": "s0131",
          "zh": "初，李永和既誅，餘黨竄陝西，至是入甘肅，陷階州。",
          "translations": []
        },
        {
          "id": "s0132",
          "zh": "四年，中和偕總兵周達武往剿，毀龍王廟、三官殿賊壘，逼階州城下，掘地道轟城，克之，斬賊酋蔡昌齡，盡殲其黨。",
          "translations": []
        },
        {
          "id": "s0133",
          "zh": "階州平，被珍賚。",
          "translations": []
        }
      ],
      "translations": []
    },
    {
      "type": "paragraph",
      "sentences": [
        {
          "id": "s0134",
          "zh": "冬，剿苗匪於建武，腰中彈傷，力戰敗之。",
          "translations": []
        },
        {
          "id": "s0135",
          "zh": "五年，剿屏山賊，解馬邊廳圍，誅賊酋宋任傑等，餘匪悉平。",
          "translations": []
        },
        {
          "id": "s0136",
          "zh": "十三年，調雲南提督。",
          "translations": []
        },
        {
          "id": "s0137",
          "zh": "光緒二年，抵任。",
          "translations": []
        },
        {
          "id": "s0138",
          "zh": "三年，平騰越夷匪。",
          "translations": []
        },
        {
          "id": "s0139",
          "zh": "七年，丁母憂歸里。",
          "translations": []
        },
        {
          "id": "s0140",
          "zh": "九年，卒，賜卹。",
          "translations": []
        }
      ],
      "translations": []
    },
    {
      "type": "paragraph",
      "sentences": [
        {
          "id": "s0141",
          "zh": "何勝必，湖南湘鄉人。",
          "translations": []
        },
        {
          "id": "s0142",
          "zh": "咸豐中，勝必應募入湘軍，從蕭啟江轉戰江西、廣西，積功至副將。",
          "translations": []
        },
        {
          "id": "s0143",
          "zh": "從入蜀，分統湘果右軍，破李永和於井研，又破之於資州，陣斬賊酋王二官，賜號禦勇巴圖魯。",
          "translations": []
        },
        {
          "id": "s0144",
          "zh": "十一年，會破滇匪藍朝柱於西山觀，又敗諸青衣壩，解眉州圍，追至青神，擒斬甚眾，授甘肅肅州鎮總兵。",
          "translations": []
        },
        {
          "id": "s0145",
          "zh": "同治元年，會諸軍克青神，追賊宜賓，擒賊目周廷光。",
          "translations": []
        },
        {
          "id": "s0146",
          "zh": "偕胡中和誘擒李永和於犍為龍場，二年，偕蕭慶高援漢中，戰油坊街，不利，漢中、城固相繼陷，革職留軍。",
          "translations": []
        },
        {
          "id": "s0147",
          "zh": "三年，會攻法慈院賊壘，再敗之牟家壩，乘勝薄漢中城下，捻渠陳得才遁走，克漢中，復原官。",
          "translations": []
        },
        {
          "id": "s0148",
          "zh": "又破陳得才於上元觀，克城固，進規階州。",
          "translations": []
        },
        {
          "id": "s0149",
          "zh": "四年，卒於軍，賜卹，諡威愨。",
          "translations": []
        }
      ],
      "translations": []
    },
    {
      "type": "paragraph",
      "sentences": [
        {
          "id": "s0150",
          "zh": "蕭慶高，湖南湘鄉人。",
          "translations": []
        },
        {
          "id": "s0151",
          "zh": "隸楚軍，積功至副將。",
          "translations": []
        },
        {
          "id": "s0152",
          "zh": "蕭啟江援蜀，調從軍，以井研之捷，賜號果勇巴圖魯。",
          "translations": []
        },
        {
          "id": "s0153",
          "zh": "破李永和於資州，以總兵記名。",
          "translations": []
        },
        {
          "id": "s0154",
          "zh": "會剿藍朝柱，解綿州圍。",
          "translations": []
        },
        {
          "id": "s0155",
          "zh": "同治二年，偕何勝必援漢中。",
          "translations": []
        },
        {
          "id": "s0156",
          "zh": "油坊街之戰，勝必先敗，慶高赴援不及，同革職留軍。",
          "translations": []
        },
        {
          "id": "s0157",
          "zh": "三年，克漢中，同复官。",
          "translations": []
        },
        {
          "id": "s0158",
          "zh": "追賊至城固，梯城而入，賊潰走。",
          "translations": []
        },
        {
          "id": "s0159",
          "zh": "四年，進攻洋縣，遣死士入城為內應，克之。",
          "translations": []
        },
        {
          "id": "s0160",
          "zh": "賊酋曹燦章走踞八里坪，夾攻破之，燦章就擒，授漢中鎮總兵。",
          "translations": []
        },
        {
          "id": "s0161",
          "zh": "五年，卒，諡武毅。",
          "translations": []
        }
      ],
      "translations": []
    },
    {
      "type": "paragraph",
      "sentences": [
        {
          "id": "s0162",
          "zh": "楊復東，湖南瀏陽人。",
          "translations": []
        },
        {
          "id": "s0163",
          "zh": "咸豐十年，從胡中和援蜀。",
          "translations": []
        },
        {
          "id": "s0164",
          "zh": "十一年，戰富順牛腹渡，解大邑圍，擢守備。",
          "translations": []
        },
        {
          "id": "s0165",
          "zh": "敗藍朝柱於綿州，擢都司。",
          "translations": []
        },
        {
          "id": "s0166",
          "zh": "又破朝柱於崇慶，毀石羊場，焚賊巢，擢游擊。",
          "translations": []
        },
        {
          "id": "s0167",
          "zh": "同治元年，复丹棱，擢參將。",
          "translations": []
        },
        {
          "id": "s0168",
          "zh": "克青神，平鐵山賊壘，擒李永和。",
          "translations": []
        },
        {
          "id": "s0169",
          "zh": "擢副將。",
          "translations": []
        },
        {
          "id": "s0170",
          "zh": "五年，總督駱秉章疏陳復東歷年防剿滇、黔諸賊功多，以總兵記名。",
          "translations": []
        },
        {
          "id": "s0171",
          "zh": "七年，授四川川北鎮總兵。",
          "translations": []
        },
        {
          "id": "s0172",
          "zh": "光緒二年，調雲南開化鎮。",
          "translations": []
        },
        {
          "id": "s0173",
          "zh": "六年，卒。",
          "translations": []
        }
      ],
      "translations": []
    },
    {
      "type": "paragraph",
      "sentences": [
        {
          "id": "s0174",
          "zh": "周達武，字夢熊，湖南寧鄉人。",
          "translations": []
        },
        {
          "id": "s0175",
          "zh": "咸豐四年，應募入李續賓營，從克岳州、武昌，累功擢守備。",
          "translations": []
        },
        {
          "id": "s0176",
          "zh": "戰湖口，晉都司。",
          "translations": []
        },
        {
          "id": "s0177",
          "zh": "達武每戰陷陣，手大旗盪決，續賓異之，使領百人曰信字營，常為軍鋒。",
          "translations": []
        },
        {
          "id": "s0178",
          "zh": "八年，克黃安，擢游擊，賜花翎。",
          "translations": []
        },
        {
          "id": "s0179",
          "zh": "從續賓攻舒城，達武率死士先登，左耳受槍傷，克城後，留守。",
          "translations": []
        },
        {
          "id": "s0180",
          "zh": "俄續賓覆軍三河，舒城守軍亦潰，達武以創重回湖南。",
          "translations": []
        },
        {
          "id": "s0181",
          "zh": "九年，石達開圍寶慶，巡撫駱秉章令達武募五百人號曰章武軍，從知府劉岳昭援寶慶，守東關，屢拒戰破賊。",
          "translations": []
        },
        {
          "id": "s0182",
          "zh": "圍解，擢參將。",
          "translations": []
        },
        {
          "id": "s0183",
          "zh": "十年，援廣西，克富川平古城、連塘賊壘，复賀縣，擢副將，加總兵銜。",
          "translations": []
        },
        {
          "id": "s0184",
          "zh": "石達開分黨犯永明、柘牌，連戰破之，擢總兵。",
          "translations": []
        },
        {
          "id": "s0185",
          "zh": "十一年，會諸軍克會同，賊走湖北，陷來鳳。",
          "translations": []
        },
        {
          "id": "s0186",
          "zh": "同治元年春，從劉岳昭攻克之，予二品封典。",
          "translations": []
        }
      ],
      "translations": []
    },
    {
      "type": "paragraph",
      "sentences": [
        {
          "id": "s0187",
          "zh": "駱秉章督師四川，調達武從剿。",
          "translations": []
        },
        {
          "id": "s0188",
          "zh": "抵涪州，會賊酋周紹勇由大寧竄陝西，達武扼之窄子口，地當兩山間，令部將李輝武逾險而入，賊潰走，追至大竹安吉場，擒紹勇及其黨吳崇禮等，檻送成都斬之，賜號質勇巴圖魯。",
          "translations": []
        },
        {
          "id": "s0189",
          "zh": "又破郭刀刀於儀隴大​​儀寨，陣斬其弟佔彪及悍黨馬玉音，追奔至巴州鼎山鋪，擒刀刀，餘黨皆降。",
          "translations": []
        },
        {
          "id": "s0190",
          "zh": "紹勇與刀刀並為蜀中劇賊，至是悉平，授四川建昌鎮總兵，加提督銜。",
          "translations": []
        },
        {
          "id": "s0191",
          "zh": "二年，護理提督。",
          "translations": []
        }
      ],
      "translations": []
    },
    {
      "type": "paragraph",
      "sentences": [
        {
          "id": "s0192",
          "zh": "粵匪陳得才圍漢中，眾號十萬，石達開亦由高縣走寧遠，全蜀大震。",
          "translations": []
        },
        {
          "id": "s0193",
          "zh": "達武增募軍四千人，往來游擊。",
          "translations": []
        },
        {
          "id": "s0194",
          "zh": "三年，得才之黨梁福成合川匪蔡昌齡由漢中竄甘肅階州，達武議以剿為防，率師越境，攻克江東水、嚴家灣賊壘。",
          "translations": []
        },
        {
          "id": "s0195",
          "zh": "進攻階州，自將台山穴地達城根，地雷發，城崩，選鋒四百人先入，大軍繼之，遂克階州，斬福成、昌齡。",
          "translations": []
        },
        {
          "id": "s0196",
          "zh": "以提督記名，並頒珍賚。",
          "translations": []
        },
        {
          "id": "s0197",
          "zh": "尋平松潘叛番，授貴州提督，仍留防重慶，備滇邊。",
          "translations": []
        },
        {
          "id": "s0198",
          "zh": "五年，剿平馬邊廳教匪，斬匪首宋仕傑、熊文才。",
          "translations": []
        }
      ],
      "translations": []
    },
    {
      "type": "paragraph",
      "sentences": [
        {
          "id": "s0199",
          "zh": "六年，捻匪竄陝西，左宗棠諮調會剿，令部將李輝武率三千赴陝。",
          "translations": []
        },
        {
          "id": "s0200",
          "zh": "七年，破越巂倮夷於普雄，進克西昌交腳夷巢，斬級數千，諸夷悉降，賜黃馬褂，晉號博奇巴圖魯。",
          "translations": []
        },
        {
          "id": "s0201",
          "zh": "九年，詔赴貴州提督任，率所部六千人行，沿途平苗砦。",
          "translations": []
        },
        {
          "id": "s0202",
          "zh": "先是貴州剿寇仰客軍，出省城百里即莫能製馭。",
          "translations": []
        },
        {
          "id": "s0203",
          "zh": "達武與巡撫議增募至三萬人，分任戰守，由龍里進凱渡，截上下游賊為二，复都勻，分軍破賊永寧、威寧。",
          "translations": []
        },
        {
          "id": "s0204",
          "zh": "十年，遣鍾開蘭攻克麻哈州之高水塘等地數十砦；",
          "translations": []
        },
        {
          "id": "s0205",
          "zh": "遣何世華破粵賊李文彩、苗酋李高腳於都勻、獨山，收復八寨、三腳諸城，並克鎮寧、歸化及吳秀河、斑竹園諸苗砦，復清平、黃平二城。",
          "translations": []
        },
        {
          "id": "s0206",
          "zh": "始與楚軍席寶田合。",
          "translations": []
        },
        {
          "id": "s0207",
          "zh": "十一年，會席軍敗苗酋張臭迷之黨於茶牛坡，斬馘甚眾，降者數万。",
          "translations": []
        },
        {
          "id": "s0208",
          "zh": "追至冷水溝，生擒賊酋，餘黨李高腳、李文彩竄荊蓬坎，分三路追擊，盡殄之。",
          "translations": []
        },
        {
          "id": "s0209",
          "zh": "旋破群苗於清平香爐山，寶田擒張臭迷。",
          "translations": []
        },
        {
          "id": "s0210",
          "zh": "苗疆平，予騎都尉世職。",
          "translations": []
        }
      ],
      "translations": []
    },
    {
      "type": "paragraph",
      "sentences": [
        {
          "id": "s0211",
          "zh": "光緒元年，乞病歸。",
          "translations": []
        },
        {
          "id": "s0212",
          "zh": "三年，授甘肅提督。",
          "translations": []
        },
        {
          "id": "s0213",
          "zh": "十年，肅州妖民王林倡亂高台，討平之，斬王林。",
          "translations": []
        },
        {
          "id": "s0214",
          "zh": "十九年，萬壽慶典，加尚書銜。",
          "translations": []
        },
        {
          "id": "s0215",
          "zh": "二十年，卒官，賜卹，建專祠。",
          "translations": []
        }
      ],
      "translations": []
    },
    {
      "type": "paragraph",
      "sentences": [
        {
          "id": "s0216",
          "zh": "弟康祿，從達武勦賊廣西、湖南，歷保知縣。",
          "translations": []
        },
        {
          "id": "s0217",
          "zh": "同治元年，從赴蜀，破周紹勇，擢知州。",
          "translations": []
        },
        {
          "id": "s0218",
          "zh": "四年，從克階州，擢知府。",
          "translations": []
        },
        {
          "id": "s0219",
          "zh": "從至貴州，總理營務。",
          "translations": []
        },
        {
          "id": "s0220",
          "zh": "十一年，下游肅清，擢道員。",
          "translations": []
        },
        {
          "id": "s0221",
          "zh": "駐軍普安新城，招撫流亡。",
          "translations": []
        },
        {
          "id": "s0222",
          "zh": "十二年，會匪煽亂，康祿督親軍百人往討，眾寡不敵，死之。",
          "translations": []
        },
        {
          "id": "s0223",
          "zh": "贈內閣學士，予騎都尉世職，諡壯節。",
          "translations": []
        }
      ],
      "translations": []
    },
    {
      "type": "paragraph",
      "sentences": [
        {
          "id": "s0224",
          "zh": "李輝武，湖南衡山人。",
          "translations": []
        },
        {
          "id": "s0225",
          "zh": "周達武部將。",
          "translations": []
        },
        {
          "id": "s0226",
          "zh": "咸豐中，從剿粵匪，洊擢游擊。",
          "translations": []
        },
        {
          "id": "s0227",
          "zh": "十一年，從入四川，剿涪川鶴遊坪踞賊，擒賊酋周紹勇、郭刀刀。",
          "translations": []
        },
        {
          "id": "s0228",
          "zh": "輝武功為多，擢副將，賜號武勇巴圖魯。",
          "translations": []
        },
        {
          "id": "s0229",
          "zh": "同治三年，從援階州，輝武由伍家坪進軍，扼州城外北山條竹埡。",
          "translations": []
        },
        {
          "id": "s0230",
          "zh": "四年，攻破橋頭里賊壘，又破賊於孟家莊，殲城外賊殆盡。",
          "translations": []
        },
        {
          "id": "s0231",
          "zh": "穴地破城，輝武先登，擒賊目蔡四。",
          "translations": []
        },
        {
          "id": "s0232",
          "zh": "巡部，以總兵記名。",
          "translations": []
        },
        {
          "id": "s0233",
          "zh": "從討松潘叛番，拔其巢。",
          "translations": []
        },
        {
          "id": "s0234",
          "zh": "尋攻黑河番，焚芝麻第五寨，餘寨皆降。",
          "translations": []
        },
        {
          "id": "s0235",
          "zh": "乘勝連破大松樹及竹自三寨，以提督記名。",
          "translations": []
        }
      ],
      "translations": []
    },
    {
      "type": "paragraph",
      "sentences": [
        {
          "id": "s0236",
          "zh": "六年，捻匪竄陝西，輝武率步隊五營赴援，剿破汧陽、隴州、寶雞諸賊，西路肅清。",
          "translations": []
        },
        {
          "id": "s0237",
          "zh": "八年，剿董志原竄匪，斃賊目王明章，晉號福凌阿巴圖魯，授漢中鎮總兵。",
          "translations": []
        },
        {
          "id": "s0238",
          "zh": "九年，偕提督劉端冕分擊北山回匪，破翟三、禹得彥於縣頭鎮、陳村。",
          "translations": []
        },
        {
          "id": "s0239",
          "zh": "十一年，擢甘肅提督，仍留防漢中。",
          "translations": []
        },
        {
          "id": "s0240",
          "zh": "光緒四年，卒，賜卹。",
          "translations": []
        }
      ],
      "translations": []
    },
    {
      "type": "paragraph",
      "sentences": [
        {
          "id": "s0241",
          "zh": "輝武在漢中久，軍民相安。",
          "translations": []
        },
        {
          "id": "s0242",
          "zh": "疏濬府城東河道達漢川，旁引溝渠以資灌溉，民食其利；",
          "translations": []
        },
        {
          "id": "s0243",
          "zh": "又修復褎斜棧道，商旅便焉。",
          "translations": []
        },
        {
          "id": "s0244",
          "zh": "沒後，士民籥請建祠，從之。",
          "translations": []
        }
      ],
      "translations": []
    },
    {
      "type": "paragraph",
      "sentences": [
        {
          "id": "s0245",
          "zh": "唐友耕，雲南大關廳人。",
          "translations": []
        },
        {
          "id": "s0246",
          "zh": "咸豐中，滇匪起，陷賊，至四川敘州，自拔來歸。",
          "translations": []
        },
        {
          "id": "s0247",
          "zh": "從戰有功，授千總，署通江營守備。",
          "translations": []
        },
        {
          "id": "s0248",
          "zh": "賊擾​​鹽井，屢從戰擊走之，擢守備。",
          "translations": []
        },
        {
          "id": "s0249",
          "zh": "十年，戰峨眉索橋，受傷，破賊雙福場，進平天全茅山賊壘，擢都司，賜號額勒莫克依巴圖魯。",
          "translations": []
        },
        {
          "id": "s0250",
          "zh": "十一年，援潼川，破賊解圍，擢副將。",
          "translations": []
        },
        {
          "id": "s0251",
          "zh": "駱秉章督師至蜀，檄友耕會諸軍援綿州，令自石橋鋪進攻，友耕觀望不前，被劾，褫職留營。",
          "translations": []
        },
        {
          "id": "s0252",
          "zh": "既而會援眉州，友耕軍先至，戰比有功，圍解，復原官。",
          "translations": []
        },
        {
          "id": "s0253",
          "zh": "戰青神，陣斬賊目張興，身被二傷，裹創力戰，賊大敗。",
          "translations": []
        }
      ],
      "translations": []
    },
    {
      "type": "paragraph",
      "sentences": [
        {
          "id": "s0254",
          "zh": "同治元年，破石達開黨賴裕新於工卩州。",
          "translations": []
        },
        {
          "id": "s0255",
          "zh": "三月，達開圍涪州，友耕馳援，解其圍，授四川重慶鎮總兵。",
          "translations": []
        },
        {
          "id": "s0256",
          "zh": "會諸軍复長寧，賊引去。",
          "translations": []
        },
        {
          "id": "s0257",
          "zh": "是年冬，達開屯敘州雙龍場，分黨屯橫江，友耕攻破江岸賊壘。",
          "translations": []
        },
        {
          "id": "s0258",
          "zh": "二年春，賊由橫江竄新灘溪，與屏山隔一水，友耕慮賊乘間偷渡，乃濟江設伏，誘賊深入，敗之。",
          "translations": []
        },
        {
          "id": "s0259",
          "zh": "六月，達開謀渡金沙江，官軍扼之不得進，改趨天全土司地，友耕擊沉賊筏；",
          "translations": []
        },
        {
          "id": "s0260",
          "zh": "達開奔老鴉漩，復為土兵所遏，遂就擒。",
          "translations": []
        },
        {
          "id": "s0261",
          "zh": "友耕擢雲南提督，留屯川南。",
          "translations": []
        },
        {
          "id": "s0262",
          "zh": "四年，丁母憂，詔改署提督，友耕請終制，許之。",
          "translations": []
        },
        {
          "id": "s0263",
          "zh": "七年服闋，署四川總督崇實奏緩陛見，令募勇防川北。",
          "translations": []
        },
        {
          "id": "s0264",
          "zh": "八年，調赴雲南，招降回寇李本忠等，賜黃馬褂。",
          "translations": []
        },
        {
          "id": "s0265",
          "zh": "光緒六年，署四川提督，八年，卒。",
          "translations": []
        }
      ],
      "translations": []
    },
    {
      "type": "paragraph",
      "sentences": [
        {
          "id": "s0266",
          "zh": "論曰：雷正綰、陶茂林、曹克忠皆多隆阿部下戰將。",
          "translations": []
        },
        {
          "id": "s0267",
          "zh": "多隆阿歿後，甘肅軍事實倚三人，以餉匱兵變，遂難成功。",
          "translations": []
        },
        {
          "id": "s0268",
          "zh": "克忠較有謀略，其軍獨全，終以病引退，後猶稱為宿將。",
          "translations": []
        },
        {
          "id": "s0269",
          "zh": "胡中和、周達武等皆以楚軍平蜀寇。",
          "translations": []
        },
        {
          "id": "s0270",
          "zh": "唐友耕以蜀軍頡頏其間，並躋專閫。",
          "translations": []
        },
        {
          "id": "s0271",
          "zh": "達武晚任貴州軍事，與席寶田同定苗疆，建樹較閎達焉。",
          "translations": []
        }
      ],
      "translations": []
    }
  ]
}