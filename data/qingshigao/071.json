  "content": [
    {
      "type": "paragraph",
      "sentences": [
        {
          "id": "s0001",
          "zh": "志四十六",
          "translations": []
        }
      ],
      "translations": []
    },
    {
      "type": "paragraph",
      "sentences": [
        {
          "id": "s0002",
          "zh": "地理十七",
          "translations": []
        }
      ],
      "translations": []
    },
    {
      "type": "paragraph",
      "sentences": [
        {
          "id": "s0003",
          "zh": "臺灣",
          "translations": []
        }
      ],
      "translations": []
    },
    {
      "type": "paragraph",
      "sentences": [
        {
          "id": "s0004",
          "zh": "臺灣：古荒服之地，不通中國，名曰東番。",
          "translations": []
        },
        {
          "id": "s0005",
          "zh": "隋開皇中，遣虎賁陳棱略澎湖三十六島。",
          "translations": []
        },
        {
          "id": "s0006",
          "zh": "，海寇林道乾掠近海郡縣，都督俞大猷征之，追至澎湖，道乾遁入臺灣。",
          "translations": []
        },
        {
          "id": "s0007",
          "zh": "，閩人顏思齊引日本國人據其地。",
          "translations": []
        },
        {
          "id": "s0008",
          "zh": "久之，為荷蘭所奪。",
          "translations": []
        },
        {
          "id": "s0009",
          "zh": "，海寇鄭成功逐荷蘭人據之，偽置承天府，名曰東都，設二縣，曰天興，曰萬年。",
          "translations": []
        },
        {
          "id": "s0010",
          "zh": "其子鄭經改東都為東寧省，升二縣為州。",
          "translations": []
        },
        {
          "id": "s0011",
          "zh": "康熙二十二年討平之，改置臺灣府，屬福建省，領縣三。",
          "translations": []
        },
        {
          "id": "s0012",
          "zh": "雍正元年，增置彰化縣，領縣四。",
          "translations": []
        },
        {
          "id": "s0013",
          "zh": "光緒十三年，改建行省。",
          "translations": []
        },
        {
          "id": "s0014",
          "zh": "光緒十三年九月庚午，閩浙總督楊昌濬、臺灣巡撫劉銘傳會奏，略云：「臺灣疆域，南北相距七百餘里，東西近者二百餘里，遠或三四百里，崇山大溪，鉤連高下。",
          "translations": []
        },
        {
          "id": "s0015",
          "zh": "從前所治，不過山前迤南一線，故僅設三縣而有餘。",
          "translations": []
        },
        {
          "id": "s0016",
          "zh": "自後榛莽日開，故屢增庁治而猶不足。",
          "translations": []
        },
        {
          "id": "s0017",
          "zh": "光緒元年，沈葆楨請設臺北府、縣以固北路，又將同知移治卑南以顧後山，全臺官制，粗有規模。",
          "translations": []
        },
        {
          "id": "s0018",
          "zh": "然彼時局勢，未聞擇要修舉，非一勞永逸之計也。",
          "translations": []
        },
        {
          "id": "s0019",
          "zh": "臣等公同商酌，竊謂建置之法，恃險與勢，分治之道，貴持其平。",
          "translations": []
        },
        {
          "id": "s0020",
          "zh": "臺省治理，視內地為難，而各縣幅員，反較多於內地。",
          "translations": []
        },
        {
          "id": "s0021",
          "zh": "如彰化、嘉義、鳳山、新竹、淡水等縣，縱橫二百餘里、三百里不等，倉卒有事，鞭長莫及。",
          "translations": []
        },
        {
          "id": "s0022",
          "zh": "且防務為治臺要領，轄境太廣，則耳目難周，控制太寬，則聲氣多阻。",
          "translations": []
        },
        {
          "id": "s0023",
          "zh": "至山後中、北兩路，延袤三四百里，僅區段所設碉堡，並無專駐治理之員，前寄清虛，亦難遙制。",
          "translations": []
        },
        {
          "id": "s0024",
          "zh": "現當改設伊始，百廢俱興，若不量予變通，何以定責成而垂久遠？",
          "translations": []
        },
        {
          "id": "s0025",
          "zh": "臣銘傳於上年九月親赴中路督剿叛番，沿途察看地勢，並據各地方官，將境內扼塞道里、田園山溪，繪圖貼說，呈送前來。",
          "translations": []
        },
        {
          "id": "s0026",
          "zh": "又據撫番清賦各員弁將撫墾地所陸續稟報，謹就山前後通局籌畫，有應添設者，有應改設者，有應裁撤者。",
          "translations": []
        },
        {
          "id": "s0027",
          "zh": "查彰化橋孜圖地方，山環水複，中開平原，氣象宏敞，又當全臺適中之地，擬照前撫臣岑毓英議，就該處建立省城，分彰化東北之境設首府曰臺灣府，附郭首縣曰臺灣縣，將原有之臺灣府、縣改為臺南府安平縣。",
          "translations": []
        },
        {
          "id": "s0028",
          "zh": "嘉義之東，彰化之南，自濁水溪至姑石圭溪止，截長補短，方長四百餘里，擬添設一縣曰云林縣。",
          "translations": []
        },
        {
          "id": "s0029",
          "zh": "新竹苗栗街一帶，扼內山之衝，東連大湖，沿山新墾荒地甚多，擬於新竹西南各境添設一縣曰苗栗縣，合原有之彰化，及埔里社通判，一庁、四縣，均隸臺灣府屬。",
          "translations": []
        },
        {
          "id": "s0030",
          "zh": "其鹿港同知一缺，應即裁撤。",
          "translations": []
        },
        {
          "id": "s0031",
          "zh": "淡水之北，東控三貂嶺，番社歧出，距縣太遠。",
          "translations": []
        },
        {
          "id": "s0032",
          "zh": "基隆為臺北第一門戶，通商建埠，交涉紛繁，現值開採煤礦，修造鐵路，商民麕集，尤賴撫綏。",
          "translations": []
        },
        {
          "id": "s0033",
          "zh": "擬分淡水東北四堡之地，撤歸基隆庁管轄，將原設通判改為撫民理番同知，以重事權。",
          "translations": []
        },
        {
          "id": "s0034",
          "zh": "此前路添改之大略也。",
          "translations": []
        },
        {
          "id": "s0035",
          "zh": "後山形勢，北以蘇溪為總隘，南以卑南為要區，控扼中權，厥惟水尾。",
          "translations": []
        },
        {
          "id": "s0036",
          "zh": "其地與擬設之雲林縣東西相直，現開路百九十餘里，由丹社嶺集集街經達彰化，將去省城，建立中路，前後脈絡，呼吸相通，實為臺東鎖鑰。",
          "translations": []
        },
        {
          "id": "s0037",
          "zh": "擬添設直隸州知州一員曰臺東直隸州，左界宜蘭，右界恆春，計長五百餘里，寬約四十里、十餘里不等，統歸該州管轄，仍隸於臺灣兵備道。",
          "translations": []
        },
        {
          "id": "s0038",
          "zh": "其卑南庁舊治，擬請改設直隸州同一員。",
          "translations": []
        },
        {
          "id": "s0039",
          "zh": "水尾迤南，改為花蓮港庁。",
          "translations": []
        },
        {
          "id": "s0040",
          "zh": "其內已墾熟田約數千畝。",
          "translations": []
        },
        {
          "id": "s0041",
          "zh": "其外海口水深數丈，稽查商舶，彈壓民番，擬請添設直隸州判一員，常川駐紮，均隸臺東直隸州屬。",
          "translations": []
        },
        {
          "id": "s0042",
          "zh": "此後路添設之大略也。",
          "translations": []
        },
        {
          "id": "s0043",
          "zh": "謹按臺灣疆土賦役，日增月廣，與舊時羈縻僑置情形迥不相同，因地制宜，似難再緩。",
          "translations": []
        },
        {
          "id": "s0044",
          "zh": "況年來生番歸化，狉榛之性初就範圍，尤須分道拊循，藉收實效。",
          "translations": []
        },
        {
          "id": "s0045",
          "zh": "輯遐牖邇，在在需員，臣等身在局中，既不敢遇事紛更，以紊典章之舊，亦不敢因陋就簡，以失富庶之基，損益酌中，期歸妥協。",
          "translations": []
        },
        {
          "id": "s0046",
          "zh": "」二十一年，割隸日本。",
          "translations": []
        },
        {
          "id": "s0047",
          "zh": "省在福建東南五百四十里。",
          "translations": []
        },
        {
          "id": "s0048",
          "zh": "西北距京師七千二百五十里。",
          "translations": []
        },
        {
          "id": "s0049",
          "zh": "東界海；",
          "translations": []
        },
        {
          "id": "s0050",
          "zh": "西界澎湖島；",
          "translations": []
        },
        {
          "id": "s0051",
          "zh": "南界磯頭海；",
          "translations": []
        },
        {
          "id": "s0052",
          "zh": "北界基隆城海。",
          "translations": []
        },
        {
          "id": "s0053",
          "zh": "廣五百里，袤一千八百里。",
          "translations": []
        },
        {
          "id": "s0054",
          "zh": "一統志載戶口原額人丁一萬八千八百二十七，滋生男婦大小口共一百七十八萬六千八百八十三，戶二十二萬四千六百四十六。",
          "translations": []
        },
        {
          "id": "s0055",
          "zh": "領府三，州一，庁三，縣十一。",
          "translations": []
        },
        {
          "id": "s0056",
          "zh": "臺灣屹峙海中，為東南屏障，四面環海，崇山峻岭，橫截其中，背負崇岡，襟帶列島。",
          "translations": []
        },
        {
          "id": "s0057",
          "zh": "浪嶠南屏，雞籠北衛，澎湖為門戶，鹿耳為咽喉。",
          "translations": []
        },
        {
          "id": "s0058",
          "zh": "七鯤身毗連環護，三茅港匯聚澄泓。",
          "translations": []
        },
        {
          "id": "s0059",
          "zh": "畜牧之饒，無異中土。",
          "translations": []
        },
        {
          "id": "s0060",
          "zh": "誠東南一大都會也。",
          "translations": []
        }
      ],
      "translations": []
    },
    {
      "type": "paragraph",
      "sentences": [
        {
          "id": "s0061",
          "zh": "臺灣府：衝，繁，疲，難。",
          "translations": []
        },
        {
          "id": "s0062",
          "zh": "為臺灣省治。",
          "translations": []
        },
        {
          "id": "s0063",
          "zh": "巡撫、布政使、分巡兵備道兼按察使銜，共駐。",
          "translations": []
        },
        {
          "id": "s0064",
          "zh": "其地東及東南界臺東州；",
          "translations": []
        },
        {
          "id": "s0065",
          "zh": "西及北界海；",
          "translations": []
        },
        {
          "id": "s0066",
          "zh": "南及西南界臺南府；",
          "translations": []
        },
        {
          "id": "s0067",
          "zh": "東北界臺北府。",
          "translations": []
        },
        {
          "id": "s0068",
          "zh": "廣袤里數闕。",
          "translations": []
        },
        {
          "id": "s0069",
          "zh": "北極高二十四度三十三分。",
          "translations": []
        },
        {
          "id": "s0070",
          "zh": "京師偏東四度二十分。",
          "translations": []
        },
        {
          "id": "s0071",
          "zh": "領縣四，庁一。",
          "translations": []
        },
        {
          "id": "s0072",
          "zh": "臺灣衝，繁，疲，難。",
          "translations": []
        },
        {
          "id": "s0073",
          "zh": "倚。",
          "translations": []
        },
        {
          "id": "s0074",
          "zh": "分彰化縣治。",
          "translations": []
        },
        {
          "id": "s0075",
          "zh": "葫蘆墩，巡司駐。",
          "translations": []
        },
        {
          "id": "s0076",
          "zh": "彰化繁，難。",
          "translations": []
        },
        {
          "id": "s0077",
          "zh": "府北百里。",
          "translations": []
        },
        {
          "id": "s0078",
          "zh": "鹿港，縣丞駐。",
          "translations": []
        },
        {
          "id": "s0079",
          "zh": "雲林難。",
          "translations": []
        },
        {
          "id": "s0080",
          "zh": "林圮埔，縣丞駐。",
          "translations": []
        },
        {
          "id": "s0081",
          "zh": "苗栗衝。",
          "translations": []
        },
        {
          "id": "s0082",
          "zh": "大甲，巡司駐。",
          "translations": []
        },
        {
          "id": "s0083",
          "zh": "埔里社庁調。",
          "translations": []
        },
        {
          "id": "s0084",
          "zh": "府東南。",
          "translations": []
        },
        {
          "id": "s0085",
          "zh": "其山在府境者，西北：五鶴、牛困山。",
          "translations": []
        },
        {
          "id": "s0086",
          "zh": "西：史老榻山。",
          "translations": []
        },
        {
          "id": "s0087",
          "zh": "南：蘆芝、芎根、郡坑、松柏山、土山。",
          "translations": []
        },
        {
          "id": "s0088",
          "zh": "東：內山。",
          "translations": []
        },
        {
          "id": "s0089",
          "zh": "濁水出埔里社庁東南山，西南流，左合二水，經雲林縣東北，一水自南來注之。",
          "translations": []
        },
        {
          "id": "s0090",
          "zh": "曲北，右納一水，經縣北。",
          "translations": []
        },
        {
          "id": "s0091",
          "zh": "又西北，一水自嘉義縣來，北流注之。",
          "translations": []
        },
        {
          "id": "s0092",
          "zh": "又西經牛埔厝，歧為三支：一支曰石龜溪，西為牛椆溪；",
          "translations": []
        },
        {
          "id": "s0093",
          "zh": "一支曰虎尾溪，經汕頭厝為麥藔港，並經縣西入于海；",
          "translations": []
        },
        {
          "id": "s0094",
          "zh": "一支為東螺溪，又歧為三，曰刺桐港即番挖港，曰鹿港，曰二林港，並經彰化縣西入于海。",
          "translations": []
        },
        {
          "id": "s0095",
          "zh": "大肚溪上源曰合水溪，出埔里社庁東南魚池仔，西北流，合南硿溪，經庁西北，北港溪、北硿溪並西流注之。",
          "translations": []
        },
        {
          "id": "s0096",
          "zh": "又西，珠子山二水合西北流注之，經府治南，左右各納一水，經大肚街為大肚溪，又西北入于海。",
          "translations": []
        },
        {
          "id": "s0097",
          "zh": "大甲溪出苗栗縣東南，合數小水，西南流，右出支津注於吞霄溪。",
          "translations": []
        },
        {
          "id": "s0098",
          "zh": "正渠南流，左納一水，折西北，經鐵砧山南，又西北入于海。",
          "translations": []
        },
        {
          "id": "s0099",
          "zh": "吞霄溪出苗栗縣東南，合大甲溪支津，經縣南，西北流入于海。",
          "translations": []
        },
        {
          "id": "s0100",
          "zh": "後壠溪出苗栗縣東南山，合一水，西北流，經五鶴山，南至鋼羅灣，夾二洲，又西北，經縣治北，右通中港溪，左納一水，入于海。",
          "translations": []
        },
        {
          "id": "s0101",
          "zh": "中港溪出縣東山，緣界西北流，經縣治，左出支津合後壠港支水為烏眉溪，與正渠並西北入于海。",
          "translations": []
        }
      ],
      "translations": []
    },
    {
      "type": "paragraph",
      "sentences": [
        {
          "id": "s0102",
          "zh": "臺南府：衝，繁，難。",
          "translations": []
        },
        {
          "id": "s0103",
          "zh": "舊臺灣府改設。",
          "translations": []
        },
        {
          "id": "s0104",
          "zh": "東北距省治二百里。",
          "translations": []
        },
        {
          "id": "s0105",
          "zh": "東及東南界臺東州；",
          "translations": []
        },
        {
          "id": "s0106",
          "zh": "西及南界海；",
          "translations": []
        },
        {
          "id": "s0107",
          "zh": "北及東北界臺灣府。",
          "translations": []
        },
        {
          "id": "s0108",
          "zh": "廣袤里數闕。",
          "translations": []
        },
        {
          "id": "s0109",
          "zh": "北極高二十三度。",
          "translations": []
        },
        {
          "id": "s0110",
          "zh": "京師偏東三度三十一分。",
          "translations": []
        },
        {
          "id": "s0111",
          "zh": "領縣四，庁一。",
          "translations": []
        },
        {
          "id": "s0112",
          "zh": "噶瑪蘭頭圍，巡司駐。",
          "translations": []
        },
        {
          "id": "s0113",
          "zh": "安平衝，繁，難。",
          "translations": []
        },
        {
          "id": "s0114",
          "zh": "倚。",
          "translations": []
        },
        {
          "id": "s0115",
          "zh": "大武壠、斗六門二巡司。",
          "translations": []
        },
        {
          "id": "s0116",
          "zh": "鳳山繁，難。",
          "translations": []
        },
        {
          "id": "s0117",
          "zh": "府南八十里。",
          "translations": []
        },
        {
          "id": "s0118",
          "zh": "下淡水，縣丞駐。",
          "translations": []
        },
        {
          "id": "s0119",
          "zh": "枋寮，巡司駐。",
          "translations": []
        },
        {
          "id": "s0120",
          "zh": "嘉義繁，難。",
          "translations": []
        },
        {
          "id": "s0121",
          "zh": "府北一百十七里。",
          "translations": []
        },
        {
          "id": "s0122",
          "zh": "笨港，縣丞駐。",
          "translations": []
        },
        {
          "id": "s0123",
          "zh": "佳里興，巡司駐。",
          "translations": []
        },
        {
          "id": "s0124",
          "zh": "恆春疲，難。",
          "translations": []
        },
        {
          "id": "s0125",
          "zh": "澎湖庁簡。",
          "translations": []
        },
        {
          "id": "s0126",
          "zh": "府西水程二百四十里。",
          "translations": []
        },
        {
          "id": "s0127",
          "zh": "澎湖，總兵駐。",
          "translations": []
        },
        {
          "id": "s0128",
          "zh": "澎湖八罩巡司。",
          "translations": []
        },
        {
          "id": "s0129",
          "zh": "其山在府境者，北：太湖、白水、木岡山。",
          "translations": []
        },
        {
          "id": "s0130",
          "zh": "東北：大福興、大利山。",
          "translations": []
        },
        {
          "id": "s0131",
          "zh": "東：觀音、枕頭山。",
          "translations": []
        },
        {
          "id": "s0132",
          "zh": "北：華山。",
          "translations": []
        },
        {
          "id": "s0133",
          "zh": "東南：武吉、草山。",
          "translations": []
        },
        {
          "id": "s0134",
          "zh": "南：虎頭、龜山。",
          "translations": []
        },
        {
          "id": "s0135",
          "zh": "西：鳳山，鳳山縣以此得名。",
          "translations": []
        },
        {
          "id": "s0136",
          "zh": "鳳山北大岡滾水、大武壠、大木岡山。",
          "translations": []
        },
        {
          "id": "s0137",
          "zh": "縣東傀儡山，俗曰加禮山。",
          "translations": []
        },
        {
          "id": "s0138",
          "zh": "澎湖庁懸居海中。",
          "translations": []
        },
        {
          "id": "s0139",
          "zh": "牛椆溪出嘉義縣東，西北流，經治北，與布袋嘴港並西流入于海。",
          "translations": []
        },
        {
          "id": "s0140",
          "zh": "八掌溪出雲林縣界，西北流，經平鼻山北半月山，南合瀵箕湖及一小水，西流至鹽水港，入于海。",
          "translations": []
        },
        {
          "id": "s0141",
          "zh": "急水溪二源，並出雲林縣西界，經嘉義縣東南，合西流，又經急水鋪南，左納十八重溪，又經鐵線橋街北，又西入于海。",
          "translations": []
        },
        {
          "id": "s0142",
          "zh": "曾文溪出府治東北，西北流，經大武壠北，右納茄拔溪，左納一小水，經府治北，又西經倒風港，入于海。",
          "translations": []
        },
        {
          "id": "s0143",
          "zh": "柴頭港出府治東北山，西北流，經治北，又西合德慶港為安平港，入于海。",
          "translations": []
        },
        {
          "id": "s0144",
          "zh": "二層行溪出府治東，茄定港出雁門關嶺，阿公店溪出鳳山縣東北，並西流入于海。",
          "translations": []
        },
        {
          "id": "s0145",
          "zh": "淡水溪出府治東六張犁，西南流，右納一水，左納二水，經下淡水西，鳳山縣治東，至潮州厝汛北，西冷水溝水出縣東芋匏山，合二水西南流注之。",
          "translations": []
        },
        {
          "id": "s0146",
          "zh": "又西南匯為東港，入於港海。",
          "translations": []
        },
        {
          "id": "s0147",
          "zh": "茄藤港在鳳山縣南，西流入于海。",
          "translations": []
        },
        {
          "id": "s0148",
          "zh": "率芒溪出恆春縣北武吉山，合一水，西流入于海。",
          "translations": []
        },
        {
          "id": "s0149",
          "zh": "刺桐港、楓港、五重溪、三重港、射寮溪並在恆春縣北，西流入于海。",
          "translations": []
        },
        {
          "id": "s0150",
          "zh": "龍鑾潭在恆春縣南，西北流入于海。",
          "translations": []
        },
        {
          "id": "s0151",
          "zh": "豬勞束港在恆春縣東，東流入于海。",
          "translations": []
        }
      ],
      "translations": []
    },
    {
      "type": "paragraph",
      "sentences": [
        {
          "id": "s0152",
          "zh": "臺北府：衝，繁。",
          "translations": []
        },
        {
          "id": "s0153",
          "zh": "西南距省治三百五十里。",
          "translations": []
        },
        {
          "id": "s0154",
          "zh": "東、北、西界海；",
          "translations": []
        },
        {
          "id": "s0155",
          "zh": "南界臺東州；",
          "translations": []
        },
        {
          "id": "s0156",
          "zh": "西南界臺灣府。",
          "translations": []
        },
        {
          "id": "s0157",
          "zh": "廣袤里數闕。",
          "translations": []
        },
        {
          "id": "s0158",
          "zh": "北極高二十五度十七分。",
          "translations": []
        },
        {
          "id": "s0159",
          "zh": "京師偏東五度十五分。",
          "translations": []
        },
        {
          "id": "s0160",
          "zh": "領縣三，庁一。",
          "translations": []
        },
        {
          "id": "s0161",
          "zh": "淡水衝。",
          "translations": []
        },
        {
          "id": "s0162",
          "zh": "倚。",
          "translations": []
        },
        {
          "id": "s0163",
          "zh": "新竹疲，難。",
          "translations": []
        },
        {
          "id": "s0164",
          "zh": "府西南。",
          "translations": []
        },
        {
          "id": "s0165",
          "zh": "宜蘭疲，難。",
          "translations": []
        },
        {
          "id": "s0166",
          "zh": "府東南。",
          "translations": []
        },
        {
          "id": "s0167",
          "zh": "頭圍，縣丞駐。",
          "translations": []
        },
        {
          "id": "s0168",
          "zh": "基隆庁衝，繁。",
          "translations": []
        },
        {
          "id": "s0169",
          "zh": "府東北二百七十五里。",
          "translations": []
        },
        {
          "id": "s0170",
          "zh": "其山在府境者，北：大屯、沙帽、大武壠山。",
          "translations": []
        },
        {
          "id": "s0171",
          "zh": "東北：雞籠山，在基隆庁東。",
          "translations": []
        },
        {
          "id": "s0172",
          "zh": "府城東：攀山。",
          "translations": []
        },
        {
          "id": "s0173",
          "zh": "南：瓦窯山、大羈尖山、五指山。",
          "translations": []
        },
        {
          "id": "s0174",
          "zh": "西南：橫山、金面山、虎頭山。",
          "translations": []
        },
        {
          "id": "s0175",
          "zh": "西南：嵌山。",
          "translations": []
        },
        {
          "id": "s0176",
          "zh": "海環府東、北、西三面。",
          "translations": []
        },
        {
          "id": "s0177",
          "zh": "基隆口在基隆庁東北。",
          "translations": []
        },
        {
          "id": "s0178",
          "zh": "扈尾口在府治西北。",
          "translations": []
        },
        {
          "id": "s0179",
          "zh": "磺溪出府治南山，合石頭溪，東北流，左右各納一小水，至枋橋街，紅仙水合擺接溪諸水西流注之。",
          "translations": []
        },
        {
          "id": "s0180",
          "zh": "又北經府治西，艋舺、十八重溪水北流折東注之。",
          "translations": []
        },
        {
          "id": "s0181",
          "zh": "至大稻埕。",
          "translations": []
        },
        {
          "id": "s0182",
          "zh": "大隆洞溪出基隆庁東雞籠山，合一水西流注之。",
          "translations": []
        },
        {
          "id": "s0183",
          "zh": "又西北，分流復合，經扈尾港入于海。",
          "translations": []
        },
        {
          "id": "s0184",
          "zh": "南崁港上流為大過溪，在府治西北。",
          "translations": []
        },
        {
          "id": "s0185",
          "zh": "中瀝溪、土牛溝、紅毛港、鳳山崎溪、舊港、油車港、香山港並在新竹縣西北入于海。",
          "translations": []
        },
        {
          "id": "s0186",
          "zh": "三貂溪在基隆庁東南，草嶺大溪、加禮遠港、蘇澳門並在宜蘭縣南，俱入于海。",
          "translations": []
        }
      ],
      "translations": []
    },
    {
      "type": "paragraph",
      "sentences": [
        {
          "id": "s0187",
          "zh": "臺東直隸州：衝，繁，疲，難。",
          "translations": []
        },
        {
          "id": "s0188",
          "zh": "卑南庁改設。",
          "translations": []
        },
        {
          "id": "s0189",
          "zh": "西北距省治五百里。",
          "translations": []
        },
        {
          "id": "s0190",
          "zh": "東及南界海；",
          "translations": []
        },
        {
          "id": "s0191",
          "zh": "西及西北界臺灣府；",
          "translations": []
        },
        {
          "id": "s0192",
          "zh": "北界臺北府；",
          "translations": []
        },
        {
          "id": "s0193",
          "zh": "西南界臺南府。",
          "translations": []
        },
        {
          "id": "s0194",
          "zh": "廣袤里數闕。",
          "translations": []
        },
        {
          "id": "s0195",
          "zh": "北極高二十二度二十五分。",
          "translations": []
        },
        {
          "id": "s0196",
          "zh": "京師偏東四度。",
          "translations": []
        },
        {
          "id": "s0197",
          "zh": "卑南，州同駐。",
          "translations": []
        },
        {
          "id": "s0198",
          "zh": "花蓮港，州判駐。",
          "translations": []
        },
        {
          "id": "s0199",
          "zh": "其山在州境者，北：岐來山、能高山。",
          "translations": []
        },
        {
          "id": "s0200",
          "zh": "西：秀姑巒山。",
          "translations": []
        },
        {
          "id": "s0201",
          "zh": "東：丁象山。",
          "translations": []
        },
        {
          "id": "s0202",
          "zh": "西出八同關，為秀姑巒山一帶番社，系屬巒番所居。",
          "translations": []
        },
        {
          "id": "s0203",
          "zh": "西南一帶高山番社，系屬昆番所居。",
          "translations": []
        },
        {
          "id": "s0204",
          "zh": "大港上源曰打馬溪，出秀姑巒山，東流經治北，右合網網溪，左合一水，經奇密社北，入于海。",
          "translations": []
        },
        {
          "id": "s0205",
          "zh": "卑南大溪出州西南新武洛社，合三水東南流入于海。",
          "translations": []
        },
        {
          "id": "s0206",
          "zh": "花蓮港二源，並出州西北，合數小水，經太平廠南入于海。",
          "translations": []
        },
        {
          "id": "s0207",
          "zh": "東澳、南澳、大濁水溪、大清水溪、小清水溪、得其黎溪、三棧溪、尤丹溪、米侖港並在州東北，入于海。",
          "translations": []
        },
        {
          "id": "s0208",
          "zh": "紅蝦港、黎仔阬溪、郎阿郎溪、馬武窟溪、八里芒溪、呂家望溪、知本溪、大苗里溪、虷子侖溪、大足高溪、-{干}-子壁溪、大烏萬溪、巴塱衛溪、魯木鹿溪、牡丹灣、八磘灣並在州東南，入于海。",
          "translations": []
        }
      ],
      "translations": []
    }
  ]
}